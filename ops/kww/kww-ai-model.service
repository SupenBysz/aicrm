[Unit]
Description=kww 开发环境 ai-model 服务
After=network-online.target
Wants=network-online.target
PartOf=kww-dev.target

[Service]
Type=simple
User=kww-app
Group=kww-app
WorkingDirectory=/data/kww.org.cn/runtime
EnvironmentFile=/etc/kww/database.env
EnvironmentFile=/etc/kww/runtime.env
ExecStart=/data/kww.org.cn/runtime/bin/ky-ai-model-service
ReadWritePaths=/var/lib/kww/ai-model
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
