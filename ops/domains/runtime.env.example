# Disabled until all six services, gateway, dedicated remote-managed Tunnel and origin isolation pass acceptance.
KY_DOMAIN_ENTRY_ENABLED=0
KY_DOMAIN_MANAGED_ENABLED=0
KY_DOMAIN_AUTOMATION_READY=0
KY_DOMAIN_ORIGIN_ISOLATED=0
KY_DOMAIN_INSTANCE_ID=your-project-instance
KY_DOMAIN_PLATFORM_HOSTS=console.example.com
KY_DOMAIN_RESERVED_HOSTS=www.example.com
KY_DOMAIN_RESERVED_ROOTS=
KY_DOMAIN_PROXY_SECRET=REPLACE_FROM_SECRET_STORE
KY_DOMAIN_PROBE_SECRET=REPLACE_FROM_SECRET_STORE
KY_DOMAIN_GATEWAY_TOKEN=REPLACE_FROM_SECRET_STORE
KY_DOMAIN_WORKER_TOKEN=REPLACE_FROM_SECRET_STORE
KY_DOMAIN_ORG_URL=http://127.0.0.1:18082
KY_DOMAIN_AUTH_URL=http://127.0.0.1:18081
KY_AUTH_SERVICE_URL=http://127.0.0.1:18081
KY_ORG_SERVICE_URL=http://127.0.0.1:18082
KY_MEMBERSHIP_SERVICE_URL=http://127.0.0.1:18083
KY_INTERNAL_SERVICE_TOKEN=REPLACE_FROM_SECRET_STORE
KY_DOMAIN_GATEWAY_LISTEN=127.0.0.1:18181
KY_DOMAIN_BACKEND_URL=http://127.0.0.1:18080
KY_DOMAIN_BACKEND_HOST=console.example.com
KY_DOMAIN_GATE_ENDPOINTS=http://127.0.0.1:18081,http://127.0.0.1:18082,http://127.0.0.1:18083,http://127.0.0.1:18086,http://127.0.0.1:18085,http://127.0.0.1:18087
# Worker-only variables. Do not load these into Host, business services or browser.
KY_DOMAIN_CF_TOKEN_FILE=/run/credentials/ky-domain-worker/cf-api-token
KY_DOMAIN_CF_ACCOUNT_ID=REPLACE_WITH_AUTHORIZED_ACCOUNT
KY_DOMAIN_CF_TUNNEL_ID=REPLACE_WITH_DEDICATED_TUNNEL
KY_DOMAIN_TUNNEL_ORIGIN=http://127.0.0.1:18181
KY_DOMAIN_ALLOW_ZONE_CREATE=0
# All business listeners must be loopback when entry isolation is enabled.
KY_AUTH_SERVICE_HTTP_ADDR=127.0.0.1:18081
KY_ORG_SERVICE_HTTP_ADDR=127.0.0.1:18082
KY_MEMBERSHIP_SERVICE_HTTP_ADDR=127.0.0.1:18083
KY_MATRIX_ACCOUNT_SERVICE_HTTP_ADDR=127.0.0.1:18085
KY_AI_MODEL_SERVICE_HTTP_ADDR=127.0.0.1:18086
KY_AGENT_EXECUTOR_SERVICE_HTTP_ADDR=127.0.0.1:18087
