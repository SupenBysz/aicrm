{
  "name": "@ky/admin-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "test:appearance": "node --test src/theme/theme.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:ai-executor-desktop": "node --test src/ai-executor-desktop.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./src/theme/tokens.ts",
      "default": "./src/theme/tokens.ts"
    }
  }
}
