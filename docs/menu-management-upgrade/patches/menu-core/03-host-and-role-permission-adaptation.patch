+export function mergePermissionManagementMenus(registry: readonly RegisteredManagementMenu[], catalog: readonly ManagementMenuPermissionMetadata[] = [], workspaceType: string): ManagementMenuPermissionMetadata[] {
+  const byKey = new Map(catalog.map((item) => [item.menuKey, item]));
+  const seen = new Set<string>();
+  const registeredWorkspaceTypes = (item: RegisteredManagementMenu) => {
+    const scopedMenuKey = item.permissionKeys.find((code) => /^menu\.(platform|agency|enterprise)\./.test(code));
+    const scopedWorkspace = scopedMenuKey?.match(/^menu\.(platform|agency|enterprise)\./)?.[1];
+    return scopedWorkspace ? [scopedWorkspace] : item.workspaceTypes;
+  };
+  const merged = registry.filter((item) => registeredWorkspaceTypes(item).includes(workspaceType) || byKey.has(item.menuKey)).map((item): ManagementMenuPermissionMetadata => {
+    seen.add(item.menuKey);
+    const stored = byKey.get(item.menuKey);
+    return {
+      menuKey: item.menuKey,
+      // Static plugin navigation owns the actual name/parent/order. The server
+      // contributes enabled state and persisted, workspace-scoped associations.
+      name: item.name,
+      parentKey: item.parentKey,
+      sortOrder: item.sortOrder,
+      workspaceTypes: stored?.workspaceTypes ?? item.workspaceTypes,
+      permissionKeys: [...new Set([
+        ...item.permissionKeys.filter((code) => {
+          const scope = code.match(/^(?:menu\.)?(platform|agency|enterprise)\./)?.[1];
+          return !scope || scope === workspaceType;
+        }),
+        ...(stored?.permissionKeys ?? [])
+      ])],
+      nodeType: stored?.nodeType ?? (item.routePath ? "leaf" : "group"),
+      status: stored?.status ?? "active"
+    };
+  });
+  for (const item of catalog) if (!seen.has(item.menuKey)) merged.push(item);
+  return merged;
+}
+
+export function filterPermissionsByCategory<T extends Pick<Permission, "category">>(permissions: readonly T[], category: string): T[] {
+  return category === "all" ? [...permissions] : permissions.filter((permission) => permission.category === category);
+}
+
+function menuTreeSources(menus: MenuTreeSource) {
+  const workbench = buildWorkbenchMenuTree(menus.workbench);
+  const managementByKey = new Map(menus.management.map((item) => [item.menuKey, item]));
+  const management = buildWorkbenchMenuTree(menus.management.map((item) => ({
+    menuKey: item.menuKey,
+    name: item.name,
+    icon: "",
+    parentKey: item.parentKey,
+    sortOrder: item.sortOrder,
+    workspaceTypes: item.workspaceTypes,
+    routeKey: null,
+    nodeType: item.nodeType,
+    pageType: "default" as const,
+    status: item.status ?? "active",
+    revision: 0
+  })));
+  return { workbench, management, managementByKey };
+}
+
+function placements(candidates: MenuCandidate[]): Assignment[] {
+  const unique = [...new Map(candidates.map((item) => [item.nodeKey ?? `${item.directory}:${item.menuKey}`, item])).values()];
+  const relatedNames = [...new Set(unique.map((item) => item.name))];
+  const shared = unique.length > 1;
+  return unique.map((item) => ({
+    nodeKey: item.nodeKey ?? `menu-tree:${item.directory}:${item.menuKey}`,
+    relatedNames: shared ? relatedNames : [item.name],
+    shared,
+    displayName: item.displayName
+  }));
+}
+
+function auditedMenuCandidates(code: string, menus: MenuTreeSource, activeManagement: readonly ManagementMenuPermissionMetadata[]): MenuCandidate[] {
+  return (AUDITED_MENU_BINDINGS[code] ?? []).flatMap<MenuCandidate>((binding) => {
+    if (binding.nodeKey) return [{ directory: binding.directory, nodeKey: binding.nodeKey, name: binding.displayName ?? "工作台", displayName: binding.displayName }];
+    const source = binding.directory === "management" ? activeManagement : menus.workbench;
+    const menu = source.find((item) => item.menuKey === binding.menuKey && item.status !== "disabled");
+    return menu ? [{ directory: binding.directory, menuKey: binding.menuKey, name: menu.name, displayName: binding.displayName }] : [];
+  });
+}
