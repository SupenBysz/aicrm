new file mode 100644
index 0000000..acebcfc
--- /dev/null
+++ b/apps/ky-admin-host/src/nav-open-state.ts
@@ -0,0 +1,18 @@
+// 按实际渲染树计算祖先；详情页沿用宿主最长路由匹配得到的activeKey。
+export interface NavNode { key: string; children?: NavNode[] }
+export function selectedAncestors(items: NavNode[], activeKey?: string): string[] {
+  for (const item of items) {
+    if (item.key === activeKey) return [];
+    if (item.children) {
+      const nested = selectedAncestors(item.children, activeKey);
+      if (nested.length || item.children.some(child => child.key === activeKey)) return [item.key, ...nested];
+    }
+  }
+  return [];
+}
+export function expandedKeys(items: NavNode[], requested: string[], activeKey?: string): string[] {
+  const groups = new Set<string>();
+  const visit = (nodes: NavNode[]) => { for (const node of nodes) if (node.children?.length) { groups.add(node.key); visit(node.children); } };
+  visit(items);
+  return [...new Set([...requested.filter(key => groups.has(key)), ...selectedAncestors(items, activeKey)])];
+}
