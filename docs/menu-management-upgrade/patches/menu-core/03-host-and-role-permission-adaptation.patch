new file mode 100644
index 0000000..f73b728
--- /dev/null
+++ b/packages/ky-admin-core/src/management-list-extension.tsx
@@ -0,0 +1,101 @@
+import { Children, cloneElement, createContext, createElement, isValidElement, useContext, type ComponentType, type ReactNode } from "react";
+export interface ManagementRef {
+    kind: "agency" | "enterprise" | "department" | "team" | "membership";
+    id: string;
+    name?: string;
+}
+export interface ManagementListProps {
+    refs: ManagementRef[];
+    onRefresh: () => void;
+    children: ReactNode;
+}
+export interface ManagementListContribution {
+    key: string;
+    order: number;
+    kinds: ManagementRef["kind"][];
+    Provider: ComponentType<{
+        children: ReactNode;
+    }>;
+    ListProvider: ComponentType<ManagementListProps>;
+    Cell: ComponentType<{
+        subject: ManagementRef;
+    }>;
+    Action: ComponentType<{
+        subject: ManagementRef;
+    }>;
+    Column?: {
+        title: string;
+        width?: number;
+        render: ComponentType<{ subject: ManagementRef }>;
+    };
+}
+const Contributions = createContext<ManagementListContribution[]>([]);
+export function ManagementExtensionsProvider({ contributions, children }: {
+    contributions: ManagementListContribution[];
+    children: ReactNode;
+}) {
+    const sorted = [...contributions].sort((a, b) => a.order - b.order || a.key.localeCompare(b.key));
+    if (new Set(sorted.map(x => x.key)).size !== sorted.length)
+        throw new Error("管理列表扩展标识重复");
+    return <Contributions.Provider value={sorted}>{sorted.reduceRight<ReactNode>((child, c) => <c.Provider key={c.key}>{child}</c.Provider>, children)}</Contributions.Provider>;
+}
+export function ManagementListScope(props: ManagementListProps) {
+    return useContext(Contributions).reduceRight<ReactNode>((child, c) => <c.ListProvider key={c.key} refs={props.refs.filter(ref => c.kinds.includes(ref.kind))} onRefresh={props.onRefresh}>{child}</c.ListProvider>, props.children);
+}
+export function ManagementListCell({ subject }: {
+    subject: ManagementRef;
+}) {
+    return <>{useContext(Contributions).filter(c => c.kinds.includes(subject.kind)).map(c => <c.Cell key={c.key} subject={subject}/>)}</>;
+}
+export function ManagementListAction({ subject }: {
+    subject: ManagementRef;
+}) {
+    return <>{useContext(Contributions).filter(c => c.kinds.includes(subject.kind)).map(c => <c.Action key={c.key} subject={subject}/>)}</>;
+}
+// 页面显式选择接入，不改变其他列表。标题由页面提供，Core不持有领域名称。
+export function extendManagementColumns<C extends {
+    key?: React.Key;
+    width?: string | number;
+    render?: unknown;
+}>(columns: C[], kind: ManagementRef["kind"], title: string, enabled: boolean): C[] {
+    if (!enabled)
+        return columns;
+    const result = columns.map(column => {
+        if (column.key !== "actions")
+            return column;
+        const render = column.render as ((value: unknown, row: {
+            id: string;
+        }, index: number) => ReactNode) | undefined;
+        const mergeActionLayout = (original: ReactNode, subject: ManagementRef) => {
+            const nodes = Children.toArray(original);
+            const first = nodes.length === 1 ? nodes[0] : null;
+            if (isValidElement<{ className?: string; children?: ReactNode }>(first) && typeof first.props.className === "string" && first.props.className.split(/\s+/).includes("table-action-grid")) {
+                return cloneElement(first, { className: `${first.props.className} table-action-grid--management-extension` }, ...Children.toArray(first.props.children), <ManagementListAction key="management-extension-action" subject={subject} />);
+            }
+            return <div className="table-action-grid table-action-grid--management-extension">{original}<ManagementListAction subject={subject}/></div>;
+        };
+        return { ...column, fixed: "right", width: typeof column.width === "number" ? column.width + 64 : 260, render: (value: unknown, row: {
+                id: string;
+            }, index: number) => mergeActionLayout(render?.(value, row, index), { kind, id: row.id }) } as C;
+    });
+    const balance = { key: "management-extension", title, width: 120, render: (_: unknown, row: {
+            id: string;
+            name?: string;
+        }) => <ManagementListCell subject={{ kind, id: row.id, name: row.name }}/> } as unknown as C;
+    const actionIndex = result.findIndex(c => c.key === "actions");
+    result.splice(actionIndex < 0 ? result.length : actionIndex, 0, balance);
+    const extensionColumns = useContext(Contributions)
+        .filter(c => c.kinds.includes(kind) && c.Column)
+        .map(c => {
+            const column = c.Column!;
+            return {
+                key: `management-extension:${c.key}`,
+                title: column.title,
+                width: column.width,
+                render: (_: unknown, row: { id: string; name?: string }) =>
+                    createElement(column.render, { subject: { kind, id: row.id, name: row.name } }),
+            };
+        }) as unknown as C[];
+    result.splice(actionIndex < 0 ? result.length : actionIndex, 0, ...extensionColumns);
+    return result;
+}
