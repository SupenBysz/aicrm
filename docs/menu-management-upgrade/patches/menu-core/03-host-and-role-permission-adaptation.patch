+  assert.deepEqual(new Set(permissionDisplayKeys(tree.permissionNodeIds, selectedFromProvider)), new Set(sharedActionKeys), "controlled projection checks every occurrence");
+  const deselected = applyPermissionTreeCheck(tree.permissionNodeIds, tree.treeData, String(sharedActionKeys[1]), false, selectedFromProvider);
+  assert.deepEqual([...deselected], [], "unchecking either occurrence clears the shared real ID and all projected checks");
+  assert.deepEqual(permissionDisplayKeys(tree.permissionNodeIds, deselected), []);
+  const selectedProviderKeys = new Set(permissionDisplayKeys(tree.permissionNodeIds, selectedFromProvider));
+  assert.ok(provider.children.some((node) => selectedProviderKeys.has(String(node.key))) && provider.children.some((node) => !selectedProviderKeys.has(String(node.key))), "a module parent has both checked and unchecked children, so Ant Tree projects it as half-checked");
+  assert.deepEqual([...permissionIdsFromDisplayKeys(tree.permissionNodeIds, [...sharedMenuKeys, ...sharedMenuKeys])], ["shared-menu-id"], "display occurrences deduplicate to one persisted permission ID");
+  assert.deepEqual([...tree.permissionIds].filter((id) => id === "shared-action-id"), ["shared-action-id"], "save set contains no duplicate permission ID");
+  const selectedByProviderParent = applyPermissionTreeCheck(tree.permissionNodeIds, tree.treeData, String(provider.key), true, []);
+  assert.deepEqual(new Set(selectedByProviderParent), new Set(["shared-menu-id", "shared-page-id", "shared-action-id"]), "checking a module parent resolves its subtree to unique real IDs");
+  assert.deepEqual(new Set(permissionDisplayKeys(tree.permissionNodeIds, selectedByProviderParent)), new Set([...sharedMenuKeys, ...sharedViewKeys, ...sharedActionKeys]), "parent selection projects to every shared occurrence across modules");
+  assert.deepEqual(applyPermissionTreeCheck(tree.permissionNodeIds, tree.treeData, String(provider.key), false, selectedByProviderParent), new Set(), "unchecking a module parent removes its real IDs and mirrored checks");
+});
