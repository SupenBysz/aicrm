+function permissionLeafCount(nodes: readonly DataNode[], permissionNodeIds: ReadonlyMap<string, string>): number {
+  return nodes.reduce((sum, node) => sum + (permissionNodeIds.has(String(node.key)) ? 1 : 0) + permissionLeafCount(node.children ?? [], permissionNodeIds), 0);
+}
+
+export function permissionDisplayKeys(permissionNodeIds: ReadonlyMap<string, string>, permissionIds: Iterable<string>): string[] {
+  const selected = new Set(permissionIds);
+  return [...permissionNodeIds].filter(([, permissionId]) => selected.has(permissionId)).map(([nodeKey]) => nodeKey);
+}
+
+export function permissionIdsFromDisplayKeys(permissionNodeIds: ReadonlyMap<string, string>, nodeKeys: Iterable<string>): Set<string> {
+  const ids = new Set<string>();
+  for (const key of nodeKeys) {
+    const id = permissionNodeIds.get(key);
+    if (id) ids.add(id);
+  }
+  return ids;
+}
+
+export function applyPermissionTreeCheck(
+  permissionNodeIds: ReadonlyMap<string, string>,
+  treeData: readonly DataNode[],
+  nodeKey: string,
+  checked: boolean,
+  currentPermissionIds: Iterable<string>
+): Set<string> {
+  const result = new Set(currentPermissionIds);
+  const findNode = (nodes: readonly DataNode[]): DataNode | undefined => {
+    for (const node of nodes) {
+      if (String(node.key) === nodeKey) return node;
+      const nested = findNode(node.children ?? []);
+      if (nested) return nested;
+    }
+    return undefined;
+  };
+  const node = findNode(treeData);
+  if (!node) return result;
+  const affected = new Set<string>();
+  const collect = (current: DataNode) => {
+    const permissionId = permissionNodeIds.get(String(current.key));
+    if (permissionId) affected.add(permissionId);
+    for (const child of current.children ?? []) collect(child);
+  };
+  collect(node);
+  for (const permissionId of affected) {
+    if (checked) result.add(permissionId);
+    else result.delete(permissionId);
+  }
+  return result;
+}
+
+function countLeaves(nodes: readonly DataNode[]): number {
+  return nodes.reduce((sum, node) => sum + (node.isLeaf ? 1 : countLeaves(node.children ?? [])), 0);
+}
+
+function withCount(name: string, children: readonly DataNode[]): string {
+  const count = countLeaves(children);
+  return count ? `${name}（${count}）` : name;
+}
+
+function permissionOrder(left: PermissionLike, right: PermissionLike): number {
+  const rank = (category: string) => category === "menu" ? 0 : category === "page" ? 1 : 2;
+  return rank(left.category) - rank(right.category) || left.name.localeCompare(right.name, "zh") || left.code.localeCompare(right.code);
+}
+
+function compactMenuPermissionName(name: string): string {
+  return name.replace(/^(平台|机构|企业)\s*/, "").replace(/菜单$/, "").trim();
+}
+
+function buildPermissionTree(
+  allPermissions: readonly PermissionLike[],
+  menus: MenuTreeSource,
+  category: PermissionCategory
+): { treeData: DataNode[]; parentKeys: string[]; permissionIds: Set<string>; permissionNodeIds: Map<string, string> } {
+  const visible = allPermissions.filter((permission) => category === "all" || permission.category === category);
+  const visibleById = new Map(visible.map((permission) => [permission.id, permission]));
+  const allByCode = new Map<string, PermissionLike[]>();
+  for (const permission of allPermissions) allByCode.set(permission.code, [...(allByCode.get(permission.code) ?? []), permission]);
+
+  const managementNamesByCode = new Map<string, string[]>();
+  const activeManagement = menus.management.filter((item) => item.status !== "disabled");
+  for (const item of activeManagement) for (const code of item.permissionKeys) {
+    managementNamesByCode.set(code, [...(managementNamesByCode.get(code) ?? []), item.name]);
+  }
+
+  const assignments = new Map<string, Assignment[]>();
+  const assignedToNode = new Map<string, PermissionLike[]>();
+  const add = (permission: PermissionLike, permissionPlacements: Assignment[]) => {
+    if (!visibleById.has(permission.id) || assignments.has(permission.id) || !permissionPlacements.length) return;
+    assignments.set(permission.id, permissionPlacements);
+    for (const assignment of permissionPlacements) {
+      assignedToNode.set(assignment.nodeKey, [...(assignedToNode.get(assignment.nodeKey) ?? []), permission]);
+    }
+  };
+
+  // Category=menu permissions follow exact menu permissionKeys/menu_key values.
+  // Shared permission IDs are projected into each exact menu that declares the association.
+  for (const permission of allPermissions.filter((item) => item.category === "menu")) {
+    const candidates: Array<{ directory: "workbench" | "management"; menuKey: string; name: string }> = [];
+    for (const item of activeManagement) if (item.permissionKeys.includes(permission.code)) candidates.push({ directory: "management", menuKey: item.menuKey, name: item.name });
+    for (const item of menus.workbench) if (item.status !== "disabled" && item.menuKey === permission.code) candidates.push({ directory: "workbench", menuKey: item.menuKey, name: item.name });
+    add(permission, placements(candidates.length ? candidates : auditedMenuCandidates(permission.code, menus, activeManagement)));
+  }
+
+  // Route page gates are the evidence for assigning page/action resources to
+  // management modules. For a genuinely aggregated route, the resource label
+  // becomes a capability subsection rather than an invented navigation item.
+  const managementRouteResources = new Map<string, Array<{ directory: "management"; menuKey: string; name: string }>>();
+  for (const item of activeManagement) {
+    if (item.nodeType === "group") continue;
+    const gateResources = new Set(item.permissionKeys.flatMap((code) => (allByCode.get(code) ?? [])
+      .filter((permission) => permission.category !== "menu").map((permission) => permission.resource)));
+    for (const resource of gateResources) managementRouteResources.set(resource, [...(managementRouteResources.get(resource) ?? []), { directory: "management", menuKey: item.menuKey, name: item.name }]);
+  }
+  for (const [resource, menuKeys] of Object.entries(AUDITED_RESOURCE_BINDINGS)) {
+    for (const menuKey of menuKeys) {
+      const item = activeManagement.find((candidate) => candidate.menuKey === menuKey && candidate.status !== "disabled");
+      if (!item) continue;
+      managementRouteResources.set(resource, [...(managementRouteResources.get(resource) ?? []), { directory: "management", menuKey: item.menuKey, name: item.name }]);
+    }
+  }
+  const workbenchResourceNodes = new Map<string, Array<{ directory: "workbench"; menuKey: string; name: string }>>();
+  for (const [menuKey, resources] of Object.entries(WORKBENCH_RESOURCE_BINDINGS)) {
+    const menu = menus.workbench.find((item) => item.menuKey === menuKey && item.status !== "disabled");
+    if (!menu) continue;
+    for (const resource of resources) workbenchResourceNodes.set(resource, [...(workbenchResourceNodes.get(resource) ?? []), { directory: "workbench", menuKey, name: menu.name }]);
+  }
+  for (const permission of allPermissions.filter((item) => item.category === "page" || item.category === "action")) {
+    const candidates = [...(managementRouteResources.get(permission.resource) ?? []), ...(workbenchResourceNodes.get(permission.resource) ?? [])];
+    add(permission, placements(candidates));
+  }
+
+  const assignedIds = new Set(assignments.keys());
+  const unmatched = visible.filter((permission) => !assignedIds.has(permission.id));
+  const parentKeys: string[] = [];
+  const structure: DataNode[] = [];
+  const permissionNodeIds = new Map<string, string>();
+  const categoryNodes = (nodeKey: string, menuName: string): DataNode[] => {
+    const permissions = [...(assignedToNode.get(nodeKey) ?? [])].sort(permissionOrder);
+    const grouped = new Map<string, PermissionLike[]>();
+    for (const permission of permissions) {
+      const groupKey = permission.category === "menu" ? "" : permission.resource;
+      grouped.set(groupKey, [...(grouped.get(groupKey) ?? []), permission]);
+    }
+    const resourceGroups = [...grouped.entries()].filter(([key]) => key);
+    const capabilityGrouping = resourceGroups.length > 1;
+    const output: DataNode[] = [];
+    for (const [resource, items] of grouped) {
+      const leaves = items.map((permission): DataNode => {
+        const permissionAssignments = assignments.get(permission.id)!;
+        const assignment = permissionAssignments.find((item) => item.nodeKey === nodeKey)!;
+        let label: string | undefined;
+        if (permission.category === "menu") label = assignment.displayName ?? (assignment.shared
+          ? `共用入口：${assignment.relatedNames.join("、")}`
+          : `访问${menuName}`);
+        else if (assignment.shared) {
+          label = `共用能力：${assignment.relatedNames.join("、")}`;
+        }
+        const displayKey = permissionAssignments.length > 1 ? `permission-occurrence:${nodeKey}:${permission.id}` : permission.id;
+        permissionNodeIds.set(displayKey, permission.id);
+        return { key: displayKey, title: permissionTitle(permission, allPermissions, label), isLeaf: true };
+      });
+      if (resource && capabilityGrouping) {
+        const key = `permission-capability:${nodeKey}:${resource}`;
+        parentKeys.push(key);
+        output.push({ key, title: withCount(RESOURCE_LABELS[resource] ?? "相关能力", leaves), selectable: false, checkable: permissionLeafCount(leaves, permissionNodeIds) > 0, children: leaves });
+      } else output.push(...leaves);
+    }
+    return output;
+  };
+
+  const convert = (nodes: readonly WorkbenchMenuTreeNode[], directory: "workbench" | "management"): DataNode[] => nodes.flatMap((node) => {
+    const key = `menu-tree:${directory}:${node.menuKey}`;
+    const children = [...categoryNodes(key, node.name), ...convert(node.children, directory)];
+    const inactive = node.status === "disabled";
+    const label = inactive ? `${node.name}（已停用）` : node.name;
+    // Keep the complete directory visible in each category, including modules
+    // with no permission of that category. Empty structure never receives a checkbox.
+    return [{
+      key,
+      title: withCount(label, children),
+      selectable: false,
+      checkable: permissionLeafCount(children, permissionNodeIds) > 0,
+      children
+    }];
+  });
+
+  const workbenchTree = convert(buildWorkbenchMenuTree(menus.workbench), "workbench");
+  const managementTree = convert(menuTreeSources(menus).management, "management");
+  const buildUnmatched = (): DataNode[] => {
+    const domains = new Map<string, Map<string, PermissionLike[]>>();
+    for (const permission of unmatched) {
+      const domain = resourceDomain(permission.resource);
+      if (!domains.has(domain)) domains.set(domain, new Map());
+      const resources = domains.get(domain)!;
+      resources.set(permission.resource, [...(resources.get(permission.resource) ?? []), permission]);
+    }
+    return [...domains.entries()].sort(([a], [b]) => DOMAIN_ORDER.indexOf(a as typeof DOMAIN_ORDER[number]) - DOMAIN_ORDER.indexOf(b as typeof DOMAIN_ORDER[number]))
+      .map(([domain, resources]) => {
+        const children = [...resources.entries()].sort(([a], [b]) => (RESOURCE_LABELS[a] ?? a).localeCompare(RESOURCE_LABELS[b] ?? b, "zh"))
+          .map(([resource, items]) => {
+            const leaves = [...items].sort(permissionOrder).map((permission): DataNode => ({
+              key: permission.id,
+              title: permissionTitle(permission, allPermissions, permission.category === "menu" ? compactMenuPermissionName(permission.name) : undefined),
+              isLeaf: true
+            }));
+            for (const leaf of leaves) permissionNodeIds.set(String(leaf.key), String(leaf.key));
+            if (leaves.length === 1) return leaves[0];
+            const key = `permission-unlinked-resource:${domain}:${resource}`;
+            parentKeys.push(key);
+            return { key, title: withCount(RESOURCE_LABELS[resource] ?? "其他权限", leaves), selectable: false, checkable: true, children: leaves };
+          });
+        const key = `permission-unlinked-domain:${domain}`;
+        parentKeys.push(key);
+        return { key, title: withCount(DOMAIN_LABELS[domain as typeof DOMAIN_ORDER[number]], children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children };
+      });
+  };
+
+  if (workbenchTree.length) {
+    const key = "menu-directory:workbench";
+    parentKeys.push(key);
+    const children = [...categoryNodes(key, "工作台"), ...workbenchTree];
+    structure.push({ key, title: withCount("工作台", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  if (managementTree.length) {
+    const key = "menu-directory:management";
+    parentKeys.push(key);
+    const children = [...categoryNodes(key, "管理中心"), ...managementTree];
+    structure.push({ key, title: withCount("管理中心", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  if (unmatched.length) {
+    const key = "menu-directory:unlinked";
+    parentKeys.push(key);
+    const children = buildUnmatched();
+    structure.push({ key, title: withCount("公共能力", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  const permissionIds = new Set(visible.map((permission) => permission.id));
+  return { treeData: structure, parentKeys, permissionIds, permissionNodeIds };
+}
+
+export function buildPermissionTreeData(
+  permissions: readonly PermissionLike[],
+  menus: MenuTreeSource = { workbench: [], management: [] },
+  category: string = "all"
+): { treeData: DataNode[]; parentKeys: string[]; permissionIds: Set<string>; permissionNodeIds: Map<string, string> } {
+  const normalizedCategory: PermissionCategory = category === "action" || category === "menu" || category === "page" ? category : "all";
+  return buildPermissionTree(permissions, menus, normalizedCategory);
+}
diff --git a/plugins/ky-access-management/src/role-permission-contract.test.mjs b/plugins/ky-access-management/src/role-permission-contract.test.mjs
