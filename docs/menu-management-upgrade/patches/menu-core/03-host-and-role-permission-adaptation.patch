+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import { enableWorkbenchMenu } from "./api.ts";
+import { menuStatusTarget } from "./menu-action-grid.ts";
+import { runWithPendingMenuStatus } from "./menu-management-contract.ts";
+
+const source = (name) => readFile(new URL(name, import.meta.url), "utf8");
+
+test("status target only toggles active and disabled menu records", () => {
+  assert.equal(menuStatusTarget("active"), "disabled");
+  assert.equal(menuStatusTarget("disabled"), "active");
+  assert.equal(menuStatusTarget("archived"), null);
+  assert.equal(menuStatusTarget(""), null);
+});
+
+test("workbench enable sends encoded menu key, a fresh idempotency key, and the expected revision", async () => {
+  const calls = [];
+  const client = { request: async (...args) => { calls.push(args); return { status: "active" }; } };
+  const key = "menu.workbench.example/child";
+
+  await enableWorkbenchMenu(client, key, 17);
+  await enableWorkbenchMenu(client, key, 18);
+
+  assert.equal(calls.length, 2);
+  for (const [path, options] of calls) {
+    assert.equal(path, "/api/v1/workbench-menus/menu.workbench.example%2Fchild/enable");
+    assert.equal(options.method, "POST");
+    assert.ok(options.headers["Idempotency-Key"]);
+  }
+  assert.equal(calls[0][1].body.expectedRevision, 17);
+  assert.equal(calls[1][1].body.expectedRevision, 18);
+  assert.notEqual(calls[0][1].headers["Idempotency-Key"], calls[1][1].headers["Idempotency-Key"]);
+});
+
+test("failed menu status request always clears the pending/loading state", async () => {
+  const pending = new Set();
+  const snapshots = [];
+  await assert.rejects(
+    runWithPendingMenuStatus("menu.workbench.example", pending, keys => snapshots.push(keys), async () => {
+      throw new Error("request failed");
+    }),
+    /request failed/
+  );
+  assert.equal(pending.has("menu.workbench.example"), false);
+  assert.deepEqual(snapshots.map(keys => [...keys]), [["menu.workbench.example"], []]);
+});
+
+test("both menu directories render the shared accessible status control with their existing permission gates", async () => {
+  const [component, workbench, management] = await Promise.all([
+    source("./menu-catalog-components.tsx"),
+    source("./pages/workbench-menus-page.tsx"),
+    source("./pages/management-menus-tab.tsx")
+  ]);
+
+  assert.match(component, /export function MenuStatusCell/);
+  assert.match(component, /aria-label=\{`\$\{target === "disabled" \? "停用" : "启用"\}此菜单`\}/);
+  assert.match(component, /if \(!canToggle \|\| !target\) return tag/);
+  assert.match(component, /loading=\{loading\}[\s\S]*disabled=\{loading\}/);
+  assert.match(workbench, /<MenuStatusCell[\s\S]*canToggle=\{canToggle\}[\s\S]*loading=\{statusLoading\(item\)\}/);
+  assert.match(workbench, /const canToggle = active \? canWorkbenchDisable : canWorkbenchUpdate && !isWorkbenchMenuGroup\(item\)/);
+  assert.match(workbench, /queryClient\.invalidateQueries\(\{ queryKey: \["workbench-menu-catalog"\] \}\)/);
+  assert.match(workbench, /enableMenu\.mutateAsync\(item\)/);
+  assert.match(workbench, /mutationFn: \(item: WorkbenchMenu\) => enableWorkbenchMenu\(client, item\.menuKey, item\.revision\)/);
+  assert.doesNotMatch(workbench, /client\.request\(`\/api\/v1\/workbench-menus\/\$\{encodeURIComponent\(item\.menuKey\)\}\/enable`/);
+  assert.match(workbench, /disableMenu\.mutateAsync\(item\)/);
+  assert.match(management, /<MenuStatusCell[\s\S]*canToggle=\{canToggle\}[\s\S]*pendingStatusKeys\.has\(item\.menuKey\)/);
+  assert.match(management, /item\.status === "active"[\s\S]*canDisable && permissions\.can\("platform\.workbench_menus\.disable"\)/);
+  assert.match(management, /await setStatus\.mutateAsync\(\{ item, status \}\)/);
+  assert.match(management, /queryClient\.invalidateQueries\(\{ queryKey: \["management-menu-catalog"\] \}\)/);
+  assert.match(management, /pendingStatusRef\.current\.has\(item\.menuKey\)/);
+});
