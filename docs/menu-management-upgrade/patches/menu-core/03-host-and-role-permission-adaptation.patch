+const find = (nodes, key) => {
+  for (const node of nodes) {
+    if (node.key === key) return node;
+    const nested = find(node.children ?? [], key);
+    if (nested) return nested;
+  }
+  return undefined;
+};
+const countKey = (nodes, key) => nodes.reduce((count, node) => count + (node.key === key ? 1 : 0) + countKey(node.children ?? [], key), 0);
+
