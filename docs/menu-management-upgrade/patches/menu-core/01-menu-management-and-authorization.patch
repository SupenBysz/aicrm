+export interface WorkbenchMenu {
+  menuKey: string; name: string; icon: string; parentKey: string | null; sortOrder: number;
+  workspaceTypes: string[]; routeKey: string | null; status: "active" | "disabled"; revision: number;
+}
+export interface ManagementMenu {
+  menuKey: string; name: string; icon: string; parentKey: string | null; sortOrder: number;
+  workspaceTypes: string[]; routePath: string | null; permissionKeys: string[];
+  status: "active" | "disabled"; revision: number;
+}
+export type ManagementMenuInput = Omit<ManagementMenu, "status" | "revision">;
+export function listManagementMenus(client: RequestClient): Promise<ManagementMenu[]> {
+  return client.request<ManagementMenu[]>("/api/v1/management-menus");
+}
+export function createManagementMenu(client: RequestClient, input: ManagementMenuInput): Promise<ManagementMenu> {
+  return client.request<ManagementMenu>("/api/v1/management-menus", { method: "POST", headers: { "Idempotency-Key": idempotencyKey() }, body: input });
+}
+export function updateManagementMenu(client: RequestClient, key: string, input: ManagementMenuInput & { expectedRevision: number }): Promise<ManagementMenu> {
+  return client.request<ManagementMenu>(`/api/v1/management-menus/${encodeURIComponent(key)}`, { method: "PATCH", headers: { "Idempotency-Key": idempotencyKey() }, body: input });
+}
+export function setManagementMenuStatus(client: RequestClient, key: string, status: "active" | "disabled", expectedRevision: number): Promise<unknown> {
+  const action = status === "active" ? "enable" : "disable";
+  return client.request(`/api/v1/management-menus/${encodeURIComponent(key)}/${action}`, { method: "POST", headers: { "Idempotency-Key": idempotencyKey() }, body: { expectedRevision } });
+}
+export interface WorkbenchMenuGrantSet {
+  workspaceType: string; workspaceId: string; parentWorkspaceType: string; parentWorkspaceId: string;
+  menuKeys: string[]; effectiveMenuKeys?: string[]; revision: number;
+}
+export interface WorkbenchMenuOverrides { membershipId: string; allow: string[]; deny: string[]; revision: number; }
+export type MenuDirectoryType = "workbench" | "management";
+export interface MenuAllowlistWorkspace { workspaceType: string; workspaceId: string; name: string; }
+export interface MenuAllowlistCandidateRole { id: string; name: string; code: string; }
+export interface MenuAllowlistCandidateMembership { id: string; displayName: string; }
+export interface MenuAllowlistCandidates { workspaceType: string; workspaceId: string; roles: MenuAllowlistCandidateRole[]; memberships: MenuAllowlistCandidateMembership[]; }
+export interface MenuWorkspaceAllowlist { directoryType: MenuDirectoryType; menuKey: string; workspaceType: string; workspaceId: string; enabled: boolean; roleIds: string[]; membershipIds: string[]; revision: number; updatedAt?: string; }
+
+function idempotencyKey(): string { return `wm-${crypto.randomUUID()}`; }
+export function listWorkbenchMenus(client: RequestClient): Promise<WorkbenchMenu[]> {
+  return client.request<WorkbenchMenu[]>("/api/v1/workbench-menus");
+}
+export function createWorkbenchMenu(client: RequestClient, input: Omit<WorkbenchMenu,"status"|"revision">): Promise<WorkbenchMenu> {
