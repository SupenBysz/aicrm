+func (s *Server) workbenchTargetAllowed(r *http.Request, wc wsContext, targetType, targetID string, write bool) bool {
+	if targetType == "agency" && wc.WorkspaceType == "platform" && wc.WorkspaceID == "platform_root" && targetID != "" {
+		return true
+	}
+	if targetType == "enterprise" && wc.WorkspaceType == "agency" && targetID != "" {
+		var agencyID string
+		err := s.store.LookupEnterpriseAgency(r.Context(), targetID, &agencyID)
+		return err == nil && workbenchTargetRelationshipAllowed(wc.WorkspaceType, wc.WorkspaceID, targetType, targetID, agencyID, write)
+	}
+	return workbenchTargetRelationshipAllowed(wc.WorkspaceType, wc.WorkspaceID, targetType, targetID, "", write)
+}
+
+func workbenchTargetRelationshipAllowed(actorType, actorID, targetType, targetID, parentAgencyID string, write bool) bool {
+	if targetID == "" {
+		return false
+	}
+	if !write && actorType == targetType && actorID == targetID {
+		return true
+	}
+	if targetType == "agency" {
+		return actorType == "platform" && actorID == "platform_root"
+	}
+	if targetType == "enterprise" {
+		if actorType == "agency" {
+			return parentAgencyID != "" && parentAgencyID == actorID
+		}
+		return !write && actorType == "enterprise" && actorID == targetID
+	}
+	return false
+}
