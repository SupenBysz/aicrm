+func TestInternalWorkbenchMenuKeysRejectsUntrustedHeadersAndMissingStore(t *testing.T) {
+	s := New(config.Config{InternalToken: "workbench-internal-test"})
+	request := httptest.NewRequest(http.MethodPost, "/internal/v1/workbench-menu-keys", strings.NewReader(`{}`))
+	request.Header.Set("X-KY-Request-Id", "req-workbench-1")
+	recorder := httptest.NewRecorder()
+	s.internalWorkbenchMenuKeys(recorder, request)
+	if recorder.Code != http.StatusUnauthorized || !strings.Contains(recorder.Body.String(), "internal_unauthorized") {
+		t.Fatalf("missing internal auth status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+
+	request = httptest.NewRequest(http.MethodPost, "/internal/v1/workbench-menu-keys", strings.NewReader(`{}`))
+	request.Header.Set("X-KY-Internal-Token", "workbench-internal-test")
+	request.Header.Set("X-KY-Request-Id", "req-workbench-2")
+	request.Header.Set("X-KY-Workspace-Id", "forged")
+	recorder = httptest.NewRecorder()
+	s.internalWorkbenchMenuKeys(recorder, request)
+	if recorder.Code != http.StatusBadRequest || !strings.Contains(recorder.Body.String(), "internal_header_forbidden") {
+		t.Fatalf("workspace override status=%d body=%s", recorder.Code, recorder.Body.String())
