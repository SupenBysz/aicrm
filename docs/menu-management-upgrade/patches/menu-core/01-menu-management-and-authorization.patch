@@ -0,0 +1,34 @@
+import type { RegisteredManagementMenu } from "@ky/admin-core";
+import type { ManagementMenu } from "./api";
+
+export type ManagementMenuRow = ManagementMenu & { registered: boolean; persisted: boolean };
+
+export function mergeManagementMenuRegistry(
+  registry: readonly RegisteredManagementMenu[],
+  stored: readonly ManagementMenu[]
+): ManagementMenuRow[] {
+  const storedByKey = new Map(stored.map((row) => [row.menuKey, row]));
+  const seen = new Set<string>();
+  const rows: ManagementMenuRow[] = registry.map((registered): ManagementMenuRow => {
+    seen.add(registered.menuKey);
+    const persisted = storedByKey.get(registered.menuKey);
+    return {
+      menuKey: registered.menuKey,
+      name: persisted?.name ?? registered.name,
+      icon: persisted?.icon || registered.icon,
+      parentKey: registered.parentKey,
+      sortOrder: persisted?.sortOrder ?? registered.sortOrder,
+      workspaceTypes: registered.workspaceTypes,
+      routePath: registered.routePath,
+      permissionKeys: registered.permissionKeys,
+      status: persisted?.status ?? "active",
+      revision: persisted?.revision ?? 0,
+      registered: true,
+      persisted: Boolean(persisted)
+    };
+  });
+  for (const row of stored) {
+    if (!seen.has(row.menuKey)) rows.push({ ...row, registered: false, persisted: true });
+  }
+  return rows;
+}
