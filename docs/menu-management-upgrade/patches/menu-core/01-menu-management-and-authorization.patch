+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+const source = await readFile(new URL("./app.tsx", import.meta.url), "utf8");
+const core = await readFile(new URL("../../../packages/ky-admin-core/src/permissions.tsx", import.meta.url), "utf8");
+const workbench = await readFile(new URL("./pages/workbench.tsx", import.meta.url), "utf8");
+
+test("direct plugin route denies missing menuKey independently of page permission", () => {
+  const guard = source.match(/function GuardedPluginRoute\([\s\S]*?\n}\n\nfunction menuVisible/);
+  assert.ok(guard, "Host direct route guard must remain present");
+  assert.match(guard[0], /permissions\.canMenu\(requiredMenuKey\)/);
+  assert.match(guard[0], /requiredAnyMenuKeys\.some\(\(key\) => permissions\.canMenu\(key\)\)/);
+  assert.match(guard[0], /status="403"/);
+  assert.match(guard[0], /requiredAnyPermissions/);
+  assert.match(guard[0], /<PermissionBoundary/);
+});
+
+test("management directory allowlist is an additional exact-item gate for sidebars and direct routes", async () => {
+  const registryModule = await import("../../../packages/ky-admin-core/src/management-menu-registry.ts");
+  const { buildManagementMenuRegistry, managementMenuId, managementMenuIdsForRoute, managementMenuAllowed, managementRouteAllowed } = registryModule;
+  const shared = "menu.platform.ai_configuration";
+  const plugin = {
+    name: "ky-ai-configuration",
+    menus: [
+      { key: "ky-ai-configuration.providers", label: "供应商", path: "/ai-providers", menuKey: shared, requiredPermission: "platform.ai_providers.view" },
+      { key: "ky-ai-configuration.models", label: "模型", path: "/ai-models", menuKey: shared, requiredPermission: "platform.ai_models.view" }
+    ],
+    routes: [
+      { path: "/ai-providers", requiredPermission: "platform.ai_providers.view", element: null },
+      { path: "/ai-models", requiredPermission: "platform.ai_models.view", element: null }
+    ]
+  };
+  const secondPlugin = {
+    name: "other-plugin",
+    menus: [{ key: "other.providers", label: "另一个页面", path: "/ai-providers", menuKey: shared, requiredPermission: "platform.ai_providers.view" }]
+  };
+  const registry = buildManagementMenuRegistry([plugin, secondPlugin]);
+  const providerID = managementMenuId(plugin.name, plugin.menus[0].key);
+  const modelID = managementMenuId(plugin.name, plugin.menus[1].key);
+  const allowed = [providerID];
+
+  // Shared parent permission remains available, while item identity is a separate deny-only gate.
+  assert.equal(plugin.menus[0].menuKey, plugin.menus[1].menuKey);
+  assert.equal(managementMenuAllowed(providerID, allowed), true);
+  assert.equal(managementMenuAllowed(modelID, allowed), false);
+  assert.deepEqual(managementMenuIdsForRoute(registry, "/ai-providers", "platform", plugin.name), [providerID]);
+  assert.deepEqual(managementMenuIdsForRoute(registry, "/ai-models", "platform"), [modelID]);
+  assert.equal(managementRouteAllowed([providerID], allowed), true);
+  assert.equal(managementRouteAllowed([modelID], allowed), false);
+
+  // Missing resolver data denies mapped directory routes, but does not add a gate to non-directory routes.
+  assert.equal(managementRouteAllowed([modelID], []), false);
+  assert.equal(managementRouteAllowed([], []), false, "known directory path with no current-workspace entry must fail closed");
+  assert.equal(managementRouteAllowed(null, []), true, "routes absent from the management directory preserve existing behavior");
+  assert.equal(managementMenuAllowed(providerID, undefined), false);
+  const directGuard = source.match(/function GuardedPluginRoute\([\s\S]*?\n}\n\nfunction menuVisible/);
+  assert.ok(directGuard);
+  assert.match(directGuard[0], /managementMenuIdsForRoute\(managementMenuRegistry, route\.path, workspaceType, pluginName\)/);
+  assert.match(directGuard[0], /managementRouteAllowed\(managementIDs, currentWorkspace\?\.managementMenuIds\)/);
+  assert.match(directGuard[0], /status="403"/);
+  assert.match(source, /managementMenuId\(plugin\.name, menu\.key\)/, "sidebar must use the same registry ID formula");
+});
+
+test("navigation visibility checks page and action permissions while preserving menu assignment", () => {
+  const visible = source.match(/function menuVisible\([\s\S]*?\n}\n\nfunction pathActive/);
+  assert.ok(visible, "workbench navigation visibility helper must remain present");
+  assert.match(visible[0], /menuKeys\.includes\(menu\.menuKey\)/);
+  assert.match(visible[0], /perms\.includes\(permission\)/);
+  assert.match(visible[0], /actionPerms\.includes\(permission\)/);
+  assert.match(visible[0], /requiredAnyPermissions\?\.length && !menu\.requiredAnyPermissions\.some\(hasPermission\)/);
+  assert.match(source, /managementMenuId\(plugin\.name, menu\.key\)/);
+  assert.match(source, /currentWorkspace\.managementMenuIds \?\? \[\]/);
+  assert.match(source, /managementRouteAllowed\(managementIDs, currentWorkspace\?\.managementMenuIds\)/);
+  assert.match(source, /managementMenuIdsForRoute\(managementMenuRegistry, route\.path, workspaceType, pluginName\)/);
+
+  // An action-only permission (absent from page permissions) must still expose
+  // its navigation item; menuKey assignment remains an independent gate.
+  const pagePermissions = [];
+  const actionPermissions = ["platform.workbench_menus.view"];
+  const required = "platform.workbench_menus.view";
+  assert.equal(pagePermissions.includes(required) || actionPermissions.includes(required), true);
+  assert.equal([].includes("menu.platform.access.workbench_menus"), false);
+  assert.match(core, /canMenu: \(menuKey\) => Boolean\(menuKeys && menuKeys\.includes\(menuKey\)\)/);
+});
+
+test("built-in workbench navigation and direct pages share stable menu authorization keys", () => {
+  const entries = [
+    ["workbench.overview", "menu.workbench.overview", "概览", "workbenchPathFor()"],
+    ["workbench.todos", "menu.workbench.todos", "待办事项", 'workbenchPathFor("todos")'],
+    ["workbench.messages", "menu.workbench.messages", "我的消息", 'workbenchPathFor("messages")'],
+    ["workbench.shortcuts", "menu.workbench.shortcuts", "快捷入口", 'workbenchPathFor("shortcuts")']
+  ];
+  const nav = source.slice(source.indexOf("const builtinWorkbenchNavMetas"), source.indexOf("// Build the sidebar", source.indexOf("const builtinWorkbenchNavMetas")));
+  for (const [key, menuKey, label, target] of entries) {
+    const matching = nav.split(/\r?\n/).filter((line) => line.includes(`menuKey: "${menuKey}"`));
+    assert.equal(matching.length, 1, `${key} must have exactly one navigation definition`);
+    assert.ok(matching[0].includes(`menuKey: "${menuKey}"`), `${key} must use its catalog key`);
+    assert.ok(matching[0].includes(`label: "${label}"`), `${key} label changed`);
+    assert.ok(matching[0].includes(`target: ${target}`), `${key} target changed`);
+    assert.match(source, /visibleBuiltinWorkbenchNavMetas = builtinWorkbenchNavMetas\.filter\(\(menu\) =>\s*menuVisible\(/);
+    const section = key === "workbench.overview" ? "overview" : key.slice("workbench.".length);
+    assert.ok(workbench.includes(`${section}: "${menuKey}"`), `${key} direct route must use the same catalog key`);
+  }
+  assert.match(workbench, /permissions\.canMenu\(requiredMenuKey\)/);
+  assert.match(workbench, /status="403"/);
+  assert.match(workbench, /data-workbench-section=\{section\}/);
+});
