+func workbenchMenuPermissionCodesTx(ctx context.Context, tx *sql.Tx, ids []string) ([]string, error) {
+	if len(ids) == 0 {
+		return []string{}, nil
+	}
+	placeholders := make([]string, len(ids))
+	args := make([]any, len(ids))
+	for i, id := range ids {
+		placeholders[i] = "$" + itoa(i+1)
+		args[i] = id
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT code FROM ky_permission WHERE id IN (`+strings.Join(placeholders, ",")+`) AND category='menu' AND resource='workbench' AND status='normal' ORDER BY code`, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return collectMenuKeys(rows)
+}
+func workbenchEligibleMenuKeysTx(ctx context.Context, tx *sql.Tx, ws string) ([]string, error) {
+	rows, err := tx.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' AND route_key IS NOT NULL AND workspace_types @> to_jsonb(ARRAY[$1::text]) ORDER BY menu_key`, ws)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return collectMenuKeys(rows)
+}
