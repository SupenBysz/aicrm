+import type { ManagementMenu, WorkbenchMenu } from "./api";
+import { buildWorkbenchMenuTree } from "./workbench-menu-view";
+import { type ManagementMenuRow } from "./management-menu-merge";
+export { mergeManagementMenuRegistry, type ManagementMenuRow } from "./management-menu-merge";
+export type ManagementMenuTreeNode = ManagementMenuRow & { children: ManagementMenuTreeNode[] };
+
+export function buildManagementMenuTree(items: readonly ManagementMenuRow[]) {
+  const compatible: WorkbenchMenu[] = items.map((item) => ({
+    menuKey: item.menuKey,
+    name: item.name,
+    icon: item.icon,
+    parentKey: item.parentKey,
+    sortOrder: item.sortOrder,
+    workspaceTypes: item.workspaceTypes,
+    routeKey: item.routePath,
+    status: item.status,
+    revision: item.revision
+  }));
+  const tree = buildWorkbenchMenuTree(compatible);
+  const byKey = new Map(items.map((item) => [item.menuKey, item]));
+  const mapNode = (node: (typeof tree)[number]): ManagementMenuTreeNode => ({
+    ...byKey.get(node.menuKey)!,
+    children: node.children.map(mapNode)
+  });
+  return tree.map(mapNode);
+}
diff --git a/plugins/ky-access-management/src/menu-action-grid.ts b/plugins/ky-access-management/src/menu-action-grid.ts
new file mode 100644
index 0000000..0ffb1be
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-action-grid.ts
@@ -0,0 +1,33 @@
+// Ant Design small buttons need about 72px for four 14px Chinese glyphs,
+// 7px horizontal padding on both sides, and 1px borders. The table cell has
+// 8px inset on each side, so 336px yields 80px per grid cell after the inset.
+export const MENU_ACTION_COLUMN_WIDTH = 336;
+export const MENU_ACTION_GRID_COLUMNS = 4;
+export const MENU_ACTION_CELL_INSET = 8;
+export const MENU_ACTION_MIN_BUTTON_WIDTH = 72;
+export const MENU_ACTION_GRID_CELL_WIDTH = (MENU_ACTION_COLUMN_WIDTH - MENU_ACTION_CELL_INSET * 2) / MENU_ACTION_GRID_COLUMNS;
+
+export interface MenuCatalogAction {
+  key: string;
+  label: string;
+  onClick: () => void;
+  permission?: string;
+  visible?: boolean;
+  danger?: boolean;
+  disabled?: boolean;
+  loading?: boolean;
+}
+
+export function filterMenuActions(actions: MenuCatalogAction[], can: (permission: string) => boolean): MenuCatalogAction[] {
+  return actions.filter((action) => action.visible !== false && (!action.permission || can(action.permission)));
+}
+
+export function layoutMenuActions(actions: MenuCatalogAction[]) {
+  const overflow = actions.length > 8 ? actions.slice(7) : [];
+  const visible = overflow.length ? actions.slice(0, 7) : actions;
+  return {
+    visible,
+    overflow,
+    rows: visible.length + (overflow.length ? 1 : 0) > 4 ? 2 : 1
+  };
+}
diff --git a/plugins/ky-access-management/src/menu-allowlist-drawer.tsx b/plugins/ky-access-management/src/menu-allowlist-drawer.tsx
new file mode 100644
index 0000000..0a70a3c
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-allowlist-drawer.tsx
@@ -0,0 +1,63 @@
+import { useEffect, useMemo, useState } from "react";
+import { Alert, App as AntdApp, Button, Drawer, Select, Space, Switch, Typography } from "antd";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useRequestClient } from "@ky/admin-core";
+import { getMenuAllowlistCandidates, getMenuWorkspaceAllowlist, listMenuAllowlistTargets, putMenuWorkspaceAllowlist, type MenuDirectoryType, type MenuWorkspaceAllowlist } from "./api";
+
+type Props = { open: boolean; directoryType: MenuDirectoryType; menuKey: string; menuName: string; onClose: () => void };
+
+export function MenuAllowlistDrawer({ open, directoryType, menuKey, menuName, onClose }: Props) {
+  const client = useRequestClient();
+  const { message, modal } = AntdApp.useApp();
+  const queryClient = useQueryClient();
+  const targets = useQuery({ queryKey: ["menu-allowlist-targets"], queryFn: () => listMenuAllowlistTargets(client), enabled: open });
+  const [target, setTarget] = useState("");
+  const selected = useMemo(() => targets.data?.find((item) => `${item.workspaceType}:${item.workspaceId}` === target), [target, targets.data]);
+  useEffect(() => { if (!selected && targets.data?.length) setTarget(`${targets.data[0].workspaceType}:${targets.data[0].workspaceId}`); }, [selected, targets.data]);
+  const config = useQuery({
+    queryKey: ["menu-allowlist", directoryType, menuKey, selected?.workspaceType, selected?.workspaceId],
+    queryFn: () => getMenuWorkspaceAllowlist(client, directoryType, menuKey, selected!.workspaceType, selected!.workspaceId),
+    enabled: open && Boolean(selected)
+  });
+  const candidates = useQuery({
+    queryKey: ["menu-allowlist-candidates", selected?.workspaceType, selected?.workspaceId],
+    queryFn: () => getMenuAllowlistCandidates(client, selected!.workspaceType, selected!.workspaceId),
+    enabled: open && Boolean(selected)
+  });
+  const [enabled, setEnabled] = useState(false);
+  const [roleIds, setRoleIds] = useState<string[]>([]);
+  const [membershipIds, setMembershipIds] = useState<string[]>([]);
+  const [loadedKey, setLoadedKey] = useState("");
+  const scopeKey = `${directoryType}:${menuKey}:${selected?.workspaceType ?? ""}:${selected?.workspaceId ?? ""}`;
+  useEffect(() => {
+    if (!config.data || loadedKey === scopeKey) return;
+    setEnabled(config.data.enabled); setRoleIds(config.data.roleIds ?? []); setMembershipIds(config.data.membershipIds ?? []); setLoadedKey(scopeKey);
+  }, [config.data, loadedKey, scopeKey]);
+  const save = useMutation({
+    mutationFn: (value: MenuWorkspaceAllowlist) => putMenuWorkspaceAllowlist(client, value),
+    onSuccess: async () => { message.success("菜单权限白名单已保存"); await queryClient.invalidateQueries({ queryKey: ["menu-allowlist", directoryType, menuKey] }); window.dispatchEvent(new Event("ky:bootstrap-refresh")); onClose(); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "保存白名单失败")
+  });
+  function confirmSave() {
+    if (!selected || !config.data) return;
+    const submit = () => save.mutate({ directoryType, menuKey, workspaceType: selected.workspaceType, workspaceId: selected.workspaceId, enabled, roleIds, membershipIds, revision: config.data!.revision });
+    if (enabled && roleIds.length === 0 && membershipIds.length === 0) {
+      modal.confirm({ title: "启用空白名单？", content: "启用后没有任何角色或成员命中，此菜单将对该工作区所有人隐藏，直接访问也会被拒绝。", okText: "确认启用", cancelText: "返回配置", onOk: submit });
+      return;
+    }
+    submit();
+  }
+  const roleOptions = (candidates.data?.roles ?? []).map((item) => ({ value: item.id, label: `${item.name}（${item.code}）` }));
+  const membershipOptions = (candidates.data?.memberships ?? []).map((item) => ({ value: item.id, label: `${item.displayName}（${item.id}）` }));
+  return <Drawer title={`菜单权限 · ${menuName}`} width={600} open={open} onClose={onClose} destroyOnHidden footer={<Space style={{ display: "flex", justifyContent: "flex-end" }}><Button onClick={onClose}>取消</Button><Button type="primary" loading={save.isPending} disabled={!selected || config.isLoading || candidates.isLoading} onClick={confirmSave}>保存</Button></Space>}>
+    {targets.isError || candidates.isError || config.isError ? <Alert type="error" showIcon message="白名单配置读取失败" description="请检查当前工作区权限和连接后重试。" /> : null}
+    <Space direction="vertical" size={16} style={{ width: "100%" }}>
+      <div><Typography.Text strong>目标工作区</Typography.Text><Select aria-label="目标工作区" style={{ width: "100%", marginTop: 6 }} value={target || undefined} loading={targets.isLoading} options={(targets.data ?? []).map((item) => ({ value: `${item.workspaceType}:${item.workspaceId}`, label: `${item.name}（${item.workspaceType} / ${item.workspaceId}）` }))} onChange={(value) => { setLoadedKey(""); setTarget(value); }} showSearch optionFilterProp="label" /></div>
+      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}><div><Typography.Text strong>启用白名单限制</Typography.Text><div><Typography.Text type="secondary">关闭时完全沿用现有菜单授权；启用后角色或成员任一命中即可通过白名单。</Typography.Text></div></div><Switch checked={enabled} onChange={setEnabled} aria-label="启用白名单限制" /></div>
+      {enabled && roleIds.length === 0 && membershipIds.length === 0 ? <Alert type="warning" showIcon message="当前白名单为空" description="保存并确认后，该工作区无人可访问此菜单。" /> : null}
+      <div><Typography.Text strong>角色白名单</Typography.Text><Select aria-label="角色白名单" mode="multiple" allowClear showSearch optionFilterProp="label" loading={candidates.isLoading} style={{ width: "100%", marginTop: 6 }} placeholder="搜索并选择目标工作区角色" value={roleIds} options={roleOptions} onChange={setRoleIds} /></div>
+      <div><Typography.Text strong>成员白名单</Typography.Text><Select aria-label="成员白名单" mode="multiple" allowClear showSearch optionFilterProp="label" loading={candidates.isLoading} style={{ width: "100%", marginTop: 6 }} placeholder="搜索并选择目标工作区成员" value={membershipIds} options={membershipOptions} onChange={setMembershipIds} /></div>
+      <Typography.Text type="secondary">成员项绑定工作区成员身份，不是全局用户账号。白名单只收窄现有角色、成员、工作区和页面权限，不会单独授予访问权。</Typography.Text>
+    </Space>
+  </Drawer>;
+}
