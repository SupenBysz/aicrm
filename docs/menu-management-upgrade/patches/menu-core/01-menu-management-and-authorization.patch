+package server
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/Kysion/KyaiCRM/services/ky-membership-service/internal/store"
+)
+
+func (s *Server) registerManagementMenuRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("GET /api/v1/management-menus", s.ws("platform", []string{"platform.workbench_menus.view"}, s.listManagementMenus))
+	mux.HandleFunc("POST /api/v1/management-menus", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.create"}, "management_menu.created", s.createManagementMenu))
+	mux.HandleFunc("PATCH /api/v1/management-menus/{menuKey}", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.update"}, "management_menu.updated", s.updateManagementMenu))
+	mux.HandleFunc("POST /api/v1/management-menus/{menuKey}/disable", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.disable"}, "management_menu.disabled", s.disableManagementMenu))
+	mux.HandleFunc("POST /api/v1/management-menus/{menuKey}/enable", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.update"}, "management_menu.enabled", s.enableManagementMenu))
+}
+
+func (s *Server) listManagementMenus(w http.ResponseWriter, r *http.Request, _ wsContext) {
+	items, err := s.store.ListManagementMenus(r.Context())
+	if err != nil {
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	writeData(w, r, items)
+}
+
+func (s *Server) createManagementMenu(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	var in store.ManagementMenuInput
+	if !decodeWorkbenchJSON(w, r, &in) {
+		s.auditWorkbenchResult(r, wc, "management_menu.created", "management_menu", "unknown", "failure")
+		return
+	}
+	if s.replayWorkbenchResponse(w, r, wc, "management-menu.create", in) {
+		return
+	}
+	item, err := s.store.CreateManagementMenu(r.Context(), in, wc.UserID)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.created", "management_menu", in.MenuKey, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	s.auditWorkbenchMutation(r, wc, "management_menu.created", "management_menu", item.MenuKey, map[string]any{}, item)
+	if !s.saveWorkbenchResponse(w, r, wc, "management-menu.create", in, item) {
+		return
+	}
+	writeData(w, r, item)
+}
+
+func (s *Server) updateManagementMenu(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	var in store.ManagementMenuInput
+	if !decodeWorkbenchJSON(w, r, &in) {
+		s.auditWorkbenchResult(r, wc, "management_menu.updated", "management_menu", r.PathValue("menuKey"), "failure")
+		return
+	}
+	in.MenuKey = r.PathValue("menuKey")
+	if s.replayWorkbenchResponse(w, r, wc, "management-menu.update", in) {
+		return
+	}
+	before, err := s.store.ManagementMenuSnapshot(r.Context(), in.MenuKey)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.updated", "management_menu", in.MenuKey, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	item, err := s.store.UpdateManagementMenu(r.Context(), in.MenuKey, in, wc.UserID)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.updated", "management_menu", in.MenuKey, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	s.auditWorkbenchMutation(r, wc, "management_menu.updated", "management_menu", item.MenuKey, before, item)
+	if !s.saveWorkbenchResponse(w, r, wc, "management-menu.update", in, item) {
+		return
+	}
+	writeData(w, r, item)
+}
+
+func (s *Server) disableManagementMenu(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	var in struct {
+		ExpectedRevision int64 `json:"expectedRevision"`
+	}
+	if !decodeWorkbenchJSON(w, r, &in) {
+		s.auditWorkbenchResult(r, wc, "management_menu.disabled", "management_menu", r.PathValue("menuKey"), "failure")
+		return
+	}
+	key := r.PathValue("menuKey")
+	payload := struct {
+		MenuKey          string
+		ExpectedRevision int64
+	}{key, in.ExpectedRevision}
+	if s.replayWorkbenchResponse(w, r, wc, "management-menu.disable", payload) {
+		return
+	}
+	before, err := s.store.ManagementMenuSnapshot(r.Context(), key)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.disabled", "management_menu", key, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	if err = s.store.DisableManagementMenu(r.Context(), key, in.ExpectedRevision, wc.UserID); err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.disabled", "management_menu", key, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	data := map[string]any{"menuKey": key, "status": "disabled"}
+	s.auditWorkbenchMutation(r, wc, "management_menu.disabled", "management_menu", key, before, data)
+	if !s.saveWorkbenchResponse(w, r, wc, "management-menu.disable", payload, data) {
+		return
+	}
+	writeData(w, r, data)
+}
+
+func (s *Server) enableManagementMenu(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	var in struct {
+		ExpectedRevision int64 `json:"expectedRevision"`
+	}
+	if !decodeWorkbenchJSON(w, r, &in) {
+		s.auditWorkbenchResult(r, wc, "management_menu.enabled", "management_menu", r.PathValue("menuKey"), "failure")
+		return
+	}
+	key := r.PathValue("menuKey")
+	payload := struct {
+		MenuKey          string
+		ExpectedRevision int64
+	}{key, in.ExpectedRevision}
+	if s.replayWorkbenchResponse(w, r, wc, "management-menu.enable", payload) {
+		return
+	}
+	before, err := s.store.ManagementMenuSnapshot(r.Context(), key)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.enabled", "management_menu", key, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	if err = s.store.EnableManagementMenu(r.Context(), key, in.ExpectedRevision, wc.UserID); err != nil {
+		s.auditWorkbenchResult(r, wc, "management_menu.enabled", "management_menu", key, "failure")
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	data := map[string]any{"menuKey": key, "status": "active"}
+	s.auditWorkbenchMutation(r, wc, "management_menu.enabled", "management_menu", key, before, data)
+	if !s.saveWorkbenchResponse(w, r, wc, "management-menu.enable", payload, data) {
+		return
+	}
+	writeData(w, r, data)
+}
+
+func writeManagementMenuStoreError(w http.ResponseWriter, r *http.Request, err error) {
+	switch {
+	case errors.Is(err, store.ErrValidation):
+		writeError(w, r, http.StatusBadRequest, "validation_error", "管理中心菜单参数无效")
+	case errors.Is(err, store.ErrConflict):
+		writeError(w, r, http.StatusConflict, "conflict", "管理中心菜单数据已变化，请刷新后重试")
+	case errors.Is(err, store.ErrNotFound):
+		writeError(w, r, http.StatusNotFound, "not_found", "管理中心菜单不存在")
+	default:
+		writeError(w, r, http.StatusInternalServerError, "internal_error", "管理中心菜单操作失败")
+	}
+}
