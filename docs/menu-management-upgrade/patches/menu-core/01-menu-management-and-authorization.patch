+}
+func workbenchCapTx(ctx context.Context, tx *sql.Tx, ws, wsID string) ([]string, error) {
+	if err := lockWorkbenchCatalogTx(ctx, tx); err != nil {
+		return nil, err
+	}
+	if ws == "platform" {
+		return workbenchEligibleMenuKeysTx(ctx, tx, ws)
+	}
+	parentType, parentID := "platform", "platform_root"
+	if ws == "enterprise" {
+		parentType = "agency"
+		if err := tx.QueryRowContext(ctx, `SELECT agency_id FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL FOR SHARE`, wsID).Scan(&parentID); err != nil {
+			return nil, ErrNotFound
+		}
+	} else if ws != "agency" {
+		return nil, ErrValidation
+	}
+	var locked int
+	if err := tx.QueryRowContext(ctx, `SELECT 1 FROM ky_workbench_menu_grant_set WHERE workspace_type=$1 AND workspace_id=$2 FOR SHARE`, ws, wsID).Scan(&locked); err != nil {
+		return nil, ErrNotFound
+	}
+	if ws == "enterprise" {
+		if err := tx.QueryRowContext(ctx, `SELECT 1 FROM ky_workbench_menu_grant_set WHERE workspace_type='agency' AND workspace_id=$1 FOR SHARE`, parentID).Scan(&locked); err != nil {
+			return nil, ErrNotFound
+		}
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT g.menu_key FROM ky_workbench_menu_grant_set gs JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed' JOIN ky_workbench_menu m ON m.menu_key=g.menu_key AND m.status='active' WHERE gs.workspace_type=$1 AND gs.workspace_id=$2 AND gs.parent_workspace_type=$3 AND gs.parent_workspace_id=$4 AND m.route_key IS NOT NULL ORDER BY g.menu_key`, ws, wsID, parentType, parentID)
+	if err != nil {
+		return nil, err
+	}
+	keys, err := collectMenuKeys(rows)
+	if err != nil {
+		return nil, err
+	}
+	if ws != "enterprise" {
+		return keys, nil
+	}
+	agencyRows, err := tx.QueryContext(ctx, `SELECT g.menu_key FROM ky_workbench_menu_grant_set gs JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed' WHERE gs.workspace_type='agency' AND gs.workspace_id=$1`, parentID)
+	if err != nil {
+		return nil, err
+	}
+	agencyKeys, err := collectMenuKeys(agencyRows)
+	if err != nil {
+		return nil, err
+	}
+	return IntersectWorkbenchMenuKeys(keys, agencyKeys), nil
+}
+
+func lockWorkbenchCatalogTx(ctx context.Context, tx *sql.Tx) error {
+	rows, err := tx.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' FOR SHARE`)
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var key string
+		if err = rows.Scan(&key); err != nil {
+			rows.Close()
+			return err
+		}
+	}
+	if err = rows.Close(); err != nil {
+		return err
+	}
+	return rows.Err()
+}
