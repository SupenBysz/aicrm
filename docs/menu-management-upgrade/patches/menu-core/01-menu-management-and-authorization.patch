+func (s *Store) workbenchMenuCap(ctx context.Context, workspaceType, workspaceID string) ([]string, error) {
+	parentType := "platform"
+	parentID := "platform_root"
+	if workspaceType == "enterprise" {
+		parentType = "agency"
+		if err := s.db.QueryRowContext(ctx, `SELECT agency_id FROM ky_enterprise WHERE id=$1 AND status='normal' AND agency_id IS NOT NULL`, workspaceID).Scan(&parentID); err != nil {
+			if errors.Is(err, sql.ErrNoRows) {
+				return []string{}, nil
+			}
+			return nil, err
+		}
+	} else if workspaceType != "agency" {
+		return nil, ErrValidation
+	}
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT g.menu_key
+		FROM ky_workbench_menu_grant_set gs
+		JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed'
+		JOIN ky_workbench_menu m ON m.menu_key=g.menu_key AND m.status='active'
+		WHERE gs.workspace_type=$1 AND gs.workspace_id=$2
+		  AND gs.parent_workspace_type=$3 AND gs.parent_workspace_id=$4
+		  AND m.route_key IS NOT NULL
+	ORDER BY g.menu_key`, workspaceType, workspaceID, parentType, parentID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	keys, err := collectMenuKeys(rows)
+	if err != nil || workspaceType != "enterprise" {
+		return keys, err
+	}
+	// Enterprise access is bounded by both its direct agency grant and its own
+	// cap. Intersect here so a stale/forged enterprise row cannot survive a
+	// later agency revocation.
+	agencyKeys, err := s.workbenchMenuCap(ctx, "agency", parentID)
+	if err != nil {
+		return nil, err
+	}
+	return IntersectWorkbenchMenuKeys(keys, agencyKeys), nil
+}
+
+// IntersectWorkbenchMenuKeys returns a stable set of keys granted by both an
+// asset's own workspace and its ancestor branch. Workspace eligibility is
+// applied separately to the requesting membership, so an agency may delegate
+// enterprise-only keys without gaining those routes itself.
+func IntersectWorkbenchMenuKeys(ownKeys, ancestorKeys []string) []string {
+	ancestor := stringSet(ancestorKeys)
+	seen := map[string]struct{}{}
+	out := make([]string, 0, len(ownKeys))
+	for _, key := range ownKeys {
+		if _, ok := ancestor[key]; !ok {
+			continue
+		}
+		if _, duplicate := seen[key]; duplicate {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func ResolveEffectiveWorkbenchMenuKeys(roleKeys, allowKeys, denyKeys, capKeys, eligibleKeys []string) []string {
+	eligible := stringSet(eligibleKeys)
+	cap := stringSet(capKeys)
+	allow := stringSet(allowKeys)
+	deny := stringSet(denyKeys)
+	granted := stringSet(roleKeys)
+	for key := range allow {
+		granted[key] = struct{}{}
+	}
+	out := make([]string, 0, len(granted))
+	for key := range granted {
+		if _, ok := eligible[key]; !ok {
+			continue
+		}
+		if len(capKeys) > 0 || capKeys != nil {
+			if _, ok := cap[key]; !ok {
+				continue
+			}
+		}
+		if _, ok := deny[key]; ok {
+			continue
+		}
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func stringSet(values []string) map[string]struct{} {
+	out := make(map[string]struct{}, len(values))
+	for _, value := range values {
+		out[value] = struct{}{}
+	}
+	return out
+}
