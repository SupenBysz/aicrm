+func (s *Server) auditWorkbenchResult(r *http.Request, wc wsContext, action, resourceType, resourceID, result string, details ...map[string]any) {
+	detail := map[string]any{"requestId": requestID(r)}
+	for _, values := range details {
+		for key, value := range values {
+			detail[key] = value
+		}
+	}
+	entry := store.AuditEntry{ActorUserID: wc.UserID, ActorMembershipID: wc.MembershipID, WorkspaceType: wc.WorkspaceType, WorkspaceID: wc.WorkspaceID, Action: action, ResourceType: resourceType, ResourceID: resourceID, Result: result, RequestID: requestID(r), IPAddress: clientIP(r), UserAgent: r.UserAgent(), Source: "ky-membership-service", Detail: detail}
+	if wc.WorkspaceType == "agency" {
+		entry.AgencyID = wc.WorkspaceID
+	}
+	if wc.WorkspaceType == "enterprise" {
+		entry.EnterpriseID = wc.WorkspaceID
+	}
+	_ = s.store.WriteAudit(r.Context(), entry)
+}
+
+func (s *Server) auditWorkbenchMutation(r *http.Request, wc wsContext, action, resourceType, resourceID string, before, after any) {
+	s.auditWorkbenchResult(r, wc, action, resourceType, resourceID, "success", map[string]any{
+		"beforeSha256": requestHash(before),
+		"afterSha256":  requestHash(after),
+	})
+}
+func idempotencyKeyValid(r *http.Request) bool {
+	v := strings.TrimSpace(r.Header.Get("Idempotency-Key"))
+	return len(v) >= 8 && len(v) <= 128
+}
+func requiredIdempotencyKey(r *http.Request) error {
+	if idempotencyKeyValid(r) {
+		return nil
+	}
+	return store.ErrValidation
+}
+
+func decodeWorkbenchJSON(w http.ResponseWriter, r *http.Request, value any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 32<<10)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(value); err != nil {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "请求 JSON 无效")
+		return false
+	}
+	if err := d.Decode(new(any)); err != io.EOF {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "请求只能包含一个 JSON 对象")
+		return false
+	}
+	return true
+}
+
+func writeWorkbenchStoreError(w http.ResponseWriter, r *http.Request, err error) {
+	switch {
+	case errors.Is(err, store.ErrValidation):
+		writeError(w, r, http.StatusBadRequest, "validation_error", "工作台菜单参数无效或超出授权范围")
+	case errors.Is(err, store.ErrConflict):
+		writeError(w, r, http.StatusConflict, "conflict", "工作台菜单数据已变化，请刷新后重试")
+	case errors.Is(err, store.ErrNotFound):
+		writeError(w, r, http.StatusNotFound, "not_found", "工作台菜单或授权对象不存在")
+	default:
+		writeError(w, r, http.StatusInternalServerError, "internal_error", "工作台菜单操作失败")
+	}
+}
+
+func (s *Server) replayWorkbenchResponse(w http.ResponseWriter, r *http.Request, wc wsContext, command string, payload any) bool {
+	return replayWorkbenchResponse(w, r, wc, command, payload, s.store, s.auditWorkbenchResult)
+}
+
+type workbenchCommandReceiptReader interface {
+	ReadWorkbenchCommandReceipt(context.Context, string, string, string, string, string) (json.RawMessage, bool, error)
+}
+
+type workbenchAuditRecorder func(*http.Request, wsContext, string, string, string, string, ...map[string]any)
+
+func replayWorkbenchResponse(w http.ResponseWriter, r *http.Request, wc wsContext, command string, payload any, receipts workbenchCommandReceiptReader, audit workbenchAuditRecorder) bool {
+	key := strings.TrimSpace(r.Header.Get("Idempotency-Key"))
+	if len(key) < 8 || len(key) > 128 {
+		audit(r, wc, workbenchAuditAction(command), "workspace", wc.WorkspaceID, "failure")
+		writeError(w, r, 400, "validation_error", "Idempotency-Key 必填")
+		return true
+	}
+	response, found, err := receipts.ReadWorkbenchCommandReceipt(r.Context(), wc.WorkspaceType, wc.WorkspaceID, command, key, requestHash(payload))
+	if err != nil {
+		audit(r, wc, workbenchAuditAction(command), "workspace", wc.WorkspaceID, "failure")
+		if errors.Is(err, store.ErrConflict) {
+			writeError(w, r, 409, "idempotency_key_reused", "Idempotency-Key 已用于不同请求")
+		} else {
+			writeError(w, r, 500, "internal_error", "幂等回执读取失败")
+		}
+		return true
+	}
+	if !found {
+		return false
+	}
+	var data any
+	if err = json.Unmarshal(response, &data); err != nil {
+		audit(r, wc, workbenchAuditAction(command), "workspace", wc.WorkspaceID, "failure")
+		writeError(w, r, 500, "internal_error", "幂等回执无效")
+		return true
+	}
+	// A replay returns the original successful result; it is not a second
+	// mutation and therefore must not create another mutation audit record.
+	writeData(w, r, data)
+	return true
+}
+
+func workbenchAuditAction(command string) string {
+	switch command {
+	case "menu.create":
+		return "workbench_menu.created"
+	case "menu.update":
+		return "workbench_menu.updated"
+	case "menu.disable":
+		return "workbench_menu.disabled"
+	case "grants.replace":
+		return "workbench_menu_grants.replaced"
+	case "overrides.replace":
+		return "workbench_menu_overrides.replaced"
+	default:
+		return "workbench_menu.command"
+	}
+}
+func (s *Server) saveWorkbenchResponse(w http.ResponseWriter, r *http.Request, wc wsContext, command string, payload, response any) bool {
+	// Mutations currently commit in store methods before this receipt write.
+	// Keep this recovery limitation explicit: receipt persistence failure can
+	// leave a successful mutation whose original response cannot be replayed.
+	err := s.store.SaveWorkbenchCommandReceipt(r.Context(), wc.WorkspaceType, wc.WorkspaceID, command, strings.TrimSpace(r.Header.Get("Idempotency-Key")), requestHash(payload), response)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, workbenchAuditAction(command), "workspace", wc.WorkspaceID, "failure", map[string]any{"phase": "idempotency_receipt"})
+		writeError(w, r, 500, "internal_error", "幂等回执保存失败")
+		return false
+	}
+	return true
+}
+func requestHash(v any) string {
+	b, _ := json.Marshal(v)
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
