+package server
+
+import (
+	"io"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestRequestPlatformPreservesCreatePayloadAndFailsClosed(t *testing.T) {
+	r := httptest.NewRequest("POST", "/api/v1/matrix-account-web-spaces", strings.NewReader(`{"platform":"douyin","deviceId":"device-1"}`))
+	if got := requestPlatform(r); got != "douyin" {
+		t.Fatalf("platform=%q", got)
+	}
+	body, err := io.ReadAll(r.Body)
+	if err != nil || !strings.Contains(string(body), `"deviceId":"device-1"`) {
+		t.Fatalf("middleware must restore request payload, body=%q err=%v", body, err)
+	}
+	for _, body := range []string{`{"platform":"unknown"}`, `not-json`, strings.Repeat("x", 64<<10)} {
+		r := httptest.NewRequest("POST", "/api/v1/matrix-account-web-spaces", strings.NewReader(body))
+		if got := requestPlatform(r); got != "" {
+			t.Fatalf("invalid request selected platform %q", got)
+		}
+	}
+}
+
+func TestWorkbenchPlatformSelectionMapsOnlyRegisteredKeys(t *testing.T) {
+	for _, tc := range []struct {
+		platform string
+		want     string
+	}{
+		{"douyin", "menu.workbench.matrix_accounts.douyin"},
+		{"kuaishou", "menu.workbench.matrix_accounts.kuaishou"},
+		{"xiaohongshu", "menu.workbench.matrix_accounts.xiaohongshu"},
+	} {
+		r := httptest.NewRequest("GET", "/api/v1/matrix-accounts?platform="+tc.platform, nil)
+		keys, required := (&Server{}).workbenchMenuKeysForRequest(r, "agency", "agency-1", "membership-1")
+		if !required || len(keys) != 1 || keys[0] != tc.want {
+			t.Fatalf("platform %s mapping=%v required=%v", tc.platform, keys, required)
+		}
+	}
+	r := httptest.NewRequest("GET", "/api/v1/matrix-accounts?platform=https://example.test", nil)
+	keys, required := (&Server{}).workbenchMenuKeysForRequest(r, "agency", "agency-1", "membership-1")
+	if !required || len(keys) != 0 {
+		t.Fatalf("unknown platform must fail closed, keys=%v required=%v", keys, required)
+	}
+}
