+func ValidateWorkbenchMenuGrantSet(workspaceType string, candidate, parentLimit, eligible []string) bool {
+	if workspaceType != "agency" && workspaceType != "enterprise" {
+		return false
+	}
+	return validateWorkbenchMenuSet(candidate, parentLimit, eligible)
+}
+
+func validateWorkbenchMenuSet(candidate, parentLimit, eligible []string) bool {
+	limit := stringSet(parentLimit)
+	valid := stringSet(eligible)
+	seen := make(map[string]struct{}, len(candidate))
+	for _, key := range candidate {
+		if _, ok := valid[key]; !ok {
+			return false
+		}
+		if _, ok := limit[key]; !ok {
+			return false
+		}
+		if _, ok := seen[key]; ok {
+			return false
+		}
+		seen[key] = struct{}{}
+	}
+	return true
+}
diff --git a/services/ky-membership-service/internal/store/workbench_menu_access_test.go b/services/ky-membership-service/internal/store/workbench_menu_access_test.go
new file mode 100644
