+func TestWorkbenchMenuMigrationIsAdditiveAndHasLegacyReconciliation(t *testing.T) {
+	contents, err := os.ReadFile("../../../../ops/db/106_workbench_menu_authorization.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql := string(contents)
+	for _, required := range []string{
+		"CREATE TABLE IF NOT EXISTS ky_workbench_menu",
+		"CREATE TABLE IF NOT EXISTS ky_workbench_menu_grant_set",
+		"CREATE TABLE IF NOT EXISTS ky_workbench_menu_membership_override",
+		"CREATE TABLE IF NOT EXISTS ky_workbench_menu_role_revision",
+		"menu.platform.matrix_accounts",
+		"menu.enterprise.talent_square",
+		"membershipComparisonMethod",
+		"workspaceCounts",
+		"changedMembershipCount",
+		"changedMembershipSamples",
+		"unmappedLegacyPermissionCodes",
+		"changedMembershipCount 必须为 0",
+		"COALESCE(m.route_key,'')",
+		"platform_root",
+	} {
+		if !strings.Contains(sql, required) {
+			t.Errorf("migration missing expected additive/reconciliation element %q", required)
+		}
+	}
+	if strings.Contains(strings.ToUpper(sql), "DROP TABLE") || strings.Contains(strings.ToUpper(sql), "TRUNCATE ") {
+		t.Fatal("workbench migration must not remove preexisting authorization data")
+	}
+}
