+func workbenchAgencyGrantableMenuKeysTx(ctx context.Context, tx *sql.Tx) ([]string, error) {
+	rows, err := tx.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' AND route_key IS NOT NULL AND (workspace_types @> '["agency"]'::jsonb OR workspace_types @> '["enterprise"]'::jsonb) ORDER BY menu_key`)
+	if err != nil {
