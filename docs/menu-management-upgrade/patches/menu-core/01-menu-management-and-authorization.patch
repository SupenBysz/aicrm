+CREATE TABLE IF NOT EXISTS ky_workbench_menu (
+  menu_key text PRIMARY KEY,
+  name text NOT NULL,
+  icon text NOT NULL DEFAULT '',
+  parent_key text,
+  sort_order integer NOT NULL DEFAULT 0,
+  workspace_types jsonb NOT NULL,
+  route_key text,
+  status text NOT NULL DEFAULT 'active' CHECK(status IN ('active','disabled')),
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  created_by text REFERENCES ky_user(id),
+  updated_by text REFERENCES ky_user(id),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  CHECK ((route_key IS NULL) OR route_key ~ '^[a-z][a-z0-9.-]{2,127}$')
+);
+CREATE UNIQUE INDEX IF NOT EXISTS ky_workbench_menu_route_uidx ON ky_workbench_menu(route_key) WHERE route_key IS NOT NULL;
+CREATE INDEX IF NOT EXISTS ky_workbench_menu_status_sort_idx ON ky_workbench_menu(status,sort_order,menu_key);
+
+CREATE TABLE IF NOT EXISTS ky_workbench_menu_grant_set (
+  workspace_type text NOT NULL CHECK(workspace_type IN ('agency','enterprise')),
+  workspace_id text NOT NULL,
+  parent_workspace_type text NOT NULL CHECK(parent_workspace_type IN ('platform','agency')),
+  parent_workspace_id text NOT NULL,
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  updated_by text REFERENCES ky_user(id),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY(workspace_type,workspace_id),
+  CHECK ((workspace_type='agency' AND parent_workspace_type='platform') OR (workspace_type='enterprise' AND parent_workspace_type='agency'))
+);
+CREATE TABLE IF NOT EXISTS ky_workbench_menu_grant (
+  workspace_type text NOT NULL,
+  workspace_id text NOT NULL,
+  menu_key text NOT NULL REFERENCES ky_workbench_menu(menu_key),
+  status text NOT NULL CHECK(status IN ('allowed','revoked')),
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  updated_by text REFERENCES ky_user(id),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY(workspace_type,workspace_id,menu_key),
+  FOREIGN KEY(workspace_type,workspace_id) REFERENCES ky_workbench_menu_grant_set(workspace_type,workspace_id) ON DELETE CASCADE
+);
+CREATE INDEX IF NOT EXISTS ky_workbench_menu_grant_active_idx ON ky_workbench_menu_grant(workspace_type,workspace_id,menu_key) WHERE status='allowed';
+
+CREATE TABLE IF NOT EXISTS ky_workbench_menu_membership_override (
+  membership_id text NOT NULL REFERENCES ky_membership(id) ON DELETE CASCADE,
+  workspace_type text NOT NULL CHECK(workspace_type IN ('platform','agency','enterprise')),
+  workspace_id text NOT NULL,
+  menu_key text NOT NULL REFERENCES ky_workbench_menu(menu_key),
+  effect text NOT NULL CHECK(effect IN ('allow','deny')),
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  updated_by text REFERENCES ky_user(id),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY(membership_id,menu_key),
+  UNIQUE(workspace_type,workspace_id,membership_id,menu_key)
+);
+CREATE INDEX IF NOT EXISTS ky_workbench_menu_override_scope_idx ON ky_workbench_menu_membership_override(workspace_type,workspace_id,membership_id);
+CREATE TABLE IF NOT EXISTS ky_workbench_menu_membership_set (
+  membership_id text NOT NULL REFERENCES ky_membership(id) ON DELETE CASCADE,
+  workspace_type text NOT NULL CHECK(workspace_type IN ('platform','agency','enterprise')),
+  workspace_id text NOT NULL,
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  updated_by text REFERENCES ky_user(id),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY(membership_id,workspace_type,workspace_id)
+);
+INSERT INTO ky_workbench_menu_membership_set(membership_id,workspace_type,workspace_id)
+SELECT id,workspace_type,workspace_id FROM ky_membership WHERE status='active' AND deleted_at IS NULL
+ON CONFLICT(membership_id,workspace_type,workspace_id) DO NOTHING;
+
+CREATE TABLE IF NOT EXISTS ky_workbench_menu_role_revision (
+  role_id text PRIMARY KEY REFERENCES ky_role(id) ON DELETE CASCADE,
+  revision bigint NOT NULL DEFAULT 1 CHECK(revision>0),
+  updated_by text REFERENCES ky_user(id),
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+INSERT INTO ky_workbench_menu_role_revision(role_id,revision)
