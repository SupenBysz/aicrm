+		return
+	}
+	s.auditWorkbenchMutation(r, wc, "workbench_menu_grants.replaced", "workspace", wsID, before, after)
+	data := after
+	if !s.saveWorkbenchResponse(w, r, wc, "grants.replace", struct {
+		WorkspaceType, WorkspaceID string
+		Input                      any
