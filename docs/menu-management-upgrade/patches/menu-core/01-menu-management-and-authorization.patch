@@ -0,0 +1,35 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestManagementMenuRoutesAreRegisteredBehindWorkspaceMiddleware(t *testing.T) {
+	server := &Server{}
+	mux := http.NewServeMux()
+	server.registerManagementMenuRoutes(mux)
+	for _, route := range []struct {
+		method string
+		path   string
+	}{
+		{http.MethodGet, "/api/v1/management-menus"},
+		{http.MethodPost, "/api/v1/management-menus"},
+		{http.MethodPatch, "/api/v1/management-menus/management.group.custom"},
+		{http.MethodPost, "/api/v1/management-menus/management.group.custom/disable"},
+		{http.MethodPost, "/api/v1/management-menus/management.group.custom/enable"},
+	} {
+		t.Run(route.method+" "+route.path, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(route.method, route.path, nil)
+			mux.ServeHTTP(recorder, request)
+			if recorder.Code == http.StatusNotFound {
+				t.Fatalf("management menu route %s %s was not registered", route.method, route.path)
+			}
+			if recorder.Code != http.StatusServiceUnavailable {
+				t.Fatalf("expected workspace middleware to stop before DB/auth, got HTTP %d", recorder.Code)
+			}
+		})
+	}
+}
