+import { createContext, useContext, useMemo, type PropsWithChildren } from "react";
+import type { AdminPlugin } from "./index";
+import { buildManagementMenuRegistry, type RegisteredManagementMenu } from "./management-menu-registry";
+
+const ManagementMenuRegistryContext = createContext<RegisteredManagementMenu[]>([]);
+
+export function ManagementMenuRegistryProvider({
+  plugins,
+  groupIconNames,
+  children
+}: PropsWithChildren<{ plugins: readonly AdminPlugin[]; groupIconNames?: Readonly<Record<string, string>> }>) {
+  const rows = useMemo(() => buildManagementMenuRegistry(plugins, groupIconNames), [plugins, groupIconNames]);
+  return <ManagementMenuRegistryContext.Provider value={rows}>{children}</ManagementMenuRegistryContext.Provider>;
+}
+
+export function useManagementMenuRegistry(): RegisteredManagementMenu[] {
+  return useContext(ManagementMenuRegistryContext);
+}
diff --git a/packages/ky-admin-core/src/management-menu-registry.ts b/packages/ky-admin-core/src/management-menu-registry.ts
new file mode 100644
index 0000000..f9df864
--- /dev/null
+++ b/packages/ky-admin-core/src/management-menu-registry.ts
@@ -0,0 +1,92 @@
+import type { AdminPlugin, PluginMenuItem, WorkspaceType } from "./index";
+
+export interface RegisteredManagementMenu {
+  menuKey: string;
+  name: string;
+  icon: string;
+  parentKey: string | null;
+  sortOrder: number;
+  workspaceTypes: WorkspaceType[];
+  routePath: string | null;
+  /** Includes the menu key and every action permission used by the host menu gate. */
+  permissionKeys: string[];
+  sourcePlugin: string;
+}
+
+export function managementMenuId(pluginName: string, menuKey: string): string {
+  return `management.${pluginName}.${menuKey}`;
+}
+
+export function managementMenuIdsForRoute(
+  registry: readonly RegisteredManagementMenu[],
+  routePath: string,
+  workspaceType: WorkspaceType,
+  sourcePlugin?: string
+): string[] | null {
+  const directoryItems = registry.filter((item) => item.routePath === routePath && (!sourcePlugin || item.sourcePlugin === sourcePlugin));
+  if (directoryItems.length === 0) return null;
+  return directoryItems
+    .filter((item) => item.workspaceTypes.includes(workspaceType))
+    .map((item) => item.menuKey);
+}
+
+export function managementMenuAllowed(menuId: string, effectiveMenuIds?: readonly string[]): boolean {
+  return Boolean(effectiveMenuIds?.includes(menuId));
+}
+
+export function managementRouteAllowed(menuIds: readonly string[] | null, effectiveMenuIds?: readonly string[]): boolean {
+  return menuIds === null || (menuIds.length > 0 && menuIds.some((id) => managementMenuAllowed(id, effectiveMenuIds)));
+}
+
+function workspaceTypesForMenu(menu: PluginMenuItem): WorkspaceType[] {
+  const values = [menu.menuKey, menu.requiredPermission, ...(menu.requiredAnyPermissions ?? [])]
+    .filter((value): value is string => typeof value === "string");
+  const result = new Set<WorkspaceType>();
+  for (const value of values) {
+    const scoped = value.match(/^(?:menu\.)?(platform|agency|enterprise)\./)?.[1] as WorkspaceType | undefined;
+    if (scoped) result.add(scoped);
+  }
+  return (["platform", "agency", "enterprise"] as const).filter((value) => result.has(value));
+}
+
+/** Derive only management-center plugin menus; workbenchMenus are intentionally excluded. */
+export function buildManagementMenuRegistry(
+  plugins: readonly AdminPlugin[],
+  groupIconNames: Readonly<Record<string, string>> = {}
+): RegisteredManagementMenu[] {
+  const rows: RegisteredManagementMenu[] = [];
+  const ordered = plugins.map((plugin, index) => ({ plugin, index }))
+    .filter(({ plugin }) => (plugin.menus ?? []).some((menu) => Boolean(menu.path)))
+    .sort((a, b) => (a.plugin.navOrder ?? 100) - (b.plugin.navOrder ?? 100) || a.index - b.index);
+
+  for (const { plugin, index } of ordered) {
+    const groupLabel = plugin.navGroup ?? plugin.name;
+    const groupKey = `management.group.${plugin.name}`;
+    const pages = (plugin.menus ?? []).filter((menu) => Boolean(menu.path));
+    const workspaceTypes = [...new Set(pages.flatMap(workspaceTypesForMenu))];
+    rows.push({
+      menuKey: groupKey,
+      name: groupLabel,
+      icon: groupIconNames[groupLabel] ?? pages[0]?.icon ?? "AppstoreOutlined",
+      parentKey: null,
+      sortOrder: plugin.navOrder ?? index * 10,
+      workspaceTypes: (["platform", "agency", "enterprise"] as const).filter((value) => workspaceTypes.includes(value)),
+      routePath: null,
+      permissionKeys: [],
+      sourcePlugin: plugin.name
+    });
+    pages.forEach((menu, menuIndex) => rows.push({
+      menuKey: `management.${plugin.name}.${menu.key}`,
+      name: menu.label,
+      icon: menu.icon ?? "AppstoreOutlined",
+      parentKey: groupKey,
+      sortOrder: menuIndex * 10,
+      workspaceTypes: workspaceTypesForMenu(menu),
+      routePath: menu.path ?? null,
+      permissionKeys: [...new Set([menu.menuKey, menu.requiredPermission, ...(menu.requiredAnyPermissions ?? [])]
+        .filter((value): value is string => typeof value === "string" && value.length > 0))],
+      sourcePlugin: plugin.name
+    }));
+  }
+  return rows;
+}
