+func (s *Store) ReplaceWorkbenchOverrides(ctx context.Context, membershipID, wsType, wsID string, allow, deny []string, expected int64, actor string) (int64, error) {
+	if expected < 1 || len(allow)+len(deny) > 256 || membershipID == "" || !validWorkbenchWorkspaceType(wsType) {
+		return 0, ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, err
+	}
+	defer tx.Rollback()
+	var lockedMembership string
+	if err = tx.QueryRowContext(ctx, `SELECT id FROM ky_membership WHERE id=$1 AND workspace_type=$2 AND workspace_id=$3 AND status='active' AND deleted_at IS NULL FOR UPDATE`, membershipID, wsType, wsID).Scan(&lockedMembership); err != nil {
+		return 0, ErrNotFound
+	}
+	capKeys := []string(nil)
+	if wsType != "platform" {
+		capKeys, err = workbenchCapTx(ctx, tx, wsType, wsID)
+		if err != nil {
+			return 0, err
+		}
+	} else {
+		capKeys, err = workbenchEligibleMenuKeysTx(ctx, tx, wsType)
+		if err != nil {
+			return 0, err
+		}
+	}
+	eligible, err := workbenchEligibleMenuKeysTx(ctx, tx, wsType)
+	if err != nil {
+		return 0, err
+	}
+	combined := append(append([]string{}, allow...), deny...)
+	if !ValidateWorkbenchMenuGrantSet("agency", combined, capKeys, eligible) {
+		return 0, ErrValidation
+	}
+	for _, a := range allow {
+		for _, d := range deny {
+			if a == d {
+				return 0, ErrValidation
+			}
+		}
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO ky_workbench_menu_membership_set(membership_id,workspace_type,workspace_id) VALUES($1,$2,$3) ON CONFLICT(membership_id,workspace_type,workspace_id) DO NOTHING`, membershipID, wsType, wsID); err != nil {
+		return 0, err
+	}
+	var revision int64
+	err = tx.QueryRowContext(ctx, `UPDATE ky_workbench_menu_membership_set SET revision=revision+1,updated_by=$2,updated_at=now() WHERE membership_id=$1 AND workspace_type=$3 AND workspace_id=$4 AND revision=$5 RETURNING revision`, membershipID, actor, wsType, wsID, expected).Scan(&revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return 0, ErrConflict
+	}
+	if err != nil {
+		return 0, err
+	}
+	if _, err = tx.ExecContext(ctx, `DELETE FROM ky_workbench_menu_membership_override WHERE membership_id=$1 AND workspace_type=$2 AND workspace_id=$3`, membershipID, wsType, wsID); err != nil {
+		return 0, err
+	}
+	for _, row := range []struct {
+		keys   []string
+		effect string
+	}{{allow, "allow"}, {deny, "deny"}} {
+		for _, key := range row.keys {
+			if _, err = tx.ExecContext(ctx, `INSERT INTO ky_workbench_menu_membership_override(membership_id,workspace_type,workspace_id,menu_key,effect,revision,updated_by) VALUES($1,$2,$3,$4,$5,$6,$7)`, membershipID, wsType, wsID, key, row.effect, revision, actor); err != nil {
+				return 0, err
+			}
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return 0, err
+	}
+	return revision, nil
+}
+
+func (s *Store) ReadWorkbenchOverrides(ctx context.Context, membershipID, wsType, wsID string) (WorkbenchMenuOverrides, error) {
+	out := WorkbenchMenuOverrides{MembershipID: membershipID, Allow: []string{}, Deny: []string{}}
+	err := s.db.QueryRowContext(ctx, `SELECT revision FROM ky_workbench_menu_membership_set WHERE membership_id=$1 AND workspace_type=$2 AND workspace_id=$3`, membershipID, wsType, wsID).Scan(&out.Revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return WorkbenchMenuOverrides{MembershipID: membershipID, Allow: []string{}, Deny: []string{}, Revision: 1}, nil
+	}
+	if err != nil {
+		return out, err
+	}
+	rows, err := s.db.QueryContext(ctx, `SELECT menu_key,effect FROM ky_workbench_menu_membership_override WHERE membership_id=$1 AND workspace_type=$2 AND workspace_id=$3 ORDER BY menu_key`, membershipID, wsType, wsID)
+	if err != nil {
+		return out, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var key, effect string
+		if err = rows.Scan(&key, &effect); err != nil {
+			return out, err
+		}
+		if effect == "allow" {
+			out.Allow = append(out.Allow, key)
+		} else {
+			out.Deny = append(out.Deny, key)
+		}
+	}
+	return out, rows.Err()
+}
+
+func NormalizeWorkbenchMenuKeys(keys []string) []string {
+	out := append([]string{}, keys...)
+	sort.Strings(out)
+	return out
+}
