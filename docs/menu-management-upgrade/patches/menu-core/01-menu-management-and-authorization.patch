+func (s *Store) ReplaceWorkbenchGrantSet(ctx context.Context, wsType, wsID, parentType, parentID string, keys []string, expected int64, actor string) (int64, error) {
+	if (wsType != "agency" && wsType != "enterprise") || expected < 1 || len(keys) > 256 {
+		return 0, ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, err
+	}
+	defer tx.Rollback()
+	if wsType == "agency" && (parentType != "platform" || parentID != "platform_root") {
+		return 0, ErrValidation
+	}
+	if wsType == "agency" {
+		var exists bool
+		if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_agency WHERE id=$1 AND status='normal')`, wsID).Scan(&exists); err != nil {
+			return 0, err
+		}
+		if !exists {
+			return 0, ErrNotFound
+		}
+	}
+	if wsType == "enterprise" {
+		var actualParent string
+		if err := tx.QueryRowContext(ctx, `SELECT agency_id FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL FOR SHARE`, wsID).Scan(&actualParent); err != nil {
+			return 0, ErrNotFound
+		}
+		if parentType != "agency" || parentID != actualParent {
+			return 0, ErrValidation
+		}
+		var locked int
+		if err := tx.QueryRowContext(ctx, `SELECT 1 FROM ky_workbench_menu_grant_set WHERE workspace_type='agency' AND workspace_id=$1 FOR SHARE`, parentID).Scan(&locked); err != nil {
+			return 0, ErrNotFound
+		}
+	}
+	if err := lockWorkbenchCatalogTx(ctx, tx); err != nil {
+		return 0, err
+	}
+	var limit []string
+	if parentType == "platform" {
+		limit, err = workbenchAgencyGrantableMenuKeysTx(ctx, tx)
+	} else {
+		var parentSet WorkbenchMenuGrantSet
+		parentSet, err = readWorkbenchGrantSetTx(ctx, tx, parentType, parentID)
+		limit = parentSet.MenuKeys
+	}
+	if err != nil {
+		return 0, err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO ky_workbench_menu_grant_set(workspace_type,workspace_id,parent_workspace_type,parent_workspace_id) VALUES($1,$2,$3,$4) ON CONFLICT(workspace_type,workspace_id) DO NOTHING`, wsType, wsID, parentType, parentID); err != nil {
+		return 0, err
+	}
+	var eligible []string
+	if wsType == "agency" {
+		eligible, err = workbenchAgencyGrantableMenuKeysTx(ctx, tx)
+	} else {
+		eligible, err = workbenchEligibleMenuKeysTx(ctx, tx, wsType)
+	}
+	if err != nil {
+		return 0, err
+	}
+	if !ValidateWorkbenchMenuGrantSet(wsType, keys, limit, eligible) {
+		return 0, ErrValidation
+	}
+	var revision int64
+	err = tx.QueryRowContext(ctx, `UPDATE ky_workbench_menu_grant_set SET revision=revision+1,updated_by=$3,updated_at=now() WHERE workspace_type=$1 AND workspace_id=$2 AND parent_workspace_type=$4 AND parent_workspace_id=$5 AND revision=$6 RETURNING revision`, wsType, wsID, actor, parentType, parentID, expected).Scan(&revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return 0, ErrConflict
+	}
+	if err != nil {
+		return 0, err
+	}
+	if _, err = tx.ExecContext(ctx, `DELETE FROM ky_workbench_menu_grant WHERE workspace_type=$1 AND workspace_id=$2`, wsType, wsID); err != nil {
+		return 0, err
+	}
+	for _, key := range keys {
+		if _, err = tx.ExecContext(ctx, `INSERT INTO ky_workbench_menu_grant(workspace_type,workspace_id,menu_key,status,revision,updated_by) VALUES($1,$2,$3,'allowed',$4,$5)`, wsType, wsID, key, revision, actor); err != nil {
+			return 0, err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return 0, err
+	}
+	return revision, nil
+}
+
+func (s *Store) parentWorkbenchMenuLimit(ctx context.Context, parentType, parentID string) ([]string, error) {
+	if parentType == "platform" && parentID == "platform_root" {
+		return s.eligibleWorkbenchGrantKeys(ctx, "agency")
+	}
+	if parentType == "agency" {
+		set, err := s.ReadWorkbenchGrantSet(ctx, "agency", parentID)
+		if err != nil {
+			return nil, err
+		}
+		return set.MenuKeys, nil
+	}
+	return nil, ErrValidation
+}
+
+func (s *Store) eligibleWorkbenchGrantKeys(ctx context.Context, ws string) ([]string, error) {
+	if ws == "agency" {
+		rows, err := s.db.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' AND route_key IS NOT NULL AND (workspace_types @> '["agency"]'::jsonb OR workspace_types @> '["enterprise"]'::jsonb) ORDER BY menu_key`)
+		if err != nil {
+			return nil, err
+		}
+		defer rows.Close()
+		return collectMenuKeys(rows)
+	}
+	return s.eligibleWorkbenchMenuKeys(ctx, ws)
+}
+func (s *Store) eligibleWorkbenchMenuKeys(ctx context.Context, ws string) ([]string, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' AND route_key IS NOT NULL AND workspace_types @> to_jsonb(ARRAY[$1::text]) ORDER BY menu_key`, ws)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return collectMenuKeys(rows)
+}
