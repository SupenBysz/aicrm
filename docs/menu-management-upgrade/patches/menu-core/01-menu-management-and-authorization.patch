+		Input                      any
+	}{wsType, wsID, in}) {
+		return
+	}
+	parentType, parentID := "platform", "platform_root"
+	if wsType == "enterprise" {
+		parentType, parentID = "agency", wc.WorkspaceID
+	}
+	before, err := s.store.ReadWorkbenchGrantSet(r.Context(), wsType, wsID)
