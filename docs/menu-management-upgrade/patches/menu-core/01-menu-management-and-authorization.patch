+func TestMenuWorkspaceAllowlistValidationAndCanonicalLists(t *testing.T) {
+	base := MenuWorkspaceAllowlistInput{DirectoryType: MenuDirectoryWorkbench, MenuKey: "menu.workbench.matrix_accounts.douyin", WorkspaceType: "agency", WorkspaceID: "agency-a", RoleIDs: []string{"role-a", "role-a"}, MembershipIDs: []string{"membership-a"}}
+	if !ValidMenuWorkspaceAllowlistInput(base) {
+		t.Fatal("valid scoped allowlist rejected")
+	}
+	roles, err := normalizeAllowlistIDs(base.RoleIDs)
