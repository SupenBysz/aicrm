+func (s *Store) effectiveWorkbenchGrantKeys(ctx context.Context, wsType, wsID string) ([]string, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT g.menu_key
+		FROM ky_workbench_menu_grant_set gs
+		JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed'
+		JOIN ky_workbench_menu m ON m.menu_key=g.menu_key AND m.status='active' AND m.route_key IS NOT NULL
+		WHERE gs.workspace_type=$1 AND gs.workspace_id=$2 AND m.workspace_types @> to_jsonb(ARRAY[$1::text])
+		AND (($1='agency' AND gs.parent_workspace_type='platform' AND gs.parent_workspace_id='platform_root') OR ($1='enterprise' AND gs.parent_workspace_type='agency' AND gs.parent_workspace_id=(SELECT agency_id FROM ky_enterprise WHERE id=$2 AND status='normal' AND deleted_at IS NULL)))
+		AND ($1<>'enterprise' OR EXISTS (
+			SELECT 1 FROM ky_enterprise e
+			JOIN ky_workbench_menu_grant_set ags ON ags.workspace_type='agency' AND ags.workspace_id=e.agency_id
+			JOIN ky_workbench_menu_grant ag ON ag.workspace_type=ags.workspace_type AND ag.workspace_id=ags.workspace_id AND ag.status='allowed' AND ag.menu_key=g.menu_key
+			WHERE e.id=$2 AND e.status='normal' AND e.deleted_at IS NULL
+		)) ORDER BY g.menu_key`, wsType, wsID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return collectMenuKeys(rows)
+}
