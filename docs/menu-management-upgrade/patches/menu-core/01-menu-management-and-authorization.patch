+func (s *Store) workbenchMembershipOverrides(ctx context.Context, membershipID, workspaceType, workspaceID string) (allow, deny []string, err error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT menu_key,effect FROM ky_workbench_menu_membership_override WHERE membership_id=$1 AND workspace_type=$2 AND workspace_id=$3 ORDER BY menu_key`, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
