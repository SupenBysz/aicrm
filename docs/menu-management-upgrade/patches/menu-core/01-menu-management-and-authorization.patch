+func effectiveWorkbenchMenuKeysTx(ctx context.Context, tx *sql.Tx, userID, membershipID, workspaceType, workspaceID string) ([]string, error) {
+	var active bool
+	if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_membership WHERE id=$1 AND user_id=$2 AND workspace_type=$3 AND workspace_id=$4 AND status='active' AND deleted_at IS NULL)`, membershipID, userID, workspaceType, workspaceID).Scan(&active); err != nil {
+		return nil, err
+	}
+	if !active {
+		return nil, ErrNotFound
+	}
+	roleRows, err := tx.QueryContext(ctx, `SELECT DISTINCT p.code FROM ky_membership_role mr JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=$2 AND (r.workspace_id=$3 OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL JOIN ky_role_permission rp ON rp.role_id=r.id JOIN ky_permission p ON p.id=rp.permission_id AND p.category='menu' AND p.status='normal' AND p.resource='workbench' WHERE mr.membership_id=$1 AND mr.workspace_type=$2 AND mr.workspace_id=$3`, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, err
+	}
+	roleKeys, err := collectMenuKeys(roleRows)
+	if err != nil {
+		return nil, err
+	}
+	var caps []string
+	if workspaceType != "platform" {
+		parentType, parentID := "platform", "platform_root"
+		if workspaceType == "enterprise" {
+			parentType = "agency"
+			if err = tx.QueryRowContext(ctx, `SELECT agency_id FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL AND agency_id IS NOT NULL`, workspaceID).Scan(&parentID); err != nil {
+				return nil, err
+			}
+		}
+		capRows, e := tx.QueryContext(ctx, `SELECT g.menu_key FROM ky_workbench_menu_grant_set gs JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed' JOIN ky_workbench_menu m ON m.menu_key=g.menu_key AND m.status='active' WHERE gs.workspace_type=$1 AND gs.workspace_id=$2 AND gs.parent_workspace_type=$3 AND gs.parent_workspace_id=$4 AND m.route_key IS NOT NULL ORDER BY g.menu_key`, workspaceType, workspaceID, parentType, parentID)
+		if e != nil {
+			return nil, e
+		}
+		ownGrantKeys, collectErr := collectMenuKeys(capRows)
+		caps, e = ownGrantKeys, collectErr
+		if e != nil {
+			return nil, e
+		}
+		if workspaceType == "enterprise" {
+			agencyRows, e := tx.QueryContext(ctx, `SELECT g.menu_key FROM ky_workbench_menu_grant_set gs JOIN ky_workbench_menu_grant g ON g.workspace_type=gs.workspace_type AND g.workspace_id=gs.workspace_id AND g.status='allowed' WHERE gs.workspace_type='agency' AND gs.workspace_id=$1`, parentID)
+			if e != nil {
+				return nil, e
+			}
+			agencyKeys, e := collectMenuKeys(agencyRows)
+			if e != nil {
+				return nil, e
+			}
+			caps = IntersectWorkbenchMenuKeys(caps, agencyKeys)
+		}
+	}
+	overrides, err := tx.QueryContext(ctx, `SELECT menu_key,effect FROM ky_workbench_menu_membership_override WHERE membership_id=$1 AND workspace_type=$2 AND workspace_id=$3 ORDER BY menu_key`, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, err
+	}
+	allows, denies := []string{}, []string{}
+	for overrides.Next() {
+		var key, effect string
+		if err = overrides.Scan(&key, &effect); err != nil {
+			overrides.Close()
+			return nil, err
+		}
+		if effect == "allow" {
+			allows = append(allows, key)
+		} else if effect == "deny" {
+			denies = append(denies, key)
+		}
+	}
+	if err = overrides.Close(); err != nil {
+		return nil, err
+	}
+	if err = overrides.Err(); err != nil {
+		return nil, err
+	}
+	eligibleRows, err := tx.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu WHERE status='active' AND route_key IS NOT NULL AND workspace_types @> to_jsonb(ARRAY[$1::text]) ORDER BY menu_key`, workspaceType)
+	if err != nil {
+		return nil, err
+	}
+	eligible, err := collectMenuKeys(eligibleRows)
+	if err != nil {
+		return nil, err
+	}
+	effective := ResolveEffectiveWorkbenchMenuKeys(roleKeys, allows, denies, caps, eligible)
+	// The allowlist is an additional restriction and is intentionally applied
+	// after role grants, membership allows/denies, eligibility and ancestor caps.
+	return applyMenuWorkspaceAllowlistTx(ctx, tx, MenuDirectoryWorkbench, workspaceType, workspaceID, membershipID, effective)
+}
