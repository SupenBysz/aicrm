+		JOIN ky_role_permission rp ON rp.role_id=r.id
+		JOIN ky_permission p ON p.id=rp.permission_id AND p.category='menu' AND p.status='normal' AND p.resource='workbench'
+		WHERE mr.membership_id=$1 AND mr.workspace_type=$2 AND mr.workspace_id=$3
+	`, membershipID, workspaceType, workspaceID)
