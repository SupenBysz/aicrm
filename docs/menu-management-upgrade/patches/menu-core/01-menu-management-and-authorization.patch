diff --git a/services/ky-auth-service/internal/server/workbench_menu_client.go b/services/ky-auth-service/internal/server/workbench_menu_client.go
new file mode 100644
index 0000000..b9c0c18
--- /dev/null
+++ b/services/ky-auth-service/internal/server/workbench_menu_client.go
@@ -0,0 +1,264 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Kysion/KyaiCRM/services/ky-auth-service/internal/store"
+)
+
+type workbenchMenuResolverError struct {
+	reason string
+}
+
+type workbenchMenuKeysEnvelope struct {
+	Data struct {
+		MembershipID                string   `json:"membershipId"`
+		WorkspaceType               string   `json:"workspaceType"`
+		WorkspaceID                 string   `json:"workspaceId"`
+		MenuKeys                    []string `json:"menuKeys"`
+		ManagedManagementMenuKeys   []string `json:"managedManagementMenuKeys"`
+		EffectiveManagementMenuKeys []string `json:"effectiveManagementMenuKeys"`
+		EffectiveManagementMenuIDs  []string `json:"effectiveManagementMenuIds"`
+	} `json:"data"`
+	RequestID string `json:"requestId"`
+}
+
+type effectiveMenuResolution struct {
+	WorkbenchKeys           []string
+	ManagedManagementKeys   []string
+	EffectiveManagementKeys []string
+	EffectiveManagementIDs  []string
+}
+
+func (e workbenchMenuResolverError) Error() string { return e.reason }
+
+func workbenchMenuResolutionReason(err error) string {
+	var resolverErr workbenchMenuResolverError
+	if errors.As(err, &resolverErr) {
+		return resolverErr.reason
+	}
+	return "resolver_failure"
+}
+
+// applyWorkbenchMenuResolution keeps legacy business menu keys out of the
+// bootstrap and fails closed for management catalog keys when resolution fails.
+func applyWorkbenchMenuResolution(identity store.WorkspaceIdentity, resolve func() ([]string, error)) (store.WorkspaceIdentity, error) {
+	var keys []string
+	var err error
+	if resolve == nil {
+		err = workbenchMenuResolverError{reason: "resolver_not_configured"}
+	} else {
+		keys, err = resolve()
+	}
+	if err != nil {
+		identity.MenuKeys = failClosedManagementMenus(mergeWorkbenchMenuKeys(identity.MenuKeys, nil))
+		return identity, err
+	}
+	identity.MenuKeys = mergeWorkbenchMenuKeys(identity.MenuKeys, keys)
+	return identity, nil
+}
+
+func (s *Server) effectiveWorkbenchMenuKeys(ctx context.Context, userID, membershipID, workspaceType, workspaceID string) ([]string, error) {
+	if strings.TrimSpace(s.cfg.ManagementToken) == "" {
+		return nil, workbenchMenuResolverError{reason: "resolver_not_configured"}
+	}
+	base := strings.TrimRight(s.cfg.ManagementMembershipURL, "/")
+	if base == "" {
+		base = "http://127.0.0.1:18083"
+	}
+	body, err := json.Marshal(map[string]string{"userId": userID, "membershipId": membershipID, "workspaceType": workspaceType, "workspaceId": workspaceID})
+	if err != nil {
+		return nil, workbenchMenuResolverError{reason: "request_encode_failed"}
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, base+"/internal/v1/workbench-menu-keys", bytes.NewReader(body))
+	if err != nil {
+		return nil, workbenchMenuResolverError{reason: "request_build_failed"}
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.ManagementToken)
+	req.Header.Set("X-KY-Request-Id", fmt.Sprintf("auth-bootstrap-%d", time.Now().UnixNano()))
+	client := &http.Client{Timeout: 3 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, workbenchMenuResolverError{reason: "transport_failed"}
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, workbenchMenuResolverError{reason: fmt.Sprintf("http_status_%d", resp.StatusCode)}
+	}
+	keys, err := decodeWorkbenchMenuKeysResponse(resp.Body, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, err
+	}
+	return keys, nil
+}
+
+func (s *Server) effectiveMenuResolution(ctx context.Context, userID, membershipID, workspaceType, workspaceID string) (effectiveMenuResolution, error) {
+	if strings.TrimSpace(s.cfg.ManagementToken) == "" {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "resolver_not_configured"}
+	}
+	base := strings.TrimRight(s.cfg.ManagementMembershipURL, "/")
+	if base == "" {
+		base = "http://127.0.0.1:18083"
+	}
+	body, err := json.Marshal(map[string]string{"userId": userID, "membershipId": membershipID, "workspaceType": workspaceType, "workspaceId": workspaceID})
+	if err != nil {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "request_encode_failed"}
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, base+"/internal/v1/workbench-menu-keys", bytes.NewReader(body))
+	if err != nil {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "request_build_failed"}
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.ManagementToken)
+	req.Header.Set("X-KY-Request-Id", fmt.Sprintf("auth-bootstrap-%d", time.Now().UnixNano()))
+	resp, err := (&http.Client{Timeout: 3 * time.Second}).Do(req)
+	if err != nil {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "transport_failed"}
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: fmt.Sprintf("http_status_%d", resp.StatusCode)}
+	}
+	resolution, err := decodeEffectiveMenuResolutionResponse(resp.Body, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return effectiveMenuResolution{}, err
+	}
+	return resolution, nil
+}
+
+func decodeEffectiveMenuResolutionResponse(body io.Reader, membershipID, workspaceType, workspaceID string) (effectiveMenuResolution, error) {
+	var envelope workbenchMenuKeysEnvelope
+	decoder := json.NewDecoder(io.LimitReader(body, 64<<10))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&envelope); err != nil {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "response_decode_failed"}
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "response_trailing_data"}
+	}
+	data := envelope.Data
+	if data.MembershipID != membershipID || data.WorkspaceType != workspaceType || data.WorkspaceID != workspaceID || data.MenuKeys == nil || data.ManagedManagementMenuKeys == nil || data.EffectiveManagementMenuKeys == nil || data.EffectiveManagementMenuIDs == nil {
+		return effectiveMenuResolution{}, workbenchMenuResolverError{reason: "response_context_mismatch"}
+	}
+	return effectiveMenuResolution{WorkbenchKeys: data.MenuKeys, ManagedManagementKeys: data.ManagedManagementMenuKeys, EffectiveManagementKeys: data.EffectiveManagementMenuKeys, EffectiveManagementIDs: data.EffectiveManagementMenuIDs}, nil
+}
+
+func applyEffectiveMenuResolution(identity store.WorkspaceIdentity, resolve func() (effectiveMenuResolution, error)) (store.WorkspaceIdentity, error) {
+	var resolution effectiveMenuResolution
+	var err error
+	if resolve == nil {
+		err = workbenchMenuResolverError{reason: "resolver_not_configured"}
+	} else {
+		resolution, err = resolve()
+	}
+	if err != nil {
+		// Preserve the membership's existing permission-derived menu behavior.
+		// The Host knows exact directory routes from its local registry and gates
+		// those using this empty list; non-directory routes remain unchanged.
+		identity.MenuKeys = mergeWorkbenchMenuKeys(identity.MenuKeys, nil)
+		identity.ManagementMenuIDs = []string{}
+		return identity, err
+	}
+	keys := mergeWorkbenchMenuKeys(identity.MenuKeys, resolution.WorkbenchKeys)
+	identity.MenuKeys = filterResolvedManagementMenus(keys, resolution.ManagedManagementKeys, resolution.EffectiveManagementKeys)
+	identity.ManagementMenuIDs = dedupeSortedMenuIDs(resolution.EffectiveManagementIDs)
+	return identity, nil
+}
+
+func dedupeSortedMenuIDs(ids []string) []string {
+	set := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		if strings.HasPrefix(id, "management.") {
+			set[id] = true
+		}
+	}
+	out := make([]string, 0, len(set))
+	for id := range set {
+		out = append(out, id)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func filterResolvedManagementMenus(keys, managed, effective []string) []string {
+	managedSet := make(map[string]bool, len(managed))
+	for _, key := range managed {
+		managedSet[key] = true
+	}
+	effectiveSet := make(map[string]bool, len(effective))
+	for _, key := range effective {
+		effectiveSet[key] = true
+	}
+	out := make([]string, 0, len(keys))
+	for _, key := range keys {
+		if managedSet[key] && !effectiveSet[key] {
+			continue
+		}
+		out = append(out, key)
+	}
+	return out
+}
+
+func failClosedManagementMenus(keys []string) []string {
+	out := make([]string, 0, len(keys))
+	for _, key := range keys {
+		if strings.HasPrefix(key, "menu.platform.") || strings.HasPrefix(key, "menu.agency.") || strings.HasPrefix(key, "menu.enterprise.") {
+			continue
+		}
+		out = append(out, key)
+	}
+	return out
+}
+
+func decodeWorkbenchMenuKeysResponse(body io.Reader, membershipID, workspaceType, workspaceID string) ([]string, error) {
+	var envelope workbenchMenuKeysEnvelope
+	decoder := json.NewDecoder(io.LimitReader(body, 64<<10))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&envelope); err != nil {
+		return nil, workbenchMenuResolverError{reason: "response_decode_failed"}
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, workbenchMenuResolverError{reason: "response_trailing_data"}
+	}
+	if envelope.Data.MembershipID != membershipID || envelope.Data.WorkspaceType != workspaceType || envelope.Data.WorkspaceID != workspaceID {
+		return nil, workbenchMenuResolverError{reason: "response_context_mismatch"}
+	}
+	if envelope.Data.MenuKeys == nil {
+		return []string{}, nil
+	}
+	return envelope.Data.MenuKeys, nil
+}
+
+var legacyWorkbenchMenuKeys = map[string]bool{
+	"menu.platform.matrix_accounts": true, "menu.agency.matrix_accounts": true, "menu.enterprise.matrix_accounts": true,
+	"menu.enterprise.talent_square": true, "menu.enterprise.talent_square.douyin": true,
+}
+
+func mergeWorkbenchMenuKeys(legacy, canonical []string) []string {
+	set := map[string]bool{}
+	for _, key := range legacy {
+		if strings.HasPrefix(key, "menu.workbench.") || legacyWorkbenchMenuKeys[key] {
+			continue
+		}
+		set[key] = true
+	}
+	for _, key := range canonical {
+		set[key] = true
+	}
+	out := make([]string, 0, len(set))
+	for key := range set {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/services/ky-auth-service/internal/server/workbench_menu_client_test.go b/services/ky-auth-service/internal/server/workbench_menu_client_test.go
new file mode 100644
index 0000000..e4e8b31
--- /dev/null
+++ b/services/ky-auth-service/internal/server/workbench_menu_client_test.go
@@ -0,0 +1,170 @@
+package server
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Kysion/KyaiCRM/services/ky-auth-service/internal/store"
+)
+
