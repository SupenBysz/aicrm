+  assert.equal(leafIcon.props["aria-hidden"], true, "the decorative leaf icon must be hidden from assistive technology");
+  assert.match(leafIcon.props.className, /workbench-menu-leaf-minus/, "the leaf uses the dedicated pseudo-element-free style");
+  assert.equal(leafIcon.props.style.cursor, "default", "the static minus must not advertise clickability");
