+package server
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/Kysion/KyaiCRM/services/ky-membership-service/internal/store"
+)
+
+func (s *Server) internalWorkbenchMenuKeys(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	if s.cfg.InternalToken == "" {
+		writeError(w, r, 503, "internal_auth_unavailable", "内部认证未配置")
+		return
+	}
+	actual := r.Header.Get("X-KY-Internal-Token")
+	if len(actual) != len(s.cfg.InternalToken) || subtle.ConstantTimeCompare([]byte(actual), []byte(s.cfg.InternalToken)) != 1 {
+		writeError(w, r, 401, "internal_unauthorized", "内部认证失败")
+		return
+	}
+	if !internalRequestIDPattern.MatchString(strings.TrimSpace(r.Header.Get("X-KY-Request-Id"))) {
+		writeError(w, r, 400, "request_id_required", "X-KY-Request-Id 必填")
+		return
+	}
+	if r.Header.Get("Authorization") != "" || r.Header.Get("X-KY-Workspace-Type") != "" || r.Header.Get("X-KY-Workspace-Id") != "" {
+		writeError(w, r, 400, "internal_header_forbidden", "内部接口禁止用户认证与工作区覆盖 Header")
+		return
+	}
+	if s.store == nil {
+		writeError(w, r, http.StatusServiceUnavailable, "service_unavailable", "菜单授权存储不可用")
+		return
+	}
+	var in struct {
+		UserID        string `json:"userId"`
+		MembershipID  string `json:"membershipId"`
+		WorkspaceType string `json:"workspaceType"`
+		WorkspaceID   string `json:"workspaceId"`
+	}
+	if !decodeWorkbenchJSON(w, r, &in) {
+		return
+	}
+	if !opaqueReferencePattern.MatchString(in.UserID) || !opaqueReferencePattern.MatchString(in.MembershipID) ||
+		!opaqueReferencePattern.MatchString(in.WorkspaceID) || !validWorkbenchWorkspaceTypeInput(in.WorkspaceType) {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "工作区授权参数无效")
+		return
+	}
+	keys, err := s.store.EffectiveWorkbenchMenuKeys(r.Context(), in.UserID, in.MembershipID, in.WorkspaceType, in.WorkspaceID)
+	if err != nil {
+		writeWorkbenchStoreError(w, r, err)
+		return
+	}
+	managedManagementKeys, effectiveManagementKeys, effectiveManagementMenuIDs, err := s.store.EffectiveManagementMenuKeys(r.Context(), in.UserID, in.MembershipID, in.WorkspaceType, in.WorkspaceID)
+	if err != nil {
+		writeWorkbenchStoreError(w, r, err)
+		return
+	}
+	writeData(w, r, internalWorkbenchMenuKeysData{
+		MembershipID:                in.MembershipID,
+		WorkspaceType:               in.WorkspaceType,
+		WorkspaceID:                 in.WorkspaceID,
+		MenuKeys:                    keys,
+		ManagedManagementMenuKeys:   managedManagementKeys,
+		EffectiveManagementMenuKeys: effectiveManagementKeys,
+		EffectiveManagementMenuIDs:  effectiveManagementMenuIDs,
+	})
+}
+
+type internalWorkbenchMenuKeysData struct {
+	MembershipID                string   `json:"membershipId"`
+	WorkspaceType               string   `json:"workspaceType"`
+	WorkspaceID                 string   `json:"workspaceId"`
+	MenuKeys                    []string `json:"menuKeys"`
+	ManagedManagementMenuKeys   []string `json:"managedManagementMenuKeys"`
+	EffectiveManagementMenuKeys []string `json:"effectiveManagementMenuKeys"`
+	EffectiveManagementMenuIDs  []string `json:"effectiveManagementMenuIds"`
+}
+
+func validWorkbenchWorkspaceTypeInput(value string) bool {
+	return value == "platform" || value == "agency" || value == "enterprise"
+}
+
+func (s *Server) registerWorkbenchMenuRoutes(mux *http.ServeMux) {
+	all := "platform,agency,enterprise"
+	mux.HandleFunc("GET /api/v1/workbench-menus", s.ws(all, []string{"platform.workbench_menus.view", "agency.workbench_menu_grants.manage", "enterprise.workbench_menu_grants.manage"}, s.listWorkbenchMenus))
+	mux.HandleFunc("POST /api/v1/workbench-menus", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.create"}, "workbench_menu.created", s.createWorkbenchMenu))
+	mux.HandleFunc("PATCH /api/v1/workbench-menus/{menuKey}", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.update"}, "workbench_menu.updated", s.updateWorkbenchMenu))
+	mux.HandleFunc("POST /api/v1/workbench-menus/{menuKey}/disable", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.disable"}, "workbench_menu.disabled", s.disableWorkbenchMenu))
+	mux.HandleFunc("GET /api/v1/workspaces/{workspaceType}/{workspaceId}/workbench-menu-grants", s.ws(all, []string{"platform.workbench_menu_grants.manage_agencies", "agency.workbench_menu_grants.manage", "enterprise.workbench_menu_grants.manage"}, s.getWorkbenchMenuGrants))
