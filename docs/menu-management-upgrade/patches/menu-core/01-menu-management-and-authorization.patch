index 0000000..6656a68
--- /dev/null
+++ b/plugins/ky-access-management/src/workbench-menu-view.ts
@@ -0,0 +1,149 @@
+import { createElement, type MouseEvent, type ReactElement } from "react";
+import type { WorkbenchMenu } from "./api";
+
+export type WorkbenchMenuTreeNode = WorkbenchMenu & { children: WorkbenchMenuTreeNode[] };
+
+export type WorkbenchMenuExpandIconProps<T extends { children?: readonly unknown[] | null }> = {
+  prefixCls: string;
+  expanded: boolean;
+  expandable: boolean;
+  record: T;
+  onExpand: (record: T, event: MouseEvent<HTMLElement>) => void;
+  leafColor?: string;
+};
+
+export function isWorkbenchMenuExpandable(node: { children?: readonly unknown[] | null }): boolean {
+  return (node.children?.length ?? 0) > 0;
+}
+
+export function renderWorkbenchMenuExpandIcon<T extends { children?: readonly unknown[] | null }>({
+  prefixCls,
+  expanded,
+  record,
+  onExpand,
+  leafColor = "#8c8c8c"
+}: WorkbenchMenuExpandIconProps<T>): ReactElement | null {
+  // rc-table's nested-tree path passes `hasNestChildren`; an empty [] is truthy.
+  const minusGlyph = createElement("svg", {
+    viewBox: "0 0 16 16",
+    width: "100%",
+    height: "100%",
+    "aria-hidden": true,
+    style: { position: "absolute", inset: 0, overflow: "visible", pointerEvents: "none" }
+  }, createElement("path", {
+    d: "M5 8h6",
+    fill: "none",
+    stroke: "currentColor",
+    strokeWidth: 1,
+    strokeLinecap: "round"
+  }));
+
+  // Keep a decorative minus at the same slot for leaves, without an action target.
+  if (!isWorkbenchMenuExpandable(record)) {
+    return createElement("span", {
+      "aria-hidden": true,
+      className: `${prefixCls}-row-expand-icon workbench-menu-leaf-minus`,
+      style: { cursor: "default", color: leafColor, borderColor: leafColor }
+    }, minusGlyph);
+  }
+  return createElement("button", {
+    type: "button",
+    "aria-label": expanded ? "收起子菜单" : "展开子菜单",
+    "aria-expanded": expanded,
+    className: `${prefixCls}-row-expand-icon ${prefixCls}-row-expand-icon-${expanded ? "expanded" : "collapsed"}`,
+    onClick: (event: MouseEvent<HTMLElement>) => {
+      onExpand(record, event);
+      event.stopPropagation();
+    }
+  });
+}
+
+const workspaceLabels: Record<string, string> = {
+  platform: "平台",
+  agency: "机构",
+  enterprise: "企业"
+};
+
+export function workspaceTypeLabel(value: string): string {
+  return workspaceLabels[value] ?? value;
+}
+
+export function workspaceTypesLabel(values: readonly string[] | null | undefined): string {
+  return (values ?? []).map(workspaceTypeLabel).join("、");
+}
+
+/** Build a stable tree from explicit parentKey links; malformed links stay visible at the root. */
+export function buildWorkbenchMenuTree(items: readonly WorkbenchMenu[]): WorkbenchMenuTreeNode[] {
+  const nodes = items.map((item, index) => ({ item, index, node: { ...item, children: [] as WorkbenchMenuTreeNode[] } }));
+  const byKey = new Map(nodes.map((entry) => [entry.item.menuKey, entry]));
+  const parentOf = new Map<string, string>();
+
+  for (const { item } of nodes) {
+    const parentKey = item.parentKey;
+    const parent = parentKey ? byKey.get(parentKey) : undefined;
+    if (typeof parentKey === "string" && parent && parent.item.routeKey === null && parentKey !== item.menuKey) {
+      parentOf.set(item.menuKey, parentKey);
+    }
+  }
+
+  // Each node has at most one parent. Detach the earliest listed member of each cycle.
+  const inspected = new Set<string>();
+  for (const { item } of nodes) {
+    if (inspected.has(item.menuKey)) continue;
+    const path: string[] = [];
+    const positions = new Map<string, number>();
+    let key: string | undefined = item.menuKey;
+    while (key && !inspected.has(key)) {
+      const seenAt = positions.get(key);
+      if (seenAt !== undefined) {
+        const cycle = path.slice(seenAt);
+        const detachKey = cycle.reduce((earliest, candidate) =>
+          byKey.get(candidate)!.index < byKey.get(earliest)!.index ? candidate : earliest);
+        parentOf.delete(detachKey);
+        break;
+      }
+      positions.set(key, path.length);
+      path.push(key);
+      key = parentOf.get(key);
+    }
+    path.forEach((pathKey) => inspected.add(pathKey));
+  }
+
+  const roots: typeof nodes = [];
+  for (const entry of nodes) {
+    const parentKey = parentOf.get(entry.item.menuKey);
+    const parent = parentKey ? byKey.get(parentKey) : undefined;
+    if (parent) parent.node.children.push(entry.node);
+    else roots.push(entry);
+  }
+
+  const sortEntries = (entries: typeof nodes) => entries.sort((a, b) =>
+    a.item.sortOrder - b.item.sortOrder || a.index - b.index);
+  const sortNodes = (entries: typeof nodes): WorkbenchMenuTreeNode[] => {
+    sortEntries(entries);
+    for (const entry of entries) {
+      const childEntries = entry.node.children.map((node) => byKey.get(node.menuKey)!);
+      entry.node.children = sortNodes(childEntries);
+    }
+    return entries.map((entry) => entry.node);
+  };
+
+  return sortNodes(roots);
+}
+
+export function workbenchMenuDescendantKeys(items: readonly WorkbenchMenu[], menuKey: string): Set<string> {
+  const descendants = new Set<string>();
+  const visited = new Set<string>([menuKey]);
+  const pending = [menuKey];
+  while (pending.length) {
+    const parentKey = pending.pop()!;
+    for (const item of items) {
+      if (item.parentKey === parentKey && !visited.has(item.menuKey)) {
+        visited.add(item.menuKey);
+        descendants.add(item.menuKey);
+        pending.push(item.menuKey);
+      }
+    }
+  }
+  return descendants;
+}
