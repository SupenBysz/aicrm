+			t.Fatalf("platform actor id %q error=%v, want ErrValidation", actorID, err)
+		}
+	}
+}
+
+func TestMenuWorkspaceAllowlistUsesRoleOrMembershipAndNeverGrantsWhenDisabledListEmpty(t *testing.T) {
+	if !MenuAllowlistAllows(false, nil, nil, nil, "membership-a") {
+		t.Fatal("disabled policy changed existing authorization")
+	}
+	if MenuAllowlistAllows(true, nil, nil, []string{"role-a"}, "membership-a") {
+		t.Fatal("enabled empty policy must deny")
+	}
+	if !MenuAllowlistAllows(true, []string{"role-a"}, []string{"membership-b"}, []string{"role-a"}, "membership-a") {
+		t.Fatal("matching role should pass OR allowlist")
+	}
+	if !MenuAllowlistAllows(true, []string{"role-b"}, []string{"membership-a"}, []string{"role-a"}, "membership-a") {
+		t.Fatal("matching workspace membership should pass OR allowlist")
+	}
+	if MenuAllowlistAllows(true, nil, []string{"membership-other-workspace"}, []string{"role-a"}, "membership-a") {
+		t.Fatal("membership from another workspace must not match")
+	}
+}
+
+func TestAllowlistOnlyNarrowsExistingMenuGrantDenyAndAncestorCapResult(t *testing.T) {
+	existing := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{"menu.allowed", "menu.denied", "menu.outside-cap"}, nil,
+		[]string{"menu.denied"}, []string{"menu.allowed", "menu.denied"},
+		[]string{"menu.allowed", "menu.denied", "menu.outside-cap"},
+	)
+	if !reflect.DeepEqual(existing, []string{"menu.allowed"}) {
+		t.Fatalf("existing deny/cap rules changed: %v", existing)
+	}
+	filtered := FilterMenuKeysByAllowlist(existing, map[string]bool{"menu.allowed": false})
+	if len(filtered) != 0 {
+		t.Fatalf("allowlist must be an additional deny-only filter: %v", filtered)
+	}
