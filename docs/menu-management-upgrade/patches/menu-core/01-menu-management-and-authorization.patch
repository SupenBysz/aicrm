+func readWorkbenchGrantSetTx(ctx context.Context, tx *sql.Tx, wsType, wsID string) (WorkbenchMenuGrantSet, error) {
+	out := WorkbenchMenuGrantSet{WorkspaceType: wsType, WorkspaceID: wsID, MenuKeys: []string{}}
+	err := tx.QueryRowContext(ctx, `SELECT parent_workspace_type,parent_workspace_id,revision FROM ky_workbench_menu_grant_set WHERE workspace_type=$1 AND workspace_id=$2 FOR SHARE`, wsType, wsID).Scan(&out.ParentWorkspaceType, &out.ParentWorkspaceID, &out.Revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return out, ErrNotFound
+	}
+	if err != nil {
+		return out, err
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu_grant WHERE workspace_type=$1 AND workspace_id=$2 AND status='allowed' ORDER BY menu_key`, wsType, wsID)
+	if err != nil {
+		return out, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var key string
+		if err = rows.Scan(&key); err != nil {
