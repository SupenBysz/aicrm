@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+const read = (path) => readFile(new URL(path, import.meta.url), "utf8");
+
+test("workbench and management catalogs expose the shared allowlist action only for active route entries", async () => {
+  const page = await read("./pages/workbench-menus-page.tsx");
+  const management = await read("./pages/management-menus-tab.tsx");
+  assert.match(page, /key: "allowlist", label: "权限"[\s\S]*?item\.status === "active" && item\.routeKey !== null/);
+  assert.match(management, /key: "allowlist", label: "权限"[\s\S]*?item\.persisted && item\.status === "active" && item\.routePath !== null/);
+  assert.match(management, /onOpenAllowlist\(item\.menuKey, item\.name\)/);
+  assert.match(page, /<MenuActionGrid actions=\{actions\} \/>/);
+});
+
+test("allowlist drawer scopes target choices, role IDs and workspace membership IDs", async () => {
+  const drawer = await read("./menu-allowlist-drawer.tsx");
+  const api = await read("./api.ts");
+  assert.match(drawer, /目标工作区/);
+  assert.match(drawer, /角色白名单/);
+  assert.match(drawer, /成员白名单/);
+  assert.match(drawer, /启用后没有任何角色或成员命中/);
+  assert.match(drawer, /membershipId|membershipIds/);
+  assert.match(api, /Idempotency-Key/);
+  assert.match(api, /expectedRevision: value\.revision/);
+  assert.match(api, /menu-allowlist-targets/);
+  assert.match(api, /candidates/);
+});
+
+test("empty enabled allowlist requires confirmation and is not rendered as unrestricted", async () => {
+  const drawer = await read("./menu-allowlist-drawer.tsx");
+  assert.match(drawer, /enabled && roleIds\.length === 0 && membershipIds\.length === 0/);
+  assert.match(drawer, /modal\.confirm/);
+  assert.match(drawer, /保存并确认后/);
+  assert.match(drawer, /关闭时完全沿用现有菜单授权/);
+});
diff --git a/plugins/ky-access-management/src/menu-catalog-components.tsx b/plugins/ky-access-management/src/menu-catalog-components.tsx
new file mode 100644
index 0000000..cd5372d
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-catalog-components.tsx
@@ -0,0 +1,72 @@
+import { useEffect, useRef } from "react";
+import type { ComponentType } from "react";
+import * as AntIcons from "@ant-design/icons";
+import { App as AntdApp, Button, Dropdown, Typography } from "antd";
+import type { MenuProps } from "antd";
+import { layoutMenuActions, MENU_ACTION_GRID_COLUMNS, type MenuCatalogAction } from "./menu-action-grid";
+
+type CatalogQueryState = {
+  isError: boolean;
+  error: unknown;
+  errorUpdatedAt: number;
+  refetch: () => Promise<unknown>;
+};
+
+export function useMenuCatalogLoadErrorNotice(title: string, query: CatalogQueryState, noticeKey: string) {
+  const { notification } = AntdApp.useApp();
+  const lastNotifiedAt = useRef(0);
+  const { isError, error, errorUpdatedAt, refetch } = query;
+  useEffect(() => {
+    if (!isError) {
+      notification.destroy(noticeKey);
+      lastNotifiedAt.current = 0;
+      return;
+    }
+    if (lastNotifiedAt.current === errorUpdatedAt) return;
+    lastNotifiedAt.current = errorUpdatedAt;
+    notification.open({
+      key: noticeKey,
+      type: "error",
+      message: title,
+      description: "请检查连接后重试。",
+      duration: 0,
+      btn: <Button type="link" size="small" onClick={() => void refetch()}>重试</Button>
+    });
+  }, [error, errorUpdatedAt, isError, notification, noticeKey, refetch, title]);
+}
+
+export function MenuNameCell({ name, keyName, icon }: { name: string; keyName: string; icon?: string }) {
+  const Icon = icon ? (AntIcons as unknown as Record<string, ComponentType>)[icon] : undefined;
+  return <div style={{ display: "flex", alignItems: "flex-start", gap: 8, minWidth: 0 }}>
+    <span aria-label={`${icon || "默认"} 图标`} title={icon || "默认图标"} style={{ flex: "none", lineHeight: "22px" }}>
+      {Icon ? <Icon /> : <AntIcons.AppstoreOutlined />}
+    </span>
+    <div style={{ display: "flex", flexDirection: "column", minWidth: 0, lineHeight: "22px" }}>
+      <Typography.Text strong>{name}</Typography.Text>
+      <Typography.Text type="secondary" style={{ display: "block", maxWidth: 340, lineHeight: "18px" }} ellipsis={{ tooltip: keyName }}>{keyName}</Typography.Text>
+    </div>
+  </div>;
+}
+
+export function MenuActionGrid({ actions }: { actions: MenuCatalogAction[] }) {
+  if (actions.length === 0) return null;
+  const layout = layoutMenuActions(actions);
+  const moreItems: MenuProps["items"] = layout.overflow.map((action) => ({
+    key: action.key,
+    label: action.label,
+    danger: action.danger,
+    disabled: action.disabled || action.loading,
+    onClick: action.onClick
+  }));
+  return <div className="menu-catalog-action-grid" style={{
+    display: "grid",
+    gridTemplateColumns: `repeat(${MENU_ACTION_GRID_COLUMNS}, minmax(0, 1fr))`,
+    gridTemplateRows: `repeat(${layout.rows}, minmax(32px, auto))`,
+    alignItems: "center",
+    justifyItems: "center",
+    width: "100%"
+  }}>
+    {layout.visible.map((action) => <div key={action.key}><Button className="menu-catalog-action-button" type="text" size="small" style={{ whiteSpace: "nowrap" }} danger={action.danger} disabled={action.disabled} loading={action.loading} onClick={action.onClick}>{action.label}</Button></div>)}
+    {layout.overflow.length ? <div key="more"><Dropdown trigger={["click"]} menu={{ items: moreItems }}><Button className="menu-catalog-action-button" type="text" size="small" style={{ whiteSpace: "nowrap" }}>更多</Button></Dropdown></div> : null}
+  </div>;
+}
diff --git a/plugins/ky-access-management/src/menu-catalog-form-drawer.tsx b/plugins/ky-access-management/src/menu-catalog-form-drawer.tsx
new file mode 100644
index 0000000..7976891
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-catalog-form-drawer.tsx
@@ -0,0 +1,153 @@
+import { useEffect, useRef } from "react";
+import { Alert, App as AntdApp, Button, Drawer, Form, Input, InputNumber, Select, Space } from "antd";
+import type { WorkbenchMenu } from "./api";
+import type { ManagementMenuRow } from "./management-menu-view";
+import { resolveMenuCreateContext, type MenuCatalogFormValues, type MenuDirectory, type MenuFormMode } from "./menu-management-contract";
+
+const WORKSPACE_OPTIONS = [
+  { value: "platform", label: "平台" },
+  { value: "agency", label: "机构" },
+  { value: "enterprise", label: "企业" }
+];
+const WORKBENCH_ROUTE_OPTIONS = [
+  { value: "workbench.overview", label: "工作台 / 概览" },
+  { value: "workbench.todos", label: "工作台 / 待办事项" },
+  { value: "workbench.messages", label: "工作台 / 我的消息" },
+  { value: "workbench.shortcuts", label: "工作台 / 快捷入口" },
+  { value: "workbench.matrix-accounts.douyin", label: "矩阵账号 / 抖音" },
+  { value: "workbench.matrix-accounts.kuaishou", label: "矩阵账号 / 快手" },
+  { value: "workbench.matrix-accounts.xiaohongshu", label: "矩阵账号 / 小红书" },
+  { value: "workbench.talent-square.enterprise.douyin", label: "达人广场 / 企业抖音" }
+];
+
+type MenuRecord = WorkbenchMenu | ManagementMenuRow;
+type Props = {
+  directory: MenuDirectory;
+  mode: MenuFormMode;
+  record?: MenuRecord;
+  open: boolean;
+  saving: boolean;
+  canSave: boolean;
+  groups: Array<{ value: string; label: string }>;
+  permissionOptions?: Array<{ value: string; label: string }>;
+  existingKeys: string[];
+  parentKey?: string;
+  hasChildren?: boolean;
+  onClose: () => void;
+  onSubmit: (values: MenuCatalogFormValues) => void;
+};
+
+function isManagementRecord(record?: MenuRecord): record is ManagementMenuRow {
+  return Boolean(record && "routePath" in record);
+}
+function recordIsGroup(record?: MenuRecord): boolean {
+  return Boolean(record && ("routePath" in record ? record.routePath === null : record.routeKey === null));
+}
+function recordIsRegistered(record?: MenuRecord): boolean {
+  return isManagementRecord(record) && record.registered;
+}
+function snapshot(values: Partial<MenuCatalogFormValues>): string {
+  return JSON.stringify({
+    menuType: values.menuType ?? "group", menuKey: values.menuKey ?? "", name: values.name ?? "", icon: values.icon ?? "",
+    parentKey: values.parentKey ?? "", routeKey: values.routeKey ?? "", routePath: values.routePath ?? "",
+    permissionKeys: values.permissionKeys ?? [], sortOrder: values.sortOrder ?? 0, workspaceTypes: values.workspaceTypes ?? []
+  });
+}
+
+export function MenuCatalogFormDrawer(props: Props) {
+  const { directory, mode, record, open, saving, canSave, groups, permissionOptions = [], existingKeys, parentKey, onClose, onSubmit } = props;
+  const { modal } = AntdApp.useApp();
+  const [form] = Form.useForm<MenuCatalogFormValues>();
+  const baseline = useRef("");
+  const menuType = Form.useWatch("menuType", form) ?? "group";
+  const editing = mode === "edit";
+  const management = directory === "management";
+  const createContext = resolveMenuCreateContext(directory, parentKey);
+  const registered = recordIsRegistered(record);
+  const hasChildren = props.hasChildren ?? false;
+
+  useEffect(() => {
+    if (!open) return;
+    const values: MenuCatalogFormValues = record ? {
+      menuType: recordIsGroup(record) ? "group" : "page",
+      menuKey: record.menuKey,
+      name: record.name,
+      icon: record.icon,
+      parentKey: record.parentKey ?? undefined,
+      routeKey: "routeKey" in record ? record.routeKey ?? undefined : undefined,
+      routePath: "routePath" in record ? record.routePath ?? undefined : undefined,
+      permissionKeys: "permissionKeys" in record ? [...record.permissionKeys] : [],
+      sortOrder: record.sortOrder,
+      workspaceTypes: [...record.workspaceTypes]
+    } : {
+      menuType: mode === "create-group" ? "group" : "page",
+      menuKey: "", name: "", icon: management && mode === "create-group" ? "AppstoreOutlined" : "",
+      parentKey: parentKey ?? undefined, sortOrder: 0, workspaceTypes: management ? ["platform"] : [], permissionKeys: []
+    };
+    form.resetFields();
+    form.setFieldsValue(values);
+    baseline.current = snapshot(values);
+  }, [form, management, mode, open, parentKey, record]);
+
+  function requestClose() {
+    if (saving) return;
+    if (!management && snapshot(form.getFieldsValue(true)) !== baseline.current) {
+      modal.confirm({
+        title: "放弃未保存的更改？", content: "关闭后，当前填写内容不会保存。", okText: "放弃更改", cancelText: "继续编辑", onOk: onClose
+      });
+      return;
+    }
+    onClose();
+  }
+
+  const title = editing
+    ? `编辑${management ? "管理中心" : "工作台"}${menuType === "group" ? "分组" : "菜单"}`
+    : registered ? "纳入注册菜单" : mode === "create-group" ? `新增${management ? "管理中心" : "工作台"}分组` : `新增${management ? "管理中心" : "工作台"}菜单`;
+  const submitText = registered ? "纳入目录" : "保存";
+  return <Drawer
+    title={title}
+    open={open}
+    onClose={requestClose}
+    width="min(560px, 100vw)"
+    closable={!saving}
+    maskClosable={!saving}
+    keyboard={!saving}
+    destroyOnClose
+    footer={<div style={{ display: "flex", justifyContent: "flex-end" }}><Space><Button onClick={requestClose} disabled={saving}>取消</Button><Button type="primary" loading={saving} disabled={!canSave} onClick={() => form.submit()}>{submitText}</Button></Space></div>}
+  >
+    <Form form={form} layout="vertical" onFinish={onSubmit}>
+      <Form.Item name="menuType" label="菜单类型" rules={[{ required: true }]}>
+        <Select disabled={!editing} onChange={(value: "group" | "page") => {
+          if (value === "group") form.setFieldsValue({ parentKey: undefined, routeKey: undefined, routePath: undefined, permissionKeys: [] });
+          else if (management) form.setFieldsValue({ routePath: record && "routePath" in record ? record.routePath ?? undefined : "", permissionKeys: [] });
+        }} options={[
+          { value: "group", label: "分组" },
+          { value: "page", label: "页面菜单", disabled: editing && recordIsGroup(record) && hasChildren }
+        ]} />
+      </Form.Item>
+      {editing && recordIsGroup(record) && hasChildren ? <Alert type="info" showIcon message="此分组已有子菜单，不能改为页面菜单。" style={{ marginBottom: 16 }} /> : null}
+      <Form.Item name="menuKey" label="稳定标识" rules={[
+        { required: true, whitespace: true, message: "请输入稳定标识" },
+        { pattern: /^[a-z][a-z0-9_.-]{2,127}$/, message: "标识须以小写字母开头，并仅包含小写字母、数字、点、下划线或连字符" },
+        { validator: async (_, value?: string) => { if (editing || !value || !existingKeys.includes(value)) return; throw new Error("该稳定标识已存在"); } }
+      ]}><Input placeholder="例如 menu.workbench.matrix_accounts" readOnly={editing} /></Form.Item>
+      <Form.Item name="name" label="菜单名称" rules={[{ required: true, whitespace: true, message: "请输入菜单名称" }]}><Input maxLength={120} /></Form.Item>
+      <Form.Item name="icon" label="图标名称" rules={[{ pattern: /^[A-Za-z][A-Za-z0-9]{0,63}$/, message: "请输入有效的图标名称" }]}><Input placeholder="Ant Design 图标名称，可留空" maxLength={64} /></Form.Item>
+      {menuType === "page" ? <Form.Item name="parentKey" label="所属分组" rules={[{ required: mode === "create-page", message: "请选择所属分组" }]}>
+        <Select allowClear={!createContext.lockParent} placeholder="请选择所属分组" options={groups} disabled={createContext.lockParent || registered} />
+      </Form.Item> : null}
+      <Form.Item name="sortOrder" label="排序" rules={[{ required: true }]}><InputNumber style={{ width: "100%" }} min={-10000} max={10000} /></Form.Item>
+      <Form.Item name="workspaceTypes" label="适用工作区" rules={[{ required: true, type: "array", min: 1, message: "至少选择一个工作区" }]}>
+        <Select mode="multiple" options={WORKSPACE_OPTIONS} disabled={registered} placeholder="至少选择一个工作区" />
+      </Form.Item>
+      {management ? <>
+        {menuType === "page" ? <>
+          <Form.Item name="routePath" label="注册路由" rules={[{ required: true, whitespace: true, message: "请输入注册路由" }]}><Input readOnly={registered} placeholder="例如 /shop-management" /></Form.Item>
+          <Form.Item name="permissionKeys" label="权限关联" rules={[{ required: true, type: "array", min: 1, message: "至少关联一个权限" }]}><Select mode="multiple" options={permissionOptions} optionFilterProp="label" disabled={registered} placeholder="选择页面权限" /></Form.Item>
+        </> : null}
+      </> : <Form.Item name="routeKey" label="已注册页面" rules={[{ required: menuType === "page", message: "请选择已注册页面" }]}>
+        <Select allowClear disabled={menuType === "group"} placeholder={menuType === "group" ? "分组无需页面路由" : "选择已注册页面"} options={WORKBENCH_ROUTE_OPTIONS} />
+      </Form.Item>}
+    </Form>
+  </Drawer>;
+}
diff --git a/plugins/ky-access-management/src/menu-management-contract.ts b/plugins/ky-access-management/src/menu-management-contract.ts
new file mode 100644
index 0000000..c81832a
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-management-contract.ts
@@ -0,0 +1,50 @@
+import type { ManagementMenuInput, WorkbenchMenu } from "./api";
+
+export type MenuDirectory = "catalog" | "management";
+export type MenuFormMode = "create-group" | "create-page" | "edit";
+
+export interface MenuCatalogFormValues {
+  menuType: "group" | "page";
+  menuKey: string;
+  name: string;
+  icon?: string;
+  parentKey?: string;
+  routeKey?: string;
+  routePath?: string;
+  permissionKeys?: string[];
+  sortOrder: number;
+  workspaceTypes: string[];
+}
+
+export function resolveMenuCreateContext(directory: MenuDirectory, parentKey?: string) {
+  return {
+    directory,
+    parentKey,
+    lockParent: Boolean(parentKey)
+  } as const;
+}
+
+export function toWorkbenchMenuInput(values: MenuCatalogFormValues): Omit<WorkbenchMenu, "status" | "revision"> {
+  return {
+    menuKey: values.menuKey.trim(),
+    name: values.name.trim(),
+    icon: values.icon ?? "",
+    parentKey: values.menuType === "group" ? null : values.parentKey || null,
+    sortOrder: values.sortOrder ?? 0,
+    workspaceTypes: values.workspaceTypes,
+    routeKey: values.menuType === "group" ? null : values.routeKey || null
+  };
+}
+
+export function toManagementMenuInput(values: MenuCatalogFormValues): ManagementMenuInput {
+  return {
+    menuKey: values.menuKey.trim(),
+    name: values.name.trim(),
+    icon: values.icon ?? "",
+    parentKey: values.menuType === "group" ? null : values.parentKey || null,
+    sortOrder: values.sortOrder ?? 0,
+    workspaceTypes: values.workspaceTypes,
+    routePath: values.menuType === "group" ? null : values.routePath || null,
+    permissionKeys: values.menuType === "group" ? [] : values.permissionKeys ?? []
+  };
+}
diff --git a/plugins/ky-access-management/src/pages/management-menus-tab.tsx b/plugins/ky-access-management/src/pages/management-menus-tab.tsx
new file mode 100644
index 0000000..e542055
--- /dev/null
+++ b/plugins/ky-access-management/src/pages/management-menus-tab.tsx
@@ -0,0 +1,126 @@
+import { useEffect, useMemo, useState } from "react";
+import { App as AntdApp, Table, Tag, Typography, theme } from "antd";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useManagementMenuRegistry, usePermissions, useRequestClient } from "@ky/admin-core";
+import { createManagementMenu, listManagementMenus, listPermissions, setManagementMenuStatus, updateManagementMenu, type ManagementMenu as ManagementMenuDto } from "../api";
+import { buildManagementMenuTree, mergeManagementMenuRegistry, type ManagementMenuRow } from "../management-menu-view";
+import { MenuActionGrid, MenuNameCell, useMenuCatalogLoadErrorNotice } from "../menu-catalog-components";
+import { filterMenuActions, MENU_ACTION_COLUMN_WIDTH, type MenuCatalogAction } from "../menu-action-grid";
+import { MenuCatalogFormDrawer } from "../menu-catalog-form-drawer";
+import { toManagementMenuInput, type MenuCatalogFormValues, type MenuFormMode } from "../menu-management-contract";
+import { permissionDisplayName } from "../permission-labels";
+import { isWorkbenchMenuExpandable, renderWorkbenchMenuExpandIcon, workspaceTypesLabel } from "../workbench-menu-view";
+
+type TreeRow = ManagementMenuRow & { children?: TreeRow[] };
+type Props = {
+  canCreate: boolean;
+  canUpdate: boolean;
+  canDisable: boolean;
+  formRequest: { sequence: number; mode: MenuFormMode; parentKey?: string } | null;
+  onOpenAllowlist: (menuKey: string, name: string) => void;
+};
+
+export function ManagementMenusTab({ canCreate, canUpdate, canDisable, formRequest, onOpenAllowlist }: Props) {
+  const { message, modal } = AntdApp.useApp();
+  const { token } = theme.useToken();
+  const client = useRequestClient();
+  const permissions = usePermissions();
+  const queryClient = useQueryClient();
+  const registry = useManagementMenuRegistry();
+  const [formState, setFormState] = useState<{ mode: MenuFormMode; parentKey?: string; record?: ManagementMenuRow } | null>(null);
+  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
+  const catalog = useQuery({ queryKey: ["management-menu-catalog"], queryFn: () => listManagementMenus(client) });
+  const permissionsCatalog = useQuery({ queryKey: ["permissions", "catalog"], queryFn: () => listPermissions(client) });
+  useMenuCatalogLoadErrorNotice("管理中心目录读取失败", catalog, "management-menu-catalog-load-error");
+  const rows = useMemo(() => mergeManagementMenuRegistry(registry, catalog.data ?? []), [registry, catalog.data]);
+  const permissionNames = permissionsCatalog.data ?? [];
+  const permissionOptions = useMemo(() => {
+    const codes = new Set(permissionNames.map((permission) => permission.code));
+    rows.forEach((row) => row.permissionKeys.forEach((code) => codes.add(code)));
+    return [...codes].map((code) => ({ value: code, label: permissionDisplayName(code, permissionNames) }));
+  }, [permissionNames, rows]);
+  const tree = useMemo(() => buildManagementMenuTree(rows) as TreeRow[], [rows]);
+  const groups = useMemo(() => rows.filter((item) => item.routePath === null && item.status === "active"), [rows]);
+  const formGroups = useMemo(() => groups.filter((group) => group.menuKey !== formState?.record?.menuKey)
+    .map((group) => ({ value: group.menuKey, label: group.name })), [formState?.record?.menuKey, groups]);
+  const setStatus = useMutation({
+    mutationFn: ({ item, status }: { item: ManagementMenuDto; status: "active" | "disabled" }) => setManagementMenuStatus(client, item.menuKey, status, item.revision),
+    onSuccess: async () => { message.success("菜单状态已更新"); await queryClient.invalidateQueries({ queryKey: ["management-menu-catalog"] }); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "状态更新失败")
+  });
+  const createMenu = useMutation({
+    mutationFn: (values: MenuCatalogFormValues) => createManagementMenu(client, toManagementMenuInput(values)),
+    onSuccess: async () => { message.success("管理中心菜单已纳入目录"); closeForm(); await queryClient.invalidateQueries({ queryKey: ["management-menu-catalog"] }); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "保存失败")
+  });
+  const updateMenu = useMutation({
+    mutationFn: (values: MenuCatalogFormValues) => updateManagementMenu(client, formState!.record!.menuKey, { ...toManagementMenuInput(values), expectedRevision: formState!.record!.revision }),
+    onSuccess: async () => { message.success("管理中心菜单已更新"); closeForm(); await queryClient.invalidateQueries({ queryKey: ["management-menu-catalog"] }); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "更新失败")
+  });
+  useEffect(() => {
+    if (!formRequest) return;
+    setFormState({ mode: formRequest.mode, parentKey: formRequest.parentKey });
+  }, [formRequest?.sequence]);
+  function closeForm() { setFormState(null); }
+  function submitForm(values: MenuCatalogFormValues) {
+    if (formState?.record?.persisted) updateMenu.mutate(values);
+    else createMenu.mutate(values);
+  }
+
+  const saving = createMenu.isPending || updateMenu.isPending;
+  return <>
+    <Table<TreeRow>
+      rowKey="menuKey" size="small" loading={catalog.isFetching} pagination={false} dataSource={tree} scroll={{ x: "max-content" }}
+      locale={{ emptyText: catalog.isError ? null : "暂无管理中心菜单" }}
+      expandable={{
+        expandedRowKeys,
+        onExpandedRowsChange: (keys) => setExpandedRowKeys(keys.map(String)),
+        rowExpandable: isWorkbenchMenuExpandable,
+        expandIcon: props => renderWorkbenchMenuExpandIcon({ ...props, leafColor: token.colorBorderSecondary })
+      }}
+      columns={[
+        { title: "名称", dataIndex: "name", render: (_: string, item) => <MenuNameCell name={item.name} keyName={item.menuKey} icon={item.icon} /> },
+        { title: "路由", dataIndex: "routePath", render: (value: string | null) => value ?? "分组" },
+        { title: "适用工作区", dataIndex: "workspaceTypes", render: (value: string[]) => workspaceTypesLabel(value) },
+        { title: "权限关联", dataIndex: "permissionKeys", width: 220, render: (value: string[]) => value.length ? <div style={{ display: "flex", flexDirection: "column", gap: 4, minWidth: 0 }}>{value.map((code) => <Typography.Text key={code} style={{ whiteSpace: "normal", overflowWrap: "anywhere" }}>{permissionDisplayName(code, permissionNames)}</Typography.Text>)}</div> : "—" },
+        { title: "状态", dataIndex: "status", render: (value: string) => <Tag color={value === "active" ? "green" : "default"}>{value === "active" ? "启用" : "停用"}</Tag> },
+        { title: "操作", align: "center", width: MENU_ACTION_COLUMN_WIDTH, render: (_: unknown, item) => {
+          const isGroup = item.routePath === null;
+          const dto = catalog.data?.find((candidate) => candidate.menuKey === item.menuKey);
+          const actions: MenuCatalogAction[] = filterMenuActions([
+            { key: "child", label: "新增菜单", permission: "platform.workbench_menus.create", visible: isGroup, onClick: () => setFormState({ mode: "create-page", parentKey: item.menuKey }) },
+            { key: "edit", label: item.persisted ? "编辑" : "纳入目录", permission: item.persisted ? "platform.workbench_menus.update" : "platform.workbench_menus.create", onClick: () => setFormState({ mode: "edit", record: item }) },
+            { key: "allowlist", label: "权限", permission: "platform.workbench_menus.update", visible: Boolean(dto && item.persisted && item.status === "active" && item.routePath !== null), onClick: () => onOpenAllowlist(item.menuKey, item.name) },
+            { key: "disable", label: "停用", permission: "platform.workbench_menus.disable", visible: Boolean(dto && item.status === "active"), danger: true, loading: setStatus.isPending, onClick: () => {
+              if (!dto) return;
+              modal.confirm({ title: "停用此菜单？", content: "目录状态仅供菜单目录管理使用，不会改变现有侧栏或业务访问权限。", okText: "停用", cancelText: "取消", onOk: () => setStatus.mutateAsync({ item: dto, status: "disabled" }) });
+            } },
+            { key: "enable", label: "启用", permission: "platform.workbench_menus.update", visible: Boolean(dto && item.status === "disabled"), loading: setStatus.isPending, onClick: () => { if (dto) setStatus.mutate({ item: dto, status: "active" }); } }
+          ], (permission) => {
+            if (permission === "platform.workbench_menus.create") return canCreate;
+            if (permission === "platform.workbench_menus.update") return canUpdate;
+            if (permission === "platform.workbench_menus.disable") return canDisable && permissions.can(permission);
+            return false;
+          });
+          return <MenuActionGrid actions={actions} />;
+        } }
+      ]}
+    />
+    {formState ? <MenuCatalogFormDrawer
+      directory="management"
+      mode={formState.mode}
+      record={formState.record}
+      open
+      saving={saving}
+      canSave={formState.record?.persisted ? canUpdate : canCreate}
+      groups={formGroups}
+      permissionOptions={permissionOptions}
+      existingKeys={rows.map((row) => row.menuKey)}
+      parentKey={formState.parentKey}
+      hasChildren={Boolean(formState.record && rows.some((row) => row.parentKey === formState.record!.menuKey))}
+      onClose={closeForm}
+      onSubmit={submitForm}
+    /> : null}
+  </>;
+}
diff --git a/plugins/ky-access-management/src/pages/workbench-menus-page.tsx b/plugins/ky-access-management/src/pages/workbench-menus-page.tsx
new file mode 100644
index 0000000..dee869f
--- /dev/null
+++ b/plugins/ky-access-management/src/pages/workbench-menus-page.tsx
@@ -0,0 +1,147 @@
+import { useMemo, useState } from "react";
+import { App as AntdApp, Button, Segmented, Space, Table, Tabs, Tag, theme } from "antd";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useSearchParams } from "react-router-dom";
+import { ListPageCard, useCurrentWorkspace, usePermissions, useRequestClient } from "@ky/admin-core";
+import { createWorkbenchMenu, disableWorkbenchMenu, listWorkbenchMenus, updateWorkbenchMenu, type WorkbenchMenu } from "../api";
+import { MenuActionGrid, MenuNameCell, useMenuCatalogLoadErrorNotice } from "../menu-catalog-components";
+import { filterMenuActions, MENU_ACTION_COLUMN_WIDTH, type MenuCatalogAction } from "../menu-action-grid";
+import { MenuCatalogFormDrawer } from "../menu-catalog-form-drawer";
+import { MenuAllowlistDrawer } from "../menu-allowlist-drawer";
+import { toWorkbenchMenuInput, type MenuCatalogFormValues, type MenuDirectory, type MenuFormMode } from "../menu-management-contract";
+import { buildWorkbenchMenuTree, isWorkbenchMenuExpandable, renderWorkbenchMenuExpandIcon, workbenchMenuDescendantKeys, workspaceTypesLabel } from "../workbench-menu-view";
+import { ManagementMenusTab } from "./management-menus-tab";
+
+type TreeRow = WorkbenchMenu & { children?: TreeRow[] };
+type FormState = { directory: MenuDirectory; mode: MenuFormMode; parentKey?: string; record?: WorkbenchMenu };
+
+export function WorkbenchMenusPage() {
+  const { message } = AntdApp.useApp();
+  const { token } = theme.useToken();
+  const client = useRequestClient();
+  const current = useCurrentWorkspace();
+  const permissions = usePermissions();
+  const queryClient = useQueryClient();
+  const [searchParams, setSearchParams] = useSearchParams();
+  const [formState, setFormState] = useState<FormState | null>(null);
+  const [allowlistMenu, setAllowlistMenu] = useState<{ directoryType: "workbench" | "management"; menuKey: string; name: string } | null>(null);
+  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
+  const [managementRequest, setManagementRequest] = useState<{ sequence: number; mode: MenuFormMode; parentKey?: string } | null>(null);
+  const [requestSequence, setRequestSequence] = useState(0);
+  const isPlatform = current?.type === "platform";
+  const activeTab = searchParams.get("menuTab") === "management" && isPlatform ? "management" : "catalog";
+  const canWorkbenchCreate = isPlatform && permissions.can("platform.workbench_menus.create");
+  const canWorkbenchUpdate = isPlatform && permissions.can("platform.workbench_menus.update");
+  const canWorkbenchDisable = isPlatform && permissions.can("platform.workbench_menus.disable");
+  const canManagementCreate = isPlatform && permissions.can("platform.workbench_menus.create");
+  const canManagementUpdate = isPlatform && permissions.can("platform.workbench_menus.update");
+  const canManagementDisable = isPlatform && permissions.can("platform.workbench_menus.disable");
+  const catalog = useQuery({ queryKey: ["workbench-menu-catalog"], queryFn: () => listWorkbenchMenus(client) });
+  useMenuCatalogLoadErrorNotice("工作台目录读取失败", catalog, "workbench-menu-catalog-load-error");
+  const createMenu = useMutation({
+    mutationFn: (values: MenuCatalogFormValues) => createWorkbenchMenu(client, toWorkbenchMenuInput(values)),
+    onSuccess: async () => { message.success("工作台菜单已创建"); setFormState(null); await queryClient.invalidateQueries({ queryKey: ["workbench-menu-catalog"] }); window.dispatchEvent(new Event("ky:bootstrap-refresh")); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "菜单创建失败，请重试")
+  });
+  const updateMenu = useMutation({
+    mutationFn: (values: MenuCatalogFormValues) => updateWorkbenchMenu(client, formState!.record!.menuKey, { ...toWorkbenchMenuInput(values), expectedRevision: formState!.record!.revision }),
+    onSuccess: async () => { message.success("工作台菜单已更新"); setFormState(null); await queryClient.invalidateQueries({ queryKey: ["workbench-menu-catalog"] }); window.dispatchEvent(new Event("ky:bootstrap-refresh")); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "菜单更新失败，请重试")
+  });
+  const disableMenu = useMutation({
+    mutationFn: (item: WorkbenchMenu) => disableWorkbenchMenu(client, item.menuKey, item.revision),
+    onSuccess: async () => { message.success("工作台菜单已停用"); await queryClient.invalidateQueries({ queryKey: ["workbench-menu-catalog"] }); window.dispatchEvent(new Event("ky:bootstrap-refresh")); },
+    onError: (error) => message.error(error instanceof Error ? error.message : "菜单停用失败，请重试")
+  });
+  const saving = createMenu.isPending || updateMenu.isPending;
+  const items = catalog.data ?? [];
+  const treeData = useMemo(() => buildWorkbenchMenuTree(items) as TreeRow[], [items]);
+  const descendants = useMemo(() => formState?.record ? workbenchMenuDescendantKeys(items, formState.record.menuKey) : new Set<string>(), [formState?.record, items]);
+  const groups = useMemo(() => items.filter((item) => item.routeKey === null && item.status === "active" && item.menuKey !== formState?.record?.menuKey && !descendants.has(item.menuKey))
+    .map((item) => ({ value: item.menuKey, label: item.name })), [descendants, formState?.record?.menuKey, items]);
+  const existingKeys = items.map((item) => item.menuKey);
+  const menuHasChildren = Boolean(formState?.record && items.some((item) => item.parentKey === formState.record!.menuKey));
+
+  function selectTab(key: string) {
+    setSearchParams((currentParams) => {
+      const next = new URLSearchParams(currentParams);
+      next.set("menuTab", key);
+      return next;
+    }, { replace: true });
+  }
+  function openWorkbenchForm(mode: MenuFormMode, parentKey?: string, record?: WorkbenchMenu) {
+    setFormState({ directory: "catalog", mode, parentKey, record });
+  }
+  function openManagementForm(mode: MenuFormMode, parentKey?: string) {
+    const next = requestSequence + 1;
+    setRequestSequence(next);
+    setManagementRequest({ sequence: next, mode, parentKey });
+  }
+  function submitWorkbench(values: MenuCatalogFormValues) {
+    if (formState?.record) updateMenu.mutate(values);
+    else createMenu.mutate(values);
+  }
+
+  const workbenchPage = <Table<TreeRow>
+      rowKey="menuKey" size="small" loading={catalog.isFetching} pagination={false} dataSource={treeData} scroll={{ x: "max-content" }}
+      locale={{ emptyText: catalog.isError ? null : "暂无工作台菜单" }}
+      expandable={{
+        expandedRowKeys,
+        onExpandedRowsChange: (keys) => setExpandedRowKeys(keys.map(String)),
+        rowExpandable: isWorkbenchMenuExpandable,
+        expandIcon: props => renderWorkbenchMenuExpandIcon({ ...props, leafColor: token.colorBorderSecondary })
+      }}
+      columns={[
+        { title: "名称", dataIndex: "name", render: (_: string, item) => <MenuNameCell name={item.name} keyName={item.menuKey} icon={item.icon} /> },
+        { title: "路由", dataIndex: "routeKey", render: (value: string | null) => value ?? "分组" },
+        { title: "适用工作区", dataIndex: "workspaceTypes", render: (values: string[]) => workspaceTypesLabel(values) },
+        { title: "状态", dataIndex: "status", render: (value: string) => <Tag color={value === "active" ? "green" : "default"}>{value === "active" ? "启用" : "停用"}</Tag> },
+        { title: "操作", align: "center", width: MENU_ACTION_COLUMN_WIDTH, render: (_: unknown, item: WorkbenchMenu) => {
+          const actions: MenuCatalogAction[] = filterMenuActions([
+            { key: "child", label: "新增菜单", permission: "platform.workbench_menus.create", visible: isPlatform && item.routeKey === null, onClick: () => openWorkbenchForm("create-page", item.menuKey) },
+            { key: "edit", label: "编辑", permission: "platform.workbench_menus.update", visible: isPlatform, onClick: () => openWorkbenchForm("edit", undefined, item) },
+            { key: "allowlist", label: "权限", permission: "platform.workbench_menus.update", visible: isPlatform && item.status === "active" && item.routeKey !== null, onClick: () => setAllowlistMenu({ directoryType: "workbench", menuKey: item.menuKey, name: item.name }) },
+            { key: "disable", label: "停用", permission: "platform.workbench_menus.disable", visible: isPlatform && item.status === "active", danger: true, loading: disableMenu.isPending, onClick: () => disableMenu.mutate(item) }
+          ], permissions.can);
+          return <MenuActionGrid actions={actions} />;
+        } }
+      ]}
+    />;
+  const extra = <div className="menu-catalog-toolbar-actions-wrap">
+    <Space.Compact className="menu-catalog-toolbar-actions">
+      <Button type="primary" disabled={activeTab === "catalog" ? !canWorkbenchCreate : !canManagementCreate} onClick={() => activeTab === "catalog" ? openWorkbenchForm("create-page") : openManagementForm("create-page")}>新增菜单</Button>
+      <Button disabled={activeTab === "catalog" ? !canWorkbenchCreate : !canManagementCreate} onClick={() => activeTab === "catalog" ? openWorkbenchForm("create-group") : openManagementForm("create-group")}>新增分组</Button>
+    </Space.Compact>
+  </div>;
+
+  return <ListPageCard title="菜单管理">
+    <div className="workbench-menu-toolbar">
+      <Segmented
+        className="workbench-menu-segmented list-status-segmented"
+        options={[
+          { label: "工作台", value: "catalog", disabled: !isPlatform },
+          { label: "管理中心", value: "management", disabled: !isPlatform }
+        ]}
+        value={activeTab}
+        onChange={(value) => selectTab(String(value))}
+      />
+      {extra}
+    </div>
+    <Tabs
+      className="workbench-menu-tabs"
+      activeKey={activeTab}
+      onChange={selectTab}
+      items={[
+        { key: "catalog", label: <span>工作台</span>, disabled: !isPlatform, children: workbenchPage },
+        { key: "management", label: <span>管理中心</span>, disabled: !isPlatform, children: <ManagementMenusTab canCreate={canManagementCreate} canUpdate={canManagementUpdate} canDisable={canManagementDisable} formRequest={managementRequest} onOpenAllowlist={(menuKey, name) => setAllowlistMenu({ directoryType: "management", menuKey, name })} /> }
+      ]}
+    />
+    {formState ? <MenuCatalogFormDrawer
+      directory="catalog" mode={formState.mode} record={formState.record} open saving={saving}
+      canSave={formState.record ? canWorkbenchUpdate : canWorkbenchCreate}
+      groups={groups} existingKeys={existingKeys} parentKey={formState.parentKey} hasChildren={menuHasChildren}
+      onClose={() => setFormState(null)} onSubmit={submitWorkbench}
+    /> : null}
+    {allowlistMenu ? <MenuAllowlistDrawer open directoryType={allowlistMenu.directoryType} menuKey={allowlistMenu.menuKey} menuName={allowlistMenu.name} onClose={() => setAllowlistMenu(null)} /> : null}
+  </ListPageCard>;
+}
diff --git a/plugins/ky-access-management/src/permission-labels.ts b/plugins/ky-access-management/src/permission-labels.ts
index 2d7d5d0..078f412 100644
--- a/plugins/ky-access-management/src/permission-labels.ts
+++ b/plugins/ky-access-management/src/permission-labels.ts
@@ -126,6 +126,27 @@ export function label(map: Record<string, string>, value: string): string {
   return map[value] ?? value;
 }
 
+const PERMISSION_CONTEXT_LABELS: Record<string, string> = {
+  platform: "平台",
+  agency: "机构",
+  enterprise: "企业",
+  organization: "组织"
+};
+
+/** Prefer the permission directory's Chinese name; unknown catalog entries get a Chinese fallback, never a raw code. */
+export function permissionDisplayName(code: string, catalog: Array<{ code: string; name: string }> = []): string {
+  const registered = catalog.find((permission) => permission.code === code)?.name.trim();
+  if (registered) return registered;
+
+  const parts = code.split(".").filter(Boolean);
+  const context = PERMISSION_CONTEXT_LABELS[parts[0]];
+  const actionKey = parts.at(-1) ?? "";
+  const action = ACTION_LABELS[actionKey] ?? "相关操作";
+  const resourceKey = parts.slice(context ? 1 : 0, -1).join("_");
+  const resource = RESOURCE_LABELS[resourceKey] ?? "其他资源";
+  return [context, resource, action].filter(Boolean).join(" · ");
+}
+
 export function resourceDomain(resource: string): DomainKey {
   return RESOURCE_DOMAIN[resource] ?? "platform";
 }
