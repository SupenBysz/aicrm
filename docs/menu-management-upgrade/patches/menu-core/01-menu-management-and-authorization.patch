+-- 受控路由映射：旧菜单权限扩展为其原来实际显示的已注册页面，避免迁移前可见入口丢失。
+WITH mapping(old_code,new_code) AS (VALUES
+ ('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.platform.talent_square.catalog','menu.workbench.talent_square.platform.douyin'),
+ ('menu.enterprise.talent_square','menu.workbench.talent_square.enterprise.douyin'),('menu.enterprise.talent_square.douyin','menu.workbench.talent_square.enterprise.douyin')
+)
+INSERT INTO ky_role_permission(id,role_id,permission_id)
+SELECT 'rp_workbench_legacy_'||md5(rp.role_id||':'||m.new_code),rp.role_id,np.id
+FROM mapping m JOIN ky_permission oldp ON oldp.code=m.old_code AND oldp.status='normal'
+JOIN ky_role_permission rp ON rp.permission_id=oldp.id
+JOIN ky_role r ON r.id=rp.role_id
+JOIN ky_permission np ON np.code=m.new_code
+WHERE r.status='normal' AND r.deleted_at IS NULL
+ON CONFLICT(role_id,permission_id) DO NOTHING;
+
+-- 为各当前 workspace 建立授权集合版本行；后续 PUT 使用 CAS 更新。
+INSERT INTO ky_workbench_menu_grant_set(workspace_type,workspace_id,parent_workspace_type,parent_workspace_id)
+SELECT 'agency',a.id,'platform','platform_root' FROM ky_agency a WHERE a.status='normal'
+ON CONFLICT(workspace_type,workspace_id) DO NOTHING;
+INSERT INTO ky_workbench_menu_grant_set(workspace_type,workspace_id,parent_workspace_type,parent_workspace_id)
+SELECT 'enterprise',e.id,'agency',e.agency_id FROM ky_enterprise e WHERE e.status='normal' AND e.agency_id IS NOT NULL
+ON CONFLICT(workspace_type,workspace_id) DO NOTHING;
+
+-- 旧有效角色菜单的 canonical 映射。企业上限按迁移前企业有效菜单回填。
+WITH mapping(old_code,new_code) AS (VALUES
+ ('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.platform.talent_square.catalog','menu.workbench.talent_square.platform.douyin'),('menu.enterprise.talent_square','menu.workbench.talent_square.enterprise.douyin'),('menu.enterprise.talent_square.douyin','menu.workbench.talent_square.enterprise.douyin')
+), member_menu AS (
+ SELECT DISTINCT m.workspace_type,m.workspace_id,mp.new_code AS menu_key
+ FROM ky_membership m JOIN ky_membership_role mr ON mr.membership_id=m.id
+ JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=m.workspace_type AND (r.workspace_id=m.workspace_id OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL
+ JOIN ky_role_permission rp ON rp.role_id=r.id JOIN ky_permission p ON p.id=rp.permission_id AND p.status='normal'
+ JOIN mapping mp ON mp.old_code=p.code WHERE m.status='active' AND m.deleted_at IS NULL
+)
+INSERT INTO ky_workbench_menu_grant(workspace_type,workspace_id,menu_key,status)
+SELECT mm.workspace_type,mm.workspace_id,mm.menu_key,'allowed' FROM member_menu mm
+JOIN ky_workbench_menu gm ON gm.menu_key=mm.menu_key AND gm.workspace_types @> to_jsonb(ARRAY[mm.workspace_type])
+WHERE mm.workspace_type='enterprise'
+ON CONFLICT(workspace_type,workspace_id,menu_key) DO NOTHING;
+
+-- 机构 branch cap 是机构及其下属企业迁移前有效菜单并集；新企业仍必须受该上限约束。
+WITH mapping(old_code,new_code) AS (VALUES
+ ('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.platform.talent_square.catalog','menu.workbench.talent_square.platform.douyin'),('menu.enterprise.talent_square','menu.workbench.talent_square.enterprise.douyin'),('menu.enterprise.talent_square.douyin','menu.workbench.talent_square.enterprise.douyin')
+), effective AS (
+ SELECT DISTINCT m.workspace_type,m.workspace_id,mp.new_code AS menu_key
+ FROM ky_membership m JOIN ky_membership_role mr ON mr.membership_id=m.id
+ JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=m.workspace_type AND (r.workspace_id=m.workspace_id OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL
+ JOIN ky_role_permission rp ON rp.role_id=r.id JOIN ky_permission p ON p.id=rp.permission_id AND p.status='normal'
+ JOIN mapping mp ON mp.old_code=p.code WHERE m.status='active' AND m.deleted_at IS NULL
+), branch AS (
+ SELECT 'agency'::text AS workspace_type,a.id AS workspace_id,e.menu_key
+ FROM ky_agency a JOIN effective e ON (e.workspace_type='agency' AND e.workspace_id=a.id)
+ UNION
+ SELECT 'agency',e2.agency_id,e.menu_key FROM ky_enterprise e2 JOIN effective e ON e.workspace_type='enterprise' AND e.workspace_id=e2.id WHERE e2.agency_id IS NOT NULL
+)
+INSERT INTO ky_workbench_menu_grant(workspace_type,workspace_id,menu_key,status)
+SELECT b.workspace_type,b.workspace_id,b.menu_key,'allowed' FROM branch b
+JOIN ky_workbench_menu gm ON gm.menu_key=b.menu_key AND gm.status='active' AND gm.route_key IS NOT NULL
+ON CONFLICT(workspace_type,workspace_id,menu_key) DO NOTHING;
+
+-- 初始管理权限仅赋给对应 workspace 的所有者角色；普通角色必须由授权管理员显式分配。
+WITH owner_permissions(role_type,role_code,permission_code) AS (VALUES
+ ('platform','platform_owner','platform.workbench_menus.view'),('platform','platform_owner','platform.workbench_menus.create'),('platform','platform_owner','platform.workbench_menus.update'),('platform','platform_owner','platform.workbench_menus.disable'),('platform','platform_owner','platform.workbench_menu_grants.manage_agencies'),('platform','platform_owner','menu.platform.access.workbench_menus'),
+ ('agency','agency_owner','agency.workbench_menu_grants.manage'),('agency','agency_owner','menu.agency.access.workbench_menus'),
+ ('enterprise','enterprise_owner','enterprise.workbench_menu_grants.manage'),('enterprise','enterprise_owner','menu.enterprise.access.workbench_menus')
+)
+INSERT INTO ky_role_permission(id,role_id,permission_id)
+SELECT 'rp_wm_owner_'||md5(r.id||':'||p.code),r.id,p.id FROM owner_permissions op
+JOIN ky_role r ON r.workspace_type=op.role_type AND r.code=op.role_code AND r.status='normal' AND r.deleted_at IS NULL
+JOIN ky_permission p ON p.code=op.permission_code
+ON CONFLICT(role_id,permission_id) DO NOTHING;
+
+-- 迁移时生成可审计的逐 membership 对账；这里只比较原角色菜单映射与
+-- 新角色菜单经 workspace eligibility/分支授权上限裁剪后的结果，不伪造执行前数据。
+WITH mapping(old_code,new_code) AS (VALUES
+ ('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.platform.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.agency.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.douyin'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.kuaishou'),('menu.enterprise.matrix_accounts','menu.workbench.matrix_accounts.xiaohongshu'),
+ ('menu.platform.talent_square.catalog','menu.workbench.talent_square.platform.douyin'),
+ ('menu.enterprise.talent_square','menu.workbench.talent_square.enterprise.douyin'),('menu.enterprise.talent_square.douyin','menu.workbench.talent_square.enterprise.douyin')
+), pre AS (
+ SELECT m.id AS membership_id,m.workspace_type,m.workspace_id,
+        COALESCE(array_agg(DISTINCT mp.new_code ORDER BY mp.new_code) FILTER (WHERE mp.new_code IS NOT NULL AND eligible.menu_key IS NOT NULL),ARRAY[]::text[]) AS menu_keys
+ FROM ky_membership m
+ LEFT JOIN ky_membership_role mr ON mr.membership_id=m.id AND mr.workspace_type=m.workspace_type AND mr.workspace_id=m.workspace_id
+ LEFT JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=m.workspace_type AND (r.workspace_id=m.workspace_id OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL
+ LEFT JOIN ky_role_permission rp ON rp.role_id=r.id
+ LEFT JOIN ky_permission p ON p.id=rp.permission_id AND p.status='normal' AND p.category='menu'
+ LEFT JOIN mapping mp ON mp.old_code=p.code
+ LEFT JOIN ky_workbench_menu eligible ON eligible.menu_key=mp.new_code AND eligible.workspace_types @> to_jsonb(ARRAY[m.workspace_type])
+ WHERE m.status='active' AND m.deleted_at IS NULL
+ GROUP BY m.id,m.workspace_type,m.workspace_id
+), post AS (
+ SELECT m.id AS membership_id,m.workspace_type,m.workspace_id,
+        COALESCE(array_agg(DISTINCT p.code ORDER BY p.code) FILTER (WHERE p.code IS NOT NULL AND menu.menu_key IS NOT NULL AND (m.workspace_type='platform'
+          OR (m.workspace_type='agency' AND EXISTS(SELECT 1 FROM ky_workbench_menu_grant g WHERE g.workspace_type='agency' AND g.workspace_id=m.workspace_id AND g.menu_key=p.code AND g.status='allowed'))
+          OR (m.workspace_type='enterprise' AND EXISTS(SELECT 1 FROM ky_workbench_menu_grant eg WHERE eg.workspace_type='enterprise' AND eg.workspace_id=m.workspace_id AND eg.menu_key=p.code AND eg.status='allowed')
+              AND EXISTS(SELECT 1 FROM ky_enterprise e JOIN ky_workbench_menu_grant ag ON ag.workspace_type='agency' AND ag.workspace_id=e.agency_id AND ag.menu_key=p.code AND ag.status='allowed' WHERE e.id=m.workspace_id AND e.status='normal' AND e.deleted_at IS NULL))
+        )),ARRAY[]::text[]) AS menu_keys
+ FROM ky_membership m
+ LEFT JOIN ky_membership_role mr ON mr.membership_id=m.id AND mr.workspace_type=m.workspace_type AND mr.workspace_id=m.workspace_id
+ LEFT JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=m.workspace_type AND (r.workspace_id=m.workspace_id OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL
+ LEFT JOIN ky_role_permission rp ON rp.role_id=r.id
+ LEFT JOIN ky_permission p ON p.id=rp.permission_id AND p.status='normal' AND p.category='menu' AND p.resource='workbench'
+ LEFT JOIN ky_workbench_menu menu ON menu.menu_key=p.code AND menu.status='active' AND menu.route_key IS NOT NULL AND menu.workspace_types @> to_jsonb(ARRAY[m.workspace_type])
+ WHERE m.status='active' AND m.deleted_at IS NULL
+ GROUP BY m.id,m.workspace_type,m.workspace_id
+), compared AS (
+ SELECT pre.membership_id,pre.workspace_type,pre.workspace_id,pre.menu_keys AS before_keys,post.menu_keys AS after_keys
+ FROM pre JOIN post USING(membership_id,workspace_type,workspace_id)
+), workspace_counts AS (
+ SELECT workspace_type,workspace_id,count(*) AS memberships,
+        sum(cardinality(before_keys)) AS before_menu_count,sum(cardinality(after_keys)) AS after_menu_count,
+        count(*) FILTER (WHERE before_keys<>after_keys) AS changed_memberships
+ FROM compared GROUP BY workspace_type,workspace_id
+), unmapped AS (
+ SELECT COALESCE(jsonb_agg(code ORDER BY code),'[]'::jsonb) AS codes FROM (
+   SELECT DISTINCT p.code FROM ky_permission p
+   WHERE p.category='menu' AND p.resource IN ('matrix_accounts','talent_square')
+     AND p.code NOT IN ('menu.platform.matrix_accounts','menu.agency.matrix_accounts','menu.enterprise.matrix_accounts','menu.platform.talent_square.catalog','menu.enterprise.talent_square','menu.enterprise.talent_square.douyin')
+ ) u
+), report AS (
+ SELECT jsonb_build_object(
+   'legacyMappedCodes',jsonb_build_array('menu.platform.matrix_accounts','menu.agency.matrix_accounts','menu.enterprise.matrix_accounts','menu.platform.talent_square.catalog','menu.enterprise.talent_square','menu.enterprise.talent_square.douyin'),
+   'registeredRouteKeys',jsonb_build_array('workbench.matrix-accounts.douyin','workbench.matrix-accounts.kuaishou','workbench.matrix-accounts.xiaohongshu','workbench.talent-square.platform.douyin','workbench.talent-square.enterprise.douyin'),
+   'membershipComparisonMethod','active memberships; legacy role menu permissions mapped to registered eligible menuKeys versus migrated workbench role menuKeys intersected with seeded workspace caps',
+   'workspaceCounts',(SELECT COALESCE(jsonb_agg(to_jsonb(w) ORDER BY w.workspace_type,w.workspace_id),'[]'::jsonb) FROM workspace_counts w),
+   'changedMembershipCount',(SELECT count(*) FROM compared WHERE before_keys<>after_keys),
+   'changedMembershipSamples',(SELECT COALESCE(jsonb_agg(jsonb_build_object('membershipId',membership_id,'workspaceType',workspace_type,'workspaceId',workspace_id,'beforeMenuKeys',before_keys,'afterMenuKeys',after_keys) ORDER BY workspace_type,workspace_id,membership_id),'[]'::jsonb) FROM (SELECT * FROM compared WHERE before_keys<>after_keys ORDER BY workspace_type,workspace_id,membership_id LIMIT 25) s),
+   'unmappedLegacyPermissionCodes',(SELECT codes FROM unmapped),
+   'reconciliationRequired',true,
+   'note','本报告由迁移执行时的数据库快照生成；changedMembershipCount 必须为 0 才能确认兼容对账通过。未映射旧权限不自动迁移，需人工映射审阅。'
+ ) AS value
+)
+INSERT INTO ky_workbench_menu_migration_report(report_key,report)
+SELECT '2026-10-10-r1',value FROM report
+ON CONFLICT(report_key) DO UPDATE SET report=EXCLUDED.report,created_at=now();
+
+-- 回滚说明：先关闭工作台新守卫并回退 Host/插件，再备份并核对新授权数据；仅在没有新配置依赖后删除本迁移创建的表/权限关系/目录。不要删除旧 ky_permission 或旧角色授权。
diff --git a/ops/db/108_workbench_builtin_menus.sql b/ops/db/108_workbench_builtin_menus.sql
new file mode 100644
index 0000000..29538f4
--- /dev/null
+++ b/ops/db/108_workbench_builtin_menus.sql
@@ -0,0 +1,74 @@
+-- 为现有工作台内置页面补齐正式菜单目录及授权映射。
+-- 只新增缺失目录/权限/角色授权/下级默认上限；冲突时不覆盖现有管理员配置。
+-- 新页面替代此前无菜单键限制的内置导航，故本次为所有现有普通角色及机构/企业授权集
+-- 添加等价默认授权。后续角色配置与上下级菜单上限仍由既有授权链路控制。
+-- 回滚：先回退 Host 导航与直达路由守卫，再核对无新授权依赖后从迁移前备份恢复本迁移
+-- 新增的四个目录键、对应 ky_permission、ky_role_permission 和 ky_workbench_menu_grant。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='30s';
+
+DO $$ BEGIN
+  IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF;
+END $$;
+
+INSERT INTO ky_workbench_menu(menu_key,name,icon,parent_key,sort_order,workspace_types,route_key,status)
+VALUES
+ ('menu.workbench.overview','概览','AppstoreOutlined',NULL,0,'["platform","agency","enterprise"]'::jsonb,'workbench.overview','active'),
+ ('menu.workbench.todos','待办事项','BookOutlined',NULL,1,'["platform","agency","enterprise"]'::jsonb,'workbench.todos','active'),
+ ('menu.workbench.messages','我的消息','BellOutlined',NULL,2,'["platform","agency","enterprise"]'::jsonb,'workbench.messages','active'),
+ ('menu.workbench.shortcuts','快捷入口','StarOutlined',NULL,3,'["platform","agency","enterprise"]'::jsonb,'workbench.shortcuts','active')
+ON CONFLICT DO NOTHING;
+
+-- 冲突只允许完全相同的既有定义；不要默默改写已存在的管理员目录配置。
+DO $$ BEGIN
+  IF EXISTS (
+    SELECT 1 FROM (VALUES
+      ('menu.workbench.overview','概览','AppstoreOutlined',0,'workbench.overview'),
+      ('menu.workbench.todos','待办事项','BookOutlined',1,'workbench.todos'),
+      ('menu.workbench.messages','我的消息','BellOutlined',2,'workbench.messages'),
+      ('menu.workbench.shortcuts','快捷入口','StarOutlined',3,'workbench.shortcuts')
+    ) AS expected(menu_key,name,icon,sort_order,route_key)
+    LEFT JOIN ky_workbench_menu actual USING(menu_key)
+    WHERE actual.menu_key IS NULL OR actual.name<>expected.name OR actual.icon<>expected.icon
+       OR actual.parent_key IS NOT NULL OR actual.sort_order<>expected.sort_order
+       OR actual.route_key<>expected.route_key OR actual.status<>'active'
+       OR actual.workspace_types<>'["platform","agency","enterprise"]'::jsonb
+  ) THEN RAISE EXCEPTION 'workbench_builtin_menu_conflict'; END IF;
+END $$;
+
+INSERT INTO ky_permission(id,code,name,category,resource,action,workspace_types,description,status)
+SELECT 'perm_'||md5(m.menu_key),m.menu_key,m.name,'menu','workbench',m.route_key,
+       m.workspace_types,'工作台内置页面菜单权限','normal'
+FROM ky_workbench_menu m
+WHERE m.menu_key IN ('menu.workbench.overview','menu.workbench.todos','menu.workbench.messages','menu.workbench.shortcuts')
+ON CONFLICT(code) DO NOTHING;
+
+DO $$ BEGIN
+  IF EXISTS (
+    SELECT 1 FROM ky_workbench_menu m
+    LEFT JOIN ky_permission p ON p.code=m.menu_key
+    WHERE m.menu_key IN ('menu.workbench.overview','menu.workbench.todos','menu.workbench.messages','menu.workbench.shortcuts')
+      AND (p.id IS NULL OR p.category<>'menu' OR p.resource<>'workbench' OR p.action<>m.route_key
+           OR p.status<>'normal' OR p.workspace_types<>m.workspace_types)
+  ) THEN RAISE EXCEPTION 'workbench_builtin_permission_conflict'; END IF;
+END $$;
+
+-- 当前四项此前对所有已有工作台角色可见；为相同范围内现有角色补齐菜单键，
+-- 使首次启用守卫不改变其可见性，之后可由既有角色编辑功能收窄。
+INSERT INTO ky_role_permission(id,role_id,permission_id)
+SELECT 'rp_workbench_builtin_'||md5(r.id||':'||p.code),r.id,p.id
+FROM ky_role r
+JOIN ky_permission p ON p.code IN ('menu.workbench.overview','menu.workbench.todos','menu.workbench.messages','menu.workbench.shortcuts')
+ AND p.workspace_types @> to_jsonb(ARRAY[r.workspace_type])
+WHERE r.workspace_type IN ('platform','agency','enterprise')
+  AND r.status='normal' AND r.deleted_at IS NULL
+ON CONFLICT(role_id,permission_id) DO NOTHING;
+
+-- 机构与企业此前也无对应菜单上限；只填补本次新键的缺失默认授权，保留已存在的 allow/deny。
+INSERT INTO ky_workbench_menu_grant(workspace_type,workspace_id,menu_key,status)
+SELECT gs.workspace_type,gs.workspace_id,m.menu_key,'allowed'
+FROM ky_workbench_menu_grant_set gs
+JOIN ky_workbench_menu m ON m.menu_key IN ('menu.workbench.overview','menu.workbench.todos','menu.workbench.messages','menu.workbench.shortcuts')
+ AND m.workspace_types @> to_jsonb(ARRAY[gs.workspace_type])
+WHERE gs.workspace_type IN ('agency','enterprise')
+ON CONFLICT(workspace_type,workspace_id,menu_key) DO NOTHING;
diff --git a/ops/db/109_management_center_menu_catalog.sql b/ops/db/109_management_center_menu_catalog.sql
new file mode 100644
index 0000000..72442f6
--- /dev/null
+++ b/ops/db/109_management_center_menu_catalog.sql
@@ -0,0 +1,84 @@
+-- 独立初始化管理中心侧栏菜单目录；不写入 ky_workbench_menu，也不修改任何角色或工作区授权。
+-- 可重复执行：仅补齐不存在的目录行，不覆盖管理员已调整的名称、图标、顺序或状态。
+-- 回滚：确认管理中心目录未被后续功能引用后，先备份本表，再删除 ky_management_menu；不影响工作台菜单目录。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='30s';
+
+DO $$ BEGIN
+  IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF;
+END $$;
+
+CREATE TABLE IF NOT EXISTS ky_management_menu (
+  menu_key text PRIMARY KEY,
+  name text NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),
+  icon text NOT NULL DEFAULT '' CHECK (length(icon)<=64),
+  parent_key text REFERENCES ky_management_menu(menu_key) ON DELETE RESTRICT,
+  sort_order integer NOT NULL DEFAULT 0 CHECK (sort_order BETWEEN -10000 AND 10000),
+  workspace_types jsonb NOT NULL CHECK (jsonb_typeof(workspace_types)='array'),
+  route_path text,
+  permission_keys jsonb NOT NULL DEFAULT '[]'::jsonb CHECK (jsonb_typeof(permission_keys)='array'),
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','disabled')),
+  revision bigint NOT NULL DEFAULT 1 CHECK (revision>0),
