diff --git a/services/ky-matrix-account-service/internal/server/workbench_menu_client.go b/services/ky-matrix-account-service/internal/server/workbench_menu_client.go
new file mode 100644
index 0000000..c20e2b6
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/server/workbench_menu_client.go
@@ -0,0 +1,145 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+func (s *Server) workbenchMenuKeysForRequest(r *http.Request, workspaceType, workspaceID, membershipID string) ([]string, bool) {
+	path := r.URL.Path
+	var platform string
+	switch {
+	case path == "/api/v1/matrix-accounts":
+		platform = strings.TrimSpace(r.URL.Query().Get("platform"))
+		if r.Method == http.MethodPost {
+			platform = requestPlatform(r)
+		}
+		if platform == "" {
+			return nil, true
+		}
+	case strings.HasPrefix(path, "/api/v1/matrix-accounts/"):
+		id := r.PathValue("id")
+		if id == "" {
+			return allMatrixWorkbenchMenuKeys(), true
+		}
+		value, err := s.store.MatrixAccountPlatform(r.Context(), id, workspaceType, workspaceID)
+		if err != nil || value == "" {
+			return nil, true
+		}
+		platform = value
+	case path == "/api/v1/matrix-account-web-spaces":
+		platform = strings.TrimSpace(r.URL.Query().Get("platform"))
+		if r.Method == http.MethodPost {
+			platform = requestPlatform(r)
+		}
+		if platform == "" {
+			return nil, true
+		}
+	case strings.HasPrefix(path, "/api/v1/matrix-account-web-spaces/"):
+		id := r.PathValue("id")
+		if id == "" {
+			return nil, true
+		}
+		value, err := s.store.MatrixWebSpacePlatform(r.Context(), id, workspaceType, workspaceID)
+		if err != nil || value == "" {
+			return nil, true
+		}
+		platform = value
+	case path == "/api/v1/matrix-account-login-attempts":
+		platform = requestPlatform(r)
+		if platform == "" {
+			return nil, true
+		}
+	case strings.HasPrefix(path, "/api/v1/matrix-account-login-attempts/"):
+		id := r.PathValue("id")
+		if id == "" {
+			return nil, true
+		}
+		value, err := s.store.MatrixLoginAttemptPlatform(r.Context(), id, workspaceType, workspaceID, membershipID)
+		if err != nil || value == "" {
+			return nil, true
+		}
+		platform = value
+	default:
+		return nil, false
+	}
+	if !validOneOf(platform, "douyin", "kuaishou", "xiaohongshu") {
+		return nil, true
+	}
+	return []string{"menu.workbench.matrix_accounts." + platform}, true
+}
+
+func requestPlatform(r *http.Request) string {
+	if r.Body == nil {
+		return ""
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, 64<<10))
+	r.Body = io.NopCloser(bytes.NewReader(body))
+	if err != nil || len(body) == 64<<10 {
+		return ""
+	}
+	var input struct {
+		Platform string `json:"platform"`
+	}
+	if json.Unmarshal(body, &input) != nil {
+		return ""
+	}
+	platform := strings.TrimSpace(input.Platform)
+	if !validOneOf(platform, "douyin", "kuaishou", "xiaohongshu") {
+		return ""
+	}
+	return platform
+}
+
+func allMatrixWorkbenchMenuKeys() []string {
+	return []string{"menu.workbench.matrix_accounts.douyin", "menu.workbench.matrix_accounts.kuaishou", "menu.workbench.matrix_accounts.xiaohongshu"}
+}
+
+func (s *Server) requireWorkbenchMenus(ctx context.Context, userID, sessionID, workspaceType, workspaceID string, keys []string) (bool, error) {
+	if s.cfg.InternalToken == "" || s.cfg.MembershipServiceURL == "" {
+		return false, fmt.Errorf("workbench authorization unavailable")
+	}
+	body, err := json.Marshal(map[string]any{"actorId": userID, "sessionId": sessionID, "workspaceType": workspaceType, "workspaceId": workspaceID, "requiredAllMenuKeys": keys})
+	if err != nil {
+		return false, err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, strings.TrimRight(s.cfg.MembershipServiceURL, "/")+"/internal/v1/access-decisions", bytes.NewReader(body))
+	if err != nil {
+		return false, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.InternalToken)
+	req.Header.Set("X-KY-Request-Id", menuRequestID())
+	client := &http.Client{Timeout: 2500 * time.Millisecond}
+	resp, err := client.Do(req)
+	if err != nil {
+		return false, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return false, fmt.Errorf("membership access decision status %d", resp.StatusCode)
+	}
+	var envelope struct {
+		Data struct {
+			Allowed bool `json:"allowed"`
+		} `json:"data"`
+	}
+	if err = json.NewDecoder(resp.Body).Decode(&envelope); err != nil {
+		return false, err
+	}
+	return envelope.Data.Allowed, nil
+}
+
+func menuRequestID() string {
+	var b [12]byte
+	_, _ = rand.Read(b[:])
+	return "matrix-menu-" + hex.EncodeToString(b[:])
+}
