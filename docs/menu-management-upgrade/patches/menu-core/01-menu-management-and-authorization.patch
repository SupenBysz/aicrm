--- /dev/null
+++ b/services/ky-membership-service/internal/store/workbench_menu_access_test.go
@@ -0,0 +1,204 @@
+package store
+
+import (
+	"reflect"
+	"sort"
+	"testing"
+)
+
+func TestResolveEffectiveWorkbenchMenuKeys(t *testing.T) {
+	got := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{"menu.a", "menu.shared", "menu.a"},
+		[]string{"menu.extra", "menu.shared"},
+		[]string{"menu.shared"},
+		[]string{"menu.a", "menu.shared", "menu.extra"},
+		[]string{"menu.a", "menu.shared", "menu.extra", "menu.inactive"},
+	)
+	want := []string{"menu.a", "menu.extra"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("effective keys=%v, want %v", got, want)
+	}
+}
+
+func TestResolveEffectiveWorkbenchMenuKeysHierarchyAndWorkspaceEligibility(t *testing.T) {
+	got := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{"menu.in.parent", "menu.outside.parent", "menu.disabled"},
+		[]string{"menu.direct.outside"}, nil,
+		[]string{"menu.in.parent", "menu.disabled"},
+		[]string{"menu.in.parent", "menu.outside.parent", "menu.direct.outside"},
+	)
+	if !reflect.DeepEqual(got, []string{"menu.in.parent"}) {
+		t.Fatalf("effective menu must intersect full current cap and eligible catalog, got %v", got)
+	}
+	if ValidateWorkbenchMenuGrantSet("enterprise", []string{"menu.in.parent"}, []string{"menu.in.parent"}, []string{"menu.in.parent"}) != true {
+		t.Fatal("subset of parent cap should be accepted")
+	}
+	for name, candidate := range map[string][]string{
+		"forged child key":         {"menu.in.parent", "menu.forged"},
+		"wrong workspace eligible": {"menu.agency.only"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if ValidateWorkbenchMenuGrantSet("enterprise", candidate, []string{"menu.in.parent", "menu.forged", "menu.agency.only"}, []string{"menu.in.parent"}) {
+				t.Fatal("ineligible or parent-exceeding grant accepted")
+			}
+		})
+	}
+	if ValidateWorkbenchMenuGrantSet("platform", []string{}, []string{}, []string{}) {
+		t.Fatal("platform must not become a child workspace grant target")
+	}
+}
+
+func TestEnterpriseOnlyMenuFlowsThroughAgencyBranchWithoutAgencyNavigationAccess(t *testing.T) {
+	const enterpriseOnly = "menu.workbench.talent_square.enterprise.douyin"
+	agencyBranch := []string{enterpriseOnly}
+
+	// The agency's branch cap retains enterprise-only keys, but its own
+	// workspace eligibility prevents bootstrap/navigation from exposing them.
+	agencyEffective := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{enterpriseOnly}, nil, nil, agencyBranch, []string{"menu.workbench.matrix_accounts.douyin"},
+	)
+	if len(agencyEffective) != 0 {
+		t.Fatalf("agency gained enterprise-only navigation: %v", agencyEffective)
+	}
+
+	// Enterprise access requires both its own grant and the direct agency
+	// branch grant. This is the same cap intersection used by the bootstrap
+	// resolver and EvaluateAccessDecision's RequiredAllMenuKeys check.
+	enterpriseOwn := []string{enterpriseOnly}
+	enterpriseCap := IntersectWorkbenchMenuKeys(enterpriseOwn, agencyBranch)
+	enterpriseEffective := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{enterpriseOnly}, nil, nil, enterpriseCap, []string{enterpriseOnly},
+	)
+	if !reflect.DeepEqual(enterpriseEffective, []string{enterpriseOnly}) {
+		t.Fatalf("enterprise grant should be effective with both caps: %v", enterpriseEffective)
+	}
+	if !WorkbenchMenuKeysContainAll(enterpriseEffective, []string{enterpriseOnly}) {
+		t.Fatal("RequiredAllMenuKeys-equivalent check denied a bootstrap-effective enterprise menu")
+	}
+
+	// Revoking the agency branch cap immediately removes the same key from the
+	// effective set used by RequiredAllMenuKeys authorization.
+	enterpriseCap = IntersectWorkbenchMenuKeys(enterpriseOwn, nil)
+	enterpriseEffective = ResolveEffectiveWorkbenchMenuKeys(
+		[]string{enterpriseOnly}, nil, nil, enterpriseCap, []string{enterpriseOnly},
+	)
+	if len(enterpriseEffective) != 0 {
+		t.Fatalf("enterprise access survived agency grant revocation: %v", enterpriseEffective)
+	}
+	if WorkbenchMenuKeysContainAll(enterpriseEffective, []string{enterpriseOnly}) {
+		t.Fatal("RequiredAllMenuKeys-equivalent check allowed a revoked agency menu")
+	}
+}
+
+func TestWorkbenchRouteRegistryIsClosed(t *testing.T) {
+	for _, key := range []string{
+		"workbench.overview", "workbench.todos", "workbench.messages", "workbench.shortcuts",
+		"workbench.matrix-accounts.douyin", "workbench.talent-square.enterprise.douyin",
+	} {
+		if !IsRegisteredWorkbenchRouteKey(key) {
+			t.Errorf("registered route key %q was rejected", key)
+		}
+	}
+	for _, key := range []string{"https://evil.example", "/workbench/any", "workbench.unknown.route", "workbench.talent-square.platform.douyin"} {
+		if IsRegisteredWorkbenchRouteKey(key) {
+			t.Errorf("unregistered route key %q was accepted", key)
+		}
+	}
+}
+
+func TestBuiltinWorkbenchMenusShareEligibilityAndCanBeNarrowedInEveryWorkspace(t *testing.T) {
+	builtins := []string{
+		"menu.workbench.overview", "menu.workbench.todos", "menu.workbench.messages", "menu.workbench.shortcuts",
+	}
+	allExpected := append([]string(nil), builtins...)
+	sort.Strings(allExpected)
+	narrowedExpected := append([]string(nil), builtins[:2]...)
+	sort.Strings(narrowedExpected)
+	for _, workspace := range []string{"platform", "agency", "enterprise"} {
+		t.Run(workspace, func(t *testing.T) {
+			if got := ResolveEffectiveWorkbenchMenuKeys(builtins, nil, nil, builtins, builtins); !reflect.DeepEqual(got, allExpected) {
+				t.Fatalf("first registration changed %s built-in visibility: got %v", workspace, got)
+			}
+			// Existing parent/agency caps can only narrow the candidate set.
+			narrowed := builtins[:2]
+			if got := ResolveEffectiveWorkbenchMenuKeys(builtins, nil, nil, narrowed, builtins); !reflect.DeepEqual(got, narrowedExpected) {
+				t.Fatalf("%s menu cap was bypassed: got %v want %v", workspace, got, narrowedExpected)
+			}
+		})
+	}
+}
+
+func TestWorkbenchMenuCatalogInputRequiresClosedRegisteredRoutesAndSafeFields(t *testing.T) {
+	route := "workbench.matrix-accounts.douyin"
+	base := WorkbenchMenuInput{
+		MenuKey: "menu.workbench.matrix_accounts.douyin", Name: "抖音账号", Icon: "AppstoreOutlined",
+		WorkspaceTypes: []string{"platform", "agency"}, RouteKey: &route,
+	}
+	if !validateWorkbenchMenuInput(base) {
+		t.Fatal("valid registered workbench menu rejected")
+	}
+	invalid := base
+	unsafeRoute := "https://evil.example"
+	invalid.RouteKey = &unsafeRoute
+	if validateWorkbenchMenuInput(invalid) {
+		t.Fatal("arbitrary URL route was accepted")
+	}
+	invalid = base
+	invalid.MenuKey = "../../external"
+	if validateWorkbenchMenuInput(invalid) {
+		t.Fatal("unsafe menu key was accepted")
+	}
+	invalid = base
+	invalid.WorkspaceTypes = []string{"agency", "agency"}
+	if validateWorkbenchMenuInput(invalid) {
+		t.Fatal("duplicate workspace type was accepted")
+	}
+}
+
+func TestWorkbenchMenuSetRejectsDuplicateAndOutOfCapKeys(t *testing.T) {
+	eligible := []string{"menu.allowed", "menu.also_allowed"}
+	cap := []string{"menu.allowed"}
+	if !validateWorkbenchMenuSet([]string{"menu.allowed"}, cap, eligible) {
+		t.Fatal("eligible in-cap menu should be accepted")
+	}
+	for name, candidate := range map[string][]string{
+		"outside cap":   {"menu.also_allowed"},
+		"unknown menu":  {"menu.unknown"},
+		"duplicate key": {"menu.allowed", "menu.allowed"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if validateWorkbenchMenuSet(candidate, cap, eligible) {
+				t.Fatalf("invalid candidate accepted: %v", candidate)
+			}
+		})
+	}
+}
+
+func TestWorkbenchRoleUnionMembershipAllowAndDenyRemainWorkspaceBounded(t *testing.T) {
+	got := ResolveEffectiveWorkbenchMenuKeys(
+		[]string{"menu.from.role.one", "menu.from.role.two", "menu.denied"},
+		[]string{"menu.direct.allow", "menu.denied"},
+		[]string{"menu.denied"},
+		[]string{"menu.from.role.one", "menu.from.role.two", "menu.direct.allow", "menu.denied"},
+		[]string{"menu.from.role.one", "menu.from.role.two", "menu.direct.allow", "menu.denied", "menu.other.workspace"},
+	)
+	want := []string{"menu.direct.allow", "menu.from.role.one", "menu.from.role.two"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("role union/allow/deny result=%v want=%v", got, want)
+	}
+}
+
+func TestRoleMenuChangeValidationGrandfathersButDoesNotExpandOutsideCurrentCap(t *testing.T) {
+	current := []string{"menu.current", "menu.parent_removed"}
+	limit := []string{"menu.current", "menu.within_cap"}
+	eligible := []string{"menu.current", "menu.within_cap", "menu.parent_removed", "menu.forged_outside"}
+	if !validateWorkbenchMenuAdditions([]string{"menu.current", "menu.parent_removed", "menu.within_cap"}, current, limit, eligible) {
+		t.Fatal("unchanged legacy menu plus in-cap addition should be accepted")
+	}
+	if validateWorkbenchMenuAdditions([]string{"menu.current", "menu.parent_removed", "menu.forged_outside"}, current, limit, eligible) {
+		t.Fatal("new out-of-cap menu must be rejected")
+	}
+	if got := addedMenuKeys([]string{"menu.current", "menu.parent_removed"}, current); len(got) != 0 {
+		t.Fatalf("unchanged grandfathered assignment should not become a new grant: %v", got)
+	}
+}
diff --git a/services/ky-membership-service/internal/store/workbench_menu_admin.go b/services/ky-membership-service/internal/store/workbench_menu_admin.go
new file mode 100644
index 0000000..b390e48
--- /dev/null
+++ b/services/ky-membership-service/internal/store/workbench_menu_admin.go
@@ -0,0 +1,657 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+var workbenchMenuKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{2,127}$`)
+var workbenchMenuIconPattern = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9]{0,63}$`)
+
+func (s *Store) ReadWorkbenchCommandReceipt(ctx context.Context, wsType, wsID, command, key, requestHash string) (json.RawMessage, bool, error) {
+	var storedHash string
+	var response []byte
+	err := s.db.QueryRowContext(ctx, `SELECT request_hash,response FROM ky_workbench_menu_command_receipt WHERE workspace_type=$1 AND workspace_id=$2 AND command_type=$3 AND idempotency_key=$4`, wsType, wsID, command, key).Scan(&storedHash, &response)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	if storedHash != requestHash {
+		return nil, false, ErrConflict
+	}
+	return json.RawMessage(response), true, nil
+}
+
+func (s *Store) SaveWorkbenchCommandReceipt(ctx context.Context, wsType, wsID, command, key, requestHash string, response any) error {
+	body, err := json.Marshal(response)
+	if err != nil {
+		return err
+	}
+	_, err = s.db.ExecContext(ctx, `INSERT INTO ky_workbench_menu_command_receipt(workspace_type,workspace_id,command_type,idempotency_key,request_hash,response) VALUES($1,$2,$3,$4,$5,$6::jsonb) ON CONFLICT(workspace_type,workspace_id,command_type,idempotency_key) DO NOTHING`, wsType, wsID, command, key, requestHash, string(body))
+	return err
+}
+
+type WorkbenchMenu struct {
+	MenuKey        string   `json:"menuKey"`
+	Name           string   `json:"name"`
+	Icon           string   `json:"icon"`
+	ParentKey      *string  `json:"parentKey"`
+	SortOrder      int      `json:"sortOrder"`
+	WorkspaceTypes []string `json:"workspaceTypes"`
+	RouteKey       *string  `json:"routeKey"`
+	Status         string   `json:"status"`
+	Revision       int64    `json:"revision"`
+}
+
+type WorkbenchMenuInput struct {
+	MenuKey          string   `json:"menuKey"`
+	Name             string   `json:"name"`
+	Icon             string   `json:"icon"`
+	ParentKey        *string  `json:"parentKey"`
+	SortOrder        int      `json:"sortOrder"`
+	WorkspaceTypes   []string `json:"workspaceTypes"`
+	RouteKey         *string  `json:"routeKey"`
+	ExpectedRevision int64    `json:"expectedRevision"`
+	Status           string   `json:"status,omitempty"`
+}
+
+type WorkbenchMenuGrantSet struct {
+	WorkspaceType       string   `json:"workspaceType"`
+	WorkspaceID         string   `json:"workspaceId"`
+	ParentWorkspaceType string   `json:"parentWorkspaceType"`
+	ParentWorkspaceID   string   `json:"parentWorkspaceId"`
+	MenuKeys            []string `json:"menuKeys"`
+	EffectiveMenuKeys   []string `json:"effectiveMenuKeys"`
+	Revision            int64    `json:"revision"`
+}
+
+type WorkbenchMenuOverrides struct {
+	MembershipID string   `json:"membershipId"`
+	Allow        []string `json:"allow"`
+	Deny         []string `json:"deny"`
+	Revision     int64    `json:"revision"`
+}
+
+func (s *Store) ListWorkbenchMenus(ctx context.Context, workspaceType string) ([]WorkbenchMenu, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT menu_key,name,icon,parent_key,sort_order,workspace_types,route_key,status,revision FROM ky_workbench_menu
+		WHERE $1='' OR ($1='agency_grantable' AND (workspace_types @> '["agency"]'::jsonb OR workspace_types @> '["enterprise"]'::jsonb))
+		OR ($1 NOT IN ('','agency_grantable') AND workspace_types @> to_jsonb(ARRAY[$1::text])) ORDER BY sort_order,menu_key`, workspaceType)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []WorkbenchMenu{}
+	for rows.Next() {
+		var item WorkbenchMenu
+		var workspaceTypes []byte
+		if err := rows.Scan(&item.MenuKey, &item.Name, &item.Icon, &item.ParentKey, &item.SortOrder, &workspaceTypes, &item.RouteKey, &item.Status, &item.Revision); err != nil {
+			return nil, err
+		}
+		if err := json.Unmarshal(workspaceTypes, &item.WorkspaceTypes); err != nil {
+			return nil, err
+		}
+		items = append(items, item)
+	}
+	return items, rows.Err()
+}
+
+func validateWorkbenchMenuInput(in WorkbenchMenuInput) bool {
+	if !workbenchMenuKeyPattern.MatchString(in.MenuKey) || strings.TrimSpace(in.Name) == "" || len(in.Name) > 120 || len(in.Icon) > 64 || (in.Icon != "" && !workbenchMenuIconPattern.MatchString(in.Icon)) || in.SortOrder < -10000 || in.SortOrder > 10000 || len(in.WorkspaceTypes) == 0 {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, ws := range in.WorkspaceTypes {
+		if !validWorkbenchWorkspaceType(ws) || seen[ws] {
+			return false
+		}
+		seen[ws] = true
+	}
+	if in.RouteKey != nil && !IsRegisteredWorkbenchRouteKey(*in.RouteKey) {
+		return false
+	}
+	return true
+}
+
+func validateWorkbenchMenuParent(ctx context.Context, tx *sql.Tx, parentKey, childKey string, childWorkspaceTypes []string) error {
+	var status string
+	var route sql.NullString
+	var rawWorkspaceTypes []byte
+	if err := tx.QueryRowContext(ctx, `SELECT status,route_key,workspace_types FROM ky_workbench_menu WHERE menu_key=$1 FOR SHARE`, parentKey).Scan(&status, &route, &rawWorkspaceTypes); err != nil {
+		return err
+	}
+	if status != "active" || route.Valid || parentKey == childKey {
+		return ErrValidation
+	}
+	var parentWorkspaceTypes []string
+	if err := json.Unmarshal(rawWorkspaceTypes, &parentWorkspaceTypes); err != nil {
+		return err
+	}
+	parentTypes := stringSet(parentWorkspaceTypes)
+	for _, workspaceType := range childWorkspaceTypes {
+		if _, ok := parentTypes[workspaceType]; !ok {
+			return ErrValidation
+		}
+	}
+	var createsCycle bool
+	err := tx.QueryRowContext(ctx, `WITH RECURSIVE ancestors(menu_key,parent_key,path) AS (
+		SELECT menu_key,parent_key,ARRAY[menu_key] FROM ky_workbench_menu WHERE menu_key=$1
+		UNION ALL
+		SELECT m.menu_key,m.parent_key,a.path||m.menu_key FROM ky_workbench_menu m JOIN ancestors a ON m.menu_key=a.parent_key WHERE NOT m.menu_key=ANY(a.path)
+	) SELECT EXISTS(SELECT 1 FROM ancestors WHERE menu_key=$2)`, parentKey, childKey).Scan(&createsCycle)
+	if err != nil {
+		return err
+	}
+	if createsCycle {
+		return ErrValidation
+	}
+	return nil
+}
+
+func validateWorkbenchMenuChildren(ctx context.Context, tx *sql.Tx, key string, routeKey *string, workspaceTypes []string) error {
+	rows, err := tx.QueryContext(ctx, `SELECT workspace_types FROM ky_workbench_menu WHERE parent_key=$1 AND status='active' ORDER BY menu_key`, key)
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	if routeKey != nil {
+		if rows.Next() {
+			return ErrConflict
+		}
+		return rows.Err()
+	}
+	allowed := stringSet(workspaceTypes)
+	for rows.Next() {
+		var raw []byte
+		if err := rows.Scan(&raw); err != nil {
+			return err
+		}
+		var childTypes []string
+		if err := json.Unmarshal(raw, &childTypes); err != nil {
+			return err
+		}
+		for _, childType := range childTypes {
+			if _, ok := allowed[childType]; !ok {
+				return ErrConflict
+			}
+		}
+	}
+	return rows.Err()
+}
+
+func (s *Store) CreateWorkbenchMenu(ctx context.Context, in WorkbenchMenuInput, actor string) (WorkbenchMenu, error) {
+	if !validateWorkbenchMenuInput(in) {
+		return WorkbenchMenu{}, ErrValidation
+	}
+	workspaceTypes, _ := json.Marshal(in.WorkspaceTypes)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	defer tx.Rollback()
+	if in.ParentKey != nil {
+		if err = validateWorkbenchMenuParent(ctx, tx, *in.ParentKey, in.MenuKey, in.WorkspaceTypes); err != nil {
+			return WorkbenchMenu{}, ErrValidation
+		}
+	}
+	_, err = tx.ExecContext(ctx, `INSERT INTO ky_workbench_menu(menu_key,name,icon,parent_key,sort_order,workspace_types,route_key,status,revision,created_by,updated_by) VALUES($1,$2,$3,$4,$5,$6::jsonb,$7,'active',1,$8,$8)`, in.MenuKey, in.Name, in.Icon, in.ParentKey, in.SortOrder, string(workspaceTypes), in.RouteKey, actor)
+	if err != nil {
+		return WorkbenchMenu{}, ErrConflict
+	}
+	if in.RouteKey != nil {
+		_, err = tx.ExecContext(ctx, `INSERT INTO ky_permission(id,code,name,category,resource,action,workspace_types,description,status) VALUES('perm_'||md5($1),$1,$2,'menu','workbench',$3,$4::jsonb,'工作台菜单目录权限','normal') ON CONFLICT(code) DO NOTHING`, in.MenuKey, in.Name, *in.RouteKey, string(workspaceTypes))
+		if err != nil {
+			return WorkbenchMenu{}, err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return WorkbenchMenu{}, err
+	}
+	return WorkbenchMenu{MenuKey: in.MenuKey, Name: in.Name, Icon: in.Icon, ParentKey: in.ParentKey, SortOrder: in.SortOrder, WorkspaceTypes: in.WorkspaceTypes, RouteKey: in.RouteKey, Status: "active", Revision: 1}, nil
+}
+
+func nullString(value *string) string {
+	if value == nil {
+		return ""
+	}
+	return *value
+}
+
+func (s *Store) UpdateWorkbenchMenu(ctx context.Context, key string, in WorkbenchMenuInput, actor string) (WorkbenchMenu, error) {
+	if key != in.MenuKey || !validateWorkbenchMenuInput(in) || in.ExpectedRevision < 1 {
+		return WorkbenchMenu{}, ErrValidation
+	}
+	if in.Status != "" && in.Status != "active" {
+		return WorkbenchMenu{}, ErrValidation
+	}
+	if in.ParentKey != nil && *in.ParentKey == key {
+		return WorkbenchMenu{}, ErrValidation
+	}
+	workspaceTypes, _ := json.Marshal(in.WorkspaceTypes)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	defer tx.Rollback()
+	var currentRevision int64
+	if err = tx.QueryRowContext(ctx, `SELECT revision FROM ky_workbench_menu WHERE menu_key=$1 AND status='active' FOR UPDATE`, key).Scan(&currentRevision); errors.Is(err, sql.ErrNoRows) {
+		return WorkbenchMenu{}, ErrNotFound
+	} else if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	if currentRevision != in.ExpectedRevision {
+		return WorkbenchMenu{}, ErrConflict
+	}
+	if in.ParentKey != nil {
+		if err = validateWorkbenchMenuParent(ctx, tx, *in.ParentKey, key, in.WorkspaceTypes); err != nil {
+			return WorkbenchMenu{}, ErrValidation
+		}
+	}
+	if err = validateWorkbenchMenuChildren(ctx, tx, key, in.RouteKey, in.WorkspaceTypes); err != nil {
+		return WorkbenchMenu{}, err
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE ky_workbench_menu SET name=$2,icon=$3,parent_key=$4,sort_order=$5,workspace_types=$6::jsonb,route_key=$7,status=COALESCE(NULLIF($8,''),status),revision=revision+1,updated_by=$9,updated_at=now() WHERE menu_key=$1 AND revision=$10`, key, in.Name, in.Icon, in.ParentKey, in.SortOrder, string(workspaceTypes), in.RouteKey, in.Status, actor, in.ExpectedRevision)
+	if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	n, _ := result.RowsAffected()
+	if n == 0 {
+		return WorkbenchMenu{}, ErrConflict
+	}
+	if in.RouteKey != nil {
+		_, err = tx.ExecContext(ctx, `INSERT INTO ky_permission(id,code,name,category,resource,action,workspace_types,description,status)
+			VALUES('perm_'||md5($1),$1,$2,'menu','workbench',$3,$4::jsonb,'工作台菜单目录权限','normal')
+			ON CONFLICT(code) DO UPDATE SET name=EXCLUDED.name,action=EXCLUDED.action,workspace_types=EXCLUDED.workspace_types,status='normal'
+			WHERE ky_permission.category='menu' AND ky_permission.resource='workbench'`, key, in.Name, *in.RouteKey, string(workspaceTypes))
+	} else {
+		_, err = tx.ExecContext(ctx, `UPDATE ky_permission SET status='disabled' WHERE code=$1 AND category='menu' AND resource='workbench'`, key)
+	}
+	if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	if err = tx.Commit(); err != nil {
+		return WorkbenchMenu{}, err
+	}
+	items, err := s.ListWorkbenchMenus(ctx, "")
+	if err != nil {
+		return WorkbenchMenu{}, err
+	}
+	for _, item := range items {
+		if item.MenuKey == key {
+			return item, nil
+		}
+	}
+	return WorkbenchMenu{}, ErrNotFound
+}
+
+func (s *Store) DisableWorkbenchMenu(ctx context.Context, key string, expected int64, actor string) error {
+	if expected < 1 {
+		return ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var currentStatus string
+	var currentRevision int64
+	if err := tx.QueryRowContext(ctx, `SELECT status,revision FROM ky_workbench_menu WHERE menu_key=$1 FOR UPDATE`, key).Scan(&currentStatus, &currentRevision); errors.Is(err, sql.ErrNoRows) {
+		return ErrNotFound
+	} else if err != nil {
+		return err
+	}
+	if currentStatus != "active" || currentRevision != expected {
+		return ErrConflict
+	}
+	var children int
+	if err := tx.QueryRowContext(ctx, `SELECT count(*) FROM ky_workbench_menu WHERE parent_key=$1 AND status='active'`, key).Scan(&children); err != nil {
+		return err
+	}
+	if children > 0 {
+		return ErrConflict
+	}
+	res, err := tx.ExecContext(ctx, `UPDATE ky_workbench_menu SET status='disabled',revision=revision+1,updated_by=$3,updated_at=now() WHERE menu_key=$1 AND revision=$2 AND status='active'`, key, expected, actor)
+	if err != nil {
+		return err
+	}
+	n, _ := res.RowsAffected()
+	if n == 0 {
+		return ErrConflict
+	}
+	if _, err = tx.ExecContext(ctx, `UPDATE ky_permission SET status='disabled' WHERE code=$1 AND category='menu'`, key); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+func (s *Store) ReadWorkbenchGrantSet(ctx context.Context, wsType, wsID string) (WorkbenchMenuGrantSet, error) {
+	var out WorkbenchMenuGrantSet
+	out.WorkspaceType = wsType
+	out.WorkspaceID = wsID
+	out.MenuKeys = []string{}
+	out.EffectiveMenuKeys = []string{}
+	err := s.db.QueryRowContext(ctx, `SELECT parent_workspace_type,parent_workspace_id,revision FROM ky_workbench_menu_grant_set WHERE workspace_type=$1 AND workspace_id=$2`, wsType, wsID).Scan(&out.ParentWorkspaceType, &out.ParentWorkspaceID, &out.Revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		if wsType == "agency" {
+			var exists bool
+			if err := s.db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_agency WHERE id=$1 AND status='normal')`, wsID).Scan(&exists); err != nil {
+				return out, err
+			}
+			if !exists {
+				return out, ErrNotFound
+			}
+			out.ParentWorkspaceType, out.ParentWorkspaceID, out.Revision = "platform", "platform_root", 1
+			return out, nil
+		}
+		if wsType == "enterprise" {
+			if err := s.db.QueryRowContext(ctx, `SELECT agency_id FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL AND agency_id IS NOT NULL`, wsID).Scan(&out.ParentWorkspaceID); err != nil {
+				return out, ErrNotFound
+			}
+			out.ParentWorkspaceType, out.Revision = "agency", 1
+			return out, nil
+		}
+		return out, ErrNotFound
+	}
+	if err != nil {
+		return out, err
+	}
+	rows, err := s.db.QueryContext(ctx, `SELECT menu_key FROM ky_workbench_menu_grant WHERE workspace_type=$1 AND workspace_id=$2 AND status='allowed' ORDER BY menu_key`, wsType, wsID)
+	if err != nil {
+		return out, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var key string
+		if err = rows.Scan(&key); err != nil {
+			return out, err
+		}
+		out.MenuKeys = append(out.MenuKeys, key)
+	}
+	if err = rows.Err(); err != nil {
+		return out, err
+	}
+	if wsType == "agency" || wsType == "enterprise" {
+		out.EffectiveMenuKeys, err = s.effectiveWorkbenchGrantKeys(ctx, wsType, wsID)
+		if err != nil {
+			return out, err
+		}
+	}
+	return out, nil
+}
