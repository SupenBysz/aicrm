+function menu(menuKey, { parentKey = null, routeKey = null, sortOrder = 0, status = "active", workspaceTypes = ["platform"] } = {}) {
+  return { menuKey, name: menuKey, icon: "", parentKey, sortOrder, workspaceTypes, routeKey, status, revision: 1 };
+}
+
+test("tree follows parentKey, sorts each level stably, and retains disabled/orphan records", () => {
+  const tree = buildWorkbenchMenuTree([
+    menu("root-b", { sortOrder: 2 }),
+    menu("child-z", { parentKey: "root-a", routeKey: "page.z", sortOrder: 1, status: "disabled" }),
+    menu("orphan", { parentKey: "missing", routeKey: "page.orphan" }),
+    menu("root-a", { sortOrder: 1 }),
+    menu("child-a", { parentKey: "root-a", routeKey: "page.a", sortOrder: 1 }),
+    menu("child-b", { parentKey: "root-a", routeKey: "page.b", sortOrder: 1 })
+  ]);
+
+  assert.deepEqual(tree.map((node) => node.menuKey), ["orphan", "root-a", "root-b"]);
+  assert.deepEqual(tree.find((node) => node.menuKey === "root-a").children.map((node) => node.menuKey), ["child-z", "child-a", "child-b"]);
+  assert.equal(tree.find((node) => node.menuKey === "root-a").children[0].status, "disabled");
+});
+
+test("cyclic parent references are detached deterministically without losing rows", () => {
+  const tree = buildWorkbenchMenuTree([
+    menu("group-a", { parentKey: "group-b" }),
+    menu("group-b", { parentKey: "group-a" }),
+    menu("page", { parentKey: "group-b", routeKey: "page.test" })
+  ]);
+  assert.equal(tree.length, 1);
+  assert.equal(tree[0].menuKey, "group-a");
+  assert.deepEqual(tree[0].children.map((node) => node.menuKey), ["group-b"]);
+  assert.deepEqual(tree[0].children[0].children.map((node) => node.menuKey), ["page"]);
+  assert.equal(tree.flatMap((node) => [node, ...node.children, ...node.children.flatMap((child) => child.children)]).length, 3);
+});
