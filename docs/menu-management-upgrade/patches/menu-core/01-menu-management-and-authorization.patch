+		t.Fatalf("duplicate role normalization=%v err=%v", roles, err)
+	}
+	for name, mutate := range map[string]func(*MenuWorkspaceAllowlistInput){
+		"invalid menu key":  func(in *MenuWorkspaceAllowlistInput) { in.MenuKey = "UPPER SPACE" },
+		"unknown directory": func(in *MenuWorkspaceAllowlistInput) { in.DirectoryType = "unknown" },
+		"unknown workspace": func(in *MenuWorkspaceAllowlistInput) { in.WorkspaceType = "global" },
+		"negative revision": func(in *MenuWorkspaceAllowlistInput) { in.ExpectedRevision = -1 },
+		"role count capped": func(in *MenuWorkspaceAllowlistInput) { in.RoleIDs = make([]string, maxMenuAllowlistEntries+1) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			in := base
+			mutate(&in)
+			if ValidMenuWorkspaceAllowlistInput(in) {
+				t.Fatal("invalid input accepted")
+			}
+		})
+	}
+}
+
+func TestMenuAllowlistMigrationIsRepeatableAndDefaultsToNoRestriction(t *testing.T) {
+	content, err := os.ReadFile("../../../../ops/db/110_menu_workspace_allowlists.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql := string(content)
+	for _, required := range []string{"CREATE TABLE IF NOT EXISTS ky_menu_workspace_allowlist", "CREATE TABLE IF NOT EXISTS ky_menu_workspace_allowlist_role", "CREATE TABLE IF NOT EXISTS ky_menu_workspace_allowlist_membership", "enabled boolean NOT NULL DEFAULT false", "PRIMARY KEY(directory_type,menu_key,workspace_type,workspace_id)"} {
+		if !strings.Contains(sql, required) {
+			t.Fatalf("migration missing %q", required)
+		}
+	}
+	if strings.Contains(sql, "INSERT INTO ky_menu_workspace_allowlist(") {
+		t.Fatal("migration must leave existing menu behavior disabled by absence")
+	}
+}
+
+func TestPlatformAllowlistTargetsRequireCanonicalActorWorkspace(t *testing.T) {
