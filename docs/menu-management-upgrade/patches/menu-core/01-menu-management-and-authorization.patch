+		DirectoryType:    directoryType,
+		MenuKey:          menuKey,
+		WorkspaceType:    workspaceType,
+		WorkspaceID:      workspaceID,
+		Enabled:          *p.Enabled,
+		RoleIDs:          p.RoleIDs,
+		MembershipIDs:    p.MembershipIDs,
+		ExpectedRevision: *p.ExpectedRevision,
+	}
+	if !store.ValidMenuWorkspaceAllowlistInput(in) {
