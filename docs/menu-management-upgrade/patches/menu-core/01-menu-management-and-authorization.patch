+	request.Header.Set("Idempotency-Key", "retry-same-key")
+	recorder := httptest.NewRecorder()
+	auditCalls := 0
+	audit := func(*http.Request, wsContext, string, string, string, string, ...map[string]any) { auditCalls++ }
+	wasReplayed := replayWorkbenchResponse(recorder, request, wsContext{WorkspaceType: "agency", WorkspaceID: "agency-a"}, "menu.update", map[string]string{"value": "different"}, fixedWorkbenchReceipt{err: store.ErrConflict}, audit)
+	if !wasReplayed || recorder.Code != http.StatusConflict || !strings.Contains(recorder.Body.String(), "idempotency_key_reused") {
+		t.Fatalf("reused key should be rejected, replayed=%v status=%d body=%s", wasReplayed, recorder.Code, recorder.Body.String())
+	}
+	if auditCalls != 1 {
+		t.Fatalf("mismatched key audit calls=%d, want 1", auditCalls)
+	}
+}
