+  });
+  assert.equal(groupIcon.type, "button");
+  assert.equal(groupIcon.props["aria-expanded"], false);
+  assert.equal(groupIcon.props.style, undefined, "parent icon keeps the existing Ant Design theme color");
+  assert.match(groupIcon.props.className, /ant-table-row-expand-icon-collapsed/, "a collapsed parent draws a plus");
+  groupIcon.props.onClick({ stopPropagation: () => { stoppedPropagation = true; } });
+  assert.equal(expandedRecord, group, "parent toggle must invoke the table expand handler");
+  assert.equal(stoppedPropagation, true);
+  let collapsedRecord;
+  const expandedGroupIcon = renderWorkbenchMenuExpandIcon({
+    prefixCls: "ant-table",
+    expanded: true,
+    record: group,
+    onExpand: (record) => { collapsedRecord = record; }
+  });
+  assert.match(expandedGroupIcon.props.className, /ant-table-row-expand-icon-expanded/, "an expanded parent draws a minus");
+  assert.equal(expandedGroupIcon.props.style, undefined, "expanded parent restores the original Ant Design color behavior");
+  assert.equal(expandedGroupIcon.props.children, undefined, "expanded parent keeps the original Ant Design pseudo-element minus");
+  expandedGroupIcon.props.onClick({ stopPropagation: () => {} });
+  assert.equal(collapsedRecord, group, "the expanded minus remains an operable collapse button");
+
+  const html = renderToStaticMarkup(createElement(Table, {
+    dataSource: tree,
+    rowKey: "menuKey",
+    pagination: false,
+    expandable: {
+      defaultExpandAllRows: true,
+      rowExpandable: isWorkbenchMenuExpandable,
+      expandIcon: props => renderWorkbenchMenuExpandIcon({ ...props, leafColor: "#d9d9d9" })
+    },
+    columns: [{ title: "名称", dataIndex: "name" }]
+  }));
+  assert.equal((html.match(/class="ant-table-row-expand-icon /g) ?? []).length, 3, "all rows keep the same icon slot");
+  const groupRow = html.match(/<tr[^>]*data-row-key="group"[\s\S]*?<\/tr>/)?.[0];
+  const leafRow = html.match(/<tr[^>]*data-row-key="page"[\s\S]*?<\/tr>/)?.[0];
+  const standaloneRow = html.match(/<tr[^>]*data-row-key="standalone"[\s\S]*?<\/tr>/)?.[0];
+  assert.match(groupRow ?? "", /<button[^>]*ant-table-row-expand-icon ant-table-row-expand-icon-expanded/);
+  assert.doesNotMatch(groupRow ?? "", /workbench-menu-parent-expanded-minus|color:#bfbfbf/);
+  assert.doesNotMatch(leafRow ?? "", /<button/);
+  assert.doesNotMatch(standaloneRow ?? "", /<button/);
+  assert.match(leafRow ?? "", /<span[^>]*aria-hidden="true"[^>]*ant-table-row-expand-icon workbench-menu-leaf-minus[^>]*style="cursor:default;color:#d9d9d9;border-color:#d9d9d9"[^>]*><svg[^>]*><path[^>]*stroke="currentColor"/);
+  assert.match(standaloneRow ?? "", /<span[^>]*aria-hidden="true"[^>]*ant-table-row-expand-icon workbench-menu-leaf-minus[^>]*style="cursor:default;color:#d9d9d9;border-color:#d9d9d9"[^>]*><svg[^>]*><path[^>]*stroke="currentColor"/);
+
+  const page = await readFile(new URL("./pages/workbench-menus-page.tsx", import.meta.url), "utf8");
+  const hostStyles = await readFile(new URL("../../../apps/ky-admin-host/src/styles.css", import.meta.url), "utf8");
+  assert.match(page, /defaultExpandAllRows:\s*true/);
+  assert.match(page, /rowExpandable:\s*isWorkbenchMenuExpandable/);
+  assert.match(page, /expandIcon:\s*props\s*=>\s*renderWorkbenchMenuExpandIcon\(\{\s*\.\.\.props,\s*leafColor:\s*token\.colorBorderSecondary\s*\}\)/);
+  assert.match(hostStyles, /\.ant-table-row-expand-icon\.workbench-menu-leaf-minus::before,[\s\S]*?\.ant-table-row-expand-icon\.workbench-menu-leaf-minus::after\s*\{\s*display:\s*none !important;\s*content:\s*none !important;/);
+});
+
+test("descendant lookup is cycle-safe and excludes the selected group itself", () => {
+  const items = [
+    menu("a", { parentKey: "b" }),
+    menu("b", { parentKey: "a" }),
+    menu("c", { parentKey: "b", routeKey: "page.c" })
