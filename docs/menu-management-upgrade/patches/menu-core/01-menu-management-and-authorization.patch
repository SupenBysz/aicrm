+func TestWorkbenchIdempotentSuccessReplayDoesNotAuditAgain(t *testing.T) {
+	request := httptest.NewRequest(http.MethodPut, "/api/v1/workbench-menus", strings.NewReader(`{}`))
+	request.Header.Set("Idempotency-Key", "retry-same-key")
+	recorder := httptest.NewRecorder()
+	auditCalls := 0
+	audit := func(*http.Request, wsContext, string, string, string, string, ...map[string]any) { auditCalls++ }
+	wasReplayed := replayWorkbenchResponse(recorder, request, wsContext{WorkspaceType: "agency", WorkspaceID: "agency-a"}, "menu.update", map[string]string{"value": "same"}, fixedWorkbenchReceipt{response: json.RawMessage(`{"menuKey":"menu.workbench.matrix_accounts.douyin","revision":3}`)}, audit)
+	if !wasReplayed {
+		t.Fatal("stored successful receipt was not replayed")
+	}
+	if auditCalls != 0 {
+		t.Fatalf("successful replay wrote %d audit records; want no duplicate mutation audit", auditCalls)
+	}
+	var envelope struct {
+		Data map[string]any `json:"data"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
+		t.Fatalf("decode replay envelope: %v", err)
+	}
+	if envelope.Data["menuKey"] != "menu.workbench.matrix_accounts.douyin" || envelope.Data["revision"] != float64(3) {
+		t.Fatalf("replay returned a different result: %#v", envelope.Data)
+	}
+}
