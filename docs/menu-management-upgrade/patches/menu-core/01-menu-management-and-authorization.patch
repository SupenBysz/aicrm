diff --git a/services/ky-membership-service/internal/store/management_menu_catalog.go b/services/ky-membership-service/internal/store/management_menu_catalog.go
new file mode 100644
index 0000000..6aba5b1
--- /dev/null
+++ b/services/ky-membership-service/internal/store/management_menu_catalog.go
@@ -0,0 +1,339 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"strings"
+)
+
+var managementMenuPathPattern = regexp.MustCompile(`^/[A-Za-z0-9._/-]{1,255}$`)
+
+type ManagementMenu struct {
+	MenuKey        string   `json:"menuKey"`
+	Name           string   `json:"name"`
+	Icon           string   `json:"icon"`
+	ParentKey      *string  `json:"parentKey"`
+	SortOrder      int      `json:"sortOrder"`
+	WorkspaceTypes []string `json:"workspaceTypes"`
+	RoutePath      *string  `json:"routePath"`
+	PermissionKeys []string `json:"permissionKeys"`
+	Status         string   `json:"status"`
+	Revision       int64    `json:"revision"`
+}
+
+type ManagementMenuInput struct {
+	MenuKey          string   `json:"menuKey"`
+	Name             string   `json:"name"`
+	Icon             string   `json:"icon"`
+	ParentKey        *string  `json:"parentKey"`
+	SortOrder        int      `json:"sortOrder"`
+	WorkspaceTypes   []string `json:"workspaceTypes"`
+	RoutePath        *string  `json:"routePath"`
+	PermissionKeys   []string `json:"permissionKeys"`
+	ExpectedRevision int64    `json:"expectedRevision"`
+}
+
+func validManagementMenuInput(in ManagementMenuInput) bool {
+	if !workbenchMenuKeyPattern.MatchString(in.MenuKey) || strings.TrimSpace(in.Name) == "" || len(in.Name) > 120 ||
+		len(in.Icon) > 64 || (in.Icon != "" && !workbenchMenuIconPattern.MatchString(in.Icon)) ||
+		in.SortOrder < -10000 || in.SortOrder > 10000 || len(in.WorkspaceTypes) == 0 {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, workspaceType := range in.WorkspaceTypes {
+		if !validWorkbenchWorkspaceType(workspaceType) || seen[workspaceType] {
+			return false
+		}
+		seen[workspaceType] = true
+	}
+	if in.RoutePath == nil && len(in.PermissionKeys) > 0 {
+		return false
+	}
+	if in.RoutePath != nil {
+		path := *in.RoutePath
+		if !managementMenuPathPattern.MatchString(path) || strings.Contains(path, "//") || strings.Contains(path, "..") || len(in.PermissionKeys) == 0 {
+			return false
+		}
+		seenPermissions := map[string]bool{}
+		for _, permission := range in.PermissionKeys {
+			if !workbenchMenuKeyPattern.MatchString(permission) || seenPermissions[permission] {
+				return false
+			}
+			seenPermissions[permission] = true
+		}
+	}
+	return true
+}
+
+func scanManagementMenu(row interface{ Scan(...any) error }) (ManagementMenu, error) {
+	var item ManagementMenu
+	var parent, path sql.NullString
+	var rawWorkspaceTypes, rawPermissionKeys []byte
+	err := row.Scan(&item.MenuKey, &item.Name, &item.Icon, &parent, &item.SortOrder, &rawWorkspaceTypes, &path, &rawPermissionKeys, &item.Status, &item.Revision)
+	if err != nil {
+		return ManagementMenu{}, err
+	}
+	if parent.Valid {
+		item.ParentKey = &parent.String
+	}
+	if path.Valid {
+		item.RoutePath = &path.String
+	}
+	if err := json.Unmarshal(rawWorkspaceTypes, &item.WorkspaceTypes); err != nil {
+		return ManagementMenu{}, err
+	}
+	if err := json.Unmarshal(rawPermissionKeys, &item.PermissionKeys); err != nil {
+		return ManagementMenu{}, err
+	}
+	return item, nil
+}
+
+const managementMenuColumns = `menu_key,name,icon,parent_key,sort_order,workspace_types,route_path,permission_keys,status,revision`
+
+func (s *Store) ListManagementMenus(ctx context.Context) ([]ManagementMenu, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT `+managementMenuColumns+` FROM ky_management_menu ORDER BY sort_order,menu_key`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ManagementMenu{}
+	for rows.Next() {
+		item, err := scanManagementMenu(rows)
+		if err != nil {
+			return nil, err
+		}
+		items = append(items, item)
+	}
+	return items, rows.Err()
+}
+
+func (s *Store) ManagementMenuSnapshot(ctx context.Context, key string) (ManagementMenu, error) {
+	item, err := scanManagementMenu(s.db.QueryRowContext(ctx, `SELECT `+managementMenuColumns+` FROM ky_management_menu WHERE menu_key=$1`, key))
+	if errors.Is(err, sql.ErrNoRows) {
+		return ManagementMenu{}, ErrNotFound
+	}
+	return item, err
+}
+
+func validateManagementMenuParent(ctx context.Context, tx *sql.Tx, in ManagementMenuInput) error {
+	if in.ParentKey == nil {
+		return nil
+	}
+	var status string
+	var route sql.NullString
+	var raw []byte
+	err := tx.QueryRowContext(ctx, `SELECT status,route_path,workspace_types FROM ky_management_menu WHERE menu_key=$1 FOR SHARE`, *in.ParentKey).Scan(&status, &route, &raw)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ErrValidation
+	}
+	if err != nil {
+		return err
+	}
+	if status != "active" || route.Valid || *in.ParentKey == in.MenuKey {
+		return ErrValidation
+	}
+	var parentTypes []string
+	if err := json.Unmarshal(raw, &parentTypes); err != nil {
+		return err
+	}
+	parentSet := stringSet(parentTypes)
+	for _, workspaceType := range in.WorkspaceTypes {
+		if _, ok := parentSet[workspaceType]; !ok {
+			return ErrValidation
+		}
+	}
+	var cycle bool
+	err = tx.QueryRowContext(ctx, `WITH RECURSIVE ancestors(menu_key,parent_key,path) AS (
+		SELECT menu_key,parent_key,ARRAY[menu_key] FROM ky_management_menu WHERE menu_key=$1
+		UNION ALL SELECT m.menu_key,m.parent_key,a.path||m.menu_key FROM ky_management_menu m JOIN ancestors a ON m.menu_key=a.parent_key WHERE NOT m.menu_key=ANY(a.path)
+	) SELECT EXISTS(SELECT 1 FROM ancestors WHERE menu_key=$2)`, *in.ParentKey, in.MenuKey).Scan(&cycle)
+	if err != nil {
+		return err
+	}
+	if cycle {
+		return ErrValidation
+	}
+	return nil
+}
+
+func validateManagementMenuChildren(ctx context.Context, tx *sql.Tx, key string, in ManagementMenuInput) error {
+	rows, err := tx.QueryContext(ctx, `SELECT workspace_types FROM ky_management_menu WHERE parent_key=$1 AND status='active' ORDER BY menu_key`, key)
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	if in.RoutePath != nil {
+		if rows.Next() {
+			return ErrConflict
+		}
+		return rows.Err()
+	}
+	allowed := stringSet(in.WorkspaceTypes)
+	for rows.Next() {
+		var raw []byte
+		if err := rows.Scan(&raw); err != nil {
+			return err
+		}
+		var childTypes []string
+		if err := json.Unmarshal(raw, &childTypes); err != nil {
+			return err
+		}
+		for _, childType := range childTypes {
+			if _, ok := allowed[childType]; !ok {
+				return ErrConflict
+			}
+		}
+	}
+	return rows.Err()
+}
+
+func (s *Store) CreateManagementMenu(ctx context.Context, in ManagementMenuInput, actor string) (ManagementMenu, error) {
+	if !validManagementMenuInput(in) {
+		return ManagementMenu{}, ErrValidation
+	}
+	workspaceTypes, _ := json.Marshal(in.WorkspaceTypes)
+	permissionKeys, _ := json.Marshal(in.PermissionKeys)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ManagementMenu{}, err
+	}
+	defer tx.Rollback()
+	if err := validateManagementMenuParent(ctx, tx, in); err != nil {
+		return ManagementMenu{}, err
+	}
+	_, err = tx.ExecContext(ctx, `INSERT INTO ky_management_menu(menu_key,name,icon,parent_key,sort_order,workspace_types,route_path,permission_keys,status,revision,created_by,updated_by)
+		VALUES($1,$2,$3,$4,$5,$6::jsonb,$7,$8::jsonb,'active',1,$9,$9)`, in.MenuKey, in.Name, in.Icon, in.ParentKey, in.SortOrder, string(workspaceTypes), in.RoutePath, string(permissionKeys), actor)
+	if err != nil {
+		return ManagementMenu{}, classifyWriteErr(err)
+	}
+	if err := tx.Commit(); err != nil {
+		return ManagementMenu{}, err
+	}
+	return ManagementMenu{MenuKey: in.MenuKey, Name: in.Name, Icon: in.Icon, ParentKey: in.ParentKey, SortOrder: in.SortOrder, WorkspaceTypes: in.WorkspaceTypes, RoutePath: in.RoutePath, PermissionKeys: in.PermissionKeys, Status: "active", Revision: 1}, nil
+}
+
+func (s *Store) UpdateManagementMenu(ctx context.Context, key string, in ManagementMenuInput, actor string) (ManagementMenu, error) {
+	if key != in.MenuKey || !validManagementMenuInput(in) || in.ExpectedRevision < 1 {
+		return ManagementMenu{}, ErrValidation
+	}
+	workspaceTypes, _ := json.Marshal(in.WorkspaceTypes)
+	permissionKeys, _ := json.Marshal(in.PermissionKeys)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ManagementMenu{}, err
+	}
+	defer tx.Rollback()
+	var revision int64
+	err = tx.QueryRowContext(ctx, `SELECT revision FROM ky_management_menu WHERE menu_key=$1 AND status='active' FOR UPDATE`, key).Scan(&revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ManagementMenu{}, ErrNotFound
+	}
+	if err != nil {
+		return ManagementMenu{}, err
+	}
+	if revision != in.ExpectedRevision {
+		return ManagementMenu{}, ErrConflict
+	}
+	if err := validateManagementMenuParent(ctx, tx, in); err != nil {
+		return ManagementMenu{}, err
+	}
+	if err := validateManagementMenuChildren(ctx, tx, key, in); err != nil {
+		return ManagementMenu{}, err
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE ky_management_menu SET name=$2,icon=$3,parent_key=$4,sort_order=$5,workspace_types=$6::jsonb,route_path=$7,permission_keys=$8::jsonb,revision=revision+1,updated_by=$9,updated_at=now() WHERE menu_key=$1 AND revision=$10 AND status='active'`, key, in.Name, in.Icon, in.ParentKey, in.SortOrder, string(workspaceTypes), in.RoutePath, string(permissionKeys), actor, in.ExpectedRevision)
+	if err != nil {
+		return ManagementMenu{}, err
+	}
+	count, _ := result.RowsAffected()
+	if count == 0 {
+		return ManagementMenu{}, ErrConflict
+	}
+	if err := tx.Commit(); err != nil {
+		return ManagementMenu{}, err
+	}
+	return ManagementMenu{MenuKey: in.MenuKey, Name: in.Name, Icon: in.Icon, ParentKey: in.ParentKey, SortOrder: in.SortOrder, WorkspaceTypes: in.WorkspaceTypes, RoutePath: in.RoutePath, PermissionKeys: in.PermissionKeys, Status: "active", Revision: in.ExpectedRevision + 1}, nil
+}
+
+func (s *Store) DisableManagementMenu(ctx context.Context, key string, expected int64, actor string) error {
+	if expected < 1 {
+		return ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var status string
+	var revision int64
+	err = tx.QueryRowContext(ctx, `SELECT status,revision FROM ky_management_menu WHERE menu_key=$1 FOR UPDATE`, key).Scan(&status, &revision)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ErrNotFound
+	}
+	if err != nil {
+		return err
+	}
+	if status != "active" || revision != expected {
+		return ErrConflict
+	}
+	var children int
+	if err := tx.QueryRowContext(ctx, `SELECT count(*) FROM ky_management_menu WHERE parent_key=$1 AND status='active'`, key).Scan(&children); err != nil {
+		return err
+	}
+	if children > 0 {
+		return ErrConflict
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE ky_management_menu SET status='disabled',revision=revision+1,updated_by=$3,updated_at=now() WHERE menu_key=$1 AND revision=$2 AND status='active'`, key, expected, actor)
+	if err != nil {
+		return err
+	}
+	count, _ := result.RowsAffected()
+	if count == 0 {
+		return ErrConflict
+	}
+	return tx.Commit()
+}
+
+func (s *Store) EnableManagementMenu(ctx context.Context, key string, expected int64, actor string) error {
+	if expected < 1 {
+		return ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var status string
+	var revision int64
+	var parent sql.NullString
+	err = tx.QueryRowContext(ctx, `SELECT status,revision,parent_key FROM ky_management_menu WHERE menu_key=$1 FOR UPDATE`, key).Scan(&status, &revision, &parent)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ErrNotFound
+	}
+	if err != nil {
+		return err
+	}
+	if status != "disabled" || revision != expected {
+		return ErrConflict
+	}
+	if parent.Valid {
+		var active bool
+		if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_management_menu WHERE menu_key=$1 AND status='active')`, parent.String).Scan(&active); err != nil {
+			return err
+		}
+		if !active {
+			return ErrConflict
+		}
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE ky_management_menu SET status='active',revision=revision+1,updated_by=$3,updated_at=now() WHERE menu_key=$1 AND revision=$2 AND status='disabled'`, key, expected, actor)
+	if err != nil {
+		return err
+	}
+	count, _ := result.RowsAffected()
+	if count == 0 {
+		return ErrConflict
+	}
+	return tx.Commit()
+}
diff --git a/services/ky-membership-service/internal/store/management_menu_catalog_test.go b/services/ky-membership-service/internal/store/management_menu_catalog_test.go
new file mode 100644
index 0000000..ea381c4
--- /dev/null
+++ b/services/ky-membership-service/internal/store/management_menu_catalog_test.go
@@ -0,0 +1,59 @@
+package store
+
+import "testing"
+
+func TestValidManagementMenuInputPreservesDirectoryScope(t *testing.T) {
+	parent := "management.group.ky-shop-management"
+	path := "/shop-management/stores"
+	validPage := ManagementMenuInput{
+		MenuKey:        "management.ky-shop-management.platform",
+		Name:           "抖店店铺",
+		Icon:           "AppstoreOutlined",
+		ParentKey:      &parent,
+		SortOrder:      0,
+		WorkspaceTypes: []string{"platform"},
+		RoutePath:      &path,
+		PermissionKeys: []string{"menu.platform.shop_management", "platform.shop_management.view"},
+	}
+	if !validManagementMenuInput(validPage) {
+		t.Fatal("registered management page should be valid")
+	}
+
+	validGroup := ManagementMenuInput{
+		MenuKey:        "management.group.custom",
+		Name:           "自定义分组",
+		Icon:           "AppstoreOutlined",
+		SortOrder:      90,
+		WorkspaceTypes: []string{"platform"},
+		PermissionKeys: []string{},
+	}
+	if !validManagementMenuInput(validGroup) {
+		t.Fatal("a directory-only group should be valid")
+	}
+
+	tests := []struct {
+		name string
+		edit func(*ManagementMenuInput)
+	}{
+		{"external route", func(in *ManagementMenuInput) { value := "https://evil.example"; in.RoutePath = &value }},
+		{"query route", func(in *ManagementMenuInput) { value := "/shop?next=external"; in.RoutePath = &value }},
+		{"empty permission association", func(in *ManagementMenuInput) { in.PermissionKeys = nil }},
+		{"duplicate permission association", func(in *ManagementMenuInput) {
+			in.PermissionKeys = []string{"platform.shop_management.view", "platform.shop_management.view"}
+		}},
+		{"invalid permission association", func(in *ManagementMenuInput) { in.PermissionKeys = []string{"bad permission"} }},
+		{"unsupported workspace", func(in *ManagementMenuInput) { in.WorkspaceTypes = []string{"platform", "unknown"} }},
+		{"duplicate workspace", func(in *ManagementMenuInput) { in.WorkspaceTypes = []string{"platform", "platform"} }},
+		{"invalid icon", func(in *ManagementMenuInput) { in.Icon = "icon-name" }},
+		{"menu group with page permission", func(in *ManagementMenuInput) { in.RoutePath = nil }},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			input := validPage
+			test.edit(&input)
+			if validManagementMenuInput(input) {
+				t.Fatal("invalid menu input was accepted")
+			}
+		})
+	}
+}
diff --git a/services/ky-membership-service/internal/store/menu_allowlist.go b/services/ky-membership-service/internal/store/menu_allowlist.go
new file mode 100644
index 0000000..b3d3a92
--- /dev/null
+++ b/services/ky-membership-service/internal/store/menu_allowlist.go
@@ -0,0 +1,599 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"sort"
+	"strings"
+	"time"
+)
+
+const (
+	MenuDirectoryWorkbench  = "workbench"
+	MenuDirectoryManagement = "management"
+	maxMenuAllowlistEntries = 100
+)
+
+type MenuWorkspaceAllowlist struct {
+	DirectoryType string   `json:"directoryType"`
+	MenuKey       string   `json:"menuKey"`
+	WorkspaceType string   `json:"workspaceType"`
+	WorkspaceID   string   `json:"workspaceId"`
+	Enabled       bool     `json:"enabled"`
+	RoleIDs       []string `json:"roleIds"`
+	MembershipIDs []string `json:"membershipIds"`
+	Revision      int64    `json:"revision"`
+	UpdatedAt     string   `json:"updatedAt,omitempty"`
+}
+
+type MenuWorkspaceAllowlistInput struct {
+	DirectoryType    string   `json:"directoryType"`
+	MenuKey          string   `json:"menuKey"`
+	WorkspaceType    string   `json:"workspaceType"`
+	WorkspaceID      string   `json:"workspaceId"`
+	Enabled          bool     `json:"enabled"`
+	RoleIDs          []string `json:"roleIds"`
+	MembershipIDs    []string `json:"membershipIds"`
+	ExpectedRevision int64    `json:"expectedRevision"`
+}
+
+type MenuAllowlistWorkspaceOption struct {
+	WorkspaceType string `json:"workspaceType"`
+	WorkspaceID   string `json:"workspaceId"`
+	Name          string `json:"name"`
+}
+type MenuAllowlistRoleOption struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	Code string `json:"code"`
+}
+type MenuAllowlistMembershipOption struct {
+	ID          string `json:"id"`
+	DisplayName string `json:"displayName"`
+}
+type MenuAllowlistCandidates struct {
+	WorkspaceType string                          `json:"workspaceType"`
+	WorkspaceID   string                          `json:"workspaceId"`
+	Roles         []MenuAllowlistRoleOption       `json:"roles"`
+	Memberships   []MenuAllowlistMembershipOption `json:"memberships"`
+}
+
+func validAllowlistScope(directoryType, menuKey, workspaceType, workspaceID string) bool {
+	return (directoryType == MenuDirectoryWorkbench || directoryType == MenuDirectoryManagement) &&
+		workbenchMenuKeyPattern.MatchString(menuKey) && validWorkbenchWorkspaceType(workspaceType) && strings.TrimSpace(workspaceID) != ""
+}
+
+func normalizeAllowlistIDs(ids []string) ([]string, error) {
+	if len(ids) > maxMenuAllowlistEntries {
+		return nil, ErrValidation
+	}
+	seen := make(map[string]struct{}, len(ids))
+	out := make([]string, 0, len(ids))
+	for _, id := range ids {
+		id = strings.TrimSpace(id)
+		if id == "" || len(id) > 200 {
+			return nil, ErrValidation
+		}
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		out = append(out, id)
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+func MenuAllowlistAllows(enabled bool, roleIDs, membershipIDs, currentRoleIDs []string, currentMembershipID string) bool {
+	if !enabled {
+		return true
+	}
+	roles := stringSet(currentRoleIDs)
+	for _, id := range roleIDs {
+		if _, ok := roles[id]; ok {
+			return true
+		}
+	}
+	for _, id := range membershipIDs {
+		if id == currentMembershipID && id != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// FilterMenuKeysByAllowlist removes keys explicitly denied by an enabled
+// policy. Missing/disabled policies are absent from the map and preserve the
+// pre-existing authorization result.
+func FilterMenuKeysByAllowlist(keys []string, allowedByEnabledPolicy map[string]bool) []string {
+	out := make([]string, 0, len(keys))
+	for _, key := range keys {
+		allowed, restricted := allowedByEnabledPolicy[key]
+		if restricted && !allowed {
+			continue
+		}
+		out = append(out, key)
+	}
+	return out
+}
+
+func (s *Store) ReadMenuWorkspaceAllowlist(ctx context.Context, directoryType, menuKey, workspaceType, workspaceID string) (MenuWorkspaceAllowlist, error) {
+	if !validAllowlistScope(directoryType, menuKey, workspaceType, workspaceID) {
+		return MenuWorkspaceAllowlist{}, ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true, Isolation: sql.LevelRepeatableRead})
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	defer tx.Rollback()
+	if err = validateAllowlistWorkspaceTx(ctx, tx, workspaceType, workspaceID); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	if err = validateAllowlistMenuTx(ctx, tx, directoryType, menuKey, workspaceType); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	item := MenuWorkspaceAllowlist{DirectoryType: directoryType, MenuKey: menuKey, WorkspaceType: workspaceType, WorkspaceID: workspaceID, RoleIDs: []string{}, MembershipIDs: []string{}}
+	var updatedAt sql.NullTime
+	err = tx.QueryRowContext(ctx, `SELECT enabled,revision,updated_at FROM ky_menu_workspace_allowlist WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4`, directoryType, menuKey, workspaceType, workspaceID).Scan(&item.Enabled, &item.Revision, &updatedAt)
+	if errors.Is(err, sql.ErrNoRows) {
+		err = nil
+	} else if err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	} else {
+		item.UpdatedAt = updatedAt.Time.UTC().Format("2006-01-02T15:04:05.999999Z")
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT role_id FROM ky_menu_workspace_allowlist_role WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4 ORDER BY role_id`, directoryType, menuKey, workspaceType, workspaceID)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return MenuWorkspaceAllowlist{}, err
+		}
+		item.RoleIDs = append(item.RoleIDs, id)
+	}
+	if err := rows.Close(); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	if err := rows.Err(); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	rows, err = tx.QueryContext(ctx, `SELECT membership_id FROM ky_menu_workspace_allowlist_membership WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4 ORDER BY membership_id`, directoryType, menuKey, workspaceType, workspaceID)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return MenuWorkspaceAllowlist{}, err
+		}
+		item.MembershipIDs = append(item.MembershipIDs, id)
+	}
+	if err := rows.Close(); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	if err := rows.Err(); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	if err := tx.Commit(); err != nil {
+		return MenuWorkspaceAllowlist{}, err
+	}
+	return item, nil
+}
+
+func (s *Store) ReplaceMenuWorkspaceAllowlist(ctx context.Context, in MenuWorkspaceAllowlistInput, actorID string) (MenuWorkspaceAllowlist, MenuWorkspaceAllowlist, error) {
+	if !validAllowlistScope(in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID) || in.ExpectedRevision < 0 || strings.TrimSpace(actorID) == "" {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, ErrValidation
+	}
+	roles, err := normalizeAllowlistIDs(in.RoleIDs)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	members, err := normalizeAllowlistIDs(in.MembershipIDs)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	defer tx.Rollback()
+	lockKey := in.DirectoryType + "\x00" + in.MenuKey + "\x00" + in.WorkspaceType + "\x00" + in.WorkspaceID
+	if _, err = tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtext($1))`, lockKey); err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	if err = validateAllowlistWorkspaceTx(ctx, tx, in.WorkspaceType, in.WorkspaceID); err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	if err = validateAllowlistMenuTx(ctx, tx, in.DirectoryType, in.MenuKey, in.WorkspaceType); err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	for _, id := range roles {
+		var exists bool
+		if err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_role WHERE id=$1 AND workspace_type=$2 AND (workspace_id=$3 OR workspace_id IS NULL) AND status='normal' AND deleted_at IS NULL)`, id, in.WorkspaceType, in.WorkspaceID).Scan(&exists); err != nil {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+		}
+		if !exists {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, ErrValidation
+		}
+	}
+	for _, id := range members {
+		var exists bool
+		if err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_membership WHERE id=$1 AND workspace_type=$2 AND workspace_id=$3 AND status='active' AND deleted_at IS NULL)`, id, in.WorkspaceType, in.WorkspaceID).Scan(&exists); err != nil {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+		}
+		if !exists {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, ErrValidation
+		}
+	}
+	before := MenuWorkspaceAllowlist{DirectoryType: in.DirectoryType, MenuKey: in.MenuKey, WorkspaceType: in.WorkspaceType, WorkspaceID: in.WorkspaceID, RoleIDs: []string{}, MembershipIDs: []string{}}
+	var revision int64
+	err = tx.QueryRowContext(ctx, `SELECT enabled,revision FROM ky_menu_workspace_allowlist WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4 FOR UPDATE`, in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID).Scan(&before.Enabled, &revision)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	before.Revision = revision
+	before.RoleIDs, err = allowlistIDsTx(ctx, tx, "ky_menu_workspace_allowlist_role", "role_id", in)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	before.MembershipIDs, err = allowlistIDsTx(ctx, tx, "ky_menu_workspace_allowlist_membership", "membership_id", in)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	if revision != in.ExpectedRevision {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, ErrConflict
+	}
+	after := MenuWorkspaceAllowlist{DirectoryType: in.DirectoryType, MenuKey: in.MenuKey, WorkspaceType: in.WorkspaceType, WorkspaceID: in.WorkspaceID, Enabled: in.Enabled, RoleIDs: roles, MembershipIDs: members, Revision: revision + 1}
+	var updatedAt time.Time
+	err = tx.QueryRowContext(ctx, `INSERT INTO ky_menu_workspace_allowlist(directory_type,menu_key,workspace_type,workspace_id,enabled,revision,updated_by,updated_at) VALUES($1,$2,$3,$4,$5,$6,$7,now()) ON CONFLICT(directory_type,menu_key,workspace_type,workspace_id) DO UPDATE SET enabled=EXCLUDED.enabled,revision=EXCLUDED.revision,updated_by=EXCLUDED.updated_by,updated_at=now() RETURNING updated_at`, after.DirectoryType, after.MenuKey, after.WorkspaceType, after.WorkspaceID, after.Enabled, after.Revision, actorID).Scan(&updatedAt)
+	if err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	after.UpdatedAt = updatedAt.UTC().Format("2006-01-02T15:04:05.999999Z")
+	for _, table := range []string{"ky_menu_workspace_allowlist_role", "ky_menu_workspace_allowlist_membership"} {
+		if _, err = tx.ExecContext(ctx, `DELETE FROM `+table+` WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4`, in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID); err != nil {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+		}
+	}
+	for _, id := range roles {
+		if _, err = tx.ExecContext(ctx, `INSERT INTO ky_menu_workspace_allowlist_role(directory_type,menu_key,workspace_type,workspace_id,role_id) VALUES($1,$2,$3,$4,$5)`, in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID, id); err != nil {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+		}
+	}
+	for _, id := range members {
+		if _, err = tx.ExecContext(ctx, `INSERT INTO ky_menu_workspace_allowlist_membership(directory_type,menu_key,workspace_type,workspace_id,membership_id) VALUES($1,$2,$3,$4,$5)`, in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID, id); err != nil {
+			return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return MenuWorkspaceAllowlist{}, MenuWorkspaceAllowlist{}, err
+	}
+	return before, after, nil
+}
+
+func allowlistIDsTx(ctx context.Context, tx *sql.Tx, table, column string, in MenuWorkspaceAllowlistInput) ([]string, error) {
+	// table/column are closed internal constants, never request values.
+	query := `SELECT ` + column + ` FROM ` + table + ` WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4 ORDER BY ` + column
+	rows, err := tx.QueryContext(ctx, query, in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []string{}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		out = append(out, id)
+	}
+	return out, rows.Err()
+}
+
+func (s *Store) ListMenuAllowlistWorkspaceOptions(ctx context.Context, actorType, actorID string) ([]MenuAllowlistWorkspaceOption, error) {
+	if !validWorkbenchWorkspaceType(actorType) || actorID == "" {
+		return nil, ErrValidation
+	}
+	out := []MenuAllowlistWorkspaceOption{}
+	appendRows := func(query string, args ...any) error {
+		rows, err := s.db.QueryContext(ctx, query, args...)
+		if err != nil {
+			return err
+		}
+		defer rows.Close()
+		for rows.Next() {
+			var item MenuAllowlistWorkspaceOption
+			if err = rows.Scan(&item.WorkspaceType, &item.WorkspaceID, &item.Name); err != nil {
+				return err
+			}
+			out = append(out, item)
+		}
+		return rows.Err()
+	}
+	switch actorType {
+	case "platform":
+		if actorID != "platform_root" {
+			return nil, ErrValidation
+		}
+		out = append(out, MenuAllowlistWorkspaceOption{WorkspaceType: "platform", WorkspaceID: "platform_root", Name: "平台工作区"})
+		if err := appendRows(`SELECT 'agency',id,name FROM ky_agency WHERE status='normal' AND deleted_at IS NULL ORDER BY name,id`); err != nil {
+			return nil, err
+		}
+		if err := appendRows(`SELECT 'enterprise',id,name FROM ky_enterprise WHERE status='normal' AND deleted_at IS NULL ORDER BY name,id`); err != nil {
+			return nil, err
+		}
+	case "agency":
+		if err := appendRows(`SELECT 'agency',id,name FROM ky_agency WHERE id=$1 AND status='normal' AND deleted_at IS NULL`, actorID); err != nil {
+			return nil, err
+		}
+		if err := appendRows(`SELECT 'enterprise',id,name FROM ky_enterprise WHERE agency_id=$1 AND status='normal' AND deleted_at IS NULL ORDER BY name,id`, actorID); err != nil {
+			return nil, err
+		}
+	case "enterprise":
+		if err := appendRows(`SELECT 'enterprise',id,name FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL`, actorID); err != nil {
+			return nil, err
+		}
+	}
+	return out, nil
+}
+
+func (s *Store) ListMenuAllowlistCandidates(ctx context.Context, workspaceType, workspaceID string) (MenuAllowlistCandidates, error) {
+	if !validWorkbenchWorkspaceType(workspaceType) || workspaceID == "" {
+		return MenuAllowlistCandidates{}, ErrValidation
+	}
+	if err := s.ExistsMenuAllowlistWorkspace(ctx, workspaceType, workspaceID); err != nil {
+		return MenuAllowlistCandidates{}, err
+	}
+	out := MenuAllowlistCandidates{WorkspaceType: workspaceType, WorkspaceID: workspaceID, Roles: []MenuAllowlistRoleOption{}, Memberships: []MenuAllowlistMembershipOption{}}
+	rows, err := s.db.QueryContext(ctx, `SELECT id,name,code FROM ky_role WHERE workspace_type=$1 AND (workspace_id=$2 OR workspace_id IS NULL) AND status='normal' AND deleted_at IS NULL ORDER BY name,code,id`, workspaceType, workspaceID)
+	if err != nil {
+		return out, err
+	}
+	for rows.Next() {
+		var item MenuAllowlistRoleOption
+		if err = rows.Scan(&item.ID, &item.Name, &item.Code); err != nil {
+			rows.Close()
+			return out, err
+		}
+		out.Roles = append(out.Roles, item)
+	}
+	if err = rows.Err(); err != nil {
+		rows.Close()
+		return out, err
+	}
+	if err = rows.Close(); err != nil {
+		return out, err
+	}
+	rows, err = s.db.QueryContext(ctx, `SELECT id,display_name FROM ky_membership WHERE workspace_type=$1 AND workspace_id=$2 AND status='active' AND deleted_at IS NULL ORDER BY display_name,id`, workspaceType, workspaceID)
+	if err != nil {
+		return out, err
+	}
+	for rows.Next() {
+		var item MenuAllowlistMembershipOption
+		if err = rows.Scan(&item.ID, &item.DisplayName); err != nil {
+			rows.Close()
+			return out, err
+		}
+		out.Memberships = append(out.Memberships, item)
+	}
+	if err = rows.Err(); err != nil {
+		rows.Close()
+		return out, err
+	}
+	if err = rows.Close(); err != nil {
+		return out, err
+	}
+	return out, nil
+}
+
+func validateAllowlistWorkspaceTx(ctx context.Context, tx *sql.Tx, workspaceType, workspaceID string) error {
+	var exists bool
+	switch workspaceType {
+	case "platform":
+		exists = workspaceID == "platform_root"
+	case "agency":
+		if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_agency WHERE id=$1 AND status='normal' AND deleted_at IS NULL)`, workspaceID).Scan(&exists); err != nil {
+			return err
+		}
+	case "enterprise":
+		if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_enterprise WHERE id=$1 AND status='normal' AND deleted_at IS NULL)`, workspaceID).Scan(&exists); err != nil {
+			return err
+		}
+	default:
+		return ErrValidation
+	}
+	if !exists {
+		return ErrNotFound
+	}
+	return nil
+}
+
+func (s *Store) ExistsMenuAllowlistWorkspace(ctx context.Context, workspaceType, workspaceID string) error {
+	if workspaceType == "platform" && workspaceID == "platform_root" {
+		return nil
+	}
+	if workspaceType != "agency" && workspaceType != "enterprise" {
+		return ErrValidation
+	}
+	table := "ky_agency"
+	if workspaceType == "enterprise" {
+		table = "ky_enterprise"
+	}
+	var exists bool
+	if err := s.db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM `+table+` WHERE id=$1 AND status='normal' AND deleted_at IS NULL)`, workspaceID).Scan(&exists); err != nil {
+		return err
+	}
+	if !exists {
+		return ErrNotFound
+	}
+	return nil
+}
+
+func validateAllowlistMenuTx(ctx context.Context, tx *sql.Tx, directoryType, menuKey, workspaceType string) error {
+	var exists bool
+	if directoryType == MenuDirectoryWorkbench {
+		err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_workbench_menu WHERE menu_key=$1 AND status='active' AND route_key IS NOT NULL AND workspace_types @> to_jsonb(ARRAY[$2::text]))`, menuKey, workspaceType).Scan(&exists)
+		if err != nil {
+			return err
+		}
+	} else {
+		err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_management_menu WHERE menu_key=$1 AND status='active' AND route_path IS NOT NULL AND workspace_types @> to_jsonb(ARRAY[$2::text]))`, menuKey, workspaceType).Scan(&exists)
+		if err != nil {
+			return err
+		}
+	}
+	if !exists {
+		return ErrValidation
+	}
+	return nil
+}
+
+func applyMenuWorkspaceAllowlistTx(ctx context.Context, tx *sql.Tx, directoryType, workspaceType, workspaceID, membershipID string, keys []string) ([]string, error) {
+	if len(keys) == 0 {
+		return []string{}, nil
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT p.menu_key,NOT (EXISTS(SELECT 1 FROM ky_menu_workspace_allowlist_role ar JOIN ky_membership_role mr ON mr.role_id=ar.role_id AND mr.membership_id=$4 AND mr.workspace_type=$2 AND mr.workspace_id=$3 JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=$2 AND (r.workspace_id=$3 OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL WHERE ar.directory_type=$1 AND ar.menu_key=p.menu_key AND ar.workspace_type=$2 AND ar.workspace_id=$3) OR EXISTS(SELECT 1 FROM ky_menu_workspace_allowlist_membership am JOIN ky_membership m ON m.id=am.membership_id AND m.workspace_type=$2 AND m.workspace_id=$3 AND m.status='active' AND m.deleted_at IS NULL WHERE am.directory_type=$1 AND am.menu_key=p.menu_key AND am.workspace_type=$2 AND am.workspace_id=$3 AND am.membership_id=$4)) FROM ky_menu_workspace_allowlist p WHERE p.directory_type=$1 AND p.workspace_type=$2 AND p.workspace_id=$3 AND p.enabled AND p.menu_key=ANY($5)`, directoryType, workspaceType, workspaceID, membershipID, keys)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	blocked := map[string]bool{}
+	for rows.Next() {
+		var key string
+		var deny bool
+		if err = rows.Scan(&key, &deny); err != nil {
+			return nil, err
+		}
+		blocked[key] = deny
+	}
+	if err = rows.Err(); err != nil {
+		return nil, err
+	}
+	allowedByEnabledPolicy := make(map[string]bool, len(blocked))
+	for key, deny := range blocked {
+		allowedByEnabledPolicy[key] = !deny
+	}
+	return FilterMenuKeysByAllowlist(keys, allowedByEnabledPolicy), nil
+}
+
+type managementMenuAllowlistCandidate struct {
+	menuID, permissionCode, permissionCategory string
+	eligible, enabled, roleMatch, memberMatch  bool
+}
+
+// EffectiveManagementMenuIDs returns stable catalog item IDs after the
+// existing role permission and optional per-item allowlist have both passed.
+func effectiveManagementMenuIDs(candidates []managementMenuAllowlistCandidate, rolePermissions map[string]bool) []string {
+	allowed := map[string]bool{}
+	for _, item := range candidates {
+		if item.eligible && rolePermissions[item.permissionCode] && (!item.enabled || item.roleMatch || item.memberMatch) {
+			allowed[item.menuID] = true
+		}
+	}
+	ids := make([]string, 0, len(allowed))
+	for id := range allowed {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// EffectiveManagementMenuKeys preserves the permission-code compatibility
+// filter and additionally returns independent stable catalog item IDs. The
+// latter prevents sibling pages sharing one permission code from sharing an
+// allowlist decision.
+func (s *Store) EffectiveManagementMenuKeys(ctx context.Context, userID, membershipID, workspaceType, workspaceID string) (managed, effective, effectiveIDs []string, err error) {
+	if userID == "" || membershipID == "" || !validWorkbenchWorkspaceType(workspaceType) || workspaceID == "" {
+		return nil, nil, nil, ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true, Isolation: sql.LevelRepeatableRead})
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	defer tx.Rollback()
+	var active bool
+	if err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_membership WHERE id=$1 AND user_id=$2 AND workspace_type=$3 AND workspace_id=$4 AND status='active' AND deleted_at IS NULL)`, membershipID, userID, workspaceType, workspaceID).Scan(&active); err != nil {
+		return nil, nil, nil, err
+	}
+	if !active {
+		return nil, nil, nil, ErrNotFound
+	}
+	rolePermissions, roleMenu := map[string]bool{}, map[string]bool{}
+	rows, err := tx.QueryContext(ctx, `SELECT DISTINCT p.code,p.category FROM ky_membership_role mr JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=$2 AND (r.workspace_id=$3 OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL JOIN ky_role_permission rp ON rp.role_id=r.id JOIN ky_permission p ON p.id=rp.permission_id AND p.category IN ('menu','page','action') AND p.status='normal' WHERE mr.membership_id=$1 AND mr.workspace_type=$2 AND mr.workspace_id=$3 ORDER BY p.code,p.category`, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	for rows.Next() {
+		var code, category string
+		if err = rows.Scan(&code, &category); err != nil {
+			rows.Close()
+			return nil, nil, nil, err
+		}
+		rolePermissions[code] = true
+		if category == "menu" {
+			roleMenu[code] = true
+		}
+	}
+	if err = rows.Close(); err != nil {
+		return nil, nil, nil, err
+	}
+	candidates := make([]managementMenuAllowlistCandidate, 0)
+	rows, err = tx.QueryContext(ctx, `SELECT mm.menu_key,p.code,p.category,(mm.status='active' AND mm.workspace_types @> to_jsonb(ARRAY[$1::text])),COALESCE(a.enabled,false),
+		 EXISTS(SELECT 1 FROM ky_menu_workspace_allowlist_role ar JOIN ky_membership_role mr ON mr.role_id=ar.role_id AND mr.membership_id=$3 AND mr.workspace_type=$1 AND mr.workspace_id=$2 JOIN ky_role r ON r.id=mr.role_id AND r.workspace_type=$1 AND (r.workspace_id=$2 OR r.workspace_id IS NULL) AND r.status='normal' AND r.deleted_at IS NULL WHERE ar.directory_type='management' AND ar.menu_key=mm.menu_key AND ar.workspace_type=$1 AND ar.workspace_id=$2),
+	 EXISTS(SELECT 1 FROM ky_menu_workspace_allowlist_membership am JOIN ky_membership m ON m.id=am.membership_id AND m.workspace_type=$1 AND m.workspace_id=$2 AND m.status='active' AND m.deleted_at IS NULL WHERE am.directory_type='management' AND am.menu_key=mm.menu_key AND am.workspace_type=$1 AND am.workspace_id=$2 AND am.membership_id=$3)
+	 FROM ky_management_menu mm CROSS JOIN LATERAL jsonb_array_elements_text(mm.permission_keys) k(code) JOIN ky_permission p ON p.code=k.code AND p.category IN ('menu','page','action') AND p.status='normal' LEFT JOIN ky_menu_workspace_allowlist a ON a.directory_type='management' AND a.menu_key=mm.menu_key AND a.workspace_type=$1 AND a.workspace_id=$2
+	 WHERE mm.route_path IS NOT NULL ORDER BY mm.menu_key,p.code`, workspaceType, workspaceID, membershipID)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	managedSet, effectiveSet := map[string]bool{}, map[string]bool{}
+	for rows.Next() {
+		var item managementMenuAllowlistCandidate
+		if err = rows.Scan(&item.menuID, &item.permissionCode, &item.permissionCategory, &item.eligible, &item.enabled, &item.roleMatch, &item.memberMatch); err != nil {
+			rows.Close()
+			return nil, nil, nil, err
+		}
+		if item.permissionCategory == "menu" {
+			managedSet[item.permissionCode] = true
+			if item.eligible && roleMenu[item.permissionCode] && (!item.enabled || item.roleMatch || item.memberMatch) {
+				effectiveSet[item.permissionCode] = true
+			}
+		}
+		candidates = append(candidates, item)
+	}
+	if err = rows.Close(); err != nil {
+		return nil, nil, nil, err
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, nil, nil, err
+	}
+	managed = make([]string, 0, len(managedSet))
+	for key := range managedSet {
+		managed = append(managed, key)
+	}
+	sort.Strings(managed)
+	effective = make([]string, 0, len(effectiveSet))
+	for key := range effectiveSet {
+		effective = append(effective, key)
+	}
+	sort.Strings(effective)
+	return managed, effective, effectiveManagementMenuIDs(candidates, rolePermissions), nil
+}
+
+func validMenuAllowlistInput(in MenuWorkspaceAllowlistInput) bool {
+	if !validAllowlistScope(in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID) || in.ExpectedRevision < 0 || len(in.RoleIDs) > maxMenuAllowlistEntries || len(in.MembershipIDs) > maxMenuAllowlistEntries {
+		return false
+	}
+	_, roleErr := normalizeAllowlistIDs(in.RoleIDs)
+	_, memberErr := normalizeAllowlistIDs(in.MembershipIDs)
+	return roleErr == nil && memberErr == nil
+}
+
+func ValidMenuWorkspaceAllowlistInput(in MenuWorkspaceAllowlistInput) bool {
+	return validMenuAllowlistInput(in)
+}
