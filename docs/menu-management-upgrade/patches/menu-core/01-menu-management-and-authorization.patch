+// EffectiveWorkbenchMenuKeys resolves role union + membership allow, then applies
+// current catalog, workspace eligibility, ancestor caps, and membership deny.
+func (s *Store) EffectiveWorkbenchMenuKeys(ctx context.Context, userID, membershipID, workspaceType, workspaceID string) ([]string, error) {
+	if userID == "" || membershipID == "" || workspaceID == "" || !validWorkbenchWorkspaceType(workspaceType) {
+		return nil, ErrValidation
+	}
+	tx, err := s.db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true, Isolation: sql.LevelRepeatableRead})
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	keys, err := effectiveWorkbenchMenuKeysTx(ctx, tx, userID, membershipID, workspaceType, workspaceID)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return keys, nil
+}
