+func TestVisibleMenuNavigationReturnsOnlyAuthorizedLeavesAndRequiredAncestors(t *testing.T) {
+	groupKey := "group.workbench.talent_square"
+	group := visibleMenuNavigationRow{MenuKey: groupKey, NodeType: "group", Name: "达人广场", Icon: "team", SortOrder: 20, WorkspaceTypes: []string{"platform", "agency"}, Status: "active"}
+	child := visibleMenuNavigationRow{MenuKey: "menu.workbench.talent_square.douyin", NodeType: "leaf", Name: "抖音", Icon: "douyin", ParentKey: &groupKey, SortOrder: 5, WorkspaceTypes: []string{"platform", "agency"}, RouteKey: stringPointer("talent-square.douyin"), Status: "active"}
+	hidden := visibleMenuNavigationRow{MenuKey: "menu.workbench.talent_square.hidden", NodeType: "leaf", Name: "不可见页面", Icon: "LockOutlined", ParentKey: &groupKey, SortOrder: 1, WorkspaceTypes: []string{"platform"}, Status: "active"}
+	otherWorkspace := visibleMenuNavigationRow{MenuKey: "menu.workbench.talent_square.enterprise", NodeType: "leaf", Name: "企业页面", Icon: "ShopOutlined", ParentKey: &groupKey, SortOrder: 2, WorkspaceTypes: []string{"enterprise"}, Status: "active"}
+	rows := []visibleMenuNavigationRow{hidden, group, child, otherWorkspace}
+	visible, ancestors := projectVisibleMenuNavigation(rows, []string{child.MenuKey}, "platform")
+	if len(visible) != 1 || visible[0].MenuKey != child.MenuKey || visible[0].Name != "抖音" || visible[0].Icon != "douyin" {
+		t.Fatalf("visible authorized navigation rows=%+v", visible)
+	}
+	if len(ancestors) != 1 || ancestors[0].MenuKey != groupKey || ancestors[0].Name != "达人广场" || ancestors[0].Icon != "team" {
+		t.Fatalf("necessary ancestor projection=%+v", ancestors)
+	}
+	encoded, err := json.Marshal(struct {
+		Items     []visibleMenuNavigationRow `json:"navigationItems"`
+		Ancestors []visibleMenuNavigationRow `json:"ancestors"`
+	}{visible, ancestors})
+	if err != nil || strings.Contains(string(encoded), hidden.MenuKey) || strings.Contains(string(encoded), otherWorkspace.MenuKey) {
