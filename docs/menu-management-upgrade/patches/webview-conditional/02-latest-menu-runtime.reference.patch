@@ -0,0 +1,28 @@
+-- 菜单 WebView 支持通用配置；现有行保持 workspace 覆盖语义。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='20s';
+DO $$ BEGIN
+  IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF;
+END $$;
+
+ALTER TABLE ky_menu_webview_config
+  ADD COLUMN IF NOT EXISTS config_scope text NOT NULL DEFAULT 'workspace';
+
+DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='ky_menu_webview_config'::regclass AND conname='ky_menu_webview_config_scope_ck') THEN
+    ALTER TABLE ky_menu_webview_config ADD CONSTRAINT ky_menu_webview_config_scope_ck
+      CHECK (config_scope IN ('workspace','common'));
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='ky_menu_webview_config'::regclass AND conname='ky_menu_webview_config_common_scope_ck') THEN
+    ALTER TABLE ky_menu_webview_config ADD CONSTRAINT ky_menu_webview_config_common_scope_ck
+      CHECK (config_scope <> 'common' OR
+        (workspace_type='platform' AND workspace_id='*' AND session_source='ordinary'
+          AND store_id IS NULL AND inherit_default_resources=false AND proxy_secret_version_id IS NULL));
+  END IF;
+END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS ky_menu_webview_config_one_common_idx
+  ON ky_menu_webview_config(directory_type,menu_key) WHERE config_scope='common';
+
+-- 回滚：先停止通用配置路由及回退读取，备份并删除 config_scope='common' 的菜单配置行，
+-- 再删除索引和两个约束，最后删除 config_scope 列。所有原 workspace 配置行保持不动。
