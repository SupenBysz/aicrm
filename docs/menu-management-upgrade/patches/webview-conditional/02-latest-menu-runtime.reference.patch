+import assert from "node:assert/strict";
+import test from "node:test";
+import React, { useEffect, useState } from "react";
+import { act, create } from "react-test-renderer";
+import {
+  activateWorkspaceAreaScroll,
+  createWorkspaceAreaScrollMemory,
+  createWorkspaceAreaRouteCache,
+  rememberWorkspaceAreaScroll,
+  rememberWorkspaceAreaRoute,
+  selectWorkspaceAreaRoute,
+  workspaceAreaLocationKey
+} from "./workspace-area-route-cache.ts";
+import { bindViewportToInstance, boundsForWorkspaceArea } from "./components/business-web-page-viewport-bounds.ts";
+import { readFile } from "node:fs/promises";
+import { WorkspaceAreaRoutePaneFrame } from "./workspace-area-route-pane.ts";
+
+function route(pathname, node, search = "", hash = "") {
+  const location = { pathname, search, hash, state: null, key: pathname + search + hash };
+  return { pathKey: workspaceAreaLocationKey(location), location, navigationType: "PUSH", node };
+}
+
+test("工作台 WebView 与管理列表切换时保留各自页面节点及筛选分页状态", () => {
+  const scope = "user-1:platform:workspace-1:permissions-a";
+  const webview = { kind: "webview", state: { instanceId: "view-1", url: "https://example.test/", scrollTop: 420 } };
+  const list = { kind: "management-list", state: { keyword: "订单", page: 3, pageSize: 50, dialogOpen: true, draft: "未提交" } };
+  let cache = createWorkspaceAreaRouteCache(scope);
+
+  cache = rememberWorkspaceAreaRoute(cache, scope, "workbench", route("/w/platform/workspace-1/menu/workbench/orders", webview));
+  cache = rememberWorkspaceAreaRoute(cache, scope, "manage", route("/w/platform/workspace-1/shops", list, "?status=active"));
+
+  const restoredWebview = selectWorkspaceAreaRoute({
+    cache, scopeKey: scope, area: "workbench", activeArea: "workbench",
+    activePathKey: "/w/platform/workspace-1/menu/workbench/orders", liveSnapshot: route("/w/platform/workspace-1/menu/workbench/orders", {})
+  });
+  assert.strictEqual(restoredWebview.node, webview);
+  assert.equal(restoredWebview.node.state.instanceId, "view-1");
+  assert.equal(restoredWebview.node.state.scrollTop, 420);
+
+  const restoredList = selectWorkspaceAreaRoute({
+    cache, scopeKey: scope, area: "manage", activeArea: "manage",
+    activePathKey: "/w/platform/workspace-1/shops?status=active", liveSnapshot: route("/w/platform/workspace-1/shops?status=active", {})
+  });
+  assert.strictEqual(restoredList.node, list);
+  assert.deepEqual(restoredList.node.state, { keyword: "订单", page: 3, pageSize: 50, dialogOpen: true, draft: "未提交" });
+});
+
+test("同区域导航只替换该区域快照，用户/工作区/权限范围变化不复用旧页面", () => {
+  const scope = "user-1:platform:workspace-1:permissions-a";
+  let cache = createWorkspaceAreaRouteCache(scope);
+  const manage = { state: { page: 4 } };
+  const workbenchFirst = { state: { scrollTop: 10 } };
+  const workbenchNext = { state: { scrollTop: 0 } };
+  cache = rememberWorkspaceAreaRoute(cache, scope, "manage", route("/w/platform/workspace-1/shops", manage));
+  cache = rememberWorkspaceAreaRoute(cache, scope, "workbench", route("/w/platform/workspace-1/workbench", workbenchFirst));
+  const previousManage = cache.manage;
+  cache = rememberWorkspaceAreaRoute(cache, scope, "workbench", route("/w/platform/workspace-1/workbench/reports", workbenchNext));
+  assert.strictEqual(cache.manage, previousManage);
+  assert.strictEqual(cache.workbench.node, workbenchNext);
+
+  for (const newScopeKey of [
+    "user-2:platform:workspace-1:permissions-a",
+    "user-1:agency:workspace-2:permissions-a",
+    "user-1:platform:workspace-1:permissions-b"
+  ]) {
+    const newScope = createWorkspaceAreaRouteCache(newScopeKey);
+    const restored = selectWorkspaceAreaRoute({
+      cache, scopeKey: newScope.scopeKey, area: "manage", activeArea: "workbench",
+      activePathKey: "/w/platform/workspace-1/workbench/reports", liveSnapshot: null
+    });
+    assert.equal(restored, null);
+    assert.notEqual(newScope.scopeKey, cache.scopeKey);
+  }
+});
+
+test("两区域独立记住内容滚动位置，切换用户/工作区后归零", () => {
+  const scope = "user-1:workspace-1:permissions-a";
+  let scroll = createWorkspaceAreaScrollMemory(scope, "manage");
+  scroll = rememberWorkspaceAreaScroll(scroll, scope, "manage", 740);
+  let activated = activateWorkspaceAreaScroll(scroll, scope, "workbench");
+  assert.equal(activated.scrollTop, 0);
+  scroll = rememberWorkspaceAreaScroll(activated.memory, scope, "workbench", 120);
+  activated = activateWorkspaceAreaScroll(scroll, scope, "manage");
+  assert.equal(activated.scrollTop, 740);
+  activated = activateWorkspaceAreaScroll(activated.memory, "user-2:workspace-1:permissions-a", "manage");
+  assert.equal(activated.scrollTop, 0);
+  assert.deepEqual(activated.memory.positions, { workbench: 0, manage: 0 });
+});
+
+test("非活动区域立即给原生 WebView 零尺寸隐藏，返回后恢复 DOM 实测 bounds", () => {
+  const measured = { x: 213, y: 148, width: 1024, height: 680, visible: true };
+  assert.deepEqual(boundsForWorkspaceArea(false, measured), { x: 0, y: 0, width: 0, height: 0, visible: false });
+  assert.strictEqual(boundsForWorkspaceArea(true, measured), measured);
+});
+
+test("两个区域内 WebView 的 bounds 显隐按各自 instanceId 隔离", () => {
+  const calls = [];
+  const workbenchSetBounds = bindViewportToInstance("workbench-instance", (id, bounds) => calls.push([id, bounds]));
+  const managementSetBounds = bindViewportToInstance("management-instance", (id, bounds) => calls.push([id, bounds]));
+  workbenchSetBounds(boundsForWorkspaceArea(false, { x: 100, y: 50, width: 800, height: 600, visible: true }));
+  managementSetBounds(boundsForWorkspaceArea(true, { x: 120, y: 60, width: 760, height: 580, visible: true }));
+  assert.deepEqual(calls.map(([id, bounds]) => [id, bounds.visible, bounds.width, bounds.height]), [
+    ["workbench-instance", false, 0, 0],
+    ["management-instance", true, 760, 580]
+  ]);
+});
+
+test("区域内 Drawer/Modal/菜单 Portal 跟随所属区域隐藏而不是留在 body 覆盖另一侧", async () => {
+  const app = await readFile(new URL("./app.tsx", import.meta.url), "utf8");
+  const pane = await readFile(new URL("./workspace-area-route-pane.ts", import.meta.url), "utf8");
+  const styles = await readFile(new URL("./styles.css", import.meta.url), "utf8");
