@@ -0,0 +1,269 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/stdlib"
+)
+
+// This integration contract is opt-in and must only be pointed at a disposable
+// database whose name starts with kww_role_save_it_. It creates a private
+// schema and never touches application tables or production role assignments.
+func TestSetRolePermissionsWithRevisionPostgresIsolation(t *testing.T) {
+	dsn := os.Getenv("KY_MEMBERSHIP_ROLE_SAVE_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("set KY_MEMBERSHIP_ROLE_SAVE_TEST_DATABASE_URL to a disposable kww_role_save_it_* database")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	adminDB, err := sql.Open("pgx", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer adminDB.Close()
+	var databaseName string
+	if err := adminDB.QueryRowContext(ctx, `SELECT current_database()`).Scan(&databaseName); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(databaseName, "kww_role_save_it_") {
+		t.Fatalf("refusing PostgreSQL integration fixture in non-disposable database %q", databaseName)
+	}
+	schema := fmt.Sprintf("role_save_it_%d", time.Now().UnixNano())
+	if _, err := adminDB.ExecContext(ctx, `CREATE SCHEMA `+schema); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _, _ = adminDB.ExecContext(context.Background(), `DROP SCHEMA `+schema+` CASCADE`) }()
+
+	config, err := pgx.ParseConfig(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.RuntimeParams["search_path"] = schema
+	db := stdlib.OpenDB(*config)
+	defer db.Close()
+	if err := createRoleSaveFixtureSchema(ctx, db); err != nil {
+		t.Fatal(err)
+	}
+	fixture := &Store{db: db}
+	if err := seedRoleSaveFixture(ctx, db); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, tc := range []struct {
+		id, workspaceType, workspaceID string
+	}{
+		{"platform-null-system", "platform", "platform_root"},
+		{"platform-root-system", "platform", "platform_root"},
+		{"agency-null-template", "agency", "agency-1"},
+		{"enterprise-null-template", "enterprise", "enterprise-1"},
+	} {
+		t.Run(tc.id, func(t *testing.T) {
+			if err := fixture.SetRolePermissionsWithRevision(ctx, tc.id, tc.workspaceType, tc.workspaceID, []string{"permission-valid"}, 1, "test-actor"); err != nil {
+				t.Fatalf("current revision should save inside the isolated fixture: %v", err)
+			}
+			assertRoleSaveFixtureState(t, ctx, db, tc.id, 2, []string{"permission-valid"})
+		})
+	}
+
+	if err := fixture.SetRolePermissionsWithRevision(ctx, "agency-null-template", "enterprise", "enterprise-1", []string{"permission-other"}, 2, "test-actor"); err != ErrNotFound {
+		t.Fatalf("same role id must not cross workspace_type: got %v", err)
+	}
+	if err := fixture.SetRolePermissionsWithRevision(ctx, "agency-concrete-system", "agency", "agency-other", []string{"permission-other"}, 1, "test-actor"); err != ErrNotFound {
+		t.Fatalf("concrete scope must not cross workspace_id: got %v", err)
+	}
+	if err := fixture.SetRolePermissionsWithRevision(ctx, "agency-null-nonsystem", "agency", "agency-1", []string{"permission-other"}, 1, "test-actor"); err != ErrNotFound {
+		t.Fatalf("NULL non-system role must not acquire template scope: got %v", err)
+	}
+
+	if err := fixture.SetRolePermissionsWithRevision(ctx, "platform-root-system", "platform", "platform_root", []string{"permission-other"}, 1, "test-actor"); err != ErrConflict {
+		t.Fatalf("stale revision must conflict: got %v", err)
+	}
+	assertRoleSaveFixtureState(t, ctx, db, "platform-root-system", 2, []string{"permission-valid"})
+
+	if ok, err := fixture.PermissionsAllBelongToWorkspaceType(ctx, []string{"permission-missing"}, "platform"); err != nil || ok {
+		t.Fatalf("unknown permission must be rejected by handler prevalidation: ok=%v err=%v", ok, err)
+	}
+	if ok, err := fixture.PermissionsAllBelongToWorkspaceType(ctx, []string{"permission-valid"}, "platform"); err != nil || !ok {
+		t.Fatalf("valid permission should pass current workspace catalog check: ok=%v err=%v", ok, err)
+	}
+	assertRoleSaveFixtureState(t, ctx, db, "platform-root-system", 2, []string{"permission-valid"})
+
+	t.Run("production-shaped-platform-workbench-catalog", func(t *testing.T) {
+		current := []string{
+			"perm_legacy_platform_workbench",
+			"perm_menu_platform_access_workbench_menus",
+			"perm_menu_workbench_overview", "perm_menu_workbench_todos", "perm_menu_workbench_messages", "perm_menu_workbench_shortcuts",
+			"perm_platform_roles_update_permissions", "perm_platform_workbench_menus_view",
+		}
+		candidate := append([]string(nil), current...)
+		candidate = append(candidate,
+			"perm_menu_workbench_matrix_accounts_douyin",
+			"perm_menu_workbench_matrix_accounts_kuaishou",
+			"perm_menu_workbench_matrix_accounts_xiaohongshu",
+			"perm_menu_workbench_talent_square_douyin",
+		)
+		if ok, err := fixture.PermissionsAllBelongToWorkspaceType(ctx, candidate, "platform"); err != nil || !ok {
+			t.Fatalf("the production-shaped full menu/page/action selection must pass catalog scope validation: ok=%v err=%v", ok, err)
+		}
+		if err := fixture.SetRolePermissionsWithRevision(ctx, "platform-production-shape", "platform", "platform_root", candidate, 1, "test-actor"); err != nil {
+			t.Fatalf("existing platform permissions plus every active routable/WebView menu and the new Douyin leaf should save: %v", err)
+		}
+		assertRoleSaveFixtureState(t, ctx, db, "platform-production-shape", 2, candidate)
+
+		// The catalog contains a normal permission row for the matrix directory
+		// group, but the directory entry has no route or WebView. It is structural,
+		// not independently grantable; the frontend must hide it while preserving
+		// any pre-existing ID. A direct new grant remains rejected.
+		if err := fixture.SetRolePermissionsWithRevision(ctx, "platform-no-group", "platform", "platform_root", []string{"perm_group_workbench_matrix_accounts"}, 1, "test-actor"); err != ErrValidation {
+			t.Fatalf("a non-routable directory group must not be newly grantable: got %v", err)
+		}
+		assertRoleSaveFixtureState(t, ctx, db, "platform-no-group", 1, nil)
+		if err := fixture.SetRolePermissionsWithRevision(ctx, "platform-no-group", "platform", "platform_root", []string{"perm_menu_workbench_agency_only"}, 1, "test-actor"); err != ErrValidation {
+			t.Fatalf("a valid catalog menu outside platform workspace eligibility must remain rejected: got %v", err)
+		}
+		assertRoleSaveFixtureState(t, ctx, db, "platform-no-group", 1, nil)
+	})
+}
+
+func createRoleSaveFixtureSchema(ctx context.Context, db *sql.DB) error {
+	statements := []string{
+		`CREATE TABLE ky_role (id text PRIMARY KEY, workspace_type text NOT NULL, workspace_id text, name text NOT NULL, code text NOT NULL, description text NOT NULL DEFAULT '', is_system boolean NOT NULL, status text NOT NULL, deleted_at timestamptz, updated_by text, updated_at timestamptz NOT NULL DEFAULT now())`,
+		`CREATE TABLE ky_workbench_menu_role_revision (role_id text PRIMARY KEY REFERENCES ky_role(id), revision bigint NOT NULL CHECK(revision>0), updated_by text, updated_at timestamptz NOT NULL DEFAULT now())`,
+		`CREATE TABLE ky_permission (id text PRIMARY KEY, code text NOT NULL, category text NOT NULL, resource text NOT NULL DEFAULT '', status text NOT NULL, workspace_types jsonb NOT NULL)`,
+		`CREATE TABLE ky_role_permission (id text PRIMARY KEY, role_id text NOT NULL REFERENCES ky_role(id), permission_id text NOT NULL REFERENCES ky_permission(id), UNIQUE(role_id,permission_id))`,
+		`CREATE TABLE ky_workbench_menu (menu_key text PRIMARY KEY, workspace_types jsonb NOT NULL, route_key text, page_type text NOT NULL DEFAULT 'default', status text NOT NULL)`,
+	}
+	for _, statement := range statements {
+		if _, err := db.ExecContext(ctx, statement); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func seedRoleSaveFixture(ctx context.Context, db *sql.DB) error {
+	roles := []struct {
+		id, workspaceType string
+		workspaceID       *string
+		system            bool
+	}{
+		{"platform-null-system", "platform", nil, true},
+		{"platform-root-system", "platform", ptr("platform_root"), true},
+		{"agency-null-template", "agency", nil, true},
+		{"enterprise-null-template", "enterprise", nil, true},
+		{"agency-concrete-system", "agency", ptr("agency-1"), true},
+		{"agency-null-nonsystem", "agency", nil, false},
+		{"platform-production-shape", "platform", ptr("platform_root"), true},
+		{"platform-no-group", "platform", ptr("platform_root"), true},
+	}
+	for _, role := range roles {
+		if _, err := db.ExecContext(ctx, `INSERT INTO ky_role(id,workspace_type,workspace_id,name,code,is_system,status) VALUES($1,$2,$3,$4,$1,$5,'normal')`, role.id, role.workspaceType, role.workspaceID, role.id, role.system); err != nil {
