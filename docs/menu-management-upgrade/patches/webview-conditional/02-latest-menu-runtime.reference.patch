+import assert from "node:assert/strict";
+import { readFile, readdir } from "node:fs/promises";
+import test from "node:test";
+import { assignableWorkbenchMenuCodes, mergeRolePermissionIds, missingPermissionIds, StaleRolePermissionCatalogError } from "./role-permission-contract.ts";
+import { PERMISSION_RESOURCE_AUDIT_KEYS, RESOURCE_LABELS, permissionDisplayName, resourceDomain } from "./permission-labels.ts";
+import { applyPermissionTreeCheck, buildPermissionTreeData, filterPermissionsByCategory, mergePermissionManagementMenus, permissionDisplayKeys, permissionIdsFromDisplayKeys } from "./permission-tree.ts";
+
+const find = (nodes, key) => {
+  for (const node of nodes) {
+    if (node.key === key) return node;
+    const nested = find(node.children ?? [], key);
+    if (nested) return nested;
+  }
+  return undefined;
+};
+const countKey = (nodes, key) => nodes.reduce((count, node) => count + (node.key === key ? 1 : 0) + countKey(node.children ?? [], key), 0);
+
+test("permission categories are stable and changing one category preserves hidden checked IDs", () => {
+  const permissions = [
+    { id: "menu-id", code: "menu.workbench.example", name: "示例菜单", category: "menu", resource: "workbench" },
+    { id: "action-id", code: "platform.shop_management.update", name: "店铺编辑", category: "action", resource: "shop_management" },
+    { id: "page-id", code: "platform.shop_management.view", name: "店铺查看", category: "page", resource: "shop_management" }
+  ];
+  assert.deepEqual(filterPermissionsByCategory(permissions, "all").map((item) => item.id), ["menu-id", "action-id", "page-id"]);
+  assert.deepEqual(filterPermissionsByCategory(permissions, "action").map((item) => item.id), ["action-id"]);
+  assert.deepEqual(filterPermissionsByCategory(permissions, "menu").map((item) => item.id), ["menu-id"]);
+  assert.deepEqual(filterPermissionsByCategory(permissions, "page").map((item) => item.id), ["page-id"]);
+  assert.deepEqual(mergeRolePermissionIds(["menu-id", "action-id", "page-id"], new Set(["action-id"]), []), ["menu-id", "page-id"]);
+});
+
+test("dynamic menu metadata builds directory-specific hierarchy with only real permission IDs selectable", () => {
+  const permissions = [
+    { id: "workbench-leaf-perm", code: "menu.workbench.dynamic.douyin", name: "抖音", category: "menu", resource: "workbench" },
+    { id: "management-leaf-perm", code: "menu.platform.dynamic_page", name: "动态管理页", category: "menu", resource: "plugin_management" }
+  ];
+  const result = buildPermissionTreeData(permissions, {
+    workbench: [
+      { menuKey: "group.workbench.dynamic", name: "新建分组", icon: "FolderOutlined", parentKey: null, sortOrder: 1, workspaceTypes: ["platform"], routeKey: null, nodeType: "group", status: "active", revision: 1 },
+      { menuKey: "menu.workbench.dynamic.douyin", name: "抖音", icon: "AppstoreOutlined", parentKey: "group.workbench.dynamic", sortOrder: 1, workspaceTypes: ["platform"], routeKey: "workbench.dynamic.douyin", nodeType: "leaf", status: "active", revision: 1 }
+    ],
+    management: [
+      { menuKey: "management.dynamic.group", name: "新管理组", icon: "FolderOutlined", parentKey: null, sortOrder: 1, workspaceTypes: ["platform"], routePath: null, permissionKeys: [], nodeType: "group", status: "active", revision: 1 },
+      { menuKey: "management.dynamic.leaf", name: "动态管理页", icon: "AppstoreOutlined", parentKey: "management.dynamic.group", sortOrder: 1, workspaceTypes: ["platform"], routePath: "/dynamic", permissionKeys: ["menu.platform.dynamic_page"], nodeType: "leaf", status: "active", revision: 1 }
+    ]
+  });
+  const workbench = find(result.treeData, "menu-directory:workbench");
+  const management = find(result.treeData, "menu-directory:management");
+  assert.ok(workbench);
+  assert.ok(management);
+  assert.equal(find(workbench.children, "workbench-group-perm"), undefined, "structural groups remain visible without a permission checkbox");
+  assert.equal(find(workbench.children, "workbench-leaf-perm")?.key, "workbench-leaf-perm");
+  assert.equal(find(management.children, "management-leaf-perm")?.key, "management-leaf-perm");
+  assert.deepEqual([...result.permissionIds].sort(), ["management-leaf-perm", "workbench-leaf-perm"]);
+  assert.ok(!result.parentKeys.includes("workbench-leaf-perm"), "structure expansion keys remain distinct from permission IDs");
+});
+
+test("matched menu permissions use the registered navigation label and empty catalog branches disappear", () => {
+  const permissions = [
+    { id: "plugins-menu-id", code: "menu.platform.plugin_management", name: "平台插件管理菜单", category: "menu", resource: "plugin_management" },
+    { id: "legacy-menu-id", code: "menu.platform.legacy_plugins", name: "平台旧插件菜单", category: "menu", resource: "plugin_management" }
+  ];
+  const registry = [{
+    menuKey: "management.ky-system-settings.ky-system-settings.plugins", name: "插件管理", icon: "ApiOutlined",
+    parentKey: "management.group.ky-system-settings", sortOrder: 0, workspaceTypes: ["platform"],
+    routePath: "/system/plugins", permissionKeys: ["menu.platform.plugin_management"], sourcePlugin: "ky-system-settings"
+  }];
+  const catalog = [
+    { menuKey: "management.group.ky-system-settings", name: "系统设置", parentKey: null, sortOrder: 1, workspaceTypes: ["platform"], permissionKeys: [], nodeType: "group", status: "active" },
+    { menuKey: "management.ky-system-settings.ky-system-settings.plugins", name: "平台插件管理", parentKey: "management.group.ky-system-settings", sortOrder: 0, workspaceTypes: ["platform"], permissionKeys: ["menu.platform.plugin_management"], nodeType: "leaf", status: "active" },
+    { menuKey: "management.group.empty", name: "空目录", parentKey: null, sortOrder: 2, workspaceTypes: ["platform"], permissionKeys: [], nodeType: "group", status: "active" },
+    { menuKey: "management.disabled.old", name: "已停用旧页", parentKey: null, sortOrder: 3, workspaceTypes: ["platform"], permissionKeys: ["menu.platform.legacy_plugins"], nodeType: "leaf", status: "disabled" }
+  ];
+  const management = mergePermissionManagementMenus(registry, catalog, "platform");
+  const tree = buildPermissionTreeData(permissions, { workbench: [], management });
+  const actualMenuLeaf = find(tree.treeData, "plugins-menu-id");
+  assert.equal(actualMenuLeaf.title.props.children[0].props.children, "访问插件管理");
+  assert.equal(countKey(tree.treeData, "plugins-menu-id"), 1);
+  assert.equal(find(tree.treeData, "menu-tree:management:management.group.empty")?.checkable, false, "empty modules stay visible without a checkbox");
+  assert.equal(find(tree.treeData, "menu-tree:management:management.disabled.old")?.checkable, false, "disabled menu remains in the full skeleton without a selectable permission checkbox");
+  const unlinked = find(tree.treeData, "legacy-menu-id");
+  assert.equal(unlinked.title.props.children[0].props.children, "旧插件");
+  assert.equal(find(tree.treeData, "menu-directory:unlinked").title, "公共能力（1）");
+});
+
+test("resource labels cover every permission resource declared by the SQL migration corpus", async () => {
+  const migrationDirectory = new URL("../../../ops/db/", import.meta.url);
+  const migrationFiles = await readdir(migrationDirectory);
+  const sourceResources = new Set();
+  for (const file of migrationFiles.filter((name) => name.endsWith(".sql"))) {
+    const sql = await readFile(new URL(file, migrationDirectory), "utf8");
+    for (const match of sql.matchAll(/'(?:menu|page|action)'\s*,\s*'([^']+)'\s*,\s*'[^']*'\s*,\s*'\[/g)) sourceResources.add(match[1]);
+  }
