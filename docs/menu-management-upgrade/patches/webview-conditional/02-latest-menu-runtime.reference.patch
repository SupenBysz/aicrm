+type managementMenuPermissionMetadata struct {
+	MenuKey        string   `json:"menuKey"`
+	Name           string   `json:"name"`
+	ParentKey      *string  `json:"parentKey"`
+	SortOrder      int      `json:"sortOrder"`
+	WorkspaceTypes []string `json:"workspaceTypes"`
+	PermissionKeys []string `json:"permissionKeys"`
+	NodeType       string   `json:"nodeType"`
+	Status         string   `json:"status"`
+}
+
+func projectManagementMenuPermissionMetadata(items []store.ManagementMenu, permissionCodes map[string]struct{}, workspaceType string) []managementMenuPermissionMetadata {
+	byKey := make(map[string]store.ManagementMenu, len(items))
+	include := make(map[string]bool, len(items))
+	for _, item := range items {
+		byKey[item.MenuKey] = item
+		include[item.MenuKey] = slices.Contains(item.WorkspaceTypes, workspaceType)
+	}
+	for _, item := range items {
+		if !include[item.MenuKey] {
+			continue
+		}
+		parentKey := item.ParentKey
+		for parentKey != nil {
+			parent, ok := byKey[*parentKey]
+			if !ok || include[parent.MenuKey] {
+				break
+			}
+			include[parent.MenuKey] = true
+			parentKey = parent.ParentKey
+		}
+	}
+	out := make([]managementMenuPermissionMetadata, 0, len(items))
+	for _, item := range items {
+		if !include[item.MenuKey] {
+			continue
+		}
+		keys := make([]string, 0, len(item.PermissionKeys))
+		for _, code := range item.PermissionKeys {
+			if _, ok := permissionCodes[code]; ok {
+				keys = append(keys, code)
+			}
+		}
+		out = append(out, managementMenuPermissionMetadata{
+			MenuKey: item.MenuKey, Name: item.Name, ParentKey: item.ParentKey, SortOrder: item.SortOrder,
+			WorkspaceTypes: []string{workspaceType}, PermissionKeys: keys, NodeType: item.NodeType, Status: item.Status,
+		})
+	}
+	return out
+}
+
+func (s *Server) listManagementMenuPermissionMetadata(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	items, err := s.store.ListManagementMenus(r.Context())
+	if err != nil {
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	permissions, err := s.store.ListPermissions(r.Context(), wc.WorkspaceType, "")
+	if err != nil {
+		writeManagementMenuStoreError(w, r, err)
+		return
+	}
+	permissionCodes := make(map[string]struct{}, len(permissions))
+	for _, permission := range permissions {
+		permissionCodes[permission.Code] = struct{}{}
+	}
+	writeData(w, r, projectManagementMenuPermissionMetadata(items, permissionCodes, wc.WorkspaceType))
+}
+
