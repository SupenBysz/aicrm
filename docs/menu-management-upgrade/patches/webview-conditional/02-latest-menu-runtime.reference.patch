+package store
+
+import (
+	"context"
+	"reflect"
+	"testing"
+)
+
+func TestGroupRolePermissionIDsPreservesExistingAssignmentsPerRole(t *testing.T) {
+	got := groupRolePermissionIDs(
+		[]string{"role-a", "role-b", "role-empty"},
+		[]rolePermissionPair{
+			{roleID: "role-a", permissionID: "permission-2"},
+			{roleID: "role-b", permissionID: "permission-3"},
+			{roleID: "role-a", permissionID: "permission-1"},
+			{roleID: "not-in-page", permissionID: "ignored"},
+		},
+	)
+	want := map[string][]string{
+		"role-a":     {"permission-2", "permission-1"},
+		"role-b":     {"permission-3"},
+		"role-empty": {},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("groupRolePermissionIDs() = %#v, want %#v", got, want)
+	}
+}
+
+func TestRolePermissionWorkspaceMatchesRoleListingTemplateSemantics(t *testing.T) {
+	workspaceID := "platform_root"
+	role := Role{WorkspaceType: "platform", WorkspaceID: &workspaceID, IsSystem: true}
+	if err := validateRolePermissionWorkspace(role, "platform", "platform_root"); err != nil {
+		t.Fatalf("system role should be editable through the separately authorized permission path: %v", err)
+	}
+	if err := validateRolePermissionWorkspace(role, "agency", "agency-1"); err != ErrNotFound {
+		t.Fatalf("cross-workspace update must remain hidden, got %v", err)
+	}
+	if err := validateRolePermissionWorkspace(role, "platform", "other-platform"); err != ErrNotFound {
+		t.Fatalf("cross-scope update must remain hidden, got %v", err)
+	}
+	if err := validateRoleMetadataEditable(role); err != ErrConflict {
+		t.Fatalf("system role metadata must remain protected, got %v", err)
+	}
+
+	// System templates with NULL workspace_id are visible through ListRoles and
+	// GetRole to every workspace of their own workspace_type.
+	nullAgencyTemplate := Role{WorkspaceType: "agency", WorkspaceID: nil, IsSystem: true}
+	if err := validateRolePermissionWorkspace(nullAgencyTemplate, "agency", "agency-1"); err != nil {
+		t.Fatalf("same-type NULL-scope system template must match listing semantics: %v", err)
+	}
+	if err := validateRolePermissionWorkspace(nullAgencyTemplate, "enterprise", "enterprise-1"); err != ErrNotFound {
+		t.Fatalf("NULL-scope system template must not cross workspace_type, got %v", err)
+	}
+	nullCustomRole := Role{WorkspaceType: "agency", WorkspaceID: nil, IsSystem: false}
+	if err := validateRolePermissionWorkspace(nullCustomRole, "agency", "agency-1"); err != ErrNotFound {
+		t.Fatalf("NULL-scope non-system role must not be treated as a template, got %v", err)
+	}
+}
+
+func TestSetRolePermissionsRequiresRevisionForEveryReplacement(t *testing.T) {
+	var store Store
+	ctx := context.Background()
+	if err := store.SetRolePermissionsWithRevision(ctx, "role", "platform", "platform_root", nil, 0, "actor"); err != ErrValidation {
+		t.Fatalf("missing revision must fail before database access, got %v", err)
+	}
+	if err := store.SetRolePermissionsWithRevision(ctx, "role", "platform", "platform_root", nil, -1, "actor"); err != ErrValidation {
+		t.Fatalf("negative revision must fail before database access, got %v", err)
+	}
+	if err := store.SetRolePermissions(ctx, "role", "platform", "platform_root", nil, "actor"); err != ErrValidation {
+		t.Fatalf("legacy no-revision replacement must not bypass CAS, got %v", err)
+	}
+}
