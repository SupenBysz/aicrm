@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { isAllowedMenuWebViewApiBaseUrl } from "./menu-webview-api-security.ts";
+
+test("menu WebView API accepts HTTPS in packaged and development clients", () => {
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("https://api.kww.org.cn", { isPackaged: true }), true);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("https://api.kww.org.cn", { isPackaged: false }), true);
+});
+
+test("HTTP is accepted only for numeric loopback in an explicit un-packaged SSH tunnel", () => {
+  const sshDevelopment = { isPackaged: false, connectionMode: "ssh" };
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://127.0.0.1:18180", sshDevelopment), true);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://[::1]:18180", sshDevelopment), true);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://127.0.0.1:18181", sshDevelopment), false);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://127.0.0.1", sshDevelopment), false);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://127.0.0.1:18180", { ...sshDevelopment, connectionMode: "direct" }), false);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://127.0.0.1:18180", { ...sshDevelopment, isPackaged: true }), false);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://api.kww.org.cn", sshDevelopment), false);
+  assert.equal(isAllowedMenuWebViewApiBaseUrl("http://localhost:18180", sshDevelopment), false);
+});
+
+test("API base URL rejects credentials, query, fragment and malformed values", () => {
+  const development = { isPackaged: false, connectionMode: "ssh" };
+  for (const value of [
+    "https://user:pass@api.kww.org.cn",
+    "http://127.0.0.1:18180?token=secret",
+    "http://127.0.0.1:18180/#fragment",
+    "not a URL"
+  ]) assert.equal(isAllowedMenuWebViewApiBaseUrl(value, development), false, value);
+});
diff --git a/apps/aicrm-desktop/src/main/menu-webview-api-security.ts b/apps/aicrm-desktop/src/main/menu-webview-api-security.ts
new file mode 100644
index 000000000..8cddc7297
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/menu-webview-api-security.ts
@@ -0,0 +1,14 @@
+export function isAllowedMenuWebViewApiBaseUrl(
+  value: string,
+  policy: { isPackaged: boolean; connectionMode?: string }
+): boolean {
+  let url: URL;
+  try { url = new URL(value); } catch { return false; }
+  if (url.username || url.password || url.search || url.hash) return false;
+  if (url.protocol === "https:") return true;
+  if (url.protocol !== "http:" || policy.isPackaged || policy.connectionMode !== "ssh") return false;
+  // The only insecure exception is an explicitly selected, un-packaged SSH
+  // development tunnel bound to a numeric loopback address. Never trust a
+  // remote HTTP host or a hostname that could resolve away from loopback.
+  return (url.hostname === "127.0.0.1" || url.hostname === "[::1]") && url.port === "18180";
+}
