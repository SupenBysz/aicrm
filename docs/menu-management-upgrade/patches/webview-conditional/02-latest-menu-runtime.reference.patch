+/** Validate the required menu WebView URL outside Ant Design field rules so failures use a floating notice. */
+export function validateMenuWebViewDefaultUrl(value: unknown): string | undefined {
+  if (typeof value !== "string" || !value.trim()) return "请输入页面默认 URL";
+  if (value.trim() !== value) return "URL 前后不能包含空格";
+  try {
+    const url = new URL(value);
+    if ((url.protocol === "https:" || url.protocol === "http:") && url.hostname && !url.username && !url.password) return undefined;
+  } catch {
+    // Invalid URL values use the same actionable message as unsupported protocols.
+  }
+  return "请输入有效的 HTTP 或 HTTPS URL";
+}
+
+export interface MenuWebViewStoreQueryContext {
+  open: boolean;
+  isWebView: boolean;
+  editing: boolean;
+  menuKey?: string;
+  sessionSource: MenuWebViewSessionSource;
+  target: { workspaceType: string; workspaceId: string } | null;
+  targetIsAllowed: boolean;
+  configHydrated: boolean;
+}
+
+/** Store lists are scoped to a selected, authorized workspace and only queried after its config is loaded. */
+export function shouldLoadMenuWebViewStores(context: MenuWebViewStoreQueryContext): boolean {
+  return context.open && context.isWebView && context.editing && Boolean(context.menuKey)
+    && context.sessionSource === "store" && context.targetIsAllowed && context.configHydrated
+    && Boolean(context.target?.workspaceType && context.target.workspaceId);
+}
+
+export function shouldReportMenuWebViewStoreError(
+  queryEnabled: boolean,
+  queryIsError: boolean,
+  error: unknown,
+  previouslyObservedError: unknown
+): boolean {
+  return queryEnabled && queryIsError && error != null && error !== previouslyObservedError;
+}
+
+/** Keep a saved common config as the default edit target; a deliberate target selection always wins. */
+export function resolveInitialMenuWebViewTargetKey(
+  commonConfigExists: boolean,
+  currentTargetKey: string,
+  targetWasExplicitlySelected: boolean
+): string {
+  return !targetWasExplicitlySelected && commonConfigExists ? "" : currentTargetKey;
+}
+
+/** Keep controlled, unregistered WebView fields that Ant Design omits from onFinish values. */
+export function collectMenuCatalogFormValues(
+  registeredValues: Partial<MenuCatalogFormValues>,
+  allFormValues: Partial<MenuCatalogFormValues>
+): MenuCatalogFormValues {
+  const registeredWebView = registeredValues.webView;
+  const storedWebView = allFormValues.webView;
+  const webView = { ...storedWebView, ...registeredWebView } as MenuCatalogFormValues["webView"];
+  webView.scripts = registeredWebView?.scripts !== undefined
+    ? registeredWebView.scripts
+    : storedWebView?.scripts !== undefined ? storedWebView.scripts : [];
+  webView.styles = registeredWebView?.styles !== undefined
+    ? registeredWebView.styles
+    : storedWebView?.styles !== undefined ? storedWebView.styles : [];
+  return { ...allFormValues, ...registeredValues, webView } as MenuCatalogFormValues;
+}
+
+export async function runWithPendingMenuStatus(
+  menuKey: string,
+  pendingKeys: Set<string>,
+  onPendingChange: (keys: Set<string>) => void,
+  action: () => Promise<unknown>
+): Promise<void> {
+  if (pendingKeys.has(menuKey)) return;
+  pendingKeys.add(menuKey);
+  onPendingChange(new Set(pendingKeys));
+  try {
+    await action();
+  } finally {
+    pendingKeys.delete(menuKey);
+    onPendingChange(new Set(pendingKeys));
+  }
+}
