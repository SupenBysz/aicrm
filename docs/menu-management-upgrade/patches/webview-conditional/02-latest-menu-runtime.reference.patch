+test("实际 React 区域容器往返时页面只挂载一次并保留未提交状态", async () => {
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+  const counts = { workbenchMounts: 0, workbenchUnmounts: 0, manageMounts: 0, manageUnmounts: 0 };
+  let changeActive;
+  function StatefulPage({ area }) {
+    const [value, setValue] = useState(area === "workbench" ? "webview-scroll=420" : "keyword=订单&page=3&draft=未提交");
+    useEffect(() => {
