+
+  assert.match(component, /export function MenuStatusCell/);
+  assert.match(component, /aria-label=\{`\$\{target === "disabled" \? "停用" : "启用"\}此菜单`\}/);
+  assert.match(component, /if \(!canToggle \|\| !target\) return tag/);
+  assert.match(component, /loading=\{loading\}[\s\S]*disabled=\{loading\}/);
+  assert.match(workbench, /<MenuStatusCell[\s\S]*canToggle=\{canToggle\}[\s\S]*loading=\{statusLoading\(item\)\}/);
+  assert.match(workbench, /const canToggle = active \? canWorkbenchDisable : canWorkbenchUpdate && !isWorkbenchMenuGroup\(item\)/);
+  assert.match(workbench, /queryClient\.invalidateQueries\(\{ queryKey: \["workbench-menu-catalog"\] \}\)/);
+  assert.match(workbench, /enableMenu\.mutateAsync\(item\)/);
+  assert.match(workbench, /mutationFn: \(item: WorkbenchMenu\) => enableWorkbenchMenu\(client, item\.menuKey, item\.revision\)/);
+  assert.doesNotMatch(workbench, /client\.request\(`\/api\/v1\/workbench-menus\/\$\{encodeURIComponent\(item\.menuKey\)\}\/enable`/);
+  assert.match(workbench, /disableMenu\.mutateAsync\(item\)/);
