+func assertRoleSaveFixtureState(t *testing.T, ctx context.Context, db *sql.DB, roleID string, revision int64, permissionIDs []string) {
+	t.Helper()
+	want := append([]string(nil), permissionIDs...)
+	sort.Strings(want)
+	var actualRevision int64
+	if err := db.QueryRowContext(ctx, `SELECT revision FROM ky_workbench_menu_role_revision WHERE role_id=$1`, roleID).Scan(&actualRevision); err != nil {
+		t.Fatal(err)
+	}
+	if actualRevision != revision {
+		t.Fatalf("role revision=%d want=%d", actualRevision, revision)
+	}
+	rows, err := db.QueryContext(ctx, `SELECT permission_id FROM ky_role_permission WHERE role_id=$1 ORDER BY permission_id`, roleID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var got []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, id)
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != len(want) {
+		t.Fatalf("role permissions=%v want=%v", got, want)
+	}
+	for i, id := range want {
+		if got[i] != id {
+			t.Fatalf("role permissions=%v want=%v", got, want)
+		}
+	}
+}
