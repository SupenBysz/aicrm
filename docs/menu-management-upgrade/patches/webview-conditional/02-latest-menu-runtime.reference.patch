+import assert from "node:assert/strict";
+import test from "node:test";
+import { logMenuWebViewDiagnostic, menuWebViewDiagnosticErrorCode, menuWebViewDiagnosticRecord } from "./menu-webview-diagnostic.ts";
+
+test("menu WebView diagnostic output is an allow-listed stage record", () => {
+  const record = menuWebViewDiagnosticRecord({
+    requestId: "request-id",
+    stage: "resolve_response_received",
+    elapsedMs: 14.8,
+    directoryType: "workbench",
+    workspaceType: "platform",
+    httpStatus: 200,
+    sessionAvailable: true,
+    errorCode: undefined
+  });
+  assert.deepEqual(record, {
+    requestId: "request-id",
+    stage: "resolve_response_received",
+    elapsedMs: 14,
+    directoryType: "workbench",
+    workspaceType: "platform",
+    httpStatus: 200,
+    sessionAvailable: true
+  });
+  assert.doesNotMatch(JSON.stringify(record), /token|cookie|password|headers|url|workspaceId|menuKey/i);
+});
+
+test("logger emits JSON without accepting full request or response payloads", () => {
+  const output = [];
+  logMenuWebViewDiagnostic({ requestId: "r", stage: "session_load_started", elapsedMs: 1, directoryType: "management", workspaceType: "agency" }, (...args) => output.push(args));
+  assert.equal(output.length, 1);
+  assert.equal(output[0][0], "menu_webview_open_diagnostic");
+  assert.deepEqual(JSON.parse(output[0][1]), {
+    requestId: "r", stage: "session_load_started", elapsedMs: 1, directoryType: "management", workspaceType: "agency"
+  });
+});
+
+test("resolve diagnostics preserve safe failure categories without exposing arbitrary messages", () => {
+  assert.equal(menuWebViewDiagnosticErrorCode(new Error("https_required")), "https_required");
+  assert.equal(menuWebViewDiagnosticErrorCode(new Error("api_url_invalid")), "api_url_invalid");
+  assert.equal(menuWebViewDiagnosticErrorCode(new Error("menu_runtime_http_403")), "menu_runtime_http_error");
+  assert.equal(menuWebViewDiagnosticErrorCode(new Error("https://user:secret@example.test/path?token=secret")), "menu_webview_resolve_failed");
+});
diff --git a/apps/aicrm-desktop/src/main/menu-webview-diagnostic.ts b/apps/aicrm-desktop/src/main/menu-webview-diagnostic.ts
new file mode 100644
index 000000000..d71d17a02
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/menu-webview-diagnostic.ts
@@ -0,0 +1,57 @@
+export type MenuWebViewDiagnosticStage =
+  | "request_received" | "request_rejected" | "owner_validated"
+  | "session_load_started" | "session_load_failed" | "session_loaded"
+  | "resolve_started" | "resolve_request_started" | "resolve_response_received" | "resolve_body_parsed" | "resolve_config_validated" | "resolve_failed" | "resolve_timeout"
+  | "login_space_session_started" | "login_space_session_ready"
+  | "session_config_started" | "session_config_ready"
+  | "view_creation_started" | "view_created" | "view_attached"
+  | "document_start_prepare_started" | "document_start_prepare_completed"
+  | "navigation_started" | "navigation_failed" | "open_returned" | "open_failed" | "superseded";
+
+export type MenuWebViewDiagnosticErrorCode =
+  | "validation_error" | "window_unavailable" | "auth_context_missing" | "session_load_failed"
+  | "menu_webview_resolve_failed" | "menu_webview_invalid_response" | "login_space_session_setup_failed"
+  | "login_space_session_configuration_conflict" | "menu_webview_open_failed"
+  | "document_start_prepare_failed" | "page_load_failed" | "https_required" | "api_url_invalid"
+  | "desktop_session_unavailable" | "menu_runtime_http_error";
+
+/** Map arbitrary runtime failures to a small non-sensitive diagnostic vocabulary. */
+export function menuWebViewDiagnosticErrorCode(error: unknown): MenuWebViewDiagnosticErrorCode {
+  const message = error instanceof Error ? error.message : "";
+  if (message === "https_required" || message === "api_url_invalid" || message === "desktop_session_unavailable") return message;
+  if (/^menu_runtime_http_\d{3}$/.test(message)) return "menu_runtime_http_error";
+  return "menu_webview_resolve_failed";
+}
+
+export type MenuWebViewDiagnosticInput = {
+  requestId: string;
+  stage: MenuWebViewDiagnosticStage;
+  elapsedMs: number;
+  directoryType: "workbench" | "management";
+  workspaceType: "platform" | "agency" | "enterprise";
+  httpStatus?: number;
+  sessionAvailable?: boolean;
+  sessionSource?: "ordinary" | "store";
+  openMode?: "embedded" | "window";
+  errorCode?: MenuWebViewDiagnosticErrorCode;
+};
+
+/** Emit an allow-listed diagnostic record. Never pass request/config payloads here. */
+export function menuWebViewDiagnosticRecord(input: MenuWebViewDiagnosticInput) {
+  return {
+    requestId: input.requestId,
+    stage: input.stage,
+    elapsedMs: Math.max(0, Math.floor(input.elapsedMs)),
+    directoryType: input.directoryType,
+    workspaceType: input.workspaceType,
+    ...(Number.isInteger(input.httpStatus) ? { httpStatus: input.httpStatus } : {}),
+    ...(typeof input.sessionAvailable === "boolean" ? { sessionAvailable: input.sessionAvailable } : {}),
+    ...(input.sessionSource ? { sessionSource: input.sessionSource } : {}),
+    ...(input.openMode ? { openMode: input.openMode } : {}),
+    ...(input.errorCode ? { errorCode: input.errorCode } : {})
+  };
+}
+
+export function logMenuWebViewDiagnostic(input: MenuWebViewDiagnosticInput, logger = console.info) {
+  logger("menu_webview_open_diagnostic", JSON.stringify(menuWebViewDiagnosticRecord(input)));
+}
