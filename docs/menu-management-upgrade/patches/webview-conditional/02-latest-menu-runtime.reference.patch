+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { assignableWorkbenchMenuCodes, mergeRolePermissionIds, rolePermissionConflictMessage, rolePermissionSaveReady, visibleRolePermissionIds } from "./role-permission-contract.ts";
+import { setRolePermissions } from "./api.ts";
+
+test("existing role checks render when the permission catalog finishes loading", () => {
+  const existing = ["visible-a", "hidden-b", "visible-c"];
+  assert.deepEqual(visibleRolePermissionIds(existing, new Set()), [], "the tree waits for its catalog without discarding source IDs");
+  assert.deepEqual(visibleRolePermissionIds(existing, new Set(["visible-a", "visible-c"])), ["visible-a", "visible-c"]);
+});
+
+test("saving visible edits preserves assignments hidden by workspace or catalog filtering", () => {
+  const existing = ["visible-a", "hidden-b", "visible-c"];
+  const visible = new Set(["visible-a", "visible-c", "visible-new"]);
+  assert.deepEqual(mergeRolePermissionIds(existing, visible, ["visible-a", "visible-new"]), ["hidden-b", "visible-a", "visible-new"]);
+  assert.deepEqual(mergeRolePermissionIds(existing, new Set(), existing), existing, "a failed/empty visible catalog cannot clear existing assignments");
+});
+
+test("only active routable and WebView workbench leaves are selectable; group and legacy IDs stay preserved", () => {
+  const menus = [
+    { menuKey: "group.workbench.matrix_accounts", workspaceTypes: ["platform", "agency", "enterprise"], routeKey: null, pageType: "default", status: "active" },
+    { menuKey: "group.workbench.talent_square", workspaceTypes: ["platform", "enterprise"], routeKey: null, pageType: "default", status: "active" },
+    { menuKey: "menu.workbench.matrix_accounts.douyin", workspaceTypes: ["platform", "agency", "enterprise"], routeKey: "workbench.matrix-accounts.douyin", pageType: "default", status: "active" },
+    { menuKey: "menu.workbench.talent_square.douyin", workspaceTypes: ["platform", "enterprise"], routeKey: null, pageType: "webview", status: "active" },
+    { menuKey: "menu.workbench.old", workspaceTypes: ["platform"], routeKey: "workbench.old", pageType: "default", status: "disabled" }
+  ];
+  const permissions = [
+    { id: "group", code: "group.workbench.matrix_accounts", category: "menu", resource: "workbench", status: "normal", workspaceTypes: ["platform"] },
+    { id: "talent-group", code: "group.workbench.talent_square", category: "menu", resource: "workbench", status: "disabled", workspaceTypes: ["platform"] },
+    { id: "douyin", code: "menu.workbench.matrix_accounts.douyin", category: "menu", resource: "workbench", status: "normal", workspaceTypes: ["platform"] },
+    { id: "webview", code: "menu.workbench.talent_square.douyin", category: "menu", resource: "workbench", status: "normal", workspaceTypes: ["platform"] },
+    { id: "legacy", code: "menu.platform.workbench", category: "menu", resource: "workbench", status: "normal", workspaceTypes: ["platform"] },
+    { id: "management", code: "menu.platform.access.workbench_menus", category: "menu", resource: "access.workbench_menus", status: "normal", workspaceTypes: ["platform"] }
+  ];
+  const selectable = assignableWorkbenchMenuCodes({ workspaceType: "platform", permissions, menus });
+  assert.deepEqual([...selectable].sort(), ["menu.workbench.matrix_accounts.douyin", "menu.workbench.talent_square.douyin"]);
+  const existing = ["group", "legacy"];
+  const saved = mergeRolePermissionIds(existing, new Set(["douyin", "webview"]), ["douyin", "webview"]);
+  assert.deepEqual(saved, ["group", "legacy", "douyin", "webview"], "non-selectable existing group and legacy assignments are retained");
+  const page = readFileSync(new URL("./pages/roles-page.tsx", import.meta.url), "utf8");
+  assert.match(page, /assignableWorkbenchMenuCodes\(\{/);
+  assert.match(page, /workbenchMenusQuery\.data/);
+});
+
+test("role permission save stays disabled until the full catalog, menu directories and workspace cap are ready", () => {
+  const base = { permissionCatalogLoaded: true, permissionCatalogLoading: false, permissionCatalogFailed: false, menuDirectoriesReady: true, workspaceMenuCapReady: true };
+  assert.equal(rolePermissionSaveReady(base), true);
+  assert.equal(rolePermissionSaveReady({ ...base, permissionCatalogLoaded: false }), false);
+  assert.equal(rolePermissionSaveReady({ ...base, permissionCatalogLoading: true }), false);
+  assert.equal(rolePermissionSaveReady({ ...base, permissionCatalogFailed: true }), false);
+  assert.equal(rolePermissionSaveReady({ ...base, menuDirectoriesReady: false }), false);
+  assert.equal(rolePermissionSaveReady({ ...base, workspaceMenuCapReady: false }), false);
+});
+
+test("role permission drawer initializes from role data and never rehydrates over edits", () => {
+  const source = readFileSync(new URL("./pages/roles-page.tsx", import.meta.url), "utf8");
+  assert.match(source, /async function openPermissions\(role: Role\)/);
+  assert.match(source, /queryClient\.fetchQuery\(\{\s*queryKey: rolesQueryKey,[\s\S]*?staleTime: 0/);
+  assert.match(source, /const requestId = \+\+permissionOpenRequest\.current;[\s\S]*?if \(requestId !== permissionOpenRequest\.current\) return;/);
+  assert.match(source, /permissionOpenRequest\.current \+= 1;[\s\S]*?setPermRole\(null\);/);
+  assert.match(source, /setPermRole\(currentRole\);\s*setCheckedPerms\(\[\.\.\.currentRole\.permissionIds\]\)/);
+  assert.match(source, /checkedKeys=\{permissionDisplayKeys\(permissionTree\.permissionNodeIds, visibleRolePermissionIds\(checkedPerms, displayedPermissionIds\)\)\}/);
+  assert.match(source, /applyPermissionTreeCheck\(\s*permissionTree\.permissionNodeIds,\s*permissionTree\.treeData,\s*String\(info\.node\.key\),\s*info\.checked,\s*current\s*\)/);
+  assert.match(source, /mergeRolePermissionIds\(permRole\?\.permissionIds \?\? \[\], visiblePermissionIds, ids\)/);
+  assert.match(source, /disabled=\{!permissionTreeReady\}/);
+  assert.match(source, /setCheckedPerms\(\[\.\.\.currentRole\.permissionIds\]\)/);
+  assert.match(source, /const rolesQueryKey = \["roles", workspace\?\.type, workspace\?\.id,/);
+  assert.match(source, /queryKey: \["permissions", "catalog", workspace\?\.type, workspace\?\.id\]/);
+  assert.match(source, /rolePermissionConflictMessage\(error\)/);
+  assert.match(source, /if \(conflictMessage\) \{[\s\S]*?invalidateQueries[\s\S]*?message\.error\(conflictMessage\);\s*return;/);
+  assert.doesNotMatch(source, /if \(conflictMessage\) \{[\s\S]{0,500}?setCheckedPerms\(\[\]\)/);
+  assert.match(source, /setPermRole\(null\);\s*setCheckedPerms\(\[\]\);\s*\}, \[workspace\?\.id, workspace\?\.type\]\)/);
+});
+
+test("role permission conflicts are explicit and do not claim catalog errors are concurrency conflicts", () => {
+  assert.match(rolePermissionConflictMessage({ code: "conflict" }), /当前勾选草稿已保留/);
+  assert.match(rolePermissionConflictMessage({ code: "conflict" }), /重新打开授权/);
+  assert.equal(rolePermissionConflictMessage({ code: "validation_error" }), null);
+  assert.equal(rolePermissionConflictMessage(new Error("network")), null);
+});
+
+test("role permission API always sends the exact positive revision and rejects missing/invalid baselines", async () => {
+  const calls = [];
+  const client = { request: async (...args) => { calls.push(args); return { ok: true }; } };
+  await setRolePermissions(client, "role-1", ["permission-1"], 7);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0][0], "/api/v1/roles/role-1/permissions");
+  assert.deepEqual(calls[0][1].body, { permissionIds: ["permission-1"], expectedRevision: 7 });
+  for (const invalid of [undefined, 0, -1, 1.5, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.throws(() => setRolePermissions(client, "role-1", [], invalid), /角色授权版本信息无效/);
+  }
+  assert.equal(calls.length, 1, "invalid revision never sends a request");
+});
diff --git a/plugins/ky-access-management/src/role-permission-contract.ts b/plugins/ky-access-management/src/role-permission-contract.ts
