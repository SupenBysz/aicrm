+      return () => { counts[area === "workbench" ? "workbenchUnmounts" : "manageUnmounts"]++; };
+    }, [area]);
+    return React.createElement("page-state", { area, value, change: setValue });
+  }
+  const workbenchNode = React.createElement(StatefulPage, { area: "workbench" });
+  const manageNode = React.createElement(StatefulPage, { area: "manage" });
+  function Harness() {
