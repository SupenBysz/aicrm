+  assert.match(management, /item\.status === "active"[\s\S]*canDisable && permissions\.can\("platform\.workbench_menus\.disable"\)/);
+  assert.match(management, /await setStatus\.mutateAsync\(\{ item, status \}\)/);
+  assert.match(management, /queryClient\.invalidateQueries\(\{ queryKey: \["management-menu-catalog"\] \}\)/);
