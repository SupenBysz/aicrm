+package store
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestWorkbenchMenuUpdateAllowsDisabledWebViewConfigurationWithoutEnablingMenu(t *testing.T) {
+	cases := []struct {
+		name                       string
+		status, current, requested string
+		want                       bool
+	}{
+		{"active webview", "active", "webview", "webview", true},
+		{"active page can be edited", "active", "default", "default", true},
+		{"disabled webview remains configurable", "disabled", "webview", "webview", true},
+		{"disabled ordinary page remains unavailable", "disabled", "default", "default", false},
+		{"disabled webview cannot change page kind", "disabled", "webview", "default", false},
+		{"unknown state remains unavailable", "deleted", "webview", "webview", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := workbenchMenuUpdateAllowed(tc.status, tc.current, tc.requested); got != tc.want {
+				t.Fatalf("workbenchMenuUpdateAllowed(%q,%q,%q)=%v want %v", tc.status, tc.current, tc.requested, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestDisabledWebViewUpdateLocksStateAndPreservesDisabledStatus(t *testing.T) {
+	source, err := os.ReadFile("workbench_menu_admin.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(source)
+	for _, want := range []string{
+		"SELECT revision,COALESCE(page_type,'default'),status FROM ky_workbench_menu WHERE menu_key=$1 AND status IN ('active','disabled') FOR UPDATE",
+		"workbenchMenuUpdateAllowed(currentStatus, currentPageType, requestedPageType)",
+		"WHEN $13='disabled' THEN 'disabled'",
+	} {
+		if !strings.Contains(text, want) {
+			t.Errorf("disabled WebView update transaction is missing safety clause %q", want)
+		}
+	}
+}
+
+func TestExistingDisabledPlatformMenuAcceptsOrdinaryWebViewConfiguration(t *testing.T) {
+	revision := int64(0)
+	input := MenuWebViewConfigInput{
+		SessionSource: "ordinary", OpenMode: "embedded", DefaultURL: "https://www.baidu.com",
+		ScheduleMode: "page_first", Scripts: []MenuWebViewBinding{}, Styles: []MenuWebViewBinding{},
+		ProtocolWhitelist: MenuWebViewProtocolWhitelist{
+			Navigation: []string{"http", "https", "blob", "data"},
+			WebSocket:  []string{"ws", "wss"},
+			External:   []string{"mailto"},
+		},
+		Proxy:            MenuWebViewProxyInput{MenuWebViewProxy: MenuWebViewProxy{Mode: "direct", BypassRules: []string{}}},
+		CloseBehavior:    "close_view",
+		ExpectedRevision: &revision,
+	}
+	if !validMenuWebViewInput(input) {
+		t.Fatal("valid ordinary WebView settings should pass server validation")
+	}
+	if !ValidMenuWebViewTarget("platform", "platform_root") {
+		t.Fatal("the authorized platform workspace target should be valid")
+	}
+	if !menuWebViewConfigLeafEligible("webview", "disabled", "platform", []string{"platform"}, true) {
+		t.Fatal("an existing disabled WebView leaf must accept setup before enablement")
+	}
+	if !workbenchMenuUpdateAllowed("disabled", "webview", "webview") {
+		t.Fatal("menu metadata PATCH preceding config PUT must accept the disabled WebView leaf")
+	}
+
+	if ValidMenuWebViewTarget("platform", "another-platform") {
+		t.Fatal("a forged platform target must remain rejected")
+	}
+	if menuWebViewConfigLeafEligible("webview", "disabled", "platform", []string{"enterprise"}, true) {
+		t.Fatal("an unsupported workspace type must remain rejected")
+	}
+	if workbenchMenuUpdateAllowed("disabled", "default", "default") {
+		t.Fatal("ordinary disabled menu rows must remain unavailable for updates")
+	}
+}
