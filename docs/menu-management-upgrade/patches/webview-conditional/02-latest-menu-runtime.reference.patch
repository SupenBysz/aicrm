+  const key = "menu.workbench.example/child";
+
+  await enableWorkbenchMenu(client, key, 17);
+  await enableWorkbenchMenu(client, key, 18);
+
+  assert.equal(calls.length, 2);
+  for (const [path, options] of calls) {
+    assert.equal(path, "/api/v1/workbench-menus/menu.workbench.example%2Fchild/enable");
+    assert.equal(options.method, "POST");
+    assert.ok(options.headers["Idempotency-Key"]);
+  }
+  assert.equal(calls[0][1].body.expectedRevision, 17);
+  assert.equal(calls[1][1].body.expectedRevision, 18);
+  assert.notEqual(calls[0][1].headers["Idempotency-Key"], calls[1][1].headers["Idempotency-Key"]);
+});
+
+test("failed menu status request always clears the pending/loading state", async () => {
+  const pending = new Set();
+  const snapshots = [];
+  await assert.rejects(
+    runWithPendingMenuStatus("menu.workbench.example", pending, keys => snapshots.push(keys), async () => {
+      throw new Error("request failed");
+    }),
+    /request failed/
+  );
+  assert.equal(pending.has("menu.workbench.example"), false);
+  assert.deepEqual(snapshots.map(keys => [...keys]), [["menu.workbench.example"], []]);
