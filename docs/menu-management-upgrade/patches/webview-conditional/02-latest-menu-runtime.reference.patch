+export type BusinessWebPageViewportBounds = { x: number; y: number; width: number; height: number; visible: boolean };
+
+export function boundsForWorkspaceArea(
+  active: boolean,
+  bounds: BusinessWebPageViewportBounds
+): BusinessWebPageViewportBounds {
+  return active ? bounds : { x: 0, y: 0, width: 0, height: 0, visible: false };
+}
+
+export function bindViewportToInstance<TBounds>(
+  instanceId: string | null,
+  setBounds: (id: string, bounds: TBounds) => void | Promise<unknown>
+): (bounds: TBounds) => void | Promise<unknown> {
+  return (bounds) => instanceId ? setBounds(instanceId, bounds) : undefined;
+}
