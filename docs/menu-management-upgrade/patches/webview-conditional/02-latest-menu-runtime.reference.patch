+// visibleMenuNavigationRow is the least-privilege menu metadata needed to
+// render navigation. It deliberately excludes permission associations,
+// revision state and WebView configuration.
+type visibleMenuNavigationRow struct {
+	MenuKey        string   `json:"menuKey"`
+	NodeType       string   `json:"nodeType"`
+	Name           string   `json:"name"`
+	Icon           string   `json:"icon"`
+	ParentKey      *string  `json:"parentKey"`
+	SortOrder      int      `json:"sortOrder"`
+	WorkspaceTypes []string `json:"workspaceTypes"`
+	RouteKey       *string  `json:"routeKey,omitempty"`
+	RoutePath      *string  `json:"routePath,omitempty"`
+	PageType       string   `json:"pageType"`
+	Status         string   `json:"status"`
+}
+
+func visibleMenuKeys(ctx context.Context, st menuWebViewAccessStore, wc wsContext, directory string) ([]string, error) {
+	if directory == "workbench" {
+		return st.EffectiveWorkbenchMenuKeys(ctx, wc.UserID, wc.MembershipID, wc.WorkspaceType, wc.WorkspaceID)
+	}
+	_, _, keys, err := st.EffectiveManagementMenuKeys(ctx, wc.UserID, wc.MembershipID, wc.WorkspaceType, wc.WorkspaceID)
+	return keys, err
+}
+
+func projectVisibleMenuNavigation(rows []visibleMenuNavigationRow, allowedKeys []string, workspaceType string) ([]visibleMenuNavigationRow, []visibleMenuNavigationRow) {
+	byKey := make(map[string]visibleMenuNavigationRow, len(rows))
+	allowed := make(map[string]struct{}, len(allowedKeys))
+	for _, key := range allowedKeys {
+		allowed[key] = struct{}{}
+	}
+	for _, row := range rows {
+		byKey[row.MenuKey] = row
+	}
+	visible, ancestorRows := map[string]visibleMenuNavigationRow{}, map[string]visibleMenuNavigationRow{}
+	for _, row := range rows {
+		if row.NodeType != "leaf" || row.Status != "active" || !containsMenuWebViewKey(row.WorkspaceTypes, workspaceType) {
+			continue
+		}
+		if _, ok := allowed[row.MenuKey]; !ok {
+			continue
+		}
+		chain, parentsAvailable := visibleMenuAncestorChain(row, byKey, workspaceType)
+		for _, parent := range chain {
+			if containsMenuWebViewKey(parent.WorkspaceTypes, workspaceType) {
+				ancestorRows[parent.MenuKey] = parent
+			}
+		}
+		if parentsAvailable {
+			visible[row.MenuKey] = row
+		}
+	}
+	toSorted := func(source map[string]visibleMenuNavigationRow) []visibleMenuNavigationRow {
+		out := make([]visibleMenuNavigationRow, 0, len(source))
+		for _, row := range source {
+			out = append(out, row)
+		}
+		sort.Slice(out, func(i, j int) bool {
+			if out[i].SortOrder != out[j].SortOrder {
+				return out[i].SortOrder < out[j].SortOrder
+			}
+			return out[i].MenuKey < out[j].MenuKey
+		})
+		return out
+	}
+	return toSorted(visible), toSorted(ancestorRows)
+}
+
+func visibleMenuAncestorChain(leaf visibleMenuNavigationRow, byKey map[string]visibleMenuNavigationRow, workspaceType string) ([]visibleMenuNavigationRow, bool) {
+	chain := []visibleMenuNavigationRow{}
+	available := true
+	parentKey := leaf.ParentKey
+	seen := map[string]struct{}{}
+	for parentKey != nil && *parentKey != "" {
+		if _, cycle := seen[*parentKey]; cycle {
+			return chain, false
+		}
+		seen[*parentKey] = struct{}{}
+		parent, ok := byKey[*parentKey]
+		if !ok {
+			return chain, false
+		}
+		chain = append(chain, parent)
+		if parent.NodeType != "group" || parent.Status != "active" || !containsMenuWebViewKey(parent.WorkspaceTypes, workspaceType) {
+			available = false
+		}
+		parentKey = parent.ParentKey
+	}
+	return chain, available
 }
 
