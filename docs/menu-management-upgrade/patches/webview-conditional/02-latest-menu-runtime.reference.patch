+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+
+const styles = await readFile(new URL("./styles.css", import.meta.url), "utf8");
+const viewport = await readFile(new URL("./components/business-web-page-viewport.tsx", import.meta.url), "utf8");
+const mainBounds = await readFile(new URL("../../aicrm-desktop/src/main/ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+
+test("embedded menu WebView fills the bounded content track below the breadcrumb", () => {
+  assert.match(styles, /\.workspace-area-route-pane\s*\{\s*display:\s*contents;\s*\}/);
+  assert.match(styles, /\.workspace-area-route-pane\[hidden\]\s*\{\s*display:\s*none;\s*\}/);
+  assert.match(styles, /\.app-content:has\(> \.workspace-area-route-pane:not\(\[hidden\]\) \.menu-webview-page\)\s*\{[^}]*--menu-webview-content-inset:\s*12px;[^}]*display:\s*flex;[^}]*flex-direction:\s*column;[^}]*overflow-y:\s*hidden;[^}]*padding-left:\s*var\(--menu-webview-content-inset\);[^}]*padding-right:\s*var\(--menu-webview-content-inset\);[^}]*padding-bottom:\s*var\(--menu-webview-content-inset\);[^}]*scrollbar-gutter:\s*auto;/s);
+  assert.match(styles, /\.app-content:has\(> \.workspace-area-route-pane:not\(\[hidden\]\) \.menu-webview-page\) \.menu-webview-page\s*\{[^}]*flex:\s*1 1 0;[^}]*min-height:\s*0;/s);
+  assert.match(styles, /\.app-content:has\(> \.workspace-area-route-pane:not\(\[hidden\]\) \.menu-webview-page\) \.menu-webview-viewport\s*\{\s*min-height:\s*0;\s*\}/);
+});
+
+test("the measured viewport tracks host resizing and main-process clipping", () => {
+  assert.match(viewport, /new ResizeObserver\(update\)/);
+  assert.match(viewport, /resizeObserver\.observe\(element\)/);
+  assert.match(viewport, /window\.addEventListener\("resize", update\)/);
+  assert.match(viewport, /window\.addEventListener\("scroll", update, true\)/);
+  assert.match(viewport, /const rect = clippedViewportRect\(element\)/);
+  assert.match(viewport, /BusinessWebPageAreaVisibilityContext/);
+  assert.match(viewport, /useLayoutEffect\(\(\) => \{\s*if \(areaVisible \|\| !port\) return;[\s\S]*?setViewport\(boundsForWorkspaceArea\(false/s);
+  assert.match(viewport, /x: rect\.left,\s*y: rect\.top,\s*width: rect\.width,\s*height: rect\.height/s);
+  assert.match(mainBounds, /nativeViewportBounds\(input, instance\.ownerContents\.getZoomFactor\(\), contentBounds\.width, contentBounds\.height\)/);
+  assert.match(mainBounds, /const instance = menuInstance\(input\.instanceId\)/);
+  assert.match(mainBounds, /instance\.view\.setBounds\(\{ x: bounds\.x, y: bounds\.y, width: bounds\.width, height: bounds\.height \}\)/);
+  assert.match(mainBounds, /instance\.view\.setVisible\(bounds\.visible && !instance\.state\.error\)/);
+});
