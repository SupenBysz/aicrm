diff --git a/apps/ky-admin-host/src/components/business-web-page-presentation.ts b/apps/ky-admin-host/src/components/business-web-page-presentation.ts
new file mode 100644
index 000000000..a972bb101
--- /dev/null
+++ b/apps/ky-admin-host/src/components/business-web-page-presentation.ts
@@ -0,0 +1,35 @@
+import type { BusinessWebPageLifecycleState } from "./business-web-page-instance";
+
+export type BusinessWebPagePresentation =
+  | { kind: "initializing"; message: string }
+  | { kind: "loading"; message: string }
+  | { kind: "error"; message: string }
+  | { kind: "closed"; message: string }
+  | { kind: "ready"; message: "" };
+
+const PAGE_ERRORS: Record<string, string> = {
+  page_load_failed: "网页加载失败，请检查网络或页面地址后重试。",
+  page_load_timeout: "网页加载超时，页面仍未完成响应。请检查网络后重试。",
+  document_start_prepare_failed: "页面脚本准备失败，当前页面未能安全启动。请重试或联系管理员。",
+  webview_process_gone: "网页进程已退出，请重新打开页面。"
+};
+
+export function businessWebPagePresentation(input: {
+  instanceId: string | null;
+  error?: string;
+  closed: boolean;
+  state: Pick<BusinessWebPageLifecycleState, "loading" | "error"> | null;
+}): BusinessWebPagePresentation {
+  if (input.closed) return { kind: "closed", message: "页面已关闭，可重新打开。" };
+  if (input.error) return { kind: "error", message: input.error };
+  if (input.state?.error) return { kind: "error", message: PAGE_ERRORS[input.state.error] ?? "网页加载失败，请检查网络后重试。" };
+  if (!input.instanceId) return { kind: "initializing", message: "正在初始化页面视图…" };
+  if (!input.state || input.state.loading) return { kind: "loading", message: "正在加载网页…" };
+  return { kind: "ready", message: "" };
+}
+
+export function menuWebPageDisplayTitle(menuName: string | undefined, menuKey: string, pageTitle: string | undefined): string {
+  const name = menuName?.trim();
+  if (!pageTitle || pageTitle === menuKey || pageTitle === "菜单页面") return name || "菜单页面";
+  return pageTitle;
+}
