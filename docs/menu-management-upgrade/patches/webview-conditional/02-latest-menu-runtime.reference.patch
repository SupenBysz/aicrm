+      if (!domains.has(domain)) domains.set(domain, new Map());
+      const resources = domains.get(domain)!;
+      resources.set(permission.resource, [...(resources.get(permission.resource) ?? []), permission]);
+    }
+    return [...domains.entries()].sort(([a], [b]) => DOMAIN_ORDER.indexOf(a as typeof DOMAIN_ORDER[number]) - DOMAIN_ORDER.indexOf(b as typeof DOMAIN_ORDER[number]))
+      .map(([domain, resources]) => {
+        const children = [...resources.entries()].sort(([a], [b]) => (RESOURCE_LABELS[a] ?? a).localeCompare(RESOURCE_LABELS[b] ?? b, "zh"))
+          .map(([resource, items]) => {
+            const leaves = [...items].sort(permissionOrder).map((permission): DataNode => ({
+              key: permission.id,
+              title: permissionTitle(permission, allPermissions, permission.category === "menu" ? compactMenuPermissionName(permission.name) : undefined),
+              isLeaf: true
+            }));
+            for (const leaf of leaves) permissionNodeIds.set(String(leaf.key), String(leaf.key));
+            if (leaves.length === 1) return leaves[0];
+            const key = `permission-unlinked-resource:${domain}:${resource}`;
+            parentKeys.push(key);
+            return { key, title: withCount(RESOURCE_LABELS[resource] ?? "其他权限", leaves), selectable: false, checkable: true, children: leaves };
+          });
+        const key = `permission-unlinked-domain:${domain}`;
+        parentKeys.push(key);
+        return { key, title: withCount(DOMAIN_LABELS[domain as typeof DOMAIN_ORDER[number]], children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children };
+      });
+  };
+
+  if (workbenchTree.length) {
+    const key = "menu-directory:workbench";
+    parentKeys.push(key);
+    const children = [...categoryNodes(key, "工作台"), ...workbenchTree];
+    structure.push({ key, title: withCount("工作台", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  if (managementTree.length) {
+    const key = "menu-directory:management";
+    parentKeys.push(key);
+    const children = [...categoryNodes(key, "管理中心"), ...managementTree];
+    structure.push({ key, title: withCount("管理中心", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  if (unmatched.length) {
+    const key = "menu-directory:unlinked";
+    parentKeys.push(key);
+    const children = buildUnmatched();
+    structure.push({ key, title: withCount("公共能力", children), selectable: false, checkable: permissionLeafCount(children, permissionNodeIds) > 0, children });
+  }
+  const permissionIds = new Set(visible.map((permission) => permission.id));
+  return { treeData: structure, parentKeys, permissionIds, permissionNodeIds };
+}
+
+export function buildPermissionTreeData(
+  permissions: readonly PermissionLike[],
+  menus: MenuTreeSource = { workbench: [], management: [] },
+  category: string = "all"
+): { treeData: DataNode[]; parentKeys: string[]; permissionIds: Set<string>; permissionNodeIds: Map<string, string> } {
+  const normalizedCategory: PermissionCategory = category === "action" || category === "menu" || category === "page" ? category : "all";
+  return buildPermissionTree(permissions, menus, normalizedCategory);
+}
diff --git a/plugins/ky-access-management/src/role-permission-contract.test.mjs b/plugins/ky-access-management/src/role-permission-contract.test.mjs
