+        void blockedRedirectResponse.then(() => {
+          response.writeHead(302, { location: "https://blocked-menu-navigation.invalid/final" });
+          response.end();
+        });
+        return;
+      }
+      response.writeHead(200, { "content-type": "text/html" });
+      response.end("<!doctype html><h1>host-fixture</h1>");
+    });
+    const fixtureAddress = await listen(fixtureServer);
+    fixtureOrigin = `http://127.0.0.1:${fixtureAddress.port}`;
+    ordinaryPageUrl.current = `${fixtureOrigin}/strict-redirect`;
+
+    proxyServer = createServer((request, response) => {
+      proxyRequests.push({ url: request.url, userAgent: request.headers["user-agent"], acceptLanguage: request.headers["accept-language"] });
+      response.writeHead(200, { "content-type": "text/html; charset=utf-8" });
+      response.end("<!doctype html><html><body><h1>proxied-menu-page</h1><script>window.__KWW_PROXY_PAGE__=true</script></body></html>");
+    });
+    await listen(proxyServer);
+
+    const fetchImpl = makeFetchImpl();
+    registerMenuWebViewIpc({
+      loadSession: async () => ({ token: token.current }),
+      loadDesktopConfig: () => ({ apiBaseUrl: API_BASE, webUrl: "https://console.fixture.invalid", debugMode: true }),
+      fetchImpl
+    });
+    token.current = tokenFor("owner-a");
+    appWindow = await createOwner(fixtureOrigin, "a");
+    secondAppWindow = await createOwner(fixtureOrigin, "b");
+
+    const strict = await openEmbedded(appWindow, "menu.strict.redirect");
+    const pluginStorageRoot = join(temporaryUserData, "desktop-host-plugins", "web-window");
+    await waitFor(async () => (await stat(pluginStorageRoot)).isDirectory(), "fresh_plugin_storage_initialized");
+    await waitFor(() => new URL(strict.contents.getURL()).pathname === "/strict-final", "strict_url_only_redirect");
+    assert.equal(await strict.contents.executeJavaScript("document.querySelector('#strict-final')?.textContent"), "strict-redirect-loaded");
+    await strict.contents.executeJavaScript("location.href = 'https://blocked-menu-navigation.invalid/direct'");
+    await new Promise((resolve) => setTimeout(resolve, 250));
