+const managementMenuWebViewTargetsQuery = `SELECT m.workspace_types FROM ky_management_menu m WHERE m.menu_key=$1 AND COALESCE(m.page_type,'default')='webview' AND m.status IN ('active','disabled') AND NOT EXISTS (SELECT 1 FROM ky_management_menu child WHERE child.parent_key=m.menu_key AND child.status='active')`
+const workbenchMenuWebViewExistsQuery = `SELECT COALESCE(m.page_type,'default'),m.status,m.workspace_types,NOT EXISTS (SELECT 1 FROM ky_workbench_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_workbench_menu m WHERE m.menu_key=$1 FOR SHARE`
+const managementMenuWebViewExistsQuery = `SELECT COALESCE(m.page_type,'default'),m.status,m.workspace_types,NOT EXISTS (SELECT 1 FROM ky_management_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_management_menu m WHERE m.menu_key=$1 FOR SHARE`
+const workbenchMenuWebViewConfigLeafQuery = `SELECT COALESCE(m.page_type,'default')='webview' AND m.status IN ('active','disabled') AND m.workspace_types @> to_jsonb(ARRAY[$2::text]) AND NOT EXISTS (SELECT 1 FROM ky_workbench_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_workbench_menu m WHERE m.menu_key=$1`
