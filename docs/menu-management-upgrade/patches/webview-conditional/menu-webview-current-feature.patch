+  registerSender(view.webContents, "controlled", (url) => {
+    const pageUrl = normalizeNavigationUrl(url);
+    return pageUrl !== null && (new URL(pageUrl).origin === new URL(config.defaultUrl).origin || isAllowedByOriginPatterns(pageUrl, allowedOriginMatchers));
+  });
+  view.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+  view.webContents.on("will-attach-webview", (attachEvent) => attachEvent.preventDefault());
+  const prepareStrictNavigation = (navigationEvent: Electron.Event, url: string): void => {
+    // strict 预备只用于有真实运行时且目标可由 URL resolver 处理的 HTTP(S) 文档。
+    // URL-only 配置以及白名单允许的 blob/data 导航继续使用 Chromium 原生行为。
+    if (config.scheduleMode !== "strict_document_start" || !instance.runtime || !safePageUrl(url)) return;
+    const approved = instance.approvedStrictNavigations.has(url);
+    if (approved) { instance.approvedStrictNavigations.delete(url); return; }
+    navigationEvent.preventDefault();
+    if (instance.strictPreparationInFlight.has(url)) return;
+    instance.strictPreparationInFlight.add(url);
+    void instance.runtime.prepareDocumentStart(view.webContents, url).then((prepared) => {
+      if (!prepared || view.webContents.isDestroyed()) { reportState(instance, { error: "document_start_prepare_failed", loading: false }); return; }
+      instance.approvedStrictNavigations.add(url);
+      void view.webContents.loadURL(url).catch(() => reportState(instance, { error: "page_load_failed", loading: false }));
+    }).finally(() => instance.strictPreparationInFlight.delete(url));
+  };
+  const applyNavigationPolicy = (navigationEvent: Electron.Event, url: string, isRedirect: boolean): boolean => {
+    const action = classifyLoginSpaceUrl(url, normalizeLoginSpaceProtocolWhitelist(config.protocolWhitelist as Partial<MatrixAccountWebSpaceProtocolWhitelist>));
+    if (action === "blank") return true;
+    if (action === "external" && !isRedirect) {
+      navigationEvent.preventDefault();
+      void shell.openExternal(url).catch((error) => console.warn("菜单 WebView 外部协议打开失败", JSON.stringify({ scheme: getUrlScheme(url), error: error instanceof Error ? error.message : "unknown" })));
+      return false;
+    }
+    if (action !== "navigate") {
+      navigationEvent.preventDefault();
+      console.warn(isRedirect ? "菜单 WebView 已拦截不允许的重定向协议" : "菜单 WebView 已拦截未允许的链接协议", getUrlScheme(url) ?? "unknown");
+      return false;
+    }
+    return true;
+  };
+  view.webContents.on("will-navigate", (navigationEvent, url, _isInPlace, isMainFrame) => {
+    if (!isMainFrame) return;
+    if (!applyNavigationPolicy(navigationEvent, url, false)) return;
+    prepareStrictNavigation(navigationEvent, url);
+  });
+  view.webContents.on("will-redirect", (navigationEvent, url, _isInPlace, isMainFrame) => {
+    if (!isMainFrame) return;
+    if (!applyNavigationPolicy(navigationEvent, url, true)) return;
+    prepareStrictNavigation(navigationEvent, url);
+  });
+  view.webContents.on("did-start-loading", () => reportState(instance, { loading: true, error: undefined, url: safeStateUrl(instance) }));
+  view.webContents.on("did-stop-loading", () => reportState(instance, { loading: false, url: safeStateUrl(instance), canGoBack: view.webContents.canGoBack(), canGoForward: view.webContents.canGoForward() }));
+  view.webContents.on("did-start-navigation", (_event, _url, isInPlace, isMainFrame) => {
+    if (!isMainFrame || isInPlace) return;
+    instance.navigationGeneration += 1;
+    resetInjectionForNavigation(instance);
+    publishPluginContext(instance);
+  });
+  view.webContents.on("page-title-updated", (_event, title) => reportState(instance, { title: title.slice(0, 240) || input.menuKey }));
+  view.webContents.on("did-navigate", (_event, url) => {
+    reportState(instance, { url: safeUrlProjection(url), canGoBack: view.webContents.canGoBack(), canGoForward: view.webContents.canGoForward(), error: undefined });
+    publishPluginContext(instance);
+  });
+  view.webContents.on("did-navigate-in-page", (_event, url) => {
+    reportState(instance, { url: safeUrlProjection(url), canGoBack: view.webContents.canGoBack(), canGoForward: view.webContents.canGoForward() });
+    publishPluginContext(instance);
+  });
+  view.webContents.on("did-fail-load", (_event, errorCode, _description, _validatedUrl, isMainFrame) => { if (isMainFrame && errorCode !== -3) reportState(instance, { loading: false, error: "page_load_failed" }); });
+  view.webContents.on("render-process-gone", () => reportState(instance, { loading: false, error: "webview_process_gone" }));
+  const onDownload = (downloadEvent: Electron.Event, _item: Electron.DownloadItem, contents: Electron.WebContents) => { if (contents === view.webContents) downloadEvent.preventDefault(); };
+  targetSession.on("will-download", onDownload);
+  view.webContents.once("destroyed", () => {
+    targetSession.removeListener("will-download", onDownload);
+    if (instances.has(id)) closeInstance(id);
+  });
+  owner.once("closed", () => closeInstance(id));
+  attachRuntime(instance);
+  void webWindowPluginHost.startEmbedded(owner, view.webContents, pluginContextFor(instance)).catch((error) => {
+    console.error("菜单 WebView 插件宿主启动失败", error instanceof Error ? error.message : "unknown");
+  });
+  if (config.scheduleMode === "strict_document_start" && instance.runtime) {
+    const prepared = await instance.runtime.prepareDocumentStart(view.webContents, config.defaultUrl).catch(() => false);
+    if (!prepared) { closeInstance(id); return fail("document_start_prepare_failed", "严格 document_start 模式无法准备脚本，页面未打开"); }
+    instance.approvedStrictNavigations.add(config.defaultUrl);
+  }
+  void view.webContents.loadURL(config.defaultUrl).catch(() => reportState(instance, { loading: false, error: "page_load_failed" }));
+  return ok({ instanceId: id, opened: true, openMode: "embedded", closeBehavior: config.closeBehavior });
+}
+
+function publicResolveMessage(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  if (message === "desktop_session_unavailable") return "桌面登录会话已失效，请重新登录。";
+  if (message === "https_required" || message === "api_url_invalid") return "服务端连接配置不安全，页面未打开。";
+  if (/^menu_runtime_http_/.test(message)) return "菜单权限、店铺登录空间或服务端配置校验失败，页面未打开。";
+  return "菜单页面解析失败，请检查菜单、店铺和登录空间配置。";
+}
+
+function validBounds(input: MenuWebViewBoundsInput): boolean {
+  return Boolean(input && instanceIdPattern.test(input.instanceId) && [input.x, input.y, input.width, input.height].every((value) => Number.isFinite(value) && value >= 0 && value <= 12000) && typeof input.visible === "boolean");
+}
+
+const menuWebViewIpc = scopedIpc(["main"], (args) => args.length <= 1 && Buffer.byteLength(JSON.stringify(args)) <= 1024 * 1024);
+
+export function registerMenuWebViewIpc(overrides: Partial<MenuWebViewIpcDependencies> = {}): void {
+  const dependencies: MenuWebViewIpcDependencies = { loadSession, loadDesktopConfig, fetchImpl: fetch, ...overrides };
+  menuWebViewIpc.handle(IPC_CHANNELS.menuWebViewOpen, (event, input: MenuWebViewOpenInput) => openMenu(event, input, dependencies));
+  menuWebViewIpc.handle(IPC_CHANNELS.menuWebViewSetBounds, (event, input: MenuWebViewBoundsInput) => {
+    if (!validBounds(input)) return fail("validation_error", "菜单 WebView 区域无效");
+    const instance = instances.get(input.instanceId);
+    if (!instance || instance.view.webContents.isDestroyed()) return fail("menu_webview_not_found", "菜单 WebView 已关闭");
+    if (instance.ownerContents !== event.sender) return fail("permission_denied", "无权控制此菜单 WebView");
+    instance.bounds = input;
+    instance.view.setBounds({ x: Math.round(input.x), y: Math.round(input.y), width: Math.round(input.width), height: Math.round(input.height) });
+    instance.view.setVisible(input.visible && !instance.state.error);
+    return ok({ updated: true });
+  });
+  menuWebViewIpc.handle(IPC_CHANNELS.menuWebViewNavigate, (event, input: MenuWebViewNavigationInput) => {
+    if (!input || !instanceIdPattern.test(input.instanceId) || !["back", "forward", "reload", "home"].includes(input.command)) return fail("validation_error", "菜单 WebView 导航参数无效");
+    const instance = instances.get(input.instanceId);
+    if (!instance || instance.view.webContents.isDestroyed()) return fail("menu_webview_not_found", "菜单 WebView 已关闭");
+    if (instance.ownerContents !== event.sender) return fail("permission_denied", "无权控制此菜单 WebView");
+    const contents = instance.view.webContents;
+    if (input.command === "back" && contents.canGoBack()) contents.goBack();
+    else if (input.command === "forward" && contents.canGoForward()) contents.goForward();
+    else if (input.command === "reload") contents.reload();
+    else if (input.command === "home") void contents.loadURL(instance.runtimeConfig.defaultUrl);
+    return ok({ navigated: true });
+  });
+  menuWebViewIpc.handle(IPC_CHANNELS.menuWebViewClose, (event, input: MenuWebViewCloseInput) => {
+    if (!input || !instanceIdPattern.test(input.instanceId)) return fail("validation_error", "菜单 WebView 标识无效");
+    const instance = instances.get(input.instanceId);
+    if (instance && instance.ownerContents !== event.sender) return fail("permission_denied", "无权关闭此菜单 WebView");
+    return ok({ closed: closeInstance(input.instanceId) });
+  });
+}
