+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, readFile, rm } from "node:fs/promises";
+import { dirname, join, resolve } from "node:path";
+import { tmpdir } from "node:os";
+import { spawn } from "node:child_process";
+import { createRequire } from "node:module";
+import { build } from "esbuild";
+
+const packageRoot = process.cwd();
+const preloadPaths = ["out/preload/web-window.js", "out/preload/web-window-plugin.js"];
+const outputPath = resolve(packageRoot, "out/main/menu-webview-runtime.electron.test.cjs");
+const entryPath = resolve(packageRoot, "src/main/menu-webview-runtime.electron.test.mjs");
+const require = createRequire(import.meta.url);
+
+try {
+  await Promise.all(preloadPaths.map((path) => readFile(resolve(packageRoot, path))));
+} catch {
+  throw new Error("Electron harness 需要先运行 `corepack pnpm --filter @ky/aicrm-desktop build` 生成真实 preload。");
+}
+
+await mkdir(dirname(outputPath), { recursive: true });
+await build({
+  entryPoints: [entryPath],
+  outfile: outputPath,
+  bundle: true,
+  platform: "node",
+  format: "cjs",
+  target: "node22",
+  external: ["electron"],
+  sourcemap: "inline",
+  plugins: [{
+    name: "raw-source-imports",
+    setup(buildContext) {
+      // esbuild separates the import query into `suffix`; `path` is the actual
+      // plugin.js path, so matching `?raw` against path silently misses it.
+      buildContext.onLoad({ filter: /plugin\.js$/ }, async (args) => {
+        if (args.suffix !== "?raw") return;
+        const contents = await readFile(args.path, "utf8");
+        return { contents: `module.exports = ${JSON.stringify(contents)};`, loader: "js" };
+      });
+    }
+  }]
+});
+
+if (process.env.KWW_MENU_WEBVIEW_HARNESS_BUILD_ONLY === "1") {
+  console.log(`Electron runtime harness bundled: ${outputPath}`);
+  process.exit(0);
+}
+
+const electronBinary = require("electron");
+if (typeof electronBinary !== "string" || electronBinary.length === 0) {
+  throw new Error("Electron package did not resolve to its executable binary");
+}
+const temporaryUserData = await mkdtemp(join(tmpdir(), "kww-menu-webview-runtime-runner-"));
+let child;
+let timedOut = false;
+let stdout = "";
+let stderr = "";
+let timeoutHandle;
+let forceKillHandle;
+
+try {
+  const result = await new Promise((resolveResult, rejectResult) => {
+    // Spawn Electron itself so the timeout owns the actual GUI process instead
+    // of a Node CLI parent that may leave a native Electron child behind.
+    child = spawn(electronBinary, [outputPath], {
+      cwd: packageRoot,
+      env: {
+        ...process.env,
+        KWW_WEB_WINDOW_PLUGIN_REMOTE_DISABLED: "1",
+        KWW_MENU_WEBVIEW_HARNESS_USER_DATA: temporaryUserData
+      },
+      stdio: ["ignore", "pipe", "pipe"]
+    });
+    child.stdout.setEncoding("utf8");
+    child.stderr.setEncoding("utf8");
+    child.stdout.on("data", (chunk) => {
+      stdout += chunk;
+      process.stdout.write(chunk);
+    });
+    child.stderr.on("data", (chunk) => {
+      stderr += chunk;
+      process.stderr.write(chunk);
+    });
+    child.once("error", rejectResult);
+    child.once("close", (code, signal) => resolveResult({ code, signal }));
+    timeoutHandle = setTimeout(() => {
+      timedOut = true;
+      child.kill("SIGTERM");
+      forceKillHandle = setTimeout(() => child.kill("SIGKILL"), 2000);
+    }, 60_000);
+  });
+
+  if (timedOut) throw new Error("Electron harness exceeded the 60-second timeout");
+  if (result.signal) throw new Error(`Electron harness interrupted by ${result.signal}`);
+  assert.equal(result.code, 0, `Electron harness exited with status ${result.code}`);
+  const successMarker = stdout.split(/\r?\n/).some((line) => {
+    try {
+      const value = JSON.parse(line);
+      return value.harness === "menu-webview-runtime-electron" && value.realWebContentsView === true && value.scriptRuntimeInjection === true;
+    } catch { return false; }
+  });
+  assert.ok(successMarker, "Electron harness exited 0 without its success marker");
+} finally {
+  clearTimeout(timeoutHandle);
+  clearTimeout(forceKillHandle);
+  await rm(temporaryUserData, { recursive: true, force: true });
+}
