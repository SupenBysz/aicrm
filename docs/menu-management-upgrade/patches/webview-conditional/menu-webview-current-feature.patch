+	mux.HandleFunc("GET /api/v1/menu-pages/{directoryType}/{menuKey}/webview/{workspaceType}/{workspaceId}", s.ws("platform", []string{"platform.workbench_menus.view"}, s.getMenuWebViewConfig))
+	mux.HandleFunc("GET /api/v1/menu-pages/{directoryType}/{menuKey}/webview-visibility", s.ws("platform,agency,enterprise", nil, s.getMenuWebViewVisibility))
+	mux.HandleFunc("GET /api/v1/menu-pages/{directoryType}/{menuKey}/webview/{workspaceType}/{workspaceId}/shops", s.ws("platform", []string{"platform.workbench_menus.view"}, s.getMenuWebViewShops))
+	mux.HandleFunc("PUT /api/v1/menu-pages/{directoryType}/{menuKey}/webview/{workspaceType}/{workspaceId}", s.wsWithDeniedAudit("platform", []string{"platform.workbench_menus.update"}, "menu_webview.updated", s.putMenuWebViewConfig))
