+
+function tokenFor(subject) {
+  return `header.${Buffer.from(JSON.stringify({ sub: subject })).toString("base64url")}.signature`;
+}
+
+function jsonResponse(data, status = 200) {
+  return new Response(JSON.stringify({ data }), { status, headers: { "content-type": "application/json" } });
+}
+
+function configFor(menuKey) {
+  const common = {
+    menuKey,
+    directoryType: "workbench",
+    platform: "douyin",
+    scheduleMode: "strict_document_start",
+    pageConfig: {
+      defaultUrl: menuKey === "menu.strict.block-redirect" ? `${fixtureOrigin}/redirect-to-https` : ordinaryPageUrl.current,
+      scheduleMode: "strict_document_start",
+      scripts: [],
+      styles: [],
+      closeBehavior: "close",
+      showWebViewDevTools: false
+    },
+    runtimeConfig: {
+      userAgentProfile: { userAgent: "KWW-Menu-Harness/1.0", acceptLanguage: "zh-CN,zh;q=0.9" },
+      protocolWhitelist: { navigation: ["http"], webSocket: ["ws"], external: [] },
+      proxy: { mode: "direct" }
+    },
+    proxy: { mode: "direct" }
+  };
+  if (menuKey === "menu.window.proxy") {
+    const address = proxyServer.address();
+    return {
+      ...common,
+      sessionSource: "store",
+      openMode: "window",
+      storeId: "33333333-3333-4333-8333-333333333333",
+      uuid: uuidA,
+      webSpaceId: "space-alpha",
+      shopPlatform: "douyin_shop",
+      shopAccount: "",
+      runtimeConfig: {
+        ...common.runtimeConfig,
+        proxy: { mode: "fixed", protocol: "http", host: "127.0.0.1", port: address.port, bypassRules: [] }
+      },
+      proxy: { mode: "fixed", protocol: "http", host: "127.0.0.1", port: address.port, bypassRules: [] },
+      pageConfig: {
+        ...common.pageConfig,
+        defaultUrl: "http://menu-proxy-fixture.test/injected",
+        scripts: [{ identifier: "HARNESS_SCRIPT", versionPolicy: "latest_released", runAt: "document_start", priority: 1 }]
+      }
+    };
+  }
+  if (menuKey === "menu.window.proxy.second") {
+    const address = proxyServer.address();
+    return {
+      ...common,
+      sessionSource: "store",
+      openMode: "window",
+      storeId: "33333333-3333-4333-8333-333333333333",
+      uuid: uuidB,
+      webSpaceId: "space-beta",
+      shopPlatform: "douyin_shop",
+      runtimeConfig: {
+        ...common.runtimeConfig,
+        proxy: { mode: "fixed", protocol: "http", host: "127.0.0.1", port: address.port, bypassRules: [] }
+      },
+      proxy: { mode: "fixed", protocol: "http", host: "127.0.0.1", port: address.port, bypassRules: [] },
+      pageConfig: { ...common.pageConfig, defaultUrl: "http://menu-proxy-fixture.test/plain" }
+    };
+  }
+  if (menuKey === "menu.ordinary.window") {
+    return { ...common, sessionSource: "ordinary", openMode: "window", pageConfig: { ...common.pageConfig, scheduleMode: "page_first" } };
+  }
+  if (menuKey === "menu.ordinary.shared") {
+    return {
+      ...common,
+      sessionSource: "ordinary",
+      openMode: "embedded",
+      pageConfig: {
+        ...common.pageConfig,
+        scheduleMode: "page_first",
+        scripts: [{ identifier: "HARNESS_SCRIPT", versionPolicy: "latest_released", runAt: "document_idle", priority: 1 }],
+        styles: [{ identifier: "HARNESS_STYLE", versionPolicy: "latest_released", runAt: "document_idle", priority: 1 }]
+      }
+    };
+  }
+  // 无资源的 strict 页面专门验证合法 HTTP 重定向仍由 Chromium 完成。
+  return { ...common, sessionSource: "ordinary", openMode: "embedded" };
+}
+
+function makeFetchImpl() {
+  return async (input, init = {}) => {
+    const url = new URL(typeof input === "string" ? input : input.url);
+    if (url.pathname.includes("/menu-pages/")) {
+      const parts = url.pathname.split("/").filter(Boolean);
+      const menuKey = decodeURIComponent(parts.at(-2));
+      return jsonResponse(configFor(menuKey));
+    }
+    if (url.pathname === "/api/v1/script-runtime/manifest") {
+      return jsonResponse({ schemaVersion: 1, ...WORKSPACE, platform: "douyin", manifestRevision: "harness-manifest-1", assets: [], public: [], publicStyles: [] });
+    }
+    if (url.pathname === "/api/v1/script-runtime/resolve") {
+      const body = JSON.parse(init.body ?? "{}");
+      const assets = [];
+      if ((body.scriptSelectors ?? []).some((selector) => selector.identifier === "HARNESS_SCRIPT")) {
+        assets.push({
+          assetType: "script", platform: "douyin", identifier: "HARNESS_SCRIPT", version: "1.0.0",
+          effectiveVersionId: "harness-script-version-1", runAt: "document_idle", priority: 1, enabled: true,
+          source, sourceSha256, matchRules: [], matchConfiguredUrlRules: false
+        });
+      }
+      if ((body.styleSelectors ?? []).some((selector) => selector.identifier === "HARNESS_STYLE")) {
+        assets.push({
+          assetType: "style", platform: "douyin", identifier: "HARNESS_STYLE", version: "1.0.0",
+          effectiveVersionId: "harness-style-version-1", runAt: "document_idle", priority: 1, enabled: true,
+          source: styleSource, sourceSha256: styleSourceSha256, matchRules: [], matchConfiguredUrlRules: false
+        });
+      }
+      return jsonResponse({ assets, public: [], publicStyles: [] });
+    }
+    throw new Error(`unexpected_runtime_api:${url.pathname}:${init.method ?? "GET"}`);
+  };
+}
+
+async function listen(server) {
+  await new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  return server.address();
+}
+
+function waitFor(predicate, label, timeoutMs = 8000) {
+  return new Promise((resolve, reject) => {
+    const deadline = Date.now() + timeoutMs;
+    const check = async () => {
+      let value;
+      try { value = await predicate(); } catch { value = false; }
+      if (value) return resolve(value);
+      if (Date.now() >= deadline) return reject(new Error(`wait_timeout:${label}`));
+      setTimeout(check, 25);
+    };
+    check();
+  });
+}
+
+async function invoke(owner, channel, input) {
+  return owner.webContents.executeJavaScript(
+    `require("electron").ipcRenderer.invoke(${JSON.stringify(channel)}, ${JSON.stringify(input)})`,
+    true
+  );
+}
+
+async function createOwner(origin, roleName) {
+  const window = new BrowserWindow({
+    show: false,
+    webPreferences: { nodeIntegration: true, contextIsolation: false, sandbox: false }
+  });
+  registerSender(window.webContents, "main", (url) => {
+    try { return new URL(url).origin === origin; } catch { return false; }
+  });
+  await window.loadURL(`${origin}/host?owner=${roleName}`);
+  return window;
+}
+
+function openInput(menuKey, workspace = WORKSPACE) {
+  return { directoryType: "workbench", menuKey, ...workspace };
+}
+
+function nestedResult(result) {
+  assert.equal(result?.ok, true, "main-role IPC envelope should accept the registered sender");
+  assert.ok(result.data && typeof result.data === "object");
+  return result.data;
+}
+
+function embeddedView(owner) {
+  return owner.contentView.children.find((child) => child instanceof WebContentsView);
+}
+
+async function openEmbedded(owner, menuKey, workspace = WORKSPACE) {
+  const result = nestedResult(await invoke(owner, IPC_CHANNELS.menuWebViewOpen, openInput(menuKey, workspace)));
+  assert.equal(result.ok, true, JSON.stringify(result.error));
+  const view = await waitFor(() => embeddedView(owner), "embedded_view_created");
+  // WebContentsView.webContents can become unavailable after destruction.
+  // Keep the original object so final lifecycle assertions remain observable.
+  return { instanceId: result.data.instanceId, view, contents: view.webContents };
+}
+
+async function run() {
+  try {
+    await app.whenReady();
+    temporaryUserData = process.env.KWW_MENU_WEBVIEW_HARNESS_USER_DATA
+      ?? await mkdtemp(join(tmpdir(), "kww-menu-webview-runtime-"));
+    app.setPath("userData", temporaryUserData);
+    fixtureServer = createServer((request, response) => {
+      const path = new URL(request.url ?? "/", "http://127.0.0.1").pathname;
+      if (path === "/strict-redirect") {
+        response.writeHead(302, { location: "/strict-final" });
+        response.end();
+        return;
+      }
+      if (path === "/strict-final") {
+        response.writeHead(200, { "content-type": "text/html" });
