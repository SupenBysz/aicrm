+func (s *Server) listVisibleMenuWebViews(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	w.Header().Set("Cache-Control", "no-store")
+	dir := r.PathValue("directoryType")
+	if dir != "workbench" && dir != "management" {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "菜单目录类型无效")
+		return
+	}
+	items := []any{}
+	if dir == "workbench" {
+		menus, err := s.store.ListWorkbenchMenus(r.Context(), "")
+		if err != nil {
+			writeWorkbenchStoreError(w, r, err)
+			return
+		}
+		for _, menu := range menus {
+			if menu.PageType != "webview" || menu.Status != "active" || !containsMenuWebViewKey(menu.WorkspaceTypes, wc.WorkspaceType) {
+				continue
+			}
+			allowed, err := effectiveMenuWebViewAccess(r.Context(), s.store, wc.UserID, wc.MembershipID, wc.WorkspaceType, wc.WorkspaceID, dir, menu.MenuKey)
+			if err != nil {
+				writeError(w, r, http.StatusServiceUnavailable, "authorization_unavailable", "菜单授权暂不可用")
+				return
+			}
+			if !allowed {
+				continue
+			}
+			config, err := s.store.GetMenuWebViewConfig(r.Context(), dir, menu.MenuKey, wc.WorkspaceType, wc.WorkspaceID)
+			if err != nil {
+				menu.UsageScope, menu.UsageReasons = "client_only", []string{"configuration_unavailable"}
+			} else {
+				menu.UsageScope, menu.UsageReasons = config.UsageScope, config.UsageReasons
+			}
+			items = append(items, menu)
+		}
+	} else {
+		menus, err := s.store.ListManagementMenus(r.Context())
+		if err != nil {
+			writeManagementMenuStoreError(w, r, err)
+			return
+		}
+		for _, menu := range menus {
+			if menu.PageType != "webview" || menu.Status != "active" || !containsMenuWebViewKey(menu.WorkspaceTypes, wc.WorkspaceType) {
+				continue
+			}
+			allowed, err := effectiveMenuWebViewAccess(r.Context(), s.store, wc.UserID, wc.MembershipID, wc.WorkspaceType, wc.WorkspaceID, dir, menu.MenuKey)
+			if err != nil {
+				writeError(w, r, http.StatusServiceUnavailable, "authorization_unavailable", "菜单授权暂不可用")
+				return
+			}
+			if !allowed {
+				continue
+			}
+			config, err := s.store.GetMenuWebViewConfig(r.Context(), dir, menu.MenuKey, wc.WorkspaceType, wc.WorkspaceID)
+			if err != nil {
+				menu.UsageScope, menu.UsageReasons = "client_only", []string{"configuration_unavailable"}
+			} else {
+				menu.UsageScope, menu.UsageReasons = config.UsageScope, config.UsageReasons
+			}
+			items = append(items, menu)
+		}
+	}
+	writeData(w, r, map[string]any{"items": items})
+}
