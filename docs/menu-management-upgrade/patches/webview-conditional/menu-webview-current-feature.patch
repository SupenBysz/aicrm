+// getMenuWebViewVisibility is a minimal browser-safe projection. It never
+// returns UUID identity, proxy settings, resource source, or configuration data.
+func (s *Server) getMenuWebViewVisibility(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	w.Header().Set("Cache-Control", "no-store")
+	dir, key, ok := menuWebViewDirectoryTarget(r)
+	if !ok {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "菜单页面参数无效")
+		return
+	}
+	allowed, err := effectiveMenuWebViewAccess(r.Context(), s.store, wc.UserID, wc.MembershipID, wc.WorkspaceType, wc.WorkspaceID, dir, key)
+	if err != nil {
+		writeError(w, r, http.StatusServiceUnavailable, "authorization_unavailable", "菜单授权暂不可用")
+		return
+	}
+	if !allowed {
+		writeError(w, r, http.StatusNotFound, "not_found", "菜单页面不存在或不可访问")
+		return
+	}
+	active, activeErr := s.store.MenuWebViewRuntimeEnabled(r.Context(), dir, key, wc.WorkspaceType, wc.WorkspaceID)
+	if activeErr != nil {
+		writeError(w, r, http.StatusServiceUnavailable, "menu_state_unavailable", "菜单状态暂不可用")
+		return
+	}
+	if !active {
+		writeError(w, r, http.StatusNotFound, "not_found", "菜单页面不存在或不可访问")
+		return
+	}
+	config, err := s.store.GetMenuWebViewConfig(r.Context(), dir, key, wc.WorkspaceType, wc.WorkspaceID)
+	if err != nil {
+		writeMenuWebViewError(w, r, err)
+		return
+	}
+	allowedInBrowser := config.UsageScope == "browser_and_client" && config.SessionSource == "ordinary"
+	projection := map[string]any{
+		"directoryType": dir, "menuKey": key, "workspaceType": wc.WorkspaceType, "workspaceId": wc.WorkspaceID,
+		"allowed": true, "browserAllowed": allowedInBrowser, "usageScope": config.UsageScope,
+		"usageReasons": config.UsageReasons, "openMode": config.OpenMode,
+	}
+	if allowedInBrowser {
+		projection["url"] = config.DefaultURL
+	}
+	writeData(w, r, projection)
+}
