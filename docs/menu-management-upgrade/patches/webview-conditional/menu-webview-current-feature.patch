+    const blockedRedirect = await openEmbedded(secondAppWindow, "menu.strict.block-redirect");
+    await blockedRedirectRequest;
+    const redirectEvent = new Promise((resolve) => {
+      blockedRedirect.contents.once("will-redirect", (event, url) => resolve({ event, url }));
+    });
+    releaseBlockedRedirectResponse();
+    const blockedAttempt = await redirectEvent;
+    assert.match(blockedAttempt.url, /^https:\/\/blocked-menu-navigation\.invalid\//);
