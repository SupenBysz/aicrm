+func TestWorkbenchMenuErrorsDoNotMisreportDatabaseConstraintAsStaleConflict(t *testing.T) {
+	tests := []struct {
+		name       string
+		err        error
+		wantStatus int
+		wantCode   string
+		wantText   string
+	}{
+		{"duplicate key", store.ErrWorkbenchMenuExists, http.StatusConflict, "menu_already_exists", "已被占用"},
+		{"database constraint", store.ErrWorkbenchMenuConstraint, http.StatusUnprocessableEntity, "menu_constraint_violation", "不兼容"},
+		{"stale revision", store.ErrConflict, http.StatusConflict, "conflict", "并发冲突"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodPost, "/api/v1/workbench-menus", nil)
+			rec := httptest.NewRecorder()
+			writeWorkbenchStoreError(rec, req, tc.err)
+			if rec.Code != tc.wantStatus {
+				t.Fatalf("status=%d want %d", rec.Code, tc.wantStatus)
+			}
+			var envelope struct {
+				Error struct {
+					Code    string `json:"code"`
+					Message string `json:"message"`
+				} `json:"error"`
+			}
+			if err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {
+				t.Fatal(err)
+			}
+			if envelope.Error.Code != tc.wantCode || !strings.Contains(envelope.Error.Message, tc.wantText) {
+				t.Fatalf("error=%+v", envelope.Error)
+			}
+		})
+	}
+}
