+-- 菜单普通会话代理设置只保存非敏感投影；认证信息保存在店铺服务加密 envelope。
+-- 幂等迁移。回滚前备份菜单配置并清除所有代理引用；不得把 credentials 写回配置表。
+DO $$ BEGIN
+  IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF;
+END $$;
+
+ALTER TABLE ky_menu_webview_config
+  ADD COLUMN IF NOT EXISTS proxy jsonb NOT NULL DEFAULT '{"mode":"direct","bypassRules":[]}'::jsonb;
+
+DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='ky_menu_webview_config'::regclass AND conname='ky_menu_webview_proxy_shape_ck') THEN
+    ALTER TABLE ky_menu_webview_config ADD CONSTRAINT ky_menu_webview_proxy_shape_ck CHECK (
+      jsonb_typeof(proxy)='object'
+      AND proxy->>'mode' IN ('direct','system','fixed')
+      AND NOT (proxy ? 'username') AND NOT (proxy ? 'password')
+      AND jsonb_typeof(COALESCE(proxy->'bypassRules','[]'::jsonb))='array'
+      AND (proxy->>'mode'<>'fixed' OR (proxy->>'protocol' IN ('http','https','socks5') AND char_length(COALESCE(proxy->>'host','')) BETWEEN 1 AND 253 AND (proxy->>'port')::integer BETWEEN 1 AND 65535))
+    );
+  END IF;
+END $$;
+
+-- 回滚：确认未启用依赖菜单代理后备份配置，再删除约束与 proxy 列。加密凭据表由 shop 服务单独管理。
