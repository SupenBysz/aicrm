+func TestMenuWebViewConcurrentRevisionCASStagesOnlyWinner(t *testing.T) {
+	dsn := os.Getenv("KWW_MENU_WEBVIEW_PROXY_TEST_DSN")
+	if dsn == "" {
+		t.Skip("set KWW_MENU_WEBVIEW_PROXY_TEST_DSN to an isolated PostgreSQL database")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	s, err := Open(ctx, dsn)
+	if err != nil {
+		t.Fatal("open isolated database:", err)
+	}
+	defer s.Close()
+
+	menuKey := "menu.workbench.revision_cas_" + strings.ReplaceAll(time.Now().UTC().Format("150405.000000000"), ".", "")
+	const workspaceType, workspaceID = "platform", "platform_root"
+	if _, err := s.db.ExecContext(ctx, `INSERT INTO ky_workbench_menu(menu_key,page_type,status,workspace_types,parent_key) VALUES($1,'webview','active','["platform"]'::jsonb,NULL)`, menuKey); err != nil {
+		t.Fatal("seed synthetic menu:", err)
+	}
+	defer func() {
+		_, _ = s.db.ExecContext(context.Background(), `DELETE FROM ky_menu_webview_config WHERE directory_type='workbench' AND menu_key=$1 AND workspace_type=$2 AND workspace_id=$3`, menuKey, workspaceType, workspaceID)
+		_, _ = s.db.ExecContext(context.Background(), `DELETE FROM ky_shop_management.ky_menu_webview_proxy_secret_version WHERE directory_type='workbench' AND menu_key=$1 AND workspace_type=$2 AND workspace_id=$3`, menuKey, workspaceType, workspaceID)
+		_, _ = s.db.ExecContext(context.Background(), `DELETE FROM ky_workbench_menu WHERE menu_key=$1`, menuKey)
+	}()
+
+	zero := int64(0)
+	base := MenuWebViewConfigInput{SessionSource: "ordinary", OpenMode: "embedded", DefaultURL: "https://revision-fixture.invalid/", ScheduleMode: "page_first", Scripts: []MenuWebViewBinding{}, Styles: []MenuWebViewBinding{}, ProtocolWhitelist: MenuWebViewProtocolWhitelist{Navigation: []string{"http", "https", "blob", "data"}, WebSocket: []string{"ws", "wss"}, External: []string{"mailto"}}, Proxy: MenuWebViewProxyInput{MenuWebViewProxy: MenuWebViewProxy{Mode: "direct", BypassRules: []string{}}}, CloseBehavior: "close_view", ExpectedRevision: &zero}
+	created, err := s.PutMenuWebViewConfig(ctx, "workbench", menuKey, workspaceType, workspaceID, "synthetic-user", base)
+	if err != nil || created.Revision != 1 {
+		t.Fatalf("seed config revision=%d err=%v", created.Revision, err)
+	}
+
+	one := int64(1)
+	var callbacks atomic.Int32
+	versionID := "123e4567-e89b-42d3-a456-426614174000"
+	var wg sync.WaitGroup
+	type result struct{ err error }
+	results := make(chan result, 2)
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			input := base
+			input.ExpectedRevision = &one
+			_, putErr := s.PutMenuWebViewConfigWithBeforeCommit(ctx, "workbench", menuKey, workspaceType, workspaceID, "synthetic-user", input, func(string) (string, error) {
+				callbacks.Add(1)
+				_, stageErr := s.db.ExecContext(ctx, `INSERT INTO ky_shop_management.ky_menu_webview_proxy_secret_version(secret_version_id,directory_type,menu_key,workspace_type,workspace_id) VALUES($1::uuid,'workbench',$2,$3,$4)`, versionID, menuKey, workspaceType, workspaceID)
+				return versionID, stageErr
+			})
+			results <- result{err: putErr}
+		}()
+	}
+	wg.Wait()
+	close(results)
+	successes, conflicts := 0, 0
+	for value := range results {
+		switch {
+		case value.err == nil:
+			successes++
+		case errors.Is(value.err, ErrConflict):
+			conflicts++
+		default:
+			t.Fatalf("unexpected concurrent update error: %v", value.err)
+		}
+	}
+	if successes != 1 || conflicts != 1 || callbacks.Load() != 1 {
+		t.Fatalf("CAS results success=%d conflicts=%d stageCallbacks=%d; want 1/1/1", successes, conflicts, callbacks.Load())
+	}
+	current, err := s.GetMenuWebViewConfig(ctx, "workbench", menuKey, workspaceType, workspaceID)
+	if err != nil || current.Revision != 2 || current.ProxySecretVersionID != versionID {
+		t.Fatalf("committed CAS revision=%d proxyRefPresent=%v err=%v", current.Revision, current.ProxySecretVersionID != "", err)
+	}
+
+	// Simulate a successful Shop-side immutable stage followed by a deferred
+	// Membership commit failure. The failed CAS/write must not replace the old
+	// pointer; the new staged row may remain orphaned and is safe to GC later.
+	newVersion := "123e4567-e89b-42d3-a456-426614174001"
+	functionName := fmt.Sprintf("menu_revision_fail_%d", time.Now().UnixNano())
+	triggerName := functionName + "_trigger"
+	triggerSQL := fmt.Sprintf(`CREATE OR REPLACE FUNCTION public.%s() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic_membership_commit_failure'; END; $$; CREATE CONSTRAINT TRIGGER %s AFTER UPDATE ON ky_menu_webview_config DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.%s()`, functionName, triggerName, functionName)
+	if _, err := s.db.ExecContext(ctx, triggerSQL); err != nil {
+		t.Fatal("install deferred failure trigger:", err)
+	}
+	defer func() {
+		_, _ = s.db.ExecContext(context.Background(), fmt.Sprintf(`DROP TRIGGER IF EXISTS %s ON ky_menu_webview_config; DROP FUNCTION IF EXISTS public.%s()`, triggerName, functionName))
+		_, _ = s.db.ExecContext(context.Background(), `DELETE FROM ky_shop_management.ky_menu_webview_proxy_secret_version WHERE secret_version_id=$1::uuid`, newVersion)
+	}()
+	failedInput := base
+	two := int64(2)
+	failedInput.ExpectedRevision = &two
+	_, err = s.PutMenuWebViewConfigWithBeforeCommit(ctx, "workbench", menuKey, workspaceType, workspaceID, "synthetic-user", failedInput, func(string) (string, error) {
+		_, stageErr := s.db.ExecContext(ctx, `INSERT INTO ky_shop_management.ky_menu_webview_proxy_secret_version(secret_version_id,directory_type,menu_key,workspace_type,workspace_id) VALUES($1::uuid,'workbench',$2,$3,$4)`, newVersion, menuKey, workspaceType, workspaceID)
+		return newVersion, stageErr
+	})
+	if err == nil {
+		t.Fatal("deferred Membership commit failure was not observed")
+	}
+	current, err = s.GetMenuWebViewConfig(ctx, "workbench", menuKey, workspaceType, workspaceID)
+	if err != nil || current.Revision != 2 || current.ProxySecretVersionID != versionID {
+		t.Fatalf("failed commit changed active reference: revision=%d pointerPreserved=%v err=%v", current.Revision, current.ProxySecretVersionID == versionID, err)
+	}
+	var stagedRows int
+	if err := s.db.QueryRowContext(ctx, `SELECT count(*) FROM ky_shop_management.ky_menu_webview_proxy_secret_version WHERE secret_version_id=$1::uuid AND directory_type='workbench' AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4`, newVersion, menuKey, workspaceType, workspaceID).Scan(&stagedRows); err != nil || stagedRows != 1 {
+		t.Fatalf("successful Shop stage should remain as an unreferenced immutable row after Membership rollback: rows=%d err=%v", stagedRows, err)
+	}
+}
