+    // before bypassing Electron's native teardown (which can hang in headless CI).
+    const exitCode = error || !cleanupDone ? 1 : 0;
+    await new Promise((resolve) => process.stdout.write(`${JSON.stringify({ harness: "menu-webview-runtime-electron", finish: "exit_requested", exitCode })}\n`, resolve));
