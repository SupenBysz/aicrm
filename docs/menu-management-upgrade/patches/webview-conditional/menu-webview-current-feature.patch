+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname='ky_menu_webview_protocol_whitelist_ck') THEN
+    ALTER TABLE ky_menu_webview_config ADD CONSTRAINT ky_menu_webview_protocol_whitelist_ck
+      CHECK (jsonb_typeof(protocol_whitelist)='object'
