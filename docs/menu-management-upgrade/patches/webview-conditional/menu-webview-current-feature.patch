+async function configureSpaceSession(partition: string, targetSession: Session, config: MenuRuntimeConfig): Promise<void> {
+  const proxy = config.proxy;
+  const fingerprint = JSON.stringify({ userAgent: config.userAgent, acceptLanguage: config.acceptLanguage, proxy });
+  const prior = sessionSetup.get(partition);
+  if (prior && (prior as Promise<void> & { fingerprint?: string }).fingerprint === fingerprint) return prior;
+  const setup = (async () => {
+    configureLoginSpaceWebSocketPolicy(targetSession, normalizeLoginSpaceProtocolWhitelist(config.protocolWhitelist as Partial<MatrixAccountWebSpaceProtocolWhitelist> | null | undefined));
