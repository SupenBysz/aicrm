+-- 菜单 WebView 代理凭据改为不可变版本；配置事务只切换版本引用。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='20s';
+DO $$ BEGIN
+  IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF;
+END $$;
+
+ALTER TABLE ky_menu_webview_config
+  ADD COLUMN IF NOT EXISTS proxy_secret_version_id uuid;
+
+CREATE TABLE IF NOT EXISTS ky_shop_management.ky_menu_webview_proxy_secret_version (
+  secret_version_id uuid PRIMARY KEY,
+  directory_type text NOT NULL CHECK(directory_type IN ('workbench','management')),
+  menu_key text NOT NULL CHECK(menu_key ~ '^[a-z][a-z0-9_.-]{2,127}$'),
+  workspace_type text NOT NULL CHECK(workspace_type IN ('platform','agency','enterprise')),
+  workspace_id text NOT NULL,
+  username_envelope jsonb,
+  password_envelope jsonb,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE(secret_version_id,directory_type,menu_key,workspace_type,workspace_id),
+  CHECK(username_envelope IS NULL OR jsonb_typeof(username_envelope)='object'),
+  CHECK(password_envelope IS NULL OR jsonb_typeof(password_envelope)='object')
+);
+CREATE INDEX IF NOT EXISTS ky_menu_webview_proxy_secret_version_scope_idx
+  ON ky_shop_management.ky_menu_webview_proxy_secret_version(directory_type,menu_key,workspace_type,workspace_id,created_at DESC);
+DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='ky_menu_webview_config'::regclass AND conname='ky_menu_webview_proxy_secret_version_fk') THEN
+    ALTER TABLE ky_menu_webview_config ADD CONSTRAINT ky_menu_webview_proxy_secret_version_fk
+      FOREIGN KEY(proxy_secret_version_id,directory_type,menu_key,workspace_type,workspace_id)
+      REFERENCES ky_shop_management.ky_menu_webview_proxy_secret_version(secret_version_id,directory_type,menu_key,workspace_type,workspace_id)
+      ON UPDATE RESTRICT ON DELETE RESTRICT;
+  END IF;
+END $$;
+REVOKE ALL ON ky_shop_management.ky_menu_webview_proxy_secret_version FROM PUBLIC;
+GRANT SELECT,INSERT ON ky_shop_management.ky_menu_webview_proxy_secret_version TO ky_shop_management_app;
+
+-- 回滚：停止新版本引用读写后，先将每个活跃引用的密文在受控服务流程中解密并重新加密到对应 legacy 行，逐条验证配置/凭据一致，再清空 proxy_secret_version_id；确认没有引用后才可删除版本表和列。迁移后保存的新凭据未必存在于旧 legacy 行，禁止直接清空引用或覆盖旧密文，否则会丢失当前有效代理凭据。仅在确认无人引用后清理孤立版本。
diff --git a/packages/ky-admin-core/src/login-space-binding-selector.tsx b/packages/ky-admin-core/src/login-space-binding-selector.tsx
new file mode 100644
index 0000000..b005252
--- /dev/null
+++ b/packages/ky-admin-core/src/login-space-binding-selector.tsx
@@ -0,0 +1,129 @@
+import { Checkbox, Select, Space, Typography } from "antd";
+
+export type LoginSpaceBindingPolicy = "latest_released" | "pinned";
+
+export interface LoginSpaceBindingLike {
+  identifier: string;
+  versionId: string;
+  version: string;
+  versionPolicy?: LoginSpaceBindingPolicy;
+  available?: boolean;
+  error?: string;
+  urlMatchers: string[];
+  runAt: string;
+  sortOrder: number;
+}
+
+export interface LoginSpaceBindingOptionLike<TBinding extends LoginSpaceBindingLike> {
+  key: string;
+  label: string;
+  binding: TBinding;
+  versions: TBinding[];
+}
+
+export interface LoginSpaceBindingSelectorProps<TBinding extends LoginSpaceBindingLike> {
+  title: string;
+  placeholder: string;
+  bindings: TBinding[];
+  options: LoginSpaceBindingOptionLike<TBinding>[];
+  disabled?: boolean;
+  onChange: (bindings: TBinding[]) => void;
+}
+
+/** Shared script/style binding editor used by shop defaults and menu pages. */
+export function LoginSpaceBindingSelector<TBinding extends LoginSpaceBindingLike>({
+  title,
+  placeholder,
+  bindings,
+  options,
+  disabled = false,
+  onChange
+}: LoginSpaceBindingSelectorProps<TBinding>) {
+  const selectedIdentifiers = bindings.map(binding => binding.identifier);
+  const selectorOptions = [...options];
+  for (const binding of bindings) {
+    if (!selectorOptions.some(option => option.key === binding.identifier)) {
+      selectorOptions.push({
+        key: binding.identifier,
+        label: `${binding.identifier} · 当前发布版本不可用`,
+        binding,
+        versions: [{ ...binding, versionPolicy: "pinned" }]
+      });
+    }
+  }
+
+  function replaceSelected(identifiers: string[]) {
+    const currentByIdentifier = new Map(bindings.map(binding => [binding.identifier, binding]));
+    onChange(identifiers.flatMap(identifier => {
+      const existing = currentByIdentifier.get(identifier);
+      if (existing) return [existing];
+      const option = selectorOptions.find(item => item.key === identifier);
+      return option ? [{ ...option.binding, versionPolicy: "latest_released" as const }] : [];
+    }));
+  }
+
+  function updatePolicy(identifier: string, versionPolicy: LoginSpaceBindingPolicy) {
+    onChange(bindings.map(binding => binding.identifier === identifier
+      ? { ...binding, versionPolicy, available: undefined, error: undefined }
+      : binding));
+  }
+
+  function pinVersion(identifier: string, versionId: string) {
+    const selected = selectorOptions.find(item => item.key === identifier)?.versions.find(item => item.versionId === versionId);
+    if (!selected) return;
+    onChange(bindings.map(binding => binding.identifier === identifier ? {
+      ...binding,
+      versionId: selected.versionId,
+      version: selected.version,
+      runAt: selected.runAt,
+      versionPolicy: "pinned",
+      available: undefined,
+      error: undefined
+    } : binding));
+  }
+
+  return <div>
+    <Typography.Text strong>{title}</Typography.Text>
+    <Select
+      mode="multiple"
+      allowClear
+      disabled={disabled}
+      style={{ width: "100%", marginTop: 8 }}
+      placeholder={placeholder}
+      value={selectedIdentifiers}
+      options={selectorOptions.map(option => ({ value: option.key, label: option.label }))}
+      onChange={replaceSelected}
+    />
+    {bindings.length > 0 && <Space direction="vertical" size={8} style={{ width: "100%", marginTop: 10 }}>
+      {bindings.map(binding => {
+        const option = options.find(item => item.key === binding.identifier);
+        const followsLatest = (binding.versionPolicy ?? "pinned") === "latest_released";
+        const latestUnavailable = followsLatest && (binding.available === false || ((!binding.versionId || !binding.version) && binding.available !== true));
+        const versionOptions = [...(option?.versions ?? [])];
+        if (binding.versionId && !versionOptions.some(item => item.versionId === binding.versionId)) {
+          versionOptions.push({ ...binding, versionPolicy: "pinned" });
+        }
+        return <div key={binding.identifier} style={{ border: "1px solid var(--ant-color-border-secondary, #eee)", borderRadius: 8, padding: "8px 10px" }}>
+          <Space direction="vertical" size={6} style={{ width: "100%" }}>
+            <Typography.Text strong>{binding.identifier}</Typography.Text>
+            <Checkbox disabled={disabled} checked={followsLatest} onChange={event => updatePolicy(binding.identifier, event.target.checked ? "latest_released" : "pinned")}>
+              自动跟随最新发布版
+            </Checkbox>
+            {followsLatest
+              ? latestUnavailable
+                ? <Typography.Text type="danger">当前没有可用的发布版本；请移除此绑定或发布可用版本后再打开空间。</Typography.Text>
+                : <Typography.Text type="secondary">{binding.version ? `新建或重新打开空间时解析最新版本；当前解析版本：v${binding.version}` : "新建或重新打开页面时由服务端解析最新发布版本。"}</Typography.Text>
+              : <Select
+                disabled={disabled}
+                value={binding.versionId || undefined}
+                placeholder="选择固定发布版本"
+                style={{ width: "100%" }}
+                options={versionOptions.map(item => ({ value: item.versionId, label: `固定版本 v${item.version}` }))}
+                onChange={versionId => pinVersion(binding.identifier, versionId)}
+              />}
+          </Space>
+        </div>;
+      })}
+    </Space>}
+  </div>;
+}
diff --git a/packages/ky-admin-core/src/webview-common-settings.tsx b/packages/ky-admin-core/src/webview-common-settings.tsx
new file mode 100644
index 0000000..053e59b
