+func menuWebViewMenuExists(ctx context.Context, tx *sql.Tx, directory, key, workspaceType string) (bool, error) {
+	var pageType, status string
+	var hasNoActiveChildren bool
+	switch directory {
+	case "workbench":
+		var types []byte
+		err := tx.QueryRowContext(ctx, workbenchMenuWebViewExistsQuery, key).Scan(&pageType, &status, &types, &hasNoActiveChildren)
+		if errors.Is(err, sql.ErrNoRows) {
+			return false, nil
+		}
+		if err != nil {
+			return false, err
+		}
+		var ws []string
+		if json.Unmarshal(types, &ws) != nil {
+			return false, ErrValidation
+		}
+		return menuWebViewConfigLeafEligible(pageType, status, workspaceType, ws, hasNoActiveChildren), nil
+	case "management":
+		var types []byte
+		err := tx.QueryRowContext(ctx, managementMenuWebViewExistsQuery, key).Scan(&pageType, &status, &types, &hasNoActiveChildren)
+		if errors.Is(err, sql.ErrNoRows) {
+			return false, nil
+		}
+		if err != nil {
+			return false, err
+		}
+		var ws []string
+		if json.Unmarshal(types, &ws) != nil {
+			return false, ErrValidation
+		}
+		return menuWebViewConfigLeafEligible(pageType, status, workspaceType, ws, hasNoActiveChildren), nil
+	default:
+		return false, ErrValidation
+	}
+}
