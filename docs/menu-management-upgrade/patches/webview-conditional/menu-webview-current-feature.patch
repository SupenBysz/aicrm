+    if (!latest) return null;
+    const makeBinding = (asset: ScriptAsset, versionPolicy: MenuWebViewVersionPolicy): MenuWebViewBinding => ({
+      identifier: script.identifier,
+      versionId: versionPolicy === "pinned" ? asset.id : "",
+      version: versionPolicy === "pinned" ? asset.version : "",
+      versionPolicy,
+      available: true,
+      urlMatchers: urlMatchers(script),
+      runAt: asset.runAt || script.runAt,
+      sortOrder: script.priority ?? 0
+    });
+    return {
+      key: script.identifier,
+      label: `${script.identifier} · ${script.name} · 最新 v${latest.version}`,
+      binding: makeBinding(latest, "latest_released"),
+      versions: versions.map(item => makeBinding(item, "pinned"))
+    } satisfies MenuWebViewBindingOption;
+  }));
+  return options.filter((option): option is MenuWebViewBindingOption => Boolean(option));
+}
