+func TestWorkbenchTalentPagesRemovalMigrationKeepsOtherTalentPermissions(t *testing.T) {
+	contents, err := os.ReadFile("../../../../ops/db/114_remove_workbench_talent_square_pages.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql := string(contents)
+	for _, key := range []string{
+		"menu.workbench.talent_square.platform.douyin",
+		"menu.workbench.talent_square.agency.douyin",
+		"menu.workbench.talent_square.enterprise.douyin",
+	} {
+		if !strings.Contains(sql, key) {
+			t.Fatalf("migration does not remove exact workbench menu %q", key)
+		}
+	}
+	for _, expected := range []string{
+		"current_database()<>'kwwcrm'",
+		"DELETE FROM ky_workbench_menu_membership_override",
+		"DELETE FROM ky_workbench_menu_grant",
+		"DELETE FROM ky_menu_workspace_allowlist",
+		"DELETE FROM ky_role_permission rp",
+		"agency.talent_square.view",
+		"DELETE FROM ky_workbench_menu parent",
+	} {
+		if !strings.Contains(sql, expected) {
+			t.Errorf("migration missing removal guard %q", expected)
+		}
+	}
+	var executable strings.Builder
+	for _, line := range strings.Split(sql, "\n") {
+		if !strings.HasPrefix(strings.TrimSpace(line), "--") {
+			executable.WriteString(line)
+			executable.WriteByte('\n')
+		}
+	}
+	code := executable.String()
+	if !strings.Contains(sql, "加密备份") {
+		t.Fatal("migration must document the backup-based recovery boundary")
+	}
+	for _, protected := range []string{
+		"platform.talent_square.manage_view",
+		"enterprise.talent_square.view",
+		"menu.platform.talent_square.catalog",
+		"TRUNCATE",
+	} {
+		if strings.Contains(code, protected) {
+			t.Errorf("migration crosses protected boundary %q", protected)
+		}
+	}
+}
