+func (s *Store) PutMenuWebViewConfig(ctx context.Context, directory, key, workspaceType, workspaceID, actor string, in MenuWebViewConfigInput) (MenuWebViewConfig, error) {
+	return s.PutMenuWebViewConfigWithBeforeCommit(ctx, directory, key, workspaceType, workspaceID, actor, in, nil)
+}
+
+// PutMenuWebViewConfigWithBeforeCommit keeps the configuration row uncommitted
+// until an optional dependent write succeeds. The proxy-secret service uses
+// this hook so a failed credential save cannot leave a new menu configuration
+// revision behind.
+func (s *Store) PutMenuWebViewConfigWithBeforeCommit(ctx context.Context, directory, key, workspaceType, workspaceID, actor string, in MenuWebViewConfigInput, beforeCommit func(string) (string, error)) (MenuWebViewConfig, error) {
+	if in.ScheduleMode == "" {
+		in.ScheduleMode = "page_first"
+	}
+	if in.Scripts == nil {
+		in.Scripts = []MenuWebViewBinding{}
+	}
+	if in.Styles == nil {
+		in.Styles = []MenuWebViewBinding{}
+	}
+	if in.CloseBehavior == "" {
+		in.CloseBehavior = "close_view"
+	}
+	if in.SessionSource == "" {
+		in.SessionSource = "store"
+	}
+	if in.OpenMode == "" {
+		in.OpenMode = "embedded"
+	}
+	if in.ProtocolWhitelist.Navigation == nil {
+		in.ProtocolWhitelist.Navigation = []string{"http", "https", "blob", "data"}
+	}
+	if in.ProtocolWhitelist.WebSocket == nil {
+		in.ProtocolWhitelist.WebSocket = []string{"ws", "wss"}
+	}
+	if in.ProtocolWhitelist.External == nil {
+		in.ProtocolWhitelist.External = []string{"mailto"}
+	}
+	if in.Proxy.Mode == "" {
+		in.Proxy.Mode = "direct"
+	}
+	if in.Proxy.BypassRules == nil {
+		in.Proxy.BypassRules = []string{}
+	}
+	if !validMenuWebViewInput(in) || (in.ProxySecretVersionID != "" && !ValidMenuWebViewProxySecretVersionID(in.ProxySecretVersionID)) || !workbenchMenuKeyPattern.MatchString(key) || actor == "" || !validWorkbenchWorkspaceType(workspaceType) || workspaceID == "" {
+		return MenuWebViewConfig{}, ErrValidation
+	}
+	scripts, _ := json.Marshal(in.Scripts)
+	styles, _ := json.Marshal(in.Styles)
+	protocolWhitelist, _ := json.Marshal(in.ProtocolWhitelist)
+	proxy, _ := json.Marshal(in.Proxy.MenuWebViewProxy)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return MenuWebViewConfig{}, err
+	}
+	defer tx.Rollback()
+	lockKey := menuWebViewConfigLockKey(directory, key, workspaceType, workspaceID)
+	if _, err = tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, lockKey); err != nil {
+		return MenuWebViewConfig{}, err
+	}
+	leaf, err := menuWebViewMenuExists(ctx, tx, directory, key, workspaceType)
+	if err != nil {
+		return MenuWebViewConfig{}, err
+	}
+	if !leaf {
+		return MenuWebViewConfig{}, ErrValidation
+	}
+	var current int64
+	err = tx.QueryRowContext(ctx, `SELECT revision,COALESCE(proxy_secret_version_id::text,'') FROM ky_menu_webview_config WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4 FOR UPDATE`, directory, key, workspaceType, workspaceID).Scan(&current, &in.ProxySecretVersionID)
+	if errors.Is(err, sql.ErrNoRows) {
+		if *in.ExpectedRevision != 0 {
+			return MenuWebViewConfig{}, ErrConflict
+		}
+		current = 0
+	} else if err != nil {
+		return MenuWebViewConfig{}, err
+	} else if current != *in.ExpectedRevision {
+		return MenuWebViewConfig{}, ErrConflict
+	}
+	if beforeCommit != nil {
+		versionID, stageErr := beforeCommit(in.ProxySecretVersionID)
+		if stageErr != nil {
+			return MenuWebViewConfig{}, stageErr
+		}
+		in.ProxySecretVersionID = versionID
+	}
+	next := current + 1
+	var storeID any
+	if in.SessionSource == "store" {
+		storeID = in.StoreID
+	}
+	_, err = tx.ExecContext(ctx, `INSERT INTO ky_menu_webview_config(directory_type,menu_key,workspace_type,workspace_id,session_source,open_mode,store_id,runtime_platform,default_url,schedule_mode,scripts,styles,inherit_default_resources,show_web_view_dev_tools,user_agent,accept_language,protocol_whitelist,close_behavior,proxy,proxy_secret_version_id,revision,updated_by) VALUES($1,$2,$3,$4,$5,$6,$7::uuid,$8,$9,$10,$11::jsonb,$12::jsonb,$13,$14,$15,$16,$17::jsonb,$18,$19::jsonb,$20::uuid,$21,$22) ON CONFLICT(directory_type,menu_key,workspace_type,workspace_id) DO UPDATE SET session_source=EXCLUDED.session_source,open_mode=EXCLUDED.open_mode,store_id=EXCLUDED.store_id,runtime_platform=EXCLUDED.runtime_platform,default_url=EXCLUDED.default_url,schedule_mode=EXCLUDED.schedule_mode,scripts=EXCLUDED.scripts,styles=EXCLUDED.styles,inherit_default_resources=EXCLUDED.inherit_default_resources,show_web_view_dev_tools=EXCLUDED.show_web_view_dev_tools,user_agent=EXCLUDED.user_agent,accept_language=EXCLUDED.accept_language,protocol_whitelist=EXCLUDED.protocol_whitelist,close_behavior=EXCLUDED.close_behavior,proxy=EXCLUDED.proxy,proxy_secret_version_id=EXCLUDED.proxy_secret_version_id,revision=EXCLUDED.revision,updated_by=EXCLUDED.updated_by,updated_at=now()`, directory, key, workspaceType, workspaceID, in.SessionSource, in.OpenMode, storeID, in.Platform, in.DefaultURL, in.ScheduleMode, string(scripts), string(styles), in.InheritDefaultResources, in.ShowWebViewDevTools, in.UserAgent, in.AcceptLanguage, string(protocolWhitelist), in.CloseBehavior, string(proxy), nullableMenuWebViewSecretVersionID(in.ProxySecretVersionID), next, actor)
+	if err != nil {
+		return MenuWebViewConfig{}, err
+	}
+	if err = tx.Commit(); err != nil {
+		return MenuWebViewConfig{}, err
+	}
+	item := MenuWebViewConfig{DirectoryType: directory, MenuKey: key, WorkspaceType: workspaceType, WorkspaceID: workspaceID, SessionSource: in.SessionSource, OpenMode: in.OpenMode, StoreID: in.StoreID, Platform: in.Platform, DefaultURL: in.DefaultURL, ScheduleMode: in.ScheduleMode, Scripts: in.Scripts, Styles: in.Styles, InheritDefaultResources: in.InheritDefaultResources, ShowWebViewDevTools: in.ShowWebViewDevTools, UserAgent: in.UserAgent, AcceptLanguage: in.AcceptLanguage, ProtocolWhitelist: in.ProtocolWhitelist, Proxy: in.Proxy.MenuWebViewProxy, CloseBehavior: in.CloseBehavior, Revision: next, ProxySecretVersionID: in.ProxySecretVersionID}
+	item.UsageScope, item.UsageReasons = menuWebViewUsage(item)
+	return item, nil
+}
+
+func menuWebViewUsage(cfg MenuWebViewConfig) (string, []string) {
+	reasons := []string{}
+	if cfg.SessionSource == "store" {
+		reasons = append(reasons, "store_session")
+	}
+	// This setting controls Electron's WebContents DevTools. A browser route
+	// cannot enforce the same per-menu policy, so it must stay client-only.
+	if cfg.ShowWebViewDevTools {
+		reasons = append(reasons, "developer_tools")
+	}
+	if len(cfg.Scripts)+len(cfg.Styles) > 0 || cfg.InheritDefaultResources {
+		reasons = append(reasons, "injection_resources")
+	}
+	if cfg.UserAgent != "" || cfg.AcceptLanguage != "" {
+		reasons = append(reasons, "custom_identity")
+	}
+	if cfg.ProtocolWhitelist.Navigation != nil && (len(cfg.ProtocolWhitelist.Navigation) != 4 || !containsString(cfg.ProtocolWhitelist.Navigation, "http") || !containsString(cfg.ProtocolWhitelist.Navigation, "https") || !containsString(cfg.ProtocolWhitelist.Navigation, "blob") || !containsString(cfg.ProtocolWhitelist.Navigation, "data")) {
+		reasons = append(reasons, "protocol_policy")
+	}
+	if cfg.Proxy.Mode != "" && cfg.Proxy.Mode != "direct" {
+		reasons = append(reasons, "proxy")
+	}
+	if cfg.ProtocolWhitelist.WebSocket != nil && (len(cfg.ProtocolWhitelist.WebSocket) != 2 || !containsString(cfg.ProtocolWhitelist.WebSocket, "ws") || !containsString(cfg.ProtocolWhitelist.WebSocket, "wss")) {
+		reasons = append(reasons, "websocket_protocol_policy")
+	}
+	if cfg.ProtocolWhitelist.External != nil && (len(cfg.ProtocolWhitelist.External) != 1 || !containsString(cfg.ProtocolWhitelist.External, "mailto")) {
+		reasons = append(reasons, "external_protocol_policy")
+	}
+	if len(reasons) > 0 {
+		return "client_only", reasons
+	}
+	return "browser_and_client", reasons
+}
+
+// menuWebViewHasAnyConfiguration is used by the menu enable gate. A WebView
+// leaf starts disabled and cannot be published until at least one complete
+// workspace-scoped page configuration exists.
+func menuWebViewHasAnyConfiguration(ctx context.Context, tx *sql.Tx, directory, menuKey string) (bool, error) {
+	if directory != "workbench" && directory != "management" {
+		return false, ErrValidation
+	}
+	var rawWorkspaceTypes []byte
+	var pageType string
+	var hasNoActiveChildren bool
+	query := `SELECT COALESCE(page_type,'default'),workspace_types,NOT EXISTS(SELECT 1 FROM ky_workbench_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_workbench_menu m WHERE menu_key=$1 AND status IN ('active','disabled')`
+	if directory == "management" {
+		query = `SELECT COALESCE(page_type,'default'),workspace_types,NOT EXISTS(SELECT 1 FROM ky_management_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_management_menu m WHERE menu_key=$1 AND status IN ('active','disabled')`
+	}
+	if err := tx.QueryRowContext(ctx, query, menuKey).Scan(&pageType, &rawWorkspaceTypes, &hasNoActiveChildren); errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, err
+	}
+	if pageType != "webview" || !hasNoActiveChildren {
+		return false, nil
+	}
+	var targets []string
+	if err := json.Unmarshal(rawWorkspaceTypes, &targets); err != nil {
+		return false, err
+	}
+	if len(targets) == 0 {
+		return false, nil
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT workspace_type,workspace_id,COALESCE(session_source,'store'),COALESCE(open_mode,'embedded'),COALESCE(store_id::text,''),COALESCE(runtime_platform,''),default_url,schedule_mode,scripts,styles,inherit_default_resources,show_web_view_dev_tools,COALESCE(user_agent,''),COALESCE(accept_language,''),COALESCE(protocol_whitelist,'{"navigation":["http","https","blob","data"],"webSocket":["ws","wss"],"external":["mailto"]}'::jsonb),close_behavior,COALESCE(proxy,'{"mode":"direct","bypassRules":[]}'::jsonb),revision FROM ky_menu_webview_config WHERE directory_type=$1 AND menu_key=$2 ORDER BY workspace_type,workspace_id`, directory, menuKey)
+	if err != nil {
+		return false, err
+	}
+	defer rows.Close()
+	configured := map[string]bool{}
+	validConfigs := []MenuWebViewConfig{}
+	for rows.Next() {
+		var cfg MenuWebViewConfig
+		var scripts, styles, protocols, proxy []byte
+		if err := rows.Scan(&cfg.WorkspaceType, &cfg.WorkspaceID, &cfg.SessionSource, &cfg.OpenMode, &cfg.StoreID, &cfg.Platform, &cfg.DefaultURL, &cfg.ScheduleMode, &scripts, &styles, &cfg.InheritDefaultResources, &cfg.ShowWebViewDevTools, &cfg.UserAgent, &cfg.AcceptLanguage, &protocols, &cfg.CloseBehavior, &proxy, &cfg.Revision); err != nil {
+			return false, err
+		}
+		if json.Unmarshal(scripts, &cfg.Scripts) != nil || json.Unmarshal(styles, &cfg.Styles) != nil || json.Unmarshal(protocols, &cfg.ProtocolWhitelist) != nil || json.Unmarshal(proxy, &cfg.Proxy) != nil {
+			return false, ErrValidation
+		}
+		input := MenuWebViewConfigInput{SessionSource: cfg.SessionSource, OpenMode: cfg.OpenMode, StoreID: cfg.StoreID, Platform: cfg.Platform, DefaultURL: cfg.DefaultURL, ScheduleMode: cfg.ScheduleMode, Scripts: cfg.Scripts, Styles: cfg.Styles, InheritDefaultResources: cfg.InheritDefaultResources, ShowWebViewDevTools: cfg.ShowWebViewDevTools, UserAgent: cfg.UserAgent, AcceptLanguage: cfg.AcceptLanguage, ProtocolWhitelist: cfg.ProtocolWhitelist, Proxy: MenuWebViewProxyInput{MenuWebViewProxy: cfg.Proxy}, CloseBehavior: cfg.CloseBehavior, ExpectedRevision: &cfg.Revision}
+		if !ValidMenuWebViewTarget(cfg.WorkspaceType, cfg.WorkspaceID) || !validMenuWebViewInput(input) {
+			continue
+		}
+		validConfigs = append(validConfigs, cfg)
+	}
+	if err := rows.Err(); err != nil {
+		return false, err
+	}
+	if err := rows.Close(); err != nil {
+		return false, err
+	}
+	for _, cfg := range validConfigs {
+		if cfg.SessionSource == "store" {
+			var platform string
+			if err := tx.QueryRowContext(ctx, `SELECT platform FROM ky_shop_management.ky_shop_store WHERE id=$1::uuid AND workspace_type=$2 AND workspace_id=$3 AND status='active' AND deleted_at IS NULL`, cfg.StoreID, cfg.WorkspaceType, cfg.WorkspaceID).Scan(&platform); errors.Is(err, sql.ErrNoRows) {
+				continue
+			} else if err != nil {
+				return false, err
+			}
+			cfg.Platform = strings.TrimSuffix(platform, "_shop")
+		}
+		ready, err := menuWebViewResourcesAvailable(ctx, tx, cfg)
+		if err != nil {
+			return false, err
+		}
+		if !ready {
+			continue
+		}
+		configured[cfg.WorkspaceType+"\x00"+cfg.WorkspaceID] = true
+	}
+	required := []MenuAllowlistWorkspaceOption{}
+	for _, workspaceType := range targets {
+		switch workspaceType {
+		case "platform":
+			required = append(required, MenuAllowlistWorkspaceOption{WorkspaceType: "platform", WorkspaceID: "platform_root"})
+		case "agency":
+			rows, e := tx.QueryContext(ctx, `SELECT id FROM ky_agency WHERE status='normal' AND deleted_at IS NULL ORDER BY id`)
+			if e != nil {
+				return false, e
+			}
+			for rows.Next() {
+				var id string
+				if e = rows.Scan(&id); e != nil {
+					rows.Close()
+					return false, e
+				}
+				required = append(required, MenuAllowlistWorkspaceOption{WorkspaceType: "agency", WorkspaceID: id})
+			}
+			e = rows.Err()
+			rows.Close()
+			if e != nil {
+				return false, e
+			}
+		case "enterprise":
+			rows, e := tx.QueryContext(ctx, `SELECT id FROM ky_enterprise WHERE status='normal' AND deleted_at IS NULL ORDER BY id`)
+			if e != nil {
+				return false, e
+			}
+			for rows.Next() {
+				var id string
+				if e = rows.Scan(&id); e != nil {
+					rows.Close()
+					return false, e
+				}
+				required = append(required, MenuAllowlistWorkspaceOption{WorkspaceType: "enterprise", WorkspaceID: id})
+			}
+			e = rows.Err()
+			rows.Close()
+			if e != nil {
+				return false, e
+			}
+		default:
+			return false, ErrValidation
+		}
+	}
+	if len(required) == 0 {
+		return false, nil
+	}
+	return menuWebViewTargetsConfigured(required, configured), nil
+}
+
+func menuWebViewTargetsConfigured(required []MenuAllowlistWorkspaceOption, configured map[string]bool) bool {
+	if len(required) == 0 {
+		return false
+	}
+	for _, target := range required {
+		if !configured[target.WorkspaceType+"\x00"+target.WorkspaceID] {
+			return false
+		}
+	}
+	return true
+}
+
+// menuWebViewResourcesAvailable makes the enable gate check the same immutable
+// published assets the runtime resolver can consume. Any database read error is
+// returned to the caller so a transient dependency failure cannot enable a menu.
+func menuWebViewResourcesAvailable(ctx context.Context, tx *sql.Tx, cfg MenuWebViewConfig) (bool, error) {
+	type bindingSet struct {
+		kind      string
+		items     []MenuWebViewBinding
+		inherited bool
+	}
+	bindings := []bindingSet{{kind: "script", items: cfg.Scripts}, {kind: "style", items: cfg.Styles}}
+	if cfg.SessionSource == "store" && cfg.InheritDefaultResources {
+		for _, kind := range []string{"script", "style"} {
+			table := "ky_shop_management.ky_shop_login_space_default_script"
+			if kind == "style" {
+				table = "ky_shop_management.ky_shop_login_space_default_style"
+			}
+			rows, err := tx.QueryContext(ctx, `SELECT identifier,version_policy,COALESCE(version_id,''),COALESCE(version,'') FROM `+table+` WHERE store_id=$1::uuid ORDER BY sort_order,identifier,binding_id`, cfg.StoreID)
+			if err != nil {
+				return false, err
+			}
+			items := []MenuWebViewBinding{}
+			for rows.Next() {
+				var item MenuWebViewBinding
+				if err := rows.Scan(&item.Identifier, &item.VersionPolicy, &item.VersionID, &item.Version); err != nil {
+					rows.Close()
+					return false, err
+				}
+				items = append(items, item)
+			}
+			if err := rows.Err(); err != nil {
+				rows.Close()
+				return false, err
+			}
+			if err := rows.Close(); err != nil {
+				return false, err
+			}
+			bindings = append(bindings, bindingSet{kind: kind, items: items, inherited: true})
+		}
+	}
+	hasBindings := false
+	for _, group := range bindings {
+		hasBindings = hasBindings || len(group.items) > 0
+	}
+	if hasBindings && !validMenuWebViewRuntimePlatform(cfg.Platform) {
+		return false, nil
+	}
+	explicitByKind := map[string]map[string]bool{"script": {}, "style": {}}
+	for _, group := range bindings {
+		if group.inherited {
+			continue
+		}
+		for _, item := range group.items {
+			explicitByKind[group.kind][item.Identifier] = true
+		}
+	}
+	for _, group := range bindings {
+		for _, binding := range group.items {
+			if group.inherited && explicitByKind[group.kind][binding.Identifier] {
+				continue
+			}
+			if !menuWebViewIdentifierPattern.MatchString(binding.Identifier) || (binding.VersionPolicy != "latest_released" && binding.VersionPolicy != "pinned") {
+				return false, nil
+			}
+			var available bool
+			err := tx.QueryRowContext(ctx, `SELECT EXISTS(
+SELECT 1 FROM ky_matrix_account_douyin_script s
+JOIN ky_matrix_account_douyin_script_asset_version v ON v.script_id=s.id AND v.asset_type=$5
+WHERE s.workspace_type=$1 AND s.workspace_id=$2 AND s.platform=$3 AND s.identifier=$4
+  AND s.status='enabled' AND s.deleted_at IS NULL AND v.enabled
+  AND v.status IN ('released','active')
+  AND (($6='latest_released') OR ($6='pinned' AND v.id=$7 AND v.version=$8))
+)`, cfg.WorkspaceType, cfg.WorkspaceID, cfg.Platform, binding.Identifier, group.kind, binding.VersionPolicy, binding.VersionID, binding.Version).Scan(&available)
+			if err != nil {
+				return false, err
+			}
+			if !available {
+				return false, nil
+			}
+		}
+	}
+	return true, nil
+}
+
+func containsString(values []string, target string) bool {
+	for _, value := range values {
+		if value == target {
+			return true
+		}
+	}
+	return false
+}
