+  const headers = {
+    Authorization: `Bearer ${desktopSession.token}`,
+    "Content-Type": "application/json",
+    "X-KY-Workspace-Type": input.workspaceType,
+    "X-KY-Workspace-Id": input.workspaceId,
+    "X-KY-Desktop-Call": "web-window-main"
+  };
+  const requestBody = {
+    workspaceType: input.workspaceType,
+    workspaceId: input.workspaceId,
+    reassign: input.reassign === true
+  };
+  const requestOptions = (body: typeof requestBody): RequestInit => ({
+    method: "POST",
+    headers,
+    body: JSON.stringify(body),
+    cache: "no-store",
+    redirect: "error"
