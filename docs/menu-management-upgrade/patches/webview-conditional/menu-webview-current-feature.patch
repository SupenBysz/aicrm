+            <Descriptions.Item label="Electron">{pluginProjection.versionPanel.client.electronVersion}</Descriptions.Item>
+            <Descriptions.Item label="平台">{pluginProjection.versionPanel.client.platform} / {pluginProjection.versionPanel.client.arch}</Descriptions.Item>
+          </>}
+        </Descriptions> : <Typography.Text type="secondary">插件信息正在加载。</Typography.Text>}
+      </Drawer>
+    </section>
+  );
+}
