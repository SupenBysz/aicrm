+	if err != nil || strings.Contains(string(serialized), "proxy-user") || strings.Contains(string(serialized), "secret-one") {
+		t.Fatalf("fingerprint payload leaked credentials: %s err=%v", serialized, err)
+	}
+	if _, err := menuWebViewCredentialFingerprint(first, ""); err == nil {
