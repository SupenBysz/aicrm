+	first := store.MenuWebViewProxyCredentials{Username: stringPointer("proxy-user"), Password: stringPointer("secret-one")}
+	retry := store.MenuWebViewProxyCredentials{Username: stringPointer("proxy-user"), Password: stringPointer("secret-one")}
+	changed := store.MenuWebViewProxyCredentials{Username: stringPointer("proxy-user"), Password: stringPointer("secret-two")}
+	firstFingerprint, err := menuWebViewCredentialFingerprint(first, "test-only-idempotency-key")
+	if err != nil {
+		t.Fatal(err)
+	}
+	retryFingerprint, err := menuWebViewCredentialFingerprint(retry, "test-only-idempotency-key")
+	if err != nil || retryFingerprint != firstFingerprint {
+		t.Fatalf("identical credential retry must have the same fingerprint: err=%v", err)
+	}
+	changedFingerprint, err := menuWebViewCredentialFingerprint(changed, "test-only-idempotency-key")
+	if err != nil || changedFingerprint == firstFingerprint {
+		t.Fatalf("changed credential must not reuse an idempotency fingerprint: err=%v", err)
+	}
+	serialized, err := json.Marshal(struct {
