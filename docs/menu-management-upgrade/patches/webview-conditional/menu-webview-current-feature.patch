+package store
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+func TestClassifyWorkbenchMenuCreateDatabaseErrors(t *testing.T) {
+	cases := []struct {
+		name       string
+		code       string
+		constraint string
+		want       error
+		wantText   string
+	}{
+		{"duplicate menu key", "23505", "ky_workbench_menu_pkey", ErrWorkbenchMenuExists, "sqlstate=23505 constraint=ky_workbench_menu_pkey"},
+		{"duplicate route", "23505", "ky_workbench_menu_route_uidx", ErrWorkbenchMenuExists, "sqlstate=23505 constraint=ky_workbench_menu_route_uidx"},
+		{"page type check", "23514", "ky_workbench_menu_page_type_ck", ErrWorkbenchMenuConstraint, "sqlstate=23514 constraint=ky_workbench_menu_page_type_ck"},
+		{"foreign key", "23503", "ky_workbench_menu_created_by_fkey", ErrWorkbenchMenuConstraint, "sqlstate=23503 constraint=ky_workbench_menu_created_by_fkey"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := classifyWorkbenchMenuCreateError(&pgconn.PgError{Code: tc.code, ConstraintName: tc.constraint})
+			if !errors.Is(err, tc.want) {
+				t.Fatalf("classified error %v does not match %v", err, tc.want)
+			}
+			if !strings.Contains(err.Error(), tc.wantText) {
+				t.Fatalf("safe diagnostic missing from %q", err)
+			}
+		})
+	}
+	plain := errors.New("connection unavailable")
+	if got := classifyWorkbenchMenuCreateError(plain); !errors.Is(got, plain) {
+		t.Fatalf("non-constraint error was changed: %v", got)
+	}
+	wrapped := fmt.Errorf("wrapped: %w", &pgconn.PgError{Code: "23514", ConstraintName: "bad;do-not-log"})
+	got := classifyWorkbenchMenuCreateError(wrapped)
+	if !errors.Is(got, ErrWorkbenchMenuConstraint) || strings.Contains(got.Error(), "bad;") || !strings.Contains(got.Error(), "constraint=unknown") {
+		t.Fatalf("unsafe or incorrect classification: %v", got)
+	}
+}
