+func (s *Server) fetchMenuWebViewShops(ctx context.Context, workspaceType, workspaceID string, page, pageSize int) ([]menuWebViewShopOption, store.Page, error) {
+	base, err := url.Parse(s.cfg.ShopManagementURL)
+	if err != nil || base.Host == "" || base.User != nil || base.RawQuery != "" || base.Fragment != "" || (base.Scheme != "https" && !(base.Scheme == "http" && (base.Hostname() == "127.0.0.1" || base.Hostname() == "localhost"))) {
+		return nil, store.Page{}, errors.New("shop service URL unavailable")
+	}
+	body, _ := json.Marshal(map[string]any{"workspaceType": workspaceType, "workspaceId": workspaceID, "page": page, "pageSize": pageSize})
+	u := *base
+	u.Path = "/internal/v1/menu-webview/shops"
+	c, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(c, http.MethodPost, u.String(), bytes.NewReader(body))
+	if err != nil {
+		return nil, store.Page{}, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.InternalToken)
+	req.Header.Set("X-KY-Request-Id", "menu-webview-shop-options")
+	tr := &http.Transport{Proxy: nil}
+	defer tr.CloseIdleConnections()
+	client := &http.Client{Transport: tr, Timeout: 3 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	res, err := client.Do(req)
+	if err != nil {
+		return nil, store.Page{}, err
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return nil, store.Page{}, errors.New("shop options rejected")
+	}
+	var reply struct {
+		Data struct {
+			Items      []menuWebViewShopOption `json:"items"`
+			Pagination store.Page              `json:"pagination"`
+		} `json:"data"`
+	}
+	d := json.NewDecoder(io.LimitReader(res.Body, 1024*1024))
+	if err := d.Decode(&reply); err != nil {
+		return nil, store.Page{}, err
+	}
+	if err := d.Decode(new(any)); err != io.EOF || reply.Data.Pagination.Page != page || reply.Data.Pagination.PageSize != pageSize || len(reply.Data.Items) > pageSize {
+		return nil, store.Page{}, errors.New("shop options response invalid")
+	}
+	return reply.Data.Items, reply.Data.Pagination, nil
+}
