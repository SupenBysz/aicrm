diff --git a/apps/ky-admin-host/src/pages/menu-webview-page.tsx b/apps/ky-admin-host/src/pages/menu-webview-page.tsx
new file mode 100644
index 0000000..bf43ef3
--- /dev/null
+++ b/apps/ky-admin-host/src/pages/menu-webview-page.tsx
@@ -0,0 +1,234 @@
+import { useEffect, useRef, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { App as AntdApp, Button, Descriptions, Drawer, Result, Space, Spin, Tag, Tooltip, Typography } from "antd";
+import { ArrowLeftOutlined, ArrowRightOutlined, CloseOutlined, HomeOutlined, ReloadOutlined } from "@ant-design/icons";
+import { useNavigate, useParams } from "react-router-dom";
+import { useCurrentWorkspace, useRequestClient } from "@ky/admin-core";
+import { getDesktopBridge, isDesktopClientMode } from "../desktop-client";
+import type { MenuWebViewState } from "../../../aicrm-desktop/src/shared/types";
+import type { DesktopWebWindowPluginProjection } from "../desktop-client";
+
+const { Text } = Typography;
+
+export function MenuWebViewMenuPage() {
+  const { directoryType, menuKey } = useParams();
+  const navigate = useNavigate();
+  const workspace = useCurrentWorkspace();
+  const requestClient = useRequestClient();
+  const { message } = AntdApp.useApp();
+  const bridge = getDesktopBridge()?.menuWebView;
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const instanceRef = useRef<string | null>(null);
+  const detachedWindowRef = useRef(false);
+  const [instanceId, setInstanceId] = useState<string | null>(null);
+  const [openMode, setOpenMode] = useState<"embedded" | "window">("embedded");
+  const [state, setState] = useState<MenuWebViewState | null>(null);
+  const [error, setError] = useState("");
+  const [closed, setClosed] = useState(false);
+  const [closeBehavior, setCloseBehavior] = useState<"close" | "back_to_host">("close");
+  const [pluginProjection, setPluginProjection] = useState<DesktopWebWindowPluginProjection | null>(null);
+  const [pluginPanel, setPluginPanel] = useState<"version" | "injection" | null>(null);
+  const pendingProjectionRef = useRef<DesktopWebWindowPluginProjection | null>(null);
+  const browserVisibility = useQuery({
+    queryKey: ["menu-webview-browser-visibility", directoryType, menuKey, workspace?.type, workspace?.id],
+    enabled: !isDesktopClientMode() && Boolean(workspace && directoryType && menuKey),
+    retry: false,
+    queryFn: () => requestClient.request<{ allowed: boolean; browserAllowed: boolean; openMode?: "embedded" | "window"; url?: string }>(
+      `/api/v1/menu-pages/${directoryType}/${encodeURIComponent(menuKey!)}/webview-visibility`
+    )
+  });
+
+  useEffect(() => {
+    if (!bridge || !workspace || (directoryType !== "workbench" && directoryType !== "management") || !menuKey) return;
+    let active = true;
+    pendingProjectionRef.current = null;
+    detachedWindowRef.current = false;
+    setOpenMode("embedded");
+    setPluginProjection(null);
+    setPluginPanel(null);
+    setState(null);
+    setError("");
+    setClosed(false);
+    const unsubscribe = bridge.onStateChanged((next) => {
+      if (!active || next.instanceId !== instanceRef.current) return;
+      setState((current) => !current || next.sequence >= current.sequence ? next : current);
+    });
+    const unsubscribeProjection = bridge.onPluginProjectionChanged((next) => {
+      if (!active) return;
+      if (next.instanceId === instanceRef.current) setPluginProjection(next);
+      else if (instanceRef.current === null) pendingProjectionRef.current = next;
+    });
+    void (async () => {
+      return bridge.open({
+        directoryType,
+        menuKey,
+        workspaceType: workspace.type,
+        workspaceId: workspace.id
+      });
+    })().then((result) => {
+      if (!active) {
+        if (result?.data?.instanceId) void bridge.close({ instanceId: result.data.instanceId });
+        return;
+      }
+      if (!result?.ok || !result.data?.instanceId) {
+        const text = result?.error?.message || "页面未能打开，请检查菜单配置和登录空间。";
+        setError(text);
+        message.error(text);
+        return;
+      }
+      instanceRef.current = result.data.instanceId;
+      setInstanceId(result.data.instanceId);
+      detachedWindowRef.current = result.data.openMode === "window";
+      setOpenMode(result.data.openMode);
+      setCloseBehavior(result.data.closeBehavior);
+      if (pendingProjectionRef.current?.instanceId === result.data.instanceId) {
+        setPluginProjection(pendingProjectionRef.current);
+        pendingProjectionRef.current = null;
+      }
+      setState((current) => current?.instanceId === result.data!.instanceId ? current : {
+        instanceId: result.data!.instanceId,
+        sequence: 0,
+        loading: true,
+        canGoBack: false,
+        canGoForward: false,
+        url: "",
+        title: menuKey
+      });
+    }).catch((reason: unknown) => {
+      if (active) {
+        const text = reason instanceof Error ? reason.message : "页面打开失败，请稍后重试。";
+        setError(text);
+        message.error(text);
+      }
+    });
+    return () => {
+      active = false;
+      unsubscribe();
+      unsubscribeProjection();
+      const currentInstance = instanceRef.current;
+      instanceRef.current = null;
+      if (currentInstance && !detachedWindowRef.current) void bridge.close({ instanceId: currentInstance });
+    };
+  }, [bridge, directoryType, menuKey, requestClient, workspace?.id, workspace?.type]);
+
+  useEffect(() => {
+    if (state?.error) message.error("页面加载失败，请检查网络连接或重试。");
+  }, [message, state?.error]);
+
+  useEffect(() => {
+    if (!bridge || !instanceId || openMode === "window") return;
+    const failed = Boolean(error || state?.error);
+    const element = containerRef.current;
+    if (!element) return;
+    let frame = 0;
+    const update = () => {
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(() => {
+        const rect = element.getBoundingClientRect();
+        const visible = !closed && !failed && document.visibilityState === "visible" && rect.width > 0 && rect.height > 0
+          && rect.bottom > 0 && rect.right > 0 && rect.top < window.innerHeight && rect.left < window.innerWidth;
+        void bridge.setBounds({
+          instanceId,
+          x: Math.max(0, rect.left),
+          y: Math.max(0, rect.top),
+          width: Math.max(0, rect.width),
+          height: Math.max(0, rect.height),
+          visible
+        });
+      });
+    };
+    const resizeObserver = new ResizeObserver(update);
+    resizeObserver.observe(element);
+    window.addEventListener("resize", update);
+    window.addEventListener("scroll", update, true);
+    document.addEventListener("visibilitychange", update);
+    update();
+    return () => {
+      cancelAnimationFrame(frame);
+      resizeObserver.disconnect();
+      window.removeEventListener("resize", update);
+      window.removeEventListener("scroll", update, true);
+      document.removeEventListener("visibilitychange", update);
+    };
+  }, [bridge, closed, error, instanceId, openMode, state?.error]);
+
+  if (!isDesktopClientMode()) {
+    if (browserVisibility.isLoading) return <div className="menu-webview-placeholder"><Spin tip="正在检查页面权限…" /></div>;
+    if (browserVisibility.isError || !browserVisibility.data?.allowed) return <Result status="error" title="页面暂不可用" subTitle="菜单访问权限或页面配置暂不可用，请稍后重试。" />;
+    if (!browserVisibility.data.browserAllowed || !browserVisibility.data.url) return <Result status="info" title="此菜单需要桌面客户端" subTitle="当前页面使用了浏览器无法提供的会话或宿主能力，请在 AiCRM 桌面客户端中打开。" />;
+    if (browserVisibility.data.openMode === "window") return <Result status="info" title="HTTP/HTTPS 页面" subTitle="此页面配置为新窗口打开。" extra={<Button type="primary" onClick={() => window.open(browserVisibility.data?.url, "_blank", "noopener,noreferrer")}>打开页面</Button>} />;
+    return <iframe title={menuKey} src={browserVisibility.data.url} referrerPolicy="strict-origin-when-cross-origin" sandbox="allow-forms allow-scripts allow-same-origin allow-downloads" style={{ width: "100%", height: "calc(100vh - 180px)", border: 0, background: "#fff" }} />;
+  }
+  if (!bridge) return <Result status="error" title="桌面页面未就绪" subTitle="请刷新客户端页面后重试。" />;
+  if (!workspace || (directoryType !== "workbench" && directoryType !== "management") || !menuKey) {
+    return <Result status="error" title="菜单页面参数无效" />;
+  }
+
+  const handleClose = async () => {
+    const current = instanceRef.current;
+    if (current && !detachedWindowRef.current) await bridge.close({ instanceId: current });
+    instanceRef.current = null;
+    setInstanceId(null);
+    setPluginProjection(null);
+    setPluginPanel(null);
+    pendingProjectionRef.current = null;
+    setClosed(true);
+    if (closeBehavior === "back_to_host") {
+      if (Number.isInteger(window.history.state?.idx) && window.history.state.idx > 0) navigate(-1);
+      else navigate(`/w/${workspace.type}/${encodeURIComponent(workspace.id)}/${directoryType === "workbench" ? "workbench" : "workbench"}`, { replace: true });
+    }
+  };
+
+  const sendNavigation = (command: "back" | "forward" | "reload" | "home") => {
+    if (instanceId) void bridge.navigate({ instanceId, command });
+  };
+
+  const handlePluginAction = (actionId?: string) => {
+    if (actionId === "back" || actionId === "reload" || actionId === "home") {
+      sendNavigation(actionId);
+      return;
+    }
+    setPluginPanel(actionId === "injection-panel" ? "injection" : "version");
+  };
+
+  return (
+    <section className="menu-webview-page">
+      {openMode === "embedded" ? <header className="menu-webview-toolbar">
+        <Space size={6}>
+          <Tooltip title="后退"><Button aria-label="后退" disabled={!state?.canGoBack || state.loading} icon={<ArrowLeftOutlined />} onClick={() => sendNavigation("back")} /></Tooltip>
+          <Tooltip title="前进"><Button aria-label="前进" disabled={!state?.canGoForward || state.loading} icon={<ArrowRightOutlined />} onClick={() => sendNavigation("forward")} /></Tooltip>
+          <Tooltip title="刷新"><Button aria-label="刷新" disabled={!instanceId} icon={<ReloadOutlined />} onClick={() => sendNavigation("reload")} /></Tooltip>
+          <Tooltip title="主页"><Button aria-label="主页" disabled={!instanceId} icon={<HomeOutlined />} onClick={() => sendNavigation("home")} /></Tooltip>
+        </Space>
+        <Text className="menu-webview-title" ellipsis>{state?.title || menuKey}</Text>
+        {state?.loading ? <Spin size="small" /> : null}
+        {pluginProjection?.items.length ? <Space className="menu-webview-plugin-actions" size={4}>
+          {pluginProjection.items.map((item) => item.type === "button"
+            ? <Tooltip key={item.id} title={item.title}><Button size="small" onClick={() => handlePluginAction(item.actionId)}>{item.text}</Button></Tooltip>
+            : <Tag key={item.id} color={item.tone === "error" ? "error" : item.tone === "warning" ? "warning" : undefined}>{item.text}</Tag>)}
+        </Space> : null}
+        <Tooltip title={closeBehavior === "back_to_host" ? "返回菜单" : "关闭页面"}>
+          <Button aria-label={closeBehavior === "back_to_host" ? "返回菜单" : "关闭页面"} icon={<CloseOutlined />} onClick={() => void handleClose()} />
+        </Tooltip>
+      </header> : null}
+      {openMode === "window" ? <div className="menu-webview-placeholder"><Text type="secondary">页面已在专用窗口中打开，可从任务栏窗口切换。</Text></div> : <div className="menu-webview-viewport" ref={containerRef}>
+        {!instanceId && !error ? <div className="menu-webview-placeholder"><Spin tip="正在准备页面…" /></div> : null}
+        {closed ? <div className="menu-webview-placeholder"><Text type="secondary">页面已关闭</Text></div> : null}
+      </div>}
+      <Drawer title={pluginPanel === "injection" ? "页面资源状态" : "Web 专用窗口插件"} open={pluginPanel !== null} onClose={() => setPluginPanel(null)} width={420}>
+        {pluginProjection?.versionPanel ? <Descriptions column={1} size="small" bordered>
+          <Descriptions.Item label="插件">{pluginProjection.versionPanel.plugin.id} · v{pluginProjection.versionPanel.plugin.version}</Descriptions.Item>
+          <Descriptions.Item label="插件状态">{pluginProjection.versionPanel.plugin.status}</Descriptions.Item>
+          {pluginPanel === "injection" ? <>
