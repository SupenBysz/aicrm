+func TestNestedWebViewMigrationPreservesGroupAndDefaultPageRules(t *testing.T) {
+	contents, err := os.ReadFile("../../../../ops/db/117_workbench_nested_webview_menus.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql := string(contents)
+	for _, required := range []string{
+		"current_database()<>'kwwcrm'",
+		"DROP CONSTRAINT IF EXISTS ky_workbench_menu_page_type_ck",
+		"ADD CONSTRAINT ky_workbench_menu_page_type_ck",
+		"page_type IN ('default','webview')",
+		"page_type='default' OR route_key IS NULL",
+		"不要删除菜单、授权或 WebView 配置数据",
+	} {
+		if !strings.Contains(sql, required) {
+			t.Errorf("migration missing compatibility guard %q", required)
+		}
+	}
+	for _, forbidden := range []string{"DELETE FROM", "TRUNCATE", "DROP TABLE", "ky_permission", "ky_workbench_menu_grant"} {
+		if strings.Contains(strings.ToUpper(sql), strings.ToUpper(forbidden)) {
+			t.Errorf("migration unexpectedly changes menu data or permissions: %q", forbidden)
+		}
+	}
