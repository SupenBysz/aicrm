@@ -0,0 +1,78 @@
+import { Button, Input, Select, Space, Switch, Tag, Typography } from "antd";
+import { useState } from "react";
+import { DEFAULT_WEBVIEW_PROTOCOL_WHITELIST, normalizeWebViewProtocolWhitelist, validateWebViewProtocolAddition } from "./webview-protocol-whitelist";
+import type { WebViewProtocolGroup, WebViewProtocolWhitelist } from "./webview-protocol-whitelist";
+
+export type { WebViewProtocolWhitelist } from "./webview-protocol-whitelist";
+export type WebViewCommonSettingsValue = {
+  defaultUrl?: string;
+  scheduleMode?: string;
+  showWebViewDevTools?: boolean | null;
+  showWebWindowDevTools?: boolean | null;
+  userAgent?: string;
+  acceptLanguage?: string;
+  protocolWhitelist?: Partial<WebViewProtocolWhitelist>;
+};
+export type WebViewCommonSettingsField = "defaultUrl" | "scheduleMode" | "developerTools" | "protocolWhitelist" | "userAgent";
+
+export function validateWebViewDefaultUrl(value: string): string | null {
+  if (!value.trim()) return "请输入页面默认 URL";
+  if (value.trim() !== value) return "URL 前后不能包含空格";
+  try {
+    const url = new URL(value);
+    if ((url.protocol === "https:" || url.protocol === "http:") && url.hostname && !url.username && !url.password) return null;
+  } catch { /* invalid URL */ }
+  return "请输入有效的 HTTP 或 HTTPS URL";
+}
+
+const groups: Array<{ key: WebViewProtocolGroup; title: string; description: string }> = [
+  { key: "navigation", title: "页面与内嵌内容", description: "在当前 WebView 内处理。" },
+  { key: "webSocket", title: "WebSocket 连接", description: "允许页面通过这些协议建立 WebSocket 连接。" },
+  { key: "external", title: "外部应用", description: "交由系统默认应用处理。" }
+];
+
+export function WebViewProtocolWhitelistEditor(props: {
+  value?: Partial<WebViewProtocolWhitelist> | null;
+  disabled?: boolean;
+  onChange: (value: WebViewProtocolWhitelist) => void;
+}) {
+  const [draft, setDraft] = useState<Record<WebViewProtocolGroup, string>>({ navigation: "", webSocket: "", external: "" });
+  const [error, setError] = useState<Partial<Record<WebViewProtocolGroup, string>>>({});
+  const value = normalizeWebViewProtocolWhitelist(props.value);
+  const add = (key: WebViewProtocolGroup) => {
+    const result = validateWebViewProtocolAddition(key, draft[key], value);
+    if ("error" in result) { setError(current => ({ ...current, [key]: result.error })); return; }
+    props.onChange({ ...value, [key]: [...value[key], result.protocol] });
+    setDraft(current => ({ ...current, [key]: "" })); setError(current => ({ ...current, [key]: undefined }));
+  };
+  return <Space direction="vertical" size={10} style={{ width: "100%" }}>
+    <Space style={{ width: "100%", justifyContent: "space-between" }}><Typography.Text strong>协议白名单</Typography.Text>
+      <Button size="small" disabled={props.disabled} onClick={() => { props.onChange({ ...DEFAULT_WEBVIEW_PROTOCOL_WHITELIST, navigation: [...DEFAULT_WEBVIEW_PROTOCOL_WHITELIST.navigation], webSocket: [...DEFAULT_WEBVIEW_PROTOCOL_WHITELIST.webSocket], external: [...DEFAULT_WEBVIEW_PROTOCOL_WHITELIST.external] }); setError({}); }}>恢复默认</Button>
+    </Space>
+    {groups.map(group => <div key={group.key} style={{ border: "1px solid var(--ant-color-border-secondary)", borderRadius: 4, padding: 10 }}>
+      <Space direction="vertical" size={6} style={{ width: "100%" }}><Typography.Text strong>{group.title}</Typography.Text><Typography.Text type="secondary">{group.description}</Typography.Text>
+        <Space size={[4, 4]} wrap>{value[group.key].length ? value[group.key].map(item => <Tag key={item} closable={!props.disabled} onClose={event => { event.preventDefault(); props.onChange({ ...value, [group.key]: value[group.key].filter(current => current !== item) }); }}>{item}</Tag>) : <Typography.Text type="secondary">未允许任何协议</Typography.Text>}</Space>
+        <Space.Compact style={{ width: "100%" }}><Input value={draft[group.key]} disabled={props.disabled} placeholder={group.key === "external" ? "添加外部协议，例如 tel 或 custom+app" : "添加协议"} onChange={event => setDraft(current => ({ ...current, [group.key]: event.target.value }))} onPressEnter={() => add(group.key)} /><Button disabled={props.disabled} onClick={() => add(group.key)}>添加</Button></Space.Compact>
+        {error[group.key] ? <Typography.Text type="danger">{error[group.key]}</Typography.Text> : null}
+      </Space>
+    </div>)}
+  </Space>;
+}
+
+export function WebViewCommonSettingsFields<T extends WebViewCommonSettingsValue>(props: {
+  value: T;
+  fields?: WebViewCommonSettingsField[];
+  disabled?: boolean;
+  showWindowDevTools?: boolean;
+  urlLabel?: string;
+  onChange: (patch: Partial<T>) => void;
+}) {
+  const fields = props.fields ?? ["defaultUrl", "scheduleMode", "developerTools", "protocolWhitelist"];
+  return <Space direction="vertical" size={16} style={{ width: "100%" }}>
+    {fields.includes("defaultUrl") ? <div><Typography.Text strong>{props.urlLabel ?? "默认 URL"}</Typography.Text><Input status={validateWebViewDefaultUrl(props.value.defaultUrl ?? "") ? "error" : undefined} value={props.value.defaultUrl ?? ""} disabled={props.disabled} onChange={event => props.onChange({ defaultUrl: event.target.value } as Partial<T>)} placeholder="https://example.com/" />{validateWebViewDefaultUrl(props.value.defaultUrl ?? "") ? <Typography.Text type="danger">{validateWebViewDefaultUrl(props.value.defaultUrl ?? "")}</Typography.Text> : null}</div> : null}
+    {fields.includes("scheduleMode") ? <div><Typography.Text strong>优先模式（注入）</Typography.Text><Select value={props.value.scheduleMode ?? "page_first"} disabled={props.disabled} onChange={scheduleMode => props.onChange({ scheduleMode } as Partial<T>)} options={[{ value: "page_first", label: "页面优先打开" }, { value: "strict_document_start", label: "严格保证 document_start 优先" }]} style={{ width: "100%", marginTop: 8 }} /><Typography.Paragraph type="secondary" style={{ margin: "4px 0 0" }}>页面优先打开会尽快开始导航；严格模式会等待资源校验和 document_start 注册。</Typography.Paragraph></div> : null}
+    {fields.includes("developerTools") ? <div><Typography.Text strong>开发者工具</Typography.Text><Space direction="vertical" size={8} style={{ width: "100%", marginTop: 8 }}><Switch checked={props.value.showWebViewDevTools === true} disabled={props.disabled} onChange={showWebViewDevTools => props.onChange({ showWebViewDevTools } as Partial<T>)} checkedChildren="WebView 开启" unCheckedChildren="WebView 关闭" />{props.showWindowDevTools ? <Switch checked={props.value.showWebWindowDevTools === true} disabled={props.disabled} onChange={showWebWindowDevTools => props.onChange({ showWebWindowDevTools } as Partial<T>)} checkedChildren="宿主窗口开启" unCheckedChildren="宿主窗口关闭" /> : null}</Space></div> : null}
+    {fields.includes("userAgent") ? <div><Typography.Text strong>User-Agent / Accept-Language</Typography.Text><Input.TextArea value={props.value.userAgent ?? ""} disabled={props.disabled} maxLength={2048} autoSize={{ minRows: 2, maxRows: 4 }} placeholder="自定义 User-Agent（可选）" onChange={event => props.onChange({ userAgent: event.target.value } as Partial<T>)} /><Input value={props.value.acceptLanguage ?? ""} disabled={props.disabled} maxLength={512} placeholder="Accept-Language（可选）" style={{ marginTop: 8 }} onChange={event => props.onChange({ acceptLanguage: event.target.value } as Partial<T>)} /></div> : null}
+    {fields.includes("protocolWhitelist") ? <WebViewProtocolWhitelistEditor value={props.value.protocolWhitelist} disabled={props.disabled} onChange={protocolWhitelist => props.onChange({ protocolWhitelist } as Partial<T>)} /> : null}
+  </Space>;
+}
diff --git a/packages/ky-admin-core/src/webview-protocol-whitelist.ts b/packages/ky-admin-core/src/webview-protocol-whitelist.ts
new file mode 100644
index 0000000..51e084c
--- /dev/null
+++ b/packages/ky-admin-core/src/webview-protocol-whitelist.ts
@@ -0,0 +1,48 @@
+export type WebViewProtocolWhitelist = { navigation: string[]; webSocket: string[]; external: string[] };
+export type WebViewProtocolGroup = keyof WebViewProtocolWhitelist;
+
+export const DEFAULT_WEBVIEW_PROTOCOL_WHITELIST: WebViewProtocolWhitelist = {
+  navigation: ["http", "https", "blob", "data"], webSocket: ["ws", "wss"], external: ["mailto"]
+};
+const blockedProtocols = new Set(["javascript", "vbscript", "file", "kww-plugin", "kww-offline"]);
+const protocolPattern = /^[a-z][a-z0-9+.-]{0,63}$/;
+const fixedNavigation = new Set(DEFAULT_WEBVIEW_PROTOCOL_WHITELIST.navigation);
+const fixedWebSocket = new Set(DEFAULT_WEBVIEW_PROTOCOL_WHITELIST.webSocket);
+
+export function normalizeWebViewProtocolWhitelist(value?: Partial<WebViewProtocolWhitelist> | null): WebViewProtocolWhitelist {
+  const normalize = (key: WebViewProtocolGroup) => {
+    const source = value?.[key];
+    if (!Array.isArray(source)) return [...DEFAULT_WEBVIEW_PROTOCOL_WHITELIST[key]];
+    return [...new Set(source.flatMap(item => {
+      if (typeof item !== "string") return [];
+      const protocol = item.trim().replace(/:$/, "").toLowerCase();
+      if (!protocolPattern.test(protocol) || blockedProtocols.has(protocol)) return [];
+      if (key === "navigation" && !fixedNavigation.has(protocol)) return [];
+      if (key === "webSocket" && !fixedWebSocket.has(protocol)) return [];
+      if (key === "external" && (fixedNavigation.has(protocol) || fixedWebSocket.has(protocol))) return [];
+      return [protocol];
+    }))];
+  };
+  const result = { navigation: normalize("navigation"), webSocket: normalize("webSocket"), external: normalize("external") };
+  const seen = new Set<string>();
+  for (const key of ["navigation", "webSocket", "external"] as const) {
+    result[key] = result[key].filter(protocol => { if (seen.has(protocol)) return false; seen.add(protocol); return true; });
+  }
+  return result;
+}
+
+export function validateWebViewProtocolAddition(
+  group: WebViewProtocolGroup,
+  raw: string,
+  whitelist: WebViewProtocolWhitelist
+): { protocol: string } | { error: string } {
+  const protocol = raw.trim().replace(/:$/, "").toLowerCase();
+  if (!protocolPattern.test(protocol)) return { error: "协议格式无效，请输入有效协议名。" };
+  if (blockedProtocols.has(protocol)) return { error: "该协议属于禁用或应用内部协议，不能加入白名单。" };
+  if (group === "navigation" && !fixedNavigation.has(protocol)) return { error: "页面协议仅支持 http、https、blob、data。" };
+  if (group === "webSocket" && !fixedWebSocket.has(protocol)) return { error: "WebSocket 协议仅支持 ws、wss。" };
+  if (group === "external" && (fixedNavigation.has(protocol) || fixedWebSocket.has(protocol))) return { error: "页面或 WebSocket 协议不能放入外部应用分组。" };
+  if (Object.values(whitelist).some(items => items.includes(protocol))) return { error: "该协议已在白名单中。" };
+  if (whitelist[group].length >= 32) return { error: "每类协议最多添加 32 项。" };
+  return { protocol };
+}
