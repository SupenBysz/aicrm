+	}
+	if pgErr.Code == "23505" {
+		return fmt.Errorf("%w (sqlstate=%s constraint=%s)", ErrWorkbenchMenuExists, pgErr.Code, safeConstraintName(pgErr.ConstraintName))
+	}
+	if strings.HasPrefix(pgErr.Code, "23") {
+		return fmt.Errorf("%w (sqlstate=%s constraint=%s)", ErrWorkbenchMenuConstraint, pgErr.Code, safeConstraintName(pgErr.ConstraintName))
+	}
+	return err
+}
+
+func safeConstraintName(name string) string {
+	if name == "" {
+		return "unknown"
+	}
+	for _, r := range name {
+		if !(r >= 'a' && r <= 'z') && !(r >= 'A' && r <= 'Z') && !(r >= '0' && r <= '9') && r != '_' {
+			return "unknown"
+		}
+	}
+	return name
+}
