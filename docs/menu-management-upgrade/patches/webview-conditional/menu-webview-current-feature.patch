+func validMenuWebViewBindings(items []MenuWebViewBinding) bool {
+	if len(items) > 64 {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, item := range items {
+		if !menuWebViewIdentifierPattern.MatchString(item.Identifier) || seen[item.Identifier] {
+			return false
+		}
+		seen[item.Identifier] = true
+		switch item.VersionPolicy {
+		case "latest_released":
+			if item.VersionID != "" || item.Version != "" {
+				return false
+			}
+		case "pinned":
+			if !menuWebViewAssetIDPattern.MatchString(item.VersionID) || !menuWebViewVersionPattern.MatchString(item.Version) {
+				return false
+			}
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func validMenuWebViewInput(in MenuWebViewConfigInput) bool {
+	if in.SessionSource != "ordinary" && in.SessionSource != "store" || in.OpenMode != "embedded" && in.OpenMode != "window" || strings.TrimSpace(in.DefaultURL) != in.DefaultURL || len(in.DefaultURL) > 2048 || in.DefaultURL == "" || !validMenuWebViewBindings(in.Scripts) || !validMenuWebViewBindings(in.Styles) {
+		return false
+	}
+	if in.SessionSource == "store" && (!menuWebViewUUIDPattern.MatchString(in.StoreID) || in.Platform != "") || in.SessionSource == "ordinary" && (in.StoreID != "" || in.InheritDefaultResources) {
+		return false
+	}
+	if in.SessionSource == "store" && (in.Proxy.Mode != "" && in.Proxy.Mode != "direct" || in.Proxy.UsernameConfigured || in.Proxy.PasswordConfigured || in.Proxy.Username != nil || in.Proxy.Password != nil || in.Proxy.ClearUsername || in.Proxy.ClearPassword) {
+		return false
+	}
+	if in.SessionSource == "ordinary" && (len(in.Scripts)+len(in.Styles) > 0 || in.Platform != "") && !validMenuWebViewRuntimePlatform(in.Platform) {
+		return false
+	}
+	u, err := url.Parse(in.DefaultURL)
+	if err != nil || u.User != nil || (u.Scheme != "https" && u.Scheme != "http") || u.Hostname() == "" {
+		return false
+	}
+	if in.ScheduleMode != "page_first" && in.ScheduleMode != "strict_document_start" {
+		return false
+	}
+	if in.CloseBehavior != "close_view" && in.CloseBehavior != "return_to_host" {
+		return false
+	}
+	if len(in.UserAgent) > 2048 || strings.ContainsAny(in.UserAgent, "\r\n\x00") || len(in.AcceptLanguage) > 512 || strings.ContainsAny(in.AcceptLanguage, "\r\n\x00") {
+		return false
+	}
+	if !validMenuWebViewProtocolWhitelist(in.ProtocolWhitelist) {
+		return false
+	}
+	if !validMenuWebViewProxy(in.Proxy) {
+		return false
+	}
+	return in.ExpectedRevision != nil && *in.ExpectedRevision >= 0
+}
+
+func validMenuWebViewProxy(in MenuWebViewProxyInput) bool {
+	p := in.MenuWebViewProxy
+	if p.Mode == "" {
+		p.Mode = "direct"
+	}
+	if p.Mode != "direct" && p.Mode != "system" && p.Mode != "fixed" {
+		return false
+	}
+	if p.Mode != "fixed" {
+		if p.Protocol != "" || p.Host != "" || p.Port != 0 || len(p.BypassRules) != 0 || (in.Username != nil && *in.Username != "") || (in.Password != nil && *in.Password != "") {
+			return false
+		}
+	} else if (p.Protocol != "http" && p.Protocol != "https" && p.Protocol != "socks5") || strings.TrimSpace(p.Host) != p.Host || len(p.Host) == 0 || len(p.Host) > 253 || strings.ContainsAny(p.Host, "@/\\?# \t\r\n") || p.Port < 1 || p.Port > 65535 || len(p.BypassRules) > 64 {
+		return false
+	}
+	for _, rule := range p.BypassRules {
+		if rule == "" || len(rule) > 512 || strings.TrimSpace(rule) != rule || strings.ContainsAny(rule, " \t\r\n@?#") || strings.Contains(rule, "://") {
+			return false
+		}
+	}
+	if in.Username != nil && (len(*in.Username) > 256 || strings.ContainsAny(*in.Username, "\r\n\x00")) {
+		return false
+	}
+	if in.Password != nil && (len(*in.Password) > 512 || strings.ContainsAny(*in.Password, "\r\n\x00")) {
+		return false
+	}
+	if in.ClearUsername && in.Username != nil && *in.Username != "" || in.ClearPassword && in.Password != nil && *in.Password != "" {
+		return false
+	}
+	if p.Mode != "fixed" && (p.UsernameConfigured || p.PasswordConfigured || in.ClearUsername || in.ClearPassword) {
+		return false
+	}
+	return true
+}
+
+func validMenuWebViewRuntimePlatform(value string) bool {
+	return value == "douyin" || value == "kuaishou" || value == "xiaohongshu"
+}
+
+func ValidMenuWebViewRuntimePlatform(value string) bool {
+	return validMenuWebViewRuntimePlatform(value)
+}
+
+var menuWebViewProtocolPattern = regexp.MustCompile(`^[a-z][a-z0-9+.-]{0,63}$`)
+var menuWebViewBlockedProtocols = map[string]bool{"javascript": true, "vbscript": true, "file": true, "kww-plugin": true, "kww-offline": true}
+
+func validMenuWebViewProtocolWhitelist(value MenuWebViewProtocolWhitelist) bool {
+	groups := [][]string{value.Navigation, value.WebSocket, value.External}
+	allowed := []map[string]bool{{"http": true, "https": true, "blob": true, "data": true}, {"ws": true, "wss": true}, nil}
+	seen := map[string]bool{}
+	for i, group := range groups {
+		if len(group) > 32 {
+			return false
+		}
+		for _, item := range group {
+			if !menuWebViewProtocolPattern.MatchString(item) || menuWebViewBlockedProtocols[item] || (allowed[i] != nil && !allowed[i][item]) || (i == 2 && (allowed[0][item] || allowed[1][item])) || seen[item] {
+				return false
+			}
+			seen[item] = true
+			if i == 2 {
+				if len(item) > 64 {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+func menuWebViewLeafEligible(pageType, status, workspaceType string, supportedWorkspaceTypes []string, hasNoActiveChildren bool) bool {
+	_, workspaceAllowed := stringSet(supportedWorkspaceTypes)[workspaceType]
+	return pageType == "webview" && status == "active" && workspaceAllowed && hasNoActiveChildren
+}
+
+func menuWebViewConfigLeafEligible(pageType, status, workspaceType string, supportedWorkspaceTypes []string, hasNoActiveChildren bool) bool {
+	_, workspaceAllowed := stringSet(supportedWorkspaceTypes)[workspaceType]
+	return pageType == "webview" && (status == "active" || status == "disabled") && workspaceAllowed && hasNoActiveChildren
+}
