+test("dedicated menu windows retain store UUID activity metadata and use the same API transport", async () => {
+  const ipc = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  const window = await readFile(new URL("./web-injection-window.ts", import.meta.url), "utf8");
+  assert.match(ipc, /shopId: config\.sessionSource === "store" \? config\.storeId/);
+  assert.match(ipc, /webSpaceUuid: config\.sessionSource === "store" \? config\.uuid/);
+  assert.match(ipc, /storeContext: config\.storeContext/);
+  assert.match(ipc, /\[\.\.\.activeWebInjectionWindows\(\)\]/);
+  assert.match(window, /if \(options\.webSpaceUuid\) webWindowSpaceUuids\.set\(child, options\.webSpaceUuid\)/);
+  assert.match(window, /fetchImpl: options\.fetchImpl/);
+});
