index 0000000..50fcf3d
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-subtitle.ts
@@ -0,0 +1,20 @@
+type MenuSubtitleSource = {
+  menuKey: string;
+  routeKey?: string | null;
+  routePath?: string | null;
+  nodeType?: "group" | "leaf";
+  pageType?: "default" | "webview";
+};
+
+/** Pick the secondary label shared by both menu directory tables. */
+export function menuSubtitle(item: MenuSubtitleSource): string {
+  const identifier = item.menuKey;
+
+  // WebView leaves may retain an obsolete route for compatibility; never expose it as a route.
+  if (item.pageType === "webview") return identifier;
+  if (item.nodeType === "group") return identifier;
+
+  const route = "routeKey" in item ? item.routeKey : item.routePath;
+  if (typeof route === "string" && route.trim().length > 0) return route;
+  return identifier;
+}
diff --git a/plugins/ky-access-management/src/menu-webview-api.test.mjs b/plugins/ky-access-management/src/menu-webview-api.test.mjs
new file mode 100644
index 0000000..fa0ed33
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-webview-api.test.mjs
@@ -0,0 +1,87 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { DEFAULT_WEBVIEW_PROTOCOL_WHITELIST, normalizeWebViewProtocolWhitelist, validateWebViewProtocolAddition } from "../../../packages/ky-admin-core/src/webview-protocol-whitelist.ts";
+import {
+  listMenuWebViewStores,
+  listMenuWebViewTargetWorkspaces,
+  menuWebViewWorkspaceKey,
+  parseMenuWebViewWorkspaceKey,
+  saveMenuWebViewConfig
+} from "./menu-webview-api.ts";
+
+test("target workspace choices use menu scope and store choices use the target-scoped paginated API", async () => {
+  const calls = [];
+  const client = {
+    async request(path, options) {
+      calls.push({ path, options });
+      if (path.includes("webview-targets")) {
+        return { items: [{ workspaceType: "enterprise", workspaceId: "e-1", name: "企业一" }, { workspaceType: "enterprise", workspaceId: "e-2", name: "企业二" }] };
+      }
+      const page = Number(new URL(`https://local${path}`).searchParams.get("page"));
+      return { items: [{ id: "store-1", name: "店铺一", platform: "douyin_shop" }], pagination: { page, pageSize: 100, total: 1 } };
+    }
+  };
+
+  const targets = await listMenuWebViewTargetWorkspaces(client, "workbench", "menu.example.webview");
+  const stores = await listMenuWebViewStores(client, "workbench", "menu.example.webview", "enterprise", "e-1");
+
+  assert.deepEqual(targets.map((item) => item.workspaceId), ["e-1", "e-2"]);
+  assert.deepEqual(stores, [{ id: "store-1", name: "店铺一", platform: "douyin_shop" }]);
+  assert.equal(calls[0].path, "/api/v1/menu-pages/workbench/menu.example.webview/webview-targets");
+  assert.match(calls.find((call) => call.path.includes("/shops?")).path, /\/webview\/enterprise\/e-1\/shops\?page=1&pageSize=100$/);
+  assert.doesNotMatch(calls.map((call) => call.path).join("\n"), /\/shop-management\/stores/);
+});
+
+test("workspace selector keys round-trip workspace type and identifier", () => {
+  const key = menuWebViewWorkspaceKey("enterprise", "enterprise-a::region-1");
+  assert.deepEqual(parseMenuWebViewWorkspaceKey(key), { workspaceType: "enterprise", workspaceId: "enterprise-a::region-1" });
+  assert.equal(parseMenuWebViewWorkspaceKey("invalid"), null);
+});
+
+test("saving WebView configuration sends server fields and leaves latest version selection authoritative", async () => {
+  let call;
+  const client = { async request(path, options) { call = { path, options }; return {}; } };
+  await saveMenuWebViewConfig(client, "workbench", "menu.example.webview", "enterprise", "enterprise-a", {
+    targetWorkspaceKey: "enterprise::enterprise-a",
+    storeId: "store-id", defaultUrl: "https://example.test", scheduleMode: "page_first",
+    scripts: [{ identifier: "COMMON_FUN", versionPolicy: "latest_released", versionId: "untrusted", version: "99.0.0", available: true, urlMatchers: [], runAt: "document_start", sortOrder: 1 }],
+    styles: [], inheritDefaultResources: true, closeBehavior: "close_view", revision: 3
+  });
+  const body = call.options.body;
+  assert.equal(call.path, "/api/v1/menu-pages/workbench/menu.example.webview/webview/enterprise/enterprise-a");
+  assert.equal(body.expectedRevision, 3);
+  assert.equal(body.scripts[0].versionPolicy, "latest_released");
+  assert.equal("versionId" in body.scripts[0], false);
+  assert.equal("version" in body.scripts[0], false);
+  assert.equal("available" in body.scripts[0], false);
+  assert.equal("targetWorkspaceKey" in body, false);
+  assert.equal("showWebViewDevTools" in body, false);
+});
+
+test("store-backed menu configuration never submits menu-level UA or Accept-Language overrides", async () => {
+  let call;
+  const client = { async request(path, options) { call = { path, options }; return {}; } };
+  await saveMenuWebViewConfig(client, "workbench", "menu.example.webview", "enterprise", "enterprise-a", {
+    sessionSource: "store", openMode: "embedded", storeId: "store-1", defaultUrl: "https://example.test", scheduleMode: "page_first",
+    scripts: [], styles: [], inheritDefaultResources: true, showWebViewDevTools: false,
+    userAgent: "must-not-be-sent", acceptLanguage: "must-not-be-sent", protocolWhitelist: { navigation: ["https"], webSocket: ["wss"], external: ["mailto"] },
+    proxy: { mode: "direct", bypassRules: [] }, closeBehavior: "close_view", revision: 2
+  });
+  assert.equal("userAgent" in call.options.body, false);
+  assert.equal("acceptLanguage" in call.options.body, false);
+});
+
+test("shared protocol whitelist supports defaults, custom schemes, removal, and safe validation", () => {
+  assert.deepEqual(normalizeWebViewProtocolWhitelist(), DEFAULT_WEBVIEW_PROTOCOL_WHITELIST);
+  const current = { navigation: ["https"], webSocket: ["wss"], external: ["mailto"] };
+  assert.deepEqual(validateWebViewProtocolAddition("external", "tel:", current), { protocol: "tel" });
+  assert.deepEqual(validateWebViewProtocolAddition("external", "custom+app", current), { protocol: "custom+app" });
+  assert.equal("error" in validateWebViewProtocolAddition("external", "https", current), true);
+  assert.equal("error" in validateWebViewProtocolAddition("external", "javascript", current), true);
+  assert.equal("error" in validateWebViewProtocolAddition("navigation", "custom+app", current), true);
+  const full = { navigation: Array.from({ length: 32 }, (_, index) => `https${index}`), webSocket: ["wss"], external: ["mailto"] };
+  assert.equal("error" in validateWebViewProtocolAddition("navigation", "http", full), true);
+  assert.deepEqual(normalizeWebViewProtocolWhitelist({ navigation: ["https", "https", "javascript"], webSocket: ["wss"], external: ["mailto", "tel", "tel"] }), {
+    navigation: ["https"], webSocket: ["wss"], external: ["mailto", "tel"]
+  });
+});
diff --git a/plugins/ky-access-management/src/menu-webview-api.ts b/plugins/ky-access-management/src/menu-webview-api.ts
new file mode 100644
index 0000000..cefae32
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-webview-api.ts
@@ -0,0 +1,268 @@
+import type { RequestClient } from "@ky/admin-core";
+
+export type MenuWebViewDirectory = "workbench" | "management";
+export type MenuWebViewScheduleMode = "page_first" | "strict_document_start";
+export type MenuWebViewVersionPolicy = "latest_released" | "pinned";
+export type MenuWebViewCloseBehavior = "close_view" | "return_to_host";
+export type MenuWebViewSessionSource = "ordinary" | "store";
+export type MenuWebViewOpenMode = "embedded" | "window";
+
+export interface MenuWebViewProtocolWhitelist {
+  navigation: string[];
+  webSocket: string[];
+  external: string[];
+}
+
+export interface MenuWebViewProxy {
+  mode: "direct" | "system" | "fixed";
+  protocol?: "http" | "https" | "socks5";
+  host?: string;
+  port?: number;
+  bypassRules: string[];
+  usernameConfigured: boolean;
+  passwordConfigured: boolean;
+}
+export interface MenuWebViewProxyInput extends MenuWebViewProxy {
+  username?: string;
+  password?: string;
+  clearUsername?: boolean;
+  clearPassword?: boolean;
+}
+
+export interface MenuWebViewBinding {
+  identifier: string;
+  versionId: string;
+  version: string;
+  versionPolicy?: MenuWebViewVersionPolicy;
+  available?: boolean;
+  error?: string;
+  urlMatchers: string[];
+  runAt: string;
+  sortOrder: number;
+}
+
+export interface MenuWebViewBindingOption {
+  key: string;
+  label: string;
+  binding: MenuWebViewBinding;
+  versions: MenuWebViewBinding[];
+}
+
+export interface MenuWebViewConfig {
+  directoryType: MenuWebViewDirectory;
+  menuKey: string;
+  workspaceType: string;
+  workspaceId: string;
+  sessionSource: MenuWebViewSessionSource;
+  openMode: MenuWebViewOpenMode;
+  storeId?: string;
+  platform?: string;
+  defaultUrl: string;
+  scheduleMode: MenuWebViewScheduleMode;
+  scripts: MenuWebViewBinding[];
+  styles: MenuWebViewBinding[];
+  inheritDefaultResources: boolean;
+  showWebViewDevTools: boolean;
+  userAgent?: string;
+  acceptLanguage?: string;
+  protocolWhitelist: MenuWebViewProtocolWhitelist;
+  proxy: MenuWebViewProxy;
+  usageScope: "browser_and_client" | "client_only";
+  usageReasons: string[];
+  closeBehavior: MenuWebViewCloseBehavior;
+  revision: number;
+  updatedAt?: string;
+}
+
+export type MenuWebViewConfigInput = Pick<MenuWebViewConfig,
+  "sessionSource" | "openMode" | "storeId" | "platform" | "defaultUrl" | "scheduleMode" | "scripts" | "styles" | "inheritDefaultResources" | "showWebViewDevTools" | "userAgent" | "acceptLanguage" | "protocolWhitelist" | "closeBehavior"> & { proxy: MenuWebViewProxyInput };
+
+export interface MenuWebViewStore {
+  id: string;
+  name: string | null;
+  platform: string;
+}
+
+export interface MenuWebViewTargetWorkspace {
+  workspaceType: string;
+  workspaceId: string;
+  name: string;
+}
+
+interface PageListResult<T> { items: T[]; pagination?: { page?: number; pageSize?: number; total?: number }; }
+interface ScriptSource {
+  id: string;
+  identifier: string;
+  name: string;
+  matchUrl: string;
+  matchRules?: Array<{ pattern: string; enabled: boolean; sortOrder?: number }>;
+  runAt: string;
+  priority: number;
+}
+interface ScriptAsset {
+  id: string;
+  version: string;
+  runAt: string;
+  enabled: boolean;
+  status: string;
+}
+
+function requestIdempotencyKey(): string {
+  return `menu-webview-${crypto.randomUUID()}`;
+}
+
+function configPath(directoryType: MenuWebViewDirectory, menuKey: string, workspaceType: string, workspaceId: string): string {
+  return `/api/v1/menu-pages/${directoryType}/${encodeURIComponent(menuKey)}/webview/${encodeURIComponent(workspaceType)}/${encodeURIComponent(workspaceId)}`;
+}
+
+export function menuWebViewWorkspaceKey(workspaceType: string, workspaceId: string): string {
+  return `${workspaceType}::${workspaceId}`;
+}
+
+export function parseMenuWebViewWorkspaceKey(value: string): { workspaceType: string; workspaceId: string } | null {
+  const separator = value.indexOf("::");
+  if (separator <= 0 || separator + 2 >= value.length) return null;
+  return { workspaceType: value.slice(0, separator), workspaceId: value.slice(separator + 2) };
+}
+
+async function listAllPages<T>(client: RequestClient, path: (page: number) => string, signal?: AbortSignal): Promise<T[]> {
+  const items: T[] = [];
+  const pageSize = 100;
+  for (let page = 1; ; page++) {
+    const result = await client.request<PageListResult<T>>(path(page), { signal });
+    items.push(...result.items);
+    const total = result.pagination?.total;
+    if (typeof total === "number" ? items.length >= total : result.items.length < pageSize) break;
+  }
+  return items;
+}
+
+export function listMenuWebViewTargetWorkspaces(
+  client: RequestClient,
+  directoryType: MenuWebViewDirectory,
+  menuKey: string,
+  signal?: AbortSignal
+): Promise<MenuWebViewTargetWorkspace[]> {
+  return client.request<{ items: MenuWebViewTargetWorkspace[] }>(`/api/v1/menu-pages/${directoryType}/${encodeURIComponent(menuKey)}/webview-targets`, { signal }).then(result => result.items ?? []);
+}
+
+export function getMenuWebViewConfig(
+  client: RequestClient,
+  directoryType: MenuWebViewDirectory,
+  menuKey: string,
+  workspaceType: string,
+  workspaceId: string
+): Promise<MenuWebViewConfig> {
+  return client.request<MenuWebViewConfig>(configPath(directoryType, menuKey, workspaceType, workspaceId), { headers: { "Cache-Control": "no-cache" } }).catch(error => {
+    const code = error && typeof error === "object" && "code" in error ? String((error as { code: unknown }).code) : "";
+    if (code !== "not_found" && code !== "menu_webview_config_not_found") throw error;
+    return {
+      directoryType, menuKey, workspaceType, workspaceId, sessionSource: "store", openMode: "embedded", storeId: "", defaultUrl: "", scheduleMode: "page_first",
+      scripts: [], styles: [], inheritDefaultResources: true, showWebViewDevTools: false, userAgent: "", acceptLanguage: "",
+      protocolWhitelist: { navigation: ["http", "https", "blob", "data"], webSocket: ["ws", "wss"], external: ["mailto"] }, proxy: { mode: "direct", bypassRules: [], usernameConfigured: false, passwordConfigured: false }, usageScope: "client_only", usageReasons: [], closeBehavior: "close_view", revision: 0
+    };
+  });
+}
+
+export function putMenuWebViewConfig(
+  client: RequestClient,
+  current: Pick<MenuWebViewConfig, "directoryType" | "menuKey" | "workspaceType" | "workspaceId" | "revision">,
+  input: MenuWebViewConfigInput
+): Promise<MenuWebViewConfig> {
+  const cleanBindings = (items: MenuWebViewBinding[]) => items.map(({ identifier, versionPolicy, versionId, version, urlMatchers, runAt, sortOrder }) => ({
+    identifier,
+    versionPolicy: versionPolicy ?? "pinned",
+    ...(versionPolicy === "latest_released" ? {} : { versionId, version }),
+    urlMatchers,
+    runAt,
+    sortOrder
+  }));
+  return client.request(configPath(current.directoryType, current.menuKey, current.workspaceType, current.workspaceId), {
+    method: "PUT",
+    headers: { "Idempotency-Key": requestIdempotencyKey() },
+    body: { ...input, scripts: cleanBindings(input.scripts), styles: cleanBindings(input.styles), expectedRevision: current.revision }
+  });
+}
+
+export function saveMenuWebViewConfig(
+  client: RequestClient,
+  directoryType: MenuWebViewDirectory,
+  menuKey: string,
+  workspaceType: string,
+  workspaceId: string,
+  value: MenuWebViewConfigInput & { revision: number; targetWorkspaceKey?: string }
+): Promise<MenuWebViewConfig> {
+  const { revision, targetWorkspaceKey: _targetWorkspaceKey, ...input } = value;
+  const current = { directoryType, menuKey, workspaceType, workspaceId, revision };
+  if (input.sessionSource === "store") {
+    const { userAgent: _userAgent, acceptLanguage: _acceptLanguage, ...storeInput } = input;
+    return putMenuWebViewConfig(client, current, storeInput);
+  }
+  return putMenuWebViewConfig(client, current, input);
+}
+
+export function listMenuWebViewStores(
+  client: RequestClient,
+  directoryType: MenuWebViewDirectory,
+  menuKey: string,
+  workspaceType: string,
+  workspaceId: string,
+  signal?: AbortSignal
+): Promise<MenuWebViewStore[]> {
+  const path = `/api/v1/menu-pages/${directoryType}/${encodeURIComponent(menuKey)}/webview/${encodeURIComponent(workspaceType)}/${encodeURIComponent(workspaceId)}/shops`;
+  return listAllPages(client, page => `${path}?page=${page}&pageSize=100`, signal);
+}
+
+function compareVersion(left: string, right: string): number {
+  const a = left.split(".");
+  const b = right.split(".");
+  for (let index = 0; index < 3; index++) {
+    const leftPart = a[index] ?? "0";
+    const rightPart = b[index] ?? "0";
+    if (leftPart.length !== rightPart.length) return leftPart.length - rightPart.length;
+    if (leftPart !== rightPart) return leftPart < rightPart ? -1 : 1;
+  }
+  return 0;
+}
+
+function urlMatchers(script: ScriptSource): string[] {
+  const configured = (script.matchRules ?? [])
+    .filter(rule => rule.enabled)
+    .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
+    .map(rule => rule.pattern.trim())
+    .filter(Boolean);
+  return configured.length ? configured : script.matchUrl ? [script.matchUrl] : [];
+}
+
+export async function listMenuWebViewBindingOptions(
+  client: RequestClient,
+  assetType: "script" | "style",
+  signal?: AbortSignal
+): Promise<MenuWebViewBindingOption[]> {
+  const result = await client.request<{ items: ScriptSource[] }>("/api/v1/matrix-account-douyin-scripts?page=1&pageSize=200&status=enabled", { signal });
+  const options = await Promise.all(result.items.map(async script => {
+    const assets = await client.request<ScriptAsset[]>(`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(script.id)}/assets?assetType=${assetType}`, { signal });
+    const versions = assets
