+func (s *Server) putMenuWebViewConfig(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	dir, key, wt, wi, ok := menuWebViewTarget(r)
+	if !ok {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "菜单页面配置参数无效")
+		return
+	}
+	in, decodeErr := decodeMenuWebViewConfigInput(w, r)
+	if decodeErr != nil {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "菜单页面配置参数无效")
+		return
+	}
+	if in.SessionSource == "" {
+		in.SessionSource = "store"
+	}
+	if in.Proxy.Mode == "" {
+		in.Proxy.Mode = "direct"
+	}
+	if in.Proxy.BypassRules == nil {
+		in.Proxy.BypassRules = []string{}
+	}
+	if in.SessionSource == "store" && !s.validateMenuWebViewStore(r.Context(), wt, wi, in.StoreID) {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "绑定店铺与目标工作区不匹配")
+		return
+	}
+	// Credentials are write-only: never include them in the idempotency receipt,
+	// audit before/after snapshots, or the configuration response.
+	credentialInput := store.MenuWebViewProxyCredentials{Username: in.Proxy.Username, Password: in.Proxy.Password, ClearUsername: in.Proxy.ClearUsername, ClearPassword: in.Proxy.ClearPassword}
+	before, beforeErr := s.store.GetMenuWebViewConfig(r.Context(), dir, key, wt, wi)
+	if beforeErr != nil && !errors.Is(beforeErr, store.ErrNotFound) {
+		// A failed read must not be mistaken for an empty configuration before a
+		// revisioned write; otherwise a transient store error could clear state.
+		writeError(w, r, http.StatusServiceUnavailable, "menu_webview_config_unavailable", "菜单页面配置暂不可用，请稍后重试")
+		return
+	}
+	if beforeErr == nil {
+		in.Proxy.UsernameConfigured = before.Proxy.UsernameConfigured
+		in.Proxy.PasswordConfigured = before.Proxy.PasswordConfigured
+		in.ProxySecretVersionID = before.ProxySecretVersionID
+	}
+	if credentialInput.ClearUsername || credentialInput.Username != nil {
+		in.Proxy.UsernameConfigured = !credentialInput.ClearUsername && credentialInput.Username != nil && *credentialInput.Username != ""
+	}
+	if credentialInput.ClearPassword || credentialInput.Password != nil {
+		in.Proxy.PasswordConfigured = !credentialInput.ClearPassword && credentialInput.Password != nil && *credentialInput.Password != ""
+	}
+	fingerprint, fingerprintErr := menuWebViewCredentialFingerprint(credentialInput, s.cfg.InternalToken)
+	if fingerprintErr != nil {
+		writeError(w, r, http.StatusServiceUnavailable, "proxy_credentials_unavailable", "代理凭据服务暂不可用，请稍后重试")
+		return
+	}
+	safeInput := menuWebViewSafeIdempotencyInput(in)
+	payload := struct {
+		Directory             string                       `json:"directory"`
+		Key                   string                       `json:"key"`
+		WorkspaceType         string                       `json:"workspaceType"`
+		WorkspaceID           string                       `json:"workspaceId"`
+		Input                 store.MenuWebViewConfigInput `json:"input"`
+		CredentialFingerprint string                       `json:"credentialFingerprint,omitempty"`
+	}{dir, key, wt, wi, safeInput, fingerprint}
+	if s.replayWorkbenchResponse(w, r, wsContext{UserID: wc.UserID, WorkspaceType: wt, WorkspaceID: wi}, "menu-webview.update", payload) {
+		return
+	}
+	proxySaveFailed := false
+	var beforeCommit func(string) (string, error)
+	if credentialInput.Username != nil || credentialInput.Password != nil || credentialInput.ClearUsername || credentialInput.ClearPassword {
+		beforeCommit = func(baseVersionID string) (string, error) {
+			versionID, err := s.saveMenuWebViewProxyCredentials(r.Context(), wt, wi, dir, key, baseVersionID, credentialInput)
+			if err != nil {
+				proxySaveFailed = true
+				return "", err
+			}
+			return versionID, nil
+		}
+	}
+	item, err := s.store.PutMenuWebViewConfigWithBeforeCommit(r.Context(), dir, key, wt, wi, wc.UserID, in, beforeCommit)
+	if err != nil {
+		s.auditWorkbenchResult(r, wc, "menu_webview.updated", "menu_webview", dir+":"+key, "failure")
+		if proxySaveFailed {
+			writeError(w, r, http.StatusServiceUnavailable, "proxy_credentials_unavailable", "代理凭据未能安全保存，请重试")
+			return
+		}
+		writeMenuWebViewError(w, r, err)
+		return
+	}
+	s.auditWorkbenchMutation(r, wc, "menu_webview.updated", "menu_webview", dir+":"+key, before, item)
+	if !s.saveWorkbenchResponse(w, r, wsContext{UserID: wc.UserID, WorkspaceType: wt, WorkspaceID: wi}, "menu-webview.update", payload, item) {
+		return
+	}
+	writeData(w, r, item)
+}
+
+func menuWebViewSafeIdempotencyInput(in store.MenuWebViewConfigInput) store.MenuWebViewConfigInput {
+	in.Proxy.Username, in.Proxy.Password = nil, nil
+	in.Proxy.ClearUsername, in.Proxy.ClearPassword = false, false
+	return in
+}
+
+func menuWebViewCredentialFingerprint(input store.MenuWebViewProxyCredentials, key string) (string, error) {
+	changed := input.Username != nil || input.Password != nil || input.ClearUsername || input.ClearPassword
+	if !changed {
+		return "", nil
+	}
+	if key == "" {
+		return "", errors.New("proxy_credentials_idempotency_key_unavailable")
+	}
+	canonical, err := json.Marshal(struct {
+		Username      *string `json:"username"`
+		Password      *string `json:"password"`
+		ClearUsername bool    `json:"clearUsername"`
+		ClearPassword bool    `json:"clearPassword"`
+	}{input.Username, input.Password, input.ClearUsername, input.ClearPassword})
+	if err != nil {
+		return "", err
+	}
+	mac := hmac.New(sha256.New, []byte(key))
+	_, _ = mac.Write(canonical)
+	return hex.EncodeToString(mac.Sum(nil)), nil
+}
+
+func (s *Server) saveMenuWebViewProxyCredentials(ctx context.Context, workspaceType, workspaceID, directory, menuKey, baseVersionID string, input store.MenuWebViewProxyCredentials) (string, error) {
+	base, err := url.Parse(s.cfg.ShopManagementURL)
+	if err != nil || base.Host == "" || base.User != nil || base.RawQuery != "" || base.Fragment != "" || (base.Scheme != "https" && !(base.Scheme == "http" && (base.Hostname() == "127.0.0.1" || base.Hostname() == "localhost"))) {
+		return "", errors.New("internal_config")
+	}
+	payload := map[string]any{"workspaceType": workspaceType, "workspaceId": workspaceID, "directoryType": directory, "menuKey": menuKey, "baseVersionId": baseVersionID, "username": input.Username, "password": input.Password, "clearUsername": input.ClearUsername, "clearPassword": input.ClearPassword}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return "", err
+	}
+	u := *base
+	u.Path = "/internal/v1/menu-webview/proxy-credential-versions"
+	cancelCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(cancelCtx, http.MethodPost, u.String(), bytes.NewReader(body))
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Request-Id", "menu-webview-proxy-credentials")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.InternalToken)
+	transport := &http.Transport{Proxy: nil}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 2 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	res, err := client.Do(req)
+	if err != nil {
+		return "", errors.New("proxy_credentials_unavailable")
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return "", errors.New("proxy_credentials_rejected")
+	}
+	var reply struct {
+		Data struct {
+			SecretVersionID string `json:"secretVersionId"`
+		} `json:"data"`
+	}
+	d := json.NewDecoder(io.LimitReader(res.Body, 16*1024))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&reply); err != nil || d.Decode(new(any)) != io.EOF || !store.ValidMenuWebViewProxySecretVersionID(reply.Data.SecretVersionID) {
+		return "", errors.New("proxy_credentials_response_invalid")
+	}
+	return reply.Data.SecretVersionID, nil
+}
+
+func decodeMenuWebViewConfigInput(w http.ResponseWriter, r *http.Request) (store.MenuWebViewConfigInput, error) {
+	r.Body = http.MaxBytesReader(w, r.Body, 64*1024)
+	var in store.MenuWebViewConfigInput
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(&in); err != nil {
+		return store.MenuWebViewConfigInput{}, err
+	}
+	if err := d.Decode(new(any)); err != io.EOF {
+		return store.MenuWebViewConfigInput{}, errors.New("multiple JSON values")
+	}
+	return in, nil
+}
+
+func (s *Server) validateMenuWebViewStore(ctx context.Context, workspaceType, workspaceID, storeID string) bool {
+	base, err := url.Parse(s.cfg.ShopManagementURL)
+	if err != nil || base.Host == "" || base.User != nil || base.RawQuery != "" || base.Fragment != "" || (base.Scheme != "https" && !(base.Scheme == "http" && (base.Hostname() == "127.0.0.1" || base.Hostname() == "localhost"))) {
+		return false
+	}
+	body, _ := json.Marshal(map[string]string{"workspaceType": workspaceType, "workspaceId": workspaceID, "storeId": storeID})
+	u := *base
+	u.Path = "/internal/v1/menu-webview/store-check"
+	c, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(c, http.MethodPost, u.String(), bytes.NewReader(body))
+	if err != nil {
+		return false
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-KY-Internal-Token", s.cfg.InternalToken)
+	req.Header.Set("X-KY-Request-Id", "menu-config-check")
+	tr := &http.Transport{Proxy: nil}
+	defer tr.CloseIdleConnections()
+	client := &http.Client{Transport: tr, Timeout: 2 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	res, err := client.Do(req)
+	if err != nil {
+		return false
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return false
+	}
+	var out struct {
+		Data struct {
+			Allowed       bool   `json:"allowed"`
+			WorkspaceType string `json:"workspaceType"`
+			WorkspaceID   string `json:"workspaceId"`
+			StoreID       string `json:"storeId"`
+		} `json:"data"`
+	}
+	d := json.NewDecoder(io.LimitReader(res.Body, 16*1024))
+	return d.Decode(&out) == nil && out.Data.Allowed && out.Data.WorkspaceType == workspaceType && out.Data.WorkspaceID == workspaceID && out.Data.StoreID == storeID
+}
+
+func (s *Server) internalMenuWebViewAuthorize(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	if s.cfg.InternalToken == "" {
+		writeError(w, r, 503, "internal_auth_unavailable", "内部认证未配置")
+		return
+	}
+	got := r.Header.Get("X-KY-Internal-Token")
+	if len(got) != len(s.cfg.InternalToken) || subtle.ConstantTimeCompare([]byte(got), []byte(s.cfg.InternalToken)) != 1 {
+		writeError(w, r, 401, "internal_unauthorized", "内部认证失败")
+		return
+	}
+	if r.Header.Get("Authorization") != "" || r.Header.Get("X-KY-Workspace-Type") != "" || r.Header.Get("X-KY-Workspace-Id") != "" || strings.TrimSpace(r.Header.Get("X-KY-Request-Id")) == "" {
+		writeError(w, r, 400, "internal_header_forbidden", "内部请求上下文无效")
+		return
+	}
+	var in struct {
+		UserID        string `json:"userId"`
+		MembershipID  string `json:"membershipId"`
+		WorkspaceType string `json:"workspaceType"`
+		WorkspaceID   string `json:"workspaceId"`
+		DirectoryType string `json:"directoryType"`
+		MenuKey       string `json:"menuKey"`
+	}
+	d := json.NewDecoder(http.MaxBytesReader(w, r.Body, 8*1024))
+	d.DisallowUnknownFields()
+	if d.Decode(&in) != nil || d.Decode(new(any)) != io.EOF || in.UserID == "" || in.MembershipID == "" || !store.ValidMenuWebViewTarget(in.WorkspaceType, in.WorkspaceID) || (in.DirectoryType != "workbench" && in.DirectoryType != "management") {
+		writeError(w, r, 400, "validation_error", "菜单授权参数无效")
+		return
+	}
+	if s.store == nil {
+		writeError(w, r, http.StatusServiceUnavailable, "service_unavailable", "菜单授权存储不可用")
+		return
+	}
+	allowed, err := effectiveMenuWebViewAccess(r.Context(), s.store, in.UserID, in.MembershipID, in.WorkspaceType, in.WorkspaceID, in.DirectoryType, in.MenuKey)
+	if err != nil {
+		writeError(w, r, http.StatusServiceUnavailable, "authorization_unavailable", "菜单授权服务暂不可用")
+		return
+	}
+	if !allowed {
+		writeData(w, r, map[string]any{"authorized": false, "errorCode": "permission_denied", "workspaceType": in.WorkspaceType, "workspaceId": in.WorkspaceID, "menuKey": in.MenuKey})
+		return
+	}
+	active, err := s.store.MenuWebViewRuntimeEnabled(r.Context(), in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID)
+	if err != nil {
+		writeError(w, r, http.StatusServiceUnavailable, "menu_state_unavailable", "菜单状态暂不可用")
+		return
+	}
+	if !active {
+		writeData(w, r, map[string]any{"authorized": false, "errorCode": "menu_not_webview", "workspaceType": in.WorkspaceType, "workspaceId": in.WorkspaceID, "menuKey": in.MenuKey})
+		return
+	}
+	item, err := s.store.GetMenuWebViewConfig(r.Context(), in.DirectoryType, in.MenuKey, in.WorkspaceType, in.WorkspaceID)
+	if err != nil {
+		if !errors.Is(err, store.ErrValidation) && !errors.Is(err, store.ErrNotFound) {
+			writeError(w, r, http.StatusServiceUnavailable, "authorization_unavailable", "菜单授权服务暂不可用")
+			return
+		}
+		code := "not_found"
+		if errors.Is(err, store.ErrValidation) {
+			code = "validation_error"
+		}
+		writeData(w, r, map[string]any{"authorized": false, "errorCode": code, "workspaceType": in.WorkspaceType, "workspaceId": in.WorkspaceID, "menuKey": in.MenuKey})
+		return
+	}
+	writeData(w, r, map[string]any{"authorized": true, "workspaceType": in.WorkspaceType, "workspaceId": in.WorkspaceID, "menuKey": in.MenuKey, "config": item, "proxySecretVersionId": item.ProxySecretVersionID})
+}
+
+type menuWebViewAccessStore interface {
+	EffectiveWorkbenchMenuKeys(context.Context, string, string, string, string) ([]string, error)
+	EffectiveManagementMenuKeys(context.Context, string, string, string, string) ([]string, []string, []string, error)
+}
+
+func effectiveMenuWebViewAccess(ctx context.Context, st menuWebViewAccessStore, userID, membershipID, workspaceType, workspaceID, directory, menuKey string) (bool, error) {
+	switch directory {
+	case "workbench":
+		keys, err := st.EffectiveWorkbenchMenuKeys(ctx, userID, membershipID, workspaceType, workspaceID)
+		return containsMenuWebViewKey(keys, menuKey), err
+	case "management":
+		_, _, keys, err := st.EffectiveManagementMenuKeys(ctx, userID, membershipID, workspaceType, workspaceID)
+		return containsMenuWebViewKey(keys, menuKey), err
+	default:
+		return false, store.ErrValidation
+	}
+}
+
+func containsMenuWebViewKey(items []string, key string) bool {
+	for _, v := range items {
+		if v == key {
+			return true
+		}
+	}
+	return false
+}
+
+func writeMenuWebViewError(w http.ResponseWriter, r *http.Request, err error) {
+	switch {
+	case errors.Is(err, store.ErrValidation):
+		writeError(w, r, 400, "validation_error", "菜单页面配置无效")
+	case errors.Is(err, store.ErrConflict):
+		writeError(w, r, 409, "conflict", "菜单页面配置已变化，请刷新后重试")
+	case errors.Is(err, store.ErrNotFound):
+		writeError(w, r, 404, "not_found", "菜单页面配置不存在或不可访问")
+	default:
+		writeError(w, r, 500, "internal_error", "菜单页面配置操作失败")
+	}
+}
