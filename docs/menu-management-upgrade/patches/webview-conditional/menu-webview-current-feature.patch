+// ListMenuWebViewTargets returns only active workspaces supported by an active
+// WebView leaf. The caller must still authorize the platform menu-management
+// request before exposing these options.
+func (s *Store) ListMenuWebViewTargets(ctx context.Context, directory, key string) ([]MenuAllowlistWorkspaceOption, error) {
+	if (directory != "workbench" && directory != "management") || !workbenchMenuKeyPattern.MatchString(key) {
+		return nil, ErrValidation
+	}
+	var raw []byte
+	var err error
+	switch directory {
+	case "workbench":
+		err = s.db.QueryRowContext(ctx, workbenchMenuWebViewTargetsQuery, key).Scan(&raw)
+	case "management":
+		err = s.db.QueryRowContext(ctx, managementMenuWebViewTargetsQuery, key).Scan(&raw)
+	}
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	var supported []string
+	if err := json.Unmarshal(raw, &supported); err != nil {
+		return nil, err
+	}
+	options, err := s.ListMenuAllowlistWorkspaceOptions(ctx, "platform", "platform_root")
+	if err != nil {
+		return nil, err
+	}
+	allowed := stringSet(supported)
+	out := make([]MenuAllowlistWorkspaceOption, 0, len(options))
+	for _, option := range options {
+		if _, ok := allowed[option.WorkspaceType]; ok {
+			out = append(out, option)
+		}
+	}
+	return out, nil
+}
