+func (s *Store) GetMenuWebViewConfig(ctx context.Context, directory, key, workspaceType, workspaceID string) (MenuWebViewConfig, error) {
+	if directory != "workbench" && directory != "management" || !workbenchMenuKeyPattern.MatchString(key) || !validWorkbenchWorkspaceType(workspaceType) || workspaceID == "" {
+		return MenuWebViewConfig{}, ErrValidation
+	}
+	var out MenuWebViewConfig
+	out.DirectoryType = directory
+	out.MenuKey = key
+	out.WorkspaceType = workspaceType
+	out.WorkspaceID = workspaceID
+	var exists bool
+	err := s.db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM ky_menu_webview_config WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4)`, directory, key, workspaceType, workspaceID).Scan(&exists)
+	if err != nil {
+		return out, err
+	}
+	if !exists {
+		return out, ErrNotFound
+	}
+	var leaf bool
+	if directory == "workbench" {
+		err = s.db.QueryRowContext(ctx, workbenchMenuWebViewConfigLeafQuery, key, workspaceType).Scan(&leaf)
+	} else {
+		err = s.db.QueryRowContext(ctx, managementMenuWebViewConfigLeafQuery, key, workspaceType).Scan(&leaf)
+	}
+	if errors.Is(err, sql.ErrNoRows) || !leaf {
+		return out, ErrNotFound
+	}
+	if err != nil {
+		return out, err
+	}
+	var scripts, styles, protocolWhitelist, proxy []byte
+	err = s.db.QueryRowContext(ctx, `SELECT COALESCE(session_source,'store'),COALESCE(open_mode,'embedded'),COALESCE(store_id::text,''),COALESCE(runtime_platform,''),default_url,schedule_mode,scripts,styles,inherit_default_resources,show_web_view_dev_tools,COALESCE(user_agent,''),COALESCE(accept_language,''),COALESCE(protocol_whitelist,'{"navigation":["http","https","blob","data"],"webSocket":["ws","wss"],"external":["mailto"]}'::jsonb),close_behavior,COALESCE(proxy,'{"mode":"direct","bypassRules":[]}'::jsonb),revision,COALESCE(proxy_secret_version_id::text,'') FROM ky_menu_webview_config WHERE directory_type=$1 AND menu_key=$2 AND workspace_type=$3 AND workspace_id=$4`, directory, key, workspaceType, workspaceID).Scan(&out.SessionSource, &out.OpenMode, &out.StoreID, &out.Platform, &out.DefaultURL, &out.ScheduleMode, &scripts, &styles, &out.InheritDefaultResources, &out.ShowWebViewDevTools, &out.UserAgent, &out.AcceptLanguage, &protocolWhitelist, &out.CloseBehavior, &proxy, &out.Revision, &out.ProxySecretVersionID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return out, ErrNotFound
+	}
+	if err != nil {
+		return out, err
+	}
+	if err = json.Unmarshal(scripts, &out.Scripts); err != nil {
+		return out, err
+	}
+	if err = json.Unmarshal(styles, &out.Styles); err != nil {
+		return out, err
+	}
+	if err = json.Unmarshal(protocolWhitelist, &out.ProtocolWhitelist); err != nil {
+		return out, err
+	}
+	if err = json.Unmarshal(proxy, &out.Proxy); err != nil {
+		return out, err
+	}
+	out.UsageScope, out.UsageReasons = menuWebViewUsage(out)
+	return out, nil
+}
