+func (s *Store) MenuWebViewRuntimeEnabled(ctx context.Context, directory, key, workspaceType, workspaceID string) (bool, error) {
+	if (directory != "workbench" && directory != "management") || !workbenchMenuKeyPattern.MatchString(key) || !ValidMenuWebViewTarget(workspaceType, workspaceID) {
+		return false, ErrValidation
+	}
+	var status, pageType string
+	var raw []byte
+	var leaf bool
+	query := `SELECT COALESCE(m.page_type,'default'),m.status,m.workspace_types,NOT EXISTS(SELECT 1 FROM ky_workbench_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_workbench_menu m WHERE m.menu_key=$1`
+	if directory == "management" {
+		query = `SELECT COALESCE(m.page_type,'default'),m.status,m.workspace_types,NOT EXISTS(SELECT 1 FROM ky_management_menu child WHERE child.parent_key=m.menu_key AND child.status='active') FROM ky_management_menu m WHERE m.menu_key=$1`
+	}
+	err := s.db.QueryRowContext(ctx, query, key).Scan(&pageType, &status, &raw, &leaf)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	var types []string
+	if json.Unmarshal(raw, &types) != nil {
+		return false, ErrValidation
+	}
+	return menuWebViewLeafEligible(pageType, status, workspaceType, types, leaf), nil
+}
