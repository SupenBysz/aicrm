index 0000000..88d6702
--- /dev/null
+++ b/plugins/ky-access-management/src/menu-subtitle.test.mjs
@@ -0,0 +1,21 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { menuSubtitle } from "./menu-subtitle.ts";
+
+test("workbench and management menu subtitles share group, route, fallback, and WebView rules", () => {
+  const workbenchGroup = { menuKey: "group.workbench", nodeType: "group", pageType: "default", routeKey: null };
+  const workbenchPage = { menuKey: "menu.workbench.orders", nodeType: "leaf", pageType: "default", routeKey: "workbench.orders" };
+  const managementPage = { menuKey: "menu.platform.access.roles", nodeType: "leaf", pageType: "default", routePath: "/roles" };
+  const noRoute = { menuKey: "menu.workbench.legacy", nodeType: "leaf", pageType: "default", routeKey: "  " };
+  const webViewWithLegacyRoute = { menuKey: "menu.workbench.embedded", nodeType: "leaf", pageType: "webview", routeKey: "workbench.old-page" };
+  const webViewWithManagementRoute = { menuKey: "menu.platform.embedded", nodeType: "leaf", pageType: "webview", routePath: "/old-page" };
+  const legacyGroup = { menuKey: "group.management", pageType: "default", routePath: null };
+
+  assert.equal(menuSubtitle(workbenchGroup), "group.workbench");
+  assert.equal(menuSubtitle(workbenchPage), "workbench.orders");
+  assert.equal(menuSubtitle(managementPage), "/roles");
+  assert.equal(menuSubtitle(noRoute), "menu.workbench.legacy");
+  assert.equal(menuSubtitle(webViewWithLegacyRoute), "menu.workbench.embedded");
+  assert.equal(menuSubtitle(webViewWithManagementRoute), "menu.platform.embedded");
+  assert.equal(menuSubtitle(legacyGroup), "group.management");
+});
diff --git a/plugins/ky-access-management/src/menu-subtitle.ts b/plugins/ky-access-management/src/menu-subtitle.ts
