+);
+REVOKE ALL ON ky_shop_management.ky_menu_webview_proxy_secret FROM PUBLIC;
+GRANT SELECT,INSERT,UPDATE ON ky_shop_management.ky_menu_webview_proxy_secret TO ky_shop_management_app;
+
+-- 回滚：先停用并备份菜单代理配置及本表，再删除表；不得删除 keyring 主密钥。
