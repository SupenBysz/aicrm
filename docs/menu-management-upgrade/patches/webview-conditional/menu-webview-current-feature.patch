+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+test("menu WebView open is a main-only scoped IPC and does not trust renderer store identity", async () => {
+  const source = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  assert.match(source, /scopedIpc\(\["main"\]/);
+  assert.doesNotMatch(source, /input\.storeId/);
+  assert.match(source, /sessionSource === "store" && \(!uuidPattern\.test\(uuid\)/);
+  assert.match(source, /sessionSource === "ordinary" && \(storeId \|\| uuid \|\| webSpaceId\)/);
+  assert.match(source, /menuSessionIdentity\(config\.sessionToken\)/);
+  assert.match(source, /createHash\("sha256"\)/);
+  assert.match(source, /createMenuWebInjectionWindow\(/);
+  assert.match(source, /canonicalWebSpacePartition\(/);
+});
+
+test("renderer opens by menu and workspace only; it never prefetches restricted runtime config", async () => {
+  const source = await readFile(new URL("../../../ky-admin-host/src/pages/menu-webview-page.tsx", import.meta.url), "utf8");
+  assert.match(source, /bridge\.open\(\{[\s\S]*directoryType,[\s\S]*menuKey,[\s\S]*workspaceType: workspace\.type,[\s\S]*workspaceId: workspace\.id/);
+  assert.doesNotMatch(source, /webview\/\$\{encodeURIComponent\(workspace\.type\)\}/);
+  assert.doesNotMatch(source, /storeId:/);
+  assert.match(source, /result\.data\.openMode === "window"/);
+});
+
+test("embedded and dedicated-window modes configure the resolved session before opening", async () => {
+  const source = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  const open = source.slice(source.indexOf("async function openMenu("), source.indexOf("function publicResolveMessage("));
+  assert.match(open, /await configureSpaceSession\(partition, targetSession, config\)/);
+  assert.match(open, /if \(config\.openMode === "window"\)[\s\S]*createMenuWebInjectionWindow\(/);
+  assert.match(open, /const view = new WebContentsView\(/);
+  assert.match(source, /targetSession\.setUserAgent\(config\.userAgent, config\.acceptLanguage \|\| undefined\)/);
+  assert.match(source, /targetSession\.setProxy\(\{ mode: "direct" \}\)/);
+  assert.match(source, /targetSession\.setProxy\(\{ mode: "system" \}\)/);
+  assert.match(source, /targetSession\.setProxy\(\{ mode: "fixed_servers", proxyRules:/);
+  assert.match(source, /proxyBySession\.set\(targetSession, \{ username: proxy\.username/);
+});
+
+test("runtime injection is attached to the resolved WebContents in both open modes", async () => {
+  const source = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  const open = source.slice(source.indexOf("async function openMenu("), source.indexOf("function publicResolveMessage("));
+  assert.match(source, /new ProductionScriptRuntime\(/);
+  assert.match(source, /scriptSelectors: selectors\(config\.scripts\)/);
+  assert.match(source, /styleSelectors: selectors\(config\.styles\)/);
+  assert.match(open, /createMenuWebInjectionWindow\(\{[\s\S]*scriptSelectors:[\s\S]*styleSelectors:/);
+  assert.match(open, /attachRuntime\(instance\)/);
+  assert.match(open, /void view\.webContents\.loadURL\(config\.defaultUrl\)/);
+});
+
+test("ordinary sessions isolate user, workspace and menu and never accept a login-space UUID", async () => {
+  const source = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  const normalize = source.slice(source.indexOf("function normalizeRuntimeConfig("), source.indexOf("function getRuntimeAssetCache("));
+  const open = source.slice(source.indexOf("async function openMenu("), source.indexOf("function publicResolveMessage("));
+  assert.match(normalize, /sessionSource === "ordinary" && \(storeId \|\| uuid \|\| webSpaceId\)/);
+  assert.match(open, /`persist:menu-webview-ordinary:\$\{createHash\("sha256"\)\.update\(\[menuSessionIdentity\(config\.sessionToken\), input\.workspaceType, input\.workspaceId, config\.directoryType, config\.menuKey\]\.join\("\\0"\)\)/);
+  assert.match(open, /canonicalWebSpacePartition\(\{[\s\S]*webSpaceId: config\.webSpaceId![\s\S]*storeId: config\.storeId!/);
+  assert.match(normalize, /sessionSource === "store" && \(!uuidPattern\.test\(uuid\)/);
+});
+
+test("renderer projections expose window state but not runtime proxy credentials", async () => {
+  const main = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  const types = await readFile(new URL("../shared/types.ts", import.meta.url), "utf8");
+  const projection = types.slice(types.indexOf("export interface MenuWebViewOpenProjection"), types.indexOf("export interface MenuWebViewState"));
+  assert.match(main, /function proxyFrom\(/);
+  assert.match(main, /type ProxyConfig = \{ mode:/);
+  assert.match(projection, /openMode: "embedded" \| "window"/);
+  assert.doesNotMatch(projection, /username|password|proxy:/i);
+});
+
+test("embedded commands are bound to the creating main WebContents and navigation uses the protocol whitelist", async () => {
+  const source = await readFile(new URL("./ipc/menu-webview-ipc.ts", import.meta.url), "utf8");
+  assert.equal((source.match(/instance\.ownerContents !== event\.sender/g) ?? []).length, 3);
+  assert.match(source, /classifyLoginSpaceUrl\(url, normalizeLoginSpaceProtocolWhitelist/);
+  assert.match(source, /action === "external" && !isRedirect/);
+  assert.match(source, /action !== "navigate"/);
+  assert.match(source, /config\.scheduleMode !== "strict_document_start" \|\| !instance\.runtime \|\| !safePageUrl\(url\)/);
+});
