+    await Promise.race([
+      closed,
+      new Promise((resolve) => setTimeout(() => { cleanupTimedOut = true; resolve(); }, 5000))
+    ]);
+    const remainingWindows = BrowserWindow.getAllWindows().filter((window) => !window.isDestroyed());
+    const activeDedicatedWindows = [...activeWebInjectionWindows()].filter((window) => !window.isDestroyed());
+    const remainingBusinessContents = activeDedicatedWindows.filter((window) => {
+      try { return !getBusinessWebContents(window).isDestroyed(); } catch { return false; }
+    }).length;
+    const cleanupDone = !cleanupTimedOut && remainingWindows.length === 0 && activeDedicatedWindows.length === 0 && remainingBusinessContents === 0;
+    console.log(JSON.stringify({
+      harness: "menu-webview-runtime-electron",
+      finish: "cleanup_done",
+      cleanupDone,
+      cleanupTimedOut,
+      closedCount: windows.length - remainingWindows.length,
+      remainingWindowCount: remainingWindows.length,
+      activeDedicatedWindowCount: activeDedicatedWindows.length,
+      remainingBusinessContents
