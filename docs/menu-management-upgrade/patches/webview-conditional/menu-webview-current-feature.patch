+func menuWebViewConfigLockKey(directory, menuKey, workspaceType, workspaceID string) string {
+	parts := []string{directory, menuKey, workspaceType, workspaceID}
+	var key strings.Builder
+	for _, part := range parts {
+		key.WriteString(strconv.Itoa(len(part)))
+		key.WriteByte(':')
