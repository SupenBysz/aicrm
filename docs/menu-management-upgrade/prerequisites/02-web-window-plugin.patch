+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("Web Window 宿主保留 ready ACK 与候选失败回退路径", async () => {
+  const host = await readFile(new URL("../../apps/aicrm-desktop/src/main/web-window-plugin-host.ts", import.meta.url), "utf8");
