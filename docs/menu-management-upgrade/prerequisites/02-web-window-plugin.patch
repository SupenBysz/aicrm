@@ -0,0 +1,19 @@
+import { contextBridge, ipcRenderer } from "electron";
+import { WEB_WINDOW_CHANNELS } from "../shared/web-window-contract";
+
+const call = async (channel: string, value?: unknown) => {
+  const result = await ipcRenderer.invoke(channel, ...(value === undefined ? [] : [value]));
+  if (!result.ok) throw new Error(result.error?.code ?? "web_window_plugin_unavailable");
+  return result.data;
+};
+const subscribe = (channel: string, listener: (value: unknown) => void) => {
+  const fn = (_event: unknown, value: unknown) => { try { listener(value); } catch { /* 插件错误不得越过桥 */ } };
+  ipcRenderer.on(channel, fn);
+  return () => ipcRenderer.off(channel, fn);
+};
+
+contextBridge.exposeInMainWorld("kwwWebWindowPlugin", {
+  publish: (projection: unknown) => call(WEB_WINDOW_CHANNELS.pluginPublish, projection),
+  ready: () => call(WEB_WINDOW_CHANNELS.pluginReady),
+  onContext: (listener: (context: unknown) => void) => subscribe(WEB_WINDOW_CHANNELS.pluginContext, listener)
+});
