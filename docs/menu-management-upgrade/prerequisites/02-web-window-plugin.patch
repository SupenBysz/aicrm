+const manifest = JSON.parse(await readFile(resolve(repoRoot, "desktop-plugins/kww-web-window/v1/manifest.json"), "utf8"));
+const builtinSource = await readFile(resolve(repoRoot, "desktop-plugins/kww-web-window/v1/plugin.js"), "utf8");
+const strictDocumentStartSource = "window.__kwwStrictDocumentStart = { readyState: document.readyState };";
+const strictDocumentStartSha = sha(Buffer.from(strictDocumentStartSource));
+let pageFirstManifestResponded = false;
+const pair = generateKeyPairSync("ed25519");
+const server = createServer((request, response) => {
+  const path = new URL(request.url ?? "/", "http://127.0.0.1").pathname;
+  if (path === "/api/v1/script-runtime/manifest") {
+    const sendManifest = () => {
+      if (request.headers["x-ky-workspace-id"] === "page-first-late-fixture") pageFirstManifestResponded = true;
+      if (response.destroyed) return;
+      response.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
+      response.end(JSON.stringify({ schemaVersion: 1, workspaceType: "platform", workspaceId: request.headers["x-ky-workspace-id"] ?? "local-runtime-fixture", platform: "generic", manifestRevision: "fixture-revision-1", assets: [] }));
+    };
+    if (request.headers["x-ky-workspace-id"] === "page-first-late-fixture") setTimeout(sendManifest, 700);
+    else sendManifest();
+    return;
+  }
+  if (path === "/api/v1/script-runtime/resolve") {
+    if (request.headers["x-ky-workspace-id"] === "strict-resolver-failure-fixture") {
+      response.writeHead(403, { "Content-Type": "application/json; charset=utf-8" });
+      response.end(JSON.stringify({ error: "fixture_forbidden" }));
+      return;
+    }
+    if (request.headers["x-ky-workspace-id"] === "strict-hash-failure-fixture") {
+      response.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
+      response.end(JSON.stringify({ assets: [{
+        assetType: "script", platform: "generic", identifier: "STRICT_DOCUMENT_START_FIXTURE", version: "1.0.0",
+        effectiveVersionId: "strict-document-start-v1", enabled: true, runAt: "document_start", priority: 1,
+        source: strictDocumentStartSource, sourceSha256: "0".repeat(64)
+      }] }));
+      return;
+    }
+    if (request.headers["x-ky-workspace-id"] === "strict-timeout-fixture") {
+      setTimeout(() => {
+        if (response.destroyed || response.writableEnded) return;
+        response.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
+        response.end(JSON.stringify({ assets: [{
+          assetType: "script", platform: "generic", identifier: "STRICT_DOCUMENT_START_FIXTURE", version: "1.0.0",
+          effectiveVersionId: "strict-document-start-v1", enabled: true, runAt: "document_start", priority: 1,
+          source: strictDocumentStartSource, sourceSha256: strictDocumentStartSha
+        }] }));
+      }, 3800);
+      return;
+    }
+    response.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
+    response.end(JSON.stringify({ assets: [{
+      assetType: "script", platform: "generic", identifier: "STRICT_DOCUMENT_START_FIXTURE", version: "1.0.0",
+      effectiveVersionId: "strict-document-start-v1", enabled: true, runAt: "document_start", priority: 1,
+      source: strictDocumentStartSource, sourceSha256: strictDocumentStartSha
+    }] }));
+    return;
+  }
+  if (path === "/fixture/strict-redirect") {
