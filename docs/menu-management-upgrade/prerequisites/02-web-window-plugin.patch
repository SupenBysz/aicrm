+  if (!value) return;
+  targets.delete(targetContents);
+  fallbackContexts.delete(value.target);
+  fallbackProjections.delete(targetContents);
+  pluginTargets.delete(value.pluginContents);
+  if (!value.plugin.isDestroyed()) value.plugin.destroy();
+}
+
+export { manifest };
