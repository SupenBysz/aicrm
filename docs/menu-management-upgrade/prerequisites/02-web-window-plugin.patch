+
+const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
+const root = await mkdtemp(join(tmpdir(), "kww-web-window-host-runtime-"));
+const output = resolve(repoRoot, "apps/aicrm-desktop/out/web-window-host-runtime-test");
+const appNodeModules = resolve(repoRoot, "apps/aicrm-desktop/node_modules");
+const electronBin = resolve(appNodeModules, ".bin/electron");
