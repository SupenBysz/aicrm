+import "./test-loader.mjs";
+import test from "node:test";
+import assert from "node:assert/strict";
+import { generateKeyPairSync, sign } from "node:crypto";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { readFile } from "node:fs/promises";
+import { parse, sha } from "./package-format.mjs";
+import { isWebWindowPluginPlatformSupported, WebWindowPluginDistribution, webWindowPackageFor, WEB_WINDOW_PLUGIN_ID } from "../../apps/aicrm-desktop/src/main/web-window-plugin-distribution.ts";
+
+const pair = generateKeyPairSync("ed25519");
+const raw = Buffer.from(pair.publicKey.export({ format: "jwk" }).x, "base64url");
+const key = { schemaVersion: 1, purpose: "kww-desktop-plugin-signing", channel: "dev", algorithm: "Ed25519", publicKeyFormat: "raw-ed25519-base64", publicKey: raw.toString("base64"), fingerprint: "sha256:"+sha(raw), keyId: "sha256:"+sha(raw) };
+const signed = (value, domain, extra = []) => { const bytes = Buffer.from(JSON.stringify(value)); return { schemaVersion: 1, keyId: key.keyId, signedMetadata: bytes.toString("base64"), signature: sign(null, Buffer.concat([Buffer.from(domain+"\n"), bytes]), pair.privateKey).toString("base64"), ...Object.fromEntries(extra.map((name) => [name, undefined])) }; };
+const date = (ms) => new Date(Math.floor(ms/1000)*1000).toISOString().replace(".000Z","Z");
+const manifest = JSON.parse(await readFile(new URL("../../desktop-plugins/kww-web-window/v1/manifest.json", import.meta.url)));
+const builtin = webWindowPackageFor(manifest, await readFile(new URL("../../desktop-plugins/kww-web-window/v1/plugin.js", import.meta.url), "utf8"));
+
+function releaseFixture({ platforms = manifest.platforms } = {}) {
+  const now = Date.now();
+  const nextManifest = { ...manifest, version: "1.0.1", platforms };
+  const source = Buffer.from("globalThis.__webWindowRemote = true;");
+  const metadata = signed({ manifest: nextManifest, files: [{ path: "plugin.js", size: source.length, sha256: sha(source) }] }, "kww-desktop-web-window-plugin:v1");
+  const packageBytes = Buffer.from(JSON.stringify({ ...metadata, files: [{ path: "plugin.js", contentBase64: source.toString("base64") }] }));
+  const packageDigest = sha(packageBytes);
+  const policyPayload = { schemaVersion: 1, kind: "desktop-plugin-trust-policy", channel: "dev", policyVersion: 1, keyId: key.keyId, pluginId: WEB_WINDOW_PLUGIN_ID, capabilities: ["webWindow.projection.read","webWindow.navigation.fixed"], notBefore: date(now-1000), expiresAt: date(now+60000), revokedPackageDigests: [] };
+  const indexPayload = { schemaVersion: 1, kind: "desktop-plugin-release-index", channel: "dev", pluginId: WEB_WINDOW_PLUGIN_ID, policyVersion: 1, releaseSequence: 1, version: "1.0.1", packageSha256: packageDigest, packageBytes: packageBytes.length, fileName: packageDigest+".kwwplugin.json", expiresAt: date(now+30000) };
+  return { policy: Buffer.from(JSON.stringify(signed(policyPayload, "kww-desktop-plugin-policy:v1"))), index: Buffer.from(JSON.stringify(signed(indexPayload, "kww-desktop-plugin-index:v1"))), packageBytes, fileName: indexPayload.fileName, version: "1.0.1" };
+}
+
+test("Web Window 远程更新在 macOS 和 Windows 启用，其他平台关闭", () => {
+  assert.equal(isWebWindowPluginPlatformSupported("darwin"), true);
+  assert.equal(isWebWindowPluginPlatformSupported("win32"), true);
+  assert.equal(isWebWindowPluginPlatformSupported("linux"), false);
+});
+
+test("Web Window 远程分发失败时保留内置稳定包", async () => {
+  const root = join(await mkdtemp(join(tmpdir(), "kww-web-window-fallback-")), "state-root");
+  try {
+    const d = new WebWindowPluginDistribution({ root, builtin, publicKey: key, platform: "darwin", enabled: true, autoCheck: false, fetchRelease: async () => { throw new Error("offline"); } });
+    await d.initialize();
+    assert.equal(await d.checkForUpdate(), false);
+    assert.equal(d.current().manifest.version, "1.0.0");
+    assert.equal(d.storage.state.phase, "stable");
+    await d.close();
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("Web Window 远程包经过签名校验后进入 candidate 并可稳定切换", async () => {
+  const root = join(await mkdtemp(join(tmpdir(), "kww-web-window-candidate-")), "state-root");
+  const fixture = releaseFixture();
+  const responses = new Map([["policy.json", fixture.policy],["index.json", fixture.index],[fixture.fileName, fixture.packageBytes]]);
+  try {
+    let candidate = null;
+    const d = new WebWindowPluginDistribution({ root, builtin, publicKey: key, platform: "darwin", enabled: true, autoCheck: false, fetchRelease: async (_source, name) => responses.get(name), onCandidate: async (pkg, ref) => { candidate = { pkg, ref }; } });
+    await d.initialize();
+    const updated = await d.checkForUpdate(); assert.equal(updated, true);
+    assert.equal(d.storage.state.phase, "verified");
+    assert.equal(d.storage.state.candidate.version, "1.0.1");
+    assert.equal(candidate.pkg.manifest.version, "1.0.1");
+    await d.commitStable(candidate.ref);
+    assert.equal(d.current().manifest.version, "1.0.1");
+    assert.equal(d.storage.state.phase, "stable");
+    await d.close();
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("Windows 接受声明 win32 的签名 Web Window 插件更新", async () => {
+  const root = join(await mkdtemp(join(tmpdir(), "kww-web-window-win-update-")), "state-root");
