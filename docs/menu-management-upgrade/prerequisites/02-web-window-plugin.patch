+/** 仅部署已验签的 Web Window 开发包；不会改写 status-bar 根目录产物。 */
+import { readFile, mkdir, writeFile, rename, chmod } from "node:fs/promises";
+import { resolve, join } from "node:path";
+import { parse, signed, sha } from "./package-format.mjs";
+import { ensure, digest, integer } from "../../packages/desktop-plugin-contracts/src/index.ts";
+import { validateWebWindowManifest } from "../../packages/desktop-plugin-contracts/src/web-window.ts";
+
+const PLUGIN_ID = "cn.org.kww.desktop.web-window";
+const destinationInput = process.env.KY_WEB_WINDOW_PLUGIN_DEPLOY_ROOT?.trim();
+const destination = destinationInput ? resolve(destinationInput) : "";
+const source = resolve(process.argv[2] ?? "");
+const publicKeyDocument = parse(await readFile(new URL("../../apps/aicrm-desktop/resources/desktop-plugin-web-window-dev-policy.json", import.meta.url)), 65536).publicKey;
+const date = (value) => { ensure(typeof value === "string" && /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$/.test(value)); const parsed = Date.parse(value); ensure(Number.isFinite(parsed)); return parsed; };
+try {
+  ensure(Boolean(destinationInput), "必须配置 KY_WEB_WINDOW_PLUGIN_DEPLOY_ROOT");
+  ensure(process.argv.length === 3, "用法：node scripts/desktop-plugins/deploy-web-window-public.mjs 已验签Web Window目录");
+  const policyBytes = await readFile(join(source, "policy.json"));
+  const policy = signed(parse(policyBytes, 65536), publicKeyDocument, "kww-desktop-plugin-policy:v1");
+  ensure(policy.schemaVersion === 1 && policy.kind === "desktop-plugin-trust-policy" && policy.channel === "dev" && policy.pluginId === PLUGIN_ID);
+  integer(policy.policyVersion, 1); ensure(date(policy.expiresAt) > Date.now());
+  const indexBytes = await readFile(join(source, "index.json"));
+  const index = signed(parse(indexBytes, 65536), publicKeyDocument, "kww-desktop-plugin-index:v1");
+  ensure(index.schemaVersion === 1 && index.kind === "desktop-plugin-release-index" && index.channel === "dev" && index.pluginId === PLUGIN_ID && index.policyVersion === policy.policyVersion);
+  integer(index.releaseSequence, 1); digest(index.packageSha256); integer(index.packageBytes, 1, 2097152); ensure(index.fileName === `${index.packageSha256}.kwwplugin.json` && date(index.expiresAt) > Date.now());
+  const packageBytes = await readFile(join(source, index.fileName));
+  ensure(packageBytes.length === index.packageBytes && sha(packageBytes) === index.packageSha256);
+  const outer = parse(packageBytes, 2097152);
+  const metadata = signed(outer, publicKeyDocument, "kww-desktop-web-window-plugin:v1", ["files"]);
+  validateWebWindowManifest(metadata.manifest);
+  ensure(Array.isArray(metadata.files) && metadata.files.length === 1 && metadata.files[0].path === metadata.manifest.entry);
+  ensure(Array.isArray(outer.files) && outer.files.length === metadata.files.length);
+  await mkdir(destination, { recursive: true, mode: 0o755 });
+  for (const [name, data] of [[index.fileName, packageBytes], ["policy.json", policyBytes], ["index.json", indexBytes]]) {
+    const temporary = join(destination, `${name}.next`); await writeFile(temporary, data, { mode: 0o644 }); await chmod(temporary, 0o644); await rename(temporary, join(destination, name));
+  }
+  console.log(JSON.stringify({ 结果: "Web Window 公共包验签并部署", 版本: index.version, 序号: index.releaseSequence, digest: index.packageSha256, 目录: destination }));
+} catch {
+  console.error("Web Window 公共包验证或部署失败，未输出原始异常"); process.exitCode = 1;
+}
