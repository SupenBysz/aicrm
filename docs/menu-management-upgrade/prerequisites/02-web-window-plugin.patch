+  assert.match(host, /distribution\.rollbackPackage\(\)/);
+  assert.match(host, /const pluginContents = plugin\.webContents/);
+  assert.match(host, /pluginTargets\.delete\(pluginContents\)/);
+  assert.doesNotMatch(host, /plugin\.once\("closed",[^\n]*plugin\.webContents/);
