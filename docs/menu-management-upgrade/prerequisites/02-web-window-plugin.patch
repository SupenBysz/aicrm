+  const title = path === "/fixture/navigation-next" ? "导航验收页" : "真实 WebWindow 验收页";
+  response.end(`<!doctype html><meta charset='utf-8'><title>web-window-runtime-fixture</title><h1 id='page-title'>${title}</h1><input id='preserved' value='before-update'>`);
+});
+server.listen(0, "127.0.0.1");
+await once(server, "listening");
+const fixtureUrl = `http://127.0.0.1:${server.address().port}/fixture`;
+const publicKeyBytes = Buffer.from(pair.publicKey.export({ format: "jwk" }).x, "base64url");
+const keyDigest = sha(publicKeyBytes);
+const publicKey = {
+  schemaVersion: 1,
+  purpose: "kww-desktop-plugin-signing",
+  channel: "dev",
+  algorithm: "Ed25519",
+  publicKeyFormat: "raw-ed25519-base64",
+  publicKey: publicKeyBytes.toString("base64"),
+  fingerprint: `sha256:${keyDigest}`,
+  keyId: `sha256:${keyDigest}`
+};
+
+function signMetadata(value, domain) {
+  const bytes = Buffer.from(JSON.stringify(value));
+  return {
+    schemaVersion: 1,
+    keyId: publicKey.keyId,
+    signedMetadata: bytes.toString("base64"),
+    signature: sign(null, Buffer.concat([Buffer.from(`${domain}\n`), bytes]), pair.privateKey).toString("base64")
+  };
+}
+
+function utcDate(milliseconds) {
+  return new Date(Math.floor(milliseconds / 1000) * 1000).toISOString().replace(".000Z", "Z");
+}
+
+function createRelease(version, releaseSequence, source, policyBytes) {
+  const sourceBytes = Buffer.from(source);
+  const versionManifest = { ...manifest, version };
+  const packageMetadata = signMetadata({
+    manifest: versionManifest,
+    files: [{ path: versionManifest.entry, size: sourceBytes.length, sha256: sha(sourceBytes) }]
+  }, "kww-desktop-web-window-plugin:v1");
+  const packageBytes = Buffer.from(JSON.stringify({
+    ...packageMetadata,
+    files: [{ path: versionManifest.entry, contentBase64: sourceBytes.toString("base64") }]
+  }));
+  const packageDigest = sha(packageBytes);
+  const policy = JSON.parse(policyBytes.toString("utf8"));
+  const policyMetadata = JSON.parse(Buffer.from(policy.signedMetadata, "base64").toString("utf8"));
+  const index = signMetadata({
+    schemaVersion: 1,
+    kind: "desktop-plugin-release-index",
+    channel: "dev",
+    pluginId: manifest.id,
+    policyVersion: policyMetadata.policyVersion,
+    releaseSequence,
+    version,
+    packageSha256: packageDigest,
+    packageBytes: packageBytes.length,
+    fileName: `${packageDigest}.kwwplugin.json`,
+    expiresAt: utcDate(Date.now() + 8 * 60 * 1000)
+  }, "kww-desktop-plugin-index:v1");
+  return {
+    index: Buffer.from(JSON.stringify(index)),
+    packageBytes,
+    fileName: `${packageDigest}.kwwplugin.json`
+  };
+}
+
+const policyPayload = {
+  schemaVersion: 1,
+  kind: "desktop-plugin-trust-policy",
+  channel: "dev",
+  policyVersion: 1,
+  keyId: publicKey.keyId,
+  pluginId: manifest.id,
+  capabilities: ["webWindow.projection.read", "webWindow.navigation.fixed"],
+  notBefore: utcDate(Date.now() - 60 * 1000),
+  expiresAt: utcDate(Date.now() + 10 * 60 * 1000),
+  revokedPackageDigests: []
+};
+const policyBytes = Buffer.from(JSON.stringify(signMetadata(policyPayload, "kww-desktop-plugin-policy:v1")));
+const successfulSource = builtinSource.replace('items: [],', 'items: [{ id: "web-window-navigation", slot: "webWindow.header.navigation", type: "status", text: "网页导航", tone: "muted" }, { id: "runtime-update-status", slot: "webWindow.header.status", type: "status", text: "插件 UI 已更新 1.0.1", tone: "normal" }],');
+assert.notEqual(successfulSource, builtinSource, "fixture must change the rendered plugin UI");
+const successfulRelease = createRelease("1.0.1", 1, successfulSource, policyBytes);
+const rejectedRelease = createRelease("1.0.2", 2, 'throw new Error("candidate_fixture_failure");', policyBytes);
