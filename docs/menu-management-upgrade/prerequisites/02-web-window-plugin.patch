+
+
+test("Web Window 生命周期显式经过准备、排空、激活、试运行并稳定提交", async () => {
+  const root = join(await mkdtemp(join(tmpdir(), "kww-web-window-phase-")), "state-root");
+  try {
+    const d = new WebWindowPluginDistribution({ root, builtin, publicKey: key, enabled: false, autoCheck: false });
