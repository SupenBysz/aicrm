diff --git a/scripts/desktop-plugins/sign-web-window.mjs b/scripts/desktop-plugins/sign-web-window.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c424abd01c8d2e955c0edf5590d5ea03bfefd11f
--- /dev/null
+++ b/scripts/desktop-plugins/sign-web-window.mjs
@@ -0,0 +1,89 @@
+/** Web Window 开发分发签名工具；只接受专用 Ed25519 私钥，不输出密钥或源码。 */
+import { readFile, writeFile, mkdir, lstat } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import { createPrivateKey, createPublicKey, sign } from "node:crypto";
+import { parse, sha } from "./package-format.mjs";
+import { ensure, digest, pathName, semver } from "../../packages/desktop-plugin-contracts/src/index.ts";
+import { validateWebWindowManifest } from "../../packages/desktop-plugin-contracts/src/web-window.ts";
+
+const PLUGIN_ID = "cn.org.kww.desktop.web-window";
+const DOMAIN = "kww-desktop-web-window-plugin:v1";
+const POLICY_DOMAIN = "kww-desktop-plugin-policy:v1";
+const INDEX_DOMAIN = "kww-desktop-plugin-index:v1";
+const CAPABILITIES = ["webWindow.projection.read", "webWindow.navigation.fixed"];
+const args = process.argv.slice(2);
+const opts = {};
+for (let i = 1; i < args.length; i += 2) {
+  ensure(args[i]?.startsWith("--") && args[i + 1], "参数格式无效");
+  opts[args[i].slice(2)] = args[i + 1];
+}
+
+const usage = "用法：node scripts/desktop-plugins/sign-web-window.mjs release --private-key 路径 --public-key 路径 --source 目录 --output 目录 --sequence 整数";
+const iso = (value) => new Date(Math.floor(value / 1000) * 1000).toISOString().replace(".000Z", "Z");
+const signed = (payload, domain, privateKey, keyId) => {
+  const bytes = Buffer.from(JSON.stringify(payload));
+  return {
+    schemaVersion: 1,
+    keyId,
+    signedMetadata: bytes.toString("base64"),
+    signature: sign(null, Buffer.concat([Buffer.from(`${domain}\n`), bytes]), privateKey).toString("base64")
+  };
+};
+
+try {
+  ensure(args[0] === "release", usage);
+  const keyPath = resolve(opts["private-key"]);
+  const stat = await lstat(keyPath);
+  const parent = await lstat(dirname(keyPath));
+  ensure(stat.isFile() && !stat.isSymbolicLink() && parent.isDirectory() && !parent.isSymbolicLink());
+  ensure((stat.mode & 0o777) === 0o600 && (parent.mode & 0o777) === 0o700 && stat.uid === process.getuid?.(), "私钥权限或所有者无效");
+  const privateKey = createPrivateKey(await readFile(keyPath));
+  ensure(privateKey.asymmetricKeyType === "ed25519");
+  const publicDocument = parse(await readFile(opts["public-key"]), 4096);
+  const rawPublic = Buffer.from(publicDocument.publicKey, "base64");
+  ensure(rawPublic.length === 32 && publicDocument.fingerprint === `sha256:${sha(rawPublic)}` && publicDocument.keyId === publicDocument.fingerprint);
+  const publicKey = createPublicKey({ key: { kty: "OKP", crv: "Ed25519", x: rawPublic.toString("base64url") }, format: "jwk" });
+  ensure(createPublicKey(privateKey).export({ format: "der", type: "spki" }).equals(publicKey.export({ format: "der", type: "spki" })), "公私钥不一致");
+
+  const source = resolve(opts.source);
+  const output = resolve(opts.output);
+  const manifest = validateWebWindowManifest(parse(await readFile(`${source}/manifest.json`), 65536));
+  semver(manifest.version);
+  const files = [];
+  for (const relative of [manifest.entry]) {
+    pathName(relative);
+    const content = await readFile(`${source}/${relative}`);
+    ensure(content.length <= 524288);
+    files.push({ path: relative, content, size: content.length, sha256: sha(content) });
+  }
+  const metadata = signed({ manifest, files: files.map(({ path, size, sha256 }) => ({ path, size, sha256 })) }, DOMAIN, privateKey, publicDocument.keyId);
+  const packageBytes = Buffer.from(JSON.stringify({ ...metadata, files: files.map(({ path, content }) => ({ path, contentBase64: content.toString("base64") })) }));
+  const packageSha256 = sha(packageBytes);
+  digest(packageSha256);
+  const sequence = Number(opts.sequence);
+  ensure(Number.isSafeInteger(sequence) && sequence > 0);
+  const policyVersion = Number(opts["policy-version"] ?? 1);
+  ensure(Number.isSafeInteger(policyVersion) && policyVersion > 0);
+  const now = Date.now();
+  const policy = { schemaVersion: 1, kind: "desktop-plugin-trust-policy", channel: "dev", policyVersion, keyId: publicDocument.keyId, pluginId: PLUGIN_ID, capabilities: CAPABILITIES, notBefore: iso(now - 60000), expiresAt: iso(now + 30 * 86400000), revokedPackageDigests: [] };
+  await mkdir(output, { recursive: true });
+  let policyBytes;
+  try {
+    policyBytes = await readFile(`${output}/policy.json`);
+    const existing = parse(Buffer.from(parse(policyBytes, 65536).signedMetadata, "base64"));
+    ensure(existing.policyVersion === policyVersion && Date.parse(existing.expiresAt) > now, "策略版本冲突或过期");
+    policy.expiresAt = existing.expiresAt;
+  } catch (error) {
+    if (error.code !== "ENOENT") throw error;
+    policyBytes = Buffer.from(JSON.stringify(signed(policy, POLICY_DOMAIN, privateKey, publicDocument.keyId)));
+  }
+  const packageName = `${packageSha256}.kwwplugin.json`;
+  await writeFile(`${output}/${packageName}`, packageBytes, { flag: "wx" }).catch((error) => { if (error.code !== "EEXIST") throw error; });
+  await writeFile(`${output}/policy.json`, policyBytes);
+  const index = { schemaVersion: 1, kind: "desktop-plugin-release-index", channel: "dev", pluginId: PLUGIN_ID, policyVersion, keyId: publicDocument.keyId, releaseSequence: sequence, version: manifest.version, packageSha256, packageBytes: packageBytes.length, fileName: packageName, expiresAt: policy.expiresAt };
+  await writeFile(`${output}/index.json`, JSON.stringify(signed(index, INDEX_DOMAIN, privateKey, publicDocument.keyId)));
+  console.log(JSON.stringify({ 结果: "Web Window 开发包签名完成", 插件版本: manifest.version, 序号: sequence, 文件: packageName, 目录: output }));
+} catch {
+  console.error("签名失败：请检查参数、专用密钥权限、公私钥一致性及策略版本；未输出原始异常。");
+  process.exitCode = 1;
+}
