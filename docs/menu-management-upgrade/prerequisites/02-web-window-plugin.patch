+    response.end(`<!doctype html><html><body><script>window.__pageStartedBeforeManifest = ${!pageFirstManifestResponded};window.__siteObservedDocumentStart = Boolean(window.__kwwStrictDocumentStart);</script><h1 id="page-title">页面优先验收页</h1></body></html>`);
+    return;
+  }
