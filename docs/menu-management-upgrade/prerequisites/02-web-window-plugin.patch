+      showContextMenu: () => undefined,
+      instanceId: "strict-runtime-test-window",
+      uiSessionId: "strict-runtime-test-session",
+      scheduleMode: "strict_document_start"
+    });
+    const strictContents = getBusinessWebContents(strictTarget);
+    await waitFor(() => strictContents.executeJavaScript("document.querySelector('#strict-title')?.textContent === '严格时序验收页' || document.querySelector('h1')?.textContent === '页面未打开'"), "strict_document_start_page_or_failure_visible");
+    const strictTitle = await strictContents.executeJavaScript("document.querySelector('h1')?.textContent ?? ''");
+    assert.equal(strictTitle, "严格时序验收页", "strict scheduler must load the target after preparing it; actual=" + strictTitle + "; url=" + strictContents.getURL());
+    const strictObservation = await strictContents.executeJavaScript("JSON.stringify({ injected: window.__kwwStrictDocumentStart?.readyState, siteObserved: window.__siteObservedDocumentStart })");
+    assert.equal(JSON.parse(strictObservation).siteObserved, true, "host document_start script must run before the page's first inline script; observation=" + strictObservation);
+    report.strictDocumentStartPrecedesPageScript = true;
+
+    const verifyStrictPreparationFailure = async (workspaceId, instanceId, title, expectedReason) => {
+      const failureTarget = createWebInjectionWindow({
+        url: ${JSON.stringify(`${fixtureUrl}/strict`)},
+        title,
+        allowedOrigin: new URL(${JSON.stringify(fixtureUrl)}).origin,
+        platform: "generic",
+        workspaceType: "platform",
+        workspaceId,
+        script: { identifier: "STRICT_DOCUMENT_START_FIXTURE", runAt: "document_start" },
+        sessionToken: "fixture-token",
+        themeChannel: "fixture-theme",
+        windows: new Set(),
+        showContextMenu: () => undefined,
+        instanceId,
+        uiSessionId: instanceId + "-session",
+        scheduleMode: "strict_document_start"
+      });
+      strictFailureTargets.push(failureTarget);
+      const contents = getBusinessWebContents(failureTarget);
+      await waitFor(() => contents.executeJavaScript("document.querySelector('h1')?.textContent === '页面未打开'"), instanceId + "_error_visible");
+      await waitFor(() => host.targets.get(failureTarget.webContents)?.context.injection?.script?.status === "failed", instanceId + "_failure_state_visible");
+      const injection = host.targets.get(failureTarget.webContents)?.context.injection;
+      assert.equal(injection?.script?.status, "failed");
+      if (expectedReason) assert.equal(injection?.script?.error, expectedReason);
+      else assert.ok(injection?.script?.error);
+      assert.equal(failureTarget.isDestroyed(), false);
+      return true;
+    };
+    report.strictResolverFailureShowsErrorPage = await verifyStrictPreparationFailure(
+      "strict-resolver-failure-fixture", "strict-resolver-failure-window", "严格调度资源请求失败验收", "resolver_http_403"
+    );
+    report.strictHashFailureShowsErrorPage = await verifyStrictPreparationFailure(
+      "strict-hash-failure-fixture", "strict-hash-failure-window", "严格调度完整性失败验收", "asset_hash_missing_or_mismatch"
+    );
+    report.strictPreparationTimeoutShowsErrorPage = await verifyStrictPreparationFailure(
+      "strict-timeout-fixture", "strict-timeout-window", "严格调度超时验收", null
+    );
+
+    strictRedirectTarget = createWebInjectionWindow({
+      url: ${JSON.stringify(`${fixtureUrl}/strict-redirect`)},
+      title: "本地 WebWindow 未预登记跳转验收",
+      allowedOrigin: new URL(${JSON.stringify(fixtureUrl)}).origin,
+      platform: "generic",
+      workspaceType: "platform",
+      workspaceId: "local-runtime-fixture",
+      script: { identifier: "STRICT_DOCUMENT_START_FIXTURE", runAt: "document_start" },
+      sessionToken: "fixture-token",
+      themeChannel: "fixture-theme",
+      windows: new Set(),
+      showContextMenu: () => undefined,
+      instanceId: "strict-redirect-test-window",
+      uiSessionId: "strict-redirect-test-session",
+      scheduleMode: "strict_document_start"
+    });
+    const strictRedirectContents = getBusinessWebContents(strictRedirectTarget);
+    await waitFor(() => strictRedirectContents.executeJavaScript("document.querySelector('h1')?.textContent === '页面未打开'"), "strict_unknown_redirect_rejected");
+    assert.notEqual(strictRedirectContents.getURL(), ${JSON.stringify(`${fixtureUrl}/strict-landing`)});
+    report.unknownStrictRedirectRejected = true;
+    await finish();
+  } catch (error) {
+    await finish(error);
+  }
+}).catch(finish);
+`;
+
+try {
+  await mkdir(output, { recursive: true });
+  await mkdir(join(root, "user-data/desktop-host-plugins"), { recursive: true, mode: 0o700 });
+  await writeFile(testEntry, entrySource);
+  await import("./build-preloads.mjs");
+  const require = createRequire(import.meta.url);
+  const { build } = require(resolve(appNodeModules, "esbuild"));
+  await build({
+    entryPoints: [testEntry],
+    bundle: true,
+    platform: "node",
+    format: "cjs",
+    outfile: join(output, "main.cjs"),
+    external: ["electron"],
+    define: { __dirname: JSON.stringify(output) },
+    logLevel: "silent",
+    plugins: [{
+      name: "web-window-plugin-host-runtime-test",
+      setup(builder) {
+        builder.onResolve({ filter: /\?raw$/ }, (args) => ({ path: resolve(args.resolveDir, args.path.slice(0, -4)), namespace: "raw" }));
+        builder.onLoad({ filter: /.*/, namespace: "raw" }, async (args) => ({ contents: await readFile(args.path, "utf8"), loader: "text" }));
+        builder.onLoad({ filter: /web-window-plugin-host\.ts$/ }, async (args) => {
+          let contents = await readFile(args.path, "utf8");
+          const distributionOptions = `publicKey: (webWindowPolicy as any).publicKey,\n      platform: process.platform,\n      enabled: isWebWindowPluginPlatformSupported(process.platform),\n      onCandidate: promoteCandidate`;
+          assert.ok(contents.includes(distributionOptions), "host distribution options must remain testable");
+          contents = contents
+            .replace("const targets = new Map<WebContents, Target>();", "export const targets = new Map<WebContents, Target>();")
+            .replace("let distribution: WebWindowPluginDistribution | null = null;", "export let distribution: WebWindowPluginDistribution | null = null;")
+            .replace(distributionOptions, `publicKey: (webWindowPolicy as any).publicKey,\n      platform: process.platform,\n      enabled: true,\n      autoCheck: false,\n      fetchRelease: (_source, name) => (globalThis as any).__kwwWebWindowRuntimeRelease(_source, name),\n      onCandidate: promoteCandidate`);
+          return { contents, loader: "ts", resolveDir: dirname(args.path) };
+        });
+        builder.onLoad({ filter: /desktop-plugin-web-window-dev-policy\.json$/ }, () => ({ contents: JSON.stringify({ publicKey }), loader: "json" }));
+      }
+    }]
+  });
+  const child = spawn(electronBin, [join(output, "main.cjs")], { cwd: repoRoot, stdio: ["ignore", "pipe", "inherit"], detached: true });
+  const stopElectronTestGroup = () => {
+    if (!child.pid) return;
+    try {
+      // Electron can re-parent helper/browser processes; signal only this isolated test group.
+      process.kill(-child.pid, "SIGKILL");
+    } catch {
+      child.kill("SIGKILL");
+    }
+  };
+  let stdoutBuffer = "";
+  let acceptanceReport = null;
+  let shutdownTimer;
+  const watchdog = setTimeout(stopElectronTestGroup, 95000);
+  child.stdout.setEncoding("utf8");
+  child.stdout.on("data", (chunk) => {
+    process.stdout.write(chunk);
+    stdoutBuffer += chunk;
+    const lines = stdoutBuffer.split(/\r?\n/);
+    stdoutBuffer = lines.pop() ?? "";
+    for (const line of lines) {
+      try {
+        const value = JSON.parse(line);
+        if (value?.["验收"] !== "Web 专用窗口插件热更新") continue;
+        acceptanceReport = value;
+        if (!shutdownTimer) shutdownTimer = setTimeout(stopElectronTestGroup, 750);
+      } catch { /* 普通日志不是最终验收报告。 */ }
+    }
+  });
+  const [status, signal] = await once(child, "close");
+  clearTimeout(watchdog);
+  clearTimeout(shutdownTimer);
+  assert.ok(acceptanceReport, "Electron plugin-host runtime must emit its final acceptance report");
+  assert.equal(acceptanceReport["全部通过"], true, "Electron plugin-host runtime acceptance must pass");
+  assert.ok(status === 0 || signal === "SIGKILL", `unexpected Electron exit: status=${status}, signal=${signal}`);
+} finally {
+  server.close();
+  await rm(output, { recursive: true, force: true });
+  await rm(root, { recursive: true, force: true });
+}
