+      })) }), { status: 200, headers: { "Content-Type": "application/json" } })
+    });
+    const productionResult = await productionRuntime.executeEvent(window.webContents, "document_idle");
+    assert.deepEqual(productionResult.map((item) => item.state), ["succeeded", "succeeded"]);
+    productionRuntime.stop();
