+  const match = PUBLIC_DEPENDENCIES_METADATA.exec(source);
+  if (!match) return [];
+  const identifiers = match[1].split(",").map((value) => value.trim()).filter(Boolean);
+  if (identifiers.length > 32 || identifiers.some((identifier) => !PUBLIC_SCRIPT_IDENTIFIER.test(identifier))) {
+    throw new Error("public_dependency_declaration_invalid");
+  }
+  return [...new Set(identifiers)];
+}
