+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+
+test("生产运行时保留受控 jssdk 生命周期桥并按导航事件派发", async () => {
+  const source = await readFile(new URL("./script-runtime.ts", import.meta.url), "utf8");
+  for (const event of ["documentStart", "domReady", "pageLoad", "routeChange"]) {
+    assert.match(source, new RegExp(`dispatchLifecycleEvent\\(webContents, \\"${event}\\"`));
+  }
+  assert.match(source, /api\.on =/);
+  assert.match(source, /api\.once =/);
+  assert.match(source, /api\.off =/);
+  assert.match(source, /__dispatch/);
+  assert.match(source, /__KWW_LIFECYCLE_DISPATCH_KEYS__/);
+});
