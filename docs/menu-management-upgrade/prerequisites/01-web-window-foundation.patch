+      return (this.isAllowedRuntimeUrl(url) && this.routeAwareDocumentStartBundles.has(webContents))
+        || (this.preparedDocumentStartUrls.get(webContents)?.has(routeKey(url)) ?? false);
+    }
+    catch { return false; }
+  }
+
+  private isAllowedRuntimeUrl(value: string): boolean {
+    return isAllowedByOriginPatterns(value, this.allowedOriginMatchers);
+  }
+
+  /** 在目标导航前解析、验权、校验 hash 并注册未来文档脚本。 */
