+    assert.equal(userActionResolveCalls, 0, "ordinary page DOM events must not trigger host actions");
+    const actionResults = await productionRuntime.dispatchUserAction(window.webContents, "toolbar.export");
+    assert.deepEqual(actionResults.map((item) => item.state), ["succeeded"]);
+    assert.equal(await window.webContents.executeJavaScript("window.__kwwUserActionRuns"), 1);
+    assert.deepEqual(await window.webContents.executeJavaScript("window.__kwwUserActionEvents"), ["toolbar.export"]);
+    assert.equal(userActionResolveCalls, 1);
+    productionRuntime.stop();
+    productionRuntime = null;
+
+    const documentStartSource = "window.__kwwDocumentStart = { readyState: document.readyState };";
+    documentStartServer = createServer((_request, response) => {
+      response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
