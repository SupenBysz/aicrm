+function createFixtureServer() {
+  return createServer((request, response) => {
+    const path = new URL(request.url ?? "/", "http://127.0.0.1").pathname;
+    if (path === "/drop") {
+      response.destroy();
+      return;
+    }
+    const redirects = {
+      "/redirect/a": "/redirect/b",
+      "/redirect/b": "/page/1",
+      "/redirect/c": "/redirect/d",
+      "/redirect/d": "/page/2",
+      "/redirect/e": "/redirect/f",
+      "/redirect/f": "/page/3",
+      "/redirect/g": "/redirect/h",
+      "/redirect/h": "/page/4",
+      "/initial/a": "/initial/b",
+      "/initial/b": "/start",
+      "/sub-redirect/a": "/sub-redirect/b"
+    };
+    if (redirects[path]) {
+      response.writeHead(302, { Location: redirects[path] });
+      response.end();
+      return;
+    }
+    const pages = {
+      "/start": `<main><h1>start</h1><a id="connect" target="_blank" href="/redirect/a">connect</a></main>`,
+      "/page/1": `<main><h1 id="page">page-1</h1><iframe id="subframe" src="/sub-redirect/a"></iframe><button id="next" onclick="location.href='/redirect/c'">next</button></main>`,
+      "/page/2": `<main><h1 id="page">page-2</h1><button id="next" onclick="location.href='/redirect/e'">next</button></main>`,
+      "/page/3": `<main><h1 id="page">page-3</h1><button id="next" onclick="location.href='/redirect/g'">next</button></main>`,
+      "/page/4": `<main><h1 id="page">page-4</h1></main>`,
+      "/sub-redirect/b": `<main id="frame">frame-ready</main>`
