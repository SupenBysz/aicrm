+  businessContents.on("did-start-navigation", (_event, url, _isInPlace, isMainFrame) => {
+    if (isMainFrame) console.info("Web 专用窗口业务页开始导航", JSON.stringify({ url }));
+  });
+  businessContents.on("did-finish-load", () => {
+    console.info("Web 专用窗口业务页完成加载", JSON.stringify({ url: businessContents.getURL() }));
+  });
+  registerSender(businessContents, "controlled", (currentUrl) => {
+    if (currentUrl === "about:blank") return true;
+    return isAllowedByOriginPatterns(currentUrl, allowedOriginMatchers);
+  });
+  businessContents.on("context-menu", (_event, params) => { void options.showContextMenu(child, params, businessContents); });
+  businessContents.on("devtools-opened", () => {
+    if (isDesktopProductionMode() && options.showWebViewDevTools !== true) businessContents.closeDevTools();
+  });
+  child.once("closed", () => {
+    businessContents.removeListener("console-message", onBusinessConsoleMessage);
+    stopNetwork(businessContents);
+  });
+  businessContents.on("preload-error", (_event, preloadPath, error) => {
+    console.error("Web 专用窗口业务页 preload 加载失败", preloadPath, error);
+  });
+  businessContents.on("render-process-gone", (_event, details) => {
+    console.error("Web 专用窗口业务页渲染进程退出", JSON.stringify(details));
+  });
+  businessContents.on("did-fail-load", (_event, errorCode, errorDescription, validatedURL, isMainFrame) => {
+    console.error("Web 专用窗口业务页加载失败事件", JSON.stringify({ errorCode, errorDescription, validatedURL, isMainFrame }));
+  });
+
+  const ensureRuntime = (): Promise<ScriptRuntime | null> => runtimePromise ??= (async () => {
+    if (!hasRuntimeResources) return null;
+    const session = options.sessionToken
+      ? { token: options.sessionToken }
+      : await Promise.race([
+          loadSession(),
+          new Promise<null>((resolve) => setTimeout(() => resolve(null), WEB_WINDOW_SESSION_TIMEOUT_MS))
+        ]);
+    if (!session || child.isDestroyed() || businessContents.isDestroyed()) return null;
+    const manifestSync = getScriptRuntimeManifestSync(options, session.token);
+    manifestSyncByShell.set(child, manifestSync);
+    const manifestResult = await manifestSync.sync();
+    console.info("业务脚本发布清单同步完成", JSON.stringify({ state: manifestResult.state, reason: manifestResult.state === "failed" ? manifestResult.reason : undefined, revision: manifestResult.state === "failed" ? manifestResult.snapshot?.manifestRevision : manifestResult.snapshot.manifestRevision, assetCount: manifestResult.state === "failed" ? manifestResult.snapshot?.assets.length : manifestResult.snapshot.assets.length }));
+    if (child.isDestroyed() || businessContents.isDestroyed()) return null;
+    runtime = new ScriptRuntime({
+      apiBaseUrl: loadDesktopConfig().apiBaseUrl,
+      identity: { token: session.token, workspaceType: options.workspaceType as "platform" | "agency" | "enterprise", workspaceId: options.workspaceId },
+      allowedOrigin: options.allowedOrigin,
+      allowedOriginMatchers,
+      platform: options.platform,
+      manifestSnapshot: manifestResult.state === "failed" ? null : manifestResult.snapshot,
+      script: resources.script,
+      scriptIdentifiers: options.scriptIdentifiers,
+      scriptSelectors: options.scriptSelectors,
+      styleIdentifiers: options.styleIdentifiers,
+      styleSelectors: options.styleSelectors,
+      publicIdentifiers: options.publicIdentifiers,
+      publicStyleIdentifiers: options.publicStyleIdentifiers,
+      style: resources.style,
+      versionPolicy: resources.versionPolicy,
+      cache: getPersistentScriptRuntimeAssetCache(),
+      identifier: resources.script?.identifier,
+      onNetworkCapabilities: (capabilities: ScriptRuntimeNetworkCapability[]) => setNetworkCapabilities(businessContents, capabilities),
+      emergencyDisabled: () => scriptRuntimeEmergencyDisabled(),
+      documentStartTimeoutMs: 12000,
+      debugStatus: () => isDesktopDebugMode(),
+      onDocumentStartState: (event) => {
+        const status: WebWindowAssetInfo["status"] = event.state === "prepared" ? "prepared" : event.state === "missed_document_start" ? "missed_document_start" : event.state === "failed" ? "failed" : "pending";
+        if (hasWebWindowRuntimeResourceKind(runtimeResourceOptions, "script")) injection = { ...injection, script: { ...injection.script, status, error: event.reason ?? null } };
+        if (hasWebWindowRuntimeResourceKind(runtimeResourceOptions, "style")) injection = { ...injection, style: { ...injection.style, status, error: event.reason ?? null } };
+        publishHostContext(event.state === "failed" || event.state === "missed_document_start" ? "error" : "ready");
+      },
+      onResults: (results) => {
+        for (const result of results) {
+          const key = result.kind === "style" ? "style" : "script";
+          const current = injection[key];
+          injection = {
+            ...injection,
+            [key]: {
+              ...current,
+              identifier: result.identifier,
+              // effectiveVersionId 是内部资源实例 ID（可能是 mdsa_*），不能作为发布版本展示。
+              version: result.version ?? null,
+              status: result.state,
+              error: result.errorCode
+            }
+          };
+        }
+        options.onResults?.(results);
+        publishHostContext(results.some((result) => result.state === "failed" || result.state === "timed_out") ? "error" : "ready");
+      }
+    });
+    runtimeByShell.set(child, runtime);
+    detachRuntime = runtime.attach(businessContents, options.url);
+    return runtime;
+  })();
+
+  let businessBlankDocumentReady = false;
+  let businessBlankDocumentPromise: Promise<void> | null = null;
+  const ensureBusinessDocumentReady = async (): Promise<void> => {
+    if (businessContents.isDestroyed()) return;
+    const currentUrl = businessContents.getURL();
+    if (!currentUrl || currentUrl === "about:blank") {
+      if (businessBlankDocumentReady) return;
+      if (!businessBlankDocumentPromise) {
+        // 新建 WebContentsView 的初始空文档尚未提交时，CDP early-document 命令可能一直不返回。
+        // 先提交受控的 about:blank，再预备目标资源；提交等待有上限，失败时转为可见错误页。
+        businessBlankDocumentPromise = withTimeout(
+          businessContents.loadURL("about:blank"),
+          WEB_WINDOW_DOCUMENT_READY_TIMEOUT_MS,
+          "business_document_ready_timeout"
+        ).then(() => {
+          if (businessContents.isDestroyed()) return;
+          if (businessContents.getURL() !== "about:blank") throw new Error("business_document_commit_mismatch");
+          businessBlankDocumentReady = true;
+        });
+      }
+      await businessBlankDocumentPromise;
+    }
+  };
+
+  const prepareStrictDocumentStart = async (activeRuntime: ScriptRuntime, url: string): Promise<{ prepared: boolean; reason?: string }> => {
+    let failureReason: string | undefined;
+    try {
+      const prepared = await activeRuntime.prepareDocumentStart(businessContents, url, {
+        allowSameRouteNextDocument: true,
+        routeAware: true,
+        onStateChange: (state) => {
+          if (state.state === "failed" || state.state === "missed_document_start") failureReason = state.reason;
+        }
+      });
+      if (prepared) routeAwareDocumentStartPrepared = true;
+      return { prepared, reason: failureReason };
+    } catch (error) {
+      return { prepared: false, reason: error instanceof Error ? error.message : "document_start_preparation_failed" };
+    }
+  };
+
+  let shellInitializationSettled = false;
+  let pendingShellError: string | null = null;
+  const showShellError = (html: string): void => {
+    if (child.isDestroyed()) return;
+    if (!shellInitializationSettled) {
+      pendingShellError = html;
+      return;
+    }
+    void loadLocalShellDocument(child.webContents, html).catch(() => undefined);
+  };
+
+  const showStrictPreparationFailure = (reason: string): void => {
+    if (strictFailureShown || child.isDestroyed()) return;
+    strictFailureShown = true;
+    const reasonCode = normalizeStrictPreparationReason(reason);
+    console.error("Web 专用窗口严格导航准备失败", reasonCode);
+    void writeMatrixAccountDebugLog("strict-document-start-preparation-failed", {
+      reasonCode,
+      scheduleMode
+    });
+    injection = {
+      script: hasWebWindowRuntimeResourceKind(runtimeResourceOptions, "script") ? { ...injection.script, status: "failed", error: reason } : injection.script,
+      style: hasWebWindowRuntimeResourceKind(runtimeResourceOptions, "style") ? { ...injection.style, status: "failed", error: reason } : injection.style
+    };
+    publishHostContext("error");
+    // 首屏前在宿主初始化页报告错误；首屏后只更新状态，不替换活动页面。
+    if (!hasEverBeenShown) showShellError(strictPreparationFailureHtml(reasonCode));
+  };
+
+  const isStrictInitialization = (): boolean => scheduleMode === "strict_document_start" && !hasEverBeenShown;
+
+  const prepareAndNavigateStrictly = async (url: string): Promise<void> => {
+    if (!isStrictInitialization() || routeAwareDocumentStartPrepared) {
+      if (!businessContents.isDestroyed()) await businessContents.loadURL(url);
+      return;
+    }
+    strictFailureShown = false;
+    let key: string;
+    try { key = routeKey(url); } catch { showStrictPreparationFailure("target_url_invalid"); return; }
+    if (preparingStrictNavigations.has(key)) return;
+    const navigationGeneration = ++strictNavigationGeneration;
+    preparingStrictNavigations.add(key);
+    try {
+      await ensureBusinessDocumentReady();
+      if (!isStrictInitialization() || navigationGeneration !== strictNavigationGeneration) return;
+      const activeRuntime = await ensureRuntime();
+      if (hasRuntimeResources && !activeRuntime) {
+        showStrictPreparationFailure("runtime_session_unavailable");
+        return;
+      }
+      if (!isStrictInitialization() || navigationGeneration !== strictNavigationGeneration) return;
+      if (activeRuntime) {
+        const preparation = await prepareStrictDocumentStart(activeRuntime, url);
+        if (!preparation.prepared) {
+          showStrictPreparationFailure(preparation.reason ?? "document_start_preparation_failed");
+          return;
+        }
+      }
+      if (!isStrictInitialization() || navigationGeneration !== strictNavigationGeneration) return;
+      approvedStrictNavigations.add(key);
+      try {
+        if (!businessContents.isDestroyed()) await businessContents.loadURL(url);
+      } finally {
+        approvedStrictNavigations.delete(key);
+      }
+    } catch (error) {
+      if (!isStrictInitialization() || navigationGeneration !== strictNavigationGeneration) return;
+      showStrictPreparationFailure(error instanceof Error ? error.message : "document_start_preparation_failed");
+    } finally {
+      preparingStrictNavigations.delete(key);
+    }
+  };
+
+  // target=_blank 仍留在当前 Web 专用窗口。首次候选准备完成前经过严格调度；
+  // 预注册完成后由持久 document_start 包装覆盖后续文档，导航请求保留 Chromium 原语义。
+  installSameWindowOpenHandler(businessContents, {
+    protocolWhitelist,
+    openExternal: (url) => shell.openExternal(url),
+    navigate: (url) => {
+      if (isStrictInitialization() && !routeAwareDocumentStartPrepared) return prepareAndNavigateStrictly(url);
+      return businessContents.loadURL(url);
+    }
+  });
+
+  businessContents.on("will-navigate", (event, url, _isInPlace, isMainFrame) => {
+    if (!isMainFrame) return;
+    const protocolAction = classifyLoginSpaceUrl(url, protocolWhitelist);
+    if (protocolAction === "blank") return;
+    if (protocolAction === "external") {
+      event.preventDefault();
+      void shell.openExternal(url).catch((error) => console.warn("Web 专用窗口外部协议打开失败", JSON.stringify({ scheme: getUrlScheme(url), error: error instanceof Error ? error.message : "unknown" })));
+      return;
+    }
+    if (protocolAction === "block") {
+      event.preventDefault();
+      console.warn("Web 专用窗口已拦截未允许的链接协议", getUrlScheme(url) ?? "unknown");
+      return;
+    }
+    if (!isStrictInitialization()) return;
+    let key: string;
+    try { key = routeKey(url); } catch { event.preventDefault(); showStrictPreparationFailure("target_url_invalid"); return; }
+    if (approvedStrictNavigations.delete(key)) return;
+    // 候选脚本已在首次导航前按规则预注册；后续完整导航交给 Chromium 原样执行。
+    if (routeAwareDocumentStartPrepared) return;
+    event.preventDefault();
+    void prepareAndNavigateStrictly(url);
+  });
+
+  businessContents.on("will-redirect", (event, url, _isInPlace, isMainFrame) => {
+    if (!isMainFrame) return;
+    const protocolAction = classifyLoginSpaceUrl(url, protocolWhitelist);
+    if (protocolAction === "navigate" || protocolAction === "blank") return;
+    event.preventDefault();
+    console.warn("Web 专用窗口已拦截不允许的重定向协议", getUrlScheme(url) ?? "unknown");
+  });
+
+  // 两种模式都在首个 HTTP(S) 页面提交后才显示 WebView；page_first 仍立即发起导航。
+  mountBusinessView(child, view, { visible: false });
+  const initialPageLoad = scheduleMode === "page_first" ? loadTargetPage(businessContents, options.url, {
+    preserveCurrentDocument: () => hasEverBeenShown,
+    onInitialFailure: () => {
+      publishHostContext("error");
+      showShellError(WEB_WINDOW_LOAD_ERROR_HTML);
+    }
+  }) : null;
+  void (async () => {
+    let shellReady = false;
+    await Promise.race([
+      loadLocalShellDocument(child.webContents, WEB_WINDOW_INITIALIZING_HTML).then(() => { shellReady = true; }).catch((error) => console.warn("Web 专用窗口初始化页面加载失败", error instanceof Error ? error.message : "unknown")),
+      new Promise<void>((resolve) => setTimeout(resolve, WEB_WINDOW_SHELL_TIMEOUT_MS))
+    ]);
+    console.info("Web 专用窗口初始化页处理完成", JSON.stringify({ shellReady, scheduleMode }));
+    shellInitializationSettled = true;
+    if (pendingShellError) {
+      const html = pendingShellError;
+      pendingShellError = null;
+      showShellError(html);
+    }
+    if (!child.isDestroyed() && !child.isVisible()) child.show();
+    if (scheduleMode === "page_first") {
+      if (hasRuntimeResources) {
+        const activeRuntime = await ensureRuntime();
+        if (!activeRuntime) {
+          console.warn("Web 专用窗口未挂载脚本运行时：桌面会话不可用，页面已按 page_first 打开");
+          publishHostContext("error");
+        } else {
+          const activeUrl = businessContents.getURL() || options.url;
+          const prepared = await activeRuntime.prepareDocumentStart(businessContents, activeUrl).catch(() => false);
+          if (!prepared) console.warn("Web 专用窗口 document_start 未能在导航前准备；页面保持打开并标记实际状态");
+        }
+      }
+      await initialPageLoad;
+    } else {
+      await ensureBusinessDocumentReady();
+      if (hasRuntimeResources) {
+        const activeRuntime = await ensureRuntime();
+        if (!activeRuntime) {
+          showStrictPreparationFailure("runtime_session_unavailable");
+          return;
+        }
+        const preparation = await prepareStrictDocumentStart(activeRuntime, options.url);
+        if (!preparation.prepared) {
+          showStrictPreparationFailure(preparation.reason ?? "document_start_preparation_failed");
+          return;
+        }
+      }
+      try { approvedStrictNavigations.add(routeKey(options.url)); } catch { showStrictPreparationFailure("target_url_invalid"); return; }
+      // document_start 已预备完成后启动目标导航；首个页面提交时再显示 WebView。
+      const initialStrictNavigationGeneration = strictNavigationGeneration;
+      const initialTargetLoad = loadTargetPage(businessContents, options.url, {
+        preserveCurrentDocument: () => hasEverBeenShown || strictFailureShown || strictNavigationGeneration !== initialStrictNavigationGeneration,
+        onInitialFailure: () => showStrictPreparationFailure("target_page_load_failed")
+      });
+      await initialTargetLoad;
+    }
+    if (!child.isDestroyed() && !businessContents.isDestroyed()) {
+      mountBusinessView(child, view, { visible: hasEverBeenShown });
+      console.info("Web 专用窗口业务视图状态", JSON.stringify({ scheduleMode, hasEverBeenShown, bounds: view.getBounds() }));
+    }
+  })().catch((error) => {
+    console.error("Web 专用窗口调度失败", error instanceof Error ? error.message : "unknown");
+    if (scheduleMode === "strict_document_start") showStrictPreparationFailure("schedule_failed");
+  });
+  child.once("closed", () => {
+    businessContents.removeListener("did-navigate", markFirstPageCommitted);
+    disposeBusinessViewLifecycle();
+    detachRuntime?.();
+    runtime?.stop();
+    if (!businessContents.isDestroyed()) businessContents.close();
+  });
+  return child;
+}
+
+async function loadTargetPage(contents: WebContents, url: string, options: {
+  preserveCurrentDocument?: () => boolean;
+  onInitialFailure?: (error: unknown) => void;
+} = {}): Promise<void> {
+  if (contents.isDestroyed()) return;
+  console.info("Web 专用窗口开始加载目标页面", JSON.stringify({ url }));
+  try {
+    await Promise.race([
+      contents.loadURL(url),
+      new Promise<never>((_, reject) => setTimeout(() => reject(new Error("target_page_load_timeout")), WEB_WINDOW_LOAD_TIMEOUT_MS))
+    ]);
+    console.info("Web 专用窗口目标页面加载完成", JSON.stringify({ url }));
+  } catch (error) {
+    console.error("Web 专用窗口目标页面加载失败", error instanceof Error ? error.message : "unknown");
+    if (options.preserveCurrentDocument?.() || contents.isDestroyed()) return;
+    contents.stop();
+    options.onInitialFailure?.(error);
+  }
+}
+
+async function loadLocalShellDocument(contents: WebContents, html: string): Promise<void> {
+  if (contents.isDestroyed()) return;
+  let ready = localShellDocumentPromises.get(contents);
+  if (!localShellDocumentReady.has(contents) && !ready) {
+    ready = withTimeout(
+      contents.loadURL("about:blank"),
+      WEB_WINDOW_SHELL_DOCUMENT_TIMEOUT_MS,
+      "shell_document_ready_timeout"
+    ).then(() => {
+      if (!contents.isDestroyed()) localShellDocumentReady.add(contents);
+    });
+    localShellDocumentPromises.set(contents, ready);
+  }
+  if (ready && !localShellDocumentReady.has(contents)) {
+    try {
+      await ready;
+    } catch (error) {
+      if (localShellDocumentPromises.get(contents) === ready) localShellDocumentPromises.delete(contents);
+      throw error;
+    }
+  }
+  if (contents.isDestroyed()) return;
+  await withTimeout(contents.executeJavaScript(`(() => {
+    const parsed = new DOMParser().parseFromString(${JSON.stringify(html)}, "text/html");
+    for (const node of document.head.querySelectorAll("style[data-kww-shell-document]")) node.remove();
+    for (const node of parsed.head.querySelectorAll("style")) {
+      const style = node.cloneNode(true);
+      style.setAttribute("data-kww-shell-document", "true");
+      document.head.append(style);
+    }
+    document.title = parsed.title;
+    document.body.replaceChildren(...Array.from(parsed.body.childNodes).map((node) => node.cloneNode(true)));
+  })();`, true), WEB_WINDOW_SHELL_DOCUMENT_TIMEOUT_MS, "shell_document_update_timeout");
+}
diff --git a/apps/aicrm-desktop/src/main/web-window-action-contract.test.mjs b/apps/aicrm-desktop/src/main/web-window-action-contract.test.mjs
