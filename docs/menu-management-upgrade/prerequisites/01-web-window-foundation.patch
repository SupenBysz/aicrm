+    assert.equal(failed[0].state, "failed");
+    process.env.KWW_SCRIPT_RUNTIME_MODE = "off";
+    await assert.rejects(() => injector.inject(window.webContents, plan, assets), /client_test_mode_required/);
+    process.env.KWW_SCRIPT_RUNTIME_MODE = "client-test";
+    productionRuntime = new ProductionScriptRuntime({
