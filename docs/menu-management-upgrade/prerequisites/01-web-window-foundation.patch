+export type WebWindowActionIconSvgNode = { tag: "g" | "path" | "circle" | "rect" | "line" | "polyline" | "polygon" | "ellipse"; attrs: Readonly<Record<string, string>>; children?: readonly WebWindowActionIconSvgNode[] };
