+      apiBaseUrl: "https://fixture-api.invalid",
+      identity: { token: "fixture-token", workspaceType: "platform", workspaceId: "fixture-workspace" },
+      allowedOrigin: new URL(documentStartUrl).origin,
+      platform: "generic",
+      scriptIdentifiers: ["DOCUMENT_START_FIXTURE"],
+      onDocumentStartState: (state) => documentStartReports.push(state),
+      fetchImpl: async () => new Response(JSON.stringify({ assets: [{
+        assetType: "script", platform: "generic", identifier: "DOCUMENT_START_FIXTURE", version: "1.0.0",
+        effectiveVersionId: "document-start-v1", enabled: true, runAt: "document_start", priority: 1,
+        source: documentStartSource, sourceSha256: createHash("sha256").update(documentStartSource, "utf8").digest("hex")
+      }] }), { status: 200, headers: { "Content-Type": "application/json" } })
+    });
+    productionRuntime.attach(window.webContents, "about:blank");
+    assert.equal(await productionRuntime.prepareDocumentStart(window.webContents, documentStartUrl), true);
+    assert.equal(documentStartReports.at(-1)?.state, "prepared");
+    await window.loadURL(documentStartUrl);
+    const documentStartObservation = await window.webContents.executeJavaScript("JSON.stringify({ injected: window.__kwwDocumentStart?.readyState, siteObserved: window.__siteObservedDocumentStart })");
+    assert.equal(JSON.parse(documentStartObservation).siteObserved, true, "the page's first inline script must observe the host document_start injection; observation=" + documentStartObservation);
+    console.log(JSON.stringify({ mode: "client-test", fixture: "data:text/html+local-http", cssThenJs: true, duplicateSkipped: true, cancellation: true, failureIsolation: true, productionRejected: true, domEventsIgnored: true, hostDispatchedUserAction: true, strictDocumentStartPreparedBeforeNavigation: true, hostScriptRanBeforePageScript: true }));
+    finish();
+  } catch (error) {
+    finish(error);
+  }
+}
+
+app.whenReady().then(run).catch(finish);
