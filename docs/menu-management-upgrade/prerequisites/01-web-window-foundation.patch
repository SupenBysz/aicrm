+};
+export type WebWindowQuery =
+  | { type: "navigation-state" }
+  | { type: "theme" };
+export type WebWindowCommand =
+  | { type: "navigation"; action: WebWindowNavigationAction }
+  | { type: "window"; action: "minimize" | "toggle-maximize" | "close" };
+export type WebWindowAssetStatus = "pending" | "prepared" | "succeeded" | "failed" | "timed_out" | "cancelled" | "missed_document_start" | "not_configured" | "unavailable";
+export type WebWindowAssetInfo = {
+  identifier: string;
+  version: string | null;
+  versionSource: "specified" | "latest_released" | "unknown";
+  status: WebWindowAssetStatus;
+  error: string | null;
+};
+export type WebWindowPluginInfo = {
+  id: string;
+  version: string;
+  source: "remote" | "builtin" | "fallback";
+  status: "stable" | "probation" | "preparing" | "draining" | "activating" | "error";
+};
+export type WebWindowClientInfo = {
+  name: string;
+  version: string;
+  electronVersion: string;
+  runtime: string;
+  channel: string;
+  platform: string;
+  arch: string;
+};
+export type WebWindowInjectionInfo = {
+  script: WebWindowAssetInfo;
+  style: WebWindowAssetInfo;
+};
+export type WebWindowPageInfo = {
+  url: string;
+  navigationGeneration: number;
+};
+export type WebWindowVersionPanel = {
+  plugin: WebWindowPluginInfo;
+  client: WebWindowClientInfo;
+  injection: WebWindowInjectionInfo;
+  page: WebWindowPageInfo;
+};
+export type WebWindowPluginProjection = {
+  instanceId: string;
+  navigationGeneration: NavigationGeneration;
+  uiSessionId: string;
