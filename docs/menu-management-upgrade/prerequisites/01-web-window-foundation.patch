+const LIFECYCLE_BRIDGE_SOURCE = `(() => {
+  const root = window.jssdk;
+  if (!root || typeof root !== "object") return;
+  const current = root.lifecycle && typeof root.lifecycle === "object" ? root.lifecycle : {};
+  if (typeof current.on === "function" && typeof current.once === "function" && typeof current.off === "function" && typeof current.__dispatch === "function") return;
+  const listeners = new Map();
+  const api = current;
+  const add = (name, handler, once) => {
+    if (typeof handler !== "function") return () => {};
+    const set = listeners.get(name) || new Set();
+    const entry = { handler, once };
+    set.add(entry); listeners.set(name, set);
+    return () => set.delete(entry);
+  };
+  api.on = (name, handler) => add(name, handler, false);
+  api.once = (name, handler) => add(name, handler, true);
+  api.off = (name, handler) => {
+    const set = listeners.get(name); if (!set) return;
+    for (const entry of [...set]) if (!handler || entry.handler === handler) set.delete(entry);
+  };
+  Object.defineProperty(api, "__dispatch", { value: (name, detail) => {
+    const set = listeners.get(name); if (!set) return;
+    for (const entry of [...set]) { if (entry.once) set.delete(entry); try { void entry.handler(detail); } catch (_) {} }
+  }, configurable: false, enumerable: false });
+  Object.defineProperty(api, "__kwwLifecycleBridge", { value: true, configurable: false, enumerable: false });
+  try { root.lifecycle = api; } catch (_) {}
