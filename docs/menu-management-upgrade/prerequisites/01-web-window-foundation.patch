+type PublicScriptDefinition = {
+  identifier: string;
+  /**
+   * 在页面主世界执行工厂，并将返回值跨 contextBridge 返回给 preload。
+   * 不再通过参数 exports 回写：contextBridge 会复制/冻结普通对象参数，
+   * 页面侧对参数属性的赋值不会修改 preload 持有的原对象。
+   */
+  factory: (context: { jssdk: typeof sdk }) => Record<string, unknown>;
+};
+const publicNamespaces = new Map<string, Readonly<Record<string, unknown>>>();
+const publicApi = Object.create(null) as {
+  register: (definition: PublicScriptDefinition) => boolean;
+  get: (identifier: string) => Readonly<Record<string, unknown>> | undefined;
+  has: (identifier: string) => boolean;
+};
+publicApi.register = (definition): boolean => {
+  if (!definition || !/^[A-Z][A-Z0-9_]{0,63}$/.test(definition.identifier) || typeof definition.factory !== "function") {
+    throw Object.assign(new Error("PUBLIC_REGISTRATION_INVALID"), { code: "PUBLIC_REGISTRATION_INVALID" });
+  }
+  // 公共脚本可能因宿主重试而再次执行；保留首次注册结果，避免重复覆盖或重复初始化。
+  if (publicNamespaces.has(definition.identifier)) return false;
+
+  const exports = definition.factory({ jssdk: sdk });
+  if (!exports || typeof exports !== "object" || Array.isArray(exports)) {
+    throw Object.assign(new Error("PUBLIC_REGISTRATION_EXPORTS_INVALID"), { code: "PUBLIC_REGISTRATION_EXPORTS_INVALID" });
+  }
+  // identifier 是动态数据，不能在 exposeInMainWorld 后追加到 bridge 对象。
+  // 通过稳定暴露的 get() 读取 Map，才能把后注册的函数命名空间返回页面主世界。
+  // Keep bridge return values as ordinary objects: null-prototype objects are not
+  // a supported contextBridge payload shape in every Electron version.
+  publicNamespaces.set(definition.identifier, Object.freeze({ ...exports }));
+  return true;
+};
+publicApi.get = (identifier): Readonly<Record<string, unknown>> | undefined => publicNamespaces.get(identifier);
+publicApi.has = (identifier): boolean => publicNamespaces.has(identifier);
