+  assert.equal(navigationStateSyncRequests, 0, "业务 preload 不得对受 origin 门禁保护的导航状态通道发送同步请求");
+  assert.equal(view.getVisible(), true, "跨 origin 页面加载期间业务视图仍可见");
+  assert.equal(window.contentView.children.includes(view), true, "跨 origin 页面加载期间业务视图仍挂载");
+
+  const failedLoad = waitForMainFrameFailure(contents);
+  await contents.loadURL(`${origin}/drop`).catch(() => undefined);
+  const failure = await failedLoad;
+  assert.notEqual(failure.errorCode, -3, "故障页应是真实加载失败，不是被后续导航取消");
+  assert.equal(contents.id, stableWebContentsId, "失败导航仍复用原 WebContents");
+  assert.equal(window.contentView.children.includes(view), true, "失败导航后业务视图仍挂载");
+  assert.equal(view.getVisible(), true, "失败导航后业务视图仍可见");
+  ipcMain.removeListener(WEB_WINDOW_CHANNELS.navigationStateRequest, auditNavigationStateRequest);
+  console.log(JSON.stringify({ strictInitialRedirects: 2, pageFirstTargetBlank: pageFirstOpenDispatches, crossOriginTargetBlank: true, navigationStateSyncRequests, repeatedMainNavigations: 3, spaRouteChanges: 2, stableWebContentsId, visibilityLatched: true }));
+}
+
+app.whenReady().then(() => run()).then(() => finish()).catch(finish);
diff --git a/apps/aicrm-desktop/src/main/web-window-navigation.test.mjs b/apps/aicrm-desktop/src/main/web-window-navigation.test.mjs
