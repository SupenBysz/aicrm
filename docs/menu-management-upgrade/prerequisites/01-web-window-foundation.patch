+  ,actionButtonInvoke: IPC_CHANNELS.webWindowActionButtonInvoke
+  ,actionButtonClear: IPC_CHANNELS.webWindowActionButtonClear
+} as const;
+
+export const WEB_WINDOW_VERSION_PANEL_EVENT = "kww:web-window-version-panel";
+
+export function isWebWindowNavigationAction(value: unknown): value is WebWindowNavigationAction {
+  return value === "back" || value === "forward" || value === "reload" || value === "home";
+}
+
+export function isWebWindowNavigationCommand(value: unknown): value is WebWindowNavigationCommand {
+  return isWebWindowNavigationAction(value)
+    || (Boolean(value) && typeof value === "object" && (value as { action?: unknown }).action === "navigate" && typeof (value as { url?: unknown }).url === "string");
+}
+
+export function isWebWindowScope(value: unknown): value is WebWindowScope {
+  if (!value || typeof value !== "object") return false;
+  const scope = value as Partial<WebWindowScope>;
+  return typeof scope.instanceId === "string" && scope.instanceId.length > 0
+    && typeof scope.allowedOrigin === "string" && /^https?:\/\/[^/]+$/.test(scope.allowedOrigin)
+    && typeof scope.homeUrl === "string" && scope.homeUrl.startsWith(scope.allowedOrigin);
+}
