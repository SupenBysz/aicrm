index 0000000000000000000000000000000000000000..d84e9d79743d77869325d8cb9a165462d542e211
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/login-space-info-sdk.ts
@@ -0,0 +1,24 @@
+import type { WebWindowLoginSpaceInfoUpdate } from "../shared/web-window-contract";
+
+const loginStatuses = new Set(["unknown", "logging_in", "logged_in", "logged_out", "expired", "error"]);
+
+/** Validate an SDK update before the main process attaches trusted space identity. */
+export function normalizeLoginSpaceInfoPatch(input: unknown): WebWindowLoginSpaceInfoUpdate {
+  if (!input || typeof input !== "object" || Array.isArray(input)) throw new Error("LOGIN_SPACE_INFO_INVALID");
+  const raw = input as Record<string, unknown>;
+  const allowed = new Set(["displayName", "loginStatus"]);
+  if (!Object.keys(raw).length || Object.keys(raw).some((key) => !allowed.has(key))) throw new Error("LOGIN_SPACE_INFO_INVALID");
+  const result: WebWindowLoginSpaceInfoUpdate = {};
+  if (raw.displayName !== undefined) {
+    if (typeof raw.displayName !== "string" || /[\u0000-\u001f\u007f]/.test(raw.displayName)) throw new Error("LOGIN_SPACE_INFO_INVALID");
+    const displayName = raw.displayName.trim();
+    if (!displayName || Array.from(displayName).length > 128) throw new Error("LOGIN_SPACE_INFO_INVALID");
+    result.displayName = displayName;
+  }
+  if (raw.loginStatus !== undefined) {
+    if (typeof raw.loginStatus !== "string" || !loginStatuses.has(raw.loginStatus)) throw new Error("LOGIN_SPACE_INFO_INVALID");
+    result.loginStatus = raw.loginStatus as WebWindowLoginSpaceInfoUpdate["loginStatus"];
+  }
+  if (!Object.keys(result).length) throw new Error("LOGIN_SPACE_INFO_INVALID");
+  return result;
+}
diff --git a/apps/aicrm-desktop/src/main/script-injection-plan.test.mjs b/apps/aicrm-desktop/src/main/script-injection-plan.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..159e2d6ea3bfb1d0607aa7b8a22eb5bb694d3755
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/script-injection-plan.test.mjs
@@ -0,0 +1,140 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  InMemoryInjectionSpike,
+  IsolatedWebContentsHarness,
+  NavigationGeneration,
+  createControlledPlan,
+  createInjectionPlan,
+  injectionIdempotencyKey,
+  mapLifecycleEvent,
+  routeKey
+} from "./script-injection-plan.ts";
+
+const asset = (id, kind, runAt, priority, identifier, scriptId = id) => ({
+  id, kind, runAt, priority, identifier, scriptId, effectiveVersionId: `${scriptId}-v1`
+});
+const candidate = (id, kind, runAt, priority, identifier, workspaceId = "platform_root") => ({
+  ...asset(id, kind, runAt, priority, identifier), workspaceType: "platform", workspaceId,
+  status: "enabled", versionStatus: "active", revision: 1, sourceContent: `${kind}:${id}`, contentSha256: "a".repeat(64)
+});
+
+test("main navigation generations and route keys are stable", () => {
+  const generation = new NavigationGeneration();
+  assert.equal(generation.current(), 0);
+  assert.equal(generation.beginMainNavigation(), 1);
+  assert.equal(generation.beginMainNavigation(), 2);
+  assert.equal(routeKey("HTTPS://Example.com:443/path?a=1#fragment"), "https://example.com/path?a=1");
+  assert.equal(routeKey("https://example.com/path?a=1"), routeKey("https://example.com/path?a=1#other"));
+});
+
+test("lifecycle events map only to the locked run_at contract", () => {
+  assert.equal(mapLifecycleEvent("did-start-navigation"), "document_start");
+  assert.equal(mapLifecycleEvent("dom-ready"), "dom_content_loaded");
+  assert.equal(mapLifecycleEvent("did-finish-load"), "load");
+  assert.equal(mapLifecycleEvent("spa-route-change"), "spa_route_change");
+  assert.equal(mapLifecycleEvent("user-action"), "user_action");
+});
+
+test("plan has deterministic priority order and CSS before JavaScript", () => {
+  const plan = createInjectionPlan({
+    workspaceType: "platform",
+    workspaceId: "platform_root",
+    normalizedUrl: "https://example.com/p",
+    navigationGeneration: 1,
+    routeKey: "https://example.com/p",
+    runAt: "document_idle",
+    assets: [
+      asset("js-b", "script", "document_idle", 2, "b"),
+      asset("css-a", "style", "document_idle", 100, "a"),
+      asset("js-a", "script", "document_idle", 1, "a"),
+      asset("css-other-event", "style", "load", 0, "z")
+    ]
+  });
+  assert.deepEqual(plan.items.map((item) => item.id), ["css-a", "js-a", "js-b"]);
+});
+
+test("idempotency is generation and route scoped; failures are isolated", () => {
+  const plan = createInjectionPlan({
+    workspaceType: "platform", workspaceId: "platform_root", normalizedUrl: "https://example.com/p",
+    navigationGeneration: 1, routeKey: "https://example.com/p", runAt: "document_idle",
+    assets: [asset("css", "style", "document_idle", 1, "a"), asset("js", "script", "document_idle", 2, "b")]
+  });
+  const runner = new InMemoryInjectionSpike();
+  const first = runner.executePlan(plan, 1000, new Set(["js"]));
+  assert.deepEqual(first.items.map((item) => item.state), ["succeeded", "failed"]);
+  const retry = runner.executePlan(plan, 1000);
+  assert.deepEqual(retry.items.map((item) => item.state), ["planned", "succeeded"]);
+  const duplicate = runner.executePlan(plan, 1000);
+  assert.deepEqual(duplicate.items.map((item) => item.state), ["planned", "planned"]);
+  const nextGeneration = runner.executePlan({ ...plan, navigationGeneration: 2 }, 1000);
+  assert.deepEqual(nextGeneration.items.map((item) => item.state), ["succeeded", "succeeded"]);
+  const key = injectionIdempotencyKey({ workspaceType: "platform", workspaceId: "platform_root", scriptId: "a", effectiveVersionId: "a-v1", normalizedUrl: plan.normalizedUrl, navigationGeneration: 1, routeKey: plan.routeKey, runAt: plan.runAt });
+  assert.match(key, /platform_root/);
+});
+
+test("controlled plan is plan-only and rejects unauthorized or incomplete candidates", () => {
+  const request = {
+    workspaceType: "platform", workspaceId: "platform_root", actorId: "member-1",
+    normalizedUrl: "https://example.com/p", navigationGeneration: 1, routeKey: "https://example.com/p",
+    runAt: "document_idle", planOnly: true
+  };
+  const response = createControlledPlan(request, [candidate("ok", "script", "document_idle", 1, "ok")]);
+  assert.equal(response.mode, "plan_only");
+  assert.equal(response.reason, "ok");
+  assert.equal(response.plan.items[0].state, "planned");
+  assert.equal(createControlledPlan(request, [candidate("other", "script", "document_idle", 1, "other", "other-workspace")]).plan, null);
+  assert.equal(createControlledPlan(request, [{ ...candidate("empty", "script", "document_idle", 1, "empty"), sourceContent: "" }]).reason, "candidate_denied");
+});
+
+test("isolated harness cancels old generations, deduplicates events and invalidates sender", () => {
+  const harness = new IsolatedWebContentsHarness();
+  const firstGeneration = harness.navigate("https://example.com/first");
+  const base = {
+    workspaceType: "platform", workspaceId: "platform_root", actorId: "member-1",
+    normalizedUrl: "https://example.com/first", navigationGeneration: firstGeneration,
+    routeKey: "https://example.com/first", runAt: "document_start", planOnly: true
+  };
+  assert.equal(harness.plan(base, [candidate("first", "script", "document_start", 1, "first")]).reason, "ok");
+  assert.equal(harness.plan(base, [candidate("first", "script", "document_start", 1, "first")]).reason, "duplicate");
+  const secondGeneration = harness.navigate("https://example.com/second");
+  assert.equal(harness.plan(base, [candidate("first", "script", "document_start", 1, "first")]).reason, "stale_generation");
+  const second = { ...base, normalizedUrl: "https://example.com/second", routeKey: "https://example.com/second", navigationGeneration: secondGeneration };
+  assert.equal(harness.plan(second, [candidate("second", "script", "document_start", 1, "second")]).reason, "ok");
+  harness.destroy();
+  assert.equal(harness.plan(second, [candidate("second", "script", "document_start", 1, "second")]).reason, "sender_invalidated");
+});
+
+test("harness maps DOM ready and load events to independent plan keys", () => {
+  const harness = new IsolatedWebContentsHarness();
+  const generation = harness.navigate("https://example.com/page");
+  const request = { workspaceType: "platform", workspaceId: "platform_root", actorId: "member-1", navigationGeneration: generation, planOnly: true };
+  assert.equal(harness.emitLifecycleEvent("dom-ready", request, [candidate("dom", "script", "dom_content_loaded", 1, "dom")]).reason, "ok");
+  assert.equal(harness.emitLifecycleEvent("did-finish-load", request, [candidate("load", "script", "load", 1, "load")]).reason, "ok");
+});
+
+test("late callbacks from a destroyed sender cannot write a plan", () => {
+  const harness = new IsolatedWebContentsHarness();
+  const generation = harness.navigate("https://example.com");
+  harness.destroy();
+  const response = harness.plan({
+    workspaceType: "platform", workspaceId: "platform_root", actorId: "member-1",
+    normalizedUrl: "https://example.com", navigationGeneration: generation,
+    routeKey: "https://example.com", runAt: "load", planOnly: true
+  }, [candidate("late", "script", "load", 1, "late")]);
+  assert.equal(response.reason, "sender_invalidated");
+  assert.equal(response.plan, null);
+});
+
+test("plan runner records timeout without affecting another asset", () => {
+  const plan = createInjectionPlan({
+    workspaceType: "platform", workspaceId: "platform_root", normalizedUrl: "https://example.com",
+    navigationGeneration: 1, routeKey: "https://example.com", runAt: "load",
+    assets: [candidate("css-timeout", "style", "load", 1, "css"), candidate("js-ok", "script", "load", 2, "js")]
+  });
+  const runner = new InMemoryInjectionSpike();
+  const result = runner.executePlan(plan, 0);
+  assert.deepEqual(result.items.map((item) => item.state), ["timed_out", "timed_out"]);
+  const isolated = runner.executePlan(plan, 1000, new Set(["css-timeout"]));
+  assert.deepEqual(isolated.items.map((item) => item.state), ["failed", "succeeded"]);
+});
diff --git a/apps/aicrm-desktop/src/main/script-injection-plan.ts b/apps/aicrm-desktop/src/main/script-injection-plan.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2dfce7886695de1069afeb00ae7c46c70f954cea
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/script-injection-plan.ts
@@ -0,0 +1,270 @@
+export type ScriptRunAt =
+  | "document_start"
+  | "dom_content_loaded"
+  | "document_idle"
+  | "load"
+  | "spa_route_change"
+  | "user_action";
+
+export type SpikeAssetKind = "style" | "script";
+export type SpikeAssetState = "planned" | "succeeded" | "timed_out" | "failed";
+
+export interface SpikeAsset {
+  id: string;
+  kind: SpikeAssetKind;
+  runAt: ScriptRunAt;
+  priority: number;
+  enabled?: boolean;
+  identifier: string;
+  /** 服务端发布版本号；effectiveVersionId 仅用于内部实例去重。 */
+  version?: string;
+  scriptId: string;
+  effectiveVersionId: string;
+}
+
+export interface InjectionPlanItem extends SpikeAsset {
+  state: SpikeAssetState;
+  errorCode: string | null;
+}
+
+export interface InjectionPlan {
+  workspaceType: string;
+  workspaceId: string;
+  normalizedUrl: string;
+  navigationGeneration: number;
+  routeKey: string;
+  runAt: ScriptRunAt;
+  items: InjectionPlanItem[];
+}
+
+export interface InjectionIdempotencyKey {
+  workspaceType: string;
+  workspaceId: string;
+  scriptId: string;
+  effectiveVersionId: string;
+  normalizedUrl: string;
+  navigationGeneration: number;
+  routeKey: string;
+  runAt: ScriptRunAt;
+}
+
+export interface RuntimeCandidate extends SpikeAsset {
+  workspaceType: string;
+  workspaceId: string;
+  status: "enabled" | "disabled" | "archived";
+  versionStatus: "released" | "active";
+  revision: number;
+  sourceContent: string;
+  contentSha256: string;
+}
+
+export interface ControlledRuntimeRequest {
+  workspaceType: string;
+  workspaceId: string;
+  actorId: string;
+  normalizedUrl: string;
+  navigationGeneration: number;
+  routeKey: string;
+  runAt: ScriptRunAt;
+  planOnly: true;
+}
+
+export interface ControlledPlanResponse {
+  mode: "plan_only";
+  plan: InjectionPlan | null;
+  reason: "ok" | "sender_invalidated" | "workspace_denied" | "candidate_denied" | "stale_generation" | "duplicate";
+}
+
+const RUN_AT_ORDER: Record<ScriptRunAt, number> = {
+  document_start: 0,
+  dom_content_loaded: 1,
+  document_idle: 2,
+  load: 3,
+  spa_route_change: 4,
+  user_action: 5
+};
+
+export class NavigationGeneration {
+  private value = 0;
+
+  beginMainNavigation(): number {
+    this.value += 1;
+    return this.value;
+  }
+
+  current(): number {
+    return this.value;
+  }
+}
+
+export function routeKey(url: string): string {
+  const parsed = new URL(url);
+  return `${parsed.origin}${parsed.pathname}${parsed.search}`;
+}
+
+export function mapLifecycleEvent(event: "did-start-navigation" | "dom-ready" | "did-finish-load" | "spa-route-change" | "user-action"): ScriptRunAt | null {
+  switch (event) {
+    case "did-start-navigation": return "document_start";
+    case "dom-ready": return "dom_content_loaded";
+    case "did-finish-load": return "load";
+    case "spa-route-change": return "spa_route_change";
+    case "user-action": return "user_action";
+    default: return null;
+  }
+}
+
+export function injectionIdempotencyKey(input: InjectionIdempotencyKey): string {
+  return [input.workspaceType, input.workspaceId, input.scriptId, input.effectiveVersionId, input.normalizedUrl, input.navigationGeneration, input.routeKey, input.runAt]
+    .map((part) => encodeURIComponent(String(part)))
+    .join("|");
+}
+
+function compareAssets(left: SpikeAsset, right: SpikeAsset): number {
+  return RUN_AT_ORDER[left.runAt] - RUN_AT_ORDER[right.runAt]
+    || left.priority - right.priority
+    || left.identifier.localeCompare(right.identifier)
+    || left.scriptId.localeCompare(right.scriptId)
+    || left.id.localeCompare(right.id);
+}
+
+export function createInjectionPlan(input: {
+  workspaceType: string;
+  workspaceId: string;
+  normalizedUrl: string;
+  navigationGeneration: number;
+  routeKey: string;
+  runAt: ScriptRunAt;
+  assets: SpikeAsset[];
+}): InjectionPlan {
+  const ordered = [...input.assets].sort(compareAssets);
+  const selected = ordered.filter((asset) => asset.runAt === input.runAt);
+  const css = selected.filter((asset) => asset.kind === "style");
+  const js = selected.filter((asset) => asset.kind === "script");
+  return {
+    workspaceType: input.workspaceType,
+    workspaceId: input.workspaceId,
+    normalizedUrl: input.normalizedUrl,
+    navigationGeneration: input.navigationGeneration,
+    routeKey: input.routeKey,
+    runAt: input.runAt,
+    items: [...css, ...js].map((asset) => ({ ...asset, state: "planned", errorCode: null }))
+  };
+}
+
+export function createControlledPlan(request: ControlledRuntimeRequest, candidates: RuntimeCandidate[]): ControlledPlanResponse {
+  if (!request.actorId || !request.planOnly) return { mode: "plan_only", plan: null, reason: "workspace_denied" };
+  if (!request.normalizedUrl || !request.routeKey) return { mode: "plan_only", plan: null, reason: "candidate_denied" };
+  const authorized = candidates.filter((candidate) =>
+    candidate.workspaceType === request.workspaceType
+    && candidate.workspaceId === request.workspaceId
+    && candidate.status === "enabled"
+    && candidate.versionStatus === "active"
+    && candidate.effectiveVersionId !== ""
+    && candidate.sourceContent.length > 0
+    && candidate.revision > 0
+  );
+  if (!authorized.length) return { mode: "plan_only", plan: null, reason: "candidate_denied" };
+  return {
+    mode: "plan_only",
+    plan: createInjectionPlan({ ...request, assets: authorized }),
+    reason: "ok"
+  };
+}
+
+export class IsolatedWebContentsHarness {
+  private readonly navigation = new NavigationGeneration();
+  private readonly seen = new Set<string>();
+  private alive = true;
+  private currentUrl = "";
+
+  navigate(url: string): number {
+    this.currentUrl = url;
+    return this.navigation.beginMainNavigation();
+  }
+
+  spaRouteChange(url: string): string {
+    this.currentUrl = url;
+    return routeKey(url);
+  }
+
+  emitLifecycleEvent(event: "did-start-navigation" | "dom-ready" | "did-finish-load" | "spa-route-change" | "user-action", request: Omit<ControlledRuntimeRequest, "runAt" | "routeKey" | "normalizedUrl"> & { routeKey?: string; normalizedUrl?: string }, candidates: RuntimeCandidate[]): ControlledPlanResponse {
+    const runAt = mapLifecycleEvent(event);
+    if (!runAt) return { mode: "plan_only", plan: null, reason: "candidate_denied" };
+    const normalizedUrl = request.normalizedUrl ?? this.currentUrl;
+    const nextRequest: ControlledRuntimeRequest = {
+      ...request,
+      normalizedUrl,
+      routeKey: request.routeKey ?? routeKey(normalizedUrl),
+      runAt
+    };
+    return this.plan(nextRequest, candidates);
+  }
+
+  destroy(): void {
+    this.alive = false;
+  }
+
+  plan(request: ControlledRuntimeRequest, candidates: RuntimeCandidate[], expectedGeneration = this.navigation.current()): ControlledPlanResponse {
+    if (!this.alive) return { mode: "plan_only", plan: null, reason: "sender_invalidated" };
+    if (request.navigationGeneration !== expectedGeneration) return { mode: "plan_only", plan: null, reason: "stale_generation" };
+    const response = createControlledPlan(request, candidates);
+    if (!response.plan) return response;
+    const firstKey = response.plan.items[0];
+    if (!firstKey) return { mode: "plan_only", plan: null, reason: "candidate_denied" };
+    const key = injectionIdempotencyKey({
+      workspaceType: request.workspaceType,
+      workspaceId: request.workspaceId,
+      scriptId: firstKey.scriptId,
+      effectiveVersionId: firstKey.effectiveVersionId,
+      normalizedUrl: request.normalizedUrl,
+      navigationGeneration: request.navigationGeneration,
+      routeKey: request.routeKey,
+      runAt: request.runAt
+    });
+    if (this.seen.has(key)) return { mode: "plan_only", plan: null, reason: "duplicate" };
+    this.seen.add(key);
+    // Harness仅记录计划状态，不将源码交给任何执行 API。
+    return response;
+  }
+
+  currentNavigation(): number {
+    return this.navigation.current();
+  }
+
+  currentURL(): string {
+    return this.currentUrl;
+  }
+}
+
+export class InMemoryInjectionSpike {
+  private readonly completed = new Set<string>();
+
+  hasCompleted(key: InjectionIdempotencyKey): boolean {
+    return this.completed.has(injectionIdempotencyKey(key));
+  }
+
+  markCompleted(key: InjectionIdempotencyKey): void {
+    this.completed.add(injectionIdempotencyKey(key));
+  }
+
+  executePlan(plan: InjectionPlan, timeoutMs: number, failingAssetIds = new Set<string>()): InjectionPlan {
+    const next = { ...plan, items: plan.items.map((item) => ({ ...item })) };
+    for (const item of next.items) {
+      const key: InjectionIdempotencyKey = {
+        workspaceType: plan.workspaceType,
+        workspaceId: plan.workspaceId,
+        scriptId: item.scriptId,
+        effectiveVersionId: item.effectiveVersionId,
+        normalizedUrl: plan.normalizedUrl,
+        navigationGeneration: plan.navigationGeneration,
+        routeKey: plan.routeKey,
+        runAt: plan.runAt
+      };
+      if (this.hasCompleted(key)) continue;
+      if (timeoutMs <= 0) item.state = "timed_out";
+      else if (failingAssetIds.has(item.id)) { item.state = "failed"; item.errorCode = "spike_asset_failed"; }
+      else { item.state = "succeeded"; this.markCompleted(key); }
+    }
+    return next;
+  }
+}
