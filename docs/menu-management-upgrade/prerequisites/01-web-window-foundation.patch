+    webContents.on("dom-ready", onReady);
+    webContents.on("did-finish-load", onLoad);
+    webContents.on("did-navigate-in-page", onRoute);
+    const detach = () => {
+      this.pendingAbort?.abort();
+      this.navigationUrl = null;
+      webContents.removeListener("did-start-navigation", onStart);
+      webContents.removeListener("dom-ready", onReady);
+      webContents.removeListener("did-finish-load", onLoad);
+      webContents.removeListener("did-navigate-in-page", onRoute);
