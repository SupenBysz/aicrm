index 0000000000000000000000000000000000000000..1561479e37c6ea4a2cb04509b1bcd5d2bafea84d
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-action-contract.test.mjs
@@ -0,0 +1,55 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+
+test("Web 专用窗口功能按钮有类型、受限图标校验、导航清理和安全回调转发", async () => {
+  const [contract, validator, preload, main] = await Promise.all([
+    readFile(new URL("../shared/web-window-contract.ts", import.meta.url), "utf8"),
+    readFile(new URL("../shared/web-window-action.ts", import.meta.url), "utf8"),
+    readFile(new URL("../preload/web-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("./app-window.ts", import.meta.url), "utf8"),
+  ]);
+
+  assert.match(contract, /provider: "antd"/);
+  assert.match(contract, /mode: "font-class"/);
+  assert.match(contract, /mode: "unicode"/);
+  assert.match(contract, /mode: "symbol"/);
+  assert.match(preload, /async function addActionButton\(options: WebWindowActionButtonOptions\)/);
+  assert.match(contract, /remove: \(\) => Promise<void>/);
+  assert.match(validator, /WEB_WINDOW_ACTION_BUTTON_LIMIT = 4/);
+  assert.match(validator, /hostname === "at\.alicdn\.com"/);
+  assert.match(validator, /sanitizeSvgNode/);
+  assert.match(preload, /actionButtonHandlers\.set\(id, handler\)/);
+  assert.match(preload, /WEB_WINDOW_CHANNELS\.actionButtonInvoke/);
+  assert.match(preload, /WEB_WINDOW_CHANNELS\.actionButtonClear/);
+  assert.match(main, /event\.sender !== business/);
+  assert.match(main, /action\.navigationGeneration !== generation/);
+  assert.match(main, /WEB_WINDOW_ACTION_BUTTON_LIMIT/);
+  assert.match(main, /business\.send\(WEB_WINDOW_CHANNELS\.actionButtonInvoke/);
+});
+
+test("桌面 JSSDK 封装并限制 Ant Design UI 输入", async () => {
+  const [ui, desktopPackage, browserSdk, docs] = await Promise.all([
+    readFile(new URL("../preload/web-window-ui.ts", import.meta.url), "utf8"),
+    readFile(new URL("../../package.json", import.meta.url), "utf8"),
+    readFile(new URL("../../../../plugins/ky-script-management/src/runtime-sdk.ts", import.meta.url), "utf8"),
+    readFile(new URL("../../../../docs/desktop-host-plugins/web-window-plugin/2026-10-04-Web专用窗口JSSDK接口参考.md", import.meta.url), "utf8"),
+  ]);
+  const pkg = JSON.parse(desktopPackage);
+
+  const hostPackage = JSON.parse(await readFile(new URL("../../../ky-admin-host/package.json", import.meta.url), "utf8"));
+  assert.equal(pkg.dependencies.antd, hostPackage.dependencies.antd);
+  assert.equal(pkg.dependencies["@ant-design/icons"], hostPackage.dependencies["@ant-design/icons"]);
+  assert.match(ui, /from "antd"/);
+  assert.match(ui, /ConfigProvider/);
+  assert.match(ui, /App\.useApp\(\)/);
+  assert.match(ui, /messageMethods = \["success", "info", "warning", "error", "loading"\]/);
+  assert.match(ui, /modal\.confirm/);
+  assert.match(ui, /UI_ARGUMENT_INVALID/);
+  assert.match(browserSdk, /addActionButton: \(_options: BrowserActionButtonOptions\) => unavailable/);
+  assert.match(browserSdk, /HOST_CAPABILITY_UNAVAILABLE/);
+  assert.match(browserSdk, /modal: \{/);
+  for (const entry of ['provider: "antd"', "font-class", "Unicode", "symbol", "最多注册 4 个按钮", "jssdk.ui", "Promise<boolean>"]) {
+    assert.ok(docs.includes(entry), `JSSDK 参考文档缺少：${entry}`);
+  }
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-injection.test.mjs b/apps/aicrm-desktop/src/main/web-window-injection.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c61dd1a3b82464a932b3cd18137dea254f21935c
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-injection.test.mjs
@@ -0,0 +1,113 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { hasWebWindowRuntimeResourceKind, hasWebWindowRuntimeResources, normalizeResourceDeclaration, summarizeInjectionResults } from "./web-window-injection.ts";
+
+test("资源声明只接受受限 selector 并保留版本策略", () => {
+  assert.deepEqual(normalizeResourceDeclaration({ script: { identifier: "APP_MAIN" } }), { script: { identifier: "APP_MAIN", matchConfiguredUrlRules: true }, style: undefined, versionPolicy: undefined });
+  assert.throws(() => normalizeResourceDeclaration({ script: { identifier: "bad/id" } }), /resource_identifier_invalid/);
+  assert.throws(() => normalizeResourceDeclaration({ script: { identifier: "APP_MAIN", version: "latest" } }), /resource_version_invalid/);
+});
+
