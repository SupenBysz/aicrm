+  brand.style.setProperty("--kww-window-title-font-family", style.fontFamily ?? "");
+  brand.style.setProperty("--kww-window-title-width", typeof style.width === "number" ? `${style.width}px` : "");
+  brand.style.setProperty("--kww-window-title-align", style.align ?? "");
+  brand.style.display = style.visible === false ? "none" : "";
+}
+
+function text(value: unknown, fallback = "—"): string {
+  return typeof value === "string" && value.length > 0 ? value : fallback;
+}
+
+function addVersionRow(parent: HTMLElement, label: string, value: unknown): void {
+  const row = document.createElement("div"); row.className = "kww-version-row";
+  const left = document.createElement("span"); left.className = "kww-version-label"; left.textContent = label;
+  const right = document.createElement("span"); right.className = "kww-version-value"; right.textContent = text(value);
+  row.append(left, right); parent.append(row);
+}
+
+function renderCurrentUserStatus(): void {
+  const status = document.getElementById("kww-web-window-status");
+  if (!status || windowRole !== "shell") return;
+  status.querySelector(".kww-web-window-user-status")?.remove();
+  if (!currentUserName) return;
+  const user = document.createElement("span");
+  user.className = "kww-web-window-user-status";
+  user.title = `当前用户：${currentUserName}`;
+  const icon = document.createElement("span");
+  icon.className = "kww-web-window-user-icon";
+  icon.setAttribute("aria-hidden", "true");
+  const name = document.createElement("span");
+  name.textContent = currentUserName;
+  user.append(icon, name);
+  status.prepend(user);
+}
+
+async function loadCurrentUserStatus(attempt = 0): Promise<void> {
+  if (windowRole !== "shell") return;
+  try {
+    const context = await getSdkContext();
+    const user = context.currentUser?.user;
+    currentUserName = user?.displayName?.trim() || user?.username?.trim() || null;
+    renderCurrentUserStatus();
+  } catch {
+    if (attempt < 2) setTimeout(() => void loadCurrentUserStatus(attempt + 1), 500);
+  }
+}
+
+function closeVersionPanel(): void {
+  versionPanelOpen = false;
+  document.getElementById("kww-web-window-version-panel")?.remove();
+}
+
+function openVersionPanel(panel: WebWindowVersionPanel, kind: "version" | "injection" = "version"): void {
+  closeVersionPanel();
+  versionPanelOpen = true;
+  const root = document.createElement("section"); root.id = "kww-web-window-version-panel"; root.setAttribute("role", "dialog"); root.setAttribute("aria-label", "Web 专用窗口信息");
+  const groups: Array<[string, Record<string, unknown>]> = kind === "injection"
+    ? [["脚本注入", { "标识符": panel.injection.script.identifier, "版本": panel.injection.script.version, "版本来源": panel.injection.script.versionSource === "specified" ? "指定版本" : "最新已发布", "状态": panel.injection.script.status, "错误": panel.injection.script.error }], ["样式注入", { "标识符": panel.injection.style.identifier, "版本": panel.injection.style.version, "版本来源": panel.injection.style.versionSource === "specified" ? "指定版本" : "最新已发布", "状态": panel.injection.style.status, "错误": panel.injection.style.error }]]
+    : [["客户端", { "名称": panel.client.name, "版本": panel.client.version, "Electron": panel.client.electronVersion, "运行环境": panel.client.runtime, "渠道": panel.client.channel, "平台": panel.client.platform, "架构": panel.client.arch }], ["插件", { "标识符": panel.plugin.id, "版本": `v${panel.plugin.version}`, "来源": panel.plugin.source === "remote" ? "远程" : panel.plugin.source === "fallback" ? "回退" : "内置", "状态": panel.plugin.status }]];
+  for (const [heading, rows] of groups) { const h = document.createElement("h3"); h.textContent = heading; root.append(h); for (const [label, value] of Object.entries(rows)) addVersionRow(root, label, value); }
+  document.documentElement.append(root);
+}
+
+function renderProjection(projection: WebWindowPluginProjection): void {
+  if (!projection || projection.navigationGeneration < lastNavigationGeneration) return;
+  // The host can publish while the shell document is still being replaced from about:blank.
+  // Keep the latest accepted projection and apply it after the shell chrome exists.
+  pendingPluginProjection = projection;
+  const status = document.getElementById("kww-web-window-status");
+  const chrome = document.getElementById("kww-web-window-chrome");
+  if (!status || !chrome) return;
+  const headerMount = document.getElementById("kww-web-window-header-mount");
+  const navigation = document.getElementById("kww-web-window-navigation");
+  currentVersionPanel = projection.versionPanel ?? null;
+  chrome?.querySelectorAll("[data-kww-projection-surface]").forEach((node) => node.remove());
+  if (status) {
+    status.replaceChildren();
+    renderCurrentUserStatus();
+  }
+  const surfaces = new Map<string, HTMLElement>();
+  const outletFor = (surface: string): HTMLElement | null => {
+    if (!["header.navigation", "header.status", "status.left", "status.right"].includes(surface)) return null;
+    let outlet = surfaces.get(surface);
+    if (outlet) return outlet;
+    const parent = surface === "header.navigation" ? navigation : surface === "header.status" ? headerMount : status;
+    if (!parent) return null;
+    outlet = document.createElement("span");
+    outlet.className = "kww-web-window-projection-outlet";
+    outlet.dataset.kwwProjectionSurface = surface;
+    if (surface === "status.left") status?.prepend(outlet);
+    else parent.append(outlet);
+    surfaces.set(surface, outlet);
+    return outlet;
+  };
+  for (const item of projection.items) {
+    const surface = projection.slotSurfaces?.[item.slot];
+    const outlet = surface ? outletFor(surface) : null;
+    if (!outlet) continue;
+    const node = item.type === "button" ? document.createElement("button") : document.createElement("span");
+    node.className = item.type === "button" ? "kww-web-window-version-button" : "kww-web-window-projection-status";
+    node.dataset.tone = item.tone;
+    if (item.id === "web-window-injection") {
+      const icon = document.createElement("span"); icon.className = "kww-web-window-injection-icon"; icon.setAttribute("aria-hidden", "true");
+      const count = document.createElement("span"); count.textContent = item.text;
+      node.append(icon, count);
+    } else node.textContent = item.text;
+    if (item.title) node.setAttribute("title", item.title);
+    if (item.type === "button") {
+      node.setAttribute("type", "button");
+      node.setAttribute("aria-label", item.title ?? item.text);
+      node.addEventListener("click", (event) => {
+        event.stopPropagation();
+        if (item.actionId === "back" || item.actionId === "reload" || item.actionId === "home") {
+          sendNavigation(item.actionId);
+          return;
+        }
+        const nextKind = item.actionId === "injection-panel" ? "injection" : "version";
+        const samePanel = versionPanelOpen && versionPanelKind === nextKind;
+        versionPanelKind = nextKind;
+        versionPanelOpen = !samePanel;
+        ipcRenderer.send(VERSION_PANEL_CHANNEL, { open: versionPanelOpen, panel: versionPanelKind });
+      });
+    }
+    outlet.append(node);
+  }
+  if (windowRole === "business" && versionPanelOpen && currentVersionPanel) openVersionPanel(currentVersionPanel, versionPanelKind);
+}
+
+ipcRenderer.on(VERSION_PANEL_CHANNEL, (_event, payload: { open?: unknown; panel?: unknown }) => {
+  versionPanelKind = payload?.panel === "injection" ? "injection" : "version";
+  versionPanelOpen = payload?.open === true;
+  if (versionPanelOpen && currentVersionPanel) openVersionPanel(currentVersionPanel, versionPanelKind);
+  else closeVersionPanel();
+});
+
+window.addEventListener(WEB_WINDOW_VERSION_PANEL_EVENT, (event) => {
+  const detail = (event as CustomEvent<{ open?: unknown; panel?: unknown; projection?: WebWindowPluginProjection }>).detail;
+  const panel = detail?.projection?.versionPanel;
+  if (panel) currentVersionPanel = panel;
+  versionPanelKind = detail?.panel === "injection" ? "injection" : "version";
+  versionPanelOpen = detail?.open === true;
+  if (versionPanelOpen && currentVersionPanel) openVersionPanel(currentVersionPanel, versionPanelKind);
+  else closeVersionPanel();
+});
+
+function ensureChrome(): void {
+  if (windowRole === "business") {
+    if (!document.documentElement) return;
+    if (!document.getElementById("kww-business-surface-style")) {
+      const surfaceStyle = document.createElement("style");
+      surfaceStyle.id = "kww-business-surface-style";
+      surfaceStyle.textContent = businessSurfaceStyle;
+      document.documentElement.append(surfaceStyle);
+    }
+    document.documentElement.dataset.kwwWindowRole = "business";
+    return;
+  }
+  if (!document.documentElement) return;
+  applyTheme(pendingTheme ?? false);
+  const chromeWasMissing = !document.getElementById("kww-web-window-chrome");
+  installChrome();
+  if (chromeWasMissing && pendingPluginProjection) renderProjection(pendingPluginProjection);
+}
+
+ipcRenderer.on(THEME_CHANNEL, (_event, dark: boolean) => applyTheme(Boolean(dark)));
+ipcRenderer.on(WEB_WINDOW_CHANNELS.globalLock, (_event, locked: unknown) => applyGlobalLock(locked === true));
+
+ipcRenderer.on(NAVIGATION_STATE_CHANNEL, (_event, next: Partial<NavigationState>) => updateNavigationState(next));
+ipcRenderer.on(PROJECTION_CHANNEL, (_event, projection: WebWindowPluginProjection) => renderProjection(projection));
+ipcRenderer.on(WEB_WINDOW_CHANNELS.actionButtons, (_event, buttons: WebWindowActionButtonRegistration[]) => renderActionButtons(buttons));
+applyTheme(initialTheme === "dark");
+document.addEventListener("DOMContentLoaded", ensureChrome, { once: false });
+window.addEventListener("load", ensureChrome, { once: false });
+setTimeout(ensureChrome, 0);
+const chromeObserver = new MutationObserver(() => ensureChrome());
+if (document.documentElement) chromeObserver.observe(document.documentElement, { childList: true });
diff --git a/apps/aicrm-desktop/src/shared/web-window-action.ts b/apps/aicrm-desktop/src/shared/web-window-action.ts
