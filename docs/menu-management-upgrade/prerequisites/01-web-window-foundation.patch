@@ -0,0 +1,61 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ScriptRuntimeManifestSync } from "./script-runtime-manifest-sync.ts";
+
+test("manifest snapshots retain public styles and isolate concurrent authorization scopes", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "script-runtime-manifest-"));
+  const filePath = join(directory, "manifest.json");
+  const requests = [];
+  const fetchImpl = async (_url, init) => {
+    const token = init.headers.Authorization;
+    requests.push(token);
+    await new Promise((resolve) => setTimeout(resolve, 10));
+    const revision = token.endsWith("alpha") ? "revision-alpha" : "revision-beta";
+    return new Response(JSON.stringify({
+      data: {
+        schemaVersion: "1",
+        workspaceType: "platform",
+        workspaceId: "workspace-a",
+        platform: "generic",
+        manifestRevision: revision,
+        assets: [],
+        public: [],
+        publicStyles: [{ assetType: "public-style", identifier: "THEME", version: "2", runAt: "document_idle", priority: 1, enabled: true }]
+      }
+    }), { status: 200, headers: { "Content-Type": "application/json" } });
+  };
+  const options = (token) => ({
+    apiBaseUrl: "https://api.example/",
+    token,
+    workspaceType: "platform",
+    workspaceId: "workspace-a",
+    platform: "generic",
+    filePath,
+    fetchImpl
+  });
+
+  try {
+    const alpha = new ScriptRuntimeManifestSync(options("token-alpha"));
+    const beta = new ScriptRuntimeManifestSync(options("token-beta"));
+    const [alphaResult, betaResult] = await Promise.all([alpha.sync(), beta.sync()]);
+
+    assert.deepEqual(requests.sort(), ["Bearer token-alpha", "Bearer token-beta"]);
+    assert.equal(alphaResult.state, "updated");
+    assert.equal(betaResult.state, "updated");
+    if (alphaResult.state !== "updated" || betaResult.state !== "updated") return;
+    assert.equal(alphaResult.snapshot.manifestRevision, "revision-alpha");
+    assert.equal(betaResult.snapshot.manifestRevision, "revision-beta");
+    assert.equal(alphaResult.snapshot.publicStyles?.[0]?.identifier, "THEME");
+    assert.equal(betaResult.snapshot.publicStyles?.[0]?.runAt, "document_idle");
+    assert.equal(alpha.getCached()?.manifestRevision, "revision-alpha");
+    assert.equal(beta.getCached()?.manifestRevision, "revision-beta");
+
+    const persisted = JSON.parse(readFileSync(filePath, "utf8"));
+    assert.equal(Object.keys(persisted.manifests).length, 2);
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
