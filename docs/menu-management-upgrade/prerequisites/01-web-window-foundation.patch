+    this.manifestSnapshot = options.manifestSnapshot;
+  }
+
+  private runtimeResolverHeaders(): Record<string, string> {
+    return {
+      Authorization: `Bearer ${this.options.identity.token}`,
+      "X-KY-Workspace-Type": this.options.identity.workspaceType,
+      "X-KY-Workspace-Id": this.options.identity.workspaceId,
+      "X-KY-Request-Id": randomUUID(),
+      "Content-Type": "application/json",
+    };
+  }
+
+  /**
+   * 业务脚本可在源码首部声明公共脚本依赖。首次解析拿到业务源码后，
+   * 再用相同资源选择补充公共标识符；服务端负责启用状态、工作区和依赖拓扑校验。
+   */
+  private async resolveDeclaredPublicDependencies(
+    envelope: RuntimeEnvelope,
+    requestBody: Record<string, unknown>,
+    genericRuntime: boolean,
+    url: string,
+    runAt: ScriptRunAt,
+    timeoutMs?: number,
+  ): Promise<RuntimeEnvelope> {
+    const declared = declaredPublicDependenciesInEnvelope(envelope);
+    if (declared.length === 0) return envelope;
+
+    const configured = Array.isArray(requestBody.publicIdentifiers)
+      ? requestBody.publicIdentifiers.filter((value): value is string => typeof value === "string")
+      : [];
+    const roots = [...new Set([...configured, ...declared])];
+    const additional = roots.filter((identifier) => !configured.includes(identifier));
+    if (additional.length > 0) {
+      if (!genericRuntime) throw new Error("public_dependencies_require_generic_runtime");
+
+      safeRuntimeLog("info", "业务脚本声明公共依赖", JSON.stringify({ url: new URL(url).origin + new URL(url).pathname, runAt, identifiers: additional }));
+      const controller = new AbortController();
+      const effectiveTimeoutMs = timeoutMs ?? (runAt === "document_start"
+        ? this.options.documentStartTimeoutMs ?? this.options.timeoutMs ?? 3000
+        : this.options.timeoutMs ?? 3000);
+      let timedOut = false;
+      const timeout = setTimeout(() => {
+        timedOut = true;
+        controller.abort();
+      }, effectiveTimeoutMs);
+      this.pendingAbort = controller;
+      try {
+        const response = await (this.options.fetchImpl ?? fetch)(
+          `${this.options.apiBaseUrl.replace(/\/+$/, "")}${SCRIPT_RUNTIME_RESOLVE_PATH}`,
+          {
+            method: "POST",
+            headers: this.runtimeResolverHeaders(),
+            body: JSON.stringify({ ...requestBody, publicIdentifiers: roots }),
+            signal: controller.signal,
+          },
+        );
+        if (!response.ok) throw new Error(`public_dependency_resolve_http_${response.status}`);
+        const resolved = normalizeRuntimeEnvelope(await response.json() as RuntimeEnvelope, this.options.platform ?? "legacy-douyin");
+        // 显式补充依赖时保留首次按 URL 匹配的公共资源；同标识符以本次解析结果为准。
+        resolved.public = mergePublicAssetsByIdentifier(envelope.public, resolved.public);
+        resolved.publicStyles = mergePublicAssetsByIdentifier(envelope.publicStyles, resolved.publicStyles);
+        envelope = resolved;
+      } catch (error) {
+        if (timedOut) throw new Error("document_start_public_dependency_timeout");
+        if (controller.signal.aborted && runAt === "document_start") throw new Error("document_start_public_dependency_aborted");
+        throw error;
+      } finally {
+        clearTimeout(timeout);
+        if (this.pendingAbort === controller) this.pendingAbort = null;
+      }
+    }
+
+    const availablePublicScripts = new Map(
+      (envelope.public ?? []).map((asset) => [asset.identifier, asset]),
+    );
+    const missing = declared.filter((identifier) => !availablePublicScripts.has(identifier));
+    if (missing.length > 0) throw new Error(`public_dependency_unavailable:${missing.join(",")}`);
+
+    const invalid = declared.filter((identifier) => {
+      const asset = availablePublicScripts.get(identifier);
+      return !asset || !sourceMatchesHash(toPublicAsset(asset));
+    });
+    if (invalid.length > 0) throw new Error(`public_dependency_hash_invalid:${invalid.join(",")}`);
+
+    return envelope;
+  }
+
+  updateManifestSnapshot(snapshot: RuntimeManifestSnapshot | null): void {
+    this.manifestSnapshot = snapshot;
+  }
+
+  attach(webContents: WebContents, initialUrl?: string): () => void {
