+/** Web 专用窗口插件的增量声明合同，不改变状态栏插件合同。 */
+export const WEB_WINDOW_PLUGIN_API = "1.0.0" as const;
+export const WEB_WINDOW_UI_API = "1.0.0" as const;
+export type WebWindowPluginManifest = { schemaVersion: 1; kind: "desktop-web-window-plugin"; id: string; version: string; entry: string; engines: { host: string; pluginApi: string; uiApi: string }; platforms: string[]; capabilities: string[]; contributes: { slots: string[] }; data: { mode: "declarative"; schemaVersion: 1 } };
+export type WebWindowSlot = string;
+export type WebWindowSlotSurface = "header.navigation" | "header.status" | "status.left" | "status.right";
+export type WebWindowSlotRegistration = { id: WebWindowSlot; surface: WebWindowSlotSurface };
+export type WebWindowTone = "muted" | "normal" | "warning" | "error";
+export type WebWindowAssetStatus = "pending" | "prepared" | "succeeded" | "failed" | "timed_out" | "cancelled" | "missed_document_start" | "not_configured" | "unavailable";
+export type WebWindowAssetInfo = { identifier: string; version: string | null; versionSource: "specified" | "latest_released" | "unknown"; status: WebWindowAssetStatus; error: string | null };
+export type WebWindowPluginInfo = { id: string; version: string; source: "remote" | "builtin" | "fallback"; status: "stable" | "probation" | "preparing" | "draining" | "activating" | "error" };
+export type WebWindowClientInfo = { name: string; version: string; electronVersion: string; runtime: string; channel: string; platform: string; arch: string };
+export type WebWindowInjectionInfo = { script: WebWindowAssetInfo; style: WebWindowAssetInfo };
+export type WebWindowPageInfo = { url: string; navigationGeneration: number };
+export type WebWindowVersionPanel = { plugin: WebWindowPluginInfo; client: WebWindowClientInfo; injection: WebWindowInjectionInfo; page: WebWindowPageInfo };
+export type WebWindowProjectionItem = {
+  id: string;
+  slot: WebWindowSlot;
+  type: "text" | "button" | "status";
+  text: string;
+  title?: string;
+  tone: WebWindowTone;
+  actionId?: "back" | "reload" | "home" | "version-panel";
+};
+export type WebWindowProjection = {
+  instanceId: string;
+  navigationGeneration: number;
+  uiSessionId: string;
+  activeRevision: number;
+  items: readonly WebWindowProjectionItem[];
+  slotSurfaces?: Readonly<Record<string, WebWindowSlotSurface>>;
+  versionPanel?: WebWindowVersionPanel;
+};
+
+const DEFAULT_WEB_WINDOW_SLOTS: readonly WebWindowSlotRegistration[] = [
+  { id: "webWindow.header.navigation", surface: "header.navigation" },
+  { id: "webWindow.header.status", surface: "header.status" },
+  { id: "webWindow.status.left", surface: "status.left" },
+  { id: "webWindow.status.right", surface: "status.right" }
+];
+
+/** 宿主拥有注册权；插件只能声明并使用已经注册的逻辑扩展位。 */
+export class WebWindowSlotRegistry {
+  private readonly registrations = new Map<string, WebWindowSlotSurface>();
+
+  constructor(initial: readonly WebWindowSlotRegistration[] = DEFAULT_WEB_WINDOW_SLOTS) {
+    for (const slot of initial) this.register(slot.id, slot.surface);
+  }
+
+  register(id: string, surface: WebWindowSlotSurface): void {
+    if (!/^webWindow\.[A-Za-z][A-Za-z0-9_.-]{0,95}$/.test(id)) throw new Error("web_window_slot_id_invalid");
+    const existing = this.registrations.get(id);
+    if (existing && existing !== surface) throw new Error("web_window_slot_already_registered");
+    this.registrations.set(id, surface);
+  }
+
+  surfaceFor(id: string): WebWindowSlotSurface | null {
+    return this.registrations.get(id) ?? null;
+  }
+
+  validateContributions(slots: readonly string[]): void {
+    if (new Set(slots).size !== slots.length || slots.some((slot) => !this.registrations.has(slot))) {
+      throw new Error("web_window_slot_not_registered");
+    }
+  }
+}
+
+export function validateWebWindowManifest(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("web_window_manifest_invalid");
+  const input = value as Record<string, unknown>;
+  if (input.schemaVersion !== 1 || input.kind !== "desktop-web-window-plugin" || input.id !== "cn.org.kww.desktop.web-window" || typeof input.version !== "string" || !/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/.test(input.version) || input.entry !== "plugin.js") throw new Error("web_window_manifest_invalid");
+  if (
+    !Array.isArray(input.platforms) ||
+    input.platforms.length < 1 ||
+    input.platforms.length > 2 ||
+    new Set(input.platforms).size !== input.platforms.length ||
+    !input.platforms.every((platform) => platform === "darwin" || platform === "win32")
+  ) throw new Error("web_window_manifest_invalid");
+  if (!Array.isArray(input.capabilities) || input.capabilities.length > 4 || !input.capabilities.every((item) => item === "webWindow.projection.read" || item === "webWindow.navigation.fixed")) throw new Error("web_window_manifest_invalid");
+  const contributes = input.contributes;
+  const slots = contributes && typeof contributes === "object" ? (contributes as Record<string, unknown>).slots : null;
+  if (!Array.isArray(slots) || !slots.every((slot: unknown) => typeof slot === "string" && /^webWindow\.[A-Za-z][A-Za-z0-9_.-]{0,95}$/.test(slot)) || new Set(slots).size !== slots.length) throw new Error("web_window_manifest_invalid");
+  return input;
+}
+
+export function validateWebWindowProjection(value: unknown): WebWindowProjection {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("web_window_projection_invalid");
+  const input = value as Record<string, unknown>;
+  if (typeof input.instanceId !== "string" || !input.instanceId || typeof input.navigationGeneration !== "number" || !Number.isSafeInteger(input.navigationGeneration) || input.navigationGeneration < 0 || typeof input.uiSessionId !== "string" || !input.uiSessionId || typeof input.activeRevision !== "number" || !Number.isSafeInteger(input.activeRevision) || !Array.isArray(input.items) || input.items.length > 16) throw new Error("web_window_projection_invalid");
+  const items = input.items.map((raw) => {
+    if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("web_window_projection_item_invalid");
+    const item = raw as Record<string, unknown>;
+    if (typeof item.id !== "string" || !item.id || typeof item.slot !== "string" || !/^webWindow\.[A-Za-z][A-Za-z0-9_.-]{0,95}$/.test(item.slot) || typeof item.type !== "string" || !["text", "button", "status"].includes(item.type) || typeof item.text !== "string" || item.text.length > 160 || !["muted", "normal", "warning", "error"].includes(item.tone as string)) throw new Error("web_window_projection_item_invalid");
+    if (item.type === "button" && !["back", "reload", "home", "version-panel"].includes(item.actionId as string)) throw new Error("web_window_action_invalid");
+    if (item.type !== "button" && item.actionId !== undefined) throw new Error("web_window_action_invalid");
+    return item as unknown as WebWindowProjectionItem;
+  });
+  const panel = input.versionPanel;
+  if (panel !== undefined) {
+    if (!panel || typeof panel !== "object" || Array.isArray(panel)) throw new Error("web_window_version_panel_invalid");
+    const value = panel as Record<string, unknown>;
+    for (const key of ["plugin", "client", "injection", "page"]) if (!value[key] || typeof value[key] !== "object" || Array.isArray(value[key])) throw new Error("web_window_version_panel_invalid");
+    const plugin = value.plugin as Record<string, unknown>;
+    if (typeof plugin.id !== "string" || typeof plugin.version !== "string" || !["remote", "builtin", "fallback"].includes(plugin.source as string) || !["stable", "probation", "preparing", "draining", "activating", "error"].includes(plugin.status as string)) throw new Error("web_window_version_panel_invalid");
+  }
+  return { instanceId: input.instanceId as string, navigationGeneration: input.navigationGeneration as number, uiSessionId: input.uiSessionId as string, activeRevision: input.activeRevision as number, items, versionPanel: panel as WebWindowVersionPanel | undefined };
+}
