+import assert from "node:assert/strict";
+import test from "node:test";
+import { runInNewContext } from "node:vm";
+import { ClientTestInjector, DOCUMENT_START_INJECTION_STATUS_SYMBOL, clientTestModeEnabled, guardedDocumentStartSource, injectClientTestPlan, isAllowedClientFixtureURL } from "./script-injector.ts";
+
+const plan = { workspaceType: "platform", workspaceId: "fixture", normalizedUrl: "data:text/html,fixture", navigationGeneration: 1, routeKey: "data:text/html,fixture", runAt: "document_idle", items: [
+  { id: "css", kind: "style", runAt: "document_idle", priority: 1, identifier: "css", scriptId: "s", effectiveVersionId: "v", state: "planned", errorCode: null },
+  { id: "js", kind: "script", runAt: "document_idle", priority: 2, identifier: "js", scriptId: "s", effectiveVersionId: "v", state: "planned", errorCode: null }
+] };
+const assets = [...plan.items].map((item) => ({ ...item, sourceContent: item.kind === "style" ? "body{}" : "window.__fixture=true" }));
+
+function fakeWebContents() {
+  const calls = [];
+  return { calls, isDestroyed: () => false, getURL: () => "data:text/html,fixture", insertCSS: async (source) => { calls.push(["css", source]); }, executeJavaScript: async (source) => { calls.push(["js", source]); } };
+}
+
+function delayedWebContents(delayMs, method = "js") {
+  const base = fakeWebContents();
+  base[method === "css" ? "insertCSS" : "executeJavaScript"] = async (source) => {
+    await new Promise((resolve) => setTimeout(resolve, delayMs));
+    base.calls.push([method, source]);
+  };
+  return base;
+}
+
+test("client mode guard only allows data/file fixture URLs", () => {
+  process.env.KWW_SCRIPT_RUNTIME_MODE = "client-test";
+  assert.equal(clientTestModeEnabled(), true);
+  assert.equal(isAllowedClientFixtureURL("data:text/html,fixture"), true);
+  assert.equal(isAllowedClientFixtureURL("file:///tmp/kww-script-fixture/page.html"), true);
+  assert.equal(isAllowedClientFixtureURL("https://example.com"), false);
+});
+
+test("fake WebContents contract preserves CSS then JS and rejects production mode", async () => {
+  const wc = fakeWebContents();
+  const injector = new ClientTestInjector();
+  const result = await injector.inject(wc, plan, assets);
+  assert.deepEqual(wc.calls.map(([kind]) => kind), ["css", "js"]);
+  assert.deepEqual(result.map((item) => item.state), ["succeeded", "succeeded"]);
+  process.env.KWW_SCRIPT_RUNTIME_MODE = "off";
+  await assert.rejects(() => injectClientTestPlan(wc, plan, assets), /client_test_mode_required/);
+  process.env.KWW_SCRIPT_RUNTIME_MODE = "client-test";
+});
+
+test("document_start wrapper acknowledges actual execution and synchronous failure", () => {
+  const earlyPlan = { ...plan, routeKey: "https://fixture.example/product", runAt: "document_start" };
+  const item = { ...assets[1], id: "early-script", effectiveVersionId: "v1" };
+  const key = `${item.id}|${item.effectiveVersionId}|${earlyPlan.routeKey}`;
+  const statusSymbol = Symbol.for(DOCUMENT_START_INJECTION_STATUS_SYMBOL);
+  const successWindow = {};
+  runInNewContext(guardedDocumentStartSource(earlyPlan, item, "window.__earlyRan = true;"), { window: successWindow });
+  assert.equal(successWindow.__earlyRan, true);
+  assert.equal(successWindow[statusSymbol][key], "succeeded");
+
+  const failureWindow = {};
+  assert.throws(() => runInNewContext(guardedDocumentStartSource(earlyPlan, item, 'throw new Error("fixture_failure");'), { window: failureWindow }), /fixture_failure/);
+  assert.equal(failureWindow[statusSymbol][key], "failed");
+});
+
+test("generation cancellation, timeout and one-asset failure stay isolated", async () => {
+  process.env.KWW_SCRIPT_RUNTIME_MODE = "client-test";
+  const cancelled = await new ClientTestInjector().inject(fakeWebContents(), plan, assets, { generationIsCurrent: () => false });
+  assert.deepEqual(cancelled.map((item) => item.state), ["cancelled", "cancelled"]);
+
+  const timedOut = await new ClientTestInjector().inject(delayedWebContents(20), plan, assets, { timeoutMs: 1 });
+  assert.equal(timedOut[0].state, "succeeded");
+  assert.equal(timedOut[1].state, "timed_out");
+  assert.equal(timedOut[1].errorCode, "timeout");
+
+  const failing = fakeWebContents();
+  failing.executeJavaScript = async () => { throw new Error("fixture_failure"); };
+  const isolated = await new ClientTestInjector().inject(failing, plan, assets);
+  assert.deepEqual(isolated.map((item) => item.state), ["succeeded", "failed"]);
+  assert.equal(isolated[1].errorCode, "asset_failed");
+});
