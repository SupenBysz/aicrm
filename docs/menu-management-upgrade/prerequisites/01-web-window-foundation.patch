--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-navigation.test.mjs
@@ -0,0 +1,57 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  acceptNavigationAction,
+  createAckTracker,
+  createEventSubscription,
+  createNavigationState,
+  isCurrentNavigationGeneration,
+  nextNavigationGeneration
+} from "./web-window-navigation.ts";
+import { isWebWindowScope } from "../shared/web-window-contract.ts";
+
+test("导航代次递增并拒绝旧代次事件", () => {
+  const generation = nextNavigationGeneration(3);
+  assert.equal(generation, 4);
+  assert.equal(isCurrentNavigationGeneration(4, generation), true);
+  assert.equal(isCurrentNavigationGeneration(4, 3), false);
+  assert.deepEqual(createNavigationState("https://example.com", generation), {
+  canGoBack: false, canGoForward: false, homeUrl: "https://example.com", url: "https://example.com", navigationGeneration: 4
+  });
+});
+
+test("未知导航命令被拒绝", () => {
+  assert.equal(acceptNavigationAction("home"), true);
+  assert.equal(acceptNavigationAction("loadURL"), false);
+  assert.equal(acceptNavigationAction({}), false);
+});
+
+test("未知或跨域窗口作用域不通过校验", () => {
+  assert.equal(isWebWindowScope({ instanceId: "w1", allowedOrigin: "https://example.com", homeUrl: "https://example.com/home" }), true);
+  assert.equal(isWebWindowScope({ instanceId: "w1", allowedOrigin: "https://example.com", homeUrl: "https://other.example/home" }), false);
+  assert.equal(isWebWindowScope({ instanceId: "", allowedOrigin: "https://example.com", homeUrl: "https://example.com" }), false);
+});
+
+test("重复 ACK 和旧事件只接受一次且可重置", () => {
+  const tracker = createAckTracker();
+  assert.equal(tracker.accept(1, 1), true);
+  assert.equal(tracker.accept(1, 1), false);
+  assert.equal(tracker.accept(0, 2), false);
+  tracker.reset();
+  assert.equal(tracker.accept(1, 1), true);
+});
+
+test("重复订阅不会增加监听器，清理后不再收到事件", () => {
+  const events = createEventSubscription();
+  let count = 0;
+  const listener = () => { count += 1; };
+  const cleanup = events.subscribe(listener);
+  events.subscribe(listener);
+  assert.equal(events.size(), 1);
+  events.emit("state");
+  assert.equal(count, 1);
+  cleanup();
+  assert.equal(events.size(), 0);
+  events.emit("state");
+  assert.equal(count, 1);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-navigation.ts b/apps/aicrm-desktop/src/main/web-window-navigation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eadafe1bf5823741ecded6a12077488d3eccc2e7
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-navigation.ts
@@ -0,0 +1,56 @@
+import type {
+  NavigationGeneration,
+  WebWindowNavigationAction,
+  WebWindowNavigationCommand,
+  WebWindowNavigationState
+} from "../shared/web-window-contract.ts";
+import { isWebWindowNavigationAction, isWebWindowNavigationCommand } from "../shared/web-window-contract.ts";
+
+export function nextNavigationGeneration(current: NavigationGeneration): NavigationGeneration {
+  return current >= Number.MAX_SAFE_INTEGER ? 1 : current + 1;
+}
+
+export function isCurrentNavigationGeneration(current: NavigationGeneration, candidate: unknown): boolean {
+  return Number.isSafeInteger(candidate) && candidate === current;
+}
+
+export function acceptNavigationAction(value: unknown): value is WebWindowNavigationAction {
+  return isWebWindowNavigationAction(value);
+}
+
+export function acceptNavigationCommand(value: unknown): value is WebWindowNavigationCommand {
+  return isWebWindowNavigationCommand(value);
+}
+
+export function createNavigationState(homeUrl: string, generation: NavigationGeneration, canGoBack = false, canGoForward = false, url = homeUrl): WebWindowNavigationState {
+  return { canGoBack, canGoForward, homeUrl, url, navigationGeneration: generation };
+}
+
+export function createEventSubscription<T>() {
+  const listeners = new Set<(event: T) => void>();
+  return {
+    subscribe(listener: (event: T) => void): () => void {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    emit(event: T): void {
+      for (const listener of [...listeners]) listener(event);
+    },
+    size(): number { return listeners.size; }
+  };
+}
+
+export function createAckTracker() {
+  let lastGeneration = -1;
+  let lastSequence = -1;
+  return {
+    accept(generation: number, sequence: number): boolean {
+      if (!Number.isSafeInteger(generation) || !Number.isSafeInteger(sequence)) return false;
+      if (generation < lastGeneration || (generation === lastGeneration && sequence <= lastSequence)) return false;
+      lastGeneration = generation;
+      lastSequence = sequence;
+      return true;
+    },
+    reset(): void { lastGeneration = -1; lastSequence = -1; }
+  };
+}
diff --git a/apps/aicrm-desktop/src/main/web-window-network.electron.test.mjs b/apps/aicrm-desktop/src/main/web-window-network.electron.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1fdd02d0471416d2d4895252ea43dcbb4ee36b00
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-network.electron.test.mjs
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { app, BrowserWindow } from "electron";
+import { registerNetworkSubscription, stopNetwork } from "./web-window-network.ts";
+
+let window;
+let server;
+let finished = false;
+const watchdog = setTimeout(() => finish(new Error("web_window_network_electron_test_timeout")), 20000);
+
+function finish(error) {
+  if (finished) return;
+  finished = true;
+  clearTimeout(watchdog);
+  if (error) console.error(error);
+  if (window && !window.isDestroyed()) {
+    stopNetwork(window.webContents);
+    if (window.webContents.debugger.isAttached()) window.webContents.debugger.detach();
+    window.destroy();
+  }
+  server?.close();
+  app.exit(error ? 1 : 0);
+}
+
+async function waitForResponseEvent(contents, subscriptionId) {
+  const deadline = Date.now() + 8000;
+  while (Date.now() < deadline) {
+    const events = await contents.executeJavaScript("window.__kwwNetworkEvents || []").catch(() => []);
+    const found = events.find((event) => event.subscriptions?.includes(subscriptionId));
+    if (found) return found;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  throw new Error("network_response_event_timeout");
+}
+
+async function run() {
+  try {
+    server = createServer((request, response) => {
+      if (request.url === "/api/response") {
+        response.writeHead(200, { "Content-Type": "application/json" });
+        response.end('{"ok":true,"source":"fixture"}');
+        return;
+      }
+      response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
+      response.end(`<!doctype html><script>
+        const { ipcRenderer } = require("electron");
+        window.__kwwNetworkEvents = [];
+        ipcRenderer.on("aicrm:web-window-network-event", (_event, payload) => window.__kwwNetworkEvents.push(payload));
+        fetch("/api/response").then(response => response.text()).then(value => window.__fixtureResponse = value);
+      </script><h1>network fixture</h1>`);
+    });
+    await new Promise((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(0, "127.0.0.1", resolve);
+    });
+    const address = server.address();
+    assert.ok(address && typeof address === "object");
+    const origin = `http://127.0.0.1:${address.port}`;
+
+    window = new BrowserWindow({
+      show: false,
+      webPreferences: { nodeIntegration: true, contextIsolation: false, sandbox: false }
+    });
+    await window.loadURL("about:blank");
+
+    // 模拟 ScriptRuntime 先占用同一 CDP debugger 并启用 Page 域。
+    window.webContents.debugger.attach("1.3");
+    await window.webContents.debugger.sendCommand("Page.enable");
+    const subscriptionId = await registerNetworkSubscription(window.webContents, "response", {
+      match: { url: `${origin}/api/response` },
+      includeBody: true
+    }, false);
+
+    await window.loadURL(origin);
+    const event = await waitForResponseEvent(window.webContents, subscriptionId);
+    assert.equal(event.kind, "response");
+    assert.equal(event.status, 200);
+    assert.equal(event.url, `${origin}/api/response`);
+    assert.equal(event.body, '{"ok":true,"source":"fixture"}');
+
+    console.log(JSON.stringify({ fixture: "electron-debugger-shared-session", responseSubscriptionTriggered: true, responseBodyCaptured: true }));
+    finish();
+  } catch (error) {
+    finish(error);
+  }
+}
+
+app.whenReady().then(run).catch(finish);
diff --git a/apps/aicrm-desktop/src/main/web-window-network.test.mjs b/apps/aicrm-desktop/src/main/web-window-network.test.mjs
