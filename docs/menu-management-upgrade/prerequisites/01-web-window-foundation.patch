@@ -0,0 +1,114 @@
+export type ScriptRuntimeAssetType = "script" | "style";
+
+export type ScriptRuntimeVersionPolicy = "latest_released" | "active_only";
+
+export type ScriptRuntimeRunAt =
+  | "document_start"
+  | "dom_content_loaded"
+  | "document_idle"
+  | "load"
+  | "spa_route_change"
+  | "user_action";
+
+/** 由脚本管理服务校验并返回的页面 URL 匹配规则。 */
+export interface ScriptRuntimeMatchRule {
+  id?: string;
+  matchType: "exact" | "prefix" | "wildcard";
+  pattern: string;
+  ignoreQuery: boolean;
+  enabled: boolean;
+  remark?: string;
+  sortOrder?: number;
+}
+
+/** 业务脚本通过宿主 jssdk 注册的生命周期事件。 */
+export type ScriptLifecycleEvent = "documentStart" | "domReady" | "pageLoad" | "routeChange" | "userAction";
+export type ScriptRuntimeNetworkCapability = "subscribeRequest" | "subscribeResponse" | "waitForRequest" | "waitForResponse" | "interceptRequest" | "interceptResponse";
+
+export interface ScriptRuntimeWorkspace {
+  type: string;
+  id: string;
+}
+
+export interface ScriptRuntimeAssetSelector {
+  identifier: string;
+  version?: string;
+  runAt?: ScriptRuntimeRunAt;
+  priority?: number;
+  enabled?: boolean;
+  matchConfiguredUrlRules?: boolean;
+}
+
+export interface ScriptRuntimeResolveRequest {
+  platform: string;
+  url: string;
+  workspace?: ScriptRuntimeWorkspace;
+  versionPolicy?: ScriptRuntimeVersionPolicy;
+  scriptIdentifiers?: string[];
+  styleIdentifiers?: string[];
+  publicIdentifiers?: string[];
+  publicStyleIdentifiers?: string[];
+  script?: ScriptRuntimeAssetSelector;
+  style?: ScriptRuntimeAssetSelector;
+  scriptSelectors?: ScriptRuntimeAssetSelector[];
+  styleSelectors?: ScriptRuntimeAssetSelector[];
+  runAt?: ScriptRuntimeRunAt;
+  /** 返回已绑定的 document_start 候选及 URL 规则，供客户端跨文档预注册。 */
+  preloadBoundAssets?: boolean;
+}
+
+export interface ScriptRuntimeResolvedAsset {
+  assetType: ScriptRuntimeAssetType;
+  platform: string;
+  identifier: string;
+  version: string;
+  effectiveVersionId?: string;
+  runAt: ScriptRuntimeRunAt;
+  priority: number;
+  enabled?: boolean;
+  source: string;
+  sourceSha256: string;
+  status?: "released" | "active";
+  networkCapabilities?: ScriptRuntimeNetworkCapability[];
+  matchRules?: ScriptRuntimeMatchRule[];
+  /** false 表示该明确选择的资源不应用其已保存的 URL 规则。 */
+  matchConfiguredUrlRules?: boolean;
+}
+
+export interface ScriptRuntimeResolveResponse {
+  platform: string;
+  url: string;
+  manifestRevision?: string;
+  fetchedAt?: string;
+  assets: ScriptRuntimeResolvedAsset[];
+  public?: PublicRuntimeAsset[];
+  publicStyles?: PublicRuntimeStyleAsset[];
+}
+
+export interface PublicRuntimeAsset {
+  id: string;
+  identifier: string;
+  platform: string;
+  version: string;
+  source: string;
+  sourceSha256: string;
+  dependencies?: string[];
+  networkCapabilities?: ScriptRuntimeNetworkCapability[];
+}
+
+export interface PublicRuntimeStyleAsset {
+  id: string;
+  identifier: string;
+  platform: string;
+  version: string;
+  source: string;
+  sourceSha256: string;
+  runAt: ScriptRuntimeRunAt;
+  priority: number;
+  enabled: boolean;
+  networkCapabilities?: ScriptRuntimeNetworkCapability[];
+  matchRules?: ScriptRuntimeMatchRule[];
+  matchConfiguredUrlRules?: boolean;
+}
+
+export const SCRIPT_RUNTIME_RESOLVE_PATH = "/api/v1/script-runtime/resolve";
