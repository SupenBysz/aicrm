+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { normalizeLoginSpaceInfoPatch } from "./login-space-info-sdk.ts";
+
+test("登录空间状态补丁允许名称和状态分别更新，并拒绝额外字段", () => {
+  assert.deepEqual(normalizeLoginSpaceInfoPatch({ loginStatus: "logged_in" }), { loginStatus: "logged_in" });
+  assert.deepEqual(normalizeLoginSpaceInfoPatch({ displayName: "  店铺账号  " }), { displayName: "店铺账号" });
+  assert.equal(Array.from(normalizeLoginSpaceInfoPatch({ displayName: "😀".repeat(128) }).displayName).length, 128);
+  assert.throws(() => normalizeLoginSpaceInfoPatch(null), /LOGIN_SPACE_INFO_INVALID/);
+  assert.throws(() => normalizeLoginSpaceInfoPatch({ loginStatus: "online" }), /LOGIN_SPACE_INFO_INVALID/);
+  assert.throws(() => normalizeLoginSpaceInfoPatch({ displayName: " " }), /LOGIN_SPACE_INFO_INVALID/);
+  assert.throws(() => normalizeLoginSpaceInfoPatch({ displayName: "😀".repeat(129) }), /LOGIN_SPACE_INFO_INVALID/);
+  assert.throws(() => normalizeLoginSpaceInfoPatch({ uuid: "attacker-controlled" }), /LOGIN_SPACE_INFO_INVALID/);
+});
+
+test("受控登录空间通过已验证 UUID 绑定写入并向 Host 推送更新事件", async () => {
+  const [preload, main, matrixIpc, webWindow, bridge, host, core] = await Promise.all([
+    readFile(new URL("../preload/web-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("./app-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("./ipc/matrix-account-ipc.ts", import.meta.url), "utf8"),
+    readFile(new URL("./web-injection-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("../preload/bridge.ts", import.meta.url), "utf8"),
+    readFile(new URL("../../../../plugins/ky-shop-management/src/pages/shop-management-page.tsx", import.meta.url), "utf8"),
+    readFile(new URL("../../../../packages/ky-admin-core/src/matrix-account-desktop.ts", import.meta.url), "utf8")
+  ]);
+  assert.match(preload, /updateLoginSpaceInfo\(options:\s*WebWindowLoginSpaceInfoUpdate\).*sdkRequest\("updateLoginSpaceInfo",\s*options\)/);
+  assert.match(matrixIpc, /const spaceUuid = bindingContext\?\.uuid/);
+  assert.match(matrixIpc, /webSpaceUuid:\s*spaceUuid/);
+  assert.match(webWindow, /webWindowSpaceUuids\.set\(child,\s*options\.webSpaceUuid\)/);
+  assert.match(main, /webWindowSpaceUuids.get\(child\)/);
+  assert.match(main, /data.uuid !== spaceUuid/);
+  assert.match(main, /matrixAccountLoginSpaceInfoChanged,\s*event/);
+  assert.match(bridge, /onLoginSpaceInfoChanged/);
+  assert.match(core, /onMatrixAccountLoginSpaceInfoChanged/);
+  assert.match(host, /onMatrixAccountLoginSpaceInfoChanged\(payload/);
+  assert.match(host, /applyLoginSpaceInfoUpdate\(current, update\)/);
+});
diff --git a/apps/aicrm-desktop/src/main/login-space-info-sdk.ts b/apps/aicrm-desktop/src/main/login-space-info-sdk.ts
