+function updateNavigationState(next: Partial<NavigationState>): void {
+  const generation = typeof next.navigationGeneration === "number" ? next.navigationGeneration : lastNavigationGeneration;
+  const sequence = typeof next.sequence === "number" ? next.sequence : lastNavigationSequence + 1;
+  if (generation < lastNavigationGeneration || (generation === lastNavigationGeneration && sequence < lastNavigationSequence)) return;
