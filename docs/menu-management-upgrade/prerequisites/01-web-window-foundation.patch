+    let envelope: RuntimeEnvelope;
+    let resolverRequestBody: Record<string, unknown> | null = null;
+    const manifestAssets = [
+      ...(this.manifestSnapshot?.assets ?? []),
+      ...(this.manifestSnapshot?.public ?? []),
+      ...(this.manifestSnapshot?.publicStyles ?? [])
+    ];
+    const manifestAvailable = this.manifestSnapshot !== undefined && this.manifestSnapshot !== null;
+    const configuredScript = this.options.script ?? (this.options.identifier ? { identifier: this.options.identifier } : undefined);
+    const early = {
+      script: configuredScript && selectorHasDocumentStartBinding(configuredScript, "script", manifestAssets, manifestAvailable) ? configuredScript : undefined,
