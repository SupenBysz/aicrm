+async function addActionButton(options: WebWindowActionButtonOptions): Promise<WebWindowActionButtonHandle> {
+  if (windowRole !== "business") throw Object.assign(new Error("功能按钮只能从业务页面注册"), { code: "WINDOW_ACTION_UNAVAILABLE" });
+  if (!options || typeof options !== "object" || typeof options.onClick !== "function") throw Object.assign(new TypeError("功能按钮必须提供 icon 和 onClick"), { code: "WINDOW_ACTION_ARGUMENT_INVALID" });
