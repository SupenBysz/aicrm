+import test from "node:test";
+import assert from "node:assert/strict";
+import { downloadRemoteLogo, isPublicAddress, validateRemoteImageUrl } from "./web-window-remote-image.ts";
+
+const png = Uint8Array.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1]);
+function transport({ addresses = ["93.184.216.34"], response = { status: 200, headers: { "content-type": "image/png" }, body: png }, lookup = null } = {}) {
+  const requests = [];
+  return { requests, lookup: async (host) => { assert.ok(host); return lookup ? lookup(host) : addresses; }, request: async (url, address, maxBytes, timeoutMs) => { requests.push({ url: url.toString(), address, maxBytes, timeoutMs }); return response; } };
+}
+
+test("accepts HTTPS public image URL and pins a validated address", async () => {
+  const t = transport();
+  const result = await downloadRemoteLogo("https://images.example/logo.png?sig=secret", t);
+  assert.equal(result.mime, "image/png");
+  assert.deepEqual([...result.bytes], [...png]);
+  assert.equal(t.requests[0].address, "93.184.216.34");
+  assert.equal(t.requests[0].maxBytes, 2 * 1024 * 1024);
+  assert.equal(t.requests[0].timeoutMs, 8000);
+  assert.equal(validateRemoteImageUrl("https://images.example/logo.png").hostname, "images.example");
+});
+
+test("rejects non-HTTPS, credentials, and non-default ports", () => {
+  for (const value of ["http://images.example/a.png", "https://u:p@images.example/a.png", "https://images.example:444/a.png", "not a url"]) assert.throws(() => validateRemoteImageUrl(value), /REMOTE_IMAGE_URL_INVALID/);
+});
+
+test("rejects private, loopback, link-local and mixed public/private DNS answers", async () => {
+  for (const address of ["127.0.0.1", "10.0.0.1", "169.254.169.254", "192.168.1.4", "192.88.99.1", "::1", "fe80::1", "fc00::1", "2001:db8::1", "2001:2::1", "2002:c0a8:0101::1", "3fff::1"]) assert.equal(isPublicAddress(address), false, address);
+  assert.equal(isPublicAddress("2001:4860:4860::8888"), true);
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", transport({ addresses: ["93.184.216.34", "10.0.0.1"] })), /REMOTE_IMAGE_ADDRESS_BLOCKED/);
+});
+
+test("revalidates every redirect target before requesting it", async () => {
+  const t = transport({ lookup: async (host) => host === "127.0.0.1" ? ["127.0.0.1"] : ["93.184.216.34"], response: { status: 302, headers: { location: "https://127.0.0.1/admin" }, body: new Uint8Array() } });
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", t), /REMOTE_IMAGE_ADDRESS_BLOCKED/);
+  assert.equal(t.requests.length, 1);
+});
+
+test("rejects too many redirects, bad MIME, and non-image bytes", async () => {
+  const redirect = transport({ response: { status: 302, headers: { location: "/again" }, body: new Uint8Array() } });
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", redirect), /REMOTE_IMAGE_REDIRECT_BLOCKED/);
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", transport({ response: { status: 200, headers: { "content-type": "text/html" }, body: png } })), /REMOTE_IMAGE_TYPE_INVALID/);
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", transport({ response: { status: 200, headers: { "content-type": "image/png" }, body: new Uint8Array([1, 2, 3]) } })), /REMOTE_IMAGE_CONTENT_INVALID/);
+});
+
+test("rejects response bodies larger than the cap and transport timeouts safely", async () => {
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", transport({ response: { status: 200, headers: { "content-type": "image/png" }, body: new Uint8Array(2 * 1024 * 1024 + 1) } })), /REMOTE_IMAGE_TOO_LARGE/);
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", { lookup: async () => ["93.184.216.34"], request: async () => { throw new Error("REMOTE_IMAGE_TIMEOUT"); } }), /REMOTE_IMAGE_TIMEOUT/);
+  await assert.rejects(downloadRemoteLogo("https://images.example/logo.png", { lookup: () => new Promise(() => {}), request: async () => ({ status: 200, headers: { "content-type": "image/png" }, body: png }) }), /REMOTE_IMAGE_TIMEOUT/);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-remote-image.ts b/apps/aicrm-desktop/src/main/web-window-remote-image.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1fb1525a8e0c8561d9ed8a76d3fd232d63dc0afb
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-remote-image.ts
@@ -0,0 +1,146 @@
+import { lookup as dnsLookup } from "node:dns/promises";
+import { isIP } from "node:net";
+import https from "node:https";
+
+export type RemoteImageResponse = { status: number; headers: Record<string, string | undefined>; body: Uint8Array };
+export type RemoteImageTransport = {
+  lookup(host: string): Promise<string[]>;
+  request(url: URL, address: string, maxBytes: number, timeoutMs: number): Promise<RemoteImageResponse>;
+};
+
+const MAX_BYTES = 2 * 1024 * 1024;
+const TIMEOUT_MS = 8_000;
+const MAX_REDIRECTS = 3;
+
+function isPublicIPv4(address: string): boolean {
+  const parts = address.split(".").map(Number);
+  if (parts.length !== 4 || parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255)) return false;
+  const [a, b, c] = parts;
+  return !(a === 0 || a === 10 || a === 127 || a >= 224
+    || (a === 100 && b >= 64 && b <= 127)
+    || (a === 169 && b === 254)
+    || (a === 172 && b >= 16 && b <= 31)
+    || (a === 192 && (b === 0 || b === 168))
+    || (a === 192 && b === 88 && c === 99)
+    || (a === 192 && b === 175 && c === 48)
+    || (a === 198 && (b === 18 || b === 19 || (b === 51 && c === 100)) )
+    || (a === 203 && b === 0 && c === 113));
+}
+
+function isPublicIPv6(address: string): boolean {
+  const normalized = address.toLowerCase().split("%")[0];
+  if (normalized.startsWith("::ffff:")) return isPublicIPv4(normalized.slice(7));
+  if (normalized === "::" || normalized === "::1") return false;
+  const halves = normalized.split("::");
+  if (halves.length > 2) return false;
+  const parseWords = (part: string): number[] => part ? part.split(":").map((word) => Number.parseInt(word, 16)) : [];
+  const left = parseWords(halves[0]);
+  const right = parseWords(halves[1] ?? "");
+  const words = halves.length === 2 ? [...left, ...Array(Math.max(0, 8 - left.length - right.length)).fill(0), ...right] : left;
+  if (words.length !== 8 || words.some((word) => !Number.isInteger(word) || word < 0 || word > 0xffff)) return false;
+  const first = words[0];
+  const first32 = first * 0x10000 + words[1];
+  // 仅接受 2000::/3 全球单播范围，并排除 IANA 特殊用途、6to4 和文档网段。
+  if (first < 0x2000 || first > 0x3fff || (first32 >= 0x20010000 && first32 < 0x20010200) || first32 === 0x20010db8
+    || first === 0x2002 || (first === 0x3fff && words[1] < 0x1000)) return false;
+  return true;
+}
+
+export function isPublicAddress(address: string): boolean {
+  const family = isIP(address);
+  return family === 4 ? isPublicIPv4(address) : family === 6 ? isPublicIPv6(address) : false;
+}
+
+export function validateRemoteImageUrl(raw: unknown): URL {
+  if (typeof raw !== "string" || raw.length < 1 || raw.length > 2048 || /[\u0000-\u0020\u007f]/.test(raw)) throw new Error("REMOTE_IMAGE_URL_INVALID");
+  let url: URL;
+  try { url = new URL(raw); } catch { throw new Error("REMOTE_IMAGE_URL_INVALID"); }
+  if (url.protocol !== "https:" || url.username || url.password || (url.port && url.port !== "443")) throw new Error("REMOTE_IMAGE_URL_INVALID");
+  url.hash = "";
+  return url;
+}
+
+async function systemLookup(host: string): Promise<string[]> {
+  if (isIP(host)) return [host];
+  return (await dnsLookup(host, { all: true, verbatim: true })).map((item) => item.address);
+}
+
+function requestPinned(url: URL, address: string, maxBytes: number, timeoutMs: number): Promise<RemoteImageResponse> {
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    let deadline: ReturnType<typeof setTimeout>;
+    const finish = (error?: Error, value?: RemoteImageResponse) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(deadline);
+      if (error) reject(error);
+      else resolve(value!);
+    };
+    const req = https.request(url, {
+      method: "GET",
+      headers: { Accept: "image/png,image/jpeg" },
+      servername: isIP(url.hostname.replace(/^\[|\]$/g, "")) ? undefined : url.hostname,
+      lookup: (_hostname, _options, callback) => callback(null, address, isIP(address)),
+      timeout: timeoutMs,
+      maxHeaderSize: 16 * 1024,
+    }, (response) => {
+      const status = response.statusCode ?? 0;
+      const headers = Object.fromEntries(Object.entries(response.headers).map(([key, value]) => [key.toLowerCase(), Array.isArray(value) ? value.join(",") : value]));
+      if ([301, 302, 303, 307, 308].includes(status)) { response.resume(); finish(undefined, { status, headers, body: new Uint8Array() }); return; }
+      const contentLength = Number(response.headers["content-length"] ?? 0);
+      if (Number.isFinite(contentLength) && contentLength > maxBytes) { response.destroy(new Error("REMOTE_IMAGE_TOO_LARGE")); return; }
+      const chunks: Buffer[] = [];
+      let size = 0;
+      response.on("data", (chunk: Buffer) => {
+        size += chunk.length;
+        if (size > maxBytes) { response.destroy(new Error("REMOTE_IMAGE_TOO_LARGE")); return; }
+        chunks.push(chunk);
+      });
+      response.on("end", () => finish(undefined, { status, headers, body: Buffer.concat(chunks) }));
+      response.on("error", finish);
+    });
+    req.on("timeout", () => req.destroy(new Error("REMOTE_IMAGE_TIMEOUT")));
+    req.on("error", finish);
+    deadline = setTimeout(() => req.destroy(new Error("REMOTE_IMAGE_TIMEOUT")), timeoutMs);
+    req.end();
+  });
+}
+
+const defaultTransport: RemoteImageTransport = { lookup: systemLookup, request: requestPinned };
+
+async function withTimeout<T>(operation: Promise<T>, timeoutMs: number): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      operation,
+      new Promise<T>((_, reject) => { timer = setTimeout(() => reject(new Error("REMOTE_IMAGE_TIMEOUT")), timeoutMs); }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+export async function downloadRemoteLogo(rawUrl: unknown, transport: RemoteImageTransport = defaultTransport): Promise<{ bytes: Uint8Array; mime: "image/png" | "image/jpeg" }> {
+  let url = validateRemoteImageUrl(rawUrl);
+  for (let redirect = 0; redirect <= MAX_REDIRECTS; redirect++) {
+    const addresses = await withTimeout(transport.lookup(url.hostname.replace(/^\[|\]$/g, "")), TIMEOUT_MS);
+    if (!addresses.length || addresses.some((address) => !isPublicAddress(address))) throw new Error("REMOTE_IMAGE_ADDRESS_BLOCKED");
+    const result = await withTimeout(transport.request(url, addresses[0], MAX_BYTES, TIMEOUT_MS), TIMEOUT_MS);
+    if ([301, 302, 303, 307, 308].includes(result.status)) {
+      if (redirect === MAX_REDIRECTS || !result.headers.location) throw new Error("REMOTE_IMAGE_REDIRECT_BLOCKED");
+      url = validateRemoteImageUrl(new URL(result.headers.location, url).toString());
+      continue;
+    }
+    if (result.status < 200 || result.status >= 300) throw new Error("REMOTE_IMAGE_FETCH_FAILED");
+    if (result.body.byteLength > MAX_BYTES) throw new Error("REMOTE_IMAGE_TOO_LARGE");
+    const type = (result.headers["content-type"] ?? "").split(";", 1)[0].trim().toLowerCase();
+    const mime = type === "image/png" ? "image/png" : type === "image/jpeg" ? "image/jpeg" : null;
+    if (!mime) throw new Error("REMOTE_IMAGE_TYPE_INVALID");
+    const png = result.body.length >= 8 && result.body[0] === 0x89 && result.body[1] === 0x50 && result.body[2] === 0x4e && result.body[3] === 0x47;
+    const jpeg = result.body.length >= 3 && result.body[0] === 0xff && result.body[1] === 0xd8 && result.body[2] === 0xff;
+    if ((mime === "image/png" && !png) || (mime === "image/jpeg" && !jpeg)) throw new Error("REMOTE_IMAGE_CONTENT_INVALID");
+    // Image Service performs full decoding, dimension validation, and sanitized PNG/JPEG re-encoding.
+    return { bytes: result.body, mime };
+  }
+  throw new Error("REMOTE_IMAGE_REDIRECT_BLOCKED");
+}
