+const lifecycleListeners = new Map<string, Set<{ handler: (detail: unknown) => unknown; once: boolean }>>();
+const lifecycleState = new Map<string, unknown>();
+const lifecycleBridge = {
+  on(event: string, handler: (detail: unknown) => unknown) {
+    if (typeof handler !== "function") return () => undefined;
+    const set = lifecycleListeners.get(event) ?? new Set();
+    const entry = { handler, once: false };
+    set.add(entry); lifecycleListeners.set(event, set);
+    if (lifecycleState.has(event)) queueMicrotask(() => { try { void handler(lifecycleState.get(event)); } catch { /* 页面回调异常不影响宿主 */ } });
+    return () => set.delete(entry);
+  },
+  once(event: string, handler: (detail: unknown) => unknown) {
+    if (typeof handler !== "function") return () => undefined;
+    const set = lifecycleListeners.get(event) ?? new Set();
+    const entry = { handler, once: true };
+    set.add(entry); lifecycleListeners.set(event, set);
+    if (lifecycleState.has(event)) { set.delete(entry); queueMicrotask(() => { try { void handler(lifecycleState.get(event)); } catch { /* 页面回调异常不影响宿主 */ } }); }
+    return () => set.delete(entry);
+  },
+  off(event: string, handler?: (detail: unknown) => unknown) {
+    const set = lifecycleListeners.get(event); if (!set) return;
+    for (const entry of [...set]) if (!handler || entry.handler === handler) set.delete(entry);
+  },
+  __dispatch(event: string, detail: unknown) {
+    lifecycleState.set(event, detail);
+    const set = lifecycleListeners.get(event); if (!set) return;
+    for (const entry of [...set]) { if (entry.once) set.delete(entry); try { void entry.handler(detail); } catch { /* 页面回调异常不影响宿主 */ } }
+  }
+};
