+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { createServer } from "node:http";
+import { app, BrowserWindow } from "electron";
+import { ClientTestInjector, clientTestModeEnabled } from "./script-injector.ts";
+import { ProductionScriptRuntime } from "./script-runtime.ts";
+
+let exitCode = 0;
+let window;
+let productionRuntime;
+let documentStartServer;
+let finished = false;
+const watchdog = setTimeout(() => finish(new Error("electron_script_runtime_test_timeout")), 30000);
+
+function finish(error) {
+  if (finished) return;
+  finished = true;
+  clearTimeout(watchdog);
+  if (error) {
+    exitCode = 1;
+    console.error(error);
+  }
+  productionRuntime?.stop();
+  documentStartServer?.close();
+  if (window && !window.isDestroyed()) window.destroy();
+  app.exit(exitCode);
+}
+
+async function run() {
+  try {
+    process.env.KWW_SCRIPT_RUNTIME_MODE = "client-test";
+    console.log("script-runtime electron test: ready");
+    window = new BrowserWindow({
+      show: false,
+      webPreferences: { sandbox: true, contextIsolation: true, nodeIntegration: false }
+    });
+    await window.loadURL("data:text/html,<html><head></head><body><div id='fixture'>fixture</div></body></html>");
+    assert.equal(clientTestModeEnabled(), true);
+    const plan = {
+      workspaceType: "platform", workspaceId: "fixture-workspace", normalizedUrl: "data:text/html,fixture",
+      navigationGeneration: 1, routeKey: "data:text/html,fixture", runAt: "document_idle", items: [
+        { id: "css-1", kind: "style", runAt: "document_idle", priority: 1, identifier: "fixture-style", scriptId: "script-1", effectiveVersionId: "version-1", state: "planned", errorCode: null },
+        { id: "js-1", kind: "script", runAt: "document_idle", priority: 2, identifier: "fixture-script", scriptId: "script-1", effectiveVersionId: "version-1", state: "planned", errorCode: null }
+      ]
+    };
+    const assets = [
+      { ...plan.items[0], sourceContent: ":root { --kww-css-ready: yes; }" },
+      { ...plan.items[1], sourceContent: "window.__kwwObserved = getComputedStyle(document.documentElement).getPropertyValue('--kww-css-ready').trim();" }
+    ];
+    const injector = new ClientTestInjector();
+    const first = await injector.inject(window.webContents, plan, assets);
+    assert.deepEqual(first.map((item) => item.state), ["succeeded", "succeeded"]);
+    assert.equal(await window.webContents.executeJavaScript("window.__kwwObserved"), "yes");
+    assert.deepEqual(await injector.inject(window.webContents, plan, assets), []);
+    const duplicateScriptPlan = { ...plan, navigationGeneration: 2, routeKey: plan.routeKey };
+    const duplicateScript = [{ ...assets[1], id: "js-duplicate", scriptId: "script-duplicate", sourceContent: "window.__kwwDuplicateCount = (window.__kwwDuplicateCount || 0) + 1;" }];
+    assert.deepEqual((await injector.inject(window.webContents, duplicateScriptPlan, duplicateScript)).map((item) => item.state), ["succeeded"]);
+    assert.deepEqual((await injector.inject(window.webContents, { ...duplicateScriptPlan, navigationGeneration: 3 }, duplicateScript)).map((item) => item.state), ["succeeded"]);
+    assert.equal(await window.webContents.executeJavaScript("window.__kwwDuplicateCount"), 1);
+    const cancelled = await injector.inject(window.webContents, { ...plan, navigationGeneration: 2, routeKey: "data:text/html,next" }, assets, { generationIsCurrent: () => false });
