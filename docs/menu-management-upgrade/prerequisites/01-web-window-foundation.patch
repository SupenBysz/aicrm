+  text: string;
+  title?: string;
+  tone: "muted" | "normal" | "warning" | "error";
+  actionId?: "back" | "reload" | "home" | "version-panel" | "injection-panel";
+};
+export type WebWindowPluginContext = {
+  instanceId: string;
+  navigationGeneration: NavigationGeneration;
+  uiSessionId: string;
+  activeRevision: number;
+  injectionState: string;
+  plugin?: WebWindowPluginInfo;
+  client?: WebWindowClientInfo;
+  injection?: WebWindowInjectionInfo;
+  page?: WebWindowPageInfo;
+};
+
+export const WEB_WINDOW_CHANNELS = {
