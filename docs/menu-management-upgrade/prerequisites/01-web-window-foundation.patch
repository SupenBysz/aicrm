+  notification: { success(options: { message: string; description?: string; durationMs?: number }): Promise<void>; info(options: { message: string; description?: string; durationMs?: number }): Promise<void>; warning(options: { message: string; description?: string; durationMs?: number }): Promise<void>; error(options: { message: string; description?: string; durationMs?: number }): Promise<void> };
+  modal: { confirm(options: { title: string; content: string; okText?: string; cancelText?: string }): Promise<boolean>; info(options: { title: string; content: string }): Promise<void>; success(options: { title: string; content: string }): Promise<void>; warning(options: { title: string; content: string }): Promise<void>; error(options: { title: string; content: string }): Promise<void> };
+}
+interface PublicApi {
+  register(definition: { identifier: string; factory: (input: { jssdk: Jssdk }) => Record<string, unknown> }): void;
