+  for (const asset of envelope.assets ?? []) {
+    if (asset.assetType !== "script") continue;
+    const policy: RuntimeURLMatchPolicy = {
+      matchConfiguredUrlRules: asset.matchConfiguredUrlRules !== false,
+      matchRules: (asset.matchRules ?? []).filter((rule) => rule.enabled),
+    };
+    for (const identifier of declaredPublicDependencies(asset.source)) queue.push({ identifier, policy });
+  }
+
+  while (queue.length > 0) {
+    const next = queue.shift()!;
+    const previous = policies.get(next.identifier);
+    const merged: RuntimeURLMatchPolicy = previous
+      ? {
+          matchConfiguredUrlRules: previous.matchConfiguredUrlRules && next.policy.matchConfiguredUrlRules,
+          matchRules: [...previous.matchRules],
+        }
+      : { matchConfiguredUrlRules: next.policy.matchConfiguredUrlRules, matchRules: [] };
+    if (merged.matchConfiguredUrlRules) {
+      const unique = new Set(merged.matchRules.map((rule) => JSON.stringify([rule.matchType, rule.pattern, rule.ignoreQuery])));
+      for (const rule of next.policy.matchRules) {
+        const key = JSON.stringify([rule.matchType, rule.pattern, rule.ignoreQuery]);
+        if (!unique.has(key)) {
+          unique.add(key);
+          merged.matchRules.push(rule);
+        }
+      }
+    } else {
+      merged.matchRules = [];
+    }
+    const previousSignature = previous ? JSON.stringify(previous) : "";
+    const nextSignature = JSON.stringify(merged);
+    if (previousSignature === nextSignature) continue;
+    policies.set(next.identifier, merged);
+
+    const dependency = publicByIdentifier.get(next.identifier);
+    for (const child of dependency?.dependencies ?? []) queue.push({ identifier: child, policy: merged });
+  }
+
+  return policies;
+}
+
+/**
+ * 某些服务端候选响应会返回已授权的公共脚本，但没有足够的依赖边信息将它
+ * 关联到某个消费者。此时让它继承本次已授权业务脚本的规则并集；没有
+ * 任何可用规则时保持严格失败。
+ */
+function fallbackPublicScriptURLMatchPolicy(envelope: RuntimeEnvelope): RuntimeURLMatchPolicy | undefined {
+  const consumers = (envelope.assets ?? []).filter(
+    (asset) => asset.assetType === "script" && asset.enabled !== false,
+  );
+  if (consumers.some((asset) => asset.matchConfiguredUrlRules === false)) {
+    return { matchRules: [], matchConfiguredUrlRules: false };
+  }
+
+  const rules = new Map<string, ScriptRuntimeMatchRule>();
+  for (const consumer of consumers) {
+    for (const rule of consumer.matchRules ?? []) {
+      if (!rule.enabled) continue;
+      const key = JSON.stringify([rule.matchType, rule.pattern, rule.ignoreQuery]);
+      if (!rules.has(key)) rules.set(key, rule);
+    }
+  }
+
+  if (rules.size === 0) return undefined;
+  return { matchRules: [...rules.values()], matchConfiguredUrlRules: true };
+}
+
+function documentStartURLGuardSource(
+  asset: RuntimeCandidateResponse,
+  routeAware: boolean,
+  routeKeyForSinglePage: string,
+  allowedOriginMatchers: readonly string[],
+): string {
+  if (!routeAware) {
+    return `const u=new URL(location.href);if(u.origin+u.pathname+u.search!==${JSON.stringify(routeKeyForSinglePage)})return;`;
+  }
+
+  const originRegexSources = JSON.stringify(originPatternRegexSources(allowedOriginMatchers));
+  const originGuard = `const u=new URL(location.href);const allowedOriginRegexSources=${originRegexSources};if(!allowedOriginRegexSources.some((source)=>new RegExp(source,"i").test(u.origin)))return;`;
+  if (asset.matchConfiguredUrlRules === false) return originGuard;
+  const rules = (asset.matchRules ?? []).filter((rule) => rule.enabled);
+  if (rules.length === 0) throw new Error(`asset_match_rules_missing:${asset.identifier}`);
+  const serializedRules = JSON.stringify(rules.map(({ matchType, pattern, ignoreQuery }) => ({ matchType, pattern, ignoreQuery })));
+  return `${originGuard}
+const actual = u.origin + u.pathname + u.search;
+const rules = ${serializedRules};
+const matchesRule = (rule) => {
+  let value = actual;
+  let pattern = rule.pattern;
+  if (rule.ignoreQuery) {
+    value = value.split("?")[0];
+    pattern = pattern.split("?")[0];
+  }
+  if (rule.matchType === "prefix") return value.startsWith(pattern);
+  if (rule.matchType === "exact") return value === pattern;
+  const parts = pattern.split("*");
+  let cursor = 0;
+  for (let index = 0; index < parts.length; index += 1) {
+    const part = parts[index];
+    if (!part) continue;
+    const found = value.indexOf(part, cursor);
+    if (found < 0 || (index === 0 && !pattern.startsWith("*") && found !== 0)) return false;
+    cursor = found + part.length;
+    if (index === parts.length - 1 && !pattern.endsWith("*") && cursor !== value.length) return false;
+  }
+  return true;
+};
+if (!rules.some(matchesRule)) return;`;
+}
+
+function runtimeAssetMatchesURL(asset: ClientTestAsset, url: string, allowedOriginMatchers: readonly string[]): boolean {
+  let parsed: URL;
+  try { parsed = new URL(url); } catch { return false; }
+  if (!isAllowedByOriginPatterns(url, allowedOriginMatchers)) return false;
+  if (asset.matchConfiguredUrlRules === false) return true;
+  const actual = `${parsed.origin}${parsed.pathname}${parsed.search}`;
+  return (asset.matchRules ?? []).some((rule) => {
+    if (!rule.enabled) return false;
+    let value = actual;
+    let pattern = rule.pattern;
+    if (rule.ignoreQuery) {
+      value = value.split("?")[0];
+      pattern = pattern.split("?")[0];
+    }
+    if (rule.matchType === "exact") return value === pattern;
+    if (rule.matchType === "prefix") return value.startsWith(pattern);
+    const parts = pattern.split("*");
+    let cursor = 0;
+    for (let index = 0; index < parts.length; index += 1) {
+      const part = parts[index];
+      if (!part) continue;
+      const found = value.indexOf(part, cursor);
+      if (found < 0 || (index === 0 && !pattern.startsWith("*") && found !== 0)) return false;
+      cursor = found + part.length;
+      if (index === parts.length - 1 && !pattern.endsWith("*") && cursor !== value.length) return false;
+    }
+    return true;
+  });
+}
+
+function mergePublicAssetsByIdentifier<T extends { identifier: string }>(
+  initial: T[] | undefined,
+  resolved: T[] | undefined,
+): T[] | undefined {
+  if (!initial?.length) return resolved;
+  if (!resolved?.length) return initial;
+  const merged = new Map(initial.map((asset) => [asset.identifier, asset]));
+  for (const asset of resolved) merged.set(asset.identifier, asset);
+  return [...merged.values()];
+}
+
+function sourceMatchesHash(asset: RuntimeCandidateResponse): boolean {
+  const expected = asset.sourceSha256 ?? asset.contentSha256;
+  if (!expected) return true;
+  if (!/^[a-f0-9]{64}$/i.test(expected)) return false;
+  const actual = createHash("sha256").update(asset.sourceContent, "utf8").digest("hex");
+  return actual === expected.toLowerCase();
+}
+
+function selectorHasDocumentStartBinding(
+  selector: ScriptRuntimeAssetSelector,
+  assetType: "script" | "style",
+  assets: RuntimeManifestAsset[],
+  manifestAvailable: boolean,
+  publicAsset = false
+): boolean {
+  if (selector.enabled === false || (selector.runAt && selector.runAt !== "document_start")) return false;
+  if (!manifestAvailable) return true;
+  const candidates = assets.filter((asset) => {
+    const sameType = publicAsset
+      ? assetType === "script" ? asset.assetType === "script" : asset.assetType === "style" || asset.assetType === "public-style"
+      : asset.assetType === assetType;
+    const sameVersion = !selector.version || selector.version === asset.version || selector.version === asset.effectiveVersionId;
+    return sameType && asset.identifier === selector.identifier && sameVersion;
+  });
+  // 缺少对应清单项时仍交给 resolver 校验，避免把失效绑定误判为“无需 document_start”。
+  if (candidates.length === 0) return true;
+  const enabled = candidates.filter((asset) => asset.enabled !== false);
+  if (enabled.length === 0) return false;
+  // 明确要求 document_start 的绑定要保留给 resolver 校验；若清单与绑定冲突，严格模式应报错。
+  if (selector.runAt === "document_start") return true;
+  return enabled.some((asset) => (asset.runAt ?? (publicAsset && assetType === "script" ? "document_start" : undefined)) === "document_start"
+    || asset.runAt === undefined);
+}
+
+function filterIdentifiersForDocumentStart(
+  identifiers: string[] | undefined,
+  assetType: "script" | "style",
+  assets: RuntimeManifestAsset[],
+  manifestAvailable: boolean,
+  publicAsset = false
+): string[] {
+  return (identifiers ?? []).filter((identifier) => selectorHasDocumentStartBinding(
+    { identifier }, assetType, assets, manifestAvailable, publicAsset
+  ));
+}
+
+type RuntimeDebugger = { isAttached(): boolean; attach(version?: string): void; sendCommand(method: string, params?: Record<string, unknown>): Promise<unknown>; detach(): void };
+
+function sendCdpCommand<T>(debug: RuntimeDebugger, method: string, params: Record<string, unknown> | undefined, timeoutMs: number): Promise<T> {
+  const command = debug.sendCommand(method, params);
+  return new Promise<T>((resolve, reject) => {
+    let timedOut = false;
+    const timer = setTimeout(() => {
+      timedOut = true;
+      reject(new Error(`cdp_command_timeout:${method}`));
+    }, timeoutMs);
+    command.then((result) => {
+      clearTimeout(timer);
+      if (timedOut) {
+        const identifier = method === "Page.addScriptToEvaluateOnNewDocument"
+          ? (result as { identifier?: unknown } | null)?.identifier
+          : null;
+        if (typeof identifier === "string" && debug.isAttached()) {
+          void debug.sendCommand("Page.removeScriptToEvaluateOnNewDocument", { identifier }).catch(() => undefined);
+        }
+        return;
+      }
+      resolve(result as T);
+    }, (error) => {
+      clearTimeout(timer);
+      if (!timedOut) reject(error);
+    });
+  });
+}
+
+// 主进程可能以无终端方式启动；输出管道被关闭时，Node 的 console 会抛出 EIO，
+// 日志不能影响网页窗口和注入流程。
+function safeRuntimeLog(level: "info" | "warn", ...args: unknown[]): void {
+  try {
+    // 不写 stdout/stderr：开发客户端由管道启动时，Node console 的异步 EIO
+    // 会在回调阶段抛出并终止 Electron 主进程。诊断信息落本地文件，避免影响运行时。
+    appendFileSync("/tmp/aicrm-script-runtime.log", `${new Date().toISOString()} ${level} ${args.map(String).join(" ")}\n`, { encoding: "utf8" });
+  } catch {
+    // 仅丢弃日志，运行时流程继续执行。
+  }
+}
+
+async function publishRuntimeStatus(webContents: WebContents, payload: Record<string, unknown>, enabled: boolean): Promise<void> {
+  if (webContents.isDestroyed() || !enabled) return;
+  const serialized = JSON.stringify({ ...payload, updatedAt: new Date().toISOString() });
+  await webContents.executeJavaScript(`window.__KWW_INJECTION_STATUS__ = ${serialized};`, true);
+}
+
+export class ProductionScriptRuntime {
+  private readonly navigation = new NavigationGeneration();
+  private readonly injector = new ClientTestInjector();
+  private readonly options: ProductionRuntimeOptions;
+  private readonly allowedOriginMatchers: string[];
+  private detach: (() => void) | null = null;
+  private pendingAbort: AbortController | null = null;
+  private navigationUrl: string | null = null;
+  private readonly cache: ScriptRuntimeAssetCache;
+  private readonly earlyDocumentScripts = new WeakMap<WebContents, Map<string, string>>();
+  private readonly preparedDocumentStartUrls = new WeakMap<WebContents, Set<string>>();
+  private readonly routeAwareDocumentStartBundles = new WeakMap<WebContents, { plan: InjectionPlan; assets: ClientTestAsset[] }>();
+  private readonly pendingDocumentStartExecution = new WeakMap<WebContents, PendingDocumentStartExecution>();
+  private readonly debuggerAttachedByRuntime = new WeakMap<WebContents, boolean>();
+  private manifestSnapshot: RuntimeManifestSnapshot | null | undefined;
