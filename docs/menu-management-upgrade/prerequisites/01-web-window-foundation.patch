+        this.pendingAbort = null;
+        const generation = this.navigation.current();
+        void this.execute(webContents, "spa_route_change", url).then(() => generation === this.navigation.current() ? this.dispatchLifecycleEvent(webContents, "routeChange", { url, previousUrl }) : undefined);
