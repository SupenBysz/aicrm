+type NetworkEvent = { decisionToken?: string; kind: WebWindowNetworkKind; stage: string; requestId: string; url: string; method: string; resourceType?: string; status?: number; headers?: Record<string, string>; body?: string; subscriptions?: string[] };
+type NetworkHandler = (event: NetworkEvent & { continue: (decision?: WebWindowNetworkDecision) => Promise<void>; abort: () => Promise<void>; redirect: (url: string) => Promise<void>; fulfill: (body: string, status?: number, headers?: Record<string, string>) => Promise<void> }) => unknown;
+const networkListeners = new Map<string, NetworkHandler>();
+ipcRenderer.on(WEB_WINDOW_CHANNELS.networkEvent, (_event, payload: NetworkEvent) => {
+  for (const id of payload.subscriptions ?? []) {
+    const handler = networkListeners.get(id); if (!handler) continue;
+    const decide = (decision: WebWindowNetworkDecision = { action: "continue" }) => payload.decisionToken ? sdkRequest("networkDecision", { decisionToken: payload.decisionToken, decision }).then(() => undefined) : Promise.resolve();
+    void handler({ ...payload, continue: decide, abort: () => decide({ action: "abort" }), redirect: (url) => decide({ action: "redirect", url }), fulfill: (body, status, headers) => decide({ action: "fulfill", body, status, responseHeaders: headers }) });
+  }
+});
+
+const net = {
+  subscribeRequest(options: WebWindowNetworkSubscriptionOptions, handler: NetworkHandler) { return subscribe("request", options, handler, false); },
+  subscribeResponse(options: WebWindowNetworkSubscriptionOptions, handler: NetworkHandler) { return subscribe("response", options, handler, false); },
+  interceptRequest(options: WebWindowNetworkSubscriptionOptions, handler: NetworkHandler) { return subscribe("request", options, handler, true); },
+  interceptResponse(options: WebWindowNetworkSubscriptionOptions, handler: NetworkHandler) { return subscribe("response", options, handler, true); },
+  waitForRequest(options: WebWindowNetworkSubscriptionOptions) { return waitOnce("request", options); },
+  waitForResponse(options: WebWindowNetworkSubscriptionOptions) { return waitOnce("response", options); }
+};
+async function subscribe(kind: WebWindowNetworkKind, options: WebWindowNetworkSubscriptionOptions, handler: NetworkHandler, intercept: boolean): Promise<() => Promise<unknown>> {
+  const id = await sdkRequest("networkSubscribe", { kind, subscription: options, subscriptionId: intercept ? `intercept:${Date.now()}` : `observe:${Date.now()}` }) as string;
+  networkListeners.set(id, handler);
+  return () => { networkListeners.delete(id); return sdkRequest("networkUnsubscribe", { subscriptionId: id }); };
+}
+async function waitOnce(kind: WebWindowNetworkKind, options: WebWindowNetworkSubscriptionOptions): Promise<unknown> {
+  return new Promise((resolve, reject) => { let unsubscribe: (() => Promise<unknown>) | undefined; void subscribe(kind, options, event => { resolve(event); void unsubscribe?.(); }, false).then(fn => { unsubscribe = fn; }).catch(reject); setTimeout(() => { reject(new Error("NETWORK_WAIT_TIMEOUT")); void unsubscribe?.(); }, options.timeoutMs ?? 10000); });
+}
