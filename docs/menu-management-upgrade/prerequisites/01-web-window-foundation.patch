index 0000000000000000000000000000000000000000..df04b2330fd5d76999f29469f509a5b2de6df635
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/script-injector.ts
@@ -0,0 +1,167 @@
+import type { WebContents } from "electron";
+import { injectionIdempotencyKey, type InjectionPlan, type InjectionPlanItem } from "./script-injection-plan.ts";
+import type { ScriptRuntimeMatchRule } from "./script-runtime-contract.ts";
+import { isAllowedByOriginPatterns, normalizeOriginPatterns } from "./script-runtime-origin-policy.ts";
+
+type ProductionInjectionOptions = {
+  timeoutMs?: number;
+  generationIsCurrent?: () => boolean;
+  /** 向后兼容只授权单一来源的旧调用方。 */
+  productionOrigin?: string;
+  productionOriginMatchers?: string[];
+};
+
+export interface ClientTestAsset extends InjectionPlanItem {
+  sourceContent: string;
+  matchRules?: ScriptRuntimeMatchRule[];
+  matchConfiguredUrlRules?: boolean;
+}
+
+export interface ClientInjectionResult {
+  id: string;
+  scriptId: string;
+  identifier: string;
+  version?: string;
+  effectiveVersionId: string;
+  navigationGeneration: number;
+  routeKey: string;
+  runAt: string;
+  priority: number;
+  kind: "style" | "script";
+  state: "succeeded" | "failed" | "timed_out" | "cancelled";
+  errorCode: string | null;
+}
+
+export const DOCUMENT_START_INJECTION_STATUS_SYMBOL = "kww.script-runtime.document-start-status.v1";
+
+export function clientTestModeEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env.KWW_SCRIPT_RUNTIME_MODE === "client-test";
+}
+
+export function isAllowedClientFixtureURL(value: string): boolean {
+  if (value.startsWith("data:text/html,")) return true;
+  if (!value.startsWith("file:")) return false;
+  try {
+    const path = decodeURIComponent(new URL(value).pathname);
+    const root = process.env.KWW_SCRIPT_FIXTURE_ROOT ?? "/tmp/kww-script-fixture";
+    return path === root || path.startsWith(`${root}/`);
+  } catch {
+    return false;
+  }
+}
+
+function timeout<T>(promise: Promise<T>, timeoutMs: number): Promise<T> {
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error("script_runtime_timeout")), timeoutMs);
+    promise.then((value) => { clearTimeout(timer); resolve(value); }, (error) => { clearTimeout(timer); reject(error); });
+  });
+}
+
+function planKey(plan: InjectionPlan, item: InjectionPlanItem): string {
+  return injectionIdempotencyKey({
+    workspaceType: plan.workspaceType,
+    workspaceId: plan.workspaceId,
+    scriptId: item.scriptId,
+    effectiveVersionId: item.effectiveVersionId,
+    normalizedUrl: plan.normalizedUrl,
+    navigationGeneration: plan.navigationGeneration,
+    routeKey: plan.routeKey,
+    runAt: plan.runAt
+  });
+}
+
+export function guardedScriptSource(plan: InjectionPlan, item: ClientTestAsset): string {
+  const key = `${item.id}|${item.effectiveVersionId}|${plan.routeKey}`;
+  return `(() => {\n  const registry = window.__KWW_SCRIPT_INJECTION_KEYS__ || (window.__KWW_SCRIPT_INJECTION_KEYS__ = new Set());\n  const key = ${JSON.stringify(key)};\n  if (registry.has(key)) return;\n  registry.add(key);\n${item.sourceContent}\n  void 0;\n})()`;
+}
+
+/**
+ * document_start 资源通过 CDP 注册后不会返回页面执行结果。此包装在目标文档实际运行时
+ * 写入轻量回执，供主进程在 DOM ready 后读取；它记录资源代码同步执行到达的结果，
+ * 不代表脚本启动的异步业务已经完成。
+ */
+export function guardedDocumentStartSource(plan: InjectionPlan, item: ClientTestAsset, sourceContent: string): string {
+  const key = `${item.id}|${item.effectiveVersionId}|${plan.routeKey}`;
+  return `(() => {\n` +
+    `  const registry = window.__KWW_SCRIPT_INJECTION_KEYS__ || (window.__KWW_SCRIPT_INJECTION_KEYS__ = new Set());\n` +
+    `  const key = ${JSON.stringify(key)};\n` +
+    `  if (registry.has(key)) return;\n` +
+    `  registry.add(key);\n` +
+    `  const statusKey = Symbol.for(${JSON.stringify(DOCUMENT_START_INJECTION_STATUS_SYMBOL)});\n` +
+    `  const statuses = window[statusKey] || (window[statusKey] = Object.create(null));\n` +
+    `  statuses[key] = "running";\n` +
+    `  let failed = false;\n` +
+    `  try {\n${sourceContent}\n  } catch (error) {\n` +
+    `    failed = true;\n` +
+    `    statuses[key] = "failed";\n` +
+    `    throw error;\n` +
+    `  } finally {\n` +
+    `    if (!failed) statuses[key] = "succeeded";\n` +
+    `  }\n` +
+    `})()`;
+}
+
+export class ClientTestInjector {
+  private readonly completed = new Set<string>();
+  private readonly styleKeys = new Map<WebContents, Set<string>>();
+
+  async inject(webContents: WebContents, plan: InjectionPlan, assets: ClientTestAsset[], options: { timeoutMs?: number; generationIsCurrent?: () => boolean } = {}): Promise<ClientInjectionResult[]> {
+    return this.run(webContents, plan, assets, options, false);
+  }
+
+  async injectProduction(webContents: WebContents, plan: InjectionPlan, assets: ClientTestAsset[], options: ProductionInjectionOptions = {}): Promise<ClientInjectionResult[]> {
+    return this.run(webContents, plan, assets, options, true);
+  }
+
+  private async run(webContents: WebContents, plan: InjectionPlan, assets: ClientTestAsset[], options: ProductionInjectionOptions, production: boolean): Promise<ClientInjectionResult[]> {
+  if (!production && !clientTestModeEnabled()) throw new Error("client_test_mode_required");
+  const currentURL = webContents.getURL();
+  if (webContents.isDestroyed()) return [];
+  if (!production && !isAllowedClientFixtureURL(currentURL)) throw new Error("fixture_url_required");
+  // 页面跳转可能正好发生在脚本解析完成与注入之间；旧任务对新域名
+  // 不再是错误，而是一次可安全丢弃的过期注入。
+  const productionOriginMatchers = normalizeOriginPatterns([options.productionOrigin, ...(options.productionOriginMatchers ?? [])]);
+  if (production && !isAllowedByOriginPatterns(currentURL, productionOriginMatchers)) return [];
+
+  const timeoutMs = options.timeoutMs ?? 2000;
+  const generationIsCurrent = options.generationIsCurrent ?? (() => true);
+  const result: ClientInjectionResult[] = [];
+  for (const item of assets) {
+    const key = planKey(plan, item);
+    const assetKey = `${key}|${item.kind}`;
+    const base = { id: item.id, scriptId: item.scriptId, identifier: item.identifier, version: item.version, effectiveVersionId: item.effectiveVersionId, navigationGeneration: plan.navigationGeneration, routeKey: plan.routeKey, runAt: plan.runAt, priority: item.priority, kind: item.kind } as const;
+    if (this.completed.has(assetKey)) continue;
+    if (!generationIsCurrent() || webContents.isDestroyed()) {
+      result.push({ ...base, state: "cancelled", errorCode: "sender_invalidated" });
+      continue;
+    }
+    try {
+      if (!item.sourceContent) throw new Error("resource_incomplete");
+      if (item.kind === "style") {
+        const inserted = await timeout(webContents.insertCSS(item.sourceContent), timeoutMs);
+        const keys = this.styleKeys.get(webContents) ?? new Set<string>();
+        keys.add(inserted);
+        this.styleKeys.set(webContents, keys);
+      }
+      else await timeout(webContents.executeJavaScript(guardedScriptSource(plan, item), true), timeoutMs);
+      if (!generationIsCurrent() || webContents.isDestroyed()) result.push({ ...base, state: "cancelled", errorCode: "sender_invalidated" });
+      else { this.completed.add(assetKey); result.push({ ...base, state: "succeeded", errorCode: null }); }
+    } catch (error) {
+      const code = error instanceof Error && error.message === "script_runtime_timeout" ? "timeout" : "asset_failed";
+      result.push({ ...base, state: code === "timeout" ? "timed_out" : "failed", errorCode: code });
+    }
+  }
+  return result;
+  }
+
+  async clearStyles(webContents: WebContents): Promise<void> {
+    const keys = this.styleKeys.get(webContents);
+    this.styleKeys.delete(webContents);
+    if (!keys || webContents.isDestroyed()) return;
+    await Promise.allSettled([...keys].map((key) => webContents.removeInsertedCSS(key)));
+  }
+}
+
+export async function injectClientTestPlan(webContents: WebContents, plan: InjectionPlan, assets: ClientTestAsset[], options: { timeoutMs?: number; generationIsCurrent?: () => boolean } = {}): Promise<ClientInjectionResult[]> {
+  return new ClientTestInjector().inject(webContents, plan, assets, options);
+}
