index 0000000000000000000000000000000000000000..ef74c21b21d9d4d873273b755d66d4bac9ef2858
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-navigation-controller.ts
@@ -0,0 +1,172 @@
+import { BrowserWindow, ipcMain, type WebContents } from "electron";
+import type { WebWindowNavigationCommand, WebWindowNavigationState } from "../shared/web-window-contract";
+import { WEB_WINDOW_CHANNELS, isWebWindowNavigationCommand } from "../shared/web-window-contract";
+import { nextNavigationGeneration, createNavigationState } from "./web-window-navigation";
+import { scopedIpc } from "./guarded-ipc";
+
+type NavigationControllerOptions = {
+  homeUrl: string;
+  instanceId: string;
+  uiSessionId: string;
+  activeRevision?: number;
+  beforeReload?: () => Promise<void>;
+  onShellReady?: () => void;
+  onState?: (state: WebWindowNavigationState) => void;
+};
+
+type ShellWindow = BrowserWindow;
+
+/** 将导航历史、地址栏状态和受限导航命令绑定到同一个 Shell/WebContents 实例。 */
+export class WebWindowNavigationController {
+  private generation = 0;
+  private sequence = 0;
+  private ready = false;
+  private disposed = false;
+  private readonly shellContents: WebContents;
+
+  constructor(
+    readonly shell: ShellWindow,
+    readonly contents: WebContents,
+    readonly options: NavigationControllerOptions
+  ) {
+    this.shellContents = shell.webContents;
+    contents.on("did-start-navigation", this.onStartNavigation);
+    contents.on("did-navigate", this.onNavigate);
+    contents.on("did-navigate-in-page", this.onNavigateInPage);
+    contents.on("did-finish-load", this.onFinishLoad);
+    contents.on("did-fail-load", this.onFailLoad);
+    this.shellContents.on("did-finish-load", this.onShellFinishLoad);
+    shell.once("closed", this.dispose);
+  }
+
+  snapshot(): WebWindowNavigationState {
+    const state = createNavigationState(
+      this.options.homeUrl,
+      this.generation,
+      !this.contents.isDestroyed() && this.contents.navigationHistory.canGoBack(),
+      !this.contents.isDestroyed() && this.contents.navigationHistory.canGoForward(),
+      !this.contents.isDestroyed() ? this.contents.getURL() || this.options.homeUrl : this.options.homeUrl
+    );
+    return {
+      ...state,
+      ready: this.ready,
+      sequence: this.sequence,
+      instanceId: this.options.instanceId,
+      uiSessionId: this.options.uiSessionId,
+      activeRevision: this.options.activeRevision ?? 0
+    };
+  }
+
+  publish(): WebWindowNavigationState {
+    if (this.disposed || this.shell.isDestroyed() || this.shellContents.isDestroyed()) return this.snapshot();
+    this.sequence += 1;
+    const state = this.snapshot();
+    try { this.shellContents.send(WEB_WINDOW_CHANNELS.navigationState, state); } catch { /* 关闭中的 Shell 不阻断 WebContents 导航。 */ }
+    this.options.onState?.(state);
+    return state;
+  }
+
+  async navigate(command: WebWindowNavigationCommand): Promise<void> {
+    if (this.disposed || this.shell.isDestroyed() || this.contents.isDestroyed()) return;
+    try {
+      if (command === "back") {
+        if (this.contents.navigationHistory.canGoBack()) this.contents.navigationHistory.goBack();
+      } else if (command === "forward") {
+        if (this.contents.navigationHistory.canGoForward()) this.contents.navigationHistory.goForward();
+      } else if (command === "reload") {
+        await this.options.beforeReload?.();
+        if (!this.disposed && !this.shell.isDestroyed() && !this.contents.isDestroyed()) this.contents.reload();
+      } else if (command === "home") {
+        if (this.contents.getURL() !== this.options.homeUrl) await this.contents.loadURL(this.options.homeUrl);
+      } else if (command.action === "navigate") {
+        let destination: URL | null = null;
+        try { destination = new URL(command.url, this.options.homeUrl); } catch { /* 无效地址保持当前页面。 */ }
+        const home = new URL(this.options.homeUrl);
+        if (destination && (destination.protocol === "http:" || destination.protocol === "https:") && destination.origin === home.origin) await this.contents.loadURL(destination.toString());
+      }
+    } catch (error) {
+      // 导航失败只记录并结束加载状态；不替换或销毁仍显示的业务 WebContents。
+      console.warn("Web 专用窗口导航命令失败", JSON.stringify({ command, reason: error instanceof Error ? error.message : "unknown" }));
+    }
+    this.publish();
+  }
+
+  dispose = (): void => {
+    if (this.disposed) return;
+    this.disposed = true;
+    this.contents.removeListener("did-start-navigation", this.onStartNavigation);
+    this.contents.removeListener("did-navigate", this.onNavigate);
+    this.contents.removeListener("did-navigate-in-page", this.onNavigateInPage);
+    this.contents.removeListener("did-finish-load", this.onFinishLoad);
+    this.contents.removeListener("did-fail-load", this.onFailLoad);
+    this.shellContents.removeListener("did-finish-load", this.onShellFinishLoad);
+    if (controllers.get(this.shell) === this) controllers.delete(this.shell);
+  };
+
+  private readonly onStartNavigation = (_event: unknown, _url: string, isInPlace: boolean, isMainFrame: boolean): void => {
+    if (!isMainFrame || isInPlace) return;
+    this.ready = false;
+    this.generation = nextNavigationGeneration(this.generation);
+    this.sequence = 0;
+    this.publish();
+  };
+
+  private readonly onNavigate = (): void => { this.publish(); };
+
+  private readonly onNavigateInPage = (_event: unknown, _url: string, isMainFrame: boolean): void => {
+    if (!isMainFrame) return;
+    this.generation = nextNavigationGeneration(this.generation);
+    this.sequence = 0;
+    this.publish();
+  };
+
+  private readonly onFinishLoad = (): void => {
+    this.ready = true;
+    this.publish();
+  };
+
+  private readonly onFailLoad = (_event: unknown, errorCode: number, _description: string, _validatedUrl: string, isMainFrame: boolean): void => {
+    // -3 是正常导航取消/替换的常见结果；新导航自己的事件负责更新 loading 状态。
+    if (!isMainFrame || errorCode === -3) return;
+    this.ready = true;
+    this.publish();
+  };
+
+  private readonly onShellFinishLoad = (): void => {
+    this.publish();
+    this.options.onShellReady?.();
+  };
+}
+
+const controllers = new WeakMap<ShellWindow, WebWindowNavigationController>();
+
+export function bindWebWindowNavigation(
+  shell: ShellWindow,
+  contents: WebContents,
+  options: NavigationControllerOptions
+): WebWindowNavigationController {
+  controllers.get(shell)?.dispose();
+  const controller = new WebWindowNavigationController(shell, contents, options);
+  controllers.set(shell, controller);
+  return controller;
+}
+
+export function getWebWindowNavigationController(shell: ShellWindow): WebWindowNavigationController | null {
+  return controllers.get(shell) ?? null;
+}
+
+const navigationStateIpc = scopedIpc(["controlled"], (args) => args.length === 0);
+navigationStateIpc.on(WEB_WINDOW_CHANNELS.navigationStateRequest, (event) => {
+  const shell = BrowserWindow.fromWebContents(event.sender);
+  const controller = shell ? controllers.get(shell) : undefined;
+  event.returnValue = controller?.snapshot() ?? {
+    ...createNavigationState("", 0), instanceId: "", uiSessionId: "", activeRevision: 0, ready: false
+  };
+});
+
+ipcMain.on(WEB_WINDOW_CHANNELS.navigationAction, (event, command: unknown) => {
+  const shell = BrowserWindow.fromWebContents(event.sender);
+  const controller = shell ? controllers.get(shell) : undefined;
+  if (!controller || !isWebWindowNavigationCommand(command)) return;
+  void controller.navigate(command);
+});
