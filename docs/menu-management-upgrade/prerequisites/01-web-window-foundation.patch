+        platform: "generic",
+        identifier: asset.identifier,
+        version: "1.0.0",
+        effectiveVersionId: asset.effectiveVersionId,
+        enabled: true,
+        runAt: asset.runAt,
+        priority: asset.priority,
+        source: asset.sourceContent,
