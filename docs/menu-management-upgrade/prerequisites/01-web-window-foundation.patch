@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { EventEmitter } from "node:events";
+import { FakeContents } from "../../../../scripts/desktop-plugins/test-electron.mjs";
+import { registerNetworkSubscription, stopNetwork } from "./web-window-network.ts";
+
+class FakeDebugger extends EventEmitter {
+  constructor({ attached = false, failAttach = false } = {}) {
+    super();
+    this.attached = attached;
+    this.failAttach = failAttach;
+    this.attachCalls = 0;
+    this.detachCalls = 0;
+    this.commands = [];
+  }
+
+  isAttached() { return this.attached; }
+  attach() {
+    this.attachCalls += 1;
+    if (this.failAttach) throw new Error("debugger is busy");
+    this.attached = true;
+  }
+  detach() {
+    this.detachCalls += 1;
+    this.attached = false;
+    this.emit("detach", {}, "target closed");
+  }
+  async sendCommand(method, params) {
+    this.commands.push({ method, params });
+    if (method === "Fetch.getResponseBody") return { body: Buffer.from("response-body", "utf8").toString("base64"), base64Encoded: true };
+    return {};
+  }
+}
+
+function makeContents(options) {
+  const contents = new FakeContents();
+  contents.debugger = new FakeDebugger(options);
+  contents.devToolsOpen = false;
+  contents.isDevToolsOpened = () => contents.devToolsOpen;
+  contents.received = [];
+  contents.send = (channel, payload) => contents.received.push({ channel, payload });
+  return contents;
+}
+
+function emitPaused(contents, params) {
+  contents.debugger.emit("message", {}, "Fetch.requestPaused", params);
+}
+
+test("响应订阅复用运行时已连接的调试器并只派发响应阶段", async () => {
+  const contents = makeContents({ attached: true });
+  const id = await registerNetworkSubscription(contents, "response", {
+    match: { url: "https://example.test/api/*" },
+    includeBody: true
+  }, false);
+
+  assert.equal(contents.debugger.attachCalls, 0, "不能重复 attach ScriptRuntime 已连接的调试器");
+  assert.equal(contents.debugger.commands[0]?.method, "Fetch.enable");
+
+  emitPaused(contents, {
+    requestId: "request-1",
+    request: { url: "https://example.test/api/data", method: "GET", headers: {} },
+    resourceType: "XHR"
+  });
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(contents.received.length, 0, "response 订阅不能被请求阶段事件触发");
+
+  emitPaused(contents, {
+    requestId: "request-1",
+    request: { url: "https://example.test/api/data", method: "GET", headers: {} },
+    responseStatusCode: 200,
+    responseHeaders: [{ name: "content-type", value: "application/json" }],
+    resourceType: "XHR"
+  });
+  await new Promise((resolve) => setImmediate(resolve));
+
+  assert.equal(contents.received.length, 1);
+  assert.equal(contents.received[0].channel, "aicrm:web-window-network-event");
+  assert.deepEqual(contents.received[0].payload.subscriptions, [id]);
+  assert.equal(contents.received[0].payload.kind, "response");
+  assert.equal(contents.received[0].payload.body, "response-body");
+
+  stopNetwork(contents);
+  assert.equal(contents.debugger.detachCalls, 0, "停止网络观察不能断开 ScriptRuntime 的调试器");
+  assert.ok(contents.debugger.commands.some(({ method }) => method === "Fetch.disable"));
+});
+
+test("调试器连接失败会拒绝订阅且重试不受陈旧状态影响", async () => {
+  const contents = makeContents({ attached: false, failAttach: true });
+  await assert.rejects(
+    registerNetworkSubscription(contents, "request", {}, false),
+    /NETWORK_DEBUGGER_ATTACH_FAILED/
+  );
+  assert.equal(contents.debugger.attachCalls, 1);
+
+  contents.debugger.failAttach = false;
+  const id = await registerNetworkSubscription(contents, "request", {}, false);
+  assert.match(id, /^observe:/);
+  assert.equal(contents.debugger.attachCalls, 2);
+  assert.ok(contents.debugger.commands.some(({ method }) => method === "Fetch.enable"));
+  stopNetwork(contents);
+  assert.equal(contents.debugger.detachCalls, 1, "由网络模块创建的调试器会在释放时断开");
+});
+
+test("开发者工具关闭后仍有效的网络订阅会重新连接", async () => {
+  const contents = makeContents({ attached: false });
+  await registerNetworkSubscription(contents, "response", {}, false);
+  assert.equal(contents.debugger.commands.filter(({ method }) => method === "Fetch.enable").length, 1);
+
+  contents.devToolsOpen = true;
+  contents.debugger.attached = false;
+  contents.debugger.emit("detach", {}, "devtools attached");
+  contents.devToolsOpen = false;
+  contents.emit("devtools-closed");
+
+  for (let attempt = 0; attempt < 20 && contents.debugger.commands.filter(({ method }) => method === "Fetch.enable").length < 2; attempt += 1) {
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  }
+  assert.equal(contents.debugger.commands.filter(({ method }) => method === "Fetch.enable").length, 2);
+  stopNetwork(contents);
+});
+
+test("开发者工具占用页面调试会话时订阅明确失败，不伪报成功", async () => {
+  const contents = makeContents({ attached: false });
+  contents.devToolsOpen = true;
+  await assert.rejects(
+    registerNetworkSubscription(contents, "response", {}, false),
+    /NETWORK_DEBUGGER_DEVTOOLS_OPEN/
+  );
+  assert.equal(contents.debugger.attachCalls, 0);
+  stopNetwork(contents);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-network.ts b/apps/aicrm-desktop/src/main/web-window-network.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d1934309df9def8c3fbf36ac22920728c901a56
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-network.ts
@@ -0,0 +1,213 @@
+import { BrowserWindow, type WebContents } from "electron";
+import { randomUUID } from "node:crypto";
+import type { ScriptRuntimeNetworkCapability } from "./script-runtime-contract";
+import type { WebWindowNetworkDecision, WebWindowNetworkKind, WebWindowNetworkSubscriptionOptions } from "../shared/web-window-contract";
+
+type Subscription = { id: string; kind: WebWindowNetworkKind; options: WebWindowNetworkSubscriptionOptions };
+type PendingDecision = { requestId: string; resolve: (decision: WebWindowNetworkDecision) => void };
+type State = {
+  subscriptions: Map<string, Subscription>;
+  pending: Map<string, PendingDecision>;
+  attached: boolean;
+  ownsDebugger: boolean;
+  attaching?: Promise<void>;
+  debuggerMessageListener?: (...args: any[]) => void;
+  debuggerDetachListener?: (...args: any[]) => void;
+  devtoolsClosedListener?: (...args: any[]) => void;
+  capabilities: Set<ScriptRuntimeNetworkCapability>;
+};
+type WindowLike = BrowserWindow | WebContents;
+const states = new WeakMap<WebContents, State>();
+const contentsOf = (window: WindowLike): WebContents => window instanceof BrowserWindow ? window.webContents : window;
+const MAX_NETWORK_BODY_BYTES = 512 * 1024;
+const SENSITIVE_HEADER = /^(authorization|proxy-authorization|cookie|set-cookie|x-api-key)$/i;
+
+function safeHeaders(input: Record<string, unknown> | undefined): Record<string, string> | undefined {
+  if (!input) return undefined;
+  return Object.fromEntries(Object.entries(input).map(([key, value]) => [key, SENSITIVE_HEADER.test(key) ? "[REDACTED]" : String(value).slice(0, 8192)]));
+}
+function safeBody(input: unknown): string | undefined {
+  if (typeof input !== "string") return undefined;
+  return Buffer.byteLength(input, "utf8") <= MAX_NETWORK_BODY_BYTES ? input : `${input.slice(0, MAX_NETWORK_BODY_BYTES)}\n[TRUNCATED]`;
+}
+
+function stateFor(window: WindowLike): State {
+  const contents = contentsOf(window);
+  const existing = states.get(contents); if (existing) return existing;
+  const state: State = { subscriptions: new Map(), pending: new Map(), attached: false, ownsDebugger: false, capabilities: new Set(["subscribeRequest", "subscribeResponse", "waitForRequest", "waitForResponse"]) };
+  states.set(contents, state); return state;
+}
+
+function matches(value: string, expected?: string | string[]): boolean {
+  if (!expected) return true;
+  return (Array.isArray(expected) ? expected : [expected]).some(pattern => {
+    const escaped = pattern.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*");
+    return new RegExp(`^${escaped}$`, "i").test(value);
+  });
+}
+
+function matchesSubscription(subscription: Subscription, params: any): boolean {
+  const request = params.request ?? {};
+  const match = subscription.options.match;
+  return matches(String(request.url ?? ""), match?.url) && matches(String(request.method ?? "GET"), match?.method)
+    && (!match?.resourceTypes?.length || match.resourceTypes.includes(String(params.resourceType ?? "other")));
+}
+
+async function sendCommand(window: WindowLike, method: string, params?: Record<string, unknown>): Promise<any> {
+  return contentsOf(window).debugger.sendCommand(method, params);
+}
+
+async function continuePaused(window: WindowLike, requestId: string, response: boolean): Promise<void> {
+  try { await sendCommand(window, response ? "Fetch.continueResponse" : "Fetch.continueRequest", { requestId }); }
+  catch { try { await sendCommand(window, "Fetch.continueRequest", { requestId }); } catch { /* 页面可能已销毁 */ } }
+}
+
+function dispatch(window: WindowLike, payload: Record<string, unknown>): void {
+  const contents = contentsOf(window);
+  if (!contents.isDestroyed()) contents.send("aicrm:web-window-network-event", payload);
+}
+
+function installDebuggerListeners(window: WindowLike, state: State): void {
+  const contents = contentsOf(window);
+  const debug = contents.debugger;
+  if (!state.debuggerMessageListener) {
+    state.debuggerMessageListener = (_event: unknown, method: string, params: any) => {
+      if (method !== "Fetch.requestPaused") return;
+      void (async () => {
+        const response = typeof params.responseStatusCode === "number";
+        const eventKind: WebWindowNetworkKind = response ? "response" : "request";
+        const subscriptions = [...state.subscriptions.values()].filter(item => item.kind === eventKind && matchesSubscription(item, params) && (item.options.stages?.length ? item.options.stages.includes(response ? "responseHeaders" : "beforeRequest") : true));
+        const intercepting = subscriptions.some(item => item.id.startsWith("intercept:"));
+        if (!subscriptions.length) { await continuePaused(window, params.requestId, response); return; }
+        let body: string | undefined;
+        if (response && subscriptions.some(item => item.options.includeBody)) {
+          try {
+            const result = await sendCommand(window, "Fetch.getResponseBody", { requestId: params.requestId });
+            const responseBody = result.base64Encoded && typeof result.body === "string"
+              ? Buffer.from(result.body, "base64").toString("utf8")
+              : result.body;
+            body = safeBody(responseBody);
+          } catch { body = undefined; }
+        }
+        const decisionToken = intercepting ? randomUUID() : undefined;
+        if (decisionToken) state.pending.set(decisionToken, { requestId: params.requestId, resolve: decision => void applyDecision(window, params, decision) });
+        dispatch(window, { decisionToken, kind: eventKind, stage: response ? "responseHeaders" : "beforeRequest", requestId: params.requestId, url: params.request.url, method: params.request.method, resourceType: params.resourceType, status: params.responseStatusCode, headers: safeHeaders(response ? params.responseHeaders : params.request.headers), body, subscriptions: subscriptions.map(item => item.id) });
+        if (!decisionToken) await continuePaused(window, params.requestId, response);
+        else setTimeout(() => { if (state.pending.delete(decisionToken)) void continuePaused(window, params.requestId, response); }, subscriptions[0].options.timeoutMs ?? 1500);
+      })();
+    };
+    debug.on("message", state.debuggerMessageListener);
+  }
+  if (!state.debuggerDetachListener) {
+    state.debuggerDetachListener = () => { state.attached = false; state.ownsDebugger = false; state.pending.clear(); };
+    debug.on("detach", state.debuggerDetachListener);
+  }
+  if (!state.devtoolsClosedListener) {
+    state.devtoolsClosedListener = () => {
+      if (state.subscriptions.size === 0 || contents.isDestroyed()) return;
+      void attach(window).catch(error => {
+        console.error("Web 窗口网络订阅重新连接失败", error instanceof Error ? error.message : "unknown");
+      });
+    };
+    contents.on("devtools-closed", state.devtoolsClosedListener);
+  }
+}
+
+async function attach(window: WindowLike): Promise<void> {
+  const contents = contentsOf(window);
+  const state = stateFor(window);
+  if (state.attached) return;
+  if (state.attaching) return state.attaching;
+  state.attaching = (async () => {
+    if (contents.isDestroyed()) throw new Error("NETWORK_DEBUGGER_UNAVAILABLE");
+    if (contents.isDevToolsOpened()) throw new Error("NETWORK_DEBUGGER_DEVTOOLS_OPEN");
+
+    const debug = contents.debugger;
+    let attachedByNetwork = false;
+    if (!debug.isAttached()) {
+      try {
+        debug.attach("1.3");
+        attachedByNetwork = true;
+      } catch {
+        throw new Error("NETWORK_DEBUGGER_ATTACH_FAILED");
+      }
+    }
+
+    installDebuggerListeners(window, state);
+    try {
+      await sendCommand(window, "Fetch.enable", { patterns: [{ requestStage: "Request" }, { requestStage: "Response" }] });
+      if (!debug.isAttached()) throw new Error("NETWORK_DEBUGGER_DETACHED_DURING_SETUP");
+      state.ownsDebugger = attachedByNetwork;
+      state.attached = true;
+    } catch (error) {
+      state.attached = false;
+      if (attachedByNetwork && debug.isAttached()) {
+        try { debug.detach(); } catch { /* CDP 可能已断开。 */ }
+      }
+      if (error instanceof Error && error.message.startsWith("NETWORK_DEBUGGER_")) throw error;
+      throw new Error("NETWORK_CAPTURE_SETUP_FAILED", { cause: error });
+    }
+  })();
+  try {
+    await state.attaching;
+  } finally {
+    state.attaching = undefined;
+  }
+}
+
+async function applyDecision(window: WindowLike, params: any, decision: WebWindowNetworkDecision): Promise<void> {
+  const requestId = params.requestId;
+  if (decision.body !== undefined && Buffer.byteLength(decision.body, "utf8") > MAX_NETWORK_BODY_BYTES) { await continuePaused(window, requestId, Boolean(params.responseStatusCode)); return; }
+  if (decision.action === "abort") { await sendCommand(window, "Fetch.failRequest", { requestId, errorReason: "BlockedByClient" }); return; }
+  if (decision.action === "redirect") { await sendCommand(window, "Fetch.continueRequest", { requestId, url: decision.url }); return; }
+  if (decision.action === "fulfill") {
+    const headers = Object.entries(decision.responseHeaders ?? {}).map(([name, value]) => ({ name, value }));
+    await sendCommand(window, "Fetch.fulfillRequest", { requestId, responseCode: decision.status ?? 200, responseHeaders: headers, body: Buffer.from(decision.body ?? "", "utf8").toString("base64") }); return;
+  }
+  await sendCommand(window, params.responseStatusCode ? "Fetch.continueResponse" : "Fetch.continueRequest", { requestId, ...(decision.url ? { url: decision.url } : {}), ...(decision.method ? { method: decision.method } : {}), ...(decision.headers ? { headers: Object.entries(decision.headers).map(([name, value]) => ({ name, value })) } : {}), ...(decision.body ? { postData: Buffer.from(decision.body, "utf8").toString("base64") } : {}) });
+}
+
+export function setNetworkCapabilities(window: WindowLike, capabilities: ScriptRuntimeNetworkCapability[] = []): void {
+  const state = stateFor(window);
+  state.capabilities = new Set(capabilities);
+}
+export async function registerNetworkSubscription(window: WindowLike, kind: WebWindowNetworkKind, options: WebWindowNetworkSubscriptionOptions, intercept: boolean): Promise<string> {
+  if (!options || (options.timeoutMs !== undefined && (!Number.isInteger(options.timeoutMs) || options.timeoutMs < 100 || options.timeoutMs > 10000))) throw new Error("INVALID_NETWORK_SUBSCRIPTION");
+  const capability: ScriptRuntimeNetworkCapability = intercept
+    ? (kind === "request" ? "interceptRequest" : "interceptResponse")
+    : (kind === "request" ? "subscribeRequest" : "subscribeResponse");
+  const state = stateFor(window);
+  if (!state.capabilities.has(capability)) throw new Error("NETWORK_CAPABILITY_DENIED");
+  const id = `${intercept ? "intercept" : "observe"}:${randomUUID()}`;
+  state.subscriptions.set(id, { id, kind, options });
+  try {
+    await attach(window);
+    return id;
+  } catch (error) {
+    state.subscriptions.delete(id);
+    throw error;
+  }
+}
+export function unregisterNetworkSubscription(window: WindowLike, id: string): void { states.get(contentsOf(window))?.subscriptions.delete(id); }
+export function decideNetworkRequest(window: WindowLike, token: string, decision: WebWindowNetworkDecision): boolean {
+  const state = states.get(contentsOf(window)); const pending = state?.pending.get(token); if (!state || !pending) return false; state.pending.delete(token); pending.resolve(decision); return true;
+}
+export function stopNetwork(window: WindowLike): void {
+  const contents = contentsOf(window);
+  const state = states.get(contents);
+  if (!state) return;
+  state.subscriptions.clear();
+  state.pending.clear();
+  if (state.debuggerMessageListener) contents.debugger.removeListener("message", state.debuggerMessageListener);
+  if (state.debuggerDetachListener) contents.debugger.removeListener("detach", state.debuggerDetachListener);
+  if (state.devtoolsClosedListener) contents.removeListener("devtools-closed", state.devtoolsClosedListener);
+  if (!contents.isDestroyed() && contents.debugger.isAttached()) {
+    if (state.ownsDebugger) {
+      try { contents.debugger.detach(); } catch { /* 窗口销毁时 CDP 可能已断开。 */ }
+    } else if (state.attached) {
+      // 运行时可能拥有同一 CDP 会话；停用 Fetch 域，但不要断开运行时的 Page 域。
+      void sendCommand(window, "Fetch.disable").catch(() => undefined);
+    }
+  }
+  states.delete(contents);
+}
