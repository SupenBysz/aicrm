+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { normalizeStoreInfoPatch, safeStoreInfo } from "./web-window-store-sdk.ts";
+
+test("store patch accepts only whitelisted partial display fields and explicit clearing", () => {
+  assert.deepEqual(normalizeStoreInfoPatch({ name: "新名称", logoImageId: "" }), { name: "新名称", logoImageId: "" });
+  assert.throws(() => normalizeStoreInfoPatch(null), /STORE_INFO_PATCH_INVALID/);
+  assert.throws(() => normalizeStoreInfoPatch({ name: undefined }), /STORE_INFO_PATCH_INVALID/);
+  assert.throws(() => normalizeStoreInfoPatch({ password: "secret" }), /STORE_INFO_PATCH_INVALID/);
+  assert.throws(() => normalizeStoreInfoPatch({ name: 1 }), /STORE_INFO_FIELD_INVALID/);
+  assert.throws(() => normalizeStoreInfoPatch({ name: "x".repeat(129) }), /STORE_INFO_FIELD_INVALID/);
+  assert.throws(() => normalizeStoreInfoPatch({ logoImageId: "../other-store" }), /STORE_INFO_FIELD_INVALID/);
+});
+
+test("safe store projection excludes credentials and requires the bound store", () => {
+  const got = safeStoreInfo({ id: "store-1", account: "shop", name: "Name", password: "never", token: "never", cookie: "never", ownerMembershipId: "private" }, "store-1", "douyin", "2026-10-08T00:00:00Z");
+  assert.equal(got.name, "Name");
+  assert.equal(got.storeId, "store-1");
+  assert.equal(got.loginStatus, "unknown");
+  assert.equal("password" in got, false);
+  assert.equal("token" in got, false);
+  assert.equal("cookie" in got, false);
+  assert.equal("ownerMembershipId" in got, false);
+  assert.throws(() => safeStoreInfo({ id: "other", account: "shop" }, "store-1", "douyin", "now"), /STORE_CONTEXT_MISMATCH/);
+});
+
+test("preload methods route through trusted IPC and main derives store context", async () => {
+  const [preload, main, contract] = await Promise.all([
+    readFile(new URL("../preload/web-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("./app-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("../shared/web-window-contract.ts", import.meta.url), "utf8"),
+  ]);
+  assert.match(preload, /store: \{[\s\S]*getStoreInfo\(\)[\s\S]*setStoreInfo\(input:[\s\S]*sdkRequest\("setStoreInfo"/);
+  assert.match(preload, /getStoreInfo\(\): Promise<WebWindowStoreInfo> \{ return sdkRequest\("getStoreInfo"\)/);
+  assert.match(preload, /upload\(input: \{ url: string; purpose: "logo" \}\)[\s\S]*sdkRequest\("uploadRemoteImage"/);
+  assert.match(contract, /"setStoreInfo" \| "uploadRemoteImage"/);
+  assert.match(main, /const storeId = childStoreIds\.get\(child\)/);
+  assert.match(main, /method: "PATCH"[\s\S]*"Idempotency-Key": randomUUID\(\)/);
+  assert.match(main, /body: JSON\.stringify\(\{ \.\.\.patch, revision: current\.revision \}\)/);
+  assert.match(main, /contextType: "shop", contextId: storeId, purpose: "logo"/);
+  assert.doesNotMatch(main, /upload\.contextId|upload\.workspaceId|upload\.storeId/);
+  assert.match(main, /safeStoreInfo\(await getStore\(\), storeId/);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-store-sdk.ts b/apps/aicrm-desktop/src/main/web-window-store-sdk.ts
new file mode 100644
index 0000000000000000000000000000000000000000..37d267923c8dc620ff1ed1be439b2537dcf45bde
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-store-sdk.ts
@@ -0,0 +1,51 @@
+import type { WebWindowStoreInfo, WebWindowStoreInfoPatch } from "../shared/web-window-contract";
+
+const textLimits: Readonly<Record<keyof Omit<WebWindowStoreInfoPatch, "logoImageId">, number>> = {
+  name: 128,
+  shopId: 64,
+  city: 64,
+  remark: 2000,
+};
+
+export function normalizeStoreInfoPatch(input: unknown): WebWindowStoreInfoPatch {
+  if (!input || typeof input !== "object" || Array.isArray(input)) throw new Error("STORE_INFO_PATCH_INVALID");
+  const raw = input as Record<string, unknown>;
+  const allowed = new Set(["name", "shopId", "city", "remark", "logoImageId"]);
+  if (Object.keys(raw).length === 0 || Object.keys(raw).some((key) => !allowed.has(key))) throw new Error("STORE_INFO_PATCH_INVALID");
+  const result: WebWindowStoreInfoPatch = {};
+  for (const key of Object.keys(textLimits) as (keyof typeof textLimits)[]) {
+    const value = raw[key];
+    if (value === undefined) continue;
+    if (typeof value !== "string" || value.length > textLimits[key] || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(value)) throw new Error("STORE_INFO_FIELD_INVALID");
+    result[key] = value;
+  }
+  if (raw.logoImageId !== undefined) {
+    const value = raw.logoImageId;
+    if (typeof value !== "string" || (value !== "" && !/^[0-9a-f]{32}$/.test(value))) throw new Error("STORE_INFO_FIELD_INVALID");
+    result.logoImageId = value;
+  }
+  if (Object.keys(result).length === 0) throw new Error("STORE_INFO_PATCH_INVALID");
+  return result;
+}
+
+const publicFields = ["account", "platform", "name", "shopId", "city", "remark", "logoImageId", "hasPassword", "status", "revision", "createdAt", "updatedAt", "lastLoginAt"] as const;
+
+export function safeStoreInfo(raw: unknown, storeId: string, platform: string, fetchedAt: string): WebWindowStoreInfo {
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("STORE_INFO_UNAVAILABLE");
+  const value = raw as Record<string, unknown>;
+  if (value.id !== storeId || typeof value.account !== "string") throw new Error("STORE_CONTEXT_MISMATCH");
+  for (const key of ["name", "shopId", "city", "remark", "logoImageId", "status", "createdAt", "updatedAt", "lastLoginAt"] as const) {
+    const field = value[key];
+    if (field !== undefined && field !== null && typeof field !== "string") throw new Error("STORE_INFO_UNAVAILABLE");
+  }
+  if (value.hasPassword !== undefined && typeof value.hasPassword !== "boolean") throw new Error("STORE_INFO_UNAVAILABLE");
+  if (value.revision !== undefined && (typeof value.revision !== "number" || !Number.isSafeInteger(value.revision) || value.revision < 1)) throw new Error("STORE_INFO_UNAVAILABLE");
+  const result: Record<string, unknown> = { id: storeId, storeId, platform, account: value.account, loginStatus: "unknown", fetchedAt };
+  for (const key of publicFields) if (key in value) result[key] = value[key];
+  result.id = storeId;
+  result.storeId = storeId;
+  result.platform = platform;
+  result.loginStatus = "unknown";
+  result.fetchedAt = fetchedAt;
+  return result as WebWindowStoreInfo;
+}
diff --git a/apps/aicrm-desktop/src/main/web-window-view.ts b/apps/aicrm-desktop/src/main/web-window-view.ts
new file mode 100644
index 0000000000000000000000000000000000000000..484cf82f5a9264be10627fcc082dd0d720ac4099
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-view.ts
@@ -0,0 +1,134 @@
+import { BrowserWindow, WebContentsView, type WebContents } from "electron";
+import { classifyLoginSpaceUrl, getUrlScheme, normalizeLoginSpaceProtocolWhitelist } from "../shared/login-space-protocol-whitelist.ts";
+import type { MatrixAccountWebSpaceProtocolWhitelist } from "../shared/types.ts";
+
+const shellFallbackCleared = new WeakSet<WebContents>();
+const shellFallbackClearPending = new WeakSet<WebContents>();
+const businessViewsEverShown = new WeakSet<WebContentsView>();
+
+/** 首次挂载或状态需要修复时，确保业务 WebView 位于 Shell 顶层并符合当前显示状态。 */
+export function mountBusinessView(shell: BrowserWindow, view: WebContentsView, options: { visible?: boolean } = {}): void {
+  if (shell.isDestroyed()) return;
+  const requestedVisible = options.visible ?? true;
+  if (requestedVisible) businessViewsEverShown.add(view);
+  // 首次显示后锁定为可见；导航、重试和兜底挂载都不能把它重新隐藏。
+  const shouldBeVisible = businessViewsEverShown.has(view) || requestedVisible;
+  const children = shell.contentView.children;
+  const wasAttached = children.includes(view);
+  const wasVisible = view.getVisible();
+  const needsMount = !wasAttached || children[children.length - 1] !== view;
+  if (needsMount) shell.contentView.addChildView(view);
+  if (wasVisible !== shouldBeVisible) view.setVisible(shouldBeVisible);
+  const [width, height] = shell.getContentSize();
+  const bounds = { x: 0, y: 60, width: Math.max(1, width), height: Math.max(1, height - 88) };
+  const currentBounds = view.getBounds();
+  if (currentBounds.x !== bounds.x || currentBounds.y !== bounds.y || currentBounds.width !== bounds.width || currentBounds.height !== bounds.height) {
+    view.setBounds(bounds);
+  }
+  if (needsMount || wasVisible !== shouldBeVisible) {
+    if (shouldBeVisible && !view.webContents.isDestroyed()) view.webContents.focus();
+    console.info("Web 专用窗口业务视图已挂载或恢复", JSON.stringify({ url: view.webContents.getURL(), bounds, visible: shouldBeVisible }));
+  }
+  if (shouldBeVisible) void clearShellFallback(shell.webContents);
+}
+
+/** 页面导航复用同一 WebContentsView，不替换或销毁页面视图。 */
+export function bindBusinessViewLifecycle(shell: BrowserWindow, view: WebContentsView, options: { shouldReveal?: () => boolean } = {}): () => void {
+  const contents = view.webContents;
+  const shouldReveal = (): boolean => options.shouldReveal?.() ?? true;
+  const remount = (): void => {
+    if (!shell.isDestroyed() && !contents.isDestroyed()) mountBusinessView(shell, view, { visible: shouldReveal() });
+  };
+  const onStartNavigation = (_event: Electron.Event, _url: string, _isInPlace: boolean, isMainFrame: boolean): void => {
+    if (isMainFrame) remount();
+  };
+
+  contents.on("did-start-navigation", onStartNavigation);
+  contents.on("did-finish-load", remount);
+  contents.on("did-navigate", remount);
+  contents.on("did-navigate-in-page", remount);
+  shell.on("resize", remount);
+  const guard = setInterval(() => {
+    if (shell.isDestroyed() || contents.isDestroyed()) return;
+    const children = shell.contentView.children;
+    const expectedVisible = shouldReveal();
+    if (children[children.length - 1] !== view || view.getVisible() !== expectedVisible) {
+      console.warn("Web 专用窗口业务视图状态异常，正在恢复挂载状态", JSON.stringify({
+        url: contents.getURL(),
+        childCount: children.length,
+        viewIndex: children.indexOf(view),
+        visible: view.getVisible(),
+        expectedVisible
+      }));
+      remount();
+    }
+  }, 100);
+
+  let disposed = false;
+  const dispose = (): void => {
+    if (disposed) return;
+    disposed = true;
+    clearInterval(guard);
+    contents.removeListener("did-start-navigation", onStartNavigation);
+    contents.removeListener("did-finish-load", remount);
+    contents.removeListener("did-navigate", remount);
+    contents.removeListener("did-navigate-in-page", remount);
+    shell.removeListener("resize", remount);
+  };
+  shell.once("closed", dispose);
+  mountBusinessView(shell, view, { visible: shouldReveal() });
+  return dispose;
+}
+
+/** 将 target=_blank 导航继续交给当前业务 WebContents。 */
+export function installSameWindowOpenHandler(contents: WebContents, options: {
+  navigate?: (url: string) => void | Promise<void>;
+  openExternal?: (url: string) => void | Promise<void>;
+  protocolWhitelist?: MatrixAccountWebSpaceProtocolWhitelist;
+  onBlocked?: (url: string) => void;
+} = {}): void {
+  const protocolWhitelist = normalizeLoginSpaceProtocolWhitelist(options.protocolWhitelist);
+  contents.setWindowOpenHandler(({ url }) => {
+    if (!url || contents.isDestroyed()) return { action: "deny" };
+    const action = classifyLoginSpaceUrl(url, protocolWhitelist);
+    if (action === "navigate") {
+      const navigate = options.navigate ?? ((target: string) => contents.loadURL(target));
+      void Promise.resolve(navigate(url)).catch((error) => {
+        console.warn("Web 专用窗口链接跳转失败", error instanceof Error ? error.message : "unknown");
+      });
+    } else if (action === "external" && options.openExternal) {
+      void Promise.resolve(options.openExternal(url)).catch((error) => {
+        console.warn("Web 专用窗口外部协议打开失败", JSON.stringify({ scheme: getUrlScheme(url), error: error instanceof Error ? error.message : "unknown" }));
+      });
+    } else if (action === "block") {
+      if (options.onBlocked) options.onBlocked(url);
+      else console.warn("Web 专用窗口已拦截未允许的链接协议", getUrlScheme(url) ?? "unknown");
+    }
+    return { action: "deny" };
+  });
+}
+
+export async function clearShellFallback(contents: WebContents): Promise<void> {
+  if (contents.isDestroyed() || shellFallbackCleared.has(contents) || shellFallbackClearPending.has(contents)) return;
+  shellFallbackClearPending.add(contents);
+  try {
+    const cleared = await contents.executeJavaScript(`(() => {
+      const keep = new Set(['kww-web-window-chrome', 'kww-web-window-status', 'kww-web-window-version-panel']);
+      let removedFallback = false;
+      for (const node of Array.from(document.body.children)) {
+        if (!keep.has(node.id)) {
+          node.remove();
+          removedFallback = true;
+        }
+      }
+      if (removedFallback) document.body.dataset.kwwShellFallbackCleared = 'true';
+      return removedFallback;
+    })();`, true);
+    // Shell 可能还是空白文档；只有确认真的移除了占位内容，才记为已清理。
+    if (cleared) shellFallbackCleared.add(contents);
+  } catch {
+    // 关闭或正在导航的 Shell 不阻断业务视图挂载。
+  } finally {
+    shellFallbackClearPending.delete(contents);
+  }
+}
diff --git a/apps/aicrm-desktop/src/preload/web-window-ui.ts b/apps/aicrm-desktop/src/preload/web-window-ui.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2cdad37eb5cc0675da212f2205076b5d8e7f07d8
--- /dev/null
+++ b/apps/aicrm-desktop/src/preload/web-window-ui.ts
@@ -0,0 +1,285 @@
+import React, { createElement, useEffect } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import * as AntDesignIcons from "@ant-design/icons";
+import { App, ConfigProvider, theme as antdTheme } from "antd";
+import zhCN from "antd/locale/zh_CN";
+import type {
+  WebWindowActionIcon,
+  WebWindowActionIconInput,
+  WebWindowActionIconSvgNode,
+} from "../shared/web-window-contract";
+
+type IconComponent = React.ComponentType<{ style?: React.CSSProperties; "aria-hidden"?: boolean }>;
+const iconComponents = AntDesignIcons as unknown as Record<string, IconComponent>;
+
+type UiRuntime = {
+  message: ReturnType<typeof App.useApp>["message"];
+  notification: ReturnType<typeof App.useApp>["notification"];
+  modal: ReturnType<typeof App.useApp>["modal"];
+};
+type UiOperation = (runtime: UiRuntime) => unknown;
+let uiRoot: Root | null = null;
+let uiRootElement: HTMLElement | null = null;
+let uiRuntime: UiRuntime | null = null;
+let isDarkTheme = false;
+const pendingUiOperations: Array<{ operation: UiOperation; resolve: (value: unknown) => void; reject: (reason: unknown) => void }> = [];
+
+const messageMethods = ["success", "info", "warning", "error", "loading"] as const;
+const modalMethods = ["info", "success", "warning", "error"] as const;
+
+function invokeUi<T>(operation: UiOperation): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    if (!uiRootElement || !uiRoot) installUiRoot();
+    if (uiRuntime) {
+      try { resolve(operation(uiRuntime) as T); } catch (error) { reject(error); }
+      return;
+    }
+    pendingUiOperations.push({ operation, resolve: resolve as (value: unknown) => void, reject });
+  });
+}
+
+function flushPendingUiOperations(): void {
+  if (!uiRuntime) return;
+  for (const entry of pendingUiOperations.splice(0)) {
+    try { entry.resolve(entry.operation(uiRuntime)); } catch (error) { entry.reject(error); }
+  }
+}
+
+function UiBridge(): null {
+  const runtime = App.useApp();
+  useEffect(() => {
+    uiRuntime = runtime;
+    flushPendingUiOperations();
+    return () => { if (uiRuntime === runtime) uiRuntime = null; };
+  }, [runtime]);
+  return null;
+}
+
+function installUiRoot(): void {
+  if (!document.documentElement || uiRoot) return;
+  uiRootElement = document.createElement("div");
+  uiRootElement.id = "kww-web-window-sdk-ui-root";
+  Object.assign(uiRootElement.style, {
+    position: "fixed",
+    inset: "0",
+    zIndex: "2147483647",
+    pointerEvents: "none",
+  });
+  document.documentElement.append(uiRootElement);
+  uiRoot = createRoot(uiRootElement);
+  renderUiRoot();
+}
+
+function renderUiRoot(): void {
+  if (!uiRoot) return;
+  uiRoot.render(createElement(
+    ConfigProvider,
+    {
+      locale: zhCN,
+      prefixCls: "kww-ant",
+      theme: {
+        algorithm: isDarkTheme ? antdTheme.darkAlgorithm : antdTheme.defaultAlgorithm,
+        token: { colorPrimary: "#d49a3d", borderRadius: 10, zIndexPopupBase: 2147483000 },
+      },
+    },
+    createElement(App, { className: "kww-web-window-sdk-ui" }, createElement(UiBridge)),
+  ));
+}
+
+function contentText(value: unknown, label: string): string {
+  if (typeof value !== "string" || !value.trim() || value.length > 2000 || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(value)) {
+    throw Object.assign(new TypeError(label + " 必须是 1–2000 字符的普通文本"), { code: "UI_ARGUMENT_INVALID" });
+  }
+  return value.trim();
+}
+
+function durationMs(value: unknown): number {
+  if (value === undefined) return 3000;
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 30000) {
+    throw Object.assign(new RangeError("durationMs 必须在 0–30000 之间"), { code: "UI_ARGUMENT_INVALID" });
+  }
+  return value / 1000;
+}
+
+function modalOptions(input: unknown): { title: string; content: string; okText?: string; cancelText?: string } {
+  if (!input || typeof input !== "object" || Array.isArray(input)) throw Object.assign(new TypeError("弹窗参数必须是对象"), { code: "UI_ARGUMENT_INVALID" });
+  const value = input as Record<string, unknown>;
+  const allowed = new Set(["title", "content", "okText", "cancelText"]);
+  if (Object.keys(value).some((key) => !allowed.has(key))) throw Object.assign(new TypeError("弹窗参数包含不支持的字段"), { code: "UI_ARGUMENT_INVALID" });
+  const result: { title: string; content: string; okText?: string; cancelText?: string } = {
+    title: contentText(value.title, "title"),
+    content: contentText(value.content, "content"),
+  };
+  for (const key of ["okText", "cancelText"] as const) {
+    const raw = value[key];
+    if (raw !== undefined) result[key] = contentText(raw, key).slice(0, 32);
+  }
+  return result;
+}
+
+/** 受限的 Ant Design 消息、通知和确认弹窗 API；只接受纯文本，不接收 React 节点或 HTML。 */
+export function createWebWindowUiApi() {
+  const message = Object.fromEntries(messageMethods.map((method) => [method, (text: string, options?: { durationMs?: number }) => {
+    const content = contentText(text, "message");
+    const duration = durationMs(options?.durationMs);
+    return invokeUi<void>((runtime) => { runtime.message[method](content, duration); });
+  }])) as Record<typeof messageMethods[number], (text: string, options?: { durationMs?: number }) => Promise<void>>;
+
+  const notification = Object.fromEntries(["success", "info", "warning", "error"].map((type) => [type, (input: unknown) => {
+    if (!input || typeof input !== "object" || Array.isArray(input)) throw Object.assign(new TypeError("通知参数必须是对象"), { code: "UI_ARGUMENT_INVALID" });
+    const value = input as Record<string, unknown>;
+    const allowed = new Set(["message", "description", "durationMs"]);
+    if (Object.keys(value).some((key) => !allowed.has(key))) throw Object.assign(new TypeError("通知参数包含不支持的字段"), { code: "UI_ARGUMENT_INVALID" });
+    const title = contentText(value.message, "message");
+    const description = value.description === undefined ? undefined : contentText(value.description, "description");
+    const duration = durationMs(value.durationMs);
+    return invokeUi<void>((runtime) => { runtime.notification[type as "success" | "info" | "warning" | "error"]({ message: title, description, duration }); });
+  }])) as Record<"success" | "info" | "warning" | "error", (input: { message: string; description?: string; durationMs?: number }) => Promise<void>>;
+
+  const modal = {
+    confirm(input: unknown): Promise<boolean> {
+      const options = modalOptions(input);
+      return invokeUi<boolean>((runtime) => new Promise<boolean>((resolve) => {
+        runtime.modal.confirm({
+          ...options,
+          onOk: () => { resolve(true); },
+          onCancel: () => { resolve(false); },
+        });
+      }));
+    },
+    ...Object.fromEntries(modalMethods.map((method) => [method, (input: unknown) => {
+      const options = modalOptions(input);
+      return invokeUi<void>((runtime) => { runtime.modal[method](options); });
+    }])) as Record<typeof modalMethods[number], (input: unknown) => Promise<void>>,
+  };
+
+  return Object.freeze({ message: Object.freeze(message), notification: Object.freeze(notification), modal: Object.freeze(modal) });
+}
+
+export function setWebWindowUiTheme(dark: boolean): void {
+  if (dark === isDarkTheme) return;
+  isDarkTheme = dark;
+  renderUiRoot();
+}
+
+function validStylesheetUrl(value: string): boolean {
+  if (value.length > 512) return false;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && url.hostname === "at.alicdn.com" && /^\/t\/(?:c\/)?font_[A-Za-z0-9_-]+\.css$/.test(url.pathname) && !url.username && !url.password && !url.hash;
+  } catch { return false; }
+}
+
+function validClassNames(value: string): boolean {
+  if (value.length > 256) return false;
+  const parts = value.trim().split(/\s+/);
+  return parts.length > 0 && parts.length <= 4 && parts.every((part) => /^[A-Za-z_][A-Za-z0-9_-]{0,63}$/.test(part));
+}
+
+function safeSvgNode(parent: SVGElement, node: WebWindowActionIconSvgNode): void {
+  const allowedTags = new Set(["g", "path", "circle", "rect", "line", "polyline", "polygon", "ellipse"]);
+  const allowedAttributes = new Set(["d", "fill", "stroke", "stroke-width", "fill-rule", "clip-rule", "stroke-linecap", "stroke-linejoin", "points", "cx", "cy", "r", "rx", "ry", "x", "y", "width", "height", "transform", "opacity"]);
+  if (!allowedTags.has(node.tag)) return;
+  const element = document.createElementNS("http://www.w3.org/2000/svg", node.tag);
+  for (const [name, value] of Object.entries(node.attrs ?? {})) {
+    if (!allowedAttributes.has(name) || typeof value !== "string" || value.length > 4096 || /[<>\u0000-\u001f]|url\s*\(/i.test(value)) continue;
+    element.setAttribute(name, value);
+  }
+  for (const child of node.children ?? []) safeSvgNode(element, child);
+  parent.append(element);
+}
+
+/** 在调用方页面的 DOM 中读取 iconfont symbol，并只提取安全的 SVG 几何属性。 */
+function extractIconfontSymbol(symbolId: string): { viewBox: string; nodes: WebWindowActionIconSvgNode[] } {
+  if (!/^icon-[A-Za-z0-9_-]{1,96}$/.test(symbolId)) throw Object.assign(new TypeError("Iconfont symbolId 格式无效"), { code: "ICONFONT_SYMBOL_INVALID" });
+  const symbol = document.getElementById(symbolId);
+  if (!symbol || symbol.localName.toLowerCase() !== "symbol") throw Object.assign(new Error("页面中未找到 Iconfont symbol：" + symbolId), { code: "ICONFONT_SYMBOL_NOT_FOUND" });
+  const viewBox = symbol.getAttribute("viewBox") ?? "0 0 1024 1024";
+  if (!/^[\d.\s,+-]{1,96}$/.test(viewBox)) throw Object.assign(new Error("Iconfont symbol viewBox 无效"), { code: "ICONFONT_SYMBOL_INVALID" });
+  let nodeCount = 0;
+  const allowedTags = new Set(["g", "path", "circle", "rect", "line", "polyline", "polygon", "ellipse"]);
