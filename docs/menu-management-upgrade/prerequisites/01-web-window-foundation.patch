+import type { ScriptRuntimeAssetSelector, ScriptRuntimeResolveResponse, ScriptRuntimeRunAt, ScriptRuntimeVersionPolicy } from "./script-runtime-contract";
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+
+export interface ScriptRuntimeCacheKeyInput {
+  platform: string;
+  workspaceType: string;
+  workspaceId: string;
+  origin: string;
+  normalizedUrl?: string;
+  authorizationScope?: string;
+  manifestRevision?: string;
+  runAt: ScriptRuntimeRunAt;
+  versionPolicy: ScriptRuntimeVersionPolicy;
+  scriptIdentifiers?: string[];
+  styleIdentifiers?: string[];
+  scriptSelectors?: ScriptRuntimeAssetSelector[];
+  styleSelectors?: ScriptRuntimeAssetSelector[];
+  publicIdentifiers?: string[];
+  publicStyleIdentifiers?: string[];
+  script?: ScriptRuntimeAssetSelector;
+  style?: ScriptRuntimeAssetSelector;
+}
+
+interface CacheEntry {
+  expiresAt: number;
+  response: ScriptRuntimeResolveResponse;
+}
+
+export interface CachedScriptSummary {
+  identifier: string;
+  version: string;
+  kind: "script" | "style";
+  expiresAt: number;
+  latestVersion?: string;
+  updateAvailable?: boolean;
+}
+
+export function readCachedScriptSummaries(filePath: string, now = Date.now(), manifestFilePath?: string): CachedScriptSummary[] {
+  const result = new Map<string, CachedScriptSummary>();
+  try {
+    const parsed = JSON.parse(readFileSync(filePath, "utf8")) as Record<string, CacheEntry>;
+    for (const entry of Object.values(parsed)) {
+      if (!entry || !Number.isFinite(entry.expiresAt) || entry.expiresAt <= now || !entry.response) continue;
+      const response = entry.response as ScriptRuntimeResolveResponse & { data?: { assets?: ScriptRuntimeResolveResponse["assets"]; public?: ScriptRuntimeResolveResponse["public"] } };
+      const assets = response.assets ?? response.data?.assets ?? [];
+      const publicAssets = response.public ?? response.data?.public ?? [];
+      for (const asset of assets) {
+        if (!asset || typeof asset.identifier !== "string" || !asset.identifier) continue;
+        const kind = asset.assetType === "style" ? "style" : "script";
+        const version = String(asset.version ?? asset.effectiveVersionId ?? "latest");
+        result.set(`${kind}:${asset.identifier}:${version}`, { identifier: asset.identifier, version, kind, expiresAt: entry.expiresAt });
+      }
+      for (const asset of publicAssets) {
+        if (!asset || typeof asset.identifier !== "string" || !asset.identifier) continue;
+        const version = String(asset.version ?? "latest");
+        result.set(`script:${asset.identifier}:${version}`, { identifier: asset.identifier, version, kind: "script", expiresAt: entry.expiresAt });
+      }
+    }
+  } catch { /* 缓存不存在或损坏时按空列表处理。 */ }
+  if (manifestFilePath) {
+    try {
+      const state = JSON.parse(readFileSync(manifestFilePath, "utf8")) as { manifests?: Record<string, { assets?: Array<{ identifier?: string; version?: string; assetType?: string }>; publicStyles?: Array<{ identifier?: string; version?: string }> }> };
+      const latest = new Map<string, string>();
+      for (const manifest of Object.values(state.manifests ?? {})) {
+        for (const asset of manifest.assets ?? []) {
+          if (typeof asset.identifier !== "string" || typeof asset.version !== "string") continue;
+          const kind = asset.assetType === "style" ? "style" : "script";
+          const key = `${kind}:${asset.identifier}`;
+          const previous = latest.get(key);
+          if (!previous || compareVersions(asset.version, previous) > 0) latest.set(key, asset.version);
+        }
+        for (const asset of manifest.publicStyles ?? []) {
+          if (typeof asset.identifier !== "string" || typeof asset.version !== "string") continue;
+          const key = `style:${asset.identifier}`;
+          const previous = latest.get(key);
+          if (!previous || compareVersions(asset.version, previous) > 0) latest.set(key, asset.version);
+        }
+      }
+      for (const item of result.values()) {
+        const latestVersion = latest.get(`${item.kind}:${item.identifier}`);
+        if (latestVersion && compareVersions(latestVersion, item.version) > 0) {
+          item.latestVersion = latestVersion;
+          item.updateAvailable = true;
+        }
+      }
+    } catch { /* 清单尚未生成时只展示本地缓存。 */ }
+  }
+  return [...result.values()].sort((a, b) => a.identifier.localeCompare(b.identifier) || a.kind.localeCompare(b.kind) || a.version.localeCompare(b.version));
+}
+
+function compareVersions(a: string, b: string): number {
+  const left = a.replace(/^v/i, "").split(/[.-]/).map((part) => Number.isFinite(Number(part)) ? Number(part) : part);
+  const right = b.replace(/^v/i, "").split(/[.-]/).map((part) => Number.isFinite(Number(part)) ? Number(part) : part);
+  for (let index = 0; index < Math.max(left.length, right.length); index++) {
+    const x = left[index] ?? 0; const y = right[index] ?? 0;
+    if (x === y) continue;
+    if (typeof x === "number" && typeof y === "number") return x - y;
+    return String(x).localeCompare(String(y));
+  }
+  return 0;
+}
+
+export class ScriptRuntimeAssetCache {
+  protected readonly entries = new Map<string, CacheEntry>();
+
+  get(input: ScriptRuntimeCacheKeyInput, now = Date.now()): ScriptRuntimeResolveResponse | null {
+    const key = scriptRuntimeCacheKey(input);
+    const entry = this.entries.get(key);
+    if (!entry) return null;
+    if (entry.expiresAt <= now) {
+      this.entries.delete(key);
+      return null;
+    }
+    return entry.response;
+  }
+
+  set(input: ScriptRuntimeCacheKeyInput, response: ScriptRuntimeResolveResponse, ttlMs: number, now = Date.now()): void {
+    if (ttlMs <= 0) return;
+    this.entries.set(scriptRuntimeCacheKey(input), { response, expiresAt: now + ttlMs });
+  }
+
+  clear(): void {
+    this.entries.clear();
+  }
+
+  size(): number {
+    return this.entries.size;
+  }
+
+  protected setByKey(key: string, entry: CacheEntry): void {
+    this.entries.set(key, entry);
+  }
+}
+
+/**
+ * 在内存缓存之上增加跨客户端重启复用的本地缓存。
+ * 只保存已经由服务端返回并经过运行时校验的响应，不保存 token 或请求头。
+ */
+export class PersistentScriptRuntimeAssetCache extends ScriptRuntimeAssetCache {
+  private hydrated = false;
+  private readonly filePath: string;
+
+  constructor(filePath: string) {
+    super();
+    this.filePath = filePath;
+  }
+
+  override get(input: ScriptRuntimeCacheKeyInput, now = Date.now()): ScriptRuntimeResolveResponse | null {
+    this.hydrate(now);
+    return super.get(input, now);
+  }
+
+  override set(input: ScriptRuntimeCacheKeyInput, response: ScriptRuntimeResolveResponse, ttlMs: number, now = Date.now()): void {
+    this.hydrate(now);
+    super.set(input, response, ttlMs, now);
+    this.persist();
+  }
+
+  override clear(): void {
+    super.clear();
+    this.hydrated = true;
+    this.persist();
+  }
+
+  private hydrate(now: number): void {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    try {
+      const parsed = JSON.parse(readFileSync(this.filePath, "utf8")) as Record<string, { expiresAt: number; response: ScriptRuntimeResolveResponse }>;
+      for (const [key, entry] of Object.entries(parsed)) {
+        if (!entry || !Number.isFinite(entry.expiresAt) || entry.expiresAt <= now || !entry.response) continue;
+        this.setByKey(key, entry);
+      }
+    } catch {
+      // 首次启动、缓存损坏或版本迁移时按冷缓存处理。
+    }
+  }
+
+  private persist(): void {
+    try {
+      mkdirSync(dirname(this.filePath), { recursive: true });
+      const temporaryPath = `${this.filePath}.tmp`;
+      writeFileSync(temporaryPath, JSON.stringify(Object.fromEntries(this.entries)), { encoding: "utf8", mode: 0o600 });
+      renameSync(temporaryPath, this.filePath);
+    } catch {
+      // 本地缓存不可写不影响在线注入。
+    }
+  }
+}
+
+/** 当前客户端进程内复用的短期脚本缓存；工作区和平台仍由缓存键隔离。 */
+export const sharedScriptRuntimeAssetCache = new ScriptRuntimeAssetCache();
+
+export function scriptRuntimeCacheKey(input: ScriptRuntimeCacheKeyInput): string {
+  const selector = (value?: ScriptRuntimeAssetSelector) => value ? `${value.identifier}@${value.version ?? "latest"}|runAt=${value.runAt ?? "fallback"}|priority=${value.priority ?? "fallback"}|enabled=${value.enabled ?? "fallback"}|match=${value.matchConfiguredUrlRules ?? true}` : "-";
+  return [
+    input.workspaceType,
+    input.workspaceId,
+    input.platform,
+    input.origin,
+    input.normalizedUrl ?? input.origin,
+    input.authorizationScope ?? "anonymous",
+    input.manifestRevision ?? "manifest-unavailable",
+    input.runAt,
+    input.versionPolicy,
+    `scriptIdentifiers:${[...(input.scriptIdentifiers ?? [])].sort().join(",")}`,
+    `styleIdentifiers:${[...(input.styleIdentifiers ?? [])].sort().join(",")}`,
+    `scriptSelectors:${[...(input.scriptSelectors ?? [])].map(selector).sort().join(",")}`,
+    `styleSelectors:${[...(input.styleSelectors ?? [])].map(selector).sort().join(",")}`,
+    `publicIdentifiers:${[...(input.publicIdentifiers ?? [])].sort().join(",")}`,
+    `publicStyleIdentifiers:${[...(input.publicStyleIdentifiers ?? [])].sort().join(",")}`,
+    `script:${selector(input.script)}`,
+    `style:${selector(input.style)}`,
+  ].map((part) => encodeURIComponent(part)).join("|");
+}
