+    await window.webContents.executeJavaScript(`window.__kwwUserActionEvents = []; window.jssdk = { lifecycle: { listeners: [], on(event, handler) { if (event === "userAction") this.listeners.push(handler); return () => {}; }, __dispatch(event, detail) { if (event === "userAction") for (const handler of this.listeners) handler(detail); } } }; void 0;`);
+    productionRuntime = new ProductionScriptRuntime({
