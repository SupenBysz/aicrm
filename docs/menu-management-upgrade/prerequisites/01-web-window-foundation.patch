@@ -0,0 +1,73 @@
+import type { WebWindowActionButtonRequest, WebWindowActionIcon, WebWindowActionIconSvgNode } from "./web-window-contract";
+
+export const WEB_WINDOW_ACTION_BUTTON_LIMIT = 4;
+const actionIdPattern = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$/;
+const svgTags = new Set(["g", "path", "circle", "rect", "line", "polyline", "polygon", "ellipse"]);
+const svgAttributes = new Set(["d", "fill", "stroke", "stroke-width", "fill-rule", "clip-rule", "stroke-linecap", "stroke-linejoin", "points", "cx", "cy", "r", "rx", "ry", "x", "y", "width", "height", "transform", "opacity"]);
+
+export function validWebWindowActionButtonId(value: unknown): value is string {
+  return typeof value === "string" && actionIdPattern.test(value);
+}
+
+function invalid(): never {
+  throw new TypeError("WINDOW_ACTION_ARGUMENT_INVALID");
+}
+
+function validStylesheetUrl(value: unknown): value is string {
+  if (typeof value !== "string" || value.length > 512) return false;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && url.hostname === "at.alicdn.com" && /^\/t\/(?:c\/)?font_[A-Za-z0-9_-]+\.css$/.test(url.pathname) && !url.username && !url.password && !url.hash;
+  } catch { return false; }
+}
+
+function validClassName(value: unknown): value is string {
+  if (typeof value !== "string" || value.length > 256) return false;
+  const parts = value.trim().split(/\s+/);
+  return parts.length > 0 && parts.length <= 4 && parts.every((part) => /^[A-Za-z_][A-Za-z0-9_-]{0,63}$/.test(part));
+}
+
+function sanitizeSvgNode(value: unknown, depth: number, state: { count: number }): WebWindowActionIconSvgNode {
+  if (!value || typeof value !== "object" || Array.isArray(value) || depth > 8 || ++state.count > 64) return invalid();
+  const input = value as Record<string, unknown>;
+  const tag = input.tag;
+  if (typeof tag !== "string" || !svgTags.has(tag)) return invalid();
+  if (!input.attrs || typeof input.attrs !== "object" || Array.isArray(input.attrs)) return invalid();
+  const attrs: Record<string, string> = {};
+  for (const [name, raw] of Object.entries(input.attrs as Record<string, unknown>)) {
+    if (!svgAttributes.has(name) || typeof raw !== "string" || raw.length > 4096 || /[<>\u0000-\u001f]|url\s*\(/i.test(raw)) return invalid();
+    attrs[name] = raw;
+  }
+  if (input.children !== undefined && (!Array.isArray(input.children) || input.children.length > 64)) return invalid();
+  const children = ((input.children ?? []) as unknown[]).map((child) => sanitizeSvgNode(child, depth + 1, state));
+  return { tag: tag as WebWindowActionIconSvgNode["tag"], attrs, children };
+}
+
+/** 校验 JSSDK 注册按钮的可序列化部分；业务回调不会进入主进程。 */
+export function validateWebWindowActionButtonRequest(value: unknown): WebWindowActionButtonRequest {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return invalid();
+  const input = value as Record<string, unknown>;
+  if (!validWebWindowActionButtonId(input.id) || typeof input.title !== "string" || !input.title.trim() || input.title.length > 64 || /[\u0000-\u001f\u007f]/.test(input.title)) return invalid();
+  if (!input.icon || typeof input.icon !== "object" || Array.isArray(input.icon)) return invalid();
+  const rawIcon = input.icon as Record<string, unknown>;
+  let icon: WebWindowActionIcon;
+  if (rawIcon.provider === "antd") {
+    if (typeof rawIcon.name !== "string" || !/^[A-Z][A-Za-z0-9]{0,79}(?:Outlined|Filled|TwoTone)$/.test(rawIcon.name)) return invalid();
+    icon = { provider: "antd", name: rawIcon.name };
+  } else if (rawIcon.provider === "iconfont" && rawIcon.mode === "font-class") {
+    if (!validStylesheetUrl(rawIcon.stylesheetUrl) || !validClassName(rawIcon.className)) return invalid();
+    icon = { provider: "iconfont", mode: "font-class", stylesheetUrl: rawIcon.stylesheetUrl, className: rawIcon.className.trim() };
+  } else if (rawIcon.provider === "iconfont" && rawIcon.mode === "unicode") {
+    if (!validStylesheetUrl(rawIcon.stylesheetUrl) || !validClassName(rawIcon.className) || typeof rawIcon.codePoint !== "string" || !/^(?:0x)?[0-9a-fA-F]{4,6}$/.test(rawIcon.codePoint)) return invalid();
+    const codePoint = Number.parseInt(rawIcon.codePoint.replace(/^0x/i, ""), 16);
+    if (codePoint > 0x10ffff || (codePoint >= 0xd800 && codePoint <= 0xdfff)) return invalid();
+    icon = { provider: "iconfont", mode: "unicode", stylesheetUrl: rawIcon.stylesheetUrl, className: rawIcon.className.trim(), codePoint: codePoint.toString(16) };
+  } else if (rawIcon.provider === "iconfont" && rawIcon.mode === "symbol") {
+    if (typeof rawIcon.symbolId !== "string" || !/^icon-[A-Za-z0-9_-]{1,96}$/.test(rawIcon.symbolId) || typeof rawIcon.viewBox !== "string" || !/^[\d.\s,+-]{1,96}$/.test(rawIcon.viewBox) || !Array.isArray(rawIcon.nodes) || rawIcon.nodes.length === 0) return invalid();
+    const state = { count: 0 };
+    icon = { provider: "iconfont", mode: "symbol", symbolId: rawIcon.symbolId, viewBox: rawIcon.viewBox, nodes: rawIcon.nodes.map((node) => sanitizeSvgNode(node, 1, state)) };
+  } else return invalid();
+  // 限制跨进程传递的 SVG 图标体积，防止多按钮注册导致工具栏 IPC payload 过大。
+  if (JSON.stringify(icon).length > 65536) return invalid();
+  return { id: input.id, title: input.title.trim(), icon };
+}
