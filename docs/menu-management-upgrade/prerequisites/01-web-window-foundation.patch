+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+
+test("Web 窗口宿主 SDK 使用窗口绑定上下文并拒绝密码能力旁路", async () => {
+  const source = await readFile(new URL("./app-window.ts", import.meta.url), "utf8");
+  assert.match(source, /childSdkContexts/);
+  assert.match(source, /getCurrentUser/);
+  assert.match(source, /getStoreInfo/);
+  assert.match(source, /HOST_CAPABILITY_UNAVAILABLE/);
+  assert.doesNotMatch(source, /console\.(log|info|error).*password/);
+});
+
+test("fillLoginForm 只返回字段结果并要求绑定店铺、来源和受控选择器", async () => {
+  const [source, injection] = await Promise.all([
+    readFile(new URL("./app-window.ts", import.meta.url), "utf8"),
+    readFile(new URL("./web-injection-window.ts", import.meta.url), "utf8")
+  ]);
+  assert.match(source, /login-credential/);
+  assert.match(source, /X-KY-Host-Call/);
+  assert.match(source, /ORIGIN_MISMATCH/);
+  assert.match(source, /WINDOW_NAVIGATION_CHANGED/);
+  assert.match(source, /Object\.getOwnPropertyDescriptor\(proto, "value"\)/);
+  assert.match(source, /dispatchEvent\(new Event\("input"/);
+  assert.match(source, /dispatchEvent\(new Event\("change"/);
+  assert.match(source, /passwordFilled: true/);
+  assert.match(source, /return \{ accountFilled: true, passwordFilled: true, submitted: Boolean\(result\.submitted\) \}/);
+  assert.match(source, /function isChildPageAtExpectedOrigin\(child: BrowserWindow\): boolean/);
+  assert.match(source, /webWindowAllowedOrigins\.get\(child\)/);
+  assert.match(source, /isAllowedByOriginPatterns\(currentUrl, allowedOriginMatchers\)/);
+  assert.match(injection, /webWindowAllowedOrigins\.set\(child, allowedOriginMatchers\)/);
+  assert.match(injection, /registerSender\(businessContents, "controlled", \(currentUrl\) =>/);
+  assert.match(injection, /isAllowedByOriginPatterns\(currentUrl, allowedOriginMatchers\)/);
+});
+
+test("登录空间来源白名单只从本次实际注入的资源绑定 matcher 派生", async () => {
+  const source = await readFile(new URL("./ipc/matrix-account-ipc.ts", import.meta.url), "utf8");
+  assert.match(source, /allowedOriginMatchers: loginSpaceRuntimeOriginMatchers\(/);
+  assert.match(source, /protocolWhitelist: MatrixAccountWebSpaceProtocolWhitelist/);
+  assert.match(source, /urlMatchers\?: string\[\]/);
+  assert.match(source, /const shouldInjectBoundResources = loginMode \|\| config\?\.inheritDefaultResources === true/);
+  assert.match(source, /originPatternsForBoundResources\(baseUrl, bindings\)/);
+});
+
+test("updateLoginSpaceInfo 只能更新宿主绑定空间的名称和登录状态", async () => {
+  const source = await readFile(new URL("./app-window.ts", import.meta.url), "utf8");
+  const preload = await readFile(new URL("../preload/web-window.ts", import.meta.url), "utf8");
+  const contract = await readFile(new URL("../shared/web-window-contract.ts", import.meta.url), "utf8");
+  assert.match(source, /raw\?\.method === "updateLoginSpaceInfo"/);
+  assert.match(source, /webWindowSpaceIds\.get\(child\)/);
+  assert.match(source, /bound\.id !== storeId/);
+  assert.match(source, /login-spaces\/\$\{encodeURIComponent\(spaceId\)\}\/info/);
+  assert.match(source, /method: "PATCH"/);
+  assert.match(source, /LOGIN_SPACE_INFO_INVALID/);
+  assert.match(source, /LOGIN_SPACE_STATUS_INVALID/);
+  assert.match(source, /capabilities\.push\("host\.updateLoginSpaceInfo"\)/);
+  assert.match(source, /webWindowSpaceUuids\.get\(child\)/);
+  assert.match(source, /recordLoginSpaceLocalStatus\(app\.getPath\("userData"\), spaceUuid, body\.loginStatus\)/);
+  assert.match(preload, /updateLoginSpaceInfo\(options: WebWindowLoginSpaceInfoUpdate\)/);
+  assert.match(contract, /"unknown" \| "logging_in" \| "logged_in" \| "logged_out" \| "expired" \| "error"/);
+  const updateStart = source.indexOf('if (raw?.method === "updateLoginSpaceInfo")');
+  const updateEnd = source.indexOf('if (raw?.method !== "fillLoginForm")', updateStart);
+  assert.ok(updateStart >= 0 && updateEnd > updateStart, "登录空间更新处理边界缺失");
+  assert.doesNotMatch(source.slice(updateStart, updateEnd), /body: JSON\.stringify\(\{[^}]*storeId/);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-store-sdk.test.mjs b/apps/aicrm-desktop/src/main/web-window-store-sdk.test.mjs
