+        // the target navigation and must not cancel the strict document_start resolver.
+        ignoreInitialAboutBlankStart = false;
+        return;
+      }
+      ignoreInitialAboutBlankStart = false;
+      this.pendingAbort?.abort();
+      this.pendingAbort = null;
+      try {
+        const next = new URL(url);
+        const previous = this.navigationUrl ? new URL(this.navigationUrl) : null;
+        this.navigationUrl = previous && previous.origin === next.origin && previous.pathname === next.pathname && previous.search && !next.search
+          ? previous.toString()
+          : url;
+      } catch {
+        this.navigationUrl = url;
+      }
+      void this.injector.clearStyles(webContents);
+      this.navigation.beginMainNavigation();
+      const generation = this.navigation.current();
+      let prepared = false;
+      const routeAwareBundle = this.isAllowedRuntimeUrl(url) ? this.routeAwareDocumentStartBundles.get(webContents) : undefined;
+      try {
+        prepared = routeAwareBundle !== undefined || (this.preparedDocumentStartUrls.get(webContents)?.has(routeKey(url)) ?? false);
