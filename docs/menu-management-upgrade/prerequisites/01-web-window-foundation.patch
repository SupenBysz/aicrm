+    response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
+    response.end(`<!doctype html><html><body>${pages[path] ?? "not-found"}</body></html>`);
+  });
+}
+
+function createExternalFixtureServer() {
+  return createServer((_request, response) => {
+    response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
+    response.end("<!doctype html><html><body><main><h1>external-ready</h1></main></body></html>");
+  });
+}
+
+function waitForPath(contents, expectedPath, timeoutMs = 5000) {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => done(new Error(`navigation_timeout:${expectedPath}:${contents.getURL()}`)), timeoutMs);
+    const check = () => {
+      try {
+        if (new URL(contents.getURL()).pathname === expectedPath) done();
+      } catch { /* URL尚未更新。 */ }
+    };
+    const done = (error) => {
+      clearTimeout(timeout);
+      contents.removeListener("did-navigate", check);
+      contents.removeListener("did-navigate-in-page", check);
+      contents.removeListener("did-finish-load", check);
+      error ? reject(error) : resolve();
+    };
+    contents.on("did-navigate", check);
+    contents.on("did-navigate-in-page", check);
+    contents.on("did-finish-load", check);
+    check();
+  });
+}
+
+async function assertViewStable(contents, view, label) {
+  const children = window.contentView.children;
+  assert.equal(children.filter((child) => child === view).length, 1, `${label}: view must remain mounted once`);
+  assert.equal(view.getVisible(), true, `${label}: view must remain visible`);
+  const bounds = view.getBounds();
+  assert.ok(bounds.width > 0 && bounds.height > 0, `${label}: view must retain non-zero bounds`);
+  assert.ok(!contents.isDestroyed(), `${label}: WebContents must remain alive`);
+  assert.equal(await contents.executeJavaScript("document.querySelector('h1')?.textContent"), label);
+}
+
+async function waitForFrameContents(contents, expectedText, timeoutMs = 3000) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    const text = await contents.executeJavaScript("document.getElementById('subframe')?.contentDocument?.body?.textContent.trim() ?? ''").catch(() => "");
+    if (text === expectedText) return;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  throw new Error(`subframe_contents_timeout:${expectedText}`);
+}
+
+async function waitForPageCondition(contents, expression, label, timeoutMs = 5000) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (await contents.executeJavaScript(expression).catch(() => false)) return;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  throw new Error(`page_condition_timeout:${label}`);
+}
+
+function waitForViewVisibility(view, expectedVisible, timeoutMs = 1500) {
+  return new Promise((resolve, reject) => {
+    const deadline = Date.now() + timeoutMs;
+    const check = () => {
+      if (view.webContents.isDestroyed()) return reject(new Error("web_window_view_destroyed"));
+      if (view.getVisible() === expectedVisible) return resolve();
+      if (Date.now() >= deadline) return reject(new Error(`web_window_view_visibility_timeout:${expectedVisible}`));
+      setTimeout(check, 10);
+    };
+    check();
+  });
+}
+
+function waitForMainFrameFailure(contents, timeoutMs = 5000) {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => done(new Error("main_frame_failure_timeout")), timeoutMs);
+    const onFailure = (_event, errorCode, description, validatedUrl, isMainFrame) => {
+      if (isMainFrame) done(null, { errorCode, description, validatedUrl });
+    };
+    const done = (error, result) => {
+      clearTimeout(timeout);
+      contents.removeListener("did-fail-load", onFailure);
+      error ? reject(error) : resolve(result);
+    };
+    contents.on("did-fail-load", onFailure);
+  });
+}
