+function normalizeRuntimeEnvelope(envelope: RuntimeEnvelope, platform: string): RuntimeEnvelope {
+  if (!Array.isArray(envelope.assets) && envelope.data && !Array.isArray(envelope.data)) {
+    envelope.assets = envelope.data.assets;
+    envelope.public = envelope.data.public;
+    envelope.publicStyles = envelope.data.publicStyles;
+  }
+  if (!Array.isArray(envelope.assets) && Array.isArray(envelope.data)) {
+    envelope.assets = envelope.data.map((raw) => {
+      if ("source" in (raw as unknown as Record<string, unknown>)) {
+        return raw as unknown as ScriptRuntimeResolveResponse["assets"][number];
+      }
+      const legacy = raw as RuntimeCandidateResponse;
+      return {
+        assetType: legacy.kind,
+        platform,
+        identifier: legacy.identifier,
+        ...(legacy.version ? { version: legacy.version } : {}),
+        effectiveVersionId: legacy.effectiveVersionId,
+        runAt: legacy.runAt,
+        priority: legacy.priority,
