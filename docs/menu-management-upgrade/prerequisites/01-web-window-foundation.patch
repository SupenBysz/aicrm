@@ -0,0 +1,166 @@
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { dirname } from "node:path";
+
+export interface RuntimeManifestAsset {
+  assetType: "script" | "style" | string;
+  identifier: string;
+  version: string;
+  effectiveVersionId?: string;
+  runAt?: string;
+  priority?: number;
+  enabled?: boolean;
+  sourceSha256?: string;
+  status?: string;
+}
+
+export interface RuntimeManifestSnapshot {
+  schemaVersion: number;
+  workspaceType: string;
+  workspaceId: string;
+  platform: string;
+  manifestRevision: string;
+  fetchedAt?: string;
+  assets: RuntimeManifestAsset[];
+  public?: RuntimeManifestAsset[];
+  publicStyles?: RuntimeManifestAsset[];
+}
+
+interface PersistedManifestState {
+  schemaVersion: 1;
+  manifests: Record<string, RuntimeManifestSnapshot>;
+}
+
+export interface ManifestSyncOptions {
+  apiBaseUrl: string;
+  token: string;
+  workspaceType: string;
+  workspaceId: string;
+  platform: string;
+  filePath: string;
+  fetchImpl?: typeof fetch;
+  timeoutMs?: number;
+}
+
+export type ManifestSyncResult =
+  | { state: "updated"; snapshot: RuntimeManifestSnapshot }
+  | { state: "not_modified"; snapshot: RuntimeManifestSnapshot }
+  | { state: "failed"; reason: string; snapshot?: RuntimeManifestSnapshot };
+
+const inFlight = new Map<string, Promise<ManifestSyncResult>>();
+
+function contextKey(options: ManifestSyncOptions): string {
+  const authorizationScope = createHash("sha256").update(options.token, "utf8").digest("hex");
+  return JSON.stringify([
+    options.apiBaseUrl.replace(/\/+$/, ""),
+    authorizationScope,
+    options.workspaceType,
+    options.workspaceId,
+    options.platform,
+    options.filePath,
+    "latest_released"
+  ]);
+}
+
+function readState(filePath: string): PersistedManifestState {
+  try {
+    const value = JSON.parse(readFileSync(filePath, "utf8")) as Partial<PersistedManifestState>;
+    if (value.schemaVersion === 1 && value.manifests && typeof value.manifests === "object") {
+      return { schemaVersion: 1, manifests: value.manifests as Record<string, RuntimeManifestSnapshot> };
+    }
+  } catch {
+    // 首次运行、旧文件或损坏文件按空清单处理，不能影响客户端启动。
+  }
+  return { schemaVersion: 1, manifests: {} };
+}
+
+function writeState(filePath: string, state: PersistedManifestState): void {
+  mkdirSync(dirname(filePath), { recursive: true });
+  const temporaryPath = `${filePath}.tmp`;
+  writeFileSync(temporaryPath, JSON.stringify(state), { encoding: "utf8", mode: 0o600 });
+  renameSync(temporaryPath, filePath);
+}
+
+function normalizeSnapshot(value: unknown, fallback: Pick<ManifestSyncOptions, "workspaceType" | "workspaceId" | "platform">): RuntimeManifestSnapshot | null {
+  const root = value as { data?: unknown } | null;
+  const candidate = root && root.data && typeof root.data === "object" ? root.data : value;
+  const item = candidate as Partial<RuntimeManifestSnapshot> | null;
+  if (!item || typeof item.manifestRevision !== "string" || !item.manifestRevision || !Array.isArray(item.assets)) return null;
+  const assets = item.assets.filter((asset): asset is RuntimeManifestAsset => Boolean(asset && typeof asset === "object" && typeof (asset as RuntimeManifestAsset).identifier === "string" && typeof (asset as RuntimeManifestAsset).version === "string"));
+  const publicAssets = Array.isArray(item.public)
+    ? item.public.filter((asset): asset is RuntimeManifestAsset => Boolean(asset && typeof asset === "object" && typeof (asset as RuntimeManifestAsset).identifier === "string" && typeof (asset as RuntimeManifestAsset).version === "string"))
+    : [];
+  const publicStyles = Array.isArray(item.publicStyles)
+    ? item.publicStyles.filter((asset): asset is RuntimeManifestAsset => Boolean(asset && typeof asset === "object" && typeof (asset as RuntimeManifestAsset).identifier === "string" && typeof (asset as RuntimeManifestAsset).version === "string"))
+    : [];
+  return {
+    schemaVersion: Number.isInteger(item.schemaVersion) ? Number(item.schemaVersion) : 1,
+    workspaceType: typeof item.workspaceType === "string" ? item.workspaceType : fallback.workspaceType,
+    workspaceId: typeof item.workspaceId === "string" ? item.workspaceId : fallback.workspaceId,
+    platform: typeof item.platform === "string" ? item.platform : fallback.platform,
+    manifestRevision: item.manifestRevision,
+    fetchedAt: typeof item.fetchedAt === "string" ? item.fetchedAt : new Date().toISOString(),
+    assets,
+    public: publicAssets,
+    publicStyles
+  };
+}
+
+export class ScriptRuntimeManifestSync {
+  private readonly options: ManifestSyncOptions;
+
+  constructor(options: ManifestSyncOptions) {
+    this.options = options;
+  }
+
+  getCached(): RuntimeManifestSnapshot | null {
+    return readState(this.options.filePath).manifests[contextKey(this.options)] ?? null;
+  }
+
+  sync(): Promise<ManifestSyncResult> {
+    const key = contextKey(this.options);
+    const existing = inFlight.get(key);
+    if (existing) return existing;
+    const task = this.run(key).finally(() => inFlight.delete(key));
+    inFlight.set(key, task);
+    return task;
+  }
+
+  private async run(key: string): Promise<ManifestSyncResult> {
+    const state = readState(this.options.filePath);
+    const previous = state.manifests[key];
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), this.options.timeoutMs ?? 3000);
+    try {
+      const response = await (this.options.fetchImpl ?? fetch)(`${this.options.apiBaseUrl.replace(/\/+$/, "")}/api/v1/script-runtime/manifest`, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${this.options.token}`,
+          "Content-Type": "application/json",
+          "X-KY-Workspace-Type": this.options.workspaceType,
+          "X-KY-Workspace-Id": this.options.workspaceId,
+          ...(previous?.manifestRevision ? { "If-None-Match": previous.manifestRevision } : {})
+        },
+        body: JSON.stringify({ platform: this.options.platform, workspace: { type: this.options.workspaceType, id: this.options.workspaceId }, versionPolicy: "latest_released" }),
+        signal: controller.signal
+      });
+      if (response.status === 304 || response.headers.get("X-KY-Manifest-Not-Modified") === "1") {
+        if (!previous) return { state: "failed", reason: "not_modified_without_cache" };
+        return { state: "not_modified", snapshot: previous };
+      }
+      if (!response.ok) return { state: "failed", reason: `http_${response.status}`, snapshot: previous };
+      const snapshot = normalizeSnapshot(await response.json(), this.options);
+      if (!snapshot) return { state: "failed", reason: "invalid_manifest", snapshot: previous };
+      // Different authorization scopes can refresh the same manifest file at once.
+      // Merge into the latest state so one window cannot overwrite another's cache entry.
+      const latestState = readState(this.options.filePath);
+      latestState.manifests[key] = snapshot;
+      writeState(this.options.filePath, latestState);
+      return { state: "updated", snapshot };
+    } catch (error) {
+      return { state: "failed", reason: error instanceof Error ? error.message : "manifest_sync_failed", snapshot: previous };
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+}
