+import assert from "node:assert/strict";
+import test from "node:test";
+import { EventEmitter } from "node:events";
+import { WebWindowManager } from "./web-window-manager.ts";
+
+function fakeWindow() {
+  const events = new EventEmitter();
+  return {
+    destroyed: false,
+    closeCount: 0,
+    isDestroyed() { return this.destroyed; },
+    close() { this.closeCount += 1; this.destroyed = true; events.emit("closed"); },
+    once: events.once.bind(events)
+  };
+}
+
+test("窗口管理器按稳定实例 id 复用、列举和关闭实例", async () => {
+  const manager = new WebWindowManager();
+  const shell = fakeWindow();
+  let creates = 0;
+  const create = () => {
+    creates += 1;
+    return { id: "window-1", window: shell, contents: {}, scheduleMode: "page_first", dispatchUserAction: async () => true };
+  };
+  const first = manager.open("window-1", create);
+  assert.equal(manager.open("window-1", create), first);
+  assert.equal(creates, 1);
+  assert.deepEqual(manager.list().map((item) => item.id), ["window-1"]);
+  assert.equal(await manager.dispatchUserAction("window-1", "toolbar.refresh"), true);
+  assert.equal(await manager.dispatchUserAction("window-1", "bad action"), false);
+  assert.equal(manager.close("window-1"), true);
+  assert.equal(shell.closeCount, 1);
+  assert.equal(manager.get("window-1"), null);
+  assert.equal(manager.list().length, 0);
+});
+
+test("Electron 窗口优先强制释放，避免页面 beforeunload 阻塞宿主关闭", () => {
+  const manager = new WebWindowManager();
+  const shell = fakeWindow();
+  shell.destroyCount = 0;
+  shell.destroy = function () { this.destroyCount += 1; this.destroyed = true; };
+  manager.open("window-force-close", () => ({
+    id: "window-force-close",
+    window: shell,
+    contents: {},
+    scheduleMode: "page_first",
+    dispatchUserAction: async () => false
+  }));
+
+  assert.equal(manager.close("window-force-close"), true);
+  assert.equal(shell.destroyCount, 1);
+  assert.equal(shell.closeCount, 0);
+  assert.equal(manager.get("window-force-close"), null);
+});
+
+test("宿主语义动作只派发到指定窗口实例", async () => {
+  const manager = new WebWindowManager();
+  const received = [];
+  for (const id of ["window-one", "window-two"]) {
+    manager.open(id, () => ({
+      id,
+      window: fakeWindow(),
+      contents: {},
+      scheduleMode: "page_first",
+      dispatchUserAction: async (actionId) => { received.push([id, actionId]); return true; }
+    }));
+  }
+
+  assert.equal(await manager.dispatchUserAction("window-two", "toolbar.export"), true);
+  assert.deepEqual(received, [["window-two", "toolbar.export"]]);
+  assert.equal(await manager.dispatchUserAction("missing-window", "toolbar.export"), false);
+  assert.deepEqual(received, [["window-two", "toolbar.export"]]);
+});
diff --git a/apps/aicrm-desktop/src/main/web-window-manager.ts b/apps/aicrm-desktop/src/main/web-window-manager.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fb4dc0067ee3527f30e55d8605e4a6784df1c289
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-manager.ts
@@ -0,0 +1,64 @@
+export type WebWindowScheduleMode = "page_first" | "strict_document_start";
+
+export interface ManagedWebWindow<TWindow = unknown, TContents = unknown> {
+  id: string;
+  window: TWindow;
+  contents: TContents;
+  scheduleMode: WebWindowScheduleMode;
+  dispatchUserAction(actionId: string): Promise<boolean>;
+}
+
+type ClosableWindow = {
+  isDestroyed(): boolean;
+  close(): void;
+  destroy?(): void;
+  once?(event: "closed", listener: () => void): unknown;
+};
+
+/** 维护 Web 专用窗口的稳定实例身份；导航不会改变登记关系。 */
+export class WebWindowManager<TWindow extends ClosableWindow, TContents> {
+  private readonly instances = new Map<string, ManagedWebWindow<TWindow, TContents>>();
+
+  open(id: string, create: () => ManagedWebWindow<TWindow, TContents>): ManagedWebWindow<TWindow, TContents> {
+    const existing = this.instances.get(id);
+    if (existing && !existing.window.isDestroyed()) return existing;
+    if (existing) this.instances.delete(id);
+    const instance = create();
+    if (instance.id !== id) throw new Error("web_window_instance_id_mismatch");
+    this.instances.set(id, instance);
+    instance.window.once?.("closed", () => {
+      if (this.instances.get(id) === instance) this.instances.delete(id);
+    });
+    return instance;
+  }
+
+  get(id: string): ManagedWebWindow<TWindow, TContents> | null {
+    const instance = this.instances.get(id);
+    if (!instance || instance.window.isDestroyed()) {
+      this.instances.delete(id);
+      return null;
+    }
+    return instance;
+  }
+
+  list(): readonly ManagedWebWindow<TWindow, TContents>[] {
+    for (const [id, instance] of this.instances) if (instance.window.isDestroyed()) this.instances.delete(id);
+    return [...this.instances.values()];
+  }
+
+  close(id: string): boolean {
+    const instance = this.get(id);
+    if (!instance) return false;
+    // A host-owned window must be releasable even if page code blocks beforeunload.
+    // Electron's destroy still emits `closed`, so the normal instance cleanup runs.
+    if (instance.window.destroy) instance.window.destroy();
+    else instance.window.close();
+    return true;
+  }
+
+  async dispatchUserAction(id: string, actionId: string): Promise<boolean> {
+    const instance = this.get(id);
+    if (!instance || !/^[A-Za-z][A-Za-z0-9._:-]{0,63}$/.test(actionId)) return false;
+    return instance.dispatchUserAction(actionId);
+  }
+}
diff --git a/apps/aicrm-desktop/src/main/web-window-navigation-controller.ts b/apps/aicrm-desktop/src/main/web-window-navigation-controller.ts
