+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import { WebWindowSlotRegistry, validateWebWindowManifest, validateWebWindowProjection } from "./web-window.ts";
+
+test("Web Window manifest 使用独立增量合同", () => {
+  assert.equal(validateWebWindowManifest({
+    schemaVersion: 1, kind: "desktop-web-window-plugin", id: "cn.org.kww.desktop.web-window", version: "1.0.0", entry: "plugin.js",
+    platforms: ["darwin"], capabilities: ["webWindow.projection.read", "webWindow.navigation.fixed"],
+    contributes: { slots: ["webWindow.header.navigation", "webWindow.header.status"] }, data: { mode: "declarative", schemaVersion: 1 }
+  }).id, "cn.org.kww.desktop.web-window");
+  assert.throws(() => validateWebWindowManifest({ kind: "desktop-host-plugin" }), /web_window_manifest_invalid/);
+});
+
+test("Web Window 内置投影插件支持 macOS 和 Windows，拒绝未支持的平台", () => {
+  const manifest = {
+    schemaVersion: 1,
+    kind: "desktop-web-window-plugin",
+    id: "cn.org.kww.desktop.web-window",
+    version: "1.0.0",
+    entry: "plugin.js",
+    engines: { host: ">=0.1.0 <1.0.0", pluginApi: "1.0.0", uiApi: "1.0.0" },
+    platforms: ["darwin", "win32"],
+    capabilities: ["webWindow.projection.read", "webWindow.navigation.fixed"],
+    contributes: { slots: ["webWindow.status.right"] },
+    data: { mode: "declarative", schemaVersion: 1 }
+  };
+  assert.deepEqual(validateWebWindowManifest(manifest).platforms, ["darwin", "win32"]);
+  assert.throws(() => validateWebWindowManifest({ ...manifest, platforms: ["linux"] }), /web_window_manifest_invalid/);
+  assert.throws(() => validateWebWindowManifest({ ...manifest, platforms: ["win32", "win32"] }), /web_window_manifest_invalid/);
+});
+
+test("随客户端打包的 Web Window 插件清单同时声明 macOS 和 Windows", async () => {
+  const manifest = JSON.parse(await readFile(new URL("../../../desktop-plugins/kww-web-window/v1/manifest.json", import.meta.url), "utf8"));
+  assert.deepEqual(validateWebWindowManifest(manifest).platforms, ["darwin", "win32"]);
+});
+
+test("Web Window 投影只允许声明式白名单动作", () => {
+  const projection = validateWebWindowProjection({
+    instanceId: "window-1", navigationGeneration: 2, uiSessionId: "session-1", activeRevision: 3,
+    items: [{ id: "back", slot: "webWindow.header.navigation", type: "button", text: "后退", tone: "normal", actionId: "back" }]
+  });
+  assert.equal(projection.items[0].actionId, "back");
+  assert.throws(() => validateWebWindowProjection({
+    instanceId: "window-1", navigationGeneration: 2, uiSessionId: "session-1", activeRevision: 3,
+    items: [{ id: "evil", slot: "webWindow.header.navigation", type: "button", text: "执行", tone: "normal", actionId: "executeJavaScript" }]
+  }), /web_window_action_invalid/);
+  const withPanel = validateWebWindowProjection({
+    instanceId: "window-1", navigationGeneration: 2, uiSessionId: "session-1", activeRevision: 3,
+    items: [{ id: "version", slot: "webWindow.status.right", type: "button", text: "v1.0.0", tone: "muted", actionId: "version-panel" }],
+    versionPanel: {
+      plugin: { id: "cn.org.kww.desktop.web-window", version: "1.0.0", source: "builtin", status: "stable" },
+      client: { name: "AiCRM", version: "0.1.1", electronVersion: "43.0.0", runtime: "electron", channel: "development", platform: "darwin", arch: "arm64" },
+      injection: {
+        script: { identifier: "APP_MAIN", version: "0.1.0", versionSource: "latest_released", status: "succeeded", error: null },
+        style: { identifier: "APP_STYLE", version: null, versionSource: "unknown", status: "not_configured", error: null }
+      },
+      page: { url: "https://example.com/login", navigationGeneration: 2 }
+    }
+  });
+  assert.equal(withPanel.versionPanel?.plugin.version, "1.0.0");
+});
+
+test("宿主注册的命名空间扩展位可被清单声明，未注册扩展位会被拒绝", () => {
+  const slots = new WebWindowSlotRegistry();
+  slots.register("webWindow.example.tools", "header.status");
+  slots.validateContributions(["webWindow.example.tools"]);
+  assert.equal(slots.surfaceFor("webWindow.example.tools"), "header.status");
+  assert.throws(() => slots.validateContributions(["webWindow.example.unregistered"]), /web_window_slot_not_registered/);
+  assert.throws(() => slots.register("webWindow.bad space", "status.left"), /web_window_slot_id_invalid/);
+});
+
+test("插件清单接受稳定命名的扩展位，由宿主注册表决定是否可用", () => {
+  const manifest = {
+    schemaVersion: 1,
+    kind: "desktop-web-window-plugin",
+    id: "cn.org.kww.desktop.web-window",
+    version: "1.0.0",
+    entry: "plugin.js",
+    engines: { host: ">=0.1.0 <1.0.0", pluginApi: "1.0.0", uiApi: "1.0.0" },
+    platforms: ["darwin"],
+    capabilities: ["webWindow.projection.read", "webWindow.navigation.fixed"],
+    contributes: { slots: ["webWindow.example.tools"] },
+    data: { mode: "declarative", schemaVersion: 1 }
+  };
+  assert.equal(validateWebWindowManifest(manifest), manifest);
+  const slots = new WebWindowSlotRegistry();
+  assert.throws(() => slots.validateContributions(manifest.contributes.slots), /web_window_slot_not_registered/);
+});
