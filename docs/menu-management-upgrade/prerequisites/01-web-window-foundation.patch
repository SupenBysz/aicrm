+export type WebWindowHeaderTitleStyle = { color?: string; fontSize?: number; fontWeight?: number | string; letterSpacing?: number; fontFamily?: string; /** 标题容器最小宽度，默认 145px；实际宽度按内容自适应，最大 320px。 */ width?: number; align?: "left" | "center" | "right"; visible?: boolean };
