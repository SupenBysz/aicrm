+    // 的对应生命周期，不能把它请求成 load，否则会被服务端按 runAt 过滤掉。
+    const onLoad = () => {
+      const url = this.navigationUrl ?? undefined;
+      const generation = this.navigation.current();
+      void this.confirmDocumentStartExecution(webContents, url);
+      void Promise.all([
+        this.execute(webContents, "document_idle", url),
+        this.execute(webContents, "load", url)
