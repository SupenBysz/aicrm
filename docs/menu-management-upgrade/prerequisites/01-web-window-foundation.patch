index 0000000000000000000000000000000000000000..dd0c092d1de2c3c5fbe8f0be2b543d12c200593a
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/web-window-injection.ts
@@ -0,0 +1,93 @@
+import type { ClientInjectionResult } from "./script-injector.ts";
+import type { ScriptRuntimeAssetSelector, ScriptRuntimeVersionPolicy } from "./script-runtime-contract.ts";
+
+export type WebWindowResourceDeclaration = {
+  script?: ScriptRuntimeAssetSelector;
+  scriptIdentifiers?: string[];
+  scriptSelectors?: ScriptRuntimeAssetSelector[];
+  style?: ScriptRuntimeAssetSelector;
+  styleIdentifiers?: string[];
+  styleSelectors?: ScriptRuntimeAssetSelector[];
+  publicIdentifiers?: string[];
+  publicStyleIdentifiers?: string[];
+  versionPolicy?: ScriptRuntimeVersionPolicy;
+};
+
+export type WebWindowRuntimeResourceOptions = WebWindowResourceDeclaration & {
+  scriptIdentifiers?: readonly string[];
+  styleIdentifiers?: readonly string[];
+  scriptSelectors?: readonly ScriptRuntimeAssetSelector[];
+  styleSelectors?: readonly ScriptRuntimeAssetSelector[];
+  publicIdentifiers?: readonly string[];
+  publicStyleIdentifiers?: readonly string[];
+};
+
+export type WebWindowInjectionStatus = {
+  generation: number;
+  script: "idle" | "succeeded" | "failed" | "cancelled";
+  style: "idle" | "succeeded" | "failed" | "cancelled";
+  errors: readonly string[];
+};
+
+export function normalizeResourceDeclaration(value: WebWindowResourceDeclaration = {}): WebWindowResourceDeclaration {
+  const normalize = (selector?: ScriptRuntimeAssetSelector) => {
+    if (!selector) return undefined;
+    if (!/^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/.test(selector.identifier)) throw new Error("resource_identifier_invalid");
+    if (selector.version !== undefined && !/^\d+\.\d+\.\d+$/.test(selector.version)) throw new Error("resource_version_invalid");
+    return {
+      identifier: selector.identifier,
+      ...(selector.version ? { version: selector.version } : {}),
+      matchConfiguredUrlRules: selector.matchConfiguredUrlRules ?? true
+    };
+  };
+  return {
+    script: normalize(value.script),
+    ...(value.scriptIdentifiers ? { scriptIdentifiers: value.scriptIdentifiers.slice() } : {}),
+    ...(value.scriptSelectors ? { scriptSelectors: value.scriptSelectors.slice() } : {}),
+    style: normalize(value.style),
+    ...(value.styleIdentifiers ? { styleIdentifiers: value.styleIdentifiers.slice() } : {}),
+    ...(value.styleSelectors ? { styleSelectors: value.styleSelectors.slice() } : {}),
+    ...(value.publicIdentifiers ? { publicIdentifiers: value.publicIdentifiers.slice() } : {}),
+    ...(value.publicStyleIdentifiers ? { publicStyleIdentifiers: value.publicStyleIdentifiers.slice() } : {}),
+    versionPolicy: value.versionPolicy
+  };
+}
+
+export function hasScriptResourceDeclaration(value: WebWindowResourceDeclaration = {}): boolean {
+  return Boolean(value.script || value.scriptIdentifiers?.length || value.scriptSelectors?.length || value.publicIdentifiers?.length);
+}
+
+export function hasStyleResourceDeclaration(value: WebWindowResourceDeclaration = {}): boolean {
+  return Boolean(value.style || value.styleIdentifiers?.length || value.styleSelectors?.length || value.publicStyleIdentifiers?.length);
+}
+
+export function hasInjectableResourceDeclaration(value: WebWindowResourceDeclaration = {}): boolean {
+  return Boolean(
+    hasScriptResourceDeclaration(value)
+    || hasStyleResourceDeclaration(value)
+    || value.publicIdentifiers?.length
+    || value.publicStyleIdentifiers?.length
+  );
+}
+
+export function hasWebWindowRuntimeResources(value: WebWindowRuntimeResourceOptions): boolean {
+  return hasWebWindowRuntimeResourceKind(value, "script") || hasWebWindowRuntimeResourceKind(value, "style");
+}
+
+export function hasWebWindowRuntimeResourceKind(value: WebWindowRuntimeResourceOptions, kind: "script" | "style"): boolean {
+  if (kind === "script") {
+    return Boolean(value.script || value.scriptIdentifiers?.length || value.scriptSelectors?.length || value.publicIdentifiers?.length);
+  }
+  return Boolean(value.style || value.styleIdentifiers?.length || value.styleSelectors?.length || value.publicStyleIdentifiers?.length);
+}
+
+export function summarizeInjectionResults(generation: number, results: readonly ClientInjectionResult[]): WebWindowInjectionStatus {
+  const state = (kind: "script" | "style"): WebWindowInjectionStatus[typeof kind] => {
+    const matching = results.filter((result) => result.kind === kind);
+    if (!matching.length) return "idle";
+    if (matching.some((result) => result.state === "failed" || result.state === "timed_out")) return "failed";
+    if (matching.some((result) => result.state === "cancelled")) return "cancelled";
+    return "succeeded";
+  };
+  return { generation, script: state("script"), style: state("style"), errors: results.flatMap((result) => result.errorCode ? [result.errorCode] : []) };
+}
