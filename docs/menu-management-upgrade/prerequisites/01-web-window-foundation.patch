+import assert from "node:assert/strict";
+import test from "node:test";
+import { isAllowedByOriginPatterns, normalizeOriginPattern, normalizeOriginPatterns, originPatternsForBoundResources } from "./script-runtime-origin-policy.ts";
+
+test("登录空间 URL matcher 会规范化为精确来源并保留受控主机通配符", () => {
+  assert.equal(normalizeOriginPattern("https://buyin.jinritemai.com/dashboard/servicehall/*"), "https://buyin.jinritemai.com");
+  assert.equal(normalizeOriginPattern("https://*.jinritemai.com/dashboard/*"), "https://*.jinritemai.com");
+  assert.equal(normalizeOriginPattern("https://jinritemai.com.evil*/*"), null);
+  assert.equal(normalizeOriginPattern("https://buyin.*.com/*"), null);
+  assert.equal(normalizeOriginPattern("null"), null);
+  assert.equal(normalizeOriginPattern("https://user:secret@buyin.jinritemai.com/*"), null);
+  assert.equal(normalizeOriginPattern("file://buyin.jinritemai.com/*"), null);
+});
+
+test("跨来源信任只匹配绑定的 HTTP(S) 主机，页面路径规则仍由资源 matcher 约束", () => {
+  const patterns = normalizeOriginPatterns([
+    "https://fxg.jinritemai.com/login/common?channel=zhaoshang",
+    "https://buyin.jinritemai.com/dashboard/servicehall/*",
+    "https://*.jinritemai.com/*"
+  ]);
+
+  assert.deepEqual(patterns, ["https://fxg.jinritemai.com", "https://buyin.jinritemai.com", "https://*.jinritemai.com"]);
+  assert.equal(isAllowedByOriginPatterns("https://buyin.jinritemai.com/dashboard/servicehall/daren-square", patterns), true);
+  assert.equal(isAllowedByOriginPatterns("https://fxg.jinritemai.com/product", patterns), true);
+  assert.equal(isAllowedByOriginPatterns("https://jinritemai.com/product", patterns), false);
+  assert.equal(isAllowedByOriginPatterns("https://unrelated.example/product", patterns), false);
+  assert.equal(isAllowedByOriginPatterns("file:///tmp/page.html", patterns), false);
+});
+
+test("来源授权只从已选绑定资源提取 URL matcher，并忽略无效协议与异常数据", () => {
+  const origins = originPatternsForBoundResources("https://fxg.jinritemai.com/login/common", [
+    { urlMatchers: ["https://buyin.jinritemai.com/dashboard/servicehall/*", "mailto:user@example.com", "https://user:secret@evil.example/*"] },
+    { urlMatchers: "https://untrusted.example/*" },
+    {}
+  ]);
+  assert.deepEqual(origins, ["https://fxg.jinritemai.com", "https://buyin.jinritemai.com"]);
+  assert.equal(isAllowedByOriginPatterns("https://untrusted.example/", origins), false);
+});
diff --git a/apps/aicrm-desktop/src/main/script-runtime-origin-policy.ts b/apps/aicrm-desktop/src/main/script-runtime-origin-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..90bdf522fe490bcf99dec974045d8f89b7ca252c
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/script-runtime-origin-policy.ts
@@ -0,0 +1,84 @@
+const HTTP_URL_PATTERN = /^(https?):\/\/([^/?#]+)(?:[/?#].*)?$/i;
+
+/** 从受信绑定 URL matcher 中提取来源规则；只接受完整 HTTP(S) URL。 */
+export function normalizeOriginPattern(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const normalized = value.trim();
+
+  const match = HTTP_URL_PATTERN.exec(normalized);
+  if (!match) return null;
+  const scheme = match[1].toLowerCase();
+  const authority = match[2];
+  if (!authority || authority.includes("@") || /[\s\\]/.test(authority)) return null;
+
+  try {
+    if (!authority.includes("*")) {
+      const parsed = new URL(`${scheme}://${authority}`);
+      if (parsed.username || parsed.password) return null;
+      return parsed.origin;
+    }
+
+    // 使用临时合法标签让 WHATWG URL 解析器规范化主机名和端口，
+    // 再将标签还原为通配符；通配符只允许出现在主机名中。
+    if ((authority.match(/\*/g) ?? []).length !== 1 || !/^\*(?:\.|:|$)/.test(authority)) return null;
+    const marker = "kww-origin-wildcard";
+    if (authority.toLowerCase().includes(marker)) return null;
+    const parsed = new URL(`${scheme}://${authority.replaceAll("*", marker)}`);
+    if (parsed.username || parsed.password || !parsed.hostname.includes(marker)) return null;
+    const hostname = parsed.hostname.replaceAll(marker, "*").toLowerCase();
+    return `${scheme}://${hostname}${parsed.port ? `:${parsed.port}` : ""}`;
+  } catch {
+    return null;
+  }
+}
+
+export function normalizeOriginPatterns(values: readonly unknown[]): string[] {
+  const result = new Set<string>();
+  for (const value of values) {
+    const pattern = normalizeOriginPattern(value);
+    if (pattern) result.add(pattern);
+  }
+  return [...result];
+}
+
+/** 从实际启用的绑定资源 matcher 派生额外来源；非 HTTP(S) 和格式异常的规则会被忽略。 */
+export function originPatternsForBoundResources(
+  baseUrl: string,
+  bindings: readonly { urlMatchers?: unknown }[],
+): string[] {
+  const values: unknown[] = [baseUrl];
+  for (const binding of bindings) {
+    if (!Array.isArray(binding.urlMatchers)) continue;
+    for (const matcher of binding.urlMatchers) {
+      if (typeof matcher === "string" && matcher.length <= 4096) values.push(matcher);
+    }
+  }
+  return normalizeOriginPatterns(values);
+}
+
+function originPatternRegexSource(pattern: string): string {
+  const escaped = pattern.replace(/[|\\{}()[\]^$+?.]/g, "\\$&").replace(/\*/g, "[^/]*");
+  return `^${escaped}$`;
+}
+
+/** 给主进程与 document_start 注入包装共用的来源匹配语义。 */
+export function isAllowedByOriginPatterns(value: string, originPatterns: readonly string[]): boolean {
+  let origin: string;
+  try {
+    origin = new URL(value).origin;
+  } catch {
+    return false;
+  }
+  return originPatterns.some((pattern) => {
+    try {
+      return new RegExp(originPatternRegexSource(pattern), "i").test(origin);
+    } catch {
+      return false;
+    }
+  });
+}
+
+/** 序列化受信规则，供 CDP document_start 包装在目标页面内再次验权。 */
+export function originPatternRegexSources(originPatterns: readonly string[]): string[] {
+  return originPatterns.map(originPatternRegexSource);
+}
