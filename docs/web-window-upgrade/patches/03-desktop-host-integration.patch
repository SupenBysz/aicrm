--- /dev/null
+++ b/apps/aicrm-desktop/src/main/window-lifecycle.ts
@@ -0,0 +1,32 @@
+import { app, BrowserWindow } from "electron";
+
+let rootWindow: BrowserWindow | null = null;
+let hooksInstalled = false;
+
+/** 注册客户端唯一根窗口，并在其关闭后清理全部子窗口。 */
+export function registerRootWindow(window: BrowserWindow): void {
+  rootWindow = window;
+  installHooks();
+  window.once("closed", () => {
+    if (rootWindow === window) rootWindow = null;
+    closeAllChildWindows();
+  });
+}
+
+/** 主进程退出前强制销毁所有子窗口，覆盖隐藏窗口和拦截 close 的窗口。 */
+export function closeAllChildWindows(): void {
+  for (const window of BrowserWindow.getAllWindows()) {
+    if (window === rootWindow || window.isDestroyed()) continue;
+    try {
+      window.destroy();
+    } catch (error) {
+      console.warn("客户端子窗口关闭失败", error);
+    }
+  }
+}
+
+function installHooks(): void {
+  if (hooksInstalled) return;
+  hooksInstalled = true;
+  app.on("before-quit", closeAllChildWindows);
+}
