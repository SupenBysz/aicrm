+  let resumeState: ControlledWebSpaceResumeState | undefined;
+  let resumeInput: MatrixAccountWebSpaceInput = input;
+  let resumeLoginMode = false;
+  let windowClosedForSnapshot = false;
+  let sourceWindowResumed: boolean | undefined;
+  let uploadResult: MatrixAccountLoginSpaceSyncResult | undefined;
+  let failedResult: DesktopCommandResult<MatrixAccountLoginSpaceSyncResult> | undefined;
+  try {
+    emitLoginSpaceSyncProgress(event, input, { phase: "preparing", bytesTransferred: 0, totalBytes: 0 });
+    const browserPartition = webSpacePartition(input);
+    const profile = await ensureLoginSpaceProfile(context.uuid, browserPartition);
+    const partitionSession = electronSession.fromPath(profile.storagePath);
+    const activeWindow = controlledWindows.get(browserPartition);
+    if (activeWindow && !activeWindow.isDestroyed()) {
+      const activeContents = getBusinessWebContents(activeWindow);
+      const activeUrl = activeContents.isDestroyed() ? "" : activeContents.getURL();
+      const openState = controlledWindowOpenInputs.get(browserPartition);
+      resumeInput = openState?.input ?? input;
+      resumeLoginMode = openState?.loginMode ?? false;
+      resumeState = {
