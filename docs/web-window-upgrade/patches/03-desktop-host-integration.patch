+async function syncLoginSpaceSnapshot(
+  event: IpcMainInvokeEvent,
+  input: MatrixAccountLoginSpaceSyncInput
+): Promise<DesktopCommandResult<MatrixAccountLoginSpaceSyncResult>> {
+  const invalid = validateWebSpaceInput(input);
+  if (!invalid.ok) return copyFailure(invalid);
+  if (!input.storeId || !Number.isSafeInteger(input.expectedRevision) || input.expectedRevision < 1) {
+    return fail("validation_error", "登录空间同步参数无效");
+  }
