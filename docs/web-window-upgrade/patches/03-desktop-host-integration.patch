+async function withSessionDebugTarget<T>(
+  session: Session,
+  preferredWindow: BrowserWindow | undefined,
+  operation: (debuggerSession: Debugger) => Promise<T>
+): Promise<T> {
+  const preferredContents = preferredWindow && !preferredWindow.isDestroyed()
+    ? getBusinessWebContents(preferredWindow)
+    : undefined;
+  if (preferredContents && !preferredContents.isDestroyed()) {
+    try {
+      return await runSessionDebugOperation(preferredContents, operation);
+    } catch (error) {
+      // 已打开的 WebContents 可能正被调试工具占用；用同一 Session 的隐藏 about:blank 目标重试。
+      if (error instanceof PortableCookieTransferError) throw error;
+    }
+  }
+
+  const helperWindow = new BrowserWindow({
+    show: false,
+    width: 1,
+    height: 1,
+    webPreferences: {
+      session,
+      contextIsolation: true,
+      nodeIntegration: false,
+      sandbox: true
+    }
+  });
+  try {
+    await withTimeout(helperWindow.loadURL("about:blank"), 5000, "snapshot_cookie_debug_target_timeout");
+    return await runSessionDebugOperation(helperWindow.webContents, operation);
+  } finally {
+    if (!helperWindow.isDestroyed()) helperWindow.destroy();
+  }
+}
+
+async function runSessionDebugOperation<T>(contents: WebContents, operation: (debuggerSession: Debugger) => Promise<T>): Promise<T> {
+  if (contents.isDestroyed()) throw new PortableCookieTransferError("snapshot_cookie_inspection_failed", "浏览器页面已关闭，无法读取 Cookie");
+  const debuggerSession = contents.debugger;
+  const attachedHere = !debuggerSession.isAttached();
+  if (attachedHere) debuggerSession.attach("1.3");
+  try {
+    return await operation(debuggerSession);
+  } finally {
+    if (attachedHere && debuggerSession.isAttached()) debuggerSession.detach();
+  }
+}
+
+async function sendSessionDevToolsCommand<T = { cookies?: unknown }>(
+  debuggerSession: Debugger,
+  method: string,
+  params?: Record<string, unknown>
+): Promise<T> {
+  return withTimeout(
+    debuggerSession.sendCommand(method, params),
+    5000,
+    "snapshot_cookie_debug_command_timeout"
+  ) as Promise<T>;
