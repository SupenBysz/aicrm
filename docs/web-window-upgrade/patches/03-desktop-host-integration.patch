+async function loadWebSpaceBindingContext(input: MatrixAccountWebSpaceInput): Promise<WebSpaceBindingContext | undefined> {
+  if (!input.storeId) return undefined;
+  const session = await loadSession();
+  if (!session?.token) return undefined;
+  try {
+    const config = loadDesktopConfig();
+    const response = await fetch(`${config.apiBaseUrl}/api/v1/shop-management/stores/${encodeURIComponent(input.storeId)}/login-spaces/${encodeURIComponent(input.webSpaceId)}/context`, {
+      headers: { Authorization: `Bearer ${session.token}`, "X-KY-Workspace-Type": input.workspaceType, "X-KY-Workspace-Id": input.workspaceId }
+    });
+    if (!response.ok) return undefined;
+    const envelope = await response.json() as { data?: WebSpaceBindingContext };
+    return envelope.data;
+  } catch {
+    return undefined;
+  }
+}
