@@ -0,0 +1,59 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, readFile, rename, rm, writeFile } from "node:fs/promises";
+import path from "node:path";
+
+export type LoginSpaceLocalLoginStatus = "unknown" | "logging_in" | "logged_in" | "logged_out" | "expired" | "error";
+
+const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const LOCAL_STATE_DIRECTORY = "matrix-account-login-space-local-state";
+
+/**
+ * Records only the script-reported login status on this device. It contains no
+ * cookies, tokens, account identifiers, or other website profile data.
+ */
+export async function recordLoginSpaceLocalStatus(
+  userDataPath: string,
+  spaceUuid: string,
+  loginStatus: LoginSpaceLocalLoginStatus
+): Promise<void> {
+  const filePath = localStatePath(userDataPath, spaceUuid);
+  const directory = path.dirname(filePath);
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  const temporaryPath = `${filePath}.${randomUUID()}.tmp`;
+  try {
+    await writeFile(temporaryPath, JSON.stringify({ version: 1, loginStatus, updatedAt: new Date().toISOString() }), { encoding: "utf8", mode: 0o600, flag: "wx" });
+    await rename(temporaryPath, filePath);
+  } finally {
+    await rm(temporaryPath, { force: true }).catch(() => undefined);
+  }
+}
+
+export async function readLoginSpaceLocalStatus(userDataPath: string, spaceUuid: string): Promise<LoginSpaceLocalLoginStatus | null> {
+  try {
+    const raw = await readFile(localStatePath(userDataPath, spaceUuid), "utf8");
+    if (raw.length > 1024) return null;
+    const value = JSON.parse(raw) as { version?: unknown; loginStatus?: unknown };
+    if (value.version !== 1 || !isLoginStatus(value.loginStatus)) return null;
+    return value.loginStatus;
+  } catch {
+    return null;
+  }
+}
+
+/** A fresh Chromium profile can contain Preferences and database files before it has a login session. */
+export async function hasLoginSpaceLocalSession(userDataPath: string, spaceUuid: string, cookieCount: number): Promise<boolean> {
+  const loginStatus = await readLoginSpaceLocalStatus(userDataPath, spaceUuid);
+  if (loginStatus !== null) return loginStatus === "logged_in";
+  if (Number.isSafeInteger(cookieCount) && cookieCount > 0) return true;
+  return false;
+}
+
+function localStatePath(userDataPath: string, spaceUuid: string): string {
+  if (!UUID_PATTERN.test(spaceUuid)) throw new Error("登录空间 UUID 无效");
+  const key = createHash("sha256").update(spaceUuid.toLowerCase()).digest("hex");
+  return path.join(path.resolve(userDataPath), LOCAL_STATE_DIRECTORY, `${key}.json`);
+}
+
+function isLoginStatus(value: unknown): value is LoginSpaceLocalLoginStatus {
+  return typeof value === "string" && ["unknown", "logging_in", "logged_in", "logged_out", "expired", "error"].includes(value);
+}
diff --git a/apps/aicrm-desktop/src/main/matrix-account-login-space-profile-store.ts b/apps/aicrm-desktop/src/main/matrix-account-login-space-profile-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e005fde010a5eb879ed8210336cdc58579a8ae3
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/matrix-account-login-space-profile-store.ts
@@ -0,0 +1,333 @@
+import { createHash, randomUUID } from "node:crypto";
+import {
+  copyFile,
+  lstat,
+  mkdir,
+  open,
+  readFile,
+  readdir,
+  rename,
+  rm,
+  writeFile
+} from "node:fs/promises";
+import path from "node:path";
+
+const PROFILE_MANIFEST_VERSION = 1;
+const TRANSIENT_PATH_SEGMENTS = new Set([
+  "crashpad",
+  "logs",
+  "log"
+]);
+const REGENERABLE_FILE_NAMES = new Set([
+  "lock",
+  "singletoncookie",
+  "singletonlock",
+  "singletonsocket",
+  "browsermetrics-spare.pma"
+]);
+
+export interface LoginSpaceProfile {
+  profileId: string;
+  storagePath: string;
+}
+
+export interface LoginSpaceProfileActivation {
+  active: LoginSpaceProfile;
+  previous: LoginSpaceProfile | null;
+}
+
+interface ProfileManifest {
+  version: typeof PROFILE_MANIFEST_VERSION;
+  activeProfileId: string;
+  previousProfileId: string | null;
+  updatedAt: string;
+}
+
+/**
+ * Maintains one versioned Chromium profile chain per server-issued login-space UUID.
+ * A restored profile is promoted to a new immutable directory so Electron never
+ * has an existing Session pointing at a directory being replaced underneath it.
+ */
+export class MatrixAccountLoginSpaceProfileStore {
+  private readonly locks = new Map<string, Promise<void>>();
+  private readonly rootPath: string;
+
+  constructor(rootPath: string) {
+    this.rootPath = path.resolve(rootPath);
+  }
+
+  async getActiveProfile(spaceUuid: string): Promise<LoginSpaceProfile | null> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    return this.withSpaceLock(normalizedUuid, async () => {
+      const manifest = await this.readManifest(normalizedUuid);
+      if (!manifest) return null;
+      const storagePath = this.profilePath(normalizedUuid, manifest.activeProfileId);
+      await assertProfileDirectory(storagePath);
+      return { profileId: manifest.activeProfileId, storagePath };
+    });
+  }
+
+  /** Creates the first per-UUID profile, copying an existing legacy partition if present. */
+  async ensureActiveProfile(spaceUuid: string, legacyStoragePath?: string | null): Promise<LoginSpaceProfile> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    return this.withSpaceLock(normalizedUuid, async () => {
+      const manifest = await this.readManifest(normalizedUuid);
+      if (manifest) {
+        const storagePath = this.profilePath(normalizedUuid, manifest.activeProfileId);
+        await assertProfileDirectory(storagePath);
+        return { profileId: manifest.activeProfileId, storagePath };
+      }
+
+      const profileId = randomUUID();
+      const stagingPath = this.stagingPath(normalizedUuid, profileId);
+      const storagePath = this.profilePath(normalizedUuid, profileId);
+      await mkdir(stagingPath, { recursive: true, mode: 0o700 });
+      try {
+        if (legacyStoragePath) {
+          await copyProfileTree(path.resolve(legacyStoragePath), stagingPath);
+        }
+        await mkdir(path.dirname(storagePath), { recursive: true, mode: 0o700 });
+        await rename(stagingPath, storagePath);
+        await this.writeManifest(normalizedUuid, {
+          version: PROFILE_MANIFEST_VERSION,
+          activeProfileId: profileId,
+          previousProfileId: null,
+          updatedAt: new Date().toISOString()
+        });
+        return { profileId, storagePath };
+      } catch (error) {
+        await rm(stagingPath, { recursive: true, force: true }).catch(() => undefined);
+        await rm(storagePath, { recursive: true, force: true }).catch(() => undefined);
+        throw error;
+      }
+    });
+  }
+
+  async createStagingProfilePath(spaceUuid: string): Promise<string> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    const profileId = randomUUID();
+    const stagingPath = this.stagingPath(normalizedUuid, profileId);
+    await mkdir(stagingPath, { recursive: true, mode: 0o700 });
+    return stagingPath;
+  }
+
+  /** Moves a verified staging tree to an immutable path without changing the active profile pointer. */
+  async prepareStagedProfile(spaceUuid: string, stagingPath: string): Promise<LoginSpaceProfile> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    return this.withSpaceLock(normalizedUuid, async () => {
+      const expectedStagingRoot = path.resolve(this.stagingDirectory(normalizedUuid)) + path.sep;
+      const resolvedStagingPath = path.resolve(stagingPath);
+      if (!resolvedStagingPath.startsWith(expectedStagingRoot)) {
+        throw new Error("登录空间恢复目录不属于该 UUID 的暂存区");
+      }
+      await assertProfileDirectory(resolvedStagingPath);
+
+      const profileId = randomUUID();
+      const storagePath = this.profilePath(normalizedUuid, profileId);
+      await mkdir(path.dirname(storagePath), { recursive: true, mode: 0o700 });
+      await rename(resolvedStagingPath, storagePath);
+      return { profileId, storagePath };
+    });
+  }
+
+  /** Atomically changes the UUID pointer after Electron can open and inspect the new profile. */
+  async activateProfile(
+    spaceUuid: string,
+    profile: LoginSpaceProfile,
+    expectedCurrentProfileId?: string
+  ): Promise<LoginSpaceProfileActivation> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    return this.withSpaceLock(normalizedUuid, async () => {
+      if (!isProfileId(profile.profileId) || path.resolve(profile.storagePath) !== this.profilePath(normalizedUuid, profile.profileId)) {
+        throw new Error("登录空间待启用档案路径无效");
+      }
+      await assertProfileDirectory(profile.storagePath);
+      const current = await this.readManifest(normalizedUuid);
+      if (expectedCurrentProfileId !== undefined && current?.activeProfileId !== expectedCurrentProfileId) {
+        throw new Error("登录空间档案已被其他操作更新，请刷新后重试");
+      }
+      await this.writeManifest(normalizedUuid, {
+        version: PROFILE_MANIFEST_VERSION,
+        activeProfileId: profile.profileId,
+        previousProfileId: current?.activeProfileId ?? null,
+        updatedAt: new Date().toISOString()
+      });
+      return {
+        active: profile,
+        previous: current
+          ? { profileId: current.activeProfileId, storagePath: this.profilePath(normalizedUuid, current.activeProfileId) }
+          : null
+      };
+    });
+  }
+
+  /** Convenience path for a newly created empty profile, such as clearing a space. */
+  async activateStagedProfile(spaceUuid: string, stagingPath: string): Promise<LoginSpaceProfileActivation> {
+    const profile = await this.prepareStagedProfile(spaceUuid, stagingPath);
+    try {
+      return await this.activateProfile(spaceUuid, profile);
+    } catch (error) {
+      await rm(profile.storagePath, { recursive: true, force: true }).catch(() => undefined);
+      throw error;
+    }
+  }
+
+  /** Restores the prior active pointer when creating the new Session or window fails. */
+  async rollbackActivation(spaceUuid: string, failedProfileId: string, previous: LoginSpaceProfile | null): Promise<void> {
+    const normalizedUuid = normalizeSpaceUuid(spaceUuid);
+    return this.withSpaceLock(normalizedUuid, async () => {
+      const current = await this.readManifest(normalizedUuid);
+      if (!current || current.activeProfileId !== failedProfileId) return;
+      if (previous) {
+        await assertProfileDirectory(previous.storagePath);
+        await this.writeManifest(normalizedUuid, {
+          version: PROFILE_MANIFEST_VERSION,
+          activeProfileId: previous.profileId,
+          previousProfileId: failedProfileId,
+          updatedAt: new Date().toISOString()
+        });
+      } else {
+        await rm(this.manifestPath(normalizedUuid), { force: true });
+      }
+    });
+  }
+
+  private async readManifest(spaceUuid: string): Promise<ProfileManifest | null> {
+    try {
+      const raw = await readFile(this.manifestPath(spaceUuid), "utf8");
+      const value = JSON.parse(raw) as Partial<ProfileManifest>;
+      if (
+        value.version !== PROFILE_MANIFEST_VERSION ||
+        !isProfileId(value.activeProfileId) ||
+        !(value.previousProfileId === null || isProfileId(value.previousProfileId)) ||
+        typeof value.updatedAt !== "string"
+      ) {
+        throw new Error("登录空间本机档案指针无效");
+      }
+      return value as ProfileManifest;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return null;
+      throw error;
+    }
+  }
+
+  private async writeManifest(spaceUuid: string, manifest: ProfileManifest): Promise<void> {
+    const filePath = this.manifestPath(spaceUuid);
+    const directory = path.dirname(filePath);
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const temporaryPath = `${filePath}.${randomUUID()}.tmp`;
+    const handle = await open(temporaryPath, "wx", 0o600);
+    try {
+      await handle.writeFile(JSON.stringify(manifest), "utf8");
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+    try {
+      await rename(temporaryPath, filePath);
+      const directoryHandle = await open(directory, "r").catch(() => null);
+      if (directoryHandle) {
+        try { await directoryHandle.sync(); } catch { /* Directory fsync is not supported on every platform. */ }
+        finally { await directoryHandle.close(); }
+      }
+    } finally {
+      await rm(temporaryPath, { force: true }).catch(() => undefined);
+    }
+  }
+
+  private spaceDirectory(spaceUuid: string): string {
+    const key = createHash("sha256").update(spaceUuid).digest("hex");
+    return path.join(this.rootPath, key);
+  }
+
+  private manifestPath(spaceUuid: string): string {
+    return path.join(this.spaceDirectory(spaceUuid), "active.json");
+  }
+
+  private profilesDirectory(spaceUuid: string): string {
+    return path.join(this.spaceDirectory(spaceUuid), "profiles");
+  }
+
+  private stagingDirectory(spaceUuid: string): string {
+    return path.join(this.spaceDirectory(spaceUuid), "staging");
+  }
+
+  private profilePath(spaceUuid: string, profileId: string): string {
+    return path.join(this.profilesDirectory(spaceUuid), profileId);
+  }
+
+  private stagingPath(spaceUuid: string, profileId: string): string {
+    return path.join(this.stagingDirectory(spaceUuid), profileId);
+  }
+
+  private async withSpaceLock<T>(spaceUuid: string, operation: () => Promise<T>): Promise<T> {
+    const key = createHash("sha256").update(spaceUuid).digest("hex");
+    const previous = this.locks.get(key) ?? Promise.resolve();
+    let release!: () => void;
+    const next = new Promise<void>((resolve) => { release = resolve; });
+    const queued = previous.then(() => next);
+    this.locks.set(key, queued);
+    await previous;
+    try {
+      return await operation();
+    } finally {
+      release();
+      if (this.locks.get(key) === queued) this.locks.delete(key);
+    }
+  }
+}
+
+function normalizeSpaceUuid(value: string): string {
+  if (typeof value !== "string" || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)) {
+    throw new TypeError("登录空间 UUID 无效");
+  }
+  return value.toLowerCase();
+}
+
+function isProfileId(value: unknown): value is string {
+  return typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value);
+}
+
+async function assertProfileDirectory(directoryPath: string): Promise<void> {
+  const info = await lstat(directoryPath);
+  if (!info.isDirectory() || info.isSymbolicLink()) throw new Error("登录空间档案目录无效");
+}
+
+async function copyProfileTree(sourcePath: string, targetPath: string): Promise<void> {
+  let rootInfo;
+  try {
+    rootInfo = await lstat(sourcePath);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+    throw error;
+  }
+  if (!rootInfo.isDirectory() || rootInfo.isSymbolicLink()) throw new Error("旧版登录空间目录无效");
+
+  const copyDirectory = async (source: string, target: string, relative: string): Promise<void> => {
+    await mkdir(target, { recursive: true, mode: 0o700 });
+    for (const entry of await readdir(source, { withFileTypes: true })) {
+      const childRelative = relative ? `${relative}/${entry.name}` : entry.name;
+      if (isRegenerableProfilePath(childRelative)) continue;
+      const childSource = path.join(source, entry.name);
+      const childTarget = path.join(target, entry.name);
+      const info = await lstat(childSource);
+      if (info.isSymbolicLink()) continue;
+      if (info.isDirectory()) {
+        await copyDirectory(childSource, childTarget, childRelative);
+      } else if (info.isFile()) {
+        await copyFile(childSource, childTarget);
+      }
+    }
+  };
+
+  await copyDirectory(sourcePath, targetPath, "");
+}
+
+function isRegenerableProfilePath(relativePath: string): boolean {
+  const segments = relativePath.replace(/\\/g, "/").toLowerCase().split("/").filter(Boolean);
+  if (segments.some((segment) => TRANSIENT_PATH_SEGMENTS.has(segment))) return true;
+  const name = segments.at(-1) ?? "";
+  return REGENERABLE_FILE_NAMES.has(name)
+    || name.startsWith("browsermetrics-")
+    || name.endsWith("-shm");
+}
diff --git a/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-diagnostics.ts b/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-diagnostics.ts
