+      // 先刷新并关闭受控窗口，再刷新一次 UUID 档案后打包。
+      await flushPersistentSession(partitionSession);
+      const closed = await closeControlledWindow(activeWindow);
+      if (!closed) {
+        failedResult = fail("web_space_close_failed", "无法暂停登录空间窗口，已取消同步");
+        throw new Error("login_space_window_close_failed");
+      }
+      windowClosedForSnapshot = true;
+      await flushPersistentSession(partitionSession);
+    } else {
+      await flushPersistentSession(partitionSession);
+    }
+    const portableCookies = await readPortableSessionCookies(partitionSession);
+    const sourceStoragePath = requireSessionStoragePath(partitionSession);
+    const profileMeasurement = await sessionVault.inspectPortableStoragePath(sourceStoragePath);
+    archive = await sessionVault.sealPortable({
+      sourceStoragePath,
+      scope: {
+        workspaceType: input.workspaceType,
+        workspaceId: input.workspaceId,
+        storeId: input.storeId,
+        spaceId: input.webSpaceId,
+        platform: input.platform,
+        snapshotVersion: 1
+      },
+      cookies: portableCookies
+    });
+    void writeMatrixAccountDebugLog("login-space-snapshot-sealed", {
+      webSpaceId: input.webSpaceId,
+      profileFileCount: profileMeasurement.files,
+      profileBytes: profileMeasurement.bytes,
