+export function openLoginTestWindow(url: string, sessionToken?: string): boolean {
+  try {
+    const parsed = new URL(url);
+    if (`${parsed.origin}${parsed.pathname}${parsed.search}` !== DOUYIN_LOGIN_TEST_URL) return false;
+    const fragment = new URLSearchParams(parsed.hash.slice(1));
+    const identifier = fragment.get("script") || "DD_LOGIN";
+    const scriptIdentifiers = (fragment.get("scripts") || identifier).split(",").map((value) => value.trim()).filter(Boolean);
+    const publicIdentifiers = (fragment.get("public") || "").split(",").map((value) => value.trim()).filter(Boolean);
+    // 只接受受限格式的业务脚本标识符；资源是否已发布、启用及平台一致
+    // 由服务端 resolver 再次校验，避免通过 URL fragment 绕过资源权限。
+    if (scriptIdentifiers.length === 0 || scriptIdentifiers.some((value) => !/^[A-Z][A-Z0-9_]{0,63}$/.test(value))) {
+      createLoginTestWindow();
+      return true;
+    }
+    // 登录测试入口由受控店铺页面发起；若旧版插件未携带工作区片段，
+    // 使用平台根工作区继续走通用运行时，避免退回无注入的普通窗口。
+    const workspaceType = fragment.get("workspaceType") || "platform";
+    const workspaceId = fragment.get("workspaceId") || "platform_root";
+    const scriptVersion = fragment.get("scriptVersion") || undefined;
+    const styleIdentifier = fragment.get("style") || "DD_LOGIN";
+    const styleVersion = fragment.get("styleVersion") || undefined;
+    const shopAccount = (fragment.get("shopAccount") || "").trim();
+    const storeId = (fragment.get("storeId") || "").trim() || undefined;
+    const platform = (fragment.get("platform") || "douyin").trim() || "douyin";
+    // 登录测试必须验证最新已发布资源；忽略旧版页面片段携带的 active_only，避免继续使用旧缓存。
+    const versionPolicy = "latest_released" as const;
+    console.info("抖店登录测试入口", JSON.stringify({ identifier, workspaceType, workspaceId: workspaceId ? "[present]" : "[missing]" }));
+    if (!["platform", "agency", "enterprise"].includes(workspaceType)) {
+      createLoginTestWindow();
+      return true;
+    }
+    createStyledChildWindow(parsed.toString().split("#", 1)[0], "登陆抖店", { identifier, scriptIdentifiers, publicIdentifiers, scriptVersion, styleIdentifier, styleVersion, versionPolicy, workspaceType: workspaceType as WorkspaceType, workspaceId, sessionToken, shopAccount, platform, storeId });
+    return true;
+  } catch (error) {
+    console.error("Web 专用窗口创建失败", error instanceof Error ? error.stack ?? error.message : "unknown");
+    return false;
+  }
+}
