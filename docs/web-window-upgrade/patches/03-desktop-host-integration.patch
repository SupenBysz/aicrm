+      name: cookie.name,
+      value: cookie.value,
+      domain: cookie.domain,
+      hostOnly: !cookie.domain.startsWith("."),
+      path: cookie.path || "/",
+      secure: cookie.secure,
+      httpOnly: cookie.httpOnly,
+      ...(expirationDate !== undefined ? { expirationDate } : {}),
+      sameSite,
+      ...(partitionKey ? { partitionKey } : {})
+    };
+  });
+}
+
+/** 生成 Storage.setCookies 可接受的 CookieParam；分区键随 Cookie 一同保留。 */
+export function toDevToolsCookieParams(cookies: PortableLoginSpaceCookie[]): DevToolsCookieParam[] {
+  return cookies.map((cookie) => {
+    const host = cookie.domain.replace(/^\.+/, "");
+    if (!host || /[\\/?#@]/.test(host)) {
+      throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "快照包含无效的 Cookie 域名");
+    }
