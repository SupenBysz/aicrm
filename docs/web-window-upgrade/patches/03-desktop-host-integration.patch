+  const context = await loadWebSpaceBindingContext(input);
+  if (!context || !validateWebSpaceBindingContext(context, input)) {
+    return fail("web_space_binding_unavailable", "登录空间不属于当前工作区或店铺，请刷新后重试");
+  }
+  const desktopSession = await loadSession();
+  if (!desktopSession?.token) return fail("session_unavailable", "桌面登录状态已失效，请重新登录");
+  const identity = createLoginSpaceCloudIdentity(input, desktopSession.token);
+  if (!identity) return fail("secure_transport_required", "登录态同步仅允许使用 HTTPS 服务器地址");
+
+  try {
+    const loginStatus = await loadAuthoritativeLoginSpaceStatus(identity);
+    if (loginStatus !== "logged_in") {
+      return fail("login_required", "请先完成登录，再同步登录空间");
+    }
+  } catch (error) {
+    const cloudError = createLoginSpaceCloudSyncError(error);
+    return fail(cloudError.code, cloudError.message);
+  }
+
+  const operationKey = [input.workspaceType, input.workspaceId, input.storeId, input.webSpaceId].join(":");
+  if (loginSpaceSyncInFlight.has(operationKey)) return fail("sync_already_running", "该登录空间正在同步，请稍后再试");
+  loginSpaceSyncInFlight.add(operationKey);
