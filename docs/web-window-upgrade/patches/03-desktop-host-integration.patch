+async function validateRestoredLoginSpacePage(
+  browser: BrowserWindow,
+  platform: MatrixAccountWebSpaceInput["platform"]
+): Promise<LoginSpaceRestoreLoginValidationResult> {
+  const contents = getBusinessWebContents(browser);
+  if (browser.isDestroyed() || contents.isDestroyed()) return { status: "unknown", reason: "page_not_loaded" };
+
+  const deadline = Date.now() + 12_000;
+  let previousUrl = "";
+  let stableSince = 0;
+  let pageSettled = false;
+  while (Date.now() < deadline && !browser.isDestroyed() && !contents.isDestroyed()) {
+    const currentUrl = contents.getURL();
+    if (/^https?:\/\//i.test(currentUrl)) {
+      try {
+        const readyState = await withTimeout(
+          contents.executeJavaScript("document.readyState", true) as Promise<string>,
+          1200,
+          "restore_page_probe_timeout"
+        );
+        if (readyState === "complete") {
+          if (currentUrl !== previousUrl) {
+            previousUrl = currentUrl;
+            stableSince = Date.now();
+          } else if (Date.now() - stableSince >= 900) {
+            pageSettled = true;
+            break;
+          }
+        } else {
+          previousUrl = currentUrl;
+          stableSince = 0;
+        }
+      } catch {
+        previousUrl = currentUrl;
+        stableSince = 0;
+      }
+    }
+    await delay(250);
+  }
+
+  if (browser.isDestroyed() || contents.isDestroyed()) return { status: "unknown", reason: "page_not_loaded" };
+  if (!pageSettled) return { status: "unknown", reason: "page_not_loaded" };
+  const currentUrl = contents.getURL();
+  try {
+    const probe = await withTimeout(
+      contents.executeJavaScript(`(() => {
+        const visible = (element) => {
+          const rect = element.getBoundingClientRect();
+          const style = getComputedStyle(element);
+          return rect.width > 0 && rect.height > 0 && style.display !== "none" && style.visibility !== "hidden" && Number(style.opacity || 1) > 0;
+        };
+        const inputs = Array.from(document.querySelectorAll("input")).filter(visible);
+        const visiblePasswordInput = inputs.some((input) => input.type === "password" || input.autocomplete === "current-password");
+        const bodyText = (document.body?.innerText || "").slice(0, 8000);
+        const visibleLoginPrompt = /扫码登录|手机(?:号)?登录|账号密码登录|验证码登录|登录后继续|请先登录|重新登录|登录抖店/.test(bodyText);
+        return { readyState: document.readyState, bodyText, visiblePasswordInput, visibleLoginPrompt };
+      })()`, true) as Promise<Omit<LoginSpaceRestorePageProbe, "platform" | "currentUrl">>,
+      2500,
+      "restore_page_probe_timeout"
+    );
+    return classifyLoginSpaceRestorePage({ platform, currentUrl, ...probe });
+  } catch {
+    return { status: "unknown", reason: "page_not_loaded" };
+  }
+}
