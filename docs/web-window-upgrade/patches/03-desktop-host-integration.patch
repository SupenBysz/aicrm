+
+function validateSnapshotMetadata(metadata: SnapshotMetadata): void {
+  validateChunkSize(metadata.chunkSize);
+  if (!Number.isSafeInteger(metadata.snapshotVersion) || metadata.snapshotVersion < 1 || !Number.isSafeInteger(metadata.snapshotRevision) || metadata.snapshotRevision < 1 || !/^[a-f0-9]{64}$/.test(metadata.archiveSha256) || !Number.isSafeInteger(metadata.archiveSize) || metadata.archiveSize <= 0 || metadata.archiveSize > MAX_ARCHIVE_BYTES || !Number.isSafeInteger(metadata.chunkCount) || metadata.chunkCount !== Math.ceil(metadata.archiveSize / metadata.chunkSize)) {
+    throw new LoginSpaceCloudSyncError("snapshot_metadata_invalid", "服务端快照元数据无效");
+  }
