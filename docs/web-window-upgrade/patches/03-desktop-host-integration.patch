+}
+
+function applyLoginSpaceRuntimeConfig(input: MatrixAccountWebSpaceInput, config: LoginSpaceRuntimeConfig, loginMode: boolean): MatrixAccountWebSpaceInput {
+  const shouldInjectBoundResources = loginMode || config.inheritDefaultResources;
+  const scripts = shouldInjectBoundResources ? config.scripts : [];
+  const styles = shouldInjectBoundResources ? config.styles : [];
+  return {
+    ...input,
+    url: config.defaultUrl,
+    scheduleMode: config.scheduleMode,
+    showWebViewDevTools: config.showWebViewDevTools,
+    showWebWindowDevTools: config.showWebWindowDevTools,
+    protocolWhitelist: config.protocolWhitelist,
+    inheritDefaultResources: config.inheritDefaultResources,
+    script: undefined,
+    scriptIdentifiers: undefined,
+    style: undefined,
+    styleIdentifiers: undefined,
+    scriptSelectors: runtimeSelectors(scripts),
+    styleSelectors: runtimeSelectors(styles)
+  };
+}
+
+function runtimeSelectors(items: LoginSpaceRuntimeConfig["scripts"]): MatrixAccountWebSpaceAssetSelector[] {
+  const validRunAt = new Set(["document_start", "dom_content_loaded", "document_idle", "load", "spa_route_change", "user_action"]);
+  return items.map(item => ({
+    identifier: item.identifier,
+    version: item.version,
+    ...(item.runAt && validRunAt.has(item.runAt) ? { runAt: item.runAt as MatrixAccountWebSpaceAssetSelector["runAt"] } : {}),
+    ...(typeof item.sortOrder === "number" ? { priority: item.sortOrder } : {}),
+    matchConfiguredUrlRules: true
+  }));
+}
+
+function loginSpaceRuntimeOriginMatchers(baseUrl: string, config: LoginSpaceRuntimeConfig | undefined, loginMode: boolean): string[] {
+  const shouldInjectBoundResources = loginMode || config?.inheritDefaultResources === true;
+  const bindings = shouldInjectBoundResources && config ? [...config.scripts, ...config.styles] : [];
+  return originPatternsForBoundResources(baseUrl, bindings);
+}
