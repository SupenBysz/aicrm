+  while (offset < size) {
+    const result = await file.read(buffer, offset, size - offset, position + offset);
+    if (result.bytesRead <= 0) {
+      buffer.fill(0);
+      throw new LoginSpaceCloudSyncError("archive_read_failed", "读取加密快照分块失败");
+    }
+    offset += result.bytesRead;
+  }
+  return buffer;
+}
+
+async function writeAll(file: FileHandle, chunk: Buffer, position: number): Promise<void> {
+  let offset = 0;
+  while (offset < chunk.length) {
+    const result = await file.write(chunk, offset, chunk.length - offset, position + offset);
+    if (result.bytesWritten <= 0) throw new LoginSpaceCloudSyncError("archive_write_failed", "写入下载快照分块失败");
+    offset += result.bytesWritten;
+  }
+}
+
+export async function hashDownloadedArchive(archivePath: string): Promise<string> {
+  const file = await open(archivePath, "r");
+  const hash = createHash("sha256");
+  try {
+    const size = (await file.stat()).size;
+    let position = 0;
+    while (position < size) {
+      const chunk = await readExact(file, Math.min(MAX_CHUNK_BYTES, size - position), position);
+      hash.update(chunk);
+      chunk.fill(0);
+      position += Math.min(MAX_CHUNK_BYTES, size - position);
+    }
+    return hash.digest("hex");
+  } finally {
+    await file.close();
+  }
+}
diff --git a/apps/aicrm-desktop/src/main/matrix-account-login-space-local-state.ts b/apps/aicrm-desktop/src/main/matrix-account-login-space-local-state.ts
