+async function loadAuthoritativeLoginSpaceStatus(identity: LoginSpaceCloudIdentity): Promise<string> {
+  const response = await fetch(`${identity.apiBaseUrl.replace(/\/$/, "")}/api/v1/shop-management/stores/${encodeURIComponent(identity.storeId)}/login-spaces`, {
+    headers: {
+      Authorization: `Bearer ${identity.token}`,
+      "X-KY-Workspace-Type": identity.workspaceType,
+      "X-KY-Workspace-Id": identity.workspaceId
+    },
+    cache: "no-store",
+    redirect: "error"
+  });
+  if (!response.ok) {
+    const envelope = await response.json().catch(() => undefined) as { error?: { code?: string; message?: string } } | undefined;
+    throw new LoginSpaceCloudSyncError(
+      response.status === 401 ? "session_unavailable" : envelope?.error?.code || `http_${response.status}`,
+      response.status === 401 ? "桌面登录状态已失效，请重新登录" : envelope?.error?.message || "无法读取登录空间状态"
+    );
+  }
+  const envelope = await response.json() as { data?: { items?: Array<{ id?: string; loginStatus?: string; status?: string }> } };
+  const space = envelope.data?.items?.find((item) => item.id === identity.spaceId);
+  if (!space || space.status !== "active") throw new LoginSpaceCloudSyncError("login_space_not_found", "登录空间不存在或已停用");
+  return space.loginStatus || "unknown";
+}
