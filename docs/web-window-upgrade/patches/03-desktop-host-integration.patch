+import type {
+  DesktopCommandResult,
+  MatrixAccountLoginSpaceLocalState,
+  MatrixAccountWebSpaceLocalDataInput,
+  MatrixAccountWebSpaceLocalDataResult
+} from "../shared/types";
+
+/** Adapts the current Admin Host contract to the UUID-profile inspector IPC. */
+export function adaptLoginSpaceLocalDataResult(
+  input: MatrixAccountWebSpaceLocalDataInput,
+  result: DesktopCommandResult<MatrixAccountLoginSpaceLocalState[]>
+): DesktopCommandResult<MatrixAccountWebSpaceLocalDataResult> {
+  if (!result.ok || !Array.isArray(result.data)) {
+    return {
+      ok: false,
+      error: result.error ?? { code: "local_state_unavailable", message: "无法检查本机登录空间数据" },
+      requestId: result.requestId
+    };
+  }
+
+  const statesBySpaceId = new Map(result.data.map((state) => [state.webSpaceId, state]));
+  return {
+    ok: true,
+    data: {
+      items: input.spaces.map((space) => {
+        const state = statesBySpaceId.get(space.webSpaceId);
+        return {
+          webSpaceId: space.webSpaceId,
+          uuid: space.uuid,
+          status: !state ? "unknown" : state.localDataAvailable ? "has_data" : "no_data"
+        };
+      })
+    },
+    requestId: result.requestId
+  };
+}
