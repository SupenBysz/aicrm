+async function restorePortableSessionCookies(session: Session, cookies: PortableLoginSpaceCookie[]): Promise<void> {
+  // Electron 的 Cookie API 不暴露 Chromium 的 CHIPS 分区键；用 CDP 往返完整属性后再由 Chromium 在目标系统写入本机 Cookie 存储。
+  await session.clearStorageData({ storages: ["cookies"] });
+  const parameters = toDevToolsCookieParams(cookies);
+  await withSessionDebugTarget(session, undefined, async (debuggerSession) => {
+    for (let offset = 0; offset < parameters.length; offset += 200) {
+      const batch = parameters.slice(offset, offset + 200);
+      try {
+        await sendSessionDevToolsCommand(debuggerSession, "Network.setCookies", { cookies: batch });
+      } catch {
+        await sendSessionDevToolsCommand(debuggerSession, "Storage.setCookies", { cookies: batch });
+      }
+    }
+    await session.cookies.flushStore();
+    const restored = await readDevToolsCookies(debuggerSession);
+    const restoredIdentities = new Set(restored.map(portableCookieIdentity));
+    if (cookies.some((cookie) => !restoredIdentities.has(portableCookieIdentity(cookie)))) {
+      throw new SessionVaultError("snapshot_cookie_restore_incomplete", "部分登录 Cookie 或分区键未能写入本机，已取消切换登录空间档案");
+    }
+    void writeMatrixAccountDebugLog("login-space-cookies-restored", {
+      cookieCount: cookies.length,
+      partitionedCookieCount: cookies.filter((cookie) => cookie.partitionKey).length,
+      verifiedCookieCount: restored.length
+    });
+  });
+}
