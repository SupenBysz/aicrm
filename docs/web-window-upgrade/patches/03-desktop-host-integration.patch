@@ -0,0 +1,99 @@
+import { createHash } from "node:crypto";
+import type { MatrixAccountWebSpaceAssetSelector, MatrixAccountWebSpaceInput, MatrixAccountWebSpaceStoreContext } from "../shared/types";
+
+function safePartitionPart(value: string): string {
+  return value.replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, 96);
+}
+
+export function canonicalWebSpacePartition(input: Pick<MatrixAccountWebSpaceInput, "workspaceType" | "workspaceId" | "platform" | "webSpaceId" | "deviceId" | "storeId">): string {
+  const parts = ["persist:matrix-account-space", safePartitionPart(input.workspaceType), safePartitionPart(input.workspaceId), safePartitionPart(input.platform)];
+  parts.push(safePartitionPart(input.webSpaceId), safePartitionPart(input.deviceId || "default"));
+  return parts.join(":");
+}
+
+export function validateWebSpacePartition(input: Pick<MatrixAccountWebSpaceInput, "workspaceType" | "workspaceId" | "platform" | "webSpaceId" | "deviceId" | "storeId">, partition: string | undefined): boolean {
+  return !input.storeId || !partition || partition === canonicalWebSpacePartition(input);
+}
+
+export type WebSpaceBindingContext = { id: string; uuid: string; workspaceType: string; workspaceId: string; storeId: string; platform: string; status: string };
+
+export function validateWebSpaceBindingContext(value: WebSpaceBindingContext, input: MatrixAccountWebSpaceInput): boolean {
+  const normalizedStorePlatform = value.platform.replace(/_shop$/, "");
+  return value.id === input.webSpaceId && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value.uuid) && value.storeId === input.storeId && value.workspaceType === input.workspaceType && value.workspaceId === input.workspaceId && value.status === "active" && (normalizedStorePlatform === input.platform || value.platform === input.platform);
+}
+
+export function validateWebSpaceStoreContext(value: MatrixAccountWebSpaceStoreContext, input: MatrixAccountWebSpaceInput): boolean {
+  if (value.id !== input.storeId || value.workspaceId !== input.workspaceId || value.workspaceType !== input.workspaceType || !value.account || typeof value.hasPassword !== "boolean" || !Number.isInteger(value.revision)) return false;
+  if (typeof value.platform !== "string" || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(value.platform)) return false;
+  const normalizedPlatform = value.platform.replace(/_shop$/, "");
+  return normalizedPlatform === input.platform && !containsSensitiveContextKey(value);
+}
+
+export function validateWebSpaceAssetSelector(value: unknown): value is MatrixAccountWebSpaceAssetSelector {
+  if (!value || typeof value !== "object") return false;
+  const selector = value as MatrixAccountWebSpaceAssetSelector;
+  const validRunAt = selector.runAt === undefined || ["document_start", "dom_content_loaded", "document_idle", "load", "spa_route_change", "user_action"].includes(selector.runAt);
+  return typeof selector.identifier === "string"
+    && /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(selector.identifier)
+    && validRunAt
+    && (selector.version === undefined || /^[0-9]+\.[0-9]+\.[0-9]+$/.test(selector.version))
+    && (selector.priority === undefined || (Number.isInteger(selector.priority) && selector.priority >= -10000 && selector.priority <= 10000))
+    && (selector.enabled === undefined || typeof selector.enabled === "boolean")
+    && (selector.matchConfiguredUrlRules === undefined || typeof selector.matchConfiguredUrlRules === "boolean");
+}
+
+export function containsSensitiveContextKey(value: unknown, depth = 0): boolean {
+  if (depth > 4 || !value || typeof value !== "object") return false;
+  for (const [key, nested] of Object.entries(value as Record<string, unknown>)) {
+    if (key !== "hasPassword" && /password|secret|token|cookie|cipher|credential|session/i.test(key)) return true;
+    if (nested && typeof nested === "object" && containsSensitiveContextKey(nested, depth + 1)) return true;
+  }
+  return false;
+}
+
+const sensitivePlatformKey = /password|secret|token|cookie|cipher|credential|session/i;
+
+/**
+ * Keeps arbitrary platform attributes useful to the controlled page while
+ * enforcing a bounded, JSON-only, credential-free projection.
+ */
+export function sanitizeStorePlatformAttributes(value: unknown): Record<string, unknown> {
+  const clean = sanitizePlatformValue(value, 0);
+  return clean && typeof clean === "object" && !Array.isArray(clean) ? clean as Record<string, unknown> : {};
+}
+
+function sanitizePlatformValue(value: unknown, depth: number): unknown {
+  if (depth > 4 || value === null || value === undefined) return undefined;
+  if (typeof value === "string") return value.length <= 2048 ? value : value.slice(0, 2048);
+  if (typeof value === "number" || typeof value === "boolean") return value;
+  if (Array.isArray(value)) return value.slice(0, 64).map(item => sanitizePlatformValue(item, depth + 1)).filter(item => item !== undefined);
+  if (typeof value !== "object") return undefined;
+  const out: Record<string, unknown> = {};
+  for (const [key, nested] of Object.entries(value as Record<string, unknown>).slice(0, 64)) {
+    if (!key || key === "__proto__" || key === "constructor" || key === "prototype" || sensitivePlatformKey.test(key)) continue;
+    const safe = sanitizePlatformValue(nested, depth + 1);
+    if (safe !== undefined) out[key] = safe;
+  }
+  return out;
+}
+
+export function webSpaceResourceFingerprint(input: Pick<MatrixAccountWebSpaceInput, "storeId" | "workspaceType" | "workspaceId" | "platform" | "script" | "style" | "scriptSelectors" | "styleSelectors" | "scriptIdentifiers" | "styleIdentifiers" | "publicIdentifiers" | "publicStyleIdentifiers" | "versionPolicy" | "scheduleMode" | "inheritDefaultResources">): string {
+  const canonical = {
+    storeId: input.storeId ?? null,
+    workspaceType: input.workspaceType,
+    workspaceId: input.workspaceId,
+    platform: input.platform,
+    script: input.script ?? null,
+    style: input.style ?? null,
+    scriptIdentifiers: [...(input.scriptIdentifiers ?? [])].sort(),
+    styleIdentifiers: [...(input.styleIdentifiers ?? [])].sort(),
+    scriptSelectors: [...(input.scriptSelectors ?? [])].sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b))),
+    styleSelectors: [...(input.styleSelectors ?? [])].sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b))),
+    publicIdentifiers: [...(input.publicIdentifiers ?? [])].sort(),
+    publicStyleIdentifiers: [...(input.publicStyleIdentifiers ?? [])].sort(),
+    versionPolicy: input.versionPolicy ?? "latest_released",
+    scheduleMode: input.scheduleMode ?? "page_first",
+    inheritDefaultResources: input.inheritDefaultResources === true
+  };
+  return createHash("sha256").update(JSON.stringify(canonical), "utf8").digest("hex");
+}
