+++ b/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-diagnostics.ts
@@ -0,0 +1,48 @@
+export type LoginSpaceCloudRestoreStage =
+  | "profile_check"
+  | "staging_profile"
+  | "download_snapshot"
+  | "extract_snapshot"
+  | "inspect_snapshot"
+  | "close_existing_window"
+  | "prepare_profile";
+
+const RESTORE_STAGE_LABELS: Record<LoginSpaceCloudRestoreStage, string> = {
+  profile_check: "检查本机登录空间",
+  staging_profile: "准备本机临时目录",
+  download_snapshot: "下载云端快照",
+  extract_snapshot: "校验并解包快照",
+  inspect_snapshot: "检查恢复数据",
+  close_existing_window: "关闭已有登录窗口",
+  prepare_profile: "准备切换登录空间"
+};
+
+/** 返回适合写入本地诊断日志的错误标识，不包含原始错误消息或敏感路径。 */
+export function inspectLoginSpaceRestoreError(error: unknown): {
+  errorCode: string;
+  errorName: string;
+} {
+  const root = asErrorRecord(error);
+  const cause = asErrorRecord(root?.cause);
+  const code = [root?.code, cause?.code].find(
+    (value): value is string => typeof value === "string" && /^[A-Za-z][A-Za-z0-9_.-]{0,63}$/.test(value)
+  );
+  const name = typeof root?.name === "string" && /^[A-Za-z][A-Za-z0-9_.-]{0,63}$/.test(root.name)
+    ? root.name
+    : "UnknownError";
+
+  return {
+    errorCode: code ?? "UNKNOWN",
+    errorName: name
+  };
+}
+
+export function loginSpaceRestoreStageLabel(stage: LoginSpaceCloudRestoreStage): string {
+  return RESTORE_STAGE_LABELS[stage];
+}
+
+function asErrorRecord(value: unknown): { name?: unknown; code?: unknown; cause?: unknown } | null {
+  return value !== null && typeof value === "object"
+    ? value as { name?: unknown; code?: unknown; cause?: unknown }
+    : null;
+}
diff --git a/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-validation.ts b/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0285f25f0ee8af48c9fd356f82bf57badf3a9281
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/matrix-account-login-space-restore-validation.ts
@@ -0,0 +1,61 @@
+export type LoginSpaceRestoreLoginValidation = "logged_in" | "login_required" | "unknown";
+
+export type LoginSpaceRestoreLoginValidationReason =
+  | "login_form_detected"
+  | "login_route_detected"
+  | "authenticated_page_loaded"
+  | "page_not_loaded"
+  | "ambiguous_page";
+
+export interface LoginSpaceRestorePageProbe {
+  platform: "douyin" | "kuaishou" | "xiaohongshu";
+  currentUrl: string;
+  readyState: string;
+  bodyText: string;
+  visiblePasswordInput: boolean;
+  visibleLoginPrompt: boolean;
+}
+
+export interface LoginSpaceRestoreLoginValidationResult {
+  status: LoginSpaceRestoreLoginValidation;
+  reason: LoginSpaceRestoreLoginValidationReason;
+}
+
+const LOGIN_ROUTE = /(?:^|\/)(?:login|signin|sign-in|passport|auth)(?:\/|$)/i;
+const LOGIN_WORDING = /扫码登录|手机(?:号)?登录|账号密码登录|验证码登录|登录后继续|请先登录|重新登录|登录抖店/;
+const PAGE_LOAD_ERROR = /ERR_(?:NAME_NOT_RESOLVED|CONNECTION|INTERNET_DISCONNECTED|TIMED_OUT)|无法访问此网站|网页无法打开|无法连接到此网站/i;
+
+/**
+ * 只按页面证据判断恢复后的站点状态。Cookie 写入成功只代表档案落盘，不作为登录成功证明。
+ */
+export function classifyLoginSpaceRestorePage(probe: LoginSpaceRestorePageProbe): LoginSpaceRestoreLoginValidationResult {
+  if (!/^https?:\/\//i.test(probe.currentUrl) || probe.readyState !== "complete") {
+    return { status: "unknown", reason: "page_not_loaded" };
+  }
+
+  if (PAGE_LOAD_ERROR.test(probe.bodyText)) {
+    return { status: "unknown", reason: "page_not_loaded" };
+  }
+
+  if (probe.visiblePasswordInput || probe.visibleLoginPrompt || LOGIN_WORDING.test(probe.bodyText)) {
+    return { status: "login_required", reason: "login_form_detected" };
+  }
+
+  let pathname = "";
+  try {
+    const url = new URL(probe.currentUrl);
+    pathname = `${url.pathname}${url.search}`;
+  } catch {
+    return { status: "unknown", reason: "page_not_loaded" };
+  }
+
+  if (LOGIN_ROUTE.test(pathname)) {
+    return { status: "login_required", reason: "login_route_detected" };
+  }
+
+  if (probe.bodyText.trim().length >= 30) {
+    return { status: "logged_in", reason: "authenticated_page_loaded" };
+  }
+
+  return { status: "unknown", reason: "ambiguous_page" };
+}
