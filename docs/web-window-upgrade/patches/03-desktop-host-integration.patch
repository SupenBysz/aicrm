@@ -0,0 +1,320 @@
+import { createHash, randomUUID } from "node:crypto";
+import { open, stat } from "node:fs/promises";
+import type { FileHandle } from "node:fs/promises";
+
+const MAX_ARCHIVE_BYTES = 1024 * 1024 * 1024;
+const MAX_CHUNK_BYTES = 4 * 1024 * 1024;
+
+export type LoginSpaceSyncPhase = "preparing" | "uploading" | "verifying" | "downloading";
+
+export interface LoginSpaceCloudIdentity {
+  apiBaseUrl: string;
+  token: string;
+  workspaceType: "platform" | "agency" | "enterprise";
+  workspaceId: string;
+  storeId: string;
+  spaceId: string;
+}
+
+export interface LoginSpaceCloudProgress {
+  phase: LoginSpaceSyncPhase;
+  bytesTransferred: number;
+  totalBytes: number;
+  operationId?: string;
+}
+
+export interface EncryptedLoginSpaceArchive {
+  archivePath: string;
+  archiveSha256: string;
+  archiveSize: number;
+  dataKey: Buffer;
+  snapshotVersion: number;
+}
+
+export interface LoginSpaceCloudSyncResult {
+  snapshotVersion: number;
+  snapshotRevision: number;
+  archiveSha256: string;
+  archiveSize: number;
+  syncStatus: "synced";
+  alreadySynced?: boolean;
+}
+
+interface Envelope<T> {
+  data?: T;
+  error?: { code?: string; message?: string };
+}
+
+interface UploadOperation {
+  operationId?: string;
+  snapshotVersion: number;
+  snapshotRevision: number;
+  archiveSha256: string;
+  totalSize: number;
+  chunkSize: number;
+  status: string;
+  alreadySynced?: boolean;
+}
+
+interface SnapshotMetadata {
+  snapshotVersion: number;
+  snapshotRevision: number;
+  archiveSha256: string;
+  archiveSize: number;
+  chunkSize: number;
+  chunkCount: number;
+}
+
+/** Uploads a client-encrypted snapshot in bounded chunks and reports monotonic progress. */
+export async function uploadEncryptedLoginSpaceArchive(input: {
+  identity: LoginSpaceCloudIdentity;
+  archive: EncryptedLoginSpaceArchive;
+  expectedRevision: number;
+  onProgress?: (progress: LoginSpaceCloudProgress) => void;
+  fetchImpl?: typeof fetch;
+}): Promise<LoginSpaceCloudSyncResult> {
+  const info = validateTransferInput(input.identity);
+  const archiveStat = await stat(input.archive.archivePath);
+  if (!archiveStat.isFile() || archiveStat.size !== input.archive.archiveSize || archiveStat.size < 1 || archiveStat.size > MAX_ARCHIVE_BYTES || !/^[a-f0-9]{64}$/.test(input.archive.archiveSha256) || input.archive.dataKey.length !== 32) {
+    throw new LoginSpaceCloudSyncError("validation_error", "加密快照的大小、摘要或密钥无效");
+  }
+  if (!Number.isSafeInteger(input.expectedRevision) || input.expectedRevision < 1 || !Number.isSafeInteger(input.archive.snapshotVersion) || input.archive.snapshotVersion < 1) {
+    throw new LoginSpaceCloudSyncError("validation_error", "登录空间版本信息无效");
+  }
+
+  const fetchImpl = input.fetchImpl ?? fetch;
+  const base = loginSpacePath(info);
+  const start = await requestJson<UploadOperation>(fetchImpl, info, `${base}/sync-snapshots`, {
+    method: "POST",
+    headers: { "Idempotency-Key": randomUUID() },
+    body: JSON.stringify({
+      expectedRevision: input.expectedRevision,
+      snapshotVersion: input.archive.snapshotVersion,
+      totalSize: input.archive.archiveSize,
+      archiveSha256: input.archive.archiveSha256,
+      dataKey: input.archive.dataKey.toString("base64")
+    })
+  });
+  validateChunkSize(start.chunkSize);
+
+  if (start.alreadySynced || start.status === "synced") {
+    input.onProgress?.({ phase: "verifying", bytesTransferred: input.archive.archiveSize, totalBytes: input.archive.archiveSize });
+    return {
+      snapshotVersion: start.snapshotVersion,
+      snapshotRevision: start.snapshotRevision,
+      archiveSha256: start.archiveSha256,
+      archiveSize: start.totalSize,
+      syncStatus: "synced",
+      alreadySynced: true
+    };
+  }
+  if (!start.operationId || start.totalSize !== input.archive.archiveSize || start.archiveSha256 !== input.archive.archiveSha256 || start.snapshotVersion !== input.archive.snapshotVersion) {
+    throw new LoginSpaceCloudSyncError("sync_operation_invalid", "服务端返回的同步任务信息与本地快照不一致");
+  }
+
+  const file = await open(input.archive.archivePath, "r");
+  try {
+    const chunkCount = Math.ceil(start.totalSize / start.chunkSize);
+    let bytesTransferred = 0;
+    input.onProgress?.({ phase: "uploading", bytesTransferred, totalBytes: start.totalSize, operationId: start.operationId });
+    for (let index = 0; index < chunkCount; index += 1) {
+      const chunkLength = Math.min(start.chunkSize, start.totalSize - bytesTransferred);
+      const chunk = await readExact(file, chunkLength, bytesTransferred);
+      await requestJson(fetchImpl, info, `${base}/sync-snapshots/${encodeURIComponent(start.operationId)}/chunks/${index}`, {
+        method: "PUT",
+        headers: {
+          "Content-Type": "application/octet-stream",
+          "Content-Length": String(chunk.length)
+        },
+        body: chunk as unknown as BodyInit
+      });
+      bytesTransferred += chunk.length;
+      input.onProgress?.({ phase: "uploading", bytesTransferred, totalBytes: start.totalSize, operationId: start.operationId });
+      chunk.fill(0);
+    }
+  } finally {
+    await file.close();
+  }
+
+  input.onProgress?.({ phase: "verifying", bytesTransferred: input.archive.archiveSize, totalBytes: input.archive.archiveSize, operationId: start.operationId });
+  const completed = await requestJson<LoginSpaceCloudSyncResult>(fetchImpl, info, `${base}/sync-snapshots/${encodeURIComponent(start.operationId)}/complete`, { method: "POST" });
+  if (completed.syncStatus !== "synced" || completed.archiveSha256 !== input.archive.archiveSha256 || completed.archiveSize !== input.archive.archiveSize) {
+    throw new LoginSpaceCloudSyncError("sync_verification_failed", "服务端未确认快照校验成功");
+  }
+  return completed;
+}
+
+/** Downloads a verified ciphertext archive without buffering the complete snapshot in memory. */
+export async function downloadEncryptedLoginSpaceArchive(input: {
+  identity: LoginSpaceCloudIdentity;
+  archivePath: string;
+  onProgress?: (progress: LoginSpaceCloudProgress) => void;
+  fetchImpl?: typeof fetch;
+}): Promise<{ metadata: SnapshotMetadata; dataKey: Buffer } | null> {
+  const info = validateTransferInput(input.identity);
+  const fetchImpl = input.fetchImpl ?? fetch;
+  const base = loginSpacePath(info);
+  let metadata: SnapshotMetadata;
+  try {
+    metadata = await requestJson<SnapshotMetadata>(fetchImpl, info, `${base}/sync-snapshot`, { method: "GET" });
+  } catch (error) {
+    if (error instanceof LoginSpaceCloudSyncError && error.code === "not_found") return null;
+    throw error;
+  }
+  validateSnapshotMetadata(metadata);
+  const keyResult = await requestJson<{ dataKey: string; snapshotVersion: number; snapshotRevision: number }>(fetchImpl, info, `${base}/sync-snapshot/key`, { method: "GET" });
+  if (keyResult.snapshotVersion !== metadata.snapshotVersion || keyResult.snapshotRevision !== metadata.snapshotRevision || typeof keyResult.dataKey !== "string") {
+    throw new LoginSpaceCloudSyncError("snapshot_key_mismatch", "服务端快照密钥与快照版本不匹配");
+  }
+  const dataKey = Buffer.from(keyResult.dataKey, "base64");
+  if (dataKey.length !== 32 || dataKey.toString("base64") !== keyResult.dataKey) {
+    dataKey.fill(0);
+    throw new LoginSpaceCloudSyncError("snapshot_key_invalid", "服务端快照密钥格式无效");
+  }
+
+  const file = await open(input.archivePath, "wx", 0o600);
+  try {
+    let bytesTransferred = 0;
+    input.onProgress?.({ phase: "downloading", bytesTransferred, totalBytes: metadata.archiveSize });
+    for (let index = 0; index < metadata.chunkCount; index += 1) {
+      const response = await fetchImpl(`${info.apiBaseUrl}${base}/sync-snapshot/chunks/${index}`, {
+        method: "GET",
+        headers: requestHeaders(info),
+        redirect: "error",
+        cache: "no-store"
+      });
+      if (!response.ok) throw await responseError(response);
+      const expectedSize = Math.min(metadata.chunkSize, metadata.archiveSize - bytesTransferred);
+      const bytes = Buffer.from(await response.arrayBuffer());
+      if (bytes.length !== expectedSize || response.headers.get("X-Chunk-Index") !== String(index) || response.headers.get("X-Archive-SHA256") !== metadata.archiveSha256) {
+        bytes.fill(0);
+        throw new LoginSpaceCloudSyncError("snapshot_chunk_invalid", "服务端返回的快照分块不完整");
+      }
+      await writeAll(file, bytes, bytesTransferred);
+      bytesTransferred += bytes.length;
+      input.onProgress?.({ phase: "downloading", bytesTransferred, totalBytes: metadata.archiveSize });
+      bytes.fill(0);
+    }
+    await file.sync();
+    if (bytesTransferred !== metadata.archiveSize) throw new LoginSpaceCloudSyncError("snapshot_size_mismatch", "下载快照大小与服务端记录不一致");
+  } catch (error) {
+    await file.close().catch(() => undefined);
+    input.onProgress?.({ phase: "downloading", bytesTransferred: 0, totalBytes: metadata.archiveSize });
+    throw error;
+  }
+  await file.close();
+  return { metadata, dataKey };
+}
+
+export function createLoginSpaceCloudSyncError(error: unknown): LoginSpaceCloudSyncError {
+  if (error instanceof LoginSpaceCloudSyncError) return error;
+  return new LoginSpaceCloudSyncError("sync_failed", "登录空间云端同步失败");
+}
+
+export class LoginSpaceCloudSyncError extends Error {
+  readonly code: string;
+
+  constructor(code: string, message: string) {
+    super(message);
+    this.name = "LoginSpaceCloudSyncError";
+    this.code = code;
+  }
+}
+
+function validateTransferInput(identity: LoginSpaceCloudIdentity): LoginSpaceCloudIdentity {
+  if (!identity.token || !identity.workspaceId || !identity.storeId || !identity.spaceId || !["platform", "agency", "enterprise"].includes(identity.workspaceType)) {
+    throw new LoginSpaceCloudSyncError("validation_error", "登录空间云端同步上下文无效");
+  }
+  let parsed: URL;
+  try { parsed = new URL(identity.apiBaseUrl); } catch { throw new LoginSpaceCloudSyncError("validation_error", "服务器地址无效"); }
+  if (parsed.protocol !== "https:" || parsed.username || parsed.password) {
+    throw new LoginSpaceCloudSyncError("secure_transport_required", "登录态同步仅允许使用 HTTPS 服务器地址");
+  }
+  return { ...identity, apiBaseUrl: parsed.toString().replace(/\/$/, "") };
+}
+
+function loginSpacePath(identity: LoginSpaceCloudIdentity): string {
+  return `/api/v1/shop-management/stores/${encodeURIComponent(identity.storeId)}/login-spaces/${encodeURIComponent(identity.spaceId)}`;
+}
+
+function requestHeaders(identity: LoginSpaceCloudIdentity): Record<string, string> {
+  return {
+    Authorization: `Bearer ${identity.token}`,
+    "X-KY-Workspace-Type": identity.workspaceType,
+    "X-KY-Workspace-Id": identity.workspaceId,
+    "X-KY-Desktop-Call": "web-window-main"
+  };
+}
+
+async function requestJson<T = unknown>(fetchImpl: typeof fetch, identity: LoginSpaceCloudIdentity, path: string, init: RequestInit): Promise<T> {
+  const headers = new Headers(requestHeaders(identity));
+  new Headers(init.headers).forEach((value, key) => headers.set(key, value));
+  if (init.body && typeof init.body === "string" && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
+  const response = await fetchImpl(`${identity.apiBaseUrl}${path}`, { ...init, headers, cache: "no-store", redirect: "error" });
+  if (!response.ok) throw await responseError(response);
+  const envelope = await response.json() as Envelope<T>;
+  if (!envelope || !Object.hasOwn(envelope, "data")) throw new LoginSpaceCloudSyncError("response_invalid", "服务器响应格式无效");
+  return envelope.data as T;
+}
+
+async function responseError(response: Response): Promise<LoginSpaceCloudSyncError> {
+  let envelope: Envelope<unknown> = {};
+  try { envelope = await response.json() as Envelope<unknown>; } catch { /* Keep a generic, non-sensitive error. */ }
+  const code = typeof envelope.error?.code === "string" ? envelope.error.code : `http_${response.status}`;
+  const message = typeof envelope.error?.message === "string" ? envelope.error.message : "服务器拒绝登录空间同步请求";
+  return new LoginSpaceCloudSyncError(code, message);
