@@ -0,0 +1,24 @@
+export interface LoginSpaceWindowCountScope {
+  workspaceType: string;
+  workspaceId: string;
+  storeId: string;
+  uuids: string[];
+}
+
+export interface LoginSpaceWindowRegistryEntry {
+  workspaceType?: string;
+  workspaceId?: string;
+  storeId?: string;
+  uuid?: string;
+  alive: boolean;
+}
+
+export function countActiveLoginSpaceWindows(scope: LoginSpaceWindowCountScope, entries: LoginSpaceWindowRegistryEntry[]): Record<string, number> {
+  const requested = new Set(scope.uuids);
+  const counts = Object.fromEntries(Array.from(requested.values(), uuid => [uuid, 0] as const));
+  for (const entry of entries) {
+    if (!entry.alive || entry.workspaceType !== scope.workspaceType || entry.workspaceId !== scope.workspaceId || entry.storeId !== scope.storeId || !entry.uuid || !requested.has(entry.uuid)) continue;
+    counts[entry.uuid] += 1;
+  }
+  return counts;
+}
diff --git a/apps/aicrm-desktop/src/main/matrix-account-debug-log.ts b/apps/aicrm-desktop/src/main/matrix-account-debug-log.ts
