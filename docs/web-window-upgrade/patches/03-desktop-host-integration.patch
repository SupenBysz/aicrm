+async function applyLoginSpaceSessionConfiguration(browserPartition: string, targetSession: Session, config: LoginSpaceRuntimeConfig): Promise<void> {
+  const protocolWhitelist = normalizeLoginSpaceProtocolWhitelist(config.protocolWhitelist);
+  configureLoginSpaceWebSocketPolicy(targetSession, protocolWhitelist);
+  if (config.userAgent.trim()) targetSession.setUserAgent(config.userAgent.trim(), config.acceptLanguage.trim() || undefined);
+  const proxy = config.proxy;
+  if (proxy.mode === "direct") await targetSession.setProxy({ mode: "direct" });
+  else if (proxy.mode === "system") await targetSession.setProxy({ mode: "system" });
+  else {
+    const proxyRules = `${proxy.protocol}://${proxy.host}:${proxy.port}`;
+    await targetSession.setProxy({ mode: "fixed_servers", proxyRules, proxyBypassRules: (proxy.bypassRules ?? []).join(",") });
+  }
+  if (proxy.username || proxy.password) proxyCredentialsByPartition.set(browserPartition, { username: proxy.username ?? "", password: proxy.password ?? "" });
+  else proxyCredentialsByPartition.delete(browserPartition);
+  proxyPartitionBySession.set(targetSession, browserPartition);
+  if (!proxyLoginListenerRegistered) {
+    app.on("login", (event, webContents, _details, authInfo, callback) => {
+      if (!authInfo.isProxy) return;
+      const partition = proxyPartitionBySession.get(webContents.session);
+      if (!partition) return;
+      const credentials = proxyCredentialsByPartition.get(partition);
+      if (!credentials) return;
+      event.preventDefault();
+      callback(credentials.username, credentials.password);
+    });
+    proxyLoginListenerRegistered = true;
+  }
+}
