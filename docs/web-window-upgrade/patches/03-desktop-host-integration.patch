+      !(cookie.sameSite === "unspecified" || cookie.sameSite === "no_restriction" || cookie.sameSite === "lax" || cookie.sameSite === "strict") ||
+      (cookie.expirationDate !== undefined && (!Number.isFinite(cookie.expirationDate) || cookie.expirationDate <= 0)) ||
+      cookie.domain.length > 253 ||
+      (cookie.sameSite === "no_restriction" && cookie.secure !== true) ||
+      cookie.name.length > 4096 || cookie.value.length > 1024 * 1024 || cookie.path.length > 4096
+    ) {
+      throw new SessionVaultError("snapshot_cookie_state_invalid", "跨设备 Cookie 数据格式无效");
+    }
+    let partitionKey: PortableCookiePartitionKey | undefined;
+    if (cookie.partitionKey !== undefined) {
+      if (schemaVersion < 2) {
+        throw new SessionVaultError("snapshot_cookie_state_invalid", "旧版跨设备 Cookie 数据不能包含分区键");
+      }
+      const value = cookie.partitionKey as Partial<PortableCookiePartitionKey> | null;
+      if (!value || typeof value.topLevelSite !== "string" || typeof value.hasCrossSiteAncestor !== "boolean") {
+        throw new SessionVaultError("snapshot_cookie_state_invalid", "跨设备 Cookie 分区键格式无效");
+      }
+      try {
+        const site = new URL(value.topLevelSite);
+        if ((site.protocol !== "http:" && site.protocol !== "https:") || site.username || site.password) throw new Error("invalid_site");
+      } catch {
+        throw new SessionVaultError("snapshot_cookie_state_invalid", "跨设备 Cookie 分区站点无效");
+      }
+      partitionKey = { topLevelSite: value.topLevelSite, hasCrossSiteAncestor: value.hasCrossSiteAncestor };
+    }
+    return {
+      name: cookie.name,
+      value: cookie.value,
+      domain: cookie.domain,
+      hostOnly: cookie.hostOnly,
+      path: cookie.path || "/",
+      secure: cookie.secure,
+      httpOnly: cookie.httpOnly,
+      ...(cookie.expirationDate !== undefined ? { expirationDate: cookie.expirationDate } : {}),
+      sameSite: cookie.sameSite,
+      ...(partitionKey ? { partitionKey } : {})
+    };
+  });
+}
+
+function parsePortableCookiePayload(buffer: Buffer): PortableLoginSpaceCookie[] {
+  const value = JSON.parse(buffer.toString("utf8")) as { schemaVersion?: unknown; cookies?: unknown };
+  if (value?.schemaVersion !== 1 && value?.schemaVersion !== PORTABLE_COOKIE_STATE_SCHEMA_VERSION) {
+    throw new SessionVaultError("snapshot_cookie_state_invalid", "跨设备 Cookie 数据版本不受支持");
+  }
+  return normalizePortableCookies(value.cookies, Number(value.schemaVersion));
+}
+
+function portableSnapshotAssociatedData(scope: PortableSessionSnapshotScope, schemaVersion = 1): Buffer {
+  return Buffer.from(stableStringify({ format: "kww-login-space-snapshot", schemaVersion, ...scope }), "utf8");
+}
