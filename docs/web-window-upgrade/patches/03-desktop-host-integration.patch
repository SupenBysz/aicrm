+async function loadWebSpacePrivateRuntimeConfig(input: MatrixAccountWebSpaceInput, spaceUuid: string): Promise<LoginSpaceRuntimeConfigLoadResult> {
+  const unavailable = (reason: string): LoginSpaceRuntimeConfigLoadResult => ({ ok: false, reason });
+  if (!input.storeId || !uuidPattern.test(spaceUuid)) return unavailable("invalid_identity");
+  const desktopSession = await loadSession();
+  if (!desktopSession?.token) return unavailable("session_unavailable");
+  let apiUrl: URL;
+  try { apiUrl = new URL(loadDesktopConfig().apiBaseUrl); } catch { return unavailable("invalid_api_url"); }
+  if (apiUrl.protocol !== "https:") return unavailable("https_required");
+  try {
+    const response = await fetch(`${apiUrl.toString().replace(/\/$/, "")}/api/v1/shop-management/stores/${encodeURIComponent(input.storeId)}/login-spaces/${encodeURIComponent(spaceUuid)}/runtime-config`, {
+      headers: { Authorization: `Bearer ${desktopSession.token}`, "X-KY-Workspace-Type": input.workspaceType, "X-KY-Workspace-Id": input.workspaceId, "X-KY-Desktop-Call": "web-window-main" },
+      cache: "no-store",
+      redirect: "error"
+    });
+    if (!response.ok) return unavailable(`http_${response.status}`);
+    let envelope: {
+      data?: {
+        uuid?: string;
+        config?: Partial<LoginSpaceRuntimeConfig> & {
+          userAgentProfile?: { userAgent?: string; acceptLanguage?: string } | null;
+        };
+        proxy?: Partial<LoginSpaceRuntimeConfig["proxy"]>;
+      };
+    };
+    try {
+      envelope = await response.json();
+    } catch {
+      return unavailable("invalid_json");
+    }
+    const runtime = envelope.data;
+    const config = runtime?.config;
+    if (!runtime || !config || runtime.uuid !== spaceUuid) return unavailable("invalid_response_identity");
+    // 服务端将空间私有配置放在 config 中，解密后的代理凭据单独放在 proxy 中。
+    // 新空间尚未配置开关时服务端会返回 null，按 UI 默认关闭处理。
+    const value: Partial<LoginSpaceRuntimeConfig> = {
+      ...config,
+      uuid: runtime.uuid,
+      inheritDefaultResources: config.inheritDefaultResources ?? false,
+      showWebViewDevTools: config.showWebViewDevTools ?? false,
+      showWebWindowDevTools: config.showWebWindowDevTools ?? false,
+      protocolWhitelist: normalizeLoginSpaceProtocolWhitelist(config.protocolWhitelist),
+      userAgent: config.userAgentProfile?.userAgent ?? "",
