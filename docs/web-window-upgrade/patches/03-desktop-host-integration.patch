+
+function validateChunkSize(chunkSize: number): void {
+  if (!Number.isSafeInteger(chunkSize) || chunkSize < 1 || chunkSize > MAX_CHUNK_BYTES) {
+    throw new LoginSpaceCloudSyncError("chunk_size_invalid", "服务端返回的分块大小不受支持");
+  }
