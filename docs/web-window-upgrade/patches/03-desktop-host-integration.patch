index 0000000000000000000000000000000000000000..9285a8d5b0710a731448a719a8d8e5530adf542b
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/login-space-websocket-policy.ts
@@ -0,0 +1,22 @@
+import type { Session } from "electron";
+import { DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST, isLoginSpaceWebSocketAllowed, normalizeLoginSpaceProtocolWhitelist } from "../shared/login-space-protocol-whitelist.ts";
+import type { MatrixAccountWebSpaceProtocolWhitelist } from "../shared/types.ts";
+
+const whitelistBySession = new WeakMap<Session, MatrixAccountWebSpaceProtocolWhitelist>();
+const listenerInstalledForSession = new WeakSet<Session>();
+
+/** 每个 UUID 的专属 Session 只挂一个请求监听器，更新配置时替换该 Session 的规则快照。 */
+export function configureLoginSpaceWebSocketPolicy(
+  targetSession: Session,
+  value?: Partial<MatrixAccountWebSpaceProtocolWhitelist> | null
+): void {
+  whitelistBySession.set(targetSession, normalizeLoginSpaceProtocolWhitelist(value));
+  if (listenerInstalledForSession.has(targetSession)) return;
+
+  // Electron 的同类 webRequest 事件只保留最后一个监听器，因此只在 UUID 专属 Session 上安装一次。
+  targetSession.webRequest.onBeforeRequest({ urls: ["<all_urls>"] }, (details, callback) => {
+    const whitelist = whitelistBySession.get(targetSession) ?? DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST;
+    callback({ cancel: !isLoginSpaceWebSocketAllowed(details.url, details.resourceType, whitelist) });
+  });
+  listenerInstalledForSession.add(targetSession);
+}
