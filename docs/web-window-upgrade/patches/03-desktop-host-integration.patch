diff --git a/apps/aicrm-desktop/src/shared/login-space-protocol-whitelist.ts b/apps/aicrm-desktop/src/shared/login-space-protocol-whitelist.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fa5dfd6a0ec5924d773b1f7164314590310d31d
--- /dev/null
+++ b/apps/aicrm-desktop/src/shared/login-space-protocol-whitelist.ts
@@ -0,0 +1,69 @@
+import type { MatrixAccountWebSpaceProtocolWhitelist } from "./types.ts";
+
+export const DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST: MatrixAccountWebSpaceProtocolWhitelist = {
+  navigation: ["http", "https", "blob", "data"],
+  webSocket: ["ws", "wss"],
+  external: ["mailto"]
+};
+
+const navigationSchemes = new Set(DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST.navigation);
+const webSocketSchemes = new Set(DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST.webSocket);
+const reservedSchemes = new Set(["javascript", "vbscript", "file", "kww-plugin", "kww-offline"]);
+const schemePattern = /^[a-z][a-z0-9+.-]{0,63}$/;
+
+export type LoginSpaceUrlAction = "navigate" | "external" | "blank" | "block";
+
+export function normalizeLoginSpaceProtocolWhitelist(
+  value?: Partial<MatrixAccountWebSpaceProtocolWhitelist> | null
+): MatrixAccountWebSpaceProtocolWhitelist {
+  const normalizeGroup = (group: keyof MatrixAccountWebSpaceProtocolWhitelist): string[] => {
+    const raw = value?.[group];
+    if (!Array.isArray(raw)) return [...DEFAULT_LOGIN_SPACE_PROTOCOL_WHITELIST[group]];
+    const result: string[] = [];
+    for (const item of raw) {
+      if (typeof item !== "string") continue;
+      const protocol = normalizeScheme(item);
+      if (!protocol || reservedSchemes.has(protocol)) continue;
+      if (group === "navigation" && !navigationSchemes.has(protocol)) continue;
+      if (group === "webSocket" && !webSocketSchemes.has(protocol)) continue;
+      if (group === "external" && (navigationSchemes.has(protocol) || webSocketSchemes.has(protocol))) continue;
+      if (!result.includes(protocol)) result.push(protocol);
+    }
+    return result;
+  };
+  return {
+    navigation: normalizeGroup("navigation"),
+    webSocket: normalizeGroup("webSocket"),
+    external: normalizeGroup("external")
+  };
+}
+
+export function getUrlScheme(rawUrl: string): string | null {
+  const match = /^\s*([a-z][a-z0-9+.-]{0,63}):/i.exec(rawUrl);
+  return match?.[1]?.toLowerCase() ?? null;
+}
+
+export function normalizeScheme(raw: string): string | null {
+  let scheme = raw.trim().toLowerCase();
+  if (scheme.endsWith(":")) scheme = scheme.slice(0, -1);
+  return schemePattern.test(scheme) ? scheme : null;
+}
+
+export function classifyLoginSpaceUrl(rawUrl: string, whitelist: MatrixAccountWebSpaceProtocolWhitelist): LoginSpaceUrlAction {
+  if (rawUrl.trim().toLowerCase() === "about:blank") return "blank";
+  const scheme = getUrlScheme(rawUrl);
+  if (!scheme || reservedSchemes.has(scheme)) return "block";
+  if (whitelist.navigation.includes(scheme)) return "navigate";
+  if (whitelist.external.includes(scheme)) return "external";
+  return "block";
+}
+
+export function isLoginSpaceWebSocketAllowed(
+  rawUrl: string,
+  resourceType: string,
+  whitelist: MatrixAccountWebSpaceProtocolWhitelist
+): boolean {
+  if (resourceType !== "webSocket") return true;
+  const scheme = getUrlScheme(rawUrl);
+  return Boolean(scheme && whitelist.webSocket.includes(scheme));
+}
