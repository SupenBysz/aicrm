+    return {
+      name: cookie.name,
+      value: cookie.value,
+      ...(cookie.hostOnly
+        ? { url: `${cookie.secure ? "https" : "http"}://${host}/` }
+        : { domain: cookie.domain }),
+      path: cookie.path || "/",
+      secure: cookie.secure,
+      httpOnly: cookie.httpOnly,
+      ...(cookie.expirationDate !== undefined ? { expires: cookie.expirationDate } : {}),
+      ...(sameSite ? { sameSite } : {}),
+      ...(cookie.partitionKey ? { partitionKey: cookie.partitionKey } : {})
+    };
+  });
+}
+
+export function portableCookieIdentity(cookie: PortableLoginSpaceCookie): string {
+  const partitionKey = cookie.partitionKey
+    ? `${cookie.partitionKey.topLevelSite}\u0000${cookie.partitionKey.hasCrossSiteAncestor ? "1" : "0"}`
+    : "";
+  return [
+    cookie.name,
+    cookie.domain.replace(/^\.+/, ""),
+    cookie.hostOnly ? "host" : "domain",
+    cookie.path || "/",
+    partitionKey,
+    cookie.value
+  ].join("\u0000");
+}
+
+function normalizePartitionKey(value: unknown): PortableCookiePartitionKey | undefined {
+  if (value === undefined || value === null) return undefined;
+  const key = value as Partial<PortableCookiePartitionKey> | null;
+  if (!key || typeof key.topLevelSite !== "string" || typeof key.hasCrossSiteAncestor !== "boolean") {
+    throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "Cookie 分区键格式无效");
+  }
+  let site: URL;
+  try {
+    site = new URL(key.topLevelSite);
+  } catch {
+    throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "Cookie 分区站点无效");
+  }
+  if ((site.protocol !== "http:" && site.protocol !== "https:") || site.username || site.password) {
+    throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "Cookie 分区站点无效");
+  }
+  return { topLevelSite: key.topLevelSite, hasCrossSiteAncestor: key.hasCrossSiteAncestor };
+}
+
+function normalizeSameSite(value: unknown): PortableLoginSpaceCookie["sameSite"] {
+  if (value === "Strict") return "strict";
+  if (value === "Lax") return "lax";
+  if (value === "None") return "no_restriction";
+  return "unspecified";
+}
