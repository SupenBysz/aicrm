+      partitionedCookieCount: portableCookies.filter((cookie) => cookie.partitionKey).length,
+      archiveBytes: archive.archiveSize
+    });
+    uploadResult = await uploadEncryptedLoginSpaceArchive({
+      identity,
+      archive,
+      expectedRevision: input.expectedRevision,
+      onProgress: (progress) => emitLoginSpaceSyncProgress(event, input, progress)
+    });
+  } catch (error) {
+    if (!failedResult) {
+      if (error instanceof PortableCookieTransferError) {
+        failedResult = fail(error.code, error.message);
+      } else {
+        const cloudError = createLoginSpaceCloudSyncError(error);
