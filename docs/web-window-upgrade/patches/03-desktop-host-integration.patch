new file mode 100644
index 0000000000000000000000000000000000000000..c0345c1757a5383e75d587d05aaa27082386d0d9
--- /dev/null
+++ b/apps/aicrm-desktop/src/main/async-timeout.ts
@@ -0,0 +1,13 @@
+/** 为可能永久等待的异步操作设置上限；超时不会取消底层操作。 */
+export function withTimeout<T>(operation: PromiseLike<T>, timeoutMs: number, errorCode: string): Promise<T> {
+  const safeTimeoutMs = Number.isFinite(timeoutMs) ? Math.max(1, Math.floor(timeoutMs)) : 1;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  return Promise.race([
+    Promise.resolve(operation),
+    new Promise<T>((_resolve, reject) => {
+      timer = setTimeout(() => reject(new Error(errorCode)), safeTimeoutMs);
+    })
+  ]).finally(() => {
+    if (timer) clearTimeout(timer);
+  });
+}
