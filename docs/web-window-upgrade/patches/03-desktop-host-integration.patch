+async function readDevToolsCookies(debuggerSession: Debugger): Promise<PortableLoginSpaceCookie[]> {
+  let result: { cookies?: unknown };
+  try {
+    result = await sendSessionDevToolsCommand(debuggerSession, "Network.getAllCookies");
+  } catch {
+    result = await sendSessionDevToolsCommand(debuggerSession, "Storage.getCookies");
+  }
+  if (!Array.isArray(result.cookies)) {
+    throw new PortableCookieTransferError("snapshot_cookie_inspection_failed", "无法校验本机 Cookie 清单");
+  }
+  return fromDevToolsCookies(result.cookies);
+}
