+export function fromDevToolsCookies(value: unknown): PortableLoginSpaceCookie[] {
+  if (!Array.isArray(value) || value.length > 50_000) {
+    throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "浏览器 Cookie 数据数量无效");
+  }
+
+  return value.map((item) => {
+    const cookie = item as DevToolsCookie | null;
+    if (
+      !cookie ||
+      typeof cookie.name !== "string" ||
+      typeof cookie.value !== "string" ||
+      typeof cookie.domain !== "string" ||
+      typeof cookie.path !== "string" ||
+      typeof cookie.secure !== "boolean" ||
+      typeof cookie.httpOnly !== "boolean"
+    ) {
+      throw new PortableCookieTransferError("snapshot_cookie_state_invalid", "浏览器 Cookie 数据格式无效");
+    }
