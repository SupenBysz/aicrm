--- /dev/null
+++ b/apps/aicrm-desktop/src/main/matrix-account-debug-log.ts
@@ -0,0 +1,30 @@
+import { appendFile, chmod, mkdir, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { app } from "electron";
+
+const MAX_LOG_BYTES = 5 * 1024 * 1024;
+
+/** 将不含登录凭据的登录空间诊断记录保存在各平台实际 userData 目录中。 */
+export async function writeMatrixAccountDebugLog(event: string, payload: unknown): Promise<void> {
+  try {
+    const logPath = path.join(app.getPath("userData"), "logs", "aicrm-matrix-space-debug.log");
+    const line = `${JSON.stringify({ at: new Date().toISOString(), event, payload }).slice(0, 20000)}\n`;
+    const directory = path.dirname(logPath);
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    let resetLog = false;
+    try {
+      const info = await stat(logPath);
+      resetLog = info.size + Buffer.byteLength(line, "utf8") > MAX_LOG_BYTES;
+    } catch {
+      resetLog = false;
+    }
+    if (resetLog) {
+      await writeFile(logPath, line, { encoding: "utf8", mode: 0o600 });
+    } else {
+      await appendFile(logPath, line, { encoding: "utf8", mode: 0o600 });
+    }
+    await chmod(logPath, 0o600);
+  } catch {
+    // 本地诊断日志不能阻断登录空间打开、同步或恢复。
+  }
+}
