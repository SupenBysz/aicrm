+import { useState } from "react";
+import { Button, Input, Space, Tag, Typography } from "antd";
+import type { ShopLoginSpaceProtocolWhitelist } from "./api";
+import {
+  DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST,
+  normalizeShopLoginSpaceProtocolWhitelist,
+  validateLoginSpaceProtocolAddition,
+  type LoginSpaceProtocolGroup
+} from "./login-space-protocol-whitelist";
+
+const groupDefinitions: Array<{ key: LoginSpaceProtocolGroup; title: string; description: string }> = [
+  { key: "navigation", title: "页面与内嵌内容", description: "在当前 WebView 内处理；http/https 仍受现有页面域名规则约束。" },
+  { key: "webSocket", title: "WebSocket 连接", description: "只允许对应登录空间建立这些协议的网络连接。" },
+  { key: "external", title: "外部应用", description: "交由系统默认应用处理；设备未配置处理程序时，系统仍可能提示。" }
+];
+
+export { normalizeShopLoginSpaceProtocolWhitelist } from "./login-space-protocol-whitelist";
+
+export function LoginSpaceProtocolWhitelistEditor(props: {
+  value?: Partial<ShopLoginSpaceProtocolWhitelist> | null;
+  disabled?: boolean;
+  onChange: (value: ShopLoginSpaceProtocolWhitelist) => void;
+}) {
+  const [drafts, setDrafts] = useState<Record<LoginSpaceProtocolGroup, string>>({ navigation: "", webSocket: "", external: "" });
+  const [errors, setErrors] = useState<Partial<Record<LoginSpaceProtocolGroup, string>>>({});
+  const value = normalizeShopLoginSpaceProtocolWhitelist(props.value);
+
+  const changeGroup = (group: LoginSpaceProtocolGroup, values: string[]) => {
+    props.onChange({ ...value, [group]: values });
+  };
+
+  const addProtocol = (group: LoginSpaceProtocolGroup) => {
+    const fail = (reason: string) => setErrors(current => ({ ...current, [group]: reason }));
+    const result = validateLoginSpaceProtocolAddition(group, drafts[group], value);
+    if ("error" in result) return fail(result.error);
+    changeGroup(group, [...value[group], result.protocol]);
+    setDrafts(current => ({ ...current, [group]: "" }));
+    setErrors(current => ({ ...current, [group]: undefined }));
+  };
+
+  return <Space direction="vertical" size={10} style={{ width: "100%" }}>
+    <Space style={{ width: "100%", justifyContent: "space-between" }}>
+      <Typography.Text strong>协议白名单</Typography.Text>
+      <Button size="small" disabled={props.disabled} onClick={() => { props.onChange({ navigation: [...DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST.navigation], webSocket: [...DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST.webSocket], external: [...DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST.external] }); setErrors({}); }}>恢复默认</Button>
+    </Space>
+    {groupDefinitions.map(group => <div key={group.key} style={{ border: "1px solid var(--ant-color-border-secondary)", borderRadius: 8, padding: 10 }}>
+      <Space direction="vertical" size={6} style={{ width: "100%" }}>
+        <Typography.Text strong>{group.title}</Typography.Text>
+        <Typography.Text type="secondary">{group.description}</Typography.Text>
+        <Space size={[4, 4]} wrap>
+          {value[group.key].length ? value[group.key].map(protocol => <Tag key={protocol} closable={!props.disabled} onClose={event => { event.preventDefault(); changeGroup(group.key, value[group.key].filter(item => item !== protocol)); }}>{protocol}</Tag>) : <Typography.Text type="secondary">未允许任何协议</Typography.Text>}
+        </Space>
+        <Space.Compact style={{ width: "100%" }}>
+          <Input value={drafts[group.key]} disabled={props.disabled} placeholder={group.key === "external" ? "添加外部应用协议，例如 weixin" : `添加协议（${group.key === "navigation" ? "http、https、blob、data" : "ws、wss"}）` } onChange={event => setDrafts(current => ({ ...current, [group.key]: event.target.value }))} onPressEnter={() => addProtocol(group.key)} />
+          <Button disabled={props.disabled} onClick={() => addProtocol(group.key)}>添加</Button>
+        </Space.Compact>
+        {errors[group.key] ? <Typography.Text type="danger">{errors[group.key]}</Typography.Text> : null}
+      </Space>
+    </div>)}
+  </Space>;
+}
diff --git a/plugins/ky-shop-management/src/login-space-protocol-whitelist.ts b/plugins/ky-shop-management/src/login-space-protocol-whitelist.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cd81fa15cc67331c8faac6a0bb2a9dd6d957e88
--- /dev/null
+++ b/plugins/ky-shop-management/src/login-space-protocol-whitelist.ts
@@ -0,0 +1,63 @@
+import type { ShopLoginSpaceProtocolWhitelist } from "./api";
+
+export type LoginSpaceProtocolGroup = keyof ShopLoginSpaceProtocolWhitelist;
+
+export const DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST: ShopLoginSpaceProtocolWhitelist = {
+  navigation: ["http", "https", "blob", "data"],
+  webSocket: ["ws", "wss"],
+  external: ["mailto"]
+};
+
+const navigationSchemes = new Set(DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST.navigation);
+const webSocketSchemes = new Set(DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST.webSocket);
+const blockedSchemes = new Set(["javascript", "vbscript", "file", "kww-plugin", "kww-offline"]);
+const schemePattern = /^[a-z][a-z0-9+.-]{0,63}$/;
+
+export function normalizeShopLoginSpaceProtocolWhitelist(
+  value?: Partial<ShopLoginSpaceProtocolWhitelist> | null
+): ShopLoginSpaceProtocolWhitelist {
+  const normalizeGroup = (group: LoginSpaceProtocolGroup): string[] => {
+    const raw = value?.[group];
+    if (!Array.isArray(raw)) return [...DEFAULT_SHOP_LOGIN_SPACE_PROTOCOL_WHITELIST[group]];
+    const allowed = new Set<string>();
+    const result: string[] = [];
+    for (const item of raw) {
+      if (typeof item !== "string") continue;
+      const protocol = normalizeProtocolName(item);
+      if (!protocol || blockedSchemes.has(protocol)) continue;
+      if (group === "navigation" && !navigationSchemes.has(protocol)) continue;
+      if (group === "webSocket" && !webSocketSchemes.has(protocol)) continue;
+      if (group === "external" && (navigationSchemes.has(protocol) || webSocketSchemes.has(protocol))) continue;
+      if (allowed.has(protocol)) continue;
+      allowed.add(protocol);
+      result.push(protocol);
+    }
+    return result;
+  };
+  return {
+    navigation: normalizeGroup("navigation"),
+    webSocket: normalizeGroup("webSocket"),
+    external: normalizeGroup("external")
+  };
+}
+
+export function normalizeProtocolName(value: string): string | null {
+  let protocol = value.trim().toLowerCase();
+  if (protocol.endsWith(":")) protocol = protocol.slice(0, -1);
+  return schemePattern.test(protocol) ? protocol : null;
+}
+
+export function validateLoginSpaceProtocolAddition(
+  group: LoginSpaceProtocolGroup,
+  raw: string,
+  whitelist: ShopLoginSpaceProtocolWhitelist
+): { protocol: string } | { error: string } {
+  const protocol = normalizeProtocolName(raw);
+  if (!protocol) return { error: "协议格式无效，请输入协议名，例如 weixin。" };
+  if (blockedSchemes.has(protocol)) return { error: "该协议属于禁用或应用内部协议，不能加入白名单。" };
+  if (group === "navigation" && !navigationSchemes.has(protocol)) return { error: "此分组仅支持 http、https、blob、data。" };
+  if (group === "webSocket" && !webSocketSchemes.has(protocol)) return { error: "此分组仅支持 ws、wss。" };
+  if (group === "external" && (navigationSchemes.has(protocol) || webSocketSchemes.has(protocol))) return { error: "该协议属于页面或 WebSocket 分组。" };
+  if (Object.values(whitelist).some(items => items.includes(protocol))) return { error: "该协议已在白名单中。" };
+  return { protocol };
+}
diff --git a/plugins/ky-shop-management/src/login-space-refresh.ts b/plugins/ky-shop-management/src/login-space-refresh.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e54800cec6b3316513780171d52529184bb08e9a
--- /dev/null
+++ b/plugins/ky-shop-management/src/login-space-refresh.ts
@@ -0,0 +1,72 @@
+import type { ShopLoginSpace } from "./api";
+
+export const LOGIN_SPACE_LIST_REFRESH_INTERVAL_MS = 2_500;
+
+export type LoginSpaceInfoUpdate = {
+  storeId: string;
+  uuid: string;
+  displayName?: string;
+  loginStatus?: ShopLoginSpace["loginStatus"];
+  loginStatusUpdatedAt?: string | null;
+  updatedAt: string;
+  revision: number;
+};
+
+/** Keep the server list as the source for identity/login/snapshot fields. */
+export function mapRefreshedLoginSpaces(items: ShopLoginSpace[]): ShopLoginSpace[] {
+  return items.map(item => ({
+    ...item,
+    displayName: item.displayName ?? null,
+    loginStatus: item.loginStatus ?? "unknown",
+    syncStatus: item.syncStatus ?? "not_synced"
+  }));
+}
+
+/** Keep pushed SDK updates over a list response that began before the PATCH completed. */
+export function mergeLoginSpaceInfoUpdates(items: ShopLoginSpace[], updates: Map<string, LoginSpaceInfoUpdate>): ShopLoginSpace[] {
+  return items.map(item => {
+    const update = updates.get(item.uuid);
+    if (!update || update.storeId !== item.storeId) return item;
+    if (item.revision >= update.revision) {
+      updates.delete(item.uuid);
+      return item;
+    }
+    return {
+      ...item,
+      ...(update.displayName !== undefined ? { displayName: update.displayName } : {}),
+      ...(update.loginStatus !== undefined ? { loginStatus: update.loginStatus } : {}),
+      ...(update.loginStatusUpdatedAt !== undefined ? { loginStatusUpdatedAt: update.loginStatusUpdatedAt } : {}),
+      updatedAt: update.updatedAt,
+      revision: update.revision
+    };
+  });
+}
+
+export function applyLoginSpaceInfoUpdate(items: ShopLoginSpace[], update: LoginSpaceInfoUpdate): ShopLoginSpace[] {
+  return items.map(item => item.uuid !== update.uuid || item.storeId !== update.storeId || item.revision > update.revision ? item : {
+    ...item,
+    ...(update.displayName !== undefined ? { displayName: update.displayName } : {}),
+    ...(update.loginStatus !== undefined ? { loginStatus: update.loginStatus } : {}),
+    ...(update.loginStatusUpdatedAt !== undefined ? { loginStatusUpdatedAt: update.loginStatusUpdatedAt } : {}),
+    updatedAt: update.updatedAt,
+    revision: update.revision
+  });
+}
+
+/** A tiny single-flight gate prevents manual and timer refreshes overlapping. */
+export function createLoginSpaceRefreshGate() {
+  let running = false;
+  return {
+    get running() { return running; },
+    async run(task: () => Promise<void>): Promise<boolean> {
+      if (running) return false;
+      running = true;
+      try {
+        await task();
+        return true;
+      } finally {
+        running = false;
+      }
+    }
+  };
+}
diff --git a/plugins/ky-shop-management/src/login-space-resources.ts b/plugins/ky-shop-management/src/login-space-resources.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62928375e42f28ed1393aaf7923ea3c73cfb0127
--- /dev/null
+++ b/plugins/ky-shop-management/src/login-space-resources.ts
@@ -0,0 +1,177 @@
+import type { ShopLoginSpaceBinding, ShopLoginSpaceBindingOption, ShopLoginSpaceBindingUpdate, ShopLoginSpaceConfig, ShopLoginSpaceVersionPolicy } from "./api";
+
+export type LoginSpaceOpenMode = "new" | "reuse";
+
+export type LoginSpaceRuntimeInput = {
+  scriptSelectors: Array<{ identifier: string; version: string; runAt: ShopLoginSpaceBinding["runAt"]; priority: number; matchConfiguredUrlRules: true }>;
+  styleSelectors: Array<{ identifier: string; version: string; runAt: ShopLoginSpaceBinding["runAt"]; priority: number; matchConfiguredUrlRules: true }>;
+};
+
+export function isLoginSpaceCreationReady(input: { storeReady: boolean; workspaceReady: boolean; spacesLoading: boolean; configReady: boolean }): boolean {
+  return input.storeReady && input.workspaceReady && !input.spacesLoading && input.configReady;
+}
+
+/**
+ * Return the user-facing login-space name, cleaning up only the exact legacy
+ * default generated as "<store name or account> 登录空间". Custom names remain
+ * untouched, and this presentation helper never changes the persisted record.
+ */
+export function getLoginSpaceDisplayName(displayName: string | null | undefined, storeName: string | null | undefined, account: string | null | undefined): string {
+  if (!displayName) return "未命名空间";
+  const storeLabel = storeName || account || "";
+  if (storeLabel && displayName === `${storeLabel} 登录空间`) return storeLabel;
+  return displayName;
+}
+
+export interface LoginSpacePreferenceStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem?(key: string): void;
+}
+
+export type LoginSpacePreferences = {
+  showWebViewDevTools: boolean;
+  showWebWindowDevTools: boolean;
+};
+
+const defaultLoginSpacePreferences: LoginSpacePreferences = {
+  showWebViewDevTools: false,
+  showWebWindowDevTools: false
+};
+
+const preferenceKey = (storeId: string) => `ky.web-space.${storeId}.preferences`;
+const inheritDefaultResourcesKey = (storeId: string) => `ky.web-space.${storeId}.inherit-default-resources`;
+const legacyWebViewDevToolsKey = (storeId: string) => `ky.web-space.${storeId}.webview-devtools`;
+const legacyHostDevToolsKey = (storeId: string) => `ky.web-space.${storeId}.host-devtools`;
+
+export function readLoginSpacePreferences(storage: LoginSpacePreferenceStorage | null | undefined, storeId: string): LoginSpacePreferences {
+  if (!storage || !storeId) return { ...defaultLoginSpacePreferences };
+  try {
+    const raw = storage.getItem(preferenceKey(storeId));
+    if (!raw) {
+      return {
+        showWebViewDevTools: storage.getItem(legacyWebViewDevToolsKey(storeId)) === "1",
+        showWebWindowDevTools: storage.getItem(legacyHostDevToolsKey(storeId)) === "1"
+      };
+    }
+    const value = JSON.parse(raw) as Partial<LoginSpacePreferences>;
+    return {
+      showWebViewDevTools: value.showWebViewDevTools === true,
+      showWebWindowDevTools: value.showWebWindowDevTools === true
+    };
+  } catch {
+    return { ...defaultLoginSpacePreferences };
+  }
+}
+
+export function writeLoginSpacePreferences(storage: LoginSpacePreferenceStorage | null | undefined, storeId: string, value: LoginSpacePreferences): boolean {
+  if (!storage || !storeId) return false;
+  try {
+    storage.setItem(preferenceKey(storeId), JSON.stringify({
+      showWebViewDevTools: value.showWebViewDevTools === true,
+      showWebWindowDevTools: value.showWebWindowDevTools === true
+    }));
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function getInheritDefaultResourcesPreference(storage: LoginSpacePreferenceStorage, storeId: string): boolean {
+  return storage.getItem(inheritDefaultResourcesKey(storeId)) === "1";
+}
+
+export function setInheritDefaultResourcesPreference(storage: LoginSpacePreferenceStorage, storeId: string, enabled: boolean): void {
+  storage.setItem(inheritDefaultResourcesKey(storeId), enabled ? "1" : "0");
+}
+
+/** Import only values absent from the server, so already-synced values always win. */
+export function importLegacyLoginSpacePreferences(config: ShopLoginSpaceConfig, storage: LoginSpacePreferenceStorage | null | undefined, storeId: string): ShopLoginSpaceConfig {
+  const developerTools = readLoginSpacePreferences(storage, storeId);
+  return {
+    ...config,
+    inheritDefaultResources: config.inheritDefaultResources ?? getInheritDefaultResourcesPreference(storage ?? { getItem: () => null, setItem: () => undefined }, storeId),
+    showWebViewDevTools: config.showWebViewDevTools ?? developerTools.showWebViewDevTools,
+    showWebWindowDevTools: config.showWebWindowDevTools ?? developerTools.showWebWindowDevTools
+  };
+}
+
+export function hasUninitializedLoginSpacePreferences(config: ShopLoginSpaceConfig): boolean {
+  return config.inheritDefaultResources == null || config.showWebViewDevTools == null || config.showWebWindowDevTools == null;
+}
+
+/** Remove the old local source only after the server acknowledges the imported values. */
+export function clearLegacyLoginSpacePreferences(storage: LoginSpacePreferenceStorage | null | undefined, storeId: string): void {
+  if (!storage?.removeItem || !storeId) return;
+  storage.removeItem(preferenceKey(storeId));
+  storage.removeItem(inheritDefaultResourcesKey(storeId));
+  storage.removeItem(legacyWebViewDevToolsKey(storeId));
+  storage.removeItem(legacyHostDevToolsKey(storeId));
+}
+
+export function replaceSelectedLoginSpaceBindings(current: ShopLoginSpaceBinding[], identifiers: string[], options: ShopLoginSpaceBindingOption[]): ShopLoginSpaceBinding[] {
+  const currentByIdentifier = new Map(current.map(binding => [binding.identifier, binding]));
+  return identifiers.flatMap(identifier => {
+    const existing = currentByIdentifier.get(identifier);
+    if (existing) return [existing];
+    const option = options.find(item => item.key === identifier);
+    return option ? [{ ...option.binding, versionPolicy: "latest_released" as const }] : [];
+  });
+}
+
+export function updateLoginSpaceBindingPolicy(bindings: ShopLoginSpaceBinding[], identifier: string, versionPolicy: ShopLoginSpaceVersionPolicy): ShopLoginSpaceBinding[] {
+  return bindings.map(binding => binding.identifier === identifier ? { ...binding, versionPolicy, available: undefined, error: undefined } : binding);
+}
+
+export function pinLoginSpaceBindingVersion(bindings: ShopLoginSpaceBinding[], identifier: string, versionId: string, options: ShopLoginSpaceBindingOption[]): ShopLoginSpaceBinding[] {
+  const option = options.find(item => item.key === identifier);
+  const selected = option?.versions.find(item => item.versionId === versionId);
+  if (!selected) return bindings;
+  return bindings.map(binding => binding.identifier === identifier ? {
+    ...binding,
+    versionId: selected.versionId,
+    version: selected.version,
+    runAt: selected.runAt,
+    versionPolicy: "pinned",
+    available: undefined,
+    error: undefined
+  } : binding);
+}
+
+/** Return resources whose saved policy currently cannot resolve to an exact release. */
+export function getUnavailableLoginSpaceBindingIdentifiers(scripts: ShopLoginSpaceBinding[], styles: ShopLoginSpaceBinding[]): string[] {
+  return [...scripts, ...styles]
+    .filter(binding => ((binding.versionPolicy ?? "pinned") === "latest_released" && binding.available === false) || !binding.versionId || !binding.version)
+    .map(binding => binding.identifier);
+}
+
+export function getIncompletePinnedLoginSpaceBindingIdentifiers(scripts: ShopLoginSpaceBinding[], styles: ShopLoginSpaceBinding[]): string[] {
+  return [...scripts, ...styles]
+    .filter(binding => (binding.versionPolicy ?? "pinned") === "pinned" && (!binding.versionId || !binding.version))
+    .map(binding => binding.identifier);
+}
+
+/** Strip server-only latest-resolution metadata before sending a strict PUT payload. */
+export function toLoginSpaceBindingUpdate(binding: ShopLoginSpaceBinding): ShopLoginSpaceBindingUpdate {
+  return {
+    identifier: binding.identifier,
+    versionId: binding.versionId,
+    version: binding.version,
+    versionPolicy: binding.versionPolicy,
+    urlMatchers: binding.urlMatchers,
+    runAt: binding.runAt,
+    sortOrder: binding.sortOrder
+  };
+}
+
+export function selectLoginSpaceBindings(mode: LoginSpaceOpenMode, scripts: ShopLoginSpaceBinding[], styles: ShopLoginSpaceBinding[], inheritDefaultResources = false): { scripts: ShopLoginSpaceBinding[]; styles: ShopLoginSpaceBinding[] } {
+  if (mode === "reuse" && !inheritDefaultResources) return { scripts: [], styles: [] };
+  return { scripts: [...scripts], styles: [...styles] };
+}
+
+export function toLoginSpaceRuntimeInput(scripts: ShopLoginSpaceBinding[], styles: ShopLoginSpaceBinding[]): LoginSpaceRuntimeInput {
+  return {
+    scriptSelectors: scripts.map(item => ({ identifier: item.identifier, version: item.version, runAt: item.runAt, priority: item.sortOrder, matchConfiguredUrlRules: true })),
+    styleSelectors: styles.map(item => ({ identifier: item.identifier, version: item.version, runAt: item.runAt, priority: item.sortOrder, matchConfiguredUrlRules: true }))
+  };
+}
diff --git a/plugins/ky-shop-management/src/login-space-settings-load.ts b/plugins/ky-shop-management/src/login-space-settings-load.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9b00ad72af530ab279fbc7f443008967157bbe5a
--- /dev/null
+++ b/plugins/ky-shop-management/src/login-space-settings-load.ts
@@ -0,0 +1,71 @@
+export const LOGIN_SPACE_SETTINGS_LOAD_TIMEOUT_MS = 12_000;
+export const LOGIN_SPACE_WINDOW_COUNT_TIMEOUT_MS = 2_500;
+
+export class LoginSpaceSettingsLoadTimeoutError extends Error {
+  constructor() {
+    super("登录空间设置加载超时，请关闭后重试");
+    this.name = "LoginSpaceSettingsLoadTimeoutError";
+  }
+}
+
+export class LoginSpaceSettingsLoadCancelledError extends Error {
+  constructor() {
+    super("login_space_settings_load_cancelled");
+    this.name = "LoginSpaceSettingsLoadCancelledError";
+  }
+}
+
+export interface LoginSpaceSettingsLoadOptions {
+  timeoutMs?: number;
+  isCurrent: () => boolean;
+  setLoading: (loading: boolean) => void;
+}
+
+export interface LoginSpaceSettingsLoadHandle<T> {
+  promise: Promise<T>;
+  cancel: () => void;
+}
+
+/** Bound auxiliary drawer work; closing/reopening cannot leave a stale Spin or state write. */
+export function startLoginSpaceSettingsLoad<T>(
+  work: (signal: AbortSignal) => Promise<T>,
+  options: LoginSpaceSettingsLoadOptions
+): LoginSpaceSettingsLoadHandle<T> {
+  const controller = new AbortController();
+  const timeoutMs = options.timeoutMs ?? LOGIN_SPACE_SETTINGS_LOAD_TIMEOUT_MS;
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  let rejectAbort!: (error: Error) => void;
+  let rejectTimeout!: (error: Error) => void;
+  const aborted = new Promise<never>((_, reject) => { rejectAbort = reject; });
+  const timedOut = new Promise<never>((_, reject) => { rejectTimeout = reject; });
+  const onAbort = () => rejectAbort(new LoginSpaceSettingsLoadCancelledError());
+  controller.signal.addEventListener("abort", onAbort, { once: true });
+
+  if (options.isCurrent()) options.setLoading(true);
+  const workPromise = Promise.resolve().then(() => work(controller.signal));
+  timeout = setTimeout(() => {
+    rejectTimeout(new LoginSpaceSettingsLoadTimeoutError());
+    controller.abort();
+  }, timeoutMs);
+
+  const promise = Promise.race([workPromise, aborted, timedOut]).finally(() => {
+    if (timeout) clearTimeout(timeout);
+    controller.signal.removeEventListener("abort", onAbort);
+    controller.abort();
+    if (options.isCurrent()) options.setLoading(false);
+  });
+
+  return { promise, cancel: () => controller.abort() };
+}
+
+export function withLoginSpaceWindowCountTimeout<T>(work: Promise<T>, timeoutMs = LOGIN_SPACE_WINDOW_COUNT_TIMEOUT_MS): Promise<T> {
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  return Promise.race([
+    work,
+    new Promise<never>((_, reject) => {
+      timeout = setTimeout(() => reject(new LoginSpaceSettingsLoadTimeoutError()), timeoutMs);
+    })
+  ]).finally(() => {
+    if (timeout) clearTimeout(timeout);
+  });
+}
