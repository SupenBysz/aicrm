+   </Space> : <Alert type="info" showIcon title="正在读取该登录空间的服务器配置" />}
+  </Spin>
+ </Drawer>
+ </div></ConfigProvider>;
+}
diff --git a/plugins/ky-shop-management/src/shop-management-error.ts b/plugins/ky-shop-management/src/shop-management-error.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2c75c72cd139cc2c8429fa87114808b247fe25ea
--- /dev/null
+++ b/plugins/ky-shop-management/src/shop-management-error.ts
@@ -0,0 +1,42 @@
+const SAFE_ERROR_CODES = new Set([
+  "conflict",
+  "permission_denied",
+  "validation_error",
+  "not_found",
+  "idempotency_key_reused",
+  "rate_limited",
+  "audit_pending",
+  "credential_unavailable",
+  "archive_cleanup_pending",
+  "login_required",
+  "internal_error",
+  "request_failed",
+  "invalid_response",
+  "client_upgrade_required"
+]);
+
+const REQUEST_ID_PATTERN = /^[A-Za-z0-9._:-]{1,128}$/;
+
+type ErrorShape = { code?: unknown; requestId?: unknown };
+
+function errorShape(value: unknown): ErrorShape {
+  return typeof value === "object" && value !== null ? value as ErrorShape : {};
+}
+
+function diagnostic(value: unknown): string {
+  const error = errorShape(value);
+  const code = typeof error.code === "string" && SAFE_ERROR_CODES.has(error.code) ? error.code : "request_failed";
+  const requestId = typeof error.requestId === "string" && REQUEST_ID_PATTERN.test(error.requestId)
+    ? error.requestId
+    : "";
+  return `（错误码 ${code}${requestId ? `，请求编号 ${requestId}` : ""}）`;
+}
+
+/** Formats shop-management errors without exposing server messages, details, or request data. */
+export function formatShopManagementError(value: unknown): string {
+  const code = errorShape(value).code;
+  if (code === "conflict") return "账号已存在（含已删除记录），或记录已被他人修改，请刷新核对";
+  if (code === "permission_denied") return "当前工作区无权执行此操作";
+  if (code === "validation_error") return "输入内容不符合要求，请核对";
+  return `操作失败，请刷新后重试${diagnostic(value)}`;
+}
