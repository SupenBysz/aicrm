@@ -0,0 +1,72 @@
+import { Checkbox, Select, Space, Typography } from "antd";
+import type { ShopLoginSpaceBinding, ShopLoginSpaceBindingOption, ShopLoginSpaceVersionPolicy } from "../api";
+import { pinLoginSpaceBindingVersion, replaceSelectedLoginSpaceBindings, updateLoginSpaceBindingPolicy } from "../login-space-resources";
+
+type Props = {
+  title: string;
+  placeholder: string;
+  bindings: ShopLoginSpaceBinding[];
+  options: ShopLoginSpaceBindingOption[];
+  disabled?: boolean;
+  onChange: (bindings: ShopLoginSpaceBinding[]) => void;
+};
+
+export function LoginSpaceBindingSelector({ title, placeholder, bindings, options, disabled = false, onChange }: Props) {
+  const selectedIdentifiers = bindings.map(binding => binding.identifier);
+  const selectorOptions = [...options];
+  for (const binding of bindings) {
+    if (!selectorOptions.some(option => option.key === binding.identifier)) {
+      selectorOptions.push({ key: binding.identifier, label: `${binding.identifier} · 当前发布版本不可用`, binding, versions: [{ ...binding, versionPolicy: "pinned" }] });
+    }
+  }
+
+  const changePolicy = (identifier: string, checked: boolean) => {
+    const policy: ShopLoginSpaceVersionPolicy = checked ? "latest_released" : "pinned";
+    onChange(updateLoginSpaceBindingPolicy(bindings, identifier, policy));
+  };
+
+  return <div>
+    <Typography.Text strong>{title}</Typography.Text>
+    <Select
+      mode="multiple"
+      allowClear
+      disabled={disabled}
+      style={{ width: "100%", marginTop: 8 }}
+      placeholder={placeholder}
+      value={selectedIdentifiers}
+      options={selectorOptions.map(option => ({ value: option.key, label: option.label }))}
+      onChange={identifiers => onChange(replaceSelectedLoginSpaceBindings(bindings, identifiers, selectorOptions))}
+    />
+    {bindings.length > 0 && <Space direction="vertical" size={8} style={{ width: "100%", marginTop: 10 }}>
+      {bindings.map(binding => {
+        const option = options.find(item => item.key === binding.identifier);
+        const followsLatest = (binding.versionPolicy ?? "pinned") === "latest_released";
+        const latestUnavailable = followsLatest && (binding.available === false || !binding.versionId || !binding.version);
+        const versionOptions = [...(option?.versions ?? [])];
+        if (binding.versionId && !versionOptions.some(item => item.versionId === binding.versionId)) {
+          versionOptions.push({ ...binding, versionPolicy: "pinned" });
+        }
+        return <div key={binding.identifier} style={{ border: "1px solid var(--ant-color-border-secondary, #eee)", borderRadius: 8, padding: "8px 10px" }}>
+          <Space direction="vertical" size={6} style={{ width: "100%" }}>
+            <Typography.Text strong>{binding.identifier}</Typography.Text>
+            <Checkbox disabled={disabled} checked={followsLatest} onChange={event => changePolicy(binding.identifier, event.target.checked)}>
+              自动跟随最新发布版
+            </Checkbox>
+            {followsLatest
+              ? latestUnavailable
+                ? <Typography.Text type="danger">当前没有可用的发布版本；请移除此绑定或发布可用版本后再打开空间。</Typography.Text>
+                : <Typography.Text type="secondary">新建或重新打开空间时解析最新版本；当前解析版本：v{binding.version}</Typography.Text>
+              : <Select
+                disabled={disabled}
+                value={binding.versionId || undefined}
+                placeholder="选择固定发布版本"
+                style={{ width: "100%" }}
+                options={versionOptions.map(item => ({ value: item.versionId, label: `固定版本 v${item.version}` }))}
+                onChange={versionId => onChange(pinLoginSpaceBindingVersion(bindings, binding.identifier, versionId, options))}
+              />}
+          </Space>
+        </div>;
+      })}
+    </Space>}
+  </div>;
+}
diff --git a/plugins/ky-shop-management/src/login-space-drawer-width.ts b/plugins/ky-shop-management/src/login-space-drawer-width.ts
