+    <LoginSpaceBindingSelector title="绑定样式（可多选）" placeholder="选择该登录空间要注入的样式" bindings={privateConfig.styles ?? []} options={bindingOptions.styles} disabled={!privateConfig} onChange={styles => setPrivateConfig(current => current ? { ...current, styles } : current)} />
+    <div><Typography.Text strong>已有空间资源继承与开发者工具</Typography.Text><Typography.Paragraph type="secondary" style={{ margin: "4px 0 8px" }}>继承开关控制重新打开时是否附加店铺默认脚本和样式；已打开窗口不会热更新。</Typography.Paragraph><Space direction="vertical" size={8} style={{ width: "100%" }}><Switch checked={privateConfig.inheritDefaultResources === true} onChange={value => setPrivateConfig(current => current ? { ...current, inheritDefaultResources: value } : current)} checkedChildren="继承店铺默认资源" unCheckedChildren="不继承店铺默认资源" /><Switch checked={privateConfig.showWebViewDevTools === true} onChange={value => setPrivateConfig(current => current ? { ...current, showWebViewDevTools: value } : current)} checkedChildren="WebView 开启" unCheckedChildren="WebView 关闭" /><Switch checked={privateConfig.showWebWindowDevTools === true} onChange={value => setPrivateConfig(current => current ? { ...current, showWebWindowDevTools: value } : current)} checkedChildren="宿主窗口开启" unCheckedChildren="宿主窗口关闭" /></Space></div>
