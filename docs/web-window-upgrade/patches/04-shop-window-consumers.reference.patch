index 0000000000000000000000000000000000000000..c5562a73c2ba0f2975076145d2b92e773f1b8a56
--- /dev/null
+++ b/plugins/ky-shop-management/src/login-space-drawer-width.ts
@@ -0,0 +1,50 @@
+export const LOGIN_SPACE_DRAWER_WIDTH_STORAGE_KEY = "ky.shop-management.login-space-drawer-width.v1";
+export const LOGIN_SPACE_DRAWER_DEFAULT_WIDTH = 960;
+export const LOGIN_SPACE_DRAWER_MIN_WIDTH = 760;
+export const LOGIN_SPACE_DRAWER_MAX_WIDTH = 1440;
+export const LOGIN_SPACE_DRAWER_VIEWPORT_MARGIN = 24;
+
+export interface LoginSpaceDrawerWidthStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export function getLoginSpaceDrawerWidthBounds(viewportWidth: number): { min: number; max: number } {
+  const usableViewport = Number.isFinite(viewportWidth) && viewportWidth > 0 ? viewportWidth : LOGIN_SPACE_DRAWER_DEFAULT_WIDTH + LOGIN_SPACE_DRAWER_VIEWPORT_MARGIN;
+  const max = Math.max(1, Math.min(LOGIN_SPACE_DRAWER_MAX_WIDTH, Math.floor(usableViewport - LOGIN_SPACE_DRAWER_VIEWPORT_MARGIN)));
+  return { min: Math.min(LOGIN_SPACE_DRAWER_MIN_WIDTH, max), max };
+}
+
+export function clampLoginSpaceDrawerWidth(width: number, viewportWidth: number): number {
+  const bounds = getLoginSpaceDrawerWidthBounds(viewportWidth);
+  const requested = Number.isFinite(width) ? Math.round(width) : LOGIN_SPACE_DRAWER_DEFAULT_WIDTH;
+  return Math.min(bounds.max, Math.max(bounds.min, requested));
+}
+
+export function readLoginSpaceDrawerWidth(storage: LoginSpaceDrawerWidthStorage, viewportWidth: number): number {
+  const fallback = clampLoginSpaceDrawerWidth(LOGIN_SPACE_DRAWER_DEFAULT_WIDTH, viewportWidth);
+  try {
+    const raw = storage.getItem(LOGIN_SPACE_DRAWER_WIDTH_STORAGE_KEY);
+    if (raw === null || raw.trim() === "") return fallback;
+    const stored = Number(raw);
+    if (!Number.isFinite(stored) || stored <= 0) return fallback;
+    return clampLoginSpaceDrawerWidth(stored, viewportWidth);
+  } catch {
+    return fallback;
+  }
+}
+
+export function persistLoginSpaceDrawerWidth(storage: LoginSpaceDrawerWidthStorage, width: number, viewportWidth: number): number {
+  const clamped = clampLoginSpaceDrawerWidth(width, viewportWidth);
+  try {
+    storage.setItem(LOGIN_SPACE_DRAWER_WIDTH_STORAGE_KEY, String(clamped));
+  } catch {
+    // Storage may be unavailable in restricted desktop/browser contexts; resizing remains usable in memory.
+  }
+  return clamped;
+}
+
+export function persistLoginSpaceDrawerWidthWhenIdle(storage: LoginSpaceDrawerWidthStorage, width: number, viewportWidth: number, resizing: boolean): number | null {
+  if (resizing) return null;
+  return persistLoginSpaceDrawerWidth(storage, width, viewportWidth);
+}
