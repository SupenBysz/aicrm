+import { clearLegacyLoginSpacePreferences, getIncompletePinnedLoginSpaceBindingIdentifiers, getLoginSpaceDisplayName, getUnavailableLoginSpaceBindingIdentifiers, hasUninitializedLoginSpacePreferences, importLegacyLoginSpacePreferences, isLoginSpaceCreationReady, selectLoginSpaceBindings, toLoginSpaceBindingUpdate, toLoginSpaceRuntimeInput } from "../login-space-resources";
+import { createShopLoginSpace, deleteShopLoginSpace, getShopLoginSpaceConfig, getShopLoginSpacePrivateConfig, getShopManagementRecord, listShopLoginSpaceBindingOptions, listShopLoginSpaces, listShopManagementRecords, updateShopLoginSpaceConfig, updateShopLoginSpacePrivateConfig } from "../api";
