@@ -0,0 +1,29 @@
+import type { ShopLoginSpace } from "./api";
+
+export type ShopLoginSpaceLocalDataStatus = "has_data" | "no_data" | "unknown";
+
+export function toLoginSpaceLocalDataStatusMap(
+  spaces: ShopLoginSpace[],
+  results: Array<{ webSpaceId: string; uuid: string; status: ShopLoginSpaceLocalDataStatus }> | null | undefined
+): Record<string, ShopLoginSpaceLocalDataStatus> {
+  const byIdAndUuid = new Map((results ?? []).map(item => [`${item.webSpaceId}\u0000${item.uuid}`, item.status] as const));
+  return Object.fromEntries(spaces.map(space => [space.uuid, byIdAndUuid.get(`${space.id}\u0000${space.uuid}`) ?? "unknown"]));
+}
+
+export function loginSpaceLocalDataLabel(status: ShopLoginSpaceLocalDataStatus | undefined): string {
+  if (status === "has_data") return "本机登录数据：有";
+  if (status === "no_data") return "本机登录数据：无";
+  return "本机登录数据：未知";
+}
+
+export function cloudSnapshotLabel(status: ShopLoginSpace["syncStatus"]): string {
+  switch (status) {
+    case "synced": return "云端可恢复";
+    case "preparing": return "云端准备中";
+    case "uploading": return "云端上传中";
+    case "verifying": return "云端校验中";
+    case "failed": return "云端同步失败";
+    case "interrupted": return "云端同步中断";
+    default: return "云端无快照";
+  }
+}
