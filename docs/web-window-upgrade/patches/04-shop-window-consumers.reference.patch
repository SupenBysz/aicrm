@@ -0,0 +1,263 @@
+import type { RequestClient } from "@ky/admin-core";
+export const shopPlatforms = [
+  { value: "douyin_shop", label: "抖店" },
+  { value: "kuaishou_shop", label: "快手" },
+  { value: "xiaohongshu_shop", label: "小红书" }
+] as const;
+export type ShopPlatform = typeof shopPlatforms[number]["value"];
+export interface ShopManagementRecord {
+  id: string; workspaceType: string; workspaceId: string; ownerMembershipId: string;
+  platform: ShopPlatform; name: string | null; account: string; city: string;
+  remark: string | null; shopId: string | null; logoUrl: string | null; logoImageId?: string | null;
+  platformAttributes: { shop_type?: "official" | "flagship" | "ordinary"; verified?: boolean };
+  hasPassword: boolean; status: "active" | "deleted"; revision: number;
+  createdAt: string; updatedAt: string; deletedAt: string | null; lastLoginAt: string | null;
+}
+export interface ShopManagementListParams { page: number; pageSize: number; platform?: ShopPlatform; keyword?: string }
+export interface ListResult<T> { items: T[]; pagination: { page: number; pageSize: number; total: number } }
+// 普通读取永不返回密码或信封。
+export function listShopManagementRecords(client: RequestClient, params: ShopManagementListParams, signal?: AbortSignal): Promise<ListResult<ShopManagementRecord>> {
+  const q = new URLSearchParams({ page: String(params.page), pageSize: String(params.pageSize) });
+  if (params.platform) q.set("platform", params.platform);
+  if (params.keyword) q.set("keyword", params.keyword);
+  return client.request(`/api/v1/shop-management/stores?${q}`, { signal });
+}
+export function getShopManagementRecord(client: RequestClient, id: string): Promise<ShopManagementRecord> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(id)}`);
+}
+
+export type ShopLoginStatus = "unknown" | "logging_in" | "logged_in" | "logged_out" | "expired" | "error";
+export type ShopLoginSpaceSyncStatus = "not_synced" | "preparing" | "uploading" | "verifying" | "synced" | "failed" | "interrupted";
+export interface ShopLoginSpaceSyncProgress {
+  phase?: "preparing" | "uploading" | "verifying" | "downloading" | "restoring";
+  bytesTransferred?: number;
+  totalBytes?: number;
+  /** Server list DTO aliases used by persisted progress projections. */
+  bytes?: number;
+  total?: number;
+  percent?: number;
+  updatedAt?: string;
+  operationId?: string;
+}
+export interface ShopLoginSpace {
+  id: string; /** Stable server-generated cross-module key; distinct from legacy id/webSpaceId. */ uuid: string; storeId: string; platform?: string; displayName: string | null; loginStatus?: ShopLoginStatus; loginStatusUpdatedAt?: string | null;
+  syncStatus?: ShopLoginSpaceSyncStatus; syncProgress?: ShopLoginSpaceSyncProgress | null;
+  status: "active" | "pending" | "available" | "invalid" | "deleting" | "error";
+  archiveSha256: string | null; archiveSize?: number | null; createdAt: string; updatedAt: string; lastOpenedAt: string | null; revision: number;
+}
+export function createShopLoginSpace(client: RequestClient, storeId: string, input: { webSpaceId: string; displayName?: string }): Promise<ShopLoginSpace> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces`, { method: "POST", headers: { "Idempotency-Key": input.webSpaceId }, body: input });
+}
+export type ShopLoginSpaceRunAt = "document_start" | "dom_content_loaded" | "document_idle" | "spa_route_change";
+export type ShopLoginSpaceVersionPolicy = "latest_released" | "pinned";
+export interface ShopLoginSpaceBinding {
+  identifier: string;
+  versionId: string;
+  version: string;
+  /** Existing server responses without this field are treated as pinned. */
+  versionPolicy?: ShopLoginSpaceVersionPolicy;
+  /** Present for latest_released bindings; false means no eligible release exists. */
+  available?: boolean;
+  error?: string;
+  urlMatchers: string[];
+  runAt: ShopLoginSpaceRunAt;
+  sortOrder: number;
+}
+export type ShopLoginSpaceBindingUpdate = Omit<ShopLoginSpaceBinding, "available" | "error">;
+export interface ShopLoginSpaceConfig {
+  storeId: string;
+  defaultUrl: string;
+  scheduleMode: "page_first" | "strict_document_start";
+  /** Null/omitted only while importing legacy client-local preferences. */
+  inheritDefaultResources?: boolean | null;
+  showWebViewDevTools?: boolean | null;
+  showWebWindowDevTools?: boolean | null;
+  scripts: ShopLoginSpaceBinding[];
+  styles: ShopLoginSpaceBinding[];
+  /** 可供新空间选择的 UA/Accept-Language 快照模板。 */
+  userAgentProfiles?: ShopLoginSpaceUserAgentProfile[];
+  defaultUserAgentProfileId?: string | null;
+  /** 新 UUID 空间创建时复制的协议白名单模板。 */
+  protocolWhitelist?: ShopLoginSpaceProtocolWhitelist;
+  /** 新空间创建时使用的代理模板；GET 永不返回代理凭据。 */
+  proxy: ShopLoginSpaceProxyConfig;
+  candidateSpaceUuids: string[];
+  allocationMode: LoginSpaceAllocationMode;
+  revision: number;
+  updatedAt: string;
+}
+export interface ShopLoginSpaceUserAgentProfile {
+  id: string;
+  name: string;
+  userAgent: string;
+  acceptLanguage: string;
+}
+export type ShopLoginSpaceConfigUpdate = Pick<ShopLoginSpaceConfig, "defaultUrl" | "scheduleMode"> & {
+  inheritDefaultResources: boolean;
+  showWebViewDevTools: boolean;
+  showWebWindowDevTools: boolean;
+  scripts: ShopLoginSpaceBindingUpdate[];
+  styles: ShopLoginSpaceBindingUpdate[];
+  userAgentProfiles: ShopLoginSpaceUserAgentProfile[];
+  defaultUserAgentProfileId: string | null;
+  protocolWhitelist: ShopLoginSpaceProtocolWhitelist;
+  proxy: ShopLoginSpaceProxyInput;
+  candidateSpaceUuids: string[];
+  allocationMode: LoginSpaceAllocationMode;
+};
+export interface ShopLoginSpaceProtocolWhitelist {
+  navigation: string[];
+  webSocket: string[];
+  external: string[];
+}
+export type ShopLoginSpaceProxyMode = "direct" | "system" | "fixed";
+export type ShopLoginSpaceProxyProtocol = "http" | "https" | "socks5";
+export interface ShopLoginSpaceProxyConfig {
+  mode: ShopLoginSpaceProxyMode;
+  protocol?: ShopLoginSpaceProxyProtocol;
+  host?: string;
+  port?: number;
+  bypassRules: string[];
+  usernameConfigured: boolean;
+  passwordConfigured?: boolean;
+}
+export type LoginSpaceAllocationMode = "random" | "sequential" | "balanced";
+export interface ShopLoginSpaceProxyInput {
+  mode: ShopLoginSpaceProxyMode;
+  protocol?: ShopLoginSpaceProxyProtocol;
+  host?: string;
+  port?: number;
+  bypassRules?: string[];
+  username?: string;
+  password?: string;
+  clearUsername?: boolean;
+  clearPassword?: boolean;
+}
+export interface ShopLoginSpacePrivateConfig {
+  storeId: string;
+  spaceId: string;
+  uuid: string;
+  defaultUrl: string;
+  scheduleMode: ShopLoginSpaceRunAt | "page_first" | "strict_document_start";
+  inheritDefaultResources: boolean;
+  showWebViewDevTools: boolean;
+  showWebWindowDevTools: boolean;
+  scripts: ShopLoginSpaceBinding[];
+  styles: ShopLoginSpaceBinding[];
+  userAgentProfileId: string | null;
+  userAgentProfileName: string | null;
+  userAgent: string;
+  acceptLanguage: string;
+  userAgentLocked: boolean;
+  proxy: ShopLoginSpaceProxyConfig;
+  protocolWhitelist?: ShopLoginSpaceProtocolWhitelist;
+  revision: number;
+  updatedAt: string;
+}
+export type ShopLoginSpacePrivateConfigUpdate = Omit<Pick<ShopLoginSpacePrivateConfig,
+  "defaultUrl" | "scheduleMode" | "inheritDefaultResources" | "showWebViewDevTools" |
+  "showWebWindowDevTools" | "scripts" | "styles" | "proxy">, "proxy"> & {
+  protocolWhitelist: ShopLoginSpaceProtocolWhitelist;
+  proxy: ShopLoginSpaceProxyInput;
+};
+export interface ShopLoginSpaceBindingOption {
+  /** Stable resource identifier; version policy is configured per selected resource. */
+  key: string;
+  label: string;
+  /** Latest eligible published version; server remains authoritative at save/open time. */
+  binding: ShopLoginSpaceBinding;
+  /** Eligible exact versions available for a pinned binding. */
+  versions: ShopLoginSpaceBinding[];
+}
+interface ScriptBindingSource {
+  id: string;
+  identifier: string;
+  name: string;
+  matchUrl: string;
+  matchRules?: Array<{ pattern: string; enabled: boolean; sortOrder?: number }>;
+  runAt: ShopLoginSpaceRunAt;
+  effectiveVersionId: string;
+  effectiveVersion: string;
+  latestVersionId: string;
+  latestVersion: string;
+  status: string;
+  priority: number;
+}
+interface AssetBindingSource {
+  id: string;
+  version: string;
+  runAt: ShopLoginSpaceRunAt;
+  enabled: boolean;
+  status: string;
+}
+function compareSemVer(left: string, right: string): number {
+  const a = left.split(".");
+  const b = right.split(".");
+  for (let index = 0; index < 3; index++) {
+    const leftPart = a[index] ?? "0";
+    const rightPart = b[index] ?? "0";
+    if (leftPart.length !== rightPart.length) return leftPart.length - rightPart.length;
+    if (leftPart !== rightPart) return leftPart < rightPart ? -1 : 1;
+  }
+  return 0;
+}
+const bindingMatchers = (script: ScriptBindingSource) => {
+  const rules = (script.matchRules ?? []).filter(rule => rule.enabled).sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0)).map(rule => rule.pattern.trim()).filter(Boolean);
+  return rules.length ? rules : script.matchUrl ? [script.matchUrl] : [];
+};
+export async function listShopLoginSpaceBindingOptions(client: RequestClient, assetType: "script" | "style", signal?: AbortSignal): Promise<ShopLoginSpaceBindingOption[]> {
+  const response = await client.request<{ items: ScriptBindingSource[] }>("/api/v1/matrix-account-douyin-scripts?page=1&pageSize=200&status=enabled", { signal });
+  const options = await Promise.all(response.items.map(async script => {
+    const assets = await client.request<AssetBindingSource[]>(`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(script.id)}/assets?assetType=${assetType}`, { signal });
+    const eligibleAssets = assets
+      .filter(item => item.enabled && (item.status === "active" || item.status === "released") && /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/.test(item.version))
+      .sort((a, b) => compareSemVer(b.version, a.version) || a.id.localeCompare(b.id));
+    const latest = eligibleAssets[0];
+    if (!latest) return null;
+    const makeBinding = (asset: AssetBindingSource, versionPolicy: ShopLoginSpaceVersionPolicy): ShopLoginSpaceBinding => ({
+      identifier: script.identifier,
+      versionId: asset.id,
+      version: asset.version,
+      versionPolicy,
+      urlMatchers: bindingMatchers(script),
+      runAt: asset.runAt ?? script.runAt,
+      sortOrder: script.priority ?? 0
+    });
+    return {
+      key: script.identifier,
+      label: `${script.identifier} · ${script.name} · 最新 v${latest.version}`,
+      binding: makeBinding(latest, "latest_released"),
+      versions: eligibleAssets.map(asset => makeBinding(asset, "pinned"))
+    };
+  }));
+  return options.filter((option): option is ShopLoginSpaceBindingOption => Boolean(option));
+}
+export function listShopLoginSpaces(client: RequestClient, storeId: string, signal?: AbortSignal): Promise<ListResult<ShopLoginSpace>> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces`, { signal });
+}
+export function updateShopLoginSpaceInfo(client: RequestClient, storeId: string, spaceId: string, patch: { displayName?: string; loginStatus?: ShopLoginStatus }): Promise<{ displayName: string; loginStatus: ShopLoginStatus; updatedAt: string; revision: number }> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces/${encodeURIComponent(spaceId)}/info`, { method: "PATCH", body: patch });
+}
+export function getShopLoginSpaceConfig(client: RequestClient, storeId: string): Promise<ShopLoginSpaceConfig> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-space-config`);
+}
+export function updateShopLoginSpaceConfig(client: RequestClient, storeId: string, config: ShopLoginSpaceConfigUpdate, revision: number): Promise<ShopLoginSpaceConfig> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-space-config`, {
+    method: "PUT",
+    headers: { "Idempotency-Key": crypto.randomUUID(), "X-KY-Expected-Revision": String(revision) },
+    body: config
+  });
+}
+export function getShopLoginSpacePrivateConfig(client: RequestClient, storeId: string, spaceUuid: string): Promise<ShopLoginSpacePrivateConfig> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces/${encodeURIComponent(spaceUuid)}/config`, { headers: { "Cache-Control": "no-cache" } });
+}
+export function updateShopLoginSpacePrivateConfig(client: RequestClient, storeId: string, spaceUuid: string, config: ShopLoginSpacePrivateConfigUpdate, revision: number): Promise<ShopLoginSpacePrivateConfig> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces/${encodeURIComponent(spaceUuid)}/config`, {
+    method: "PUT",
+    headers: { "Idempotency-Key": crypto.randomUUID(), "X-KY-Expected-Revision": String(revision) },
+    body: config
+  });
+}
+export function deleteShopLoginSpace(client: RequestClient, storeId: string, space: ShopLoginSpace): Promise<unknown> {
+  return client.request(`/api/v1/shop-management/stores/${encodeURIComponent(storeId)}/login-spaces/${encodeURIComponent(space.id)}`, { method: "DELETE", headers: { "Idempotency-Key": crypto.randomUUID() }, body: { revision: space.revision } });
+}
