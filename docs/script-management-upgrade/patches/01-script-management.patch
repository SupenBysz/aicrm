+	if err != nil {
+		return DouyinScript{}, classifyWriteErr(err)
+	}
+	if err = affectedOrNotFound(res); err != nil {
+		return DouyinScript{}, ErrConflict
+	}
+	return s.GetDouyinScript(ctx, wsType, wsID, id)
+}
