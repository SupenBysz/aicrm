+    <div className="monaco-source-editor" ref={hostRef} data-script-name={scriptName ?? ""} data-version={version ?? ""} aria-label={`${language}源码编辑器`} />
+    {inlineSuggestions && <div className="script-editor-completion-popup" style={{ position: "absolute", zIndex: 20, top: inlineSuggestions.top, left: inlineSuggestions.left, width: "min(560px, calc(100% - 16px))", maxHeight: 280, overflowY: "auto", background: "#fffcf6", border: "1px solid #ead9c5", boxShadow: "0 4px 14px rgba(52,40,26,.18)" }}>{inlineSuggestions.items.map((item, index) => <button key={item.label} type="button" onMouseEnter={() => setInlineSuggestions(current => current ? { ...current, index } : current)} onMouseDown={event => { event.preventDefault(); acceptInlineSuggestion(item); }} style={{ display: "flex", width: "100%", gap: 12, padding: "7px 10px", border: 0, background: index === inlineSuggestions.index ? "#f9eedc" : "transparent", color: "#34281a", textAlign: "left", cursor: "pointer", fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace" }}><span>{item.label}</span><small style={{ marginLeft: "auto", color: "#8c7a63" }}>{item.description}</small></button>)}</div>}
+    <div className="script-editor-status-bar">
+      <div className="script-editor-status-left"><span>脚本名称：{scriptName?.trim() || "未命名"} · 版本：{version?.trim() || "未生成"}</span></div>
+      <div className="script-editor-status-center"><span>行 {stats.line}，列 {stats.column}</span></div>
+      <div className="script-editor-status-right"><span>共 {Array.from(value).length} 个字符</span>{stats.characters > 0 && <span>已选 {stats.characters} 个字符，{stats.lines} 行</span>}</div>
+    </div>
+  </div>;
+}
diff --git a/plugins/ky-script-management/src/editor-shortcut-preferences.test.mjs b/plugins/ky-script-management/src/editor-shortcut-preferences.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fe5206a3aaac2b29184157f40cab97a7daca15fd
--- /dev/null
+++ b/plugins/ky-script-management/src/editor-shortcut-preferences.test.mjs
@@ -0,0 +1,50 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  defaultEditorShortcuts,
+  displayEditorShortcut,
+  editorShortcutActions,
+  normalizeEditorShortcut,
+  normalizeEditorShortcutPreferences,
+  shortcutKeyCodeName,
+  shortcutKeyFromEvent,
+  shortcutPlatform,
+  validateEditorShortcuts
+} from "./editor-shortcut-preferences.ts";
+
+test("查找快捷键按平台采用 VS Code 默认值并规范化显示", () => {
+  assert.deepEqual(defaultEditorShortcuts("mac"), { completion: "", find: "Mod+F", replace: "Mod+Alt+F" });
+  assert.deepEqual(defaultEditorShortcuts("other"), { completion: "", find: "Mod+F", replace: "Mod+H" });
+  assert.equal(shortcutPlatform("MacIntel"), "mac");
+  assert.equal(shortcutPlatform("Win32"), "other");
+  assert.equal(displayEditorShortcut("Mod+Alt+F", "mac"), "⌘⌥F");
+  assert.equal(displayEditorShortcut("Mod+H", "other"), "Ctrl+H");
+});
+
+test("自定义组合键与旧 shortcut 字段规范化并迁移为补全快捷键", () => {
+  assert.equal(normalizeEditorShortcut("Ctrl + alt + f"), "Mod+Alt+F");
+  assert.equal(shortcutKeyCodeName("Mod+Alt+F"), "KeyF");
+  assert.equal(shortcutKeyCodeName("Mod+ArrowUp"), "UpArrow");
+  assert.deepEqual(normalizeEditorShortcutPreferences({ enabled: true, shortcut: "Ctrl+Space" }, "other"), {
+    completion: "Mod+Space", find: "Mod+F", replace: "Mod+H"
+  });
+  assert.deepEqual(normalizeEditorShortcutPreferences({ completionShortcut: "Mod+J", findShortcut: "", replaceShortcut: "" }, "mac"), {
+    completion: "Mod+J", find: "", replace: ""
+  });
+  assert.equal(shortcutKeyFromEvent({ key: "f", code: "KeyF", ctrlKey: true, metaKey: false, shiftKey: false, altKey: true }), "Mod+Alt+F");
+});
+
+test("只允许查找使用 Mod+F，且三项快捷键不能重复", () => {
+  assert.equal(validateEditorShortcuts({ completion: "Mod+J", find: "Mod+F", replace: "Mod+H" }), null);
+  assert.match(validateEditorShortcuts({ completion: "Mod+F", find: "Mod+G", replace: "Mod+H" }) ?? "", /Mod\+F/);
+  assert.match(validateEditorShortcuts({ completion: "Mod+J", find: "Ctrl+J", replace: "Mod+H" }) ?? "", /冲突/);
+  assert.ok(validateEditorShortcuts({ completion: "Mod+J", find: "Mod+G", replace: "Mod+G" }));
+});
+
+test("清除快捷键后不注册拦截动作；只读编辑器不注册替换动作", () => {
+  assert.deepEqual(editorShortcutActions({ completion: "", find: "", replace: "" }, "other", false), []);
+  assert.deepEqual(editorShortcutActions({ completion: "Mod+K", find: "Mod+F", replace: "Mod+H" }, "other", true), [
+    { command: "completion", shortcut: "Mod+K" },
+    { command: "find", shortcut: "Mod+F" }
+  ]);
+});
diff --git a/plugins/ky-script-management/src/editor-shortcut-preferences.ts b/plugins/ky-script-management/src/editor-shortcut-preferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e1b53873fdd053ff36023fc626bc7cf6f4d5423f
--- /dev/null
+++ b/plugins/ky-script-management/src/editor-shortcut-preferences.ts
@@ -0,0 +1,146 @@
+export type EditorShortcutCommand = "completion" | "find" | "replace";
+export type EditorShortcutPreferences = Record<EditorShortcutCommand, string>;
+export type ShortcutPlatform = "mac" | "other";
+
+export type EditorShortcutAction = {
+  command: EditorShortcutCommand;
+  shortcut: string;
+};
+
+const namedKeyCodes: Record<string, string> = {
+  SPACE: "Space", ENTER: "Enter", RETURN: "Enter", TAB: "Tab", ESC: "Escape", ESCAPE: "Escape",
+  BACKSPACE: "Backspace", DELETE: "Delete", INSERT: "Insert", HOME: "Home", END: "End",
+  PAGEUP: "PageUp", PAGEDOWN: "PageDown", ARROWLEFT: "LeftArrow", LEFT: "LeftArrow",
+  ARROWRIGHT: "RightArrow", RIGHT: "RightArrow", ARROWUP: "UpArrow", UP: "UpArrow",
+  ARROWDOWN: "DownArrow", DOWN: "DownArrow", SEMICOLON: "Semicolon", EQUAL: "Equal",
+  COMMA: "Comma", MINUS: "Minus", PERIOD: "Period", SLASH: "Slash", BACKQUOTE: "Backquote",
+  BRACKETLEFT: "BracketLeft", BACKSLASH: "Backslash", BRACKETRIGHT: "BracketRight", QUOTE: "Quote"
+};
+
+const displayKeys: Record<string, string> = {
+  SPACE: "Space", ENTER: "Enter", ESCAPE: "Esc", BACKSPACE: "Backspace", DELETE: "Delete",
+  INSERT: "Insert", HOME: "Home", END: "End", PAGEUP: "Page Up", PAGEDOWN: "Page Down",
+  ARROWLEFT: "←", LEFT: "←", ARROWRIGHT: "→", RIGHT: "→", ARROWUP: "↑", UP: "↑",
+  ARROWDOWN: "↓", DOWN: "↓", SEMICOLON: ";", EQUAL: "=", COMMA: ",", MINUS: "-",
+  PERIOD: ".", SLASH: "/", BACKQUOTE: "`", BRACKETLEFT: "[", BACKSLASH: "\\", BRACKETRIGHT: "]", QUOTE: "'"
+};
+
+export function shortcutPlatform(platform: string | null | undefined): ShortcutPlatform {
+  return /mac|iphone|ipad|darwin/i.test(platform ?? "") ? "mac" : "other";
+}
+
+export function defaultEditorShortcuts(platform: ShortcutPlatform): EditorShortcutPreferences {
+  return {
+    completion: "",
+    find: "Mod+F",
+    replace: platform === "mac" ? "Mod+Alt+F" : "Mod+H"
+  };
+}
+
+function normalizeKey(value: string): string | null {
+  const raw = value.trim();
+  if (/^[a-z]$/i.test(raw)) return raw.toUpperCase();
+  if (/^\d$/.test(raw)) return raw;
+  if (/^F(?:[1-9]|1\d|2[0-4])$/i.test(raw)) return raw.toUpperCase();
+  const alias = raw.replace(/[\s_-]/g, "").toUpperCase();
+  if (namedKeyCodes[alias]) return alias === "RETURN" ? "Enter" : alias === "ESC" ? "Escape" : raw[0].toUpperCase() + raw.slice(1);
+  return null;
+}
+
+export function normalizeEditorShortcut(value: unknown): string {
+  if (typeof value !== "string" || !value.trim()) return "";
+  const parts = value.split("+").map(part => part.trim()).filter(Boolean);
+  if (!parts.length) return "";
+  const modifiers = new Set<string>();
+  let key: string | null = null;
+  for (const part of parts) {
+    const modifier = part.toLowerCase();
+    if (["mod", "ctrl", "control", "cmd", "command", "meta", "⌘"].includes(modifier)) {
+      if (modifiers.has("Mod")) return "";
+      modifiers.add("Mod");
+      continue;
+    }
+    if (["shift", "⇧"].includes(modifier)) {
+      if (modifiers.has("Shift")) return "";
+      modifiers.add("Shift");
+      continue;
+    }
+    if (["alt", "option", "⌥"].includes(modifier)) {
+      if (modifiers.has("Alt")) return "";
+      modifiers.add("Alt");
+      continue;
+    }
+    if (key) return "";
+    key = normalizeKey(part);
+    if (!key) return "";
+  }
+  if (!key || modifiers.size === 0) return "";
+  return [...["Mod", "Shift", "Alt"].filter(item => modifiers.has(item)), key].join("+");
+}
+
+export function normalizeEditorShortcutPreferences(value: unknown, platform: ShortcutPlatform): EditorShortcutPreferences {
+  const stored = value && typeof value === "object" ? value as Record<string, unknown> : {};
+  const defaults = defaultEditorShortcuts(platform);
+  return {
+    completion: normalizeEditorShortcut(stored.completionShortcut ?? stored.shortcut),
+    find: stored.findShortcut === undefined ? defaults.find : normalizeEditorShortcut(stored.findShortcut),
+    replace: stored.replaceShortcut === undefined ? defaults.replace : normalizeEditorShortcut(stored.replaceShortcut)
+  };
+}
+
+export function validateEditorShortcuts(shortcuts: EditorShortcutPreferences): string | null {
+  for (const command of ["completion", "find", "replace"] as const) {
+    const value = shortcuts[command];
+    if (value && !normalizeEditorShortcut(value)) return `${command}:invalid`;
+  }
+  if (shortcuts.completion === "Mod+F" || shortcuts.replace === "Mod+F") return "Mod+F 仅可分配给查找";
+  const used = new Map<string, EditorShortcutCommand>();
+  for (const command of ["completion", "find", "replace"] as const) {
+    const shortcut = normalizeEditorShortcut(shortcuts[command]);
+    if (!shortcut) continue;
+    const previous = used.get(shortcut);
+    if (previous) return `快捷键冲突：${previous} 与 ${command}`;
+    used.set(shortcut, command);
+  }
+  return null;
+}
+
+export function editorShortcutActions(shortcuts: EditorShortcutPreferences, _platform: ShortcutPlatform, readOnly: boolean): EditorShortcutAction[] {
+  if (validateEditorShortcuts(shortcuts)) return [];
+  const actions: EditorShortcutAction[] = [];
+  for (const command of ["completion", "find", "replace"] as const) {
+    const shortcut = normalizeEditorShortcut(shortcuts[command]);
+    if (shortcut && (command !== "replace" || !readOnly)) actions.push({ command, shortcut });
+  }
+  return actions;
+}
+
+export function shortcutKeyCodeName(shortcut: string): string | null {
+  const normalized = normalizeEditorShortcut(shortcut);
+  if (!normalized) return null;
+  const key = normalized.split("+").at(-1)!;
+  if (/^[A-Z]$/.test(key)) return `Key${key}`;
+  if (/^\d$/.test(key)) return `Digit${key}`;
+  if (/^F(?:[1-9]|1\d|2[0-4])$/.test(key)) return key;
+  return namedKeyCodes[key.replace(/[\s_-]/g, "").toUpperCase()] ?? null;
+}
+
+export function displayEditorShortcut(shortcut: string, platform: ShortcutPlatform): string {
+  const normalized = normalizeEditorShortcut(shortcut);
+  if (!normalized) return "未配置";
+  return normalized.split("+").map(part => {
+    if (part === "Mod") return platform === "mac" ? "⌘" : "Ctrl";
+    if (part === "Alt") return platform === "mac" ? "⌥" : "Alt";
+    if (part === "Shift") return platform === "mac" ? "⇧" : "Shift";
+    return displayKeys[part.toUpperCase()] ?? part;
+  }).join(platform === "mac" ? "" : "+");
+}
+
+export function shortcutKeyFromEvent(event: { key: string; code: string; ctrlKey: boolean; metaKey: boolean; shiftKey: boolean; altKey: boolean }): string {
+  const code = event.code;
+  const key = code.startsWith("Key") ? code.slice(3) : code.startsWith("Digit") ? code.slice(5) : code.startsWith("Numpad") && /^Numpad\d$/.test(code) ? code.slice(6) : code;
+  const normalizedKey = normalizeKey(key);
+  if (!normalizedKey) return "";
+  const parts = [event.metaKey || event.ctrlKey ? "Mod" : "", event.shiftKey ? "Shift" : "", event.altKey ? "Alt" : "", normalizedKey].filter(Boolean);
+  return normalizeEditorShortcut(parts.join("+"));
+}
