+export interface AssetVersion { id:string; scriptId:string; assetType:AssetType; version:string; sourceContent?:string; sourceBytes:number; sourceChars:number; sourceSha256:string; runAt:"document_start"|"dom_content_loaded"|"document_idle"|"spa_route_change"; priority:number; enabled:boolean; status:VersionStatus; revision:number; createdBy?:string; createdByName?:string; updatedBy?:string; updatedByName?:string; publishedAt?:string|null; createdAt:string|number|null; updatedAt:string|number|null }
+export interface ListResponse { items:ScriptRow[]; pagination:{page:number;pageSize:number;total:number} }
