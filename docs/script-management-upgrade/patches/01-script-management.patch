+
+-- 回滚：删除新增索引与约束后，再删除 platform/dependencies 列；删除列前必须确认运行时已回退到旧版本。
diff --git a/ops/db/096_matrix_account_douyin_asset_source_hash_fix.sql b/ops/db/096_matrix_account_douyin_asset_source_hash_fix.sql
new file mode 100644
index 0000000000000000000000000000000000000000..f29f4bbd8ee69604bb2994b2d02f4f0e87eb9ae5
--- /dev/null
+++ b/ops/db/096_matrix_account_douyin_asset_source_hash_fix.sql
@@ -0,0 +1,10 @@
+-- 修复 087 历史回填把 JS+CSS 联合 hash 写入独立资产的问题。
+-- 每个资产的 source_sha256 必须只覆盖自身 source_content，供运行时完整性校验。
+CREATE EXTENSION IF NOT EXISTS pgcrypto;
+
+UPDATE ky_matrix_account_douyin_script_asset_version
+SET source_sha256 = encode(sha256(convert_to(source_content, 'UTF8')), 'hex')
+WHERE source_sha256 IS DISTINCT FROM encode(sha256(convert_to(source_content, 'UTF8')), 'hex');
+
+-- 回滚说明：本修复仅重算派生 hash，不删除源码或版本；如需回滚应恢复
+-- 迁移前的 source_sha256 备份，禁止重新写入联合 hash。
diff --git a/ops/db/099_matrix_account_public_styles.sql b/ops/db/099_matrix_account_public_styles.sql
new file mode 100644
