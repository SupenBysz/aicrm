+  for (const marker of ['provider: "antd"', 'provider: "iconfont"', 'mode: "font-class"', 'mode: "unicode"', 'mode: "symbol"', 'label: "jssdk.ui.message.success"', 'label: "jssdk.ui.modal.confirm"']) {
