+		{MatchType: "prefix", Pattern: "https://example.com/product", Enabled: true},
+	}
+	matched, err := matchDouyinRules(rules, "", "", "https://example.com/product/list?sku=1")
+	if err != nil || !matched {
+		t.Fatalf("matched=%v err=%v", matched, err)
+	}
+}
