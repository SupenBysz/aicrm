diff --git a/services/ky-matrix-account-service/internal/matcher/url.go b/services/ky-matrix-account-service/internal/matcher/url.go
new file mode 100644
index 0000000000000000000000000000000000000000..6675a8daeddbe73e5ebee8ee659c0900064d93e0
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/matcher/url.go
@@ -0,0 +1,195 @@
+package matcher
+
+import (
+	"errors"
+	"net"
+	"net/url"
+	"regexp"
+	"strings"
+	"unicode/utf8"
+)
+
+const (
+	MaxPatternLength = 2048
+	MaxWildcardCount = 32
+)
+
+var (
+	ErrEmptyURL       = errors.New("url is empty")
+	ErrInvalidURL     = errors.New("url is invalid")
+	ErrInvalidPattern = errors.New("url pattern is invalid")
+)
+
+// Normalize converts an absolute HTTP(S) URL into the matching form. Scheme
+// and hostname are lower-cased, default ports are removed, an empty path is
+// represented as "/", and the raw path/query are otherwise preserved.
+// Fragments and userinfo are rejected because they are not request targets.
+func Normalize(raw string) (string, error) {
+	return normalize(raw)
+}
+
+// Validate checks and normalizes an exact or wildcard pattern without
+// interpreting user text as a regular expression.
+func Validate(matchType, raw string) (string, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return "", ErrEmptyURL
+	}
+	if len(raw) > MaxPatternLength || !utf8.ValidString(raw) || hasControl(raw) {
+		return "", ErrInvalidPattern
+	}
+	switch matchType {
+	case "exact":
+		if strings.ContainsRune(raw, '*') {
+			return "", ErrInvalidPattern
+		}
+		value, err := Normalize(raw)
+		if err != nil {
+			return "", ErrInvalidPattern
+		}
+		return value, nil
+	case "wildcard":
+		count := strings.Count(raw, "*")
+		if count > MaxWildcardCount {
+			return "", ErrInvalidPattern
+		}
+		// wildcard 不含星号时按规范化后的完整 URL 字面量匹配，
+		// 这样历史配置和用户输入的完整 URL 都能安全保存。
+		if count == 0 {
+			value, err := Normalize(raw)
+			if err != nil {
+				return "", ErrInvalidPattern
+			}
+			return value, nil
+		}
+		const marker = "kwwwildcardmarker"
+		value, err := normalize(strings.ReplaceAll(raw, "*", marker))
+		if err != nil {
+			return "", ErrInvalidPattern
+		}
+		return strings.ReplaceAll(value, marker, "*"), nil
+	default:
+		return "", ErrInvalidPattern
+	}
+}
+
+// ValidateRule 校验多规则中的 URL 模式。prefix 使用规范化 URL 的字面前缀匹配。
+func ValidateRule(matchType, raw string) (string, error) {
+	if matchType == "prefix" {
+		raw = strings.TrimSpace(raw)
+		if raw == "" || len(raw) > MaxPatternLength || !utf8.ValidString(raw) || hasControl(raw) || strings.ContainsRune(raw, '*') {
+			return "", ErrInvalidPattern
+		}
+		return Normalize(raw)
+	}
+	return Validate(matchType, raw)
+}
+
+// MatchRule 在 exact/prefix/wildcard 三种受限语法中匹配 URL，不接受正则表达式。
+func MatchRule(matchType, pattern, candidate string, ignoreQuery bool) (bool, error) {
+	stored, err := ValidateRule(matchType, pattern)
+	if err != nil {
+		return false, err
+	}
+	actual, err := Normalize(candidate)
+	if err != nil {
+		return false, ErrInvalidURL
+	}
+	if ignoreQuery {
+		if index := strings.IndexByte(stored, '?'); index >= 0 {
+			stored = stored[:index]
+		}
+		if index := strings.IndexByte(actual, '?'); index >= 0 {
+			actual = actual[:index]
+		}
+	}
+	if matchType == "prefix" {
+		return strings.HasPrefix(actual, stored), nil
+	}
+	return Match(matchType, stored, actual)
+}
+
+// Match validates both sides and compares a normalized request URL to a
+// stored pattern. Wildcards match any sequence of URL characters; the
+// resulting regular expression is built only from escaped literals.
+func Match(matchType, pattern, candidate string) (bool, error) {
+	stored, err := Validate(matchType, pattern)
+	if err != nil {
+		return false, err
+	}
+	actual, err := Normalize(candidate)
+	if err != nil {
+		return false, ErrInvalidURL
+	}
+	if matchType == "exact" {
+		return stored == actual, nil
+	}
+	parts := strings.Split(stored, "*")
+	var b strings.Builder
+	b.WriteString("^")
+	for i, part := range parts {
+		if i > 0 {
+			b.WriteString(".*")
+		}
+		b.WriteString(regexp.QuoteMeta(part))
+	}
+	b.WriteString("$")
+	re, err := regexp.Compile(b.String())
+	if err != nil {
+		return false, ErrInvalidPattern
+	}
+	return re.MatchString(actual), nil
+}
+
+func normalize(raw string) (string, error) {
+	if raw == "" {
+		return "", ErrEmptyURL
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme == "" || u.Host == "" {
+		return "", ErrInvalidURL
+	}
+	scheme := strings.ToLower(u.Scheme)
+	if scheme != "http" && scheme != "https" || u.User != nil || u.Fragment != "" {
+		return "", ErrInvalidURL
+	}
+	hostname := strings.ToLower(u.Hostname())
+	if hostname == "" || strings.ContainsAny(hostname, " \t\r\n") {
+		return "", ErrInvalidURL
+	}
+	port := u.Port()
+	if (scheme == "http" && port == "80") || (scheme == "https" && port == "443") {
+		port = ""
+	}
+	host := hostname
+	if strings.Contains(hostname, ":") {
+		if port == "" {
+			host = "[" + hostname + "]"
+		} else {
+			host = net.JoinHostPort(hostname, port)
+		}
+	} else if port != "" {
+		host += ":" + port
+	}
+	path := u.EscapedPath()
+	if path == "" {
+		path = "/"
+	}
+	return scheme + "://" + host + path + querySuffix(u.RawQuery), nil
+}
+
+func querySuffix(raw string) string {
+	if raw == "" {
+		return ""
+	}
+	return "?" + raw
+}
+
+func hasControl(value string) bool {
+	for _, r := range value {
+		if r < 0x20 || r == 0x7f {
+			return true
+		}
+	}
+	return false
+}
diff --git a/services/ky-matrix-account-service/internal/matcher/url_test.go b/services/ky-matrix-account-service/internal/matcher/url_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9a6b96c8f1753ae26bf89899dabbe9d3526cb32d
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/matcher/url_test.go
@@ -0,0 +1,104 @@
+package matcher
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestNormalizeExactURL(t *testing.T) {
+	got, err := Normalize("HTTPS://SHOP.EXAMPLE.COM:443/product/list?b=2&a=1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "https://shop.example.com/product/list?b=2&a=1" {
+		t.Fatalf("normalized URL = %q", got)
+	}
+	if ok, err := Match("exact", got, "https://shop.example.com/product/list?b=2&a=1"); err != nil || !ok {
+		t.Fatalf("exact match = %v, %v", ok, err)
+	}
+	for _, candidate := range []string{
+		"https://other.example.com/product/list?b=2&a=1",
+		"https://shop.example.com/product/list?b=2&a=2",
+		"http://shop.example.com/product/list?b=2&a=1",
+	} {
+		if ok, err := Match("exact", got, candidate); err != nil || ok {
+			t.Fatalf("exact false case %q = %v, %v", candidate, ok, err)
+		}
+	}
+}
+
+func TestWildcardDomainPathAndQueryBoundaries(t *testing.T) {
+	cases := []struct {
+		pattern, candidate string
+		want               bool
+	}{
+		{"https://shop.example.com/product/*", "https://shop.example.com/product/list", true},
+		{"https://shop.example.com/product/*", "https://shop.example.com/products/list", false},
+		{"https://*.example.com/product/*", "https://shop.example.com/product/list", true},
+		{"https://*.example.com/product/*", "https://evil.example.net/product/list", false},
+		{"https://shop.example.com:8443/product/*", "https://shop.example.com/product/list", false},
+		{"https://shop.example.com/product/*?tab=*", "https://shop.example.com/product/list?tab=detail", true},
+		{"https://shop.example.com/product/*?tab=*", "https://shop.example.com/product/list?other=detail", false},
+		{"https://fxg.jinritemai.com/login/common?channel=zhaoshang", "https://fxg.jinritemai.com/login/common?channel=zhaoshang", true},
+		{"https://fxg.jinritemai.com/login/common?channel=zhaoshang", "https://fxg.jinritemai.com/login/common?channel=other", false},
+	}
+	for _, tc := range cases {
+		got, err := Match("wildcard", tc.pattern, tc.candidate)
+		if err != nil || got != tc.want {
+			t.Errorf("Match(%q,%q) = %v, %v; want %v", tc.pattern, tc.candidate, got, err, tc.want)
+		}
+	}
+}
+
+func TestURLPatternValidation(t *testing.T) {
+	bad := []struct {
+		kind, pattern string
+	}{
+		{"exact", ""},
+		{"exact", "/product/list"},
+		{"exact", "https://example.com/*"},
+		{"wildcard", "https://example.com/" + strings.Repeat("a", MaxPatternLength)},
+		{"wildcard", "https://example.com/" + strings.Repeat("*", MaxWildcardCount+1)},
+		{"wildcard", "https://example.com/\n*"},
+		{"wildcard", "javascript:alert(1)*"},
+	}
+	for _, tc := range bad {
+		if _, err := Validate(tc.kind, tc.pattern); err == nil {
+			t.Errorf("Validate(%q,%q) unexpectedly succeeded", tc.kind, tc.pattern)
+		}
+	}
+	if _, err := Normalize("https://example.com/a#fragment"); err == nil {
+		t.Error("fragment URL unexpectedly succeeded")
+	}
+	if _, err := Normalize("https://user:pass@example.com/a"); err == nil {
+		t.Error("userinfo URL unexpectedly succeeded")
+	}
+}
+
+func TestWildcardWithoutStarIsLiteral(t *testing.T) {
+	pattern, err := Validate("wildcard", "HTTPS://example.com/product")
+	if err != nil || pattern != "https://example.com/product" {
+		t.Fatalf("wildcard literal validation = %q, %v", pattern, err)
+	}
+	ok, err := Match("wildcard", pattern, "https://example.com/product")
+	if err != nil || !ok {
+		t.Fatalf("wildcard literal match = %v, %v", ok, err)
+	}
+}
+
+func TestMatchRulePrefixAndIgnoreQuery(t *testing.T) {
+	ok, err := MatchRule("prefix", "https://shop.example.com/product", "https://shop.example.com/product/list?tab=detail", false)
+	if err != nil || !ok {
+		t.Fatalf("prefix match = %v, %v", ok, err)
+	}
+	ok, err = MatchRule("prefix", "https://shop.example.com/product?old=1", "https://shop.example.com/product/list?new=2", true)
+	if err != nil || !ok {
+		t.Fatalf("ignore-query prefix match = %v, %v", ok, err)
+	}
+	if ok, err := MatchRule("prefix", "https://shop.example.com/product", "https://other.example.com/product/list", false); err != nil || ok {
+		t.Fatalf("cross-domain prefix match = %v, %v", ok, err)
+	}
+	if _, err := ValidateRule("prefix", "https://shop.example.com/*"); err == nil {
+		t.Fatal("prefix wildcard unexpectedly accepted")
+	}
+}
diff --git a/services/ky-matrix-account-service/internal/server/douyin_asset_handlers.go b/services/ky-matrix-account-service/internal/server/douyin_asset_handlers.go
new file mode 100644
index 0000000000000000000000000000000000000000..8e44fe6aca615306ad9feef183474b47aa07fb4e
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/server/douyin_asset_handlers.go
@@ -0,0 +1,124 @@
+package server
+
+import (
+	"log"
+	"net/http"
+	"strings"
+
+	"github.com/Kysion/KyaiCRM/services/ky-matrix-account-service/internal/store"
+)
+
+func assetType(r *http.Request) string { return strings.TrimSpace(r.URL.Query().Get("assetType")) }
+
+func (s *Server) listDouyinAssets(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	items, err := s.store.ListDouyinAssets(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), assetType(r))
+	if err != nil {
+		log.Printf("抖店资产列表查询失败 request=%s script=%s assetType=%s err=%v", requestID(r), r.PathValue("id"), assetType(r), err)
+		writeStoreError(w, r, err)
+		return
+	}
+	writeData(w, r, items)
+}
+
+func (s *Server) getDouyinAsset(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	content := r.URL.Query().Get("content") == "1"
+	if content {
+		ok, err := s.store.HasAny(r.Context(), wc.MembershipID, []string{"platform.matrix_account_douyin_scripts.content_view"})
+		if err != nil || !ok {
+			writeError(w, r, http.StatusForbidden, "permission_denied", "当前身份无权查看源码")
+			return
+		}
+	}
+	item, err := s.store.GetDouyinAsset(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), r.PathValue("assetId"), content)
+	if err != nil {
+		writeStoreError(w, r, err)
+		return
+	}
+	writeData(w, r, item)
+}
+
+func (s *Server) createDouyinAsset(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	key, ok := scriptCommandKey(w, r)
+	if !ok {
+		return
+	}
+	var in store.DouyinAssetInput
+	if !decodeJSON(w, r, &in) {
+		return
+	}
+	item, err := s.store.CreateDouyinAsset(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), wc.UserID, key, in)
+	if err != nil {
+		writeStoreError(w, r, err)
+		return
+	}
+	s.audit(r.Context(), r, wc, "matrix_account.douyin_asset_created", "matrix_account_douyin_script_asset_version", item.ID, map[string]any{"scriptId": item.ScriptID, "assetType": item.AssetType, "sourceSha256": item.SourceSHA256})
+	writeData(w, r, item)
+}
+
+func (s *Server) copyDouyinAsset(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	key, ok := scriptCommandKey(w, r)
+	if !ok {
+		return
+	}
+	item, err := s.store.CopyDouyinAsset(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), r.PathValue("assetId"), wc.UserID, key)
+	if err != nil {
+		writeStoreError(w, r, err)
+		return
+	}
+	s.audit(r.Context(), r, wc, "matrix_account.douyin_asset_copied", "matrix_account.douyin_script_asset_version", item.ID, map[string]any{"sourceAssetId": r.PathValue("assetId"), "assetType": item.AssetType})
+	writeData(w, r, item)
+}
+
+func (s *Server) updateDouyinAsset(w http.ResponseWriter, r *http.Request, wc wsContext) {
+	key, ok := scriptCommandKey(w, r)
+	if !ok {
+		return
+	}
+	rev, ok := expectedRevision(r)
+	if !ok {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "缺少 expected revision")
+		return
+	}
+	var in store.DouyinAssetInput
+	if !decodeJSON(w, r, &in) {
+		return
+	}
+	item, err := s.store.UpdateDouyinAsset(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), r.PathValue("assetId"), wc.UserID, key, rev, in)
+	if err != nil {
+		writeStoreError(w, r, err)
+		return
+	}
+	s.audit(r.Context(), r, wc, "matrix_account.douyin_asset_updated", "matrix_account.douyin_script_asset_version", item.ID, map[string]any{"assetType": item.AssetType, "expectedRevision": rev, "sourceSha256": item.SourceSHA256})
+	writeData(w, r, item)
+}
+
+func (s *Server) changeDouyinAssetState(w http.ResponseWriter, r *http.Request, wc wsContext, action string) {
+	key, ok := scriptCommandKey(w, r)
+	if !ok {
+		return
+	}
+	rev, ok := expectedRevision(r)
+	if !ok {
+		writeError(w, r, http.StatusBadRequest, "validation_error", "缺少 expected revision")
+		return
+	}
+	item, err := s.store.ChangeDouyinAssetState(r.Context(), wc.WorkspaceType, wc.WorkspaceID, r.PathValue("id"), r.PathValue("assetId"), wc.UserID, key, rev, action)
+	if err != nil {
+		writeStoreError(w, r, err)
+		return
+	}
+	s.audit(r.Context(), r, wc, "matrix_account.douyin_asset_"+action, "matrix_account.douyin_script_asset_version", item.ID, map[string]any{"assetType": item.AssetType, "expectedRevision": rev})
+	writeData(w, r, item)
+}
