+++ b/plugins/ky-script-management/src/help-drawer-sizing.test.mjs
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { clampHelpDrawerWidth, HELP_DRAWER_WIDTH_STORAGE_KEY, nudgeHelpDrawerWidth, readHelpDrawerWidth, resizeHelpDrawerWidth, writeHelpDrawerWidth } from "./help-drawer-sizing.ts";
+
+test("帮助抽屉宽度按默认值、边界和视口约束计算", () => {
+  assert.equal(clampHelpDrawerWidth(900, 1920), 900);
+  assert.equal(clampHelpDrawerWidth(100, 1920), 560);
+  assert.equal(clampHelpDrawerWidth(2000, 1920), 1600);
+  assert.equal(clampHelpDrawerWidth(900, 700), 684);
+  assert.equal(clampHelpDrawerWidth(100, 700), 560);
+  assert.equal(clampHelpDrawerWidth(2000, 700), 684);
+  assert.equal(clampHelpDrawerWidth(900, 500), 484);
+  assert.equal(clampHelpDrawerWidth(900, 320), 304);
+  assert.equal(clampHelpDrawerWidth(900, 100), 84);
+});
+
+test("帮助抽屉从实际显示宽度开始按拖拽方向调整", () => {
+  const displayedWidth = clampHelpDrawerWidth(900, 500);
+  assert.equal(displayedWidth, 484);
+  assert.equal(resizeHelpDrawerWidth(displayedWidth, 1000, 900, 1200), 584);
+  assert.equal(resizeHelpDrawerWidth(displayedWidth, 1000, 1100, 1200), 560);
+  assert.equal(resizeHelpDrawerWidth(displayedWidth, 1000, 700, 1200), 784);
+  assert.equal(resizeHelpDrawerWidth(displayedWidth, 1000, 0, 500), 484);
+  assert.equal(resizeHelpDrawerWidth(560, 1000, 976, 1200), 584);
+  assert.equal(resizeHelpDrawerWidth(560, 1000, 1024, 1200), 560);
+});
+
+test("方向键从当前实际显示宽度开始增减", () => {
+  assert.equal(nudgeHelpDrawerWidth(900, -24, 500), 484);
+  assert.equal(nudgeHelpDrawerWidth(900, 24, 500), 484);
+  assert.equal(nudgeHelpDrawerWidth(900, -24, 700), 660);
+  assert.equal(nudgeHelpDrawerWidth(900, 24, 700), 684);
+  assert.equal(nudgeHelpDrawerWidth(560, -24, 1200), 560);
+  assert.equal(nudgeHelpDrawerWidth(560, 24, 1200), 584);
+});
+
+test("帮助抽屉宽度偏好安全读写并按视口约束", () => {
+  const values = new Map();
+  const storage = {
+    getItem: (key) => values.get(key) ?? null,
+    setItem: (key, value) => values.set(key, value)
+  };
+  assert.equal(readHelpDrawerWidth(storage, 1920), 900);
+  values.set(HELP_DRAWER_WIDTH_STORAGE_KEY, "720");
+  assert.equal(readHelpDrawerWidth(storage, 1920), 720);
+  values.set(HELP_DRAWER_WIDTH_STORAGE_KEY, "900");
+  assert.equal(readHelpDrawerWidth(storage, 700), 684);
+  for (const invalid of ["", "0", "-1", "nope"]) {
+    values.set(HELP_DRAWER_WIDTH_STORAGE_KEY, invalid);
+    assert.equal(readHelpDrawerWidth(storage, 1920), 900);
+  }
+  writeHelpDrawerWidth(storage, 900, 700);
+  assert.equal(values.get(HELP_DRAWER_WIDTH_STORAGE_KEY), "684");
+  assert.equal(readHelpDrawerWidth({getItem: () => { throw new Error("blocked") }, setItem: storage.setItem}, 1920), 900);
+  assert.doesNotThrow(() => writeHelpDrawerWidth({getItem: storage.getItem, setItem: () => { throw new Error("blocked") }}, 900, 1920));
+});
diff --git a/plugins/ky-script-management/src/help-drawer-sizing.ts b/plugins/ky-script-management/src/help-drawer-sizing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..303c0a80e9422846b62283155aec126e56bdfb95
--- /dev/null
+++ b/plugins/ky-script-management/src/help-drawer-sizing.ts
@@ -0,0 +1,43 @@
+const HELP_DRAWER_VIEWPORT_GUTTER = 16;
+const HELP_DRAWER_MIN_WIDTH = 560;
+const HELP_DRAWER_MAX_WIDTH = 1600;
+export const HELP_DRAWER_DEFAULT_WIDTH = 900;
+export const HELP_DRAWER_WIDTH_STORAGE_KEY = "ky-script-management:help-drawer-width";
+
+export interface HelpDrawerStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export const clampHelpDrawerWidth = (width: number, viewportWidth: number): number => {
+  const safeWidth = Number.isFinite(width) ? width : HELP_DRAWER_MIN_WIDTH;
+  const safeViewportWidth = Number.isFinite(viewportWidth) ? viewportWidth : HELP_DRAWER_MAX_WIDTH + HELP_DRAWER_VIEWPORT_GUTTER;
+  const maxWidth = Math.min(HELP_DRAWER_MAX_WIDTH, Math.max(0, safeViewportWidth - HELP_DRAWER_VIEWPORT_GUTTER));
+  const minWidth = Math.min(HELP_DRAWER_MIN_WIDTH, maxWidth);
+  return Math.min(maxWidth, Math.max(minWidth, safeWidth));
+};
+
+export const resizeHelpDrawerWidth = (startWidth: number, startX: number, currentX: number, viewportWidth: number): number =>
+  clampHelpDrawerWidth(startWidth + startX - currentX, viewportWidth);
+
+export const nudgeHelpDrawerWidth = (width: number, delta: number, viewportWidth: number): number =>
+  clampHelpDrawerWidth(clampHelpDrawerWidth(width, viewportWidth) + delta, viewportWidth);
+
+export const readHelpDrawerWidth = (storage: HelpDrawerStorage | null | undefined, viewportWidth: number): number => {
+  let stored: string | null = null;
+  try {
+    stored = storage?.getItem(HELP_DRAWER_WIDTH_STORAGE_KEY) ?? null;
+  } catch {
+    return clampHelpDrawerWidth(HELP_DRAWER_DEFAULT_WIDTH, viewportWidth);
+  }
+  const parsed = stored === null ? Number.NaN : Number(stored.trim());
+  return clampHelpDrawerWidth(Number.isFinite(parsed) && parsed > 0 ? parsed : HELP_DRAWER_DEFAULT_WIDTH, viewportWidth);
+};
+
+export const writeHelpDrawerWidth = (storage: HelpDrawerStorage | null | undefined, width: number, viewportWidth: number): void => {
+  try {
+    storage?.setItem(HELP_DRAWER_WIDTH_STORAGE_KEY, String(clampHelpDrawerWidth(width, viewportWidth)));
+  } catch {
+    // localStorage may be blocked by browser privacy or sandbox policy.
+  }
+};
