diff --git a/services/ky-matrix-account-service/internal/store/script_runtime_manifest.go b/services/ky-matrix-account-service/internal/store/script_runtime_manifest.go
new file mode 100644
index 0000000000000000000000000000000000000000..5ee9484824bfc67ae17a9f7edb0bf6b83acfd940
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/store/script_runtime_manifest.go
@@ -0,0 +1,326 @@
+package store
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"sort"
+)
+
+type runtimeManifestAsset struct {
+	AssetType               string             `json:"assetType"`
+	Identifier              string             `json:"identifier"`
+	Version                 string             `json:"version"`
+	EffectiveVersionID      string             `json:"effectiveVersionId,omitempty"`
+	RunAt                   string             `json:"runAt,omitempty"`
+	Priority                int                `json:"priority"`
+	Enabled                 bool               `json:"enabled"`
+	Status                  string             `json:"status"`
+	SourceSHA256            string             `json:"sourceSha256"`
+	MatchRules              []RuntimeMatchRule `json:"matchRules,omitempty"`
+	MatchConfiguredURLRules *bool              `json:"matchConfiguredUrlRules,omitempty"`
+}
+
+type runtimeManifestPublicAsset struct {
+	AssetType               string             `json:"assetType"`
+	Identifier              string             `json:"identifier"`
+	Version                 string             `json:"version"`
+	EffectiveVersionID      string             `json:"effectiveVersionId,omitempty"`
+	RunAt                   string             `json:"runAt,omitempty"`
+	Priority                int                `json:"priority"`
+	Enabled                 bool               `json:"enabled"`
+	Status                  string             `json:"status"`
+	SourceSHA256            string             `json:"sourceSha256"`
+	MatchRules              []RuntimeMatchRule `json:"matchRules,omitempty"`
+	MatchConfiguredURLRules *bool              `json:"matchConfiguredUrlRules,omitempty"`
+}
+
+type runtimeManifestInput struct {
+	WorkspaceType string                       `json:"workspaceType"`
+	WorkspaceID   string                       `json:"workspaceId"`
+	Platform      string                       `json:"platform"`
+	URL           string                       `json:"url"`
+	Origin        string                       `json:"origin,omitempty"`
+	VersionPolicy string                       `json:"versionPolicy"`
+	Assets        []runtimeManifestAsset       `json:"assets"`
+	Public        []runtimeManifestPublicAsset `json:"public"`
+	PublicStyles  []runtimeManifestPublicAsset `json:"publicStyles"`
+}
+
+// ScriptRuntimeManifestAsset 是不含源码的已发布资产清单项。
+type ScriptRuntimeManifestAsset struct {
+	AssetType          string             `json:"assetType"`
+	Identifier         string             `json:"identifier"`
+	Version            string             `json:"version"`
+	EffectiveVersionID string             `json:"effectiveVersionId,omitempty"`
+	RunAt              string             `json:"runAt,omitempty"`
+	Priority           int                `json:"priority"`
+	Enabled            bool               `json:"enabled"`
+	SourceSHA256       string             `json:"sourceSha256"`
+	Status             string             `json:"status"`
+	MatchRules         []RuntimeMatchRule `json:"matchRules,omitempty"`
+}
+
+// ScriptRuntimeManifestPublic 是不含源码的公共脚本清单项。
+type ScriptRuntimeManifestPublicStyle struct {
+	AssetType          string             `json:"assetType"`
+	Identifier         string             `json:"identifier"`
+	Version            string             `json:"version"`
+	EffectiveVersionID string             `json:"effectiveVersionId,omitempty"`
+	RunAt              string             `json:"runAt,omitempty"`
+	Priority           int                `json:"priority"`
+	Enabled            bool               `json:"enabled"`
+	SourceSHA256       string             `json:"sourceSha256"`
+	Status             string             `json:"status"`
+	MatchRules         []RuntimeMatchRule `json:"matchRules,omitempty"`
+}
+
+type ScriptRuntimeManifestPublic struct {
+	AssetType          string `json:"assetType"`
+	Identifier         string `json:"identifier"`
+	Version            string `json:"version"`
+	EffectiveVersionID string `json:"effectiveVersionId,omitempty"`
+	RunAt              string `json:"runAt,omitempty"`
+	Priority           int    `json:"priority"`
+	Enabled            bool   `json:"enabled"`
+	SourceSHA256       string `json:"sourceSha256"`
+	Status             string `json:"status"`
+}
+
+// ScriptRuntimeManifest 是工作区/平台级已发布资源清单，不包含源码正文。
+type ScriptRuntimeManifest struct {
+	SchemaVersion    string                             `json:"schemaVersion"`
+	WorkspaceType    string                             `json:"workspaceType"`
+	WorkspaceID      string                             `json:"workspaceId"`
+	Platform         string                             `json:"platform"`
+	VersionPolicy    string                             `json:"versionPolicy"`
+	ManifestRevision string                             `json:"manifestRevision"`
+	Assets           []ScriptRuntimeManifestAsset       `json:"assets"`
+	Public           []ScriptRuntimeManifestPublic      `json:"public"`
+	PublicStyles     []ScriptRuntimeManifestPublicStyle `json:"publicStyles"`
+}
+
+// ScriptRuntimeManifestRevision returns a stable digest of the complete runtime resource set.
+// It deliberately excludes source text and retrieval time so identical results remain comparable.
+func ScriptRuntimeManifestRevision(req ScriptRuntimeResolveRequest, assets []RuntimeAsset, public []PublicRuntimeScript, publicStyles ...[]PublicRuntimeStyle) string {
+	policy := req.VersionPolicy
+	if policy == "" {
+		policy = "active_only"
+	}
+	canonical := runtimeManifestInput{
+		WorkspaceType: req.WorkspaceType,
+		WorkspaceID:   req.WorkspaceID,
+		Platform:      req.Platform,
+		URL:           req.URL,
+		VersionPolicy: policy,
+		Assets:        make([]runtimeManifestAsset, 0, len(assets)),
+		Public:        make([]runtimeManifestPublicAsset, 0, len(public)),
+	}
+	for _, asset := range assets {
+		canonical.Assets = append(canonical.Assets, runtimeManifestAsset{
+			AssetType:               asset.AssetType,
+			Identifier:              asset.Identifier,
+			Version:                 asset.Version,
+			EffectiveVersionID:      asset.EffectiveVersionID,
+			RunAt:                   asset.RunAt,
+			Priority:                asset.Priority,
+			Enabled:                 asset.Enabled,
+			Status:                  asset.Status,
+			SourceSHA256:            asset.SourceSHA256,
+			MatchRules:              asset.MatchRules,
+			MatchConfiguredURLRules: asset.MatchConfiguredURLRules,
+		})
+	}
+	for _, asset := range public {
+		canonical.Public = append(canonical.Public, runtimeManifestPublicAsset{
+			AssetType:          "public",
+			Identifier:         asset.Identifier,
+			Version:            asset.Version,
+			EffectiveVersionID: asset.ID,
+			Enabled:            true,
+			Status:             "enabled",
+			SourceSHA256:       asset.SourceSHA256,
+		})
+	}
+	for _, styles := range publicStyles {
+		for _, asset := range styles {
+			canonical.PublicStyles = append(canonical.PublicStyles, runtimeManifestPublicAsset{AssetType: "public-style", Identifier: asset.Identifier, Version: asset.Version, EffectiveVersionID: asset.ID, RunAt: asset.RunAt, Priority: asset.Priority, Enabled: asset.Enabled, Status: "enabled", SourceSHA256: asset.SourceSHA256, MatchRules: asset.MatchRules, MatchConfiguredURLRules: asset.MatchConfiguredURLRules})
+		}
+	}
+	sort.Slice(canonical.Assets, func(i, j int) bool {
+		left, right := canonical.Assets[i], canonical.Assets[j]
+		if left.AssetType != right.AssetType {
+			return left.AssetType < right.AssetType
+		}
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		if left.EffectiveVersionID != right.EffectiveVersionID {
+			return left.EffectiveVersionID < right.EffectiveVersionID
+		}
+		if left.RunAt != right.RunAt {
+			return left.RunAt < right.RunAt
+		}
+		if left.Priority != right.Priority {
+			return left.Priority < right.Priority
+		}
+		if left.SourceSHA256 != right.SourceSHA256 {
+			return left.SourceSHA256 < right.SourceSHA256
+		}
+		if boolPointerOrder(left.MatchConfiguredURLRules) != boolPointerOrder(right.MatchConfiguredURLRules) {
+			return boolPointerOrder(left.MatchConfiguredURLRules) < boolPointerOrder(right.MatchConfiguredURLRules)
+		}
+		return runtimeMatchRulesKey(left.MatchRules) < runtimeMatchRulesKey(right.MatchRules)
+	})
+	sort.Slice(canonical.Public, func(i, j int) bool {
+		left, right := canonical.Public[i], canonical.Public[j]
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		return left.SourceSHA256 < right.SourceSHA256
+	})
+	sort.Slice(canonical.PublicStyles, func(i, j int) bool {
+		left, right := canonical.PublicStyles[i], canonical.PublicStyles[j]
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		if left.RunAt != right.RunAt {
+			return left.RunAt < right.RunAt
+		}
+		if left.Priority != right.Priority {
+			return left.Priority < right.Priority
+		}
+		if left.EffectiveVersionID != right.EffectiveVersionID {
+			return left.EffectiveVersionID < right.EffectiveVersionID
+		}
+		if left.SourceSHA256 != right.SourceSHA256 {
+			return left.SourceSHA256 < right.SourceSHA256
+		}
+		if boolPointerOrder(left.MatchConfiguredURLRules) != boolPointerOrder(right.MatchConfiguredURLRules) {
+			return boolPointerOrder(left.MatchConfiguredURLRules) < boolPointerOrder(right.MatchConfiguredURLRules)
+		}
+		return runtimeMatchRulesKey(left.MatchRules) < runtimeMatchRulesKey(right.MatchRules)
+	})
+	payload, _ := json.Marshal(canonical)
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
+
+// ScriptRuntimeManifestRevisionForManifest 计算不依赖查询顺序的全量清单摘要。
+func ScriptRuntimeManifestRevisionForManifest(req ScriptRuntimeManifestRequest, assets []ScriptRuntimeManifestAsset, public []ScriptRuntimeManifestPublic, publicStyles ...[]ScriptRuntimeManifestPublicStyle) string {
+	canonical := runtimeManifestInput{
+		WorkspaceType: req.WorkspaceType,
+		WorkspaceID:   req.WorkspaceID,
+		Platform:      req.Platform,
+		Origin:        req.Origin,
+		URL:           req.Origin,
+		VersionPolicy: req.VersionPolicy,
+	}
+	for _, asset := range assets {
+		canonical.Assets = append(canonical.Assets, runtimeManifestAsset{AssetType: asset.AssetType, Identifier: asset.Identifier, Version: asset.Version, EffectiveVersionID: asset.EffectiveVersionID, RunAt: asset.RunAt, Priority: asset.Priority, Enabled: asset.Enabled, Status: asset.Status, SourceSHA256: asset.SourceSHA256, MatchRules: asset.MatchRules})
+	}
+	for _, asset := range public {
+		canonical.Public = append(canonical.Public, runtimeManifestPublicAsset{AssetType: asset.AssetType, Identifier: asset.Identifier, Version: asset.Version, EffectiveVersionID: asset.EffectiveVersionID, RunAt: asset.RunAt, Priority: asset.Priority, Enabled: asset.Enabled, Status: asset.Status, SourceSHA256: asset.SourceSHA256})
+	}
+	for _, styles := range publicStyles {
+		for _, asset := range styles {
+			canonical.PublicStyles = append(canonical.PublicStyles, runtimeManifestPublicAsset{AssetType: asset.AssetType, Identifier: asset.Identifier, Version: asset.Version, EffectiveVersionID: asset.EffectiveVersionID, RunAt: asset.RunAt, Priority: asset.Priority, Enabled: asset.Enabled, Status: asset.Status, SourceSHA256: asset.SourceSHA256, MatchRules: asset.MatchRules})
+		}
+	}
+	sort.Slice(canonical.Assets, func(i, j int) bool {
+		left, right := canonical.Assets[i], canonical.Assets[j]
+		if left.AssetType != right.AssetType {
+			return left.AssetType < right.AssetType
+		}
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		if left.EffectiveVersionID != right.EffectiveVersionID {
+			return left.EffectiveVersionID < right.EffectiveVersionID
+		}
+		if left.RunAt != right.RunAt {
+			return left.RunAt < right.RunAt
+		}
+		if left.Priority != right.Priority {
+			return left.Priority < right.Priority
+		}
+		if left.Enabled != right.Enabled {
+			return !left.Enabled
+		}
+		if left.Status != right.Status {
+			return left.Status < right.Status
+		}
+		if left.SourceSHA256 != right.SourceSHA256 {
+			return left.SourceSHA256 < right.SourceSHA256
+		}
+		return runtimeMatchRulesKey(left.MatchRules) < runtimeMatchRulesKey(right.MatchRules)
+	})
+	sort.Slice(canonical.Public, func(i, j int) bool {
+		left, right := canonical.Public[i], canonical.Public[j]
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		if left.EffectiveVersionID != right.EffectiveVersionID {
+			return left.EffectiveVersionID < right.EffectiveVersionID
+		}
+		if left.SourceSHA256 != right.SourceSHA256 {
+			return left.SourceSHA256 < right.SourceSHA256
+		}
+		return runtimeMatchRulesKey(left.MatchRules) < runtimeMatchRulesKey(right.MatchRules)
+	})
+	sort.Slice(canonical.PublicStyles, func(i, j int) bool {
+		left, right := canonical.PublicStyles[i], canonical.PublicStyles[j]
+		if left.Identifier != right.Identifier {
+			return left.Identifier < right.Identifier
+		}
+		if left.Version != right.Version {
+			return left.Version < right.Version
+		}
+		if left.RunAt != right.RunAt {
+			return left.RunAt < right.RunAt
+		}
+		if left.Priority != right.Priority {
+			return left.Priority < right.Priority
+		}
+		if left.EffectiveVersionID != right.EffectiveVersionID {
+			return left.EffectiveVersionID < right.EffectiveVersionID
+		}
+		if left.SourceSHA256 != right.SourceSHA256 {
+			return left.SourceSHA256 < right.SourceSHA256
+		}
+		return runtimeMatchRulesKey(left.MatchRules) < runtimeMatchRulesKey(right.MatchRules)
+	})
+	payload, _ := json.Marshal(canonical)
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
+
+func runtimeMatchRulesKey(rules []RuntimeMatchRule) string {
+	payload, _ := json.Marshal(rules)
+	return string(payload)
+}
+
+func boolPointerOrder(value *bool) int {
+	if value == nil {
+		return 0
+	}
+	if !*value {
+		return 1
+	}
+	return 2
+}
diff --git a/services/ky-matrix-account-service/internal/store/script_runtime_manifest_store.go b/services/ky-matrix-account-service/internal/store/script_runtime_manifest_store.go
new file mode 100644
index 0000000000000000000000000000000000000000..7f1731f33475cd9e8e65fe10a8b087cfcb339d15
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/store/script_runtime_manifest_store.go
@@ -0,0 +1,141 @@
+package store
+
+import (
+	"context"
+	"strconv"
+)
+
+// ListScriptRuntimeManifest 返回工作区/平台的全部已发布资产元数据，不做 URL 匹配。
+func (s *Store) ListScriptRuntimeManifest(ctx context.Context, req ScriptRuntimeManifestRequest) (ScriptRuntimeManifest, error) {
+	policy := req.VersionPolicy
+	if policy == "" {
+		policy = "latest_released"
+	}
+	if policy != "active_only" && policy != "latest_released" {
+		return ScriptRuntimeManifest{}, ErrValidation
+	}
+	assetFilter := "v.status IN ('released','active')"
+	if policy == "active_only" {
+		assetFilter = "v.status='active' AND ((v.asset_type='script' AND v.id=s.effective_script_asset_version_id) OR (v.asset_type='style' AND v.id=s.effective_style_asset_version_id))"
+	}
+	query := `SELECT s.identifier,v.asset_type,v.version,v.id,
+CASE WHEN v.asset_type='script' THEN COALESCE(s.effective_script_asset_version_id,'') ELSE COALESCE(s.effective_style_asset_version_id,'') END,
+CASE WHEN v.asset_type='script' THEN COALESCE(s.run_at,'document_start') ELSE COALESCE(v.run_at,s.run_at,'document_start') END,
+COALESCE(v.priority,s.priority),COALESCE(v.enabled,true),v.source_sha256,v.status,s.match_type,s.match_url,COALESCE(s.match_rules,'[]'::jsonb)
+FROM ky_matrix_account_douyin_script s JOIN ky_matrix_account_douyin_script_asset_version v ON v.script_id=s.id
+WHERE s.workspace_type=$1 AND s.workspace_id=$2 AND s.platform=$3 AND s.status='enabled' AND s.deleted_at IS NULL AND ` + assetFilter + `
+AND v.id=(SELECT latest.id FROM ky_matrix_account_douyin_script_asset_version latest WHERE latest.script_id=s.id AND latest.asset_type=v.asset_type AND ` + assetFilterForLatest(policy) + ` ORDER BY latest.created_at DESC,latest.id DESC LIMIT 1)
+ORDER BY s.identifier,v.asset_type,v.version,v.id`
+	rows, err := s.db.QueryContext(ctx, query, req.WorkspaceType, req.WorkspaceID, req.Platform)
+	if err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+	defer rows.Close()
+	assets := make([]ScriptRuntimeManifestAsset, 0)
+	for rows.Next() {
+		var item ScriptRuntimeManifestAsset
+		var assetID, matchType, matchURL string
+		var rawRules []byte
+		if err := rows.Scan(&item.Identifier, &item.AssetType, &item.Version, &assetID, &item.EffectiveVersionID, &item.RunAt, &item.Priority, &item.Enabled, &item.SourceSHA256, &item.Status, &matchType, &matchURL, &rawRules); err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		rules, err := decodeRuntimeMatchRules(rawRules, matchType, matchURL)
+		if err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		if len(rules) == 0 {
+			rules = nil
+		}
+		normalizedRules, err := normalizeRuntimeMatchRules(rules, matchType, matchURL)
+		if err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		item.MatchRules = enabledRuntimeMatchRules(normalizedRules)
+		assets = append(assets, item)
+	}
+	if err := rows.Err(); err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+
+	publicRows, err := s.db.QueryContext(ctx, `SELECT id,identifier,revision,source_sha256,enabled FROM ky_matrix_account_public_script WHERE workspace_type=$1 AND workspace_id=$2 AND platform=$3 AND deleted_at IS NULL ORDER BY identifier,id`, req.WorkspaceType, req.WorkspaceID, req.Platform)
+	if err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+	defer publicRows.Close()
+	public := make([]ScriptRuntimeManifestPublic, 0)
+	for publicRows.Next() {
+		var item ScriptRuntimeManifestPublic
+		var publicID string
+		var revision int
+		if err := publicRows.Scan(&publicID, &item.Identifier, &revision, &item.SourceSHA256, &item.Enabled); err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		item.AssetType, item.EffectiveVersionID, item.RunAt, item.Priority = "public", publicID, "document_start", 0
+		item.Version = strconv.Itoa(revision)
+		if item.Enabled {
+			item.Status = "enabled"
+		} else {
+			item.Status = "disabled"
+		}
+		public = append(public, item)
+	}
+	if err := publicRows.Err(); err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+
+	styleRows, err := s.db.QueryContext(ctx, `SELECT id,identifier,revision,source_sha256,match_type,match_url,run_at,priority,enabled,status FROM ky_matrix_account_public_style WHERE workspace_type=$1 AND workspace_id=$2 AND platform=$3 AND deleted_at IS NULL AND status=$4 ORDER BY identifier,id`, req.WorkspaceType, req.WorkspaceID, req.Platform, "enabled")
+	if err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+	defer styleRows.Close()
+	publicStyles := make([]ScriptRuntimeManifestPublicStyle, 0)
+	for styleRows.Next() {
+		var item ScriptRuntimeManifestPublicStyle
+		var id, matchType, matchURL string
+		var revision int
+		if err := styleRows.Scan(&id, &item.Identifier, &revision, &item.SourceSHA256, &matchType, &matchURL, &item.RunAt, &item.Priority, &item.Enabled, &item.Status); err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		rules, err := normalizeRuntimeMatchRules([]RuntimeMatchRule{{ID: "legacy", MatchType: matchType, Pattern: matchURL, Enabled: true, SortOrder: 0}}, "", "")
+		if err != nil {
+			return ScriptRuntimeManifest{}, err
+		}
+		item.MatchRules = enabledRuntimeMatchRules(rules)
+		if req.Origin != "" {
+			matched, err := matchRuntimeRules(rules, "", "", req.Origin)
+			if err != nil {
+				return ScriptRuntimeManifest{}, err
+			}
+			if !matched {
+				continue
+			}
+		}
+		item.AssetType = "public-style"
+		item.EffectiveVersionID = id
+		item.Version = strconv.Itoa(revision)
+		publicStyles = append(publicStyles, item)
+	}
+	if err := styleRows.Err(); err != nil {
+		return ScriptRuntimeManifest{}, err
+	}
+
+	revision := ScriptRuntimeManifestRevisionForManifest(req, assets, public, publicStyles)
+	return ScriptRuntimeManifest{
+		SchemaVersion:    "1",
+		WorkspaceType:    req.WorkspaceType,
+		WorkspaceID:      req.WorkspaceID,
+		Platform:         req.Platform,
+		VersionPolicy:    policy,
+		ManifestRevision: revision,
+		Assets:           assets,
+		Public:           public,
+		PublicStyles:     publicStyles,
+	}, nil
+}
+
+func assetFilterForLatest(policy string) string {
+	if policy == "active_only" {
+		return "latest.status='active' AND ((latest.asset_type='script' AND latest.id=s.effective_script_asset_version_id) OR (latest.asset_type='style' AND latest.id=s.effective_style_asset_version_id))"
+	}
+	return "latest.status IN ('released','active')"
+}
diff --git a/services/ky-matrix-account-service/internal/store/script_runtime_manifest_test.go b/services/ky-matrix-account-service/internal/store/script_runtime_manifest_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..72e7d527550d3b491901f1c2b763058aa4cb61ba
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/store/script_runtime_manifest_test.go
@@ -0,0 +1,219 @@
+package store
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func manifestRequest(policy string) ScriptRuntimeResolveRequest {
+	return ScriptRuntimeResolveRequest{
+		WorkspaceType: "platform",
+		WorkspaceID:   "platform_root",
+		Platform:      "douyin",
+		URL:           "https://example.com/product?tab=1",
+		VersionPolicy: policy,
+	}
+}
+
+func manifestAssets() ([]ScriptRuntimeCandidate, []PublicRuntimeScript) {
+	return []ScriptRuntimeCandidate{
+		{
+			AssetType:          "script",
+			Identifier:         "DD_LOGIN",
+			Version:            "1.0.0",
+			EffectiveVersionID: "asset-script-1",
+			RunAt:              "document_start",
+			Priority:           1000,
+			SourceSHA256:       "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		},
+		{
+			AssetType:          "style",
+			Identifier:         "DD_LOGIN",
+			Version:            "1.0.0",
+			EffectiveVersionID: "asset-style-1",
+			RunAt:              "document_idle",
+			Priority:           1000,
+			SourceSHA256:       "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+		},
+	}, []PublicRuntimeScript{{
+		Identifier:   "PUBLIC_HELPER",
+		Version:      "7",
+		SourceSHA256: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
+	}}
+}
+
+func TestScriptRuntimeManifestRevisionActiveOnlyIsStableForResourceOrder(t *testing.T) {
+	req := manifestRequest("active_only")
+	assets, public := manifestAssets()
+	want := ScriptRuntimeManifestRevision(req, assets, public)
+	if want == "" {
+		t.Fatal("manifest revision must be non-empty")
+	}
+	assets[0], assets[1] = assets[1], assets[0]
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got != want {
+		t.Fatalf("resource order changed revision: got %s want %s", got, want)
+	}
+	public[0].SourceSHA256 = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got == want {
+		t.Fatal("public resource hash change did not change revision")
+	}
+}
+
+func TestScriptRuntimeManifestRevisionLatestReleasedChangesWithVersionOrHash(t *testing.T) {
+	req := manifestRequest("latest_released")
+	assets, public := manifestAssets()
+	base := ScriptRuntimeManifestRevision(req, assets, public)
+	assets[0].Version = "1.0.1"
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got == base {
+		t.Fatal("asset version change did not change revision")
+	}
+	assets[0].Version = "1.0.0"
+	assets[0].SourceSHA256 = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got == base {
+		t.Fatal("asset hash change did not change revision")
+	}
+}
+
+func TestScriptRuntimeManifestRevisionChangesWhenCandidateRulesChange(t *testing.T) {
+	req := manifestRequest("latest_released")
+	assets, public := manifestAssets()
+	assets[0].MatchRules = []RuntimeMatchRule{{ID: "login", MatchType: "exact", Pattern: "https://example.com/login", Enabled: true}}
+	base := ScriptRuntimeManifestRevision(req, assets, public)
+	assets[0].MatchRules[0].Pattern = "https://example.com/shop/*"
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got == base {
+		t.Fatal("business URL match rule change did not change resolve manifest revision")
+	}
+	assets[0].MatchRules[0].Pattern = "https://example.com/login"
+	flag := false
+	assets[0].MatchConfiguredURLRules = &flag
+	if got := ScriptRuntimeManifestRevision(req, assets, public); got == base {
+		t.Fatal("per-asset URL rule bypass change did not change resolve manifest revision")
+	}
+	styleFlag := true
+	styles := []PublicRuntimeStyle{{ID: "public-style-1", Identifier: "PUBLIC_STYLE", Version: "3", RunAt: "document_start", Enabled: true, SourceSHA256: "style-hash", MatchConfiguredURLRules: &styleFlag, MatchRules: []RuntimeMatchRule{{ID: "style", MatchType: "wildcard", Pattern: "https://example.com/a/*", Enabled: true}}}}
+	styleRevision := ScriptRuntimeManifestRevision(req, nil, public, styles)
+	styles[0].MatchRules[0].Pattern = "https://example.com/b/*"
+	if got := ScriptRuntimeManifestRevision(req, nil, public, styles); got == styleRevision {
+		t.Fatal("public style URL match rule change did not change resolve manifest revision")
+	}
+}
+
+func TestScriptRuntimeManifestRevisionSeparatesContextAndPolicy(t *testing.T) {
+	assets, public := manifestAssets()
+	base := ScriptRuntimeManifestRevision(manifestRequest("active_only"), assets, public)
+	for name, req := range map[string]ScriptRuntimeResolveRequest{
+		"latest released": manifestRequest("latest_released"),
+		"other workspace": func() ScriptRuntimeResolveRequest {
+			r := manifestRequest("active_only")
+			r.WorkspaceID = "other"
+			return r
+		}(),
+		"other platform": func() ScriptRuntimeResolveRequest {
+			r := manifestRequest("active_only")
+			r.Platform = "kuaishou"
+			return r
+		}(),
+		"other url": func() ScriptRuntimeResolveRequest {
+			r := manifestRequest("active_only")
+			r.URL = "https://example.com/other"
+			return r
+		}(),
+	} {
+		if got := ScriptRuntimeManifestRevision(req, assets, public); got == base {
+			t.Fatalf("%s reused manifest revision %s", name, got)
+		}
+	}
+}
+
+func TestScriptRuntimeManifestRevisionIncludesPublishedMetadata(t *testing.T) {
+	req := ScriptRuntimeManifestRequest{WorkspaceType: "platform", WorkspaceID: "platform_root", Platform: "douyin", VersionPolicy: "latest_released", Origin: "https://example.com/"}
+	assets := []ScriptRuntimeManifestAsset{{AssetType: "style", Identifier: "DD_LOGIN", Version: "1.0.0", EffectiveVersionID: "style-1", RunAt: "document_start", Priority: 0, Enabled: true, Status: "active", SourceSHA256: "a"}}
+	base := ScriptRuntimeManifestRevisionForManifest(req, assets, nil)
+	assets[0].RunAt = "document_idle"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, nil); got == base {
+		t.Fatal("style runAt change did not change manifest revision")
+	}
+	assets[0].RunAt = "document_start"
+	assets[0].Priority = 10
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, nil); got == base {
+		t.Fatal("style priority change did not change manifest revision")
+	}
+	assets[0].Priority = 0
+	assets[0].Enabled = false
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, nil); got == base {
+		t.Fatal("style enabled change did not change manifest revision")
+	}
+}
+
+func TestScriptRuntimeManifestRevisionForManifestIncludesURLRules(t *testing.T) {
+	req := ScriptRuntimeManifestRequest{WorkspaceType: "platform", WorkspaceID: "platform_root", Platform: "douyin", VersionPolicy: "latest_released"}
+	assets := []ScriptRuntimeManifestAsset{{AssetType: "script", Identifier: "LOGIN", Version: "1.0.0", EffectiveVersionID: "v1", Status: "released", SourceSHA256: "hash", MatchRules: []RuntimeMatchRule{{ID: "login", MatchType: "exact", Pattern: "https://example.com/login", Enabled: true}}}}
+	base := ScriptRuntimeManifestRevisionForManifest(req, assets, nil)
+	assets[0].MatchRules[0].Pattern = "https://example.com/shop/*"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, nil); got == base {
+		t.Fatal("manifest API revision did not change after business match rule changed")
+	}
+	styles := []ScriptRuntimeManifestPublicStyle{{AssetType: "public-style", Identifier: "COMMON_STYLE", Version: "2", EffectiveVersionID: "style-2", Status: "enabled", SourceSHA256: "style-hash", MatchRules: []RuntimeMatchRule{{ID: "legacy", MatchType: "wildcard", Pattern: "https://example.com/a/*", Enabled: true}}}}
+	base = ScriptRuntimeManifestRevisionForManifest(req, nil, nil, styles)
+	styles[0].MatchRules[0].Pattern = "https://example.com/b/*"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, nil, nil, styles); got == base {
+		t.Fatal("manifest API revision did not change after public style match rule changed")
+	}
+}
+
+func TestScriptRuntimeManifestRevisionSortsAssetsAndSeparatesWorkspacePlatform(t *testing.T) {
+	req := ScriptRuntimeManifestRequest{WorkspaceType: "platform", WorkspaceID: "platform_root", Platform: "douyin", VersionPolicy: "latest_released"}
+	assets := []ScriptRuntimeManifestAsset{{AssetType: "script", Identifier: "B", Version: "1.0.0", EffectiveVersionID: "b", Status: "released", SourceSHA256: "b"}, {AssetType: "style", Identifier: "A", Version: "1.0.0", EffectiveVersionID: "a", Status: "active", SourceSHA256: "a"}}
+	public := []ScriptRuntimeManifestPublic{{AssetType: "public", Identifier: "COMMON", Version: "2", Status: "enabled", SourceSHA256: "p"}}
+	base := ScriptRuntimeManifestRevisionForManifest(req, assets, public)
+	assets[0], assets[1] = assets[1], assets[0]
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, public); got != base {
+		t.Fatal("resource order changed manifest revision")
+	}
+	req.WorkspaceID = "other"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, public); got == base {
+		t.Fatal("workspace change reused manifest revision")
+	}
+	req.WorkspaceID = "platform_root"
+	req.Platform = "kuaishou"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, public); got == base {
+		t.Fatal("platform change reused manifest revision")
+	}
+	req.Platform = "douyin"
+	req.VersionPolicy = "active_only"
+	if got := ScriptRuntimeManifestRevisionForManifest(req, assets, public); got == base {
+		t.Fatal("version policy change reused manifest revision")
+	}
+}
+
+func TestScriptRuntimeManifestQueryIsFullMetadataOnly(t *testing.T) {
+	source, err := os.ReadFile("script_runtime_manifest_store.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(source)
+	for _, want := range []string{
+		"s.workspace_type=$1 AND s.workspace_id=$2 AND s.platform=$3",
+		"v.status IN ('released','active')",
+		"v.status='active'",
+		"effective_script_asset_version_id",
+		"effective_style_asset_version_id",
+		"source_sha256",
+		"s.match_rules",
+		"item.MatchRules = enabledRuntimeMatchRules",
+		"CASE WHEN v.asset_type='script' THEN COALESCE(s.run_at,'document_start') ELSE COALESCE(v.run_at,s.run_at,'document_start') END",
+		"SELECT id,identifier,revision,source_sha256,enabled",
+		"ORDER BY s.identifier,v.asset_type,v.version,v.id",
+	} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("manifest query contract missing %q", want)
+		}
+	}
+	if strings.Contains(text, "source_content") {
+		t.Fatal("manifest query must not return source content")
+	}
+	if strings.Contains(text, "CASE WHEN v.asset_type='script' THEN 'document_start'") {
+		t.Fatal("manifest query must preserve configured script runAt")
+	}
+}
diff --git a/services/ky-matrix-account-service/internal/store/script_runtime_match_rules.go b/services/ky-matrix-account-service/internal/store/script_runtime_match_rules.go
new file mode 100644
index 0000000000000000000000000000000000000000..d6e00bd4fd695a739b10bf880415a770873c325e
--- /dev/null
+++ b/services/ky-matrix-account-service/internal/store/script_runtime_match_rules.go
@@ -0,0 +1,125 @@
+package store
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/Kysion/KyaiCRM/services/ky-matrix-account-service/internal/matcher"
+)
+
+const (
+	maxRuntimeMatchRules    = 32
+	maxRuntimeRuleRemark    = 200
+	maxRuntimeRuleSortOrder = 1_000_000
+)
+
+// RuntimeMatchRule 是平台无关的 URL 匹配规则。
+type RuntimeMatchRule struct {
+	ID          string `json:"id"`
+	MatchType   string `json:"matchType"`
+	Pattern     string `json:"pattern"`
+	IgnoreQuery bool   `json:"ignoreQuery"`
+	Enabled     bool   `json:"enabled"`
+	Remark      string `json:"remark"`
+	SortOrder   int    `json:"sortOrder"`
+}
+
+// ScriptRuntimeMatchRuleError 是通用规则校验错误；旧接口在兼容层转换为原有错误类型。
+type ScriptRuntimeMatchRuleError struct {
+	Field   string
+	Message string
+}
+
+func (e *ScriptRuntimeMatchRuleError) Error() string { return e.Message }
+func (e *ScriptRuntimeMatchRuleError) Unwrap() error { return ErrValidation }
+
+func normalizeRuntimeMatchRules(rules []RuntimeMatchRule, legacyType, legacyURL string) ([]RuntimeMatchRule, error) {
+	if rules == nil {
+		if legacyType == "" || legacyURL == "" {
+			return nil, &ScriptRuntimeMatchRuleError{Field: "matchRules", Message: "至少需要一条启用的 URL 匹配规则"}
+		}
+		rules = []RuntimeMatchRule{{ID: "legacy", MatchType: legacyType, Pattern: legacyURL, Enabled: true, SortOrder: 0}}
+	}
+	if len(rules) == 0 || len(rules) > maxRuntimeMatchRules {
+		return nil, &ScriptRuntimeMatchRuleError{Field: "matchRules", Message: "匹配规则数量必须在1至32条之间"}
+	}
+	seen := make(map[string]struct{}, len(rules))
+	enabled := 0
+	out := make([]RuntimeMatchRule, 0, len(rules))
+	for i, rule := range rules {
+		rule.ID = strings.TrimSpace(rule.ID)
+		if rule.ID == "" {
+			rule.ID = fmt.Sprintf("rule_%d", i+1)
+		}
+		if len(rule.ID) > 64 || strings.ContainsAny(rule.ID, " \t\r\n") {
+			return nil, &ScriptRuntimeMatchRuleError{Field: fmt.Sprintf("matchRules[%d].id", i), Message: "匹配规则标识无效"}
+		}
+		rule.MatchType = strings.TrimSpace(rule.MatchType)
+		rule.Pattern = strings.TrimSpace(rule.Pattern)
+		rule.Remark = strings.TrimSpace(rule.Remark)
+		if len([]rune(rule.Remark)) > maxRuntimeRuleRemark {
+			return nil, &ScriptRuntimeMatchRuleError{Field: fmt.Sprintf("matchRules[%d].remark", i), Message: "匹配规则备注不能超过200个字符"}
+		}
+		if rule.SortOrder < -maxRuntimeRuleSortOrder || rule.SortOrder > maxRuntimeRuleSortOrder {
+			return nil, &ScriptRuntimeMatchRuleError{Field: fmt.Sprintf("matchRules[%d].sortOrder", i), Message: "匹配规则排序值超出范围"}
+		}
+		if rule.MatchType != "exact" && rule.MatchType != "prefix" && rule.MatchType != "wildcard" {
+			return nil, &ScriptRuntimeMatchRuleError{Field: fmt.Sprintf("matchRules[%d].matchType", i), Message: "匹配方式必须是 exact、prefix 或 wildcard"}
+		}
+		normalized, err := matcher.ValidateRule(rule.MatchType, rule.Pattern)
+		if err != nil {
+			return nil, &ScriptRuntimeMatchRuleError{Field: fmt.Sprintf("matchRules[%d].pattern", i), Message: "匹配规则 URL 无效"}
+		}
+		rule.Pattern = normalized
+		key := fmt.Sprintf("%s\x00%s\x00%t", rule.MatchType, rule.Pattern, rule.IgnoreQuery)
+		if _, exists := seen[key]; exists {
+			return nil, &ScriptRuntimeMatchRuleError{Field: "matchRules", Message: "匹配规则不能重复"}
+		}
+		seen[key] = struct{}{}
+		if rule.Enabled {
+			enabled++
+		}
+		out = append(out, rule)
+	}
+	if enabled == 0 {
+		return nil, &ScriptRuntimeMatchRuleError{Field: "matchRules", Message: "至少需要一条启用的 URL 匹配规则"}
+	}
+	return out, nil
+}
+
+func encodeRuntimeMatchRules(rules []RuntimeMatchRule) ([]byte, error) {
+	return json.Marshal(rules)
+}
+
+func decodeRuntimeMatchRules(raw []byte, legacyType, legacyURL string) ([]RuntimeMatchRule, error) {
+	var rules []RuntimeMatchRule
+	if len(raw) > 0 && string(raw) != "null" {
+		if err := json.Unmarshal(raw, &rules); err != nil {
+			return nil, err
+		}
+	}
+	if rules == nil && legacyType != "" && legacyURL != "" {
+		rules = []RuntimeMatchRule{{ID: "legacy", MatchType: legacyType, Pattern: legacyURL, Enabled: true, SortOrder: 0}}
+	}
+	return rules, nil
+}
+
+func matchRuntimeRules(rules []RuntimeMatchRule, legacyType, legacyURL, candidate string) (bool, error) {
+	if len(rules) == 0 {
+		rules = []RuntimeMatchRule{{MatchType: legacyType, Pattern: legacyURL, Enabled: true}}
+	}
+	for _, rule := range rules {
+		if !rule.Enabled {
+			continue
+		}
+		matched, err := matcher.MatchRule(rule.MatchType, rule.Pattern, candidate, rule.IgnoreQuery)
+		if err != nil {
+			return false, err
+		}
+		if matched {
+			return true, nil
+		}
+	}
+	return false, nil
+}
