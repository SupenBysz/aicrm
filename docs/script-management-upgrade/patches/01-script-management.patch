diff --git a/ops/db/087_matrix_account_douyin_script_assets.sql b/ops/db/087_matrix_account_douyin_script_assets.sql
new file mode 100644
index 0000000000000000000000000000000000000000..91e7d311081cac44ec0533aa6313a80ddd990f61
--- /dev/null
+++ b/ops/db/087_matrix_account_douyin_script_assets.sql
@@ -0,0 +1,45 @@
+-- 抖店脚本与样式独立源码版本；不修改旧版本表，旧数据通过回填保留可读历史。
+ALTER TABLE ky_matrix_account_douyin_script
+  ADD COLUMN IF NOT EXISTS latest_script_asset_version_id text,
+  ADD COLUMN IF NOT EXISTS effective_script_asset_version_id text,
+  ADD COLUMN IF NOT EXISTS latest_style_asset_version_id text,
+  ADD COLUMN IF NOT EXISTS effective_style_asset_version_id text;
+
+CREATE TABLE IF NOT EXISTS ky_matrix_account_douyin_script_asset_version (
+  id text PRIMARY KEY,
+  script_id text NOT NULL REFERENCES ky_matrix_account_douyin_script(id),
+  asset_type text NOT NULL CHECK (asset_type IN ('script','style')),
+  version text NOT NULL,
+  source_content text NOT NULL DEFAULT '',
+  source_bytes integer NOT NULL DEFAULT 0 CHECK (source_bytes >= 0),
+  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^[a-f0-9]{64}$'),
+  status text NOT NULL DEFAULT 'draft' CHECK (status IN ('draft','released','active','archived')),
+  revision integer NOT NULL DEFAULT 1 CHECK (revision > 0),
+  last_command_key text NOT NULL DEFAULT '',
+  last_command_hash text NOT NULL DEFAULT '',
+  created_by text REFERENCES ky_user(id),
+  updated_by text REFERENCES ky_user(id),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE(script_id, asset_type, version)
+);
+CREATE INDEX IF NOT EXISTS ky_matrix_account_douyin_script_asset_version_list_idx
+  ON ky_matrix_account_douyin_script_asset_version(script_id, asset_type, created_at DESC);
+
+-- 旧版本同时包含 JS/CSS；分别投影到两条不可变资产历史，原表继续作为兼容 API 的事实来源。
+INSERT INTO ky_matrix_account_douyin_script_asset_version
+  (id,script_id,asset_type,version,source_content,source_bytes,source_sha256,status,revision,created_by,updated_by,created_at,updated_at)
+SELECT 'mdsa_script_'||v.id,v.script_id,'script',v.version,v.js_content,v.js_bytes,v.content_sha256,v.status,v.revision,v.created_by,v.updated_by,v.created_at,v.updated_at
+FROM ky_matrix_account_douyin_script_version v
+ON CONFLICT (script_id,asset_type,version) DO NOTHING;
+INSERT INTO ky_matrix_account_douyin_script_asset_version
+  (id,script_id,asset_type,version,source_content,source_bytes,source_sha256,status,revision,created_by,updated_by,created_at,updated_at)
+SELECT 'mdsa_style_'||v.id,v.script_id,'style',v.version,v.css_content,v.css_bytes,v.content_sha256,v.status,v.revision,v.created_by,v.updated_by,v.created_at,v.updated_at
+FROM ky_matrix_account_douyin_script_version v
+ON CONFLICT (script_id,asset_type,version) DO NOTHING;
+UPDATE ky_matrix_account_douyin_script s SET
+ latest_script_asset_version_id=COALESCE(s.latest_script_asset_version_id,'mdsa_script_'||s.latest_version_id),
+ effective_script_asset_version_id=COALESCE(s.effective_script_asset_version_id,'mdsa_script_'||s.effective_version_id),
+ latest_style_asset_version_id=COALESCE(s.latest_style_asset_version_id,'mdsa_style_'||s.latest_version_id),
+ effective_style_asset_version_id=COALESCE(s.effective_style_asset_version_id,'mdsa_style_'||s.effective_version_id)
+WHERE s.latest_version_id IS NOT NULL OR s.effective_version_id IS NOT NULL;
diff --git a/ops/db/088_matrix_account_douyin_script_identifier.sql b/ops/db/088_matrix_account_douyin_script_identifier.sql
new file mode 100644
index 0000000000000000000000000000000000000000..acefec6686d32c770984a9e8df621dd0315b5348
--- /dev/null
+++ b/ops/db/088_matrix_account_douyin_script_identifier.sql
@@ -0,0 +1,28 @@
+-- 抖店脚本标识符：用于脚本配置的稳定业务标识，不执行脚本。
+ALTER TABLE ky_matrix_account_douyin_script
+  ADD COLUMN IF NOT EXISTS identifier text;
+
+-- 旧记录没有标识符时使用不可变脚本 ID 生成稳定回填值，不覆盖已有配置。
+UPDATE ky_matrix_account_douyin_script
+SET identifier = 'script_' || regexp_replace(id, '[^A-Za-z0-9_-]', '', 'g')
+WHERE identifier IS NULL OR btrim(identifier) = '';
+
+ALTER TABLE ky_matrix_account_douyin_script
+  ALTER COLUMN identifier SET NOT NULL;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'ky_matrix_account_douyin_script'::regclass
+      AND conname = 'ky_matrix_account_douyin_script_identifier_ck'
+  ) THEN
+    ALTER TABLE ky_matrix_account_douyin_script
+      ADD CONSTRAINT ky_matrix_account_douyin_script_identifier_ck
+      CHECK (identifier ~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$');
+  END IF;
+END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS ky_matrix_account_douyin_script_identifier_uidx
+  ON ky_matrix_account_douyin_script(workspace_type, workspace_id, lower(identifier))
+  WHERE deleted_at IS NULL;
diff --git a/ops/db/089_matrix_account_douyin_script_runtime_contract.sql b/ops/db/089_matrix_account_douyin_script_runtime_contract.sql
new file mode 100644
index 0000000000000000000000000000000000000000..c95b3d0c586710d780845eb2e35e96ea50a790b6
--- /dev/null
+++ b/ops/db/089_matrix_account_douyin_script_runtime_contract.sql
@@ -0,0 +1,44 @@
+-- 阶段1运行时契约字段：仅保存配置，不启用脚本注入或执行。
+-- 旧记录统一回填为安全默认值；本迁移可重复执行。
+ALTER TABLE ky_matrix_account_douyin_script
+  ADD COLUMN IF NOT EXISTS run_at text,
+  ADD COLUMN IF NOT EXISTS priority integer;
+
+UPDATE ky_matrix_account_douyin_script
+SET run_at = 'document_idle'
+WHERE run_at IS NULL OR btrim(run_at) = '';
+
+UPDATE ky_matrix_account_douyin_script
+SET priority = 1000
+WHERE priority IS NULL;
+
+ALTER TABLE ky_matrix_account_douyin_script
+  ALTER COLUMN run_at SET DEFAULT 'document_idle',
+  ALTER COLUMN run_at SET NOT NULL,
+  ALTER COLUMN priority SET DEFAULT 1000,
+  ALTER COLUMN priority SET NOT NULL;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'ky_matrix_account_douyin_script'::regclass
+      AND conname = 'ky_matrix_account_douyin_script_run_at_ck'
+  ) THEN
+    ALTER TABLE ky_matrix_account_douyin_script
+      ADD CONSTRAINT ky_matrix_account_douyin_script_run_at_ck
+      CHECK (run_at IN ('document_start','dom_content_loaded','document_idle','load','spa_route_change','user_action'));
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'ky_matrix_account_douyin_script'::regclass
+      AND conname = 'ky_matrix_account_douyin_script_priority_ck'
+  ) THEN
+    ALTER TABLE ky_matrix_account_douyin_script
+      ADD CONSTRAINT ky_matrix_account_douyin_script_priority_ck
+      CHECK (priority BETWEEN -10000 AND 10000);
+  END IF;
+END $$;
+
+-- 回滚说明（需在维护窗口执行）：先删除上述两个约束，再删除 run_at/priority 列。
+-- 删除列会丢弃本阶段新增值，回滚前应确认调用方已停止使用新字段。
diff --git a/ops/db/090_matrix_account_douyin_asset_published_at.sql b/ops/db/090_matrix_account_douyin_asset_published_at.sql
new file mode 100644
index 0000000000000000000000000000000000000000..244fe69bb566d26ebeb125c640031d077d2022ce
--- /dev/null
+++ b/ops/db/090_matrix_account_douyin_asset_published_at.sql
@@ -0,0 +1,7 @@
+-- 为独立脚本/样式资产记录真实发布时间；历史已发布资产用既有更新时间回填。
+ALTER TABLE ky_matrix_account_douyin_script_asset_version
+  ADD COLUMN IF NOT EXISTS published_at timestamptz;
+
+UPDATE ky_matrix_account_douyin_script_asset_version
+SET published_at = updated_at
+WHERE status IN ('released', 'active') AND published_at IS NULL;
diff --git a/ops/db/091_matrix_account_douyin_style_runtime.sql b/ops/db/091_matrix_account_douyin_style_runtime.sql
new file mode 100644
index 0000000000000000000000000000000000000000..db5bb759d16aaa1c4c03bab51a2fdc5e7251b9a9
--- /dev/null
+++ b/ops/db/091_matrix_account_douyin_style_runtime.sql
@@ -0,0 +1,21 @@
+-- 为独立样式资产保存自己的运行时配置；NULL 保留旧数据回退到脚本级配置。
+ALTER TABLE ky_matrix_account_douyin_script_asset_version
+  ADD COLUMN IF NOT EXISTS run_at text,
+  ADD COLUMN IF NOT EXISTS priority integer,
+  ADD COLUMN IF NOT EXISTS enabled boolean;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'ky_matrix_account_douyin_asset_run_at_ck') THEN
+    ALTER TABLE ky_matrix_account_douyin_script_asset_version
+      ADD CONSTRAINT ky_matrix_account_douyin_asset_run_at_ck
+      CHECK (run_at IS NULL OR run_at IN ('document_start','dom_content_loaded','document_idle','spa_route_change'));
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'ky_matrix_account_douyin_asset_priority_ck') THEN
+    ALTER TABLE ky_matrix_account_douyin_script_asset_version
+      ADD CONSTRAINT ky_matrix_account_douyin_asset_priority_ck
+      CHECK (priority IS NULL OR priority BETWEEN -10000 AND 10000);
+  END IF;
+END $$;
+
+-- 新样式版本由写入服务填充 document_start/0/启用；旧样式保持 NULL，运行时按脚本配置兼容回退。
diff --git a/ops/db/092_matrix_account_public_scripts.sql b/ops/db/092_matrix_account_public_scripts.sql
new file mode 100644
index 0000000000000000000000000000000000000000..c6374beb9f26dc2745fef4b245d70d9ea3d3b734
--- /dev/null
+++ b/ops/db/092_matrix_account_public_scripts.sql
@@ -0,0 +1,29 @@
+-- 公共 JavaScript 源码资源：仅提供 workspace 隔离的 CRUD，不参与版本、发布或运行时注入。
+CREATE TABLE IF NOT EXISTS ky_matrix_account_public_script (
+  id text PRIMARY KEY,
+  workspace_type text NOT NULL CHECK (workspace_type IN ('platform','agency','enterprise')),
+  workspace_id text NOT NULL,
+  name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 120),
+  identifier text NOT NULL CHECK (identifier ~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'),
+  description text NOT NULL DEFAULT '',
+  source_content text NOT NULL DEFAULT '',
+  source_chars integer NOT NULL DEFAULT 0 CHECK (source_chars >= 0),
+  source_bytes integer NOT NULL DEFAULT 0 CHECK (source_bytes >= 0),
+  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^[a-f0-9]{64}$'),
+  enabled boolean NOT NULL DEFAULT true,
+  revision integer NOT NULL DEFAULT 1 CHECK (revision > 0),
+  last_command_key text NOT NULL DEFAULT '',
+  last_command_hash text NOT NULL DEFAULT '',
+  created_by text REFERENCES ky_user(id),
+  updated_by text REFERENCES ky_user(id),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  deleted_at timestamptz
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS ky_matrix_account_public_script_identifier_uidx
+  ON ky_matrix_account_public_script(workspace_type, workspace_id, lower(identifier))
+  WHERE deleted_at IS NULL;
+CREATE INDEX IF NOT EXISTS ky_matrix_account_public_script_list_idx
+  ON ky_matrix_account_public_script(workspace_type, workspace_id, enabled, updated_at DESC)
+  WHERE deleted_at IS NULL;
diff --git a/ops/db/093_matrix_account_douyin_script_match_rules.sql b/ops/db/093_matrix_account_douyin_script_match_rules.sql
new file mode 100644
index 0000000000000000000000000000000000000000..2a3994a2fecfcd6e70bf11e5d6694a41cc0c7c4a
--- /dev/null
+++ b/ops/db/093_matrix_account_douyin_script_match_rules.sql
@@ -0,0 +1,48 @@
+-- 抖店脚本多 URL 规则：保留旧字段并以 JSONB 规则数组作为权威配置。
+-- 兼容旧记录；不修改公共脚本或旧登录脚本表。
+ALTER TABLE ky_matrix_account_douyin_script
+  ADD COLUMN IF NOT EXISTS match_rules jsonb;
+
+UPDATE ky_matrix_account_douyin_script
+SET match_rules = jsonb_build_array(jsonb_build_object(
+  'id', 'legacy_' || id,
+  'matchType', match_type,
+  'pattern', match_url,
+  'ignoreQuery', false,
+  'enabled', true,
+  'remark', '',
+  'sortOrder', 0
+))
+WHERE match_rules IS NULL OR jsonb_typeof(match_rules) <> 'array' OR jsonb_array_length(match_rules) = 0;
+
+ALTER TABLE ky_matrix_account_douyin_script
+  ALTER COLUMN match_rules SET DEFAULT '[]'::jsonb,
+  ALTER COLUMN match_rules SET NOT NULL;
+
+ALTER TABLE ky_matrix_account_douyin_script
+  DROP CONSTRAINT IF EXISTS ky_matrix_account_douyin_script_match_type_check,
+  DROP CONSTRAINT IF EXISTS ky_matrix_account_douyin_script_match_type_ck;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'ky_matrix_account_douyin_script'::regclass
+      AND conname = 'ky_matrix_account_douyin_script_match_type_ck'
+  ) THEN
+    ALTER TABLE ky_matrix_account_douyin_script
+      ADD CONSTRAINT ky_matrix_account_douyin_script_match_type_ck
+      CHECK (match_type IN ('exact','prefix','wildcard'));
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'ky_matrix_account_douyin_script'::regclass
+      AND conname = 'ky_matrix_account_douyin_script_match_rules_array_ck'
+  ) THEN
+    ALTER TABLE ky_matrix_account_douyin_script
+      ADD CONSTRAINT ky_matrix_account_douyin_script_match_rules_array_ck
+      CHECK (jsonb_typeof(match_rules) = 'array' AND jsonb_array_length(match_rules) >= 1);
+  END IF;
+END $$;
+
+-- 回滚说明：停止使用多规则版本后，可删除本列及本迁移新增约束；旧 match_type/match_url 保留。
diff --git a/ops/db/094_matrix_account_public_script_sdk.sql b/ops/db/094_matrix_account_public_script_sdk.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d06ef292e9d5da22323cd2211739bd420b62c707
--- /dev/null
+++ b/ops/db/094_matrix_account_public_script_sdk.sql
@@ -0,0 +1,21 @@
+-- 公共脚本 SDK 依赖与平台字段增量迁移；不删除历史源码。
+ALTER TABLE ky_matrix_account_public_script
+  ADD COLUMN IF NOT EXISTS platform text NOT NULL DEFAULT 'douyin',
+  ADD COLUMN IF NOT EXISTS dependencies jsonb NOT NULL DEFAULT '[]'::jsonb;
+
+ALTER TABLE ky_matrix_account_public_script
