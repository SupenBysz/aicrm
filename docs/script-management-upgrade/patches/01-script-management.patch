+export function updateAsset(c:RequestClient,id:string,assetId:string,b:unknown,r:number){return write<AssetVersion>(c,`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(id)}/assets/${encodeURIComponent(assetId)}`,"PATCH",b,r)}
+export function copyAsset(c:RequestClient,id:string,assetId:string){return write<AssetVersion>(c,`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(id)}/assets/${encodeURIComponent(assetId)}/copy`,"POST",{})}
+export function assetAction(c:RequestClient,id:string,assetId:string,a:"release"|"activate"|"archive",r:number){return write(c,`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(id)}/assets/${encodeURIComponent(assetId)}/${a}`,"POST",{},r)}
+export function listPublicScripts(c:RequestClient,page:number,size:number,keyword="",status=""){const q=new URLSearchParams({page:String(page),pageSize:String(size)});if(keyword)q.set("keyword",keyword);if(status)q.set("status",status);return c.request<{items:PublicScriptRow[];pagination:{page:number;pageSize:number;total:number}}>(`/api/v1/matrix-account-public-scripts?${q}`)}
+export function getPublicScript(c:RequestClient,id:string,content=false){return c.request<PublicScriptRow>(`/api/v1/matrix-account-public-scripts/${encodeURIComponent(id)}${content?"?content=1":""}`)}
+export function createPublicScript(c:RequestClient,b:unknown){return write<PublicScriptRow>(c,"/api/v1/matrix-account-public-scripts","POST",b)}
+export function updatePublicScript(c:RequestClient,id:string,b:unknown,r:number){return write<PublicScriptRow>(c,`/api/v1/matrix-account-public-scripts/${encodeURIComponent(id)}`,"PATCH",b,r)}
+export function updatePublicScriptStatus(c:RequestClient,id:string,status:"enabled"|"disabled",r:number){return write<PublicScriptRow>(c,`/api/v1/matrix-account-public-scripts/${encodeURIComponent(id)}/status`,"PATCH",{status},r)}
+export function deletePublicScript(c:RequestClient,id:string,r:number){return c.request<void>(`/api/v1/matrix-account-public-scripts/${encodeURIComponent(id)}`,{method:"DELETE",headers:{"Idempotency-Key":crypto.randomUUID(),"X-KY-Expected-Revision":String(r)}})}
+export function listPublicStyles(c:RequestClient,page:number,size:number,keyword="",status=""){const q=new URLSearchParams({page:String(page),pageSize:String(size)});if(keyword)q.set("keyword",keyword);if(status)q.set("status",status);return c.request<{items:PublicStyleRow[];pagination:{page:number;pageSize:number;total:number}}>(`/api/v1/matrix-account-public-styles?${q}`)}
+export function getPublicStyle(c:RequestClient,id:string,content=false){return c.request<PublicStyleRow>(`/api/v1/matrix-account-public-styles/${encodeURIComponent(id)}${content?"?content=1":""}`)}
+export function createPublicStyle(c:RequestClient,b:unknown){return write<PublicStyleRow>(c,"/api/v1/matrix-account-public-styles","POST",b)}
+export function updatePublicStyle(c:RequestClient,id:string,b:unknown,r:number){return write<PublicStyleRow>(c,`/api/v1/matrix-account-public-styles/${encodeURIComponent(id)}`,"PATCH",b,r)}
+export function updatePublicStyleStatus(c:RequestClient,id:string,status:"enabled"|"disabled",r:number){return write<PublicStyleRow>(c,`/api/v1/matrix-account-public-styles/${encodeURIComponent(id)}/status`,"PATCH",{status},r)}
+export function deletePublicStyle(c:RequestClient,id:string,r:number){return c.request<void>(`/api/v1/matrix-account-public-styles/${encodeURIComponent(id)}`,{method:"DELETE",headers:{"Idempotency-Key":crypto.randomUUID(),"X-KY-Expected-Revision":String(r)}})}
+
+export interface EditorAiProvider { id:string; name:string; status:string; hasApiKey:boolean }
+export interface EditorAiModel { id:string; providerId:string; name:string; modelKey:string; status:string }
