+ ('perm_platform_matrix_account_public_styles_manage','platform.matrix_account_public_styles.manage','公共样式管理','action','matrix_account_public_styles','manage','["platform","agency","enterprise"]'::jsonb,'公共 CSS 样式管理','normal')
