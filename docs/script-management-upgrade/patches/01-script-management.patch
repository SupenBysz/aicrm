+  assert.match(reference, /label: "jssdk\.host\.updateLoginSpaceInfo"/, "Monaco 关键词提示缺少登录空间 SDK 方法");
+  assert.match(reference, /label: "jssdk\.host\.upload（店铺 LOGO）"/, "Monaco 关键词提示缺少远程店铺 LOGO 上传 SDK 方法");
