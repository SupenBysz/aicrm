+    return allowed.has(id) || submenuIds.has(item.submenu);
+  })
+    .sort((a, b) => (groupRank.get(a.group) ?? 99) - (groupRank.get(b.group) ?? 99) || (a.order ?? 0) - (b.order ?? 0));
+}
