+export interface PublicStyleRow { id:string; workspaceType?:string; workspaceId?:string; platform?:string; name:string; identifier:string; description:string; matchType:"exact"|"wildcard"; matchUrl:string; sourceContent?:string; sourceChars:number; sourceBytes:number; sourceSha256:string; runAt:"document_start"|"dom_content_loaded"|"document_idle"|"spa_route_change"; priority:number; enabled:boolean; status:"enabled"|"disabled"; revision:number; createdAt:string|number|null; updatedAt:string|number|null; createdBy?:string; updatedBy?:string }
+const write=<T=unknown>(client:RequestClient,path:string,method:string,body:unknown,revision?:number)=>client.request<T>(path,{method,headers:{"Idempotency-Key":crypto.randomUUID(),...(revision?{"X-KY-Expected-Revision":String(revision)}:{})},body});
+export function listScripts(c:RequestClient,page:number,size:number,keyword:string,status:string){const q=new URLSearchParams({page:String(page),pageSize:String(size)});if(keyword)q.set("keyword",keyword);if(status)q.set("status",status);return c.request<ListResponse>(`/api/v1/matrix-account-douyin-scripts?${q}`)}
+export function getScript(c:RequestClient,id:string){return c.request<ScriptRow>(`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(id)}`)}
+export function createScript(c:RequestClient,b:unknown){return write(c,"/api/v1/matrix-account-douyin-scripts","POST",b)}
+export function updateScript(c:RequestClient,id:string,b:unknown,r:number){return write(c,`/api/v1/matrix-account-douyin-scripts/${id}`,"PATCH",b,r)}
+export function updateScriptStatus(c:RequestClient,id:string,status:string,r:number){return write(c,`/api/v1/matrix-account-douyin-scripts/${id}/status`,"PATCH",{status},r)}
+export function listAssets(c:RequestClient,id:string,type:AssetType){return c.request<AssetVersion[]>(`/api/v1/matrix-account-douyin-scripts/${encodeURIComponent(id)}/assets?assetType=${type}`)}
