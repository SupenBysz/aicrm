+export function listEditorModels(c:RequestClient){return c.request<{items:EditorAiModel[]}>("/api/v1/ai-models/models?status=enabled&page=1&pageSize=200")}
+export function testEditorModel(c:RequestClient,id:string){return c.request<{ok:boolean;errorMessage?:string}>(`/api/v1/ai-models/models/${encodeURIComponent(id)}/test`,{method:"POST",body:{prompt:"源码编辑器静态补全连接测试"}})}
