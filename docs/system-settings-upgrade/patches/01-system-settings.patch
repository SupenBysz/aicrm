diff --git a/ops/db/078_platform_logo_typography.sql b/ops/db/078_platform_logo_typography.sql
new file mode 100644
index 0000000000000000000000000000000000000000..4613f232355d27b1c3ee56dfbb9fd4067bce7a9b
--- /dev/null
+++ b/ops/db/078_platform_logo_typography.sql
@@ -0,0 +1,24 @@
+-- 平台品牌长短文字 Logo 的安全字体配置。仅允许受控枚举和范围值，兼容既有 profile 行。
+ALTER TABLE ky_platform_profile
+  ADD COLUMN IF NOT EXISTS long_logo_font_size integer NOT NULL DEFAULT 16,
+  ADD COLUMN IF NOT EXISTS long_logo_font_family text NOT NULL DEFAULT 'system',
+  ADD COLUMN IF NOT EXISTS long_logo_font_weight integer NOT NULL DEFAULT 600,
+  ADD COLUMN IF NOT EXISTS short_logo_font_size integer NOT NULL DEFAULT 14,
+  ADD COLUMN IF NOT EXISTS short_logo_font_family text NOT NULL DEFAULT 'system',
+  ADD COLUMN IF NOT EXISTS short_logo_font_weight integer NOT NULL DEFAULT 600;
+
+UPDATE ky_platform_profile
+SET long_logo_font_size = COALESCE(NULLIF(long_logo_font_size, 0), 16),
+    long_logo_font_family = CASE WHEN long_logo_font_family IN ('system', 'sans', 'serif', 'mono') THEN long_logo_font_family ELSE 'system' END,
+    long_logo_font_weight = CASE WHEN long_logo_font_weight IN (400, 500, 600, 700) THEN long_logo_font_weight ELSE 600 END,
+    short_logo_font_size = COALESCE(NULLIF(short_logo_font_size, 0), 14),
+    short_logo_font_family = CASE WHEN short_logo_font_family IN ('system', 'sans', 'serif', 'mono') THEN short_logo_font_family ELSE 'system' END,
+    short_logo_font_weight = CASE WHEN short_logo_font_weight IN (400, 500, 600, 700) THEN short_logo_font_weight ELSE 600 END;
+
+ALTER TABLE ky_platform_profile
+  ADD CONSTRAINT ky_platform_profile_long_logo_font_size_ck CHECK (long_logo_font_size BETWEEN 8 AND 72),
+  ADD CONSTRAINT ky_platform_profile_short_logo_font_size_ck CHECK (short_logo_font_size BETWEEN 8 AND 72),
+  ADD CONSTRAINT ky_platform_profile_long_logo_font_family_ck CHECK (long_logo_font_family IN ('system', 'sans', 'serif', 'mono')),
+  ADD CONSTRAINT ky_platform_profile_short_logo_font_family_ck CHECK (short_logo_font_family IN ('system', 'sans', 'serif', 'mono')),
+  ADD CONSTRAINT ky_platform_profile_long_logo_font_weight_ck CHECK (long_logo_font_weight IN (400, 500, 600, 700)),
+  ADD CONSTRAINT ky_platform_profile_short_logo_font_weight_ck CHECK (short_logo_font_weight IN (400, 500, 600, 700));
diff --git a/ops/db/079_storage_providers.sql b/ops/db/079_storage_providers.sql
new file mode 100644
index 0000000000000000000000000000000000000000..f7a8f1fef1580c5854d385dbce6273693e44868a
--- /dev/null
+++ b/ops/db/079_storage_providers.sql
@@ -0,0 +1,23 @@
+-- 对象存储多提供商配置：保留旧单例并复制到兼容 MinIO 配置。
+ALTER TABLE ky_storage_setting
+  ADD COLUMN IF NOT EXISTS local_directory text NOT NULL DEFAULT './storage',
+  ADD COLUMN IF NOT EXISTS active_storage_provider text NOT NULL DEFAULT 'minio';
+
+INSERT INTO ky_storage_setting (id, provider_key, endpoint, region, bucket, bucket_private, force_path_style, prefix,
+  public_domain, access_key_id, secret_access_key_encrypted, updated_by)
+SELECT 'minio', CASE WHEN provider_key = 's3' THEN 'minio' ELSE provider_key END, endpoint, region, bucket,
+  bucket_private, force_path_style, prefix, public_domain, access_key_id, secret_access_key_encrypted, updated_by
+FROM ky_storage_setting WHERE id='default'
+ON CONFLICT (id) DO NOTHING;
+
+INSERT INTO ky_storage_setting (id, provider_key, local_directory, bucket_private)
+VALUES ('local', 'local', './storage', true)
+ON CONFLICT (id) DO NOTHING;
+INSERT INTO ky_storage_setting (id, provider_key, bucket_private)
+VALUES ('oss', 'oss', true)
+ON CONFLICT (id) DO NOTHING;
+
+UPDATE ky_storage_setting SET active_storage_provider = CASE
+  WHEN active_storage_provider IN ('local', 'minio', 'oss') THEN active_storage_provider
+  ELSE 'minio' END
+WHERE id='default';
diff --git a/ops/db/080_storage_project_directory.sql b/ops/db/080_storage_project_directory.sql
new file mode 100644
index 0000000000000000000000000000000000000000..c96751b9ead86be8a1415ee1c7374bbb76c9e682
--- /dev/null
+++ b/ops/db/080_storage_project_directory.sql
@@ -0,0 +1,4 @@
+-- 将历史生成的系统目录默认值迁移为服务工作目录下的项目 storage；不移动已有文件。
+UPDATE ky_storage_setting
+SET local_directory = './storage'
+WHERE id='local' AND (local_directory IS NULL OR local_directory='' OR local_directory='/var/lib/kww/storage');
diff --git a/ops/db/081_storage_activation_default.sql b/ops/db/081_storage_activation_default.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d88bf1244665a34454faa7623b4ee3d462fee497
--- /dev/null
+++ b/ops/db/081_storage_activation_default.sql
@@ -0,0 +1,17 @@
+-- 为测试结果绑定配置版本；未经成功测试的云存储不得成为当前存储。
+ALTER TABLE ky_storage_setting
+  ADD COLUMN IF NOT EXISTS config_fingerprint text NOT NULL DEFAULT '',
+  ADD COLUMN IF NOT EXISTS last_test_fingerprint text NOT NULL DEFAULT '';
+
+UPDATE ky_storage_setting AS d
+SET active_storage_provider = 'local', updated_at = now()
+WHERE d.id = 'default'
+  AND d.active_storage_provider <> 'local'
+  AND NOT EXISTS (
+    SELECT 1
+    FROM ky_storage_setting AS p
+    WHERE p.id = d.active_storage_provider
+      AND p.last_test_status = 'success'
+      AND p.config_fingerprint <> ''
+      AND p.config_fingerprint = p.last_test_fingerprint
+  );
