diff --git a/packages/ky-admin-core/src/image-source.ts b/packages/ky-admin-core/src/image-source.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0405e7bc0a5e64288b8ea9d40d0e0234294a377c
--- /dev/null
+++ b/packages/ky-admin-core/src/image-source.ts
@@ -0,0 +1,27 @@
+export function imagePath(value?: string | null): string | null {
+  if (!value) return null;
+  if (/^\/api\/v1\/images\/[0-9a-f]{32}(?:\?.*)?$/.test(value) || /^\/api\/v1\/shop-management\/logos\/[0-9a-f]{32}(?:\?.*)?$/.test(value)) return value;
+  try {
+    const url = new URL(value);
+    return ["api.kww.org.cn", "console.kww.org.cn"].includes(url.hostname) && url.protocol === "https:" && (/^\/api\/v1\/images\/[0-9a-f]{32}$/.test(url.pathname) || /^\/api\/v1\/shop-management\/logos\/[0-9a-f]{32}$/.test(url.pathname)) ? `${url.pathname}${url.search}` : null;
+  } catch {
+    return null;
+  }
+}
+
+export function legacyImageURL(value?: string | null): string | null {
+  if (!value) return null;
+  try {
+    const url = new URL(value);
+    if (url.protocol !== "https:" || url.username || url.password) return null;
+    if (["api.kww.org.cn", "console.kww.org.cn"].includes(url.hostname)) return null;
+    return url.href;
+  } catch {
+    return null;
+  }
+}
+
+export function resolveImageSource(value?: string | null) {
+  const path = imagePath(value);
+  return { path, legacy: path ? null : legacyImageURL(value) };
+}
diff --git a/packages/ky-admin-core/src/image-upload.tsx b/packages/ky-admin-core/src/image-upload.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e6723c8ed6e00bf49e9093f4be35f83bca179a7f
--- /dev/null
+++ b/packages/ky-admin-core/src/image-upload.tsx
@@ -0,0 +1,32 @@
+import { useEffect, useRef, useState } from "react";
+import { Alert, Button, Image as AntImage, Progress, Space, Spin, theme, Typography } from "antd";
+import { useRequestClient } from "./request-context";
+import { useCurrentUser } from "./user-context";
+import { useCurrentWorkspace } from "./workspace-context";
+import { resolveImageSource } from "./image-source";
+
+const limit = 2 * 1024 * 1024;
+
+export function ImageView({ value, size = 64 }: { value?: string | null; size?: number }) {
+  const { token } = theme.useToken(); const client = useRequestClient(); const user = useCurrentUser(); const workspace = useCurrentWorkspace(); const [src, setSrc] = useState<string>(); const [renderedKey, setRenderedKey] = useState(""); const [failed, setFailed] = useState(false); const key = `${user?.id ?? ""}:${workspace?.type ?? ""}:${workspace?.id ?? ""}:${workspace?.membershipId ?? ""}:${value ?? ""}`;
+  const { path, legacy } = resolveImageSource(value);
+  useEffect(() => { let live = true; setSrc(undefined); setRenderedKey(""); setFailed(false); if (!path) return; const ctrl = new AbortController(); let objectUrl = "";
+    client.request<{ mime: string; base64: string }>(path, { signal: ctrl.signal }).then(result => { if (!live || !/^image\/(png|jpeg)$/.test(result.mime)) throw new Error("invalid_image"); const raw = atob(result.base64); if (raw.length > limit || !live) throw new Error("invalid_image"); objectUrl = URL.createObjectURL(new Blob([Uint8Array.from(raw, ch => ch.charCodeAt(0))], { type: result.mime })); if (live) { setSrc(objectUrl); setRenderedKey(key); setFailed(false); } }).catch(() => { if (live && !ctrl.signal.aborted) setFailed(true); });
+    return () => { live = false; ctrl.abort(); if (objectUrl) URL.revokeObjectURL(objectUrl); };
+  }, [client, key, value, path]);
+  const frameStyle = { width: size, height: size, boxSizing: "border-box" as const, border: "1px solid var(--admin-image-frame-border, #d9d9d9)", background: "var(--admin-image-frame-bg, #fafafa)", borderRadius: token.borderRadius, overflow: "hidden" as const, display: "grid", placeItems: "center" };
+  if (legacy) return failed ? <button type="button" onClick={() => setFailed(false)} style={{ ...frameStyle, color: token.colorTextSecondary }}>重试</button> : <AntImage key={`${key}:legacy`} width={size} height={size} src={legacy} referrerPolicy="no-referrer" preview={{ mask: "查看大图" }} style={{ ...frameStyle, objectFit: "contain" }} onError={() => setFailed(true)} />;
+  return src && renderedKey === key ? <AntImage width={size} height={size} src={src} preview={{ mask: "查看大图" }} style={{ ...frameStyle, objectFit: "contain" }} /> : <div style={{ ...frameStyle, color: "var(--admin-image-frame-icon, #8c8c8c)" }}>{failed ? "失败" : <svg aria-hidden="true" width={Math.max(18, Math.round(size * 0.34))} height={Math.max(18, Math.round(size * 0.34))} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8" cy="9" r="1.5" /><path d="m5 17 4-4 3 3 2-2 5 5" /></svg>}</div>;
+}
+
+export function ImageUpload({ value, onChange, contextType, contextId, onBusyChange }: { value?: string; onChange?: (value: string) => void; contextType: "agency" | "enterprise" | "shop"; contextId?: string; onBusyChange?: (busy: boolean) => void }) {
+  const client = useRequestClient(); const user = useCurrentUser(); const workspace = useCurrentWorkspace(); const identityKey = `${user?.id ?? ""}:${workspace?.type ?? ""}:${workspace?.id ?? ""}:${workspace?.membershipId ?? ""}`; const input = useRef<HTMLInputElement>(null); const readerRef = useRef<FileReader | null>(null); const requestRef = useRef<AbortController | null>(null); const serial = useRef(0); const [busy, setBusy] = useState(false); const [progress, setProgress] = useState(0); const [phase, setPhase] = useState<"读取" | "上传">("读取"); const [error, setError] = useState("");
+  const setBusyState = (next: boolean) => { setBusy(next); onBusyChange?.(next); };
+  const upload = async (file?: File) => { if (!file) return; setError(""); setPhase("读取"); setProgress(0); if (file.size > limit || !["image/png", "image/jpeg"].includes(file.type)) { setError("请选择2MiB以内的PNG或JPEG图片"); return; } const current = ++serial.current; setBusyState(true);
+    try { const encoded = await new Promise<string>((resolve, reject) => { const reader = new FileReader(); readerRef.current = reader; reader.onprogress = event => { if (event.lengthComputable && current === serial.current) setProgress(Math.round(event.loaded / event.total * 100)); }; reader.onerror = () => reject(new Error("read_failed")); reader.onabort = () => reject(new Error("cancelled")); reader.onload = () => resolve(String(reader.result).split(",", 2)[1]); reader.readAsDataURL(file); }); if (current !== serial.current) return; setPhase("上传"); setProgress(0); requestRef.current = new AbortController();
+      const result = await client.request<{ imageId: string }>("/api/v1/images", { method: "POST", body: { mime: file.type, base64: encoded, contextType, contextId: contextId ?? "", purpose: "logo" }, signal: requestRef.current.signal }); if (current !== serial.current || !/^[0-9a-f]{32}$/.test(result.imageId)) throw new Error("invalid_response"); onChange?.(`/api/v1/images/${result.imageId}`);
+    } catch (error) { if (current === serial.current) { const code = (error as { code?: string })?.code; setError(code === "forbidden" ? "当前对象没有图片权限。" : code === "validation_error" ? "图片格式、尺寸或大小不符合要求。" : code === "unauthorized" ? "登录已失效，请重新登录。" : code === "permission_unavailable" ? "图片权限服务暂不可用，请稍后重试。原图片保持不变。" : code === "storage_unavailable" || code === "overloaded" ? "图片存储服务暂不可用，请稍后重试。原图片保持不变。" : "图片上传请求失败，请稍后重试。原图片保持不变。"); } } finally { if (current === serial.current) setBusyState(false); if (input.current) input.current.value = ""; }
+  };
+  useEffect(() => () => { serial.current++; readerRef.current?.abort(); requestRef.current?.abort(); setBusyState(false); }, [contextType, contextId, identityKey, client]);
+  return <div><Space wrap align="center"><ImageView value={value} /><input ref={input} type="file" accept="image/png,image/jpeg" hidden onChange={event => void upload(event.target.files?.[0])} /><Button disabled={busy} onClick={() => input.current?.click()}>{value ? "替换图片" : "选择图片上传"}</Button>{value ? <Button disabled={busy} onClick={() => { onChange?.(""); setError(""); }}>移除</Button> : null}</Space>{busy ? <Progress percent={phase === "读取" ? progress : undefined} format={percent => phase === "读取" ? `读取 ${percent ?? 0}%` : "上传中"} /> : null}{busy ? <Space><Spin size="small" /><Typography.Text>{phase === "读取" ? "正在读取图片…" : "正在上传并校验图片…"}</Typography.Text></Space> : null}{error ? <Alert style={{ marginTop: 12 }} type="error" title={error} showIcon /> : null}</div>;
+}
