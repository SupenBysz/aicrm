+		t.Fatal(err)
+	}
+	s1 := &service{c: cfg{dir: dir}, db: db}
+	s2 := &service{c: cfg{dir: dir}, db: db}
+	results := make(chan int, 2)
+	go func() { n, _ := s1.collect(ctx, time.Now().UTC(), 10); results <- n }()
+	go func() { n, _ := s2.collect(ctx, time.Now().UTC(), 10); results <- n }()
+	a, b := <-results, <-results
+	if a+b != 1 {
+		t.Fatalf("gc concurrent completed=%d+%d", a, b)
+	}
+	var n int
+	if err = db.QueryRowContext(ctx, `SELECT count(*) FROM ky_image.resource WHERE id=$1`, id).Scan(&n); err != nil || n != 0 {
+		t.Fatalf("gc row count=%d err=%v", n, err)
+	}
+	lockedID := "dddddddddddddddddddddddddddddddd"
+	if _, err = db.ExecContext(ctx, `INSERT INTO ky_image.resource(id,workspace_type,workspace_id,uploader_user_id,uploader_membership_id,context_type,purpose,path,mime,byte_size,width,height,sha256,status,expires_at) VALUES($1,'enterprise','e1','u1','m1','enterprise','logo',$2,'image/png',1,1,1,repeat('d',64),'temporary',now()-interval '1 second')`, lockedID, lockedID+".image"); err != nil {
