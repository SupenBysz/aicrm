+package server
+
+import "testing"
+
+func TestValidScopeListUsesWorkspaceTypeAndRejectsMixedUnknown(t *testing.T) {
+	tests := []struct {
+		name string
+		ws   string
+		in   []string
+		want bool
+	}{
+		{name: "all platform", ws: "platform", in: []string{"all"}, want: true},
+		{name: "self enterprise", ws: "enterprise", in: []string{"self"}, want: true},
+		{name: "self agency", ws: "agency", in: []string{"self"}, want: true},
+		{name: "agency current", ws: "agency", in: []string{"current_agency"}, want: true},
+		{name: "enterprise current", ws: "enterprise", in: []string{"current_enterprise"}, want: true},
+		{name: "empty", ws: "enterprise", in: nil, want: false},
+		{name: "all plus unknown", ws: "enterprise", in: []string{"all", "future_scope"}, want: false},
+		{name: "wrong agency scope", ws: "enterprise", in: []string{"current_agency"}, want: false},
+		{name: "wrong enterprise scope", ws: "agency", in: []string{"current_enterprise"}, want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := validScopeList(tt.ws, tt.in); got != tt.want {
+				t.Fatalf("validScopeList(%q,%v)=%v, want %v", tt.ws, tt.in, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/services/ky-image-service/internal/server/server.go b/services/ky-image-service/internal/server/server.go
