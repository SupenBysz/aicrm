diff --git a/ops/db/075_image_resources.sql b/ops/db/075_image_resources.sql
new file mode 100644
index 0000000000000000000000000000000000000000..f6e1ed30ab9edb2827eb951a24f5e00305841942
--- /dev/null
+++ b/ops/db/075_image_resources.sql
@@ -0,0 +1,39 @@
+-- 公共图片资源与业务关联；由迁移账本在事务中执行，不修改历史表。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='30s';
+DO $$ BEGIN IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF; END $$;
+CREATE SCHEMA IF NOT EXISTS ky_image AUTHORIZATION CURRENT_USER;
+CREATE TABLE IF NOT EXISTS ky_image.resource (
+ id text PRIMARY KEY CHECK (id ~ '^[0-9a-f]{32}$'),
+ workspace_type text NOT NULL CHECK (workspace_type IN ('platform','agency','enterprise')),
+ workspace_id text NOT NULL,
+ uploader_user_id text NOT NULL,
+ uploader_membership_id text NOT NULL,
+ context_type text NOT NULL CHECK (context_type IN ('agency','enterprise','shop')),
+ context_id text,
+ purpose text NOT NULL CHECK (purpose IN ('logo')),
+ path text NOT NULL UNIQUE,
+ mime text NOT NULL CHECK (mime IN ('image/png','image/jpeg')),
+ byte_size integer NOT NULL CHECK (byte_size>0 AND byte_size<=2097152),
+ width integer NOT NULL CHECK (width>0 AND width<=1024),
+ height integer NOT NULL CHECK (height>0 AND height<=1024),
+ sha256 text NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
+ status text NOT NULL CHECK (status IN ('temporary','bound','expired','deleting','deleted')),
+ expires_at timestamptz NOT NULL,
+ created_at timestamptz NOT NULL DEFAULT now(),
+ updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE TABLE IF NOT EXISTS ky_image.binding (
+ resource_id text NOT NULL REFERENCES ky_image.resource(id),
+ business_type text NOT NULL CHECK (business_type IN ('agency','enterprise','shop')),
+ business_id text NOT NULL,
+ slot text NOT NULL CHECK (slot='logo'),
+ display_order integer NOT NULL DEFAULT 0,
+ created_at timestamptz NOT NULL DEFAULT now(),
+ PRIMARY KEY (business_type,business_id,slot),
+ UNIQUE (resource_id,business_type,business_id,slot)
+);
+CREATE INDEX IF NOT EXISTS ky_image_resource_scope_idx ON ky_image.resource(workspace_type,workspace_id,status,expires_at);
+CREATE INDEX IF NOT EXISTS ky_image_resource_gc_idx ON ky_image.resource(status,expires_at);
+GRANT USAGE ON SCHEMA ky_image TO CURRENT_USER;
+GRANT SELECT,INSERT,UPDATE ON ky_image.resource,ky_image.binding TO CURRENT_USER;
