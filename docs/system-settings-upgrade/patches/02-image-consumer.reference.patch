+GRANT INSERT (logo_image_id), UPDATE (logo_image_id) ON ky_agency, ky_enterprise TO CURRENT_USER;
+GRANT SELECT (logo_image_id), INSERT (logo_image_id), UPDATE (logo_image_id) ON ky_shop_management.ky_shop_store TO CURRENT_USER;
