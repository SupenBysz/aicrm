+package main
+
+import (
+	"context"
+	"github.com/Kysion/KyaiCRM/services/ky-image-service/internal/server"
+	"log"
+	"os"
+	"os/signal"
+	"syscall"
+)
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	if e := server.Run(ctx); e != nil {
+		log.Fatal(e)
+	}
+}
