+ALTER TABLE ky_agency ADD COLUMN IF NOT EXISTS logo_image_id text CHECK (logo_image_id IS NULL OR logo_image_id ~ '^[0-9a-f]{32}$');
+ALTER TABLE ky_enterprise ADD COLUMN IF NOT EXISTS logo_image_id text CHECK (logo_image_id IS NULL OR logo_image_id ~ '^[0-9a-f]{32}$');
+ALTER TABLE ky_shop_management.ky_shop_store ADD COLUMN IF NOT EXISTS logo_image_id text CHECK (logo_image_id IS NULL OR logo_image_id ~ '^[0-9a-f]{32}$');
+UPDATE ky_agency SET logo_image_id=substring(logo_url FROM '/api/v1/images/([0-9a-f]{32})$') WHERE logo_image_id IS NULL AND logo_url ~ '/api/v1/images/[0-9a-f]{32}$';
+UPDATE ky_enterprise SET logo_image_id=substring(logo_url FROM '/api/v1/images/([0-9a-f]{32})$') WHERE logo_image_id IS NULL AND logo_url ~ '/api/v1/images/[0-9a-f]{32}$';
+UPDATE ky_shop_management.ky_shop_store SET logo_image_id=substring(logo_url FROM '/api/v1/images/([0-9a-f]{32})$') WHERE logo_image_id IS NULL AND logo_url ~ '/api/v1/images/[0-9a-f]{32}$';
+CREATE INDEX IF NOT EXISTS ky_agency_logo_image_idx ON ky_agency(logo_image_id) WHERE logo_image_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS ky_enterprise_logo_image_idx ON ky_enterprise(logo_image_id) WHERE logo_image_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS ky_shop_store_logo_image_idx ON ky_shop_management.ky_shop_store(logo_image_id) WHERE logo_image_id IS NOT NULL;
