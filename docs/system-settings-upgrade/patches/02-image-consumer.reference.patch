+package image
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/png"
+	"testing"
+)
+
+func TestSanitizeResizeAndMime(t *testing.T) {
+	var b bytes.Buffer
+	p := image.NewNRGBA(image.Rect(0, 0, 2048, 1024))
+	p.Set(0, 0, color.NRGBA{R: 255, A: 255})
+	p.Set(2047, 1023, color.NRGBA{B: 255, A: 255})
+	_ = png.Encode(&b, p)
+	out, m, e := Sanitize(b.Bytes(), "image/png")
+	if e != nil || m.Width != 1024 || m.Height != 512 {
+		t.Fatalf("resize: %+v %v", m, e)
+	}
+	d, _, e := image.Decode(bytes.NewReader(out))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if d.Bounds().Dx() != 1024 || d.Bounds().Dy() != 512 {
+		t.Fatal("aspect lost")
+	}
+	if _, _, e = Sanitize(b.Bytes(), "image/jpeg"); e == nil {
+		t.Fatal("fake MIME")
+	}
+}
