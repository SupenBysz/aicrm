+type Config struct {
+	Provider, Root, Endpoint, Region, Bucket, Prefix, AccessKey, SecretEncrypted string
+	ForcePathStyle                                                               bool
+}
+
+type Provider interface {
+	Put(context.Context, string, string, []byte) error
+	Get(context.Context, string) ([]byte, error)
+	Delete(context.Context, string) error
+	Exists(context.Context, string) (bool, error)
+	Test(context.Context) error
+	BuildAccessURL(string) string
+}
+
+type localProvider struct{ root string }
+
+func (p localProvider) path(key string) string {
+	return filepath.Join(p.root, filepath.Base(key)+".image")
+}
+func (p localProvider) Put(_ context.Context, key, _ string, data []byte) error {
+	if err := os.MkdirAll(p.root, 0700); err != nil {
+		return err
+	}
+	if err := os.Chmod(p.root, 0700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(p.root, ".image-")
+	if err != nil {
+		return err
+	}
+	name := tmp.Name()
+	defer os.Remove(name)
+	if err = tmp.Chmod(0600); err == nil {
+		_, err = tmp.Write(data)
+	}
+	if err == nil {
+		err = tmp.Sync()
+	}
+	if closeErr := tmp.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(name, p.path(key))
+}
+func (p localProvider) Get(_ context.Context, key string) ([]byte, error) {
+	f, err := os.Open(p.path(key))
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	return io.ReadAll(io.LimitReader(f, 2*1024*1024+1))
+}
+func (p localProvider) Delete(_ context.Context, key string) error {
+	err := os.Remove(p.path(key))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	return err
+}
+func (p localProvider) Exists(_ context.Context, key string) (bool, error) {
+	_, err := os.Stat(p.path(key))
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	return err == nil, err
+}
+func (p localProvider) Test(_ context.Context) error { return nil }
+func (p localProvider) BuildAccessURL(key string) string {
+	return "/api/v1/images/" + filepath.Base(key)
+}
+
+type s3Provider struct {
+	client         *minio.Client
+	bucket, prefix string
+}
+
+func (p s3Provider) object(key string) string {
+	return strings.Trim(strings.TrimSuffix(p.prefix, "/")+"/"+key, "/")
+}
+func (p s3Provider) Put(ctx context.Context, key, mime string, data []byte) error {
+	_, err := p.client.PutObject(ctx, p.bucket, p.object(key), bytes.NewReader(data), int64(len(data)), minio.PutObjectOptions{ContentType: mime})
+	return err
+}
+func (p s3Provider) Get(ctx context.Context, key string) ([]byte, error) {
+	o, err := p.client.GetObject(ctx, p.bucket, p.object(key), minio.GetObjectOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer o.Close()
+	return io.ReadAll(io.LimitReader(o, 2*1024*1024+1))
+}
+func (p s3Provider) Delete(ctx context.Context, key string) error {
+	return p.client.RemoveObject(ctx, p.bucket, p.object(key), minio.RemoveObjectOptions{})
+}
+func (p s3Provider) Exists(ctx context.Context, key string) (bool, error) {
+	_, err := p.client.StatObject(ctx, p.bucket, p.object(key), minio.StatObjectOptions{})
+	if err != nil {
+		return false, err
+	}
+	return true, nil
+}
+func (p s3Provider) Test(ctx context.Context) error {
+	ok, err := p.client.BucketExists(ctx, p.bucket)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return fmt.Errorf("bucket_missing")
+	}
+	return nil
+}
+func (p s3Provider) BuildAccessURL(key string) string { return "/api/v1/images/" + filepath.Base(key) }
+
+func Load(ctx context.Context, db *sql.DB, root, secretKey string) (Config, Provider, error) {
+	var active, status, configFingerprint, testFingerprint string
+	if err := db.QueryRowContext(ctx, `SELECT active_storage_provider FROM ky_storage_setting WHERE id='default'`).Scan(&active); err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return Config{}, nil, err
+	}
+	if active == "" {
+		active = "local"
+	}
+	if active != "local" {
+		if err := db.QueryRowContext(ctx, `SELECT last_test_status,config_fingerprint,last_test_fingerprint FROM ky_storage_setting WHERE id=$1`, active).Scan(&status, &configFingerprint, &testFingerprint); err != nil {
+			return Config{}, nil, err
+		}
+		if status != "success" || configFingerprint == "" || configFingerprint != testFingerprint {
+			return Config{}, nil, fmt.Errorf("active storage provider has not passed its current test")
+		}
+	}
+	return LoadProvider(ctx, db, root, secretKey, active)
+}
+
+func LoadProvider(ctx context.Context, db *sql.DB, root, secretKey, providerKey string) (Config, Provider, error) {
+	active := providerKey
+	if active == "" {
+		active = "local"
+	}
+	c := Config{Provider: active, Root: root}
+	if active == "local" {
+		return c, localProvider{root: root}, nil
+	}
+	var endpoint, region, bucket, prefix, access, encrypted string
+	var force bool
+	if err := db.QueryRowContext(ctx, `SELECT endpoint,region,bucket,prefix,access_key_id,secret_access_key_encrypted,force_path_style FROM ky_storage_setting WHERE id=$1`, active).Scan(&endpoint, &region, &bucket, &prefix, &access, &encrypted, &force); err != nil {
+		return Config{}, nil, err
+	}
+	c.Endpoint, c.Region, c.Bucket, c.Prefix, c.AccessKey, c.SecretEncrypted, c.ForcePathStyle = endpoint, region, bucket, prefix, access, encrypted, force
+	if endpoint == "" || bucket == "" || access == "" || encrypted == "" {
+		return Config{}, nil, fmt.Errorf("active storage provider is incomplete")
+	}
+	if secretKey == "" {
+		return Config{}, nil, fmt.Errorf("storage secret key unavailable")
+	}
+	cipher, ok := crypto.New(secretKey)
+	if !ok {
+		return Config{}, nil, fmt.Errorf("storage secret key invalid")
+	}
+	secret, err := cipher.Decrypt(encrypted)
+	if err != nil {
+		return Config{}, nil, err
+	}
+	host := strings.TrimRight(strings.TrimPrefix(strings.TrimPrefix(endpoint, "https://"), "http://"), "/")
+	client, err := minio.New(host, &minio.Options{Creds: credentials.NewStaticV4(access, secret, ""), Secure: strings.HasPrefix(endpoint, "https://"), Region: region, BucketLookup: map[bool]minio.BucketLookupType{true: minio.BucketLookupPath, false: minio.BucketLookupAuto}[force]})
+	if err != nil {
+		return Config{}, nil, err
+	}
+	return c, s3Provider{client: client, bucket: bucket, prefix: prefix}, nil
+}
+
+func NewKey() (string, error) {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", b[:]), nil
+}
