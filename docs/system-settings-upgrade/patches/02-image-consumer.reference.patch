+-- 为图片绑定补充稳定 bindingId，保留旧业务唯一约束。
+SET LOCAL lock_timeout='5s';
+SET LOCAL statement_timeout='30s';
+DO $$ BEGIN IF current_database()<>'kwwcrm' THEN RAISE EXCEPTION 'wrong_database'; END IF; END $$;
+ALTER TABLE ky_image.binding ADD COLUMN IF NOT EXISTS binding_id text;
+UPDATE ky_image.binding SET binding_id=substr(md5(resource_id||':'||business_type||':'||business_id||':'||slot),1,8)||'-'||substr(md5(resource_id||':'||business_type||':'||business_id||':'||slot),9,4)||'-'||substr(md5(resource_id||':'||business_type||':'||business_id||':'||slot),13,4)||'-'||substr(md5(resource_id||':'||business_type||':'||business_id||':'||slot),17,4)||'-'||substr(md5(resource_id||':'||business_type||':'||business_id||':'||slot),21,12) WHERE binding_id IS NULL;
+ALTER TABLE ky_image.binding ALTER COLUMN binding_id SET NOT NULL;
+CREATE UNIQUE INDEX IF NOT EXISTS ky_image_binding_id_uq ON ky_image.binding(binding_id);
