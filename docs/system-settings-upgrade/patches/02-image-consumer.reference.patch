diff --git a/services/ky-image-service/internal/server/decision_test.go b/services/ky-image-service/internal/server/decision_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..85b3df50dbbdfb2bb0c17e6ea2bbd9e79eb58784
--- /dev/null
+++ b/services/ky-image-service/internal/server/decision_test.go
@@ -0,0 +1,36 @@
+package server
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestAccessDecisionDistinguishesDeniedAndInvalidResponses(t *testing.T) {
+	tests := []struct {
+		name    string
+		body    string
+		wantOK  bool
+		wantErr bool
+	}{
+		{name: "explicit denied", body: `{"data":{"allowed":false}}`, wantOK: false},
+		{name: "missing allowed", body: `{"data":{}}`, wantErr: true},
+		{name: "null allowed", body: `{"data":{"allowed":null}}`, wantErr: true},
+		{name: "missing grant", body: `{"data":{"allowed":true,"actorId":"u1","workspaceType":"enterprise","workspaceId":"e1","membershipId":"m1","grantedRequiredPermissions":[],"dataScopes":[{"scopeType":"all"}]}}`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(tt.body))
+			}))
+			defer srv.Close()
+			s := &service{c: cfg{membershipURL: srv.URL, internalToken: "fixture"}}
+			_, ok, _, err := s.accessDecision(context.Background(), "u1", "s1", "enterprise", "e1", []string{"enterprise.profile.view"})
+			if ok != tt.wantOK || (err != nil) != tt.wantErr {
+				t.Fatalf("ok=%v err=%v, want ok=%v err=%v", ok, err, tt.wantOK, tt.wantErr)
+			}
+		})
+	}
+}
diff --git a/services/ky-image-service/internal/server/gc.go b/services/ky-image-service/internal/server/gc.go
new file mode 100644
index 0000000000000000000000000000000000000000..895a392ddd1c3b95b47c6b82d01b00e118f8ce2b
--- /dev/null
+++ b/services/ky-image-service/internal/server/gc.go
@@ -0,0 +1,85 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+
+	imagestorage "github.com/Kysion/KyaiCRM/services/ky-image-service/internal/storage"
+)
+
+// collect removes only expired temporary resources with no binding. Bound
+// resources are never selected by this job; the database binding is authoritative.
+func (s *service) collect(ctx context.Context, now time.Time, limit int) (int, error) {
+	if limit <= 0 || limit > 200 {
+		limit = 200
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, err
+	}
+	defer tx.Rollback()
+	rows, err := tx.QueryContext(ctx, `SELECT r.id,r.path,r.storage_provider FROM ky_image.resource r LEFT JOIN ky_image.binding b ON b.resource_id=r.id WHERE r.status IN('temporary','expired','deleting') AND r.expires_at <= $1 AND b.resource_id IS NULL ORDER BY r.created_at LIMIT $2 FOR UPDATE OF r SKIP LOCKED`, now, limit)
+	if err != nil {
+		return 0, err
+	}
+	defer rows.Close()
+	type victim struct{ id, path, provider string }
+	victims := []victim{}
+	for rows.Next() {
+		var v victim
+		if err = rows.Scan(&v.id, &v.path, &v.provider); err != nil {
+			return 0, err
+		}
+		victims = append(victims, v)
+	}
+	if err = rows.Err(); err != nil {
+		return 0, err
+	}
+	for _, v := range victims {
+		if _, err = tx.ExecContext(ctx, `UPDATE ky_image.resource SET status='deleting',updated_at=now() WHERE id=$1 AND status IN('temporary','expired','deleting')`, v.id); err != nil {
+			return 0, err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return 0, err
+	}
+	completed := 0
+	var firstErr error
+	for _, v := range victims {
+		var removeErr error
+		if v.provider == "" || v.provider == "local" {
+			removeErr = os.Remove(filepath.Join(s.c.dir, v.path))
+		} else {
+			_, provider, loadErr := imagestorage.LoadProvider(ctx, s.db, s.c.dir, s.c.storageSecret, v.provider)
+			if loadErr == nil {
+				removeErr = provider.Delete(ctx, v.path)
+			} else {
+				removeErr = loadErr
+			}
+		}
+		if removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) {
+			if firstErr == nil {
+				firstErr = removeErr
+			}
+			continue
+		}
+		result, err := s.db.ExecContext(ctx, `DELETE FROM ky_image.resource WHERE id=$1 AND status='deleting'`, v.id)
+		if err != nil {
+			if firstErr == nil {
+				firstErr = err
+			}
+			continue
+		}
+		if affected, err := result.RowsAffected(); err != nil {
+			if firstErr == nil {
+				firstErr = err
+			}
+		} else if affected == 1 {
+			completed++
+		}
+	}
+	return completed, firstErr
+}
