+		t.Fatal(err)
+	}
+	id := "cccccccccccccccccccccccccccccccc"
+	if _, err = db.ExecContext(ctx, `INSERT INTO ky_image.resource(id,workspace_type,workspace_id,uploader_user_id,uploader_membership_id,context_type,purpose,path,mime,byte_size,width,height,sha256,status,expires_at) VALUES($1,'enterprise','e1','u1','m1','enterprise','logo',$2,'image/png',1,1,1,repeat('c',64),'temporary',now()-interval '1 second')`, id, id+".image"); err != nil {
