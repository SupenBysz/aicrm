+package storage
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalProviderPutGetDeleteAndAccessURL(t *testing.T) {
+	d := t.TempDir()
+	if err := os.Chmod(d, 0700); err != nil {
+		t.Fatal(err)
+	}
+	p := localProvider{root: d}
+	ctx := context.Background()
+	if err := p.Put(ctx, "0123456789abcdef0123456789abcdef", "image/png", []byte("image")); err != nil {
+		t.Fatal(err)
+	}
+	got, err := p.Get(ctx, "0123456789abcdef0123456789abcdef")
+	if err != nil || string(got) != "image" {
+		t.Fatalf("get=%q err=%v", got, err)
+	}
+	ok, err := p.Exists(ctx, "0123456789abcdef0123456789abcdef")
+	if err != nil || !ok {
+		t.Fatalf("exists=%v err=%v", ok, err)
+	}
+	if want := "/api/v1/images/0123456789abcdef0123456789abcdef"; p.BuildAccessURL("0123456789abcdef0123456789abcdef") != want {
+		t.Fatalf("url mismatch")
+	}
+	if err := p.Delete(ctx, "0123456789abcdef0123456789abcdef"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(d, "0123456789abcdef0123456789abcdef.image")); !os.IsNotExist(err) {
+		t.Fatalf("file remains: %v", err)
+	}
+}
diff --git a/shared/image/files.go b/shared/image/files.go
new file mode 100644
index 0000000000000000000000000000000000000000..068f471f693a6b582402f716b53a5547a3388d7f
--- /dev/null
+++ b/shared/image/files.go
@@ -0,0 +1,255 @@
+// Package image contains the shared image validation and private file store.
+// Authorization and business binding remain in the image service/database.
+package image
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"image/png"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"syscall"
+	"time"
+)
+
+type Execer interface {
+	ExecContext(context.Context, string, ...any) (sql.Result, error)
+	QueryRowContext(context.Context, string, ...any) *sql.Row
+}
+
+// Actor is server-derived identity. It must never be populated from an
+// untrusted browser field when a resource is bound.
+type Actor struct {
+	UserID, MembershipID, WorkspaceType, WorkspaceID string
+}
+
+// BindTx changes a temporary resource to the business-owned resource and
+// updates the single slot atomically in the caller's business transaction.
+func BindTx(ctx context.Context, tx Execer, resourceID string, actor Actor, businessType, businessID string) error {
+	if actor.UserID == "" || actor.MembershipID == "" || actor.WorkspaceType == "" || actor.WorkspaceID == "" || resourceID == "" || businessID == "" {
+		return ErrInvalid
+	}
+	var status, uploader, uploaderMembership, wsType, wsID, contextType, purpose string
+	var contextID sql.NullString
+	var expires time.Time
+	err := tx.QueryRowContext(ctx, `SELECT status,uploader_user_id,uploader_membership_id,workspace_type,workspace_id,context_type,context_id,purpose,expires_at FROM ky_image.resource WHERE id=$1 FOR UPDATE`, resourceID).Scan(&status, &uploader, &uploaderMembership, &wsType, &wsID, &contextType, &contextID, &purpose, &expires)
+	if err != nil {
+		if err == sql.ErrNoRows {
+			return ErrInvalid
+		}
+		return err
+	}
+	var old string
+	err = tx.QueryRowContext(ctx, `SELECT resource_id FROM ky_image.binding WHERE business_type=$1 AND business_id=$2 AND slot='logo' FOR UPDATE`, businessType, businessID).Scan(&old)
+	if err != nil && err != sql.ErrNoRows {
+		return err
+	}
+	if err == nil && old == resourceID && status == "bound" {
+		return nil
+	}
+	if purpose != "logo" || contextType != businessType || (contextID.Valid && contextID.String != businessID) || uploader != actor.UserID || uploaderMembership != actor.MembershipID || wsType != actor.WorkspaceType || wsID != actor.WorkspaceID {
+		return ErrInvalid
+	}
+	if status != "temporary" || !expires.After(time.Now().UTC()) {
+		return ErrInvalid
+	}
+	if err == nil && old != "" {
+		var refs int
+		if e := tx.QueryRowContext(ctx, `SELECT count(*) FROM ky_image.binding WHERE resource_id=$1 AND NOT (business_type=$2 AND business_id=$3 AND slot='logo')`, old, businessType, businessID).Scan(&refs); e != nil {
+			return e
+		}
+		if refs == 0 {
+			if _, e := tx.ExecContext(ctx, `UPDATE ky_image.resource SET status='expired',expires_at=now()+interval '7 days',updated_at=now() WHERE id=$1 AND status='bound'`, old); e != nil {
+				return e
+			}
+		}
+	}
+	if _, err = tx.ExecContext(ctx, `UPDATE ky_image.resource SET status='bound',updated_at=now() WHERE id=$1 AND status='temporary'`, resourceID); err != nil {
+		return err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO ky_image.binding(binding_id,resource_id,business_type,business_id,slot) VALUES(substr(md5($1||':'||$2||':'||$3||':logo'),1,8)||'-'||substr(md5($1||':'||$2||':'||$3||':logo'),9,4)||'-'||substr(md5($1||':'||$2||':'||$3||':logo'),13,4)||'-'||substr(md5($1||':'||$2||':'||$3||':logo'),17,4)||'-'||substr(md5($1||':'||$2||':'||$3||':logo'),21,12),$1,$2,$3,'logo') ON CONFLICT (business_type,business_id,slot) DO UPDATE SET resource_id=EXCLUDED.resource_id`, resourceID, businessType, businessID); err != nil {
+		return err
+	}
+	return nil
+}
+
+func UnbindTx(ctx context.Context, tx Execer, actor Actor, businessType, businessID string) error {
+	if actor.UserID == "" || actor.MembershipID == "" || actor.WorkspaceType == "" || actor.WorkspaceID == "" || businessID == "" {
+		return ErrInvalid
+	}
+	var resourceID string
+	err := tx.QueryRowContext(ctx, `SELECT resource_id FROM ky_image.binding WHERE business_type=$1 AND business_id=$2 AND slot='logo' FOR UPDATE`, businessType, businessID).Scan(&resourceID)
+	if err == sql.ErrNoRows {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if _, err = tx.ExecContext(ctx, `DELETE FROM ky_image.binding WHERE business_type=$1 AND business_id=$2 AND slot='logo'`, businessType, businessID); err != nil {
+		return err
+	}
+	var refs int
+	if err = tx.QueryRowContext(ctx, `SELECT count(*) FROM ky_image.binding WHERE resource_id=$1`, resourceID).Scan(&refs); err != nil {
+		return err
+	}
+	if refs == 0 {
+		_, err = tx.ExecContext(ctx, `UPDATE ky_image.resource SET status='expired',expires_at=now()+interval '7 days',updated_at=now() WHERE id=$1 AND status='bound'`, resourceID)
+	}
+	return err
+}
+
+const MaxBytes = 2 * 1024 * 1024
+const MaxDimension = 4096
+const MaxStoredDimension = 1024
+
+var IDPattern = regexp.MustCompile(`^[0-9a-f]{32}$`)
+var ErrInvalid = os.ErrInvalid
+
+type Meta struct {
+	ID, MIME, Path, Hash string
+	Bytes, Width, Height int
+}
+
+func IDFromURL(value string) (string, bool) {
+	const prefix = "/api/v1/images/"
+	if !strings.HasPrefix(value, prefix) {
+		return "", false
+	}
+	id := strings.TrimPrefix(value, prefix)
+	return id, IDPattern.MatchString(id)
+}
+
+func CheckDir(dir string) error {
+	if !filepath.IsAbs(dir) {
+		return ErrInvalid
+	}
+	st, e := os.Lstat(dir)
+	if e != nil {
+		return e
+	}
+	u, ok := st.Sys().(*syscall.Stat_t)
+	if !ok || !st.IsDir() || st.Mode().Perm() != 0700 || u.Uid != uint32(os.Geteuid()) {
+		return ErrInvalid
+	}
+	return nil
+}
+func Sanitize(raw []byte, mime string) ([]byte, Meta, error) {
+	if len(raw) == 0 || len(raw) > MaxBytes {
+		return nil, Meta{}, ErrInvalid
+	}
+	cfg, format, e := image.DecodeConfig(bytes.NewReader(raw))
+	if e != nil || cfg.Width <= 0 || cfg.Height <= 0 || cfg.Width > MaxDimension || cfg.Height > MaxDimension || int64(cfg.Width)*int64(cfg.Height) > int64(MaxDimension*MaxDimension) {
+		return nil, Meta{}, ErrInvalid
+	}
+	if (format != "png" && format != "jpeg") || (format == "png" && mime != "image/png") || (format == "jpeg" && mime != "image/jpeg") {
+		return nil, Meta{}, ErrInvalid
+	}
+	src, decoded, e := image.Decode(bytes.NewReader(raw))
+	if e != nil || decoded != format {
+		return nil, Meta{}, ErrInvalid
+	}
+	w, h := cfg.Width, cfg.Height
+	if w > MaxStoredDimension || h > MaxStoredDimension {
+		scale := float64(MaxStoredDimension) / float64(w)
+		if float64(h)*scale > float64(MaxStoredDimension) {
+			scale = float64(MaxStoredDimension) / float64(h)
+		}
+		w, h = int(float64(w)*scale), int(float64(h)*scale)
+		if w < 1 {
+			w = 1
+		}
+		if h < 1 {
+			h = 1
+		}
+		dst := image.NewRGBA(image.Rect(0, 0, w, h))
+		resizeNearest(dst, src)
+		src = dst
+	}
+	var out bytes.Buffer
+	if format == "png" {
+		e = png.Encode(&out, src)
+	} else {
+		e = jpeg.Encode(&out, src, &jpeg.Options{Quality: 90})
+	}
+	if e != nil || out.Len() > MaxBytes {
+		return nil, Meta{}, ErrInvalid
+	}
+	b := out.Bytes()
+	sum := sha256.Sum256(b)
+	return b, Meta{MIME: mime, Hash: hex.EncodeToString(sum[:]), Bytes: len(b), Width: w, Height: h}, nil
+}
+func resizeNearest(dst *image.RGBA, src image.Image) {
+	sb, db := src.Bounds(), dst.Bounds()
+	for y := 0; y < db.Dy(); y++ {
+		sy := sb.Min.Y + y*sb.Dy()/db.Dy()
+		for x := 0; x < db.Dx(); x++ {
+			sx := sb.Min.X + x*sb.Dx()/db.Dx()
+			dst.Set(x, y, color.NRGBAModel.Convert(src.At(sx, sy)))
+		}
+	}
+}
+func Save(dir, mime string, raw []byte) (Meta, error) {
+	if e := CheckDir(dir); e != nil {
+		return Meta{}, e
+	}
+	clean, m, e := Sanitize(raw, mime)
+	if e != nil {
+		return Meta{}, e
+	}
+	var id [16]byte
+	if _, e = rand.Read(id[:]); e != nil {
+		return Meta{}, e
+	}
+	m.ID = hex.EncodeToString(id[:])
+	m.Path = filepath.Join(dir, m.ID+".image")
+	f, e := os.OpenFile(m.Path+".tmp", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if e != nil {
+		return Meta{}, e
+	}
+	if _, e = f.Write(clean); e == nil {
+		e = f.Sync()
+	}
+	_ = f.Close()
+	if e != nil {
+		_ = os.Remove(m.Path + ".tmp")
+		return Meta{}, e
+	}
+	if e = os.Rename(m.Path+".tmp", m.Path); e != nil {
+		return Meta{}, e
+	}
+	d, e := os.Open(dir)
+	if e == nil {
+		e = d.Sync()
+		_ = d.Close()
+	}
+	return m, e
+}
+func Load(dir, id string) ([]byte, error) {
+	if !IDPattern.MatchString(id) || CheckDir(dir) != nil {
+		return nil, ErrInvalid
+	}
+	f, e := os.OpenFile(filepath.Join(dir, id+".image"), os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if e != nil {
+		return nil, e
+	}
+	defer f.Close()
+	st, e := f.Stat()
+	if e != nil || !st.Mode().IsRegular() || st.Mode().Perm() != 0600 || st.Size() > MaxBytes {
+		return nil, ErrInvalid
+	}
+	b, e := io.ReadAll(io.LimitReader(f, MaxBytes+1))
+	if e != nil || len(b) > MaxBytes {
+		return nil, ErrInvalid
+	}
+	return b, nil
+}
