+	var imageBuf bytes.Buffer
+	_ = png.Encode(&imageBuf, image.NewNRGBA(image.Rect(0, 0, 1, 1)))
+	body := `{"mime":"image/png","base64":"` + base64.StdEncoding.EncodeToString(imageBuf.Bytes()) + `","contextType":"enterprise","purpose":"logo"}`
+	var probe uploadInput
+	if err := json.Unmarshal([]byte(body), &probe); err != nil || probe.Purpose != "logo" || probe.ContextType != "enterprise" {
+		t.Fatalf("body_contract=%v", err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/api/v1/images", strings.NewReader(body))
+	req.Header.Set("Authorization", "Bearer "+tok)
+	req.Header.Set("X-KY-Workspace-Type", "enterprise")
+	req.Header.Set("X-KY-Workspace-Id", "e1")
+	rr = httptest.NewRecorder()
+	mux.ServeHTTP(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("authorized=%d body=%s", rr.Code, rr.Body.String())
+	}
+	bad := httptest.NewRequest(http.MethodPost, "/api/v1/images", strings.NewReader(body))
+	bad.Header.Set("Authorization", "Bearer "+tok)
+	bad.Header.Set("X-KY-Workspace-Type", "enterprise")
+	bad.Header.Set("X-KY-Workspace-Id", "e2")
+	rr = httptest.NewRecorder()
+	mux.ServeHTTP(rr, bad)
+	if rr.Code != http.StatusForbidden {
+		t.Fatalf("wrong_workspace=%d", rr.Code)
+	}
+}
